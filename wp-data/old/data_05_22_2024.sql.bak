77,1918,'_survey_index_5_survey_url_text','field_629456584223a'),(84178,1918,'survey_index_6_survey_icon','1492'),(84179,1918,'_survey_index_6_survey_icon','field_6294562942237'),(84180,1918,'survey_index_6_survey_title','Energy Management'),(84181,1918,'_survey_index_6_survey_title','field_6294564042238'),(84182,1918,'survey_index_6_survey_url','#'),(84183,1918,'_survey_index_6_survey_url','field_6294564e42239'),(84184,1918,'survey_index_6_survey_url_text','View Results'),(84185,1918,'_survey_index_6_survey_url_text','field_629456584223a'),(84186,1918,'survey_index_7_survey_icon','1493'),(84187,1918,'_survey_index_7_survey_icon','field_6294562942237'),(84188,1918,'survey_index_7_survey_title','Going Off-grid'),(84189,1918,'_survey_index_7_survey_title','field_6294564042238'),(84190,1918,'survey_index_7_survey_url','#'),(84191,1918,'_survey_index_7_survey_url','field_6294564e42239'),(84192,1918,'survey_index_7_survey_url_text','View Results'),(84193,1918,'_survey_index_7_survey_url_text','field_629456584223a'),(84194,1918,'survey_index','8'),(84195,1918,'_survey_index','field_6294561242236'),(84196,1918,'report_title','Download the report'),(84197,1918,'_report_title','field_62f30edfb57e1'),(84198,1918,'report_intro','Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus massa erat, consectetur at semper at, feugiat vel orci. '),(84199,1918,'_report_intro','field_62f30eedb57e2'),(84200,1918,'report_link_url','#'),(84201,1918,'_report_link_url','field_62f30ef4b57e3'),(84202,1918,'report_link_text','Download'),(84203,1918,'_report_link_text','field_62f30f01b57e4'),(84204,1918,'solutions_content','The housing system is complex, and no one solution will solve the complex problems we now face but there are some critical first steps to be taken now.\r\n<ul>\r\n 	<li>Set out an ambitious national housing agreement between commonwealth and state governments with targets and funding for the construction of affordable homes.</li>\r\n 	<li>Phase out tax breaks for property investors and using the increase in revenue to build more public housing.</li>\r\n 	<li>Establish laws which limit rental increases beyond what is fair.</li>\r\n 	<li>Rebalance tenancy laws to provide renters with more security and control, such as eliminating no grounds evictions.</li>\r\n 	<li>Phase out stamp duty and replace it with a broad-based land tax.</li>\r\n</ul>\r\n<h4>While there are many opinions on what policy changes will fix the housing market, doing nothing is not an option.</h4>'),(84205,1918,'_solutions_content','field_640e8b307a958'),(84206,1918,'problem_icons_0_prob_icon','1699'),(84207,1918,'_problem_icons_0_prob_icon','field_640fa0291d519'),(84208,1918,'problem_icons_0_prob_concerned_stat','70% highly concerned'),(84209,1918,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(84210,1918,'problem_icons_0_prob_concerded_text','are highly concerned'),(84211,1918,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(84212,1918,'problem_icons_0_prob_issue_text',''),(84213,1918,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(84214,1918,'problem_icons','4'),(84215,1918,'_problem_icons','field_640fa0191d518'),(84216,1918,'ceh_content_left',''),(84217,1918,'_ceh_content_left','field_640e97e8f1c8c'),(84218,1918,'ceh_content_right',''),(84219,1918,'_ceh_content_right','field_640e97fdf1c8d'),(84220,1918,'pc_content_left',''),(84221,1918,'_pc_content_left','field_640e983bf1c8f'),(84222,1918,'pc_content_right',''),(84223,1918,'_pc_content_right','field_640e984df1c90'),(84224,1918,'problem_icons_1_prob_icon','1699'),(84225,1918,'_problem_icons_1_prob_icon','field_640fa0291d519'),(84226,1918,'problem_icons_1_prob_concerned_stat','69% highly concerned'),(84227,1918,'_problem_icons_1_prob_concerned_stat','field_640fa0dd81d95'),(84228,1918,'problem_icons_1_prob_concerded_text','are highly concerned'),(84229,1918,'_problem_icons_1_prob_concerded_text','field_640fa10181d96'),(84230,1918,'problem_icons_1_prob_issue_text',''),(84231,1918,'_problem_icons_1_prob_issue_text','field_640fa11a81d97'),(84232,1918,'problem_icons_2_prob_icon','1699'),(84233,1918,'_problem_icons_2_prob_icon','field_640fa0291d519'),(84234,1918,'problem_icons_2_prob_concerned_stat','64% highly concerned'),(84235,1918,'_problem_icons_2_prob_concerned_stat','field_640fa0dd81d95'),(84236,1918,'problem_icons_2_prob_concerded_text','are highly concerned'),(84237,1918,'_problem_icons_2_prob_concerded_text','field_640fa10181d96'),(84238,1918,'problem_icons_2_prob_issue_text',''),(84239,1918,'_problem_icons_2_prob_issue_text','field_640fa11a81d97'),(84240,1918,'problem_icons_3_prob_icon','1699'),(84241,1918,'_problem_icons_3_prob_icon','field_640fa0291d519'),(84242,1918,'problem_icons_3_prob_concerned_stat','64% highly concerned'),(84243,1918,'_problem_icons_3_prob_concerned_stat','field_640fa0dd81d95'),(84244,1918,'problem_icons_3_prob_concerded_text','are highly concerned'),(84245,1918,'_problem_icons_3_prob_concerded_text','field_640fa10181d96'),(84246,1918,'problem_icons_3_prob_issue_text',''),(84247,1918,'_problem_icons_3_prob_issue_text','field_640fa11a81d97'),(84248,1918,'problem_icons_0_prob_concerned_text','House prices have doubled in a decade'),(84249,1918,'_problem_icons_0_prob_concerned_text','field_640fa10181d96'),(84250,1918,'problem_icons_1_prob_concerned_text','The gap between rich and poor is growing'),(84251,1918,'_problem_icons_1_prob_concerned_text','field_640fa10181d96'),(84252,1918,'problem_icons_2_prob_concerned_text','Construction of social housing is down'),(84253,1918,'_problem_icons_2_prob_concerned_text','field_640fa10181d96'),(84254,1918,'problem_icons_3_prob_concerned_text','Banks are making more than ever from housing'),(84255,1918,'_problem_icons_3_prob_concerned_text','field_640fa10181d96'),(84256,1918,'monitor_content','The Australian Housing Monitor is a large, nationally-representative survey covering public experiences and attitudes toward housing related issues. Questions range from how well the respondent is keeping up with their mortgage/rent, to what they think about social housing construction.\r\n\r\nA broad range of demographic criteria are included, such as gender, location, age, income, voting preference, educational level, tenure type, and employment status. These variables allow CEH researchers to understand the trends and diversity of opinion around the country.\r\n\r\nIt also incorporates questions from previous surveys to track trends over time.\r\nThe inaugural poll was conducted by Essential in December 2022, and was completed by 4,735 people.'),(84257,1918,'_monitor_content','field_640fcc4014404'),(84258,1918,'problem_head','Housing in Australia is not working, and Australians are concerned.'),(84259,1918,'_problem_head','field_641935436aded'),(84260,1918,'problem_signoff','Explore the research showing how concerned Australians are our about the housing situation.'),(84261,1918,'_problem_signoff','field_641935626adee'),(84262,1918,'sections','a:2:{i:0;s:4:\"hero\";i:1;s:9:\"news_grid\";}'),(84263,1918,'_sections','field_5dafb40b8143a'),(84264,1918,'sections_0_is_full_height','1'),(84265,1918,'_sections_0_is_full_height','field_61d6f6fd5a37e'),(84266,1918,'sections_0_image','1648'),(84267,1918,'_sections_0_image','field_61d6f6d45a37d'),(84268,1918,'sections_0_heading','Heading'),(84269,1918,'_sections_0_heading','field_61d6f69e5a379'),(84270,1918,'sections_0_subtitle','Ya ya '),(84271,1918,'_sections_0_subtitle','field_61d6f6ac5a37a'),(84272,1918,'sections_0_link_one',''),(84273,1918,'_sections_0_link_one','field_61d6f6b55a37b'),(84274,1918,'sections_0_link_two',''),(84275,1918,'_sections_0_link_two','field_61d6f6c35a37c'),(84276,1918,'sections_1_select_categories','a:1:{i:0;s:2:\"27\";}'),(84277,1918,'_sections_1_select_categories','field_637f04483b63b'),(84278,1918,'intro_head_major','Super Consumers Australia is <span>fighting</span> to ensure that the superannuation industry is held accountable for the outcomes they deliver to Australian consumers.'),(84279,1918,'_intro_head_major','field_64e828783ad9f'),(84280,1918,'intro_head_minor','We want super to work for everyone—not just super fund companies. With our research, journalism and campaigns we are creating the trustworthy and transparent superannuation system we all deserve.'),(84281,1918,'_intro_head_minor','field_64e8288c3ada0'),(84282,1918,'intro_icons_0_int_icon',''),(84283,1918,'_intro_icons_0_int_icon','field_64e828b33ada2'),(84284,1918,'intro_icons_0_int_icon_text','At 1,727,000 square kilometres, we’re 2.5 times the size of Texas. <span>Yeeha!</span>'),(84285,1918,'_intro_icons_0_int_icon_text','field_64e828e33ada3'),(84286,1918,'intro_icons_1_int_icon',''),(84287,1918,'_intro_icons_1_int_icon','field_64e828b33ada2'),(84288,1918,'intro_icons_1_int_icon_text','We have twice as many species of native plant and animal as any other Australian state or territory.'),(84289,1918,'_intro_icons_1_int_icon_text','field_64e828e33ada3'),(84290,1918,'intro_icons_2_int_icon',''),(84291,1918,'_intro_icons_2_int_icon','field_64e828b33ada2'),(84292,1918,'intro_icons_2_int_icon_text','We have less land classified as ‘protected’ than any other state or territory.'),(84293,1918,'_intro_icons_2_int_icon_text','field_64e828e33ada3'),(84294,1918,'intro_icons','3'),(84295,1918,'_intro_icons','field_64e828963ada1'),(84296,1918,'threat_head_major','What we stand to lose if we don’t act soon to protect beautiful Queensland:'),(84297,1918,'_threat_head_major','field_64ec258d9dbd1'),(84298,1918,'threats_icons','3'),(84299,1918,'_threats_icons','field_64ec2551a93f9'),(84300,1918,'threats_icons_0_thr_icon','1819'),(84301,1918,'_threats_icons_0_thr_icon','field_64ec2551a93fa'),(84302,1918,'threats_icons_0_thr_icon_text','The rich cultural heritage of our First Nations people and their continuous ties to country, dating back more than 50,000 years.'),(84303,1918,'_threats_icons_0_thr_icon_text','field_64ec2551a93fb'),(84304,1918,'threats_icons_1_thr_icon','18