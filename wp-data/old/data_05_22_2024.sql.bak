arn more</a>'),(47368,1635,'_second_image_button','field_5b67cb29ddf9c'),(47369,1635,'second_image_title','Lifestart is about supporting young children'),(47370,1635,'_second_image_title','field_5b67cb20ddf9a'),(47371,1635,'page_col_image','412'),(47372,1635,'_page_col_image','field_5de6546e7c63a'),(47373,1635,'page_col_image_3','437'),(47374,1635,'_page_col_image_3','field_5de6e3998e07e'),(47375,1635,'sec_2_title','Community'),(47376,1635,'_sec_2_title','field_5de6e3ef2798f'),(47377,1635,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(47378,1635,'_sec_2_text','field_5de78dc89e613'),(47379,1635,'sec_3_title','The Project'),(47380,1635,'_sec_3_title','field_5de6e3d37d8da'),(47381,1635,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(47382,1635,'_sec_3_text','field_5de6e4044e5e8'),(47383,1635,'page_col_image_2','436'),(47384,1635,'_page_col_image_2','field_5de6546e7c63a'),(47385,1635,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(47386,1635,'_sec_2_button','field_5de6e58c86706'),(47387,1635,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(47388,1635,'_sec_3_button','field_5de6e5a243c03'),(47389,1635,'page_col_image_4','455'),(47390,1635,'_page_col_image_4','field_5de70801090ce'),(47391,1635,'sec_4_title','Location'),(47392,1635,'_sec_4_title','field_5de7082a12a81'),(47393,1635,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(47394,1635,'_sec_4_text','field_5de7084812a82'),(47395,1635,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(47396,1635,'_sec_4_button','field_5de7085e12a83'),(47397,1635,'news_title','Project updates'),(47398,1635,'_news_title','field_5de78da3aabb9'),(47399,1635,'sec_2_text_copy',''),(47400,1635,'_sec_2_text_copy','field_5de78dc89e613'),(47401,1635,'timeline-title','Timeline'),(47402,1635,'_timeline-title','field_5de78df29e615'),(47403,1635,'timeline_title','Timeline'),(47404,1635,'_timeline_title','field_5de78df29e615'),(47405,1635,'contact_title','Contact us'),(47406,1635,'_contact_title','field_5de7981e06057'),(47407,1635,'contact_intro','Contact text...'),(47408,1635,'_contact_intro','field_5de7983506058'),(47409,1635,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(47410,1635,'_news_button','field_5de8329896e02'),(47411,1635,'timeline_intro','Introduction of timeline detail...'),(47412,1635,'_timeline_intro','field_5de98f5fb1781'),(47413,1635,'timeline_pic','477'),(47414,1635,'_timeline_pic','field_5de98f72b1782'),(47415,1635,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(47416,1635,'_timeline_button','field_5de99363677f8'),(47417,1635,'banner_image_position','center'),(47418,1635,'_banner_image_position','field_5f3bc4757dd02'),(47419,1635,'services_title','Our services'),(47420,1635,'_services_title','field_5f20f3cd80eb2'),(47421,1635,'services_items_0_services_item_image','1061'),(47422,1635,'_services_items_0_services_item_image','field_5f2121355be14'),(47423,1635,'services_items_0_sservices_item_title','1300 Telephone counselling