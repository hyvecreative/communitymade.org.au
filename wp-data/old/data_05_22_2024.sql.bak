2a89973e'),(15213,906,'team_members_3_member_image','367'),(15214,906,'_team_members_3_member_image','field_5b7572a89973e'),(15215,906,'banner_button',''),(15216,906,'_banner_button','field_5b568147fd367'),(15217,906,'intro_col_1','The Take Control Campaign is a new movement of people who want to make Australia safer when it comes to drugs.'),(15218,906,'_intro_col_1','field_5df5c6cef3ddb'),(15219,906,'intro_col_2','The campaign has been launched by the Ted Noffs Foundation, Australia\'s largest provider of drug and alcohol treatment services for young people. The Foundation strives to help disadvantaged young people become advantaged and supports them on their journey to take back control of their lives.'),(15220,906,'_intro_col_2','field_5df5c6deee1ca'),(15221,906,'intro_col_3','With community support, the Take Control Campaign aims to change the conversation surrounding drugs and drug use in Australia. Through our common sense plan, we are demanding governments take control of the issue and fix our broken drug laws.'),(15222,906,'_intro_col_3','field_5df5c6e99b7a8'),(15223,906,'intro_logo','610'),(15224,906,'_intro_logo','field_5df5c6f18c801'),(15225,906,'intro_title','Decades of failed drug policy have resulted in unnecessary suffering. We have a secret and chaotic black market run by criminals and gangs. We have no control.'),(15226,906,'_intro_title','field_5df5c6799cfec'),(15227,906,'intro_bullets','Despite the best efforts of our police forces, for every drug dealer we catch, more simply start and operate with impunity.\r\n\r\nAny teenager can get drugs easily. People who use drugs can’t be sure what they are taking. Innocent young people who are just experimenting can buy themselves a death sentence.\r\n\r\nWorst of all, it’s often hard for people with problems to access help because they\'re treated like criminals.\r\n\r\nThis is because our governments refuse to take control of drugs.\r\n\r\nParents need greater tools and strategies to help their kids cope with the challenges of modern life.\r\n\r\nIt’s not good enough to put our heads in the sand and tell our kids to “just say no”. It doesn\'t work.\r\n\r\nIt\'s time to end the fear tactics. It\'s time to end the marketing gimmicks. People need real resources to reduce the harms associated with drug use.\r\n\r\nOur state and federal governments need to work together to get drug use under control by putting health and safety first.'),(15228,906,'_intro_bullets','field_5df5c6799d05a'),(15229,906,'intro_text',''),(15230,906,'_intro_text','field_5df5c6799d0c6'),(15231,906,'plan_title',''),(15232,906,'_plan_title','field_5df5c6799d197'),(15233,906,'plan_icons_row','5'),(15234,906,'_plan_icons_row','field_5df5c6799d211'),(15235,906,'plan_icons_row_0_plan_icon','516'),(15236,906,'_plan_icons_row_0_plan_icon','field_5df5c679a8044'),(15237,906,'plan_icons_row_0_plan_icon_text',' Roll out pill testing services nationally to reduce harm at music festivals and parties'),(15238,906,'_plan_icons_row_0_plan_icon_text','field_5df5c679a80ae'),(15239,906,'plan_icons_row_1_plan_icon','515'),(15240,906,'_plan_icons_row_1_plan_icon','field_5df5c679a8044'),(15241,906,'plan_icons_row_1_plan_icon_text','Expand treatment services for people suffering from drug problems'),(15242,906,'_plan_icons_row_1_plan_icon_text','field_5df5c679a80ae'),(15243,906,'plan_icons_row_2_plan_icon','514'),(15244,906,'_plan_icons_row_2_plan_icon','field_5df5c679a8044'),(15245,906,'plan_icons_row_2_plan_icon_text','Establish more drug monitoring rooms to save lives and improve communities'),(15246,906,'_plan_icons_row_2_plan_icon_text','field_5df5c679a80ae'),(15247,906,'plan_icons_row_3_plan_icon','513'),(15248,906,'_plan_icons_row_3_plan_icon','field_5df5c679a8044'),(15249,906,'plan_icons_row_3_plan_icon_text','Enhance engagement services for disadvantaged young people'),(15250,906,'_plan_icons_row_3_plan_icon_text','field_5df5c679a80ae'),(15251,906,'plan_icons_row_4_plan_icon','512'),(15252,906,'_plan_icons_ro