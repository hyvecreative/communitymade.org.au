d_image_button','field_5b67cb29ddf9c'),(79725,1894,'second_image_title','Lifestart is about supporting young children'),(79726,1894,'_second_image_title','field_5b67cb20ddf9a'),(79727,1894,'page_col_image','412'),(79728,1894,'_page_col_image','field_5de6546e7c63a'),(79729,1894,'page_col_image_3','437'),(79730,1894,'_page_col_image_3','field_5de6e3998e07e'),(79731,1894,'sec_2_title','Community'),(79732,1894,'_sec_2_title','field_5de6e3ef2798f'),(79733,1894,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(79734,1894,'_sec_2_text','field_5de78dc89e613'),(79735,1894,'sec_3_title','The Project'),(79736,1894,'_sec_3_title','field_5de6e3d37d8da'),(79737,1894,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(79738,1894,'_sec_3_text','field_5de6e4044e5e8'),(79739,1894,'page_col_image_2','436'),(79740,1894,'_page_col_image_2','field_5de6546e7c63a'),(79741,1894,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(79742,1894,'_sec_2_button','field_5de6e58c86706'),(79743,1894,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(79744,1894,'_sec_3_button','field_5de6e5a243c03'),(79745,1894,'page_col_image_4','455'),(79746,1894,'_page_col_image_4','field_5de70801090ce'),(79747,1894,'sec_4_title','Location'),(79748,1894,'_sec_4_title','field_5de7082a12a81'),(79749,1894,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(79750,1894,'_sec_4_text','field_5de7084812a82'),(79751,1894,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(79752,1894,'_sec_4_button','field_5de7085e12a83'),(79753,1894,'news_title','Project updates'),(79754,1894,'_news_title','field_5de78da3aabb9'),(79755,1894,'sec_2_text_copy',''),(79756,1894,'_sec_2_text_copy','field_5de78dc89e613'),(79757,1894,'timeline-title','Timeline'),(79758,1894,'_timeline-title','field_5de78df29e615'),(79759,1894,'timeline_title','Timeline'),(79760,1894,'_timeline_title','field_5de78df29e615'),(79761,1894,'contact_title','Contact us'),(79762,1894,'_contact_title','field_5de7981e06057'),(79763,1894,'contact_intro','Contact text...'),(79764,1894,'_contact_intro','field_5de7983506058'),(79765,1894,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(79766,1894,'_news_button','field_5de8329896e02'),(79767,1894,'timeline_intro','Introduction of timeline detail...'),(79768,1894,'_timeline_intro','field_5de98f5fb1781'),(79769,1894,'timeline_pic','477'),(79770,1894,'_timeline_pic','field_5de98f72b1782'),(79771,1894,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(79772,1894,'_timeline_button','field_5de99363677f8'),(79773,1894,'banner_image_position','center'),(79774,1894,'_banner_image_position','field_5f3bc4757dd02'),(79775,1894,'services_title','Our services'),(79776,1894,'_services_title','field_5f20f3cd80eb2'),(79777,1894,'services_items_0_services_item_image','1061'),(79778,1894,'_services_items_0_services_item_image','field_5f2121355be14'),(79779,1894,'services_items_0_sservices_item_title','1300 Telephone counselling line'),(79780,1894,'_services_ite