123,'survey_index_7_survey_title','Going Off-grid'),(115754,2123,'_survey_index_7_survey_title','field_6294564042238'),(115755,2123,'survey_index_7_survey_url','#'),(115756,2123,'_survey_index_7_survey_url','field_6294564e42239'),(115757,2123,'survey_index_7_survey_url_text','View Results'),(115758,2123,'_survey_index_7_survey_url_text','field_629456584223a'),(115759,2123,'survey_index','8'),(115760,2123,'_survey_index','field_6294561242236'),(115761,2123,'report_title','Download the report'),(115762,2123,'_report_title','field_62f30edfb57e1'),(115763,2123,'report_intro','Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus massa erat, consectetur at semper at, feugiat vel orci. '),(115764,2123,'_report_intro','field_62f30eedb57e2'),(115765,2123,'report_link_url','#'),(115766,2123,'_report_link_url','field_62f30ef4b57e3'),(115767,2123,'report_link_text','Download'),(115768,2123,'_report_link_text','field_62f30f01b57e4'),(115769,2123,'solutions_content','The housing system is complex, and no one solution will solve the complex problems we now face but there are some critical first steps to be taken now.\r\n<ul>\r\n 	<li>Set out an ambitious national housing agreement between commonwealth and state governments with targets and funding for the construction of affordable homes.</li>\r\n 	<li>Phase out tax breaks for property investors and using the increase in revenue to build more public housing.</li>\r\n 	<li>Establish laws which limit rental increases beyond what is fair.</li>\r\n 	<li>Rebalance tenancy laws to provide renters with more security and control, such as eliminating no grounds evictions.</li>\r\n 	<li>Phase out stamp duty and replace it with a broad-based land tax.</li>\r\n</ul>\r\n<h4>While there are many opinions on what policy changes will fix the housing market, doing nothing is not an option.</h4>'),(115770,2123,'_solutions_content','field_640e8b307a958'),(115771,2123,'problem_icons_0_prob_icon','1699'),(115772,2123,'_problem_icons_0_prob_icon','field_640fa0291d519'),(115773,2123,'problem_icons_0_prob_concerned_stat','70% highly concerned'),(115774,2123,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(115775,2123,'problem_icons_0_prob_concerded_text','are highly concerned'),(115776,2123,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(115777,2123,'problem_icons_0_prob_issue_text',''),(115778,2123,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(115779,2123,'problem_icons','4'),(115780,2123,'_problem_icons','field_640fa0191d518'),(115781,2123,'ceh_content_left',''),(115782,2123,'_ceh_content_left','field_640e97e8f1c8c'),(115783,2123,'ceh_content_right',''),(115784,2123,'_ceh_content_right','field_640e97fdf1c8d'),(115785,2123,'pc_content_left',''),(115786,2123,'_pc_content_left','field_640e983bf1c8f'),(115787,2123,'pc_content_right',''),(115788,2123,'_pc_content_right','field_640e984df1c90'),(115789,2123,'problem_icons_1_prob_icon','1699'),(115790,2123,'_problem_icons_1_prob_icon','field_640fa0291d519'),(115791,2123,'problem_icons_1_prob_concerned_stat','69% highly concerned'),(115792,2123,'_problem_icons_1_prob_concerned_stat','field_640fa0dd81d95'),(115793,2123,'problem_icons_1_prob_concerded_text','are highly concerned'),(115794,2123,'_problem_icons_1_prob_concerded_text','field_640fa10181d96'),(115795,2123,'problem_icons_1_prob_issue_text',''),(115796,2123,'_problem_icons_1_prob_issue_text','field_640fa11a81d97'),(115797,2123,'problem_icons_2_prob_icon','1699'),(115798,2123,'_problem_icons_2_prob_icon','field_640fa0291d519'),(115799,2123,'problem_icons_2_prob_concerned_stat','64% highly concerned'),(115800,2123,'_problem_icons_2_prob_concerned_stat','field_640fa0dd81d95'),(115801,2123,'problem_icons_2_prob_concerded_text','are highly concerned'),(115802,2123,'_problem_icons_2_prob_concerded_text','field_640fa10181d96'),(115803,2123,'problem_icons_2_prob_issue_text',''),(115804,2123,'_problem_icons_2_prob_issue_text','field_640fa11a81d97'),(115805,2123,'problem_icons_3_prob_icon','1699'),(115806,2123,'_problem_icons_3_prob_icon','field_640fa0291d519'),(115807,2123,'problem_icons_3_prob_concerned_stat','64% highly concerned'),(115808,2123,'_problem_icons_3_prob_concerned_stat','field_640fa0dd81d95'),(115809,2123,'problem_icons_3_prob_concerded_text','are highly concerned'),(115810,2123,'_problem_icons_3_prob_concerded_text','field_640fa10181d96'),(115811,2123,'problem_icons_3_prob_issue_text',''),(115812,2123,'_problem_icons_3_prob_issue_text','field_640fa11a81d97'),(115813,2123,'problem_icons_0_prob_concerned_text','House prices have doubled in a decade'),(115814,2123,'_problem_icons_0_prob_concerned_text','field_640fa10181d96'),(115815,2123,'problem_icons_1_prob_concerned_text','The gap between rich and poor is growing'),(115816,2123,'_problem_icons_1_prob_concerned_text','field_640fa10181d96'),(115817,2123,'problem_icons_2_prob_concerned_text','Construction of social housing is down'),(115818,2123,'_problem_icons_2_prob_concerned_text','field_640fa10181d96'),(115819,2123,'problem_icons_3_prob_concerned_text','Banks are making more than ever from housing'),(115820,2123,'_problem_icons_3_prob_concerned_text','field_640fa10181d96'),(115821,2123,'monitor_content','The Australian Housing Monitor is a large, nationally-representative survey covering public experiences and attitudes toward housing related issues. Questions range from how well the respondent is keeping up with their mortgage/rent, to what they think about social housing construction.\r\n\r\nA broad range of demographic criteria are included, such as gender, location, age, income, voting preference, educational level, tenure type, and employment status. These variables allow CEH researchers to understand the trends and diversity of opinion around the country.\r\n\r\nIt also incorporates questions from previous surveys to track trends over time.\r\nThe inaugural poll was conducted by Essential in December 2022, and was completed by 4,735 people.'),(115822,2123,'_monitor_content','field_640fcc4014404'),(115823,2123,'problem_head','Housing in Australia is not working, and Australians are concerned.'),(115824,2123,'_problem_head','field_641935436aded'),(115825,2123,'problem_signoff','Explore the research showing how concerned Australians are our about the housing situation.'),(115826,2123,'_problem_signoff','field_641935626adee'),(115827,2123,'sections','a:2:{i:0;s:4:\"hero\";i:1;s:9:\"news_grid\";}'),(115828,2123,'_sections','field_5dafb40b8143a'),(115829,2123,'sections_0_is_full_height','1'),(115830,2123,'_sections_0_is_full_height','field_61d6f6fd5a37e'),(115831,2123,'sections_0_image','1648'),(115832,2123,'_sections_0_image','field_61d6f6d45a37d'),(115833,2123,'sections_0_heading','Heading'),(115834,2123,'_sections_0_heading','field_61d6f69e5a379'),(115835,2123,'sections_0_subtitle','Ya ya '),(115836,2123,'_sections_0_subtitle','field_61d6f6ac5a37a'),(115837,2123,'sections_0_link_one',''),(115838,2123,'_sections_0_link_one','field_61d6f6b55a37b'),(115839,2123,'sections_0_link_two',''),(115840,2123,'_sections_0_link_two','field_61d6f6c35a37c'),(115841,2123,'sections_1_select_categories','a:1:{i:0;s:2:\"27\";}'),(115842,2123,'_sections_1_select_categories','field_637f04483b63b'),(115843,2123,'intro_head_major','Super Consumers Australia is <span>fighting</span> to ensure that the superannuation industry is <span>held accountable</span> for the outcomes they deliver to Australian consumers.'),(115844,2123,'_intro_head_major','field_64e828783ad9f'),(115845,2123,'intro_head_minor','We want super to work for everyone—not just super fund companies. With our research, journalism and campaigns we are creating the trustworthy and transparent superannuation system we all deserve.'),(115846,2123,'_intro_head_minor','field_64e8288c3ada0'),(115847,2123,'intro_icons_0_int_icon','1922'),(115848,2123,'_intro_icons_0_int_icon','field_64e828b33ada2'),(115849,2123,'intro_icons_0_int_icon_text','At 1,727,000 square kilometres, we’re 2.5 times the size of Texas. <span>Yeeha!</span>'),(115850,2123,'_intro_icons_0_int_icon_text','field_64e828e33ada3'),(115851,2123,'intro_icons_1_int_icon','1920'),(115852,2123,'_intro_icons_1_int_icon','field_64e828b33ada2'),(115853,2123,'intro_icons_1_int_icon_text','We have twice as many species of native plant and animal as any other Australian state or territory.'),(115854,2123,'_intro_icons_1_int_icon_text','field_64e828e33ada3'),(115855,2123,'intro_icons_2_int_icon','1921'),(115856,2123,'_intro_icons_2_int_icon','field_64e828b33ada2'),(115857,2123,'intro_icons_2_int_icon_text','We have less land classified as ‘protected’ than any other state or territory.'),(115858,2123,'_intro_icons_2_int_icon_text','field_64e828e33ada3'),(115859,2123,'intro_icons','3'),(115860,2123,'_intro_icons','field_64e828963ada1'),(115861,2123,'threat_head_major','What we stand to lose if we don’t act soon to protect beautiful Queensland:'),(115862,2123,'_threat_head_major','field_64ec258d9dbd1'),(115863,2123,'threats_icons','3'),(115864,2123,'_threats_icons','field_64ec2551a93f9'),(115865,2123,'threats_icons_0_thr_icon','1819'),(115866,2123,'_threats_icons_0_thr_icon','field_64ec2551a93fa'),(115867,2123,'threats_icons_0_thr_icon_text','The rich cultural heritage of our First Nations people and their continuous ties to country, dating back more than 50,000 years.'),(115868,2123,'_threats_icons_0_thr_icon_text','field_64ec2551a93fb'),(115869,2123,'threats_icons_1_thr_icon','1819'),(115870,2123,'_threats_icons_1_thr_icon','field_64ec2551a93fa'),(115871,2123,'threats_icons_1_thr_icon_text','Thousands of species of plant and animal which are now classified as threatened or endangered in Queensland.'),(115872,2123,'_threats_icons_1_thr_icon_text','field_64ec2551a93fb'),(115873,2123,'threats_icons_2_thr_icon','1819'),(115874,2123,'_threats_icons_2_thr_icon','field_64ec2551a93fa'),(115875,2123,'threats_icons_2_thr_icon_text','The access to nature that is central to the Queensland way of life.'),(1158