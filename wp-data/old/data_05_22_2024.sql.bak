87135,1929,'_second_image_cont','field_5b67cb24ddf9b'),(87136,1929,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(87137,1929,'_second_image_button','field_5b67cb29ddf9c'),(87138,1929,'second_image_title','Lifestart is about supporting young children'),(87139,1929,'_second_image_title','field_5b67cb20ddf9a'),(87140,1929,'page_col_image','412'),(87141,1929,'_page_col_image','field_5de6546e7c63a'),(87142,1929,'page_col_image_3','437'),(87143,1929,'_page_col_image_3','field_5de6e3998e07e'),(87144,1929,'sec_2_title','Community'),(87145,1929,'_sec_2_title','field_5de6e3ef2798f'),(87146,1929,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(87147,1929,'_sec_2_text','field_5de78dc89e613'),(87148,1929,'sec_3_title','The Project'),(87149,1929,'_sec_3_title','field_5de6e3d37d8da'),(87150,1929,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(87151,1929,'_sec_3_text','field_5de6e4044e5e8'),(87152,1929,'page_col_image_2','436'),(87153,1929,'_page_col_image_2','field_5de6546e7c63a'),(87154,1929,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(87155,1929,'_sec_2_button','field_5de6e58c86706'),(87156,1929,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(87157,1929,'_sec_3_button','field_5de6e5a243c03'),(87158,1929,'page_col_image_4','455'),(87159,1929,'_page_col_image_4','field_5de70801090ce'),(87160,1929,'sec_4_title','Location'),(87161,1929,'_sec_4_title','field_5de7082a12a81'),(87162,1929,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(87163,1929,'_sec_4_text','field_5de7084812a82'),(87164,1929,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(87165,1929,'_sec_4_button','field_5de7085e12a83'),(87166,1929,'news_title','Project updates'),(87167,1929,'_news_title','field_5de78da3aabb9'),(87168,1929,'sec_2_text_copy',''),(87169,1929,'_sec_2_text_copy','field_5de78dc89e613'),(87170,1929,'timeline-title','Timeline'),(87171,1929,'_timeline-title','field_5de78df29e615'),(87172,1929,'timeline_title','Timeline'),(87173,1929,'_timeline_title','field_5de78df29e615'),(87174,1929,'contact_title','Contact us'),(87175,1929,'_contact_title','field_5de7981e06057'),(87176,1929,'contact_intro','Contact text...'),(87177,1929,'_contact_intro','field_5de7983506058'),(87178,1929,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(87179,1929,'_news_button','field_5de8329896e02'),(87180,1929,'timeline_intro','Introduction of timeline detail...'),(87181,1929,'_timeline_intro','field_5de98f5fb1781'),(87182,1929,'timeline_pic','477'),(87183,1929,'_timeline_pic','field_5de98f72b1782'),(87184,1929,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(87185,1929,'_timeline_button','field_5de99363677f8'),(87186,1929,'banner_image_position','center'),(87187,1929,'_banner_image_position','field_5f3bc4757dd02'),(87188,1929,'services_title','Our services'),(87189,1929,'_services_title','field_5f20f3cd80eb2'),(87190,1929,'services_items_0_services_item_image','1061'),(87191,1929,'_servi