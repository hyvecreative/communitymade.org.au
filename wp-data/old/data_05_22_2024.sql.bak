_7_survey_icon','field_6294562942237'),(117241,2125,'survey_index_7_survey_title','Going Off-grid'),(117242,2125,'_survey_index_7_survey_title','field_6294564042238'),(117243,2125,'survey_index_7_survey_url','#'),(117244,2125,'_survey_index_7_survey_url','field_6294564e42239'),(117245,2125,'survey_index_7_survey_url_text','View Results'),(117246,2125,'_survey_index_7_survey_url_text','field_629456584223a'),(117247,2125,'survey_index','8'),(117248,2125,'_survey_index','field_6294561242236'),(117249,2125,'report_title','Download the report'),(117250,2125,'_report_title','field_62f30edfb57e1'),(117251,2125,'report_intro','Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus massa erat, consectetur at semper at, feugiat vel orci. '),(117252,2125,'_report_intro','field_62f30eedb57e2'),(117253,2125,'report_link_url','#'),(117254,2125,'_report_link_url','field_62f30ef4b57e3'),(117255,2125,'report_link_text','Download'),(117256,2125,'_report_link_text','field_62f30f01b57e4'),(117257,2125,'solutions_content','The housing system is complex, and no one solution will solve the complex problems we now face but there are some critical first steps to be taken now.\r\n<ul>\r\n 	<li>Set out an ambitious national housing agreement between commonwealth and state governments with targets and funding for the construction of affordable homes.</li>\r\n 	<li>Phase out tax breaks for property investors and using the increase in revenue to build more public housing.</li>\r\n 	<li>Establish laws which limit rental increases beyond what is fair.</li>\r\n 	<li>Rebalance tenancy laws to provide renters with more security and control, such as eliminating no grounds evictions.</li>\r\n 	<li>Phase out stamp duty and replace it with a broad-based land tax.</li>\r\n</ul>\r\n<h4>While there are many opinions on what policy changes will fix the housing market, doing nothing is not an option.</h4>'),(117258,2125,'_solutions_content','field_640e8b307a958'),(117259,2125,'problem_icons_0_prob_icon','1699'),(117260,2125,'_problem_icons_0_prob_icon','field_640fa0291d519'),(117261,2125,'problem_icons_0_prob_concerned_stat','70% highly concerned'),(117262,2125,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(117263,2125,'problem_icons_0_prob_concerded_text','are highly concerned'),(117264,2125,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(117265,2125,'problem_icons_0_prob_issue_text',''),(117266,2125,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(117267,2125,'problem_icons','4'),(117268,2125,'_problem_icons','field_640fa0191d518'),(117269,2125,'ceh_content_left',''),(117270,2125,'_ceh_content_left','field_640e97e8f1c8c'),(117271,2125,'ceh_content_right',''),(117272,2125,'_ceh_content_right','field_640e97fdf1c8d'),(117273,2125,'pc_content_left',''),(117274,2125,'_pc_content_left','field_640e983bf1c8f'),(117275,2125,'pc_content_right',''),(117276,2125,'_pc_content_right','field_640e984df1c90'),(117277,2125,'problem_icons_1_prob_icon','1699'),(117278,2125,'_problem_icons_1_prob_icon','field_640fa0291d519'),(117279,2125,'problem_icons_1_prob_concerned_stat','69% highly concerned'),(117280,2125,'_problem_icons_1_prob_concerned_stat','field_640fa0dd81d95'),(117281,2125,'problem_icons_1_prob_concerded_text','are highly concerned'),(117282,2125,'_problem_icons_1_prob_concerded_text','field_640fa10181d96'),(117283,2125,'problem_icons_1_prob_issue_text',''),(117284,2125,'_problem_icons_1_prob_issue_text','field_640fa11a81d97'),(117285,2125,'problem_icons_2_prob_icon','1699'),(117286,2125,'_problem_icons_2_prob_icon','field_640fa0291d519'),(117287,2125,'problem_icons_2_prob_concerned_stat','64% highly concerned'),(117288,2125,'_problem_icons_2_prob_concerned_stat','field_640fa0dd81d95'),(117289,2125,'problem_icons_2_prob_concerded_text','are highly concerned'),(117290,2125,'_problem_icons_2_prob_concerded_text','field_640fa10181d96'),(117291,2125,'problem_icons_2_prob_issue_text',''),(117292,2125,'_problem_icons_2_prob_issue_