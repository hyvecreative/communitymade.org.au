,(78142,1875,'survey_index_7_survey_title','Going Off-grid'),(78143,1875,'_survey_index_7_survey_title','field_6294564042238'),(78144,1875,'survey_index_7_survey_url','#'),(78145,1875,'_survey_index_7_survey_url','field_6294564e42239'),(78146,1875,'survey_index_7_survey_url_text','View Results'),(78147,1875,'_survey_index_7_survey_url_text','field_629456584223a'),(78148,1875,'survey_index','8'),(78149,1875,'_survey_index','field_6294561242236'),(78150,1875,'report_title','Download the report'),(78151,1875,'_report_title','field_62f30edfb57e1'),(78152,1875,'report_intro','Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus massa erat, consectetur at semper at, feugiat vel orci. '),(78153,1875,'_report_intro','field_62f30eedb57e2'),(78154,1875,'report_link_url','#'),(78155,1875,'_report_link_url','field_62f30ef4b57e3'),(78156,1875,'report_link_text','Download'),(78157,1875,'_report_link_text','field_62f30f01b57e4'),(78158,1875,'solutions_content','The housing system is complex, and no one solution will solve the complex problems we now face but there are some critical first steps to be taken now.\r\n<ul>\r\n 	<li>Set out an ambitious national housing agreement between commonwealth and state governments with targets and funding for the construction of affordable homes.</li>\r\n 	<li>Phase out tax breaks for property investors and using the increase in revenue to build more public housing.</li>\r\n 	<li>Establish laws which limit rental increases beyond what is fair.</li>\r\n 	<li>Rebalance tenancy laws to provide renters with more security and control, such as eliminating no grounds evictions.</li>\r\n 	<li>Phase out stamp duty and replace it with a broad-based land tax.</li>\r\n</ul>\r\n<h4>While there are many opinions on what policy changes will fix the housing market, doing nothing is not an option.</h4>'),(78159,1875,'_solutions_content','field_640e8b307a958'),(78160,1875,'problem_icons_0_prob_icon','1699'),(78161,1875,'_problem_icons_0_prob_icon','field_640fa0291d519'),(78162,1875,'problem_icons_0_prob_concerned_stat','70% highly concerned'),(78163,1875,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(78164,1875,'problem_icons_0_prob_concerded_text','are highly concerned'),(78165,1875,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(78166,1875,'problem_icons_0_prob_issue_text',''),(78167,1875,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(78168,1875,'problem_icons','4'),(78169,1875,'_problem_icons','field_640fa0191d518'),(78170,1875,'ceh_content_left',''),(78171,1875,'_ceh_content_left','field_640e97e8f1c8c'),(78172,1875,'ceh_content_right',''),(78173,1875,'_ceh_content_right','field_640e97fdf1c8d'),(78174,1875,'pc_content_left',''),(78175,1875,'_pc_content_left','field_640e983bf1c8f'),(78176,1875,'pc_content_right',''),(78177,1875,'_pc_content_right','field_640e984df1c90'),(78178,1875,'problem_icons_1_prob_icon','1699'),(78179,1875,'_problem_icons_1_prob_icon','field_640fa0291d519'),(78180,1875,'problem_icons_1_prob_concerned_stat','69% highly concerned'),(78181,1875,'_problem_icons_1_prob_concerned_stat','field_640fa0dd81d95'),(78182,1875,'problem_icons_1_prob_concerded_text','are highly concerned'),(78183,1875,'_problem_icons_1_prob_concerded_text','field_640fa10181d96'),(78184,1875,'problem_icons_1_prob_issue_text',''),(78185,1875,'_problem_icons_1_prob_issue_text','field_640fa11a81d97'),(78186,1875,'problem_icons_2_prob_icon','1699'),(78187,1875,'_problem_icons_2_prob_icon','field_640fa0291d519'),(78188,1875,'problem_icons_2_prob_concerned_stat','64% highly concerned'),(78189,1875,'_problem_icons_2_prob_concerned_stat','field_640fa0dd81d95'),(78190,1875,'problem_icons_2_prob_concerded_text','are highly concerned'),(78191,1875,'_problem_icons_2_prob_concerded_text','field_640fa10181d96'),(78192,1875,'problem_icons_2_prob_issue_text',''),(78193,1875,'_problem_icons_2_prob_issue_text','field_640fa11a81d97'),(78194,1875,'problem_icons_3_prob_icon','1699'),(78195,1875,'