,'field_629456584223a'),(57380,1791,'survey_index_7_survey_icon','1493'),(57381,1791,'_survey_index_7_survey_icon','field_6294562942237'),(57382,1791,'survey_index_7_survey_title','Going Off-grid'),(57383,1791,'_survey_index_7_survey_title','field_6294564042238'),(57384,1791,'survey_index_7_survey_url','#'),(57385,1791,'_survey_index_7_survey_url','field_6294564e42239'),(57386,1791,'survey_index_7_survey_url_text','View Results'),(57387,1791,'_survey_index_7_survey_url_text','field_629456584223a'),(57388,1791,'survey_index','8'),(57389,1791,'_survey_index','field_6294561242236'),(57390,1791,'report_title','Download the report'),(57391,1791,'_report_title','field_62f30edfb57e1'),(57392,1791,'report_intro','Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus massa erat, consectetur at semper at, feugiat vel orci. '),(57393,1791,'_report_intro','field_62f30eedb57e2'),(57394,1791,'report_link_url','#'),(57395,1791,'_report_link_url','field_62f30ef4b57e3'),(57396,1791,'report_link_text','Download'),(57397,1791,'_report_link_text','field_62f30f01b57e4'),(57398,1791,'solutions_content','The housing system is complex, and no one solution will solve the complex problems we now face but there are some critical first steps to be taken now.\r\n<ul>\r\n 	<li>Set out an ambitious national housing agreement between commonwealth and state governments with targets and funding for the construction of affordable homes.</li>\r\n 	<li>Phase out tax breaks for property investors and using the increase in revenue to build more public housing.</li>\r\n 	<li>Establish laws which limit rental increases beyond what is fair.</li>\r\n 	<li>Rebalance tenancy laws to provide renters with more security and control, such as eliminating no grounds evictions.</li>\r\n 	<li>Phase out stamp duty and replace it with a broad-based land tax.</li>\r\n</ul>\r\n<h4>While there are many opinions on what policy changes will fix the housing market, doing nothing is not an option.</h4>'),(57399,1791,'_solutions_content','field_640e8b307a958'),(57400,1791,'problem_icons_0_prob_icon','1699'),(57401,1791,'_problem_icons_0_prob_icon','field_640fa0291d519'),(57402,1791,'problem_icons_0_prob_concerned_stat','70% highly concerned'),(57403,1791,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(57404,1791,'problem_icons_0_prob_concerded_text','are highly concerned'),(57405,1791,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(57406,1791,'problem_icons_0_prob_issue_text',''),(57407,1791,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(57408,1791,'problem_icons','4'),(57409,1791,'_problem_icons','field_640fa0191d518'),(57410,1791,'ceh_content_left',''),(57411,1791,'_ceh_content_left','field_640e97e8f1c8c'),(57412,1791,'ceh_content_right',''),(57413,1791,'_ceh_content_right','field_640e97fdf1c8d'),(57414,1791,'pc_content_left',''),(57415,1791,'_pc_content_left','field_640e983bf1c8f'),(57416,1791,'pc_content_right',''),(57417,1791,'_pc_content_right','field_640e984df1c90'),(57418,1791,'problem_icons_1_prob_icon','1699'),(57419,1791,'_problem_icons_1_prob_icon','field_640fa0291d519'),(57420,1791,'problem_icons_1_prob_concerned_stat','69% highly concerned'),(57421,1791,'_problem_icons_1_prob_concerned_stat','field_640fa0dd81d95'),(57422,1791,'problem_icons_1_prob_concerded_text','are highly concerned'),(57423,1791,'_problem_icons_1_prob_concerded_text','field_640fa10181d96'),(57424,1791,'problem_icons_1_prob_issue_text',''),(57425,1791,'_problem_icons_1_prob_issue_text','field_640fa11a81d97'),(57426,1791,'problem_icons_2_prob_icon','1699'),(57427,1791,'_problem_icons_2_prob_icon','field_640fa0291d519'),(57428,1791,'problem_icons_2_prob_concerned_stat','64% highly concerned'),(57429,1791,'_problem_icons_2_prob_concerned_stat','field_640fa0dd81d95'),(57430,1791,'problem_icons_2_prob_concerded_text','are highly concerned'),(57431,1791,'_problem_icons_2_prob_concerded_text','field_640fa10181d96'),(57432,1791,'problem_icons_2_prob_issue_text',''),(57433,1791,'_problem_icons_2_prob_issue_text','field_640fa11a81d97'),(57434,1791,'problem_icons_3_prob_icon','1699'),(57435,1791,'_problem_icons_3_prob_icon','field_640fa0291d519'),(57436,1791,'problem_icons_3_prob_concerned_stat','64% highly concerned'),(57437,1791,'_problem_icons_3_prob_concerned_stat','field_640fa0dd81d95'),(57438,1791,'problem_icons_3_prob_concerded_text','are highly concerned'),(57439,1791,'_problem_icons_3_prob_concerded_text','field_640fa10181d96'),(57440,1791,'problem_icons_3_prob_issue_text',''),(57441,1791,'_problem_icons_3_prob_issue_text','field_640fa11a81d97'),(57442,1791,'problem_icons_0_prob_concerned_text','House prices have doubled in a decade'),(57443,1791,'_problem_icons_0_prob_concerned_text','field_640fa10181d96'),(57444,1791,'problem_icons_1_prob_concerned_text','The gap between rich and poor is growing'),(57445,1791,'_problem_icons_1_prob_concerned_text','field_640fa10181d96'),(57446,1791,'problem_icons_2_prob_concerned_text','Construction of social housing is down'),(57447,1791,'_problem_icons_2_prob_concerned_text','field_640fa10181d96'),(57448,1791,'problem_icons_3_prob_concerned_text','Banks are making more than ever from housing'),(57449,1791,'_problem_icons_3_prob_concerned_text','field_640fa10181d96'),(57450,1791,'monitor_content','The Australian Housing Monitor is a large, nationally-representative survey covering public experiences and attitudes toward housing related issues. Questions range from how well the respondent is keeping up with their mortgage/rent, to what they think about social housing construction.\r\n\r\nA broad range of demographic criteria are included, such as gender, location, age, income, voting preference, educational level, tenure type, and employment status. These variables allow CEH researchers to understand the trends and diversity of opinion around the country.\r\n\r\nIt also incorporates questions from previous surveys to track trends over time.\r\nThe inaugural poll was conducted by Essential in December 2022, and was completed by 4,735 people.'),(57451,1791,'_monitor_content','field_640fcc4014404'),(57452,1791,'problem_head','Housing in Australia is not working, and Australians are concerned.'),(57453,1791,'_problem_head','field_641935436aded'),(57454,1791,'problem_signoff','Explore the research showing how concerned Australians are our about the housing situation.'),(57455,1791,'_problem_signoff','field_641935626adee'),(57456,1791,'sections','a:1:{i:0;s:4:\"hero\";}'),(57457,1791,'_sections','field_5dafb40b8143a'),(57458,1791,'sections_0_is_full_height','1'),(57459,1791,'_sections_0_is_full_height','field_61d6f6fd5a37e'),(57460,1791,'sections_0_image','1648'),(57461,1791,'_sections_0_image','field_61d6f6d45a37d'),(57462,1791,'sections_0_heading','Heading'),(57463,1791,'_sections_0_heading','field_61d6f69e5a379'),(57464,1791,'sections_0_subtitle','Ya ya '),(57465,1791,'_sections_0_subtitle','field_61d6f6ac5a37a'),(57466,1791,'sections_0_link_one',''),(57467,1791,'_sections_0_link_one','field_61d6f6b55a37b'),(57468,1791,'sections_0_link_two',''),(57469,1791,'_sections_0_link_two','field_61d6f6c35a37c'),(57472,6,'sections_1_select_categories','a:1:{i:0;s:2:\"27\";}'),(57473,6,'_sections_1_select_categories','field_637f04483b63b'),(57474,1794,'banner_head',''),(57475,1794,'_banner_head','field_5b568121a8ffe'),(57476,1794,'banner_sub',''),(57477,1794,'_banner_sub','field_5b568139fd366'),(57478,1794,'banner_button','<a class=\"btn btn-home\" style=\"width: 200px;\" href=\"#project\">Sign the petition</a>'),(57479,1794,'_banner_button','field_5b568147fd367'),(57480,1794,'support_section_title','How can Lifestart support you?'),(57481,1794,'_support_section_title','field_5b67c7d060398'),(57482,1794,'support_left_title','Services'),(57483,1794,'_support_left_title','field_5b67c298e7f8f'),(57484,1794,'support_left_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy.'),(57485,1794,'_support_left_cont','field_5b67c5f6e7f91')