),(67499,1851,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(67500,1851,'_sec_3_text','field_5de6e4044e5e8'),(67501,1851,'page_col_image_2','436'),(67502,1851,'_page_col_image_2','field_5de6546e7c63a'),(67503,1851,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(67504,1851,'_sec_2_button','field_5de6e58c86706'),(67505,1851,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(67506,1851,'_sec_3_button','field_5de6e5a243c03'),(67507,1851,'page_col_image_4','455'),(67508,1851,'_page_col_image_4','field_5de70801090ce'),(67509,1851,'sec_4_title','Location'),(67510,1851,'_sec_4_title','field_5de7082a12a81'),(67511,1851,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(67512,1851,'_sec_4_text','field_5de7084812a82'),(67513,1851,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(67514,1851,'_sec_4_button','field_5de7085e12a83'),(67515,1851,'news_title','Project updates'),(67516,1851,'_news_title','field_5de78da3aabb9'),(67517,1851,'sec_2_text_copy',''),(67518,1851,'_sec_2_text_copy','field_5de78dc89e613'),(67519,1851,'timeline-title','Timeline'),(67520,1851,'_timeline-title','field_5de78df29e615'),(67521,1851,'timeline_title','Timeline'),(67522,1851,'_timeline_title','field_5de78df29e615')