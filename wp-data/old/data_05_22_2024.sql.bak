),(61972,1823,'second _image_title','Lifestart is about supporting young children'),(61973,1823,'_second _image_title','field_5b67cb20ddf9a'),(61974,1823,'second_image_cont','from 0-24 years living with disabilities and their familes'),(61975,1823,'_second_image_cont','field_5b67cb24ddf9b'),(61976,1823,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(61977,1823,'_second_image_button','field_5b67cb29ddf9c'),(61978,1823,'second_image_title','Lifestart is about supporting young children'),(61979,1823,'_second_image_title','field_5b67cb20ddf9a'),(61980,1823,'page_col_image','412'),(61981,1823,'_page_col_image','field_5de6546e7c63a'),(61982,1823,'page_col_image_3','437'),(61983,1823,'_page_col_image_3','field_5de6e3998e07e'),(61984,1823,'sec_2_title','Community'),(61985,1823,'_sec_2_title','field_5de6e3ef2798f'),(61986,1823,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(61987,1823,'_sec_2_text','field_5de78dc89e613'),(61988,1823,'sec_3_title','The Project'),(61989,1823,'_sec_3_title','field_5de6e3d37d8da'),(61990,1823,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(61991,1823,'_sec_3_text','field_5de6e4044e5e8'),(61992,1823,'page_col_image_2','436'),(61993,1823,'_page_col_image_2','field_5de6546e7c63a'),(61994,1823,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(61995,1823,'_sec_2_button','field_5de6e58c86706'),(61996,1823,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(61997,1823,'_sec_3_button','field_5de6e5a243c03'),(61998,1823,'page_col_image_4','455'),(61999,1823,'_page_col_image_4','field_5de70801090ce'),(62000,1823,'sec_4_title','Location'),(62001,1823,'_sec_4_title','field_5de7082a12a81'),(62002,1823,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(62003,1823,'_sec_4_text','field_5de7084812a82'),(62004,1823,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(62005,1823,'_sec_4_button','field_5de7085e12a83'),(62006,1823,'news_title','Project updates'),(62007,1823,'_news_title','field_5de78da3aabb9'),(62008,1823,'sec_2_text_copy',''),(62009,1823,'_sec_2_text_copy','field_5de78dc89e613'),(62010,1823,'timeline-title','Timeline'),(62011,1823,'_timeline-title','field_5de78df29e615'),(62012,1823,'timeline_title','Timeline'),(62013,1823,'_timeline_title','field_5de78df29e615'),(62014,1823,'contact_title','Contact us'),(62015,1823,'_contact_title','field_5de7981e06057'),(62016,1823,'contact_intro','Contact text...'),(62017,1823,'_contact_intro','field_5de7983506058'),(62018,1823,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(62019,1823,'_news_button','field_5de8329896e02'),(62020,1823,'timeline_intro','Introduction of timeline detail...'),(62021,1823,'_timeline_intro','field_5de98f5fb1781'),(62022,1823,'timeline_pic','477'),(62023,1823,'_timeline_pic','field_5de98f72b1782'),(62024,1823,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(62025,1823,'_timeline_button','field_5de99363677f8'),(62026,1823,'banner_image_position','center')