on','<a class=\"btn btn-orange\" href=\"/supports/\">Find us</a>'),(115312,2123,'_support_ctr_button','field_5b67c63658af5'),(115313,2123,'support_right_title','NDIS Registered provider'),(115314,2123,'_support_right_title','field_5b67c6a38c064'),(115315,2123,'support_right_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut.'),(115316,2123,'_support_right_cont','field_5b67c6c98c065'),(115317,2123,'support_right_button','<a class=\"btn btn-blue\" href=\"#\">Read more</a>'),(115318,2123,'_support_right_button','field_5b67c6dd8c066'),(115319,2123,'first_image_title','Lifestart is about supporting young children'),(115320,2123,'_first_image_title','field_5b67ca606afc4'),(115321,2123,'first_image_cont','from 0-24 years living with disabilities and their familes'),(115322,2123,'_first_image_cont','field_5b67caff6afc5'),(115323,2123,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(115324,2123,'_first_image_button','field_5b67cb0d6afc6'),(115325,2123,'second _image_title','Lifestart is about supporting young children'),(115326,2123,'_second _image_title','field_5b67cb20ddf9a'),(115327,2123,'second_image_cont','from 0-24 years living with disabilities and their familes'),(115328,2123,'_second_image_cont','field_5b67cb24ddf9b'),(115329,2123,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(115330,2123,'_second_image_button','field_5b67cb29ddf9c'),(115331,2123,'second_image_title','Lifestart is about supporting young children'),(115332,2123,'_second_image_title','field_5b67cb20ddf9a'),(115333,2123,'page_col_image','412'),(115334,2123,'_page_col_image','field_5de6546e7c63a'),(115335,2123,'page_col_image_3','437'),(115336,2123,'_page_col_image_3','field_5de6e3998e07e'),(115337,2123,'sec_2_title','Community'),(115338,2123,'_sec_2_title','field_5de6e3ef2798f'),(115339,2123,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(115340,2123,'_sec_2_text','field_5de78dc89e613'),(115341,2123,'sec_3_title','The Project'),(115342,2123,'_sec_3_title','field_5de6e3d37d8da'),(115343,2123,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(115344,2123,'_sec_3_text','field_5de6e4044e5e8'),(115345,2123,'page_col_image_2','436'),(115346,2123,'_page_col_image_2','field_5de6546e7c63a'),(115347,2123,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(115348,2123,'_sec_2_button','field_5de6e58c86706'),(115349,2123,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(115350,2123,'_sec_3_button','field_5de6e5a243c03'),(115351,2123,'page_col_image_4','455'),(115352,2123,'_page_col_image_4','field_5de70801090ce'),(115353,2123,'sec_4_title','Location'),(115354,2123,'_sec_4_title','field_5de7082a12a81'),(115355,2123,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(115356,2123,'_sec_4_text','field_5de7084812a82'),(115357,2123,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(115358,2123,'_sec_4_button','field_5de7085e12a83'),(115359,2123,'news_title','Project updates'),(115360,2123,'_news_title','f