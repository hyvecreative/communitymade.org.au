ey_title','Battery Storage'),(69745,1857,'_survey_index_5_survey_title','field_6294564042238'),(69746,1857,'survey_index_5_survey_url','#'),(69747,1857,'_survey_index_5_survey_url','field_6294564e42239'),(69748,1857,'survey_index_5_survey_url_text','View Results'),(69749,1857,'_survey_index_5_survey_url_text','field_629456584223a'),(69750,1857,'survey_index_6_survey_icon','1492'),(69751,1857,'_survey_index_6_survey_icon','field_6294562942237'),(69752,1857,'survey_index_6_survey_title','Energy Management'),(69753,1857,'_survey_index_6_survey_title','field_6294564042238'),(69754,1857,'survey_index_6_survey_url','#'),(69755,1857,'_survey_index_6_survey_url','field_6294564e42239'),(69756,1857,'survey_index_6_survey_url_text','View Results'),(69757,1857,'_survey_index_6_survey_url_text','field_629456584223a'),(69758,1857,'survey_index_7_survey_icon','1493'),(69759,1857,'_survey_index_7_survey_icon','field_6294562942237'),(69760,1857,'survey_index_7_survey_title','Going Off-grid'),(69761,1857,'_survey_index_7_survey_title','field_6294564042238'),(69762,1857,'survey_index_7_survey_url','#'),(69763,1857,'_survey_index_7_survey_url','field_6294564e42239'),(69764,1857,'survey_index_7_survey_url_text','View Results'),(69765,1857,'_survey_index_7_survey_url_text','field_629456584223a'),(69766,1857,'survey_index','8'),(69767,1857,'_survey_index','field_6294561242236'),(69768,1857,'report_title','Download the report'),(69769,1857,'_report_title','field_62f30edfb57e1'),(69770,1857,'report_intro','Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus massa erat, consectetur at semper at, feugiat vel orci. '),(69771,1857,'_report_intro','field_62f30eedb57e2'),(69772,1857,'report_link_url','#'),(69773,1857,'_report_link_url','field_62f30ef4b57e3'),(69774,1857,'report_link_text','Download'),(69775,1857,'_report_link_text','field_62f30f01b57e4'),(69776,1857,'solutions_content','The housing system is complex, and no one solution will solve the complex problems we now face but there are some critical first steps to be taken now.\r\n<ul>\r\n 	<li>Set out an ambitious national housing agreement between commonwealth and state governments with targets and funding for the construction of affordable homes.</li>\r\n 	<li>Phase out tax breaks for property investors and using the increase in revenue to build more public housing.</li>\r\n 	<li>Establish laws which limit rental increases beyond what is fair.</li>\r\n 	<li>Rebalance tenancy laws to provide renters with more security and control, such as eliminating no grounds evictions.</li>\r\n 	<li>Phase out stamp duty and replace it with a broad-based land tax.</li>\r\n</ul>\r\n<h4>While there are many opinions on what policy changes will fix the housing market, doing nothing is not an option.</h4>'),(69777,1857,'_solutions_content','field_640e8b307a958'),(69778,1857,'problem_icons_0_prob_icon','1699'),(69779,1857,'_problem_icons_0_prob_icon','field_640fa0291d519'),(69780,1857,'problem_icons_0_prob_concerned_stat','70% highly concerned'),(69781,1857,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(69782,1857,'problem_icons_0_prob_concerded_text','are highly concerned'),(69783,1857,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(69784,1857,'problem_icons_0_prob_issue_text',''),(69785,1857,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(69786,1857,'problem_icons','4'),(69787,1857,'_problem_icons','field_640fa0191d518'),(69788,1857,'ceh_content_left',''),(69789,1857,'_ceh_content_left','field_640e97e8f1c8c'),(69790,1857,'ceh_content_right',''),(69791,1857,'_ceh_content_right','field_640e97fdf1c8d'),(69792,1857,'pc_content_left',''),(69793,1857,'_pc_content_left','field_640e983bf1c8f'),(69794,1857,'pc_content_right',''),(69795,1857,'_pc_content_right','field_640e984df1c90'),(69796,1857,'problem_icons_1_prob_icon','1699'),(69797,1857,'_problem_icons_1_prob_icon','field_640fa0291d519'),(69798,1857,'problem_icons_1_prob_concerned_stat','69% highly concerned'),(69799,1857,'_problem_icons_1_prob_concerned_stat','field_640fa0dd81d95'),(69800,1857,'problem_icons_1_prob_concerded_text','are highly concerned'),(69801,1857,'_problem_icons_1_prob_concerded_text','field_640fa10181d96'),(69802,1857,'problem_icons_1_prob_issue_text',''),(69803,1857,'_problem_icons_1_prob_issue_text','field_640fa11a81d97'),(69804,1857,'problem_icons_2_prob_icon','1699'),(69805,1857,'_problem_icons_2_prob_icon','field_640fa0291d519'),(69806,1857,'problem_icons_2_prob_concerned_stat','64% highly concerned'),(69807,1857,'_problem_icons_2_prob_concerned_stat','field_640fa0dd81d95'),(69808,1857,'problem_icons_2_prob_concerded_text','are highly concerned'),(69809,1857,'_problem_icons_2_prob_concerded_text','field_640fa10181d96'),(69810,1857,'problem_icons_2_prob_issue_text',''),(69811,1857,'_problem_icons_2_prob_issue_text','field_640fa11a81d97'),(69812,1857,'problem_icons_3_prob_icon','1699'),(69813,1857,'_problem_icons_3_prob_icon','field_640fa0291d519'),(69814,1857,'problem_icons_3_prob_concerned_stat','64% highly concerned'),(69815,1857,'_problem_icons_3_prob_concerned_stat','field_640fa0dd81d95'),(69816,1857,'problem_icons_3_prob_concerded_text','are highly concerned'),(69817,1857,'_problem_icons_3_prob_concerded_text','field_640fa10181d96'),(69818,1857,'problem_icons_3_prob_issue_text',''),(69819,1857,'_problem_icons_3_prob_issue_text','field_640fa11a81d97'),(69820,1857,'problem_icons_0_prob_concerned_text','House prices have doubled in a decade'),(69821,1857,'_problem_icons_0_prob_concerned_text','field_640fa10181d96'),(69822,1857,'problem_icons_1_prob_concerned_text','The gap between rich and poor is growing'),(69823,1857,'_problem_icons_1_prob_concerned_text','field_640fa10181d96'),(69824,1857,'problem_icons_2_prob_concerned_text','Construction of social housing is down'),(69825,1857,'_problem_icons_2_prob_concerned_text','field_640fa10181d96'),(69826,1857,'problem_icons_3_prob_concerned_text','Banks are making more than ever from housing'),(69827,1857,'_problem_icons_3_prob_concerned_text','field_640fa10181d96'),(69828,1857,'monitor_content','The Australian Housing Monitor is a large, nationally-representative survey covering public experiences and attitudes toward housing related issues. Questions range from how well the respondent is keeping up with their mortgage/rent, to what they think about social housing construction.\r\n\r\nA broad range of demographic criteria are included, such as gender, location, age, income, voting preference, educational level, tenure type, and employment status. These variables allow CEH researchers to understand the trends and diversity of opinion around the country.\r\n\r\nIt also incorporates questions from previous surveys to track trends over time.\r\nThe inaugural poll was conducted by Essential in December 2022, and was completed by 4,735 people.'),(69829,1857,'_monitor_content','field_640fcc4014404'),(69830,1857,'problem_head','Housing in Australia is not working, and Australians are concerned.'),(69831,1857,'_problem_head','field_641935436aded'),(69832,1857,'problem_signoff','Explore the research showing how concerned Australians are our about the housing situation.'),(69833,1857,'_problem_signoff','field_641935626adee'),(69834,1857,'sections','a:2:{i:0;s:4:\"hero\";i:1;s:9:\"news_grid\";}'),(69835,1857,'_sections','field_5dafb40b8143a'),(69836,1857,'sections_0_is_full_height','1'),(69837,1857,'_sections_0_is_full_height','field_61d6f6fd5a37e'),(69838,1857,'sections_0_image','1648'),(69839,1857,'_sections_0_image','field_61d6f6d45a37d'),(69840,1857,'sections_0_heading','Heading'),(69841,1857,'_sections_0_heading','field_61d6f69e5a379'),(69842,1857,'sections_0_subtitle','Ya ya '),(69843,1857,'_sections_0_subtitle','field_61d6f6ac5a37a'),(69844,1857,'sections_0_link_one',''),(69845,1857,'_sections_0_link_one','field_61d6f6b55a37b'),(69846,1857,'sections_0_link_two',''),(69847,1857,'_sections_0_link_two','field_61d6f6c35a37c'),(69848,1857,'sections_1_select_categories','a:1:{i:0;s:2:\"27\";}'),(69849,1857,'_sections_1_select_categories','field_637f04483b63b'),(69850,1857,'intro_head_major','Queenslanders are known for both our love of the great outdoors and our state pride…'),(69851,1857,'_intro_head_major','field_64e828783ad9f'),(69852,1857,'intro_head_minor','But there’s a few things you might not know about our beautiful state.'),(69853,1857,'_intro_head_minor','field_64e8288c3ada0'),(69854,1857,'intro_icons_0_int_icon','1806'),(69855,1857,'_intro_icons_0_int_icon','field_64e828b33ada2'),(69856,1857,'intro_icons_0_int_icon_text','At 1,727,000 square kilometres, we’re 2.5 times the size of Texas. <span>Yeeha!</span>'),(69857,1857,'_intro_icons_0_int_icon_text','field_64e828e33ada3'),(69858,1857,'intro_icons_1_int_icon','1806'),(69859,1857,'_intro_icons_1_int_icon','field_64e828b33ada2'),(69860,1857,'intro_icons_1_int_icon_text','We have twice as many species of native plant and animal as any other Australian state or territory.'),(69861,1857,'_intro_icons_1_int_icon_text','field_64e828e33ada3'),(69862,1857,'intro_icons_2_int_icon','1806'),(69863,1857,'_intro_icons_2_int_icon','field_64e828b33ada2'),(69864,1857,'intro_icons_2_int_icon_text','We have less land classified as ‘protected’ than any other state or territory.'),(69865,1857,'_intro_icons_2_int_icon_text','field_64e828e33ada3'),(69866,1857,'intro_icons','3'),(69867,1857,'_intro_icons','field_64e828963ada1'),(69868,1857,'threat_head_major','What we stand to lose if we don’t act soon to protect beautiful Queensland:'),(69869,1857,'_threat_head_major','field_64ec258d9dbd1'),(69870,1857,'threats_icons','3'),(69871,1857,'_threats_icons','field_64ec2551a93f9'),(69872,1857,'threats_icons_0_thr_icon','1819'),(69873,1857,'_threats_icons_0_thr_icon','field_64ec2551a93fa'),(69874,1857,'threats_icons_0_thr_icon_text','The rich cultural heritage of our First Nations people and their continuous ties to country, dating back more than 50,000 years.'),(69875,1857,'_threats_icons_0_thr_icon