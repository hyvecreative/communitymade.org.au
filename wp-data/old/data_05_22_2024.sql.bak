d_5b67c6a38c064'),(40101,1530,'support_right_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut.'),(40102,1530,'_support_right_cont','field_5b67c6c98c065'),(40103,1530,'support_right_button','<a class=\"btn btn-blue\" href=\"#\">Read more</a>'),(40104,1530,'_support_right_button','field_5b67c6dd8c066'),(40105,1530,'first_image_title','Lifestart is about supporting young children'),(40106,1530,'_first_image_title','field_5b67ca606afc4'),(40107,1530,'first_image_cont','from 0-24 years living with disabilities and their familes'),(40108,1530,'_first_image_cont','field_5b67caff6afc5'),(40109,1530,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(40110,1530,'_first_image_button','field_5b67cb0d6afc6'),(40111,1530,'second _image_title','Lifestart is about supporting young children'),(40112,1530,'_second _image_title','field_5b67cb20ddf9a'),(40113,1530,'second_image_cont','from 0-24 years living with disabilities and their familes'),(40114,1530,'_second_image_cont','field_5b67cb24ddf9b'),(40115,1530,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(40116,1530,'_second_image_button','field_5b67cb29ddf9c'),(40117,1530,'second_image_title','Lifestart is about supporting young children'),(40118,1530,'_second_image_title','field_5b67cb20ddf9a'),(40119,1530,'page_col_image','412'),(40120,1530,'_page_col_image','field_5de6546e7c63a'),(40121,1530,'page_col_image_3','437'),(40122,1530,'_page_col_image_3','field_5de6e3998e07e'),(40123,1530,'sec_2_title','Community'),(40124,1530,'_sec_2_title','field_5de6e3ef2798f'),(40125,1530,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(40126,1530,'_sec_2_text','field_5de78dc89e613'),(40127,1530,'sec_3_title','The Project'),(40128,1530,'_sec_3_title','field_5de6e3d37d8da'),(40129,1530,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(40130,1530,'_sec_3_text','field_5de6e4044e5e8'),(40131,1530,'page_col_image_2','436'),(40132,1530,'_page_col_image_2','field_5de6546e7c63a'),(40133,1530,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(40134,1530,'_sec_2_button','field_5de6e58c86706'),(40135,1530,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(40136,1530,'_sec_3_button','field_5de6e5a243c03'),(40137,1530,'page_col_image_4','455'),(40138,1530,'_page_col_image_4','field_5de70801090ce'),(40139,1530,'sec_4_title','Location'),(40140,1530,'_sec_4_title','field_5de7082a12a81'),(40141,1530,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(40142,1530,'_sec_4_text','field_5de7084812a82'),(40143,1530,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(40144,1530,'_sec_4_button','field_5de7085e12a83'),(40145,1530,'news_title','Project updates'),(40146,1530,'_news_title','field_5de78da3aabb9'),(40147,1530,'sec_2_text_copy',''),(40148,1530,'_sec_2_text_copy','field_5de78dc89e613'),(40149,1530,'timeline-title','Timeline'),(40150,1530,'_timeline-title','field_5de78df29e615'),(40151,1530,'timeline_title','Timeline'),(40152,1530,'_timeline_title','