2,'_report_link_url','field_62f30ef4b57e3'),(76862,1872,'report_link_text','Download'),(76863,1872,'_report_link_text','field_62f30f01b57e4'),(76864,1872,'solutions_content','The housing system is complex, and no one solution will solve the complex problems we now face but there are some critical first steps to be taken now.\r\n<ul>\r\n 	<li>Set out an ambitious national housing agreement between commonwealth and state governments with targets and funding for the construction of affordable homes.</li>\r\n 	<li>Phase out tax breaks for property investors and using the increase in revenue to build more public housing.</li>\r\n 	<li>Establish laws which limit rental increases beyond what is fair.</li>\r\n 	<li>Rebalance tenancy laws to provide renters with more security and control, such as eliminating no grounds evictions.</li>\r\n 	<li>Phase out stamp duty and replace it with a broad-based land tax.</li>\r\n</ul>\r\n<h4>While there are many opinions on what policy changes will fix the housing market, doing nothing is not an option.</h4>'),(76865,1872,'_solutions_content','field_640e8b307a958'),(76866,1872,'problem_icons_0_prob_icon','1699'),(76867,1872,'_problem_icons_0_prob_icon','field_640fa0291d519'),(76868,1872,'problem_icons_0_prob_concerned_stat','70% highly concerned'),(76869,1872,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(76870,1872,'problem_icons_0_prob_concerded_text','are highly concerned'),(76871,1872,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(76872,1872,'problem_icons_0_prob_issue_text',''),(76873,1872,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(76874,1872,'problem_icons','4'),(76875,1872,'_problem_icons','field_640fa0191d518'),(76876,1872,'ceh_content_left',''),(76877,1872,'_ceh_content_left','field_640e97e8f1c8c'),(76878,1872,'ceh_content_right',''),(76879,1872,'_ceh_content_right','field_640e97fdf1c8d'),(76880,1872,'pc_content_left',''),(76881,1872,'_pc_content_left','field_640e983bf1c8f'),(76882,