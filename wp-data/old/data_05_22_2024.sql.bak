vey_index_7_survey_icon','1493'),(62999,1825,'_survey_index_7_survey_icon','field_6294562942237'),(63000,1825,'survey_index_7_survey_title','Going Off-grid'),(63001,1825,'_survey_index_7_survey_title','field_6294564042238'),(63002,1825,'survey_index_7_survey_url','#'),(63003,1825,'_survey_index_7_survey_url','field_6294564e42239'),(63004,1825,'survey_index_7_survey_url_text','View Results'),(63005,1825,'_survey_index_7_survey_url_text','field_629456584223a'),(63006,1825,'survey_index','8'),(63007,1825,'_survey_index','field_6294561242236'),(63008,1825,'report_title','Download the report'),(63009,1825,'_report_title','field_62f30edfb57e1'),(63010,1825,'report_intro','Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus massa erat, consectetur at semper at, feugiat vel orci. '),(63011,1825,'_report_intro','field_62f30eedb57e2'),(63012,1825,'report_link_url','#'),(63013,1825,'_report_link_url','field_62f30ef4b57e3'),(63014,1825,'report_link_text','Download'),(63015,1825,'_report_link_text','field_62f30f01b57e4'),(63016,1825,'solutions_content','The housing system is complex, and no one solution will solve the complex problems we now face but there are some critical first steps to be taken now.\r\n<ul>\r\n 	<li>Set out an ambitious national housing agreement between commonwealth and state governments with targets and funding for the construction of affordable homes.</li>\r\n 	<li>Phase out tax breaks for property investors and using the increase in revenue to build more public housing.</li>\r\n 	<li>Establish laws which limit rental increases beyond what is fair.</li>\r\n 	<li>Rebalance tenancy laws to provide renters with more security and control, such as eliminating no grounds evictions.</li>\r\n 	<li>Phase out stamp duty and replace it with a broad-based land tax.</li>\r\n</ul>\r\n<h4>While there are many opinions on what policy changes will fix the housing market, doing nothing is not an option.</h4>'),(63017,1825,'_solutions_content','field_640e8b307a958'),(63018,1825,'problem_icons_0_prob_icon','1699'),(63019,1825,'_problem_icons_0_prob_icon','field_640fa0291d519'),(63020,1825,'problem_icons_0_prob_concerned_stat','70% highly concerned'),(63021,1825,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(63022,1825,'problem_icons_0_prob_concerded_text','are highly concerned'),(63023,1825,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(63024,1825,'problem_icons_0_prob_issue_text',''),(63025,1825,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(63026,1825,'problem_icons','4'),(63027,1825,'_problem_icons','field_640fa0191d518'),(63028,1825,'ceh_content_left',''),(63029,1825,'_ceh_content_left','field_640e97e8f1c8c'),(63030,1825,'ceh_content_right',''),(63031,1825,'_ceh_content_right','field_640e97fdf1c8d'),(63032,1825,'pc_content_left',''),(63033,1825,'_pc_content_left','field_640e983bf1c8f'),(63034,1825,'pc_content_right',''),(63035,1825,'_pc_content_right','field_640e984df1c90'),(63036,1825,'problem_icons_1_prob_icon','1699'),(63037,1825,'_problem_icons_1_prob_icon','field_640fa0291d519'),(63038,1825,'problem_icons_1_prob_concerned_stat','69% highly concerned'),(63039,1825,'_problem_icons_1_prob_concerned_stat','field_640fa0dd81d95'),(63040,1825,'problem_icons_1_prob_concerded_text','are highly concerned'),(63041,1825,'_problem_icons_1_prob_concerded_text','field_640fa10181d96'),(63042,1825,'problem_icons_1_prob_issue_text',''),(63043,1825,'_problem_icons_1_prob_issue_text','field_640fa11a81d97'),(63044,1825,'problem_icons_2_prob_icon','1699'),(63045,1825,'_problem_icons_2_prob_icon','field_640fa0291d519'),(63046,1825,'problem_icons_2_prob_concerned_stat','64% highly concerned'),(63047,1825,'_problem_icons_2_prob_concerned_stat','field_640fa0dd81d95'),(63048,1825,'problem_icons_2_prob_concerded_text','are highly concerned'),(63049,1825,'_problem_icons_2_prob_concerded_text','field_640fa10181d96'),(63050,1825,'problem_icons_2_prob_issue_text',''),(63051,1825,'_problem_icons_2_prob_issue_text','field_640fa11a81d97'),(63052,1825,'problem_icons_3_prob_icon','1699'),(63053,1825,'_problem_icons_3_prob_icon','field_640fa0291d519'),(63054,1825,'problem_icons_3_prob_concerned_stat','64% highly concerned'),(63055,1825,'_problem_icons_3_prob_concerned_stat','field_640fa0dd81d95'),(63056,1825,'problem_icons_3_prob_concerded_text','are highly concerned'),(63057,1825,'_problem_icons_3_prob_concerded_text','field_640fa10181d96'),(63058,1825,'problem_icons_3_prob_issue_text',''),(63059,1825,'_problem_icons_3_prob_issue_text','field_640fa11a81d97'),(63060,1825,'problem_icons_0_prob_concerned_text','House prices have doubled in a decade'),(63061,1825,'_problem_icons_0_prob_concerned_text','field_640fa10181d96'),(63062,1825,'problem_icons_1_prob_concerned_text','The gap between rich and poor is growing'),(63063,1825,'_problem_icons_1_prob_concerned_text','field_640fa10181d96'),(63064,1825,'problem_icons_2_prob_concerned_text','Construction of social housing is down'),(63065,1825,'_problem_icons_2_prob_concerned_text','field_640fa10181d96'),(63066,1825,'problem_icons_3_prob_concerned_text','Banks are making more than ever from housing'),(63067,1825,'_problem_icons_3_prob_concerned_text','field_640fa10181d96'),(63068,1825,'monitor_content','The Australian Housing Monitor is a large, nationally-representative survey covering public experiences and attitudes toward housing related issues. Questions range from how well the respondent is keeping up with their mortgage/rent, to what they think about social housing construction.\r\n\r\nA broad range of demographic criteria are included, such as gender, location, age, income, voting preference, educational level, tenure type, and employment status. These variables allow CEH researchers to understand the trends and diversity of opinion around the country.\r\n\r\nIt also incorporates questions from previous surveys to track trends over time.\r\nThe inaugural poll was conducted by Essential in December 2022, and was completed by 4,735 people.'),(63069,1825,'_monitor_content','field_640fcc4014404'),(63070,1825,'problem_head','Housing in Australia is not working, and Australians are concerned.'),(63071,1825,'_problem_head','field_641935436aded'),(63072,1825,'problem_signoff','Explore the research showing how concerned Australians are our about the housing situation.'),(63073,1825,'_problem_signoff','field_641935626adee'),(63074,1825,'sections','a:2:{i:0;s:4:\"hero\";i:1;s:9:\"news_grid\";}'),(63075,1825,'_sections','field_5dafb40b8143a'),(63076,1825,'sections_0_is_full_height','1'),(63077,1825,'_sections_0_is_full_height','field_61d6f6fd5a37e'),(63078,1825,'sections_0_image','1648'),(63079,1825,'_sections_0_image','field_61d6f6d45a37d'),(63080,1825,'sections_0_heading','Heading'),(63081,1825,'_sections_0_heading','field_61d6f69e5a379'),(63082,1825,'sections_0_subtitle','Ya ya '),(63083,1825,'_sections_0_subtitle','field_61d6f6ac5a37a'),(63084,1825,'sections_0_link_one',''),(63085,1825,'_sections_0_link_one','field_61d6f6b55a37b'),(63086,1825,'sections_0_link_two',''),(63087,1825,'_sections_0_link_two','field_61d6f6c35a37c'),(63088,1825,'sections_1_select_categories','a:1:{i:0;s:2:\"27\";}'),(63089,1825,'_sections_1_select_categories','field_637f04483b63b'),(63090,1825,'intro_head_major','Queenslanders are known for both our love of the great outdoors and our state pride…'),(63091,1825,'_intro_head_major','field_64e828783ad9f'),(63092,1825,'intro_head_minor','But there’s a few things you might not know about our beautiful state.'),(63093,1825,'_intro_head_minor','field_64e8288c3ada0'),(63094,1825,'intro_icons_0_int_icon','1806'),(63095,1825,'_intro_icons_0_int_icon','field_64e828b33ada2'),(63096,1825,'intro_icons_0_int_icon_text','At 1,727,000 square kilometres, we’re 2.5 times the size of Texas. <span>Yeeha!</span>'),(63097,1825,'_intro_icons_0_int_icon_text','field_64e828e33ada3'),(63098,1825,'intro_icons_1_int_icon','1806'),(63099,1825,'_intro_icons_1_int_icon','field_64e828b33ada2'),(63100,1825,'intro_icons_1_int_icon_text','We have twice as many species of native plant and animal as any other Australian state or territory.'),(63101,1825,'_intro_icons_1_int_icon_text','field_64e828e33ada3'),(63102,1825,'intro_icons_2_int_icon','1806'),(63103,1825,'_intro_icons_2_int_icon','field_64e828b33ada2'),(63104,1825,'intro_icons_2_int_icon_text','We have less land classified as ‘protected’ than any other state or territory.'),(63105,1825,'_intro_icons_2_int_icon_text','field_64e828e33ada3'),(63106,1825,'intro_icons','3'),(63107,1825,'_intro_icons','field_64e828963ada1'),(63108,1825,'threat_head_major','What we stand to lose if we don’t act soon to protect beautiful Queensland:'),(63109,1825,'_threat_head_major','field_64ec258d9dbd1'),(63110,1825,'threats_icons','3'),(63111,1825,'_threats_icons','field_64ec2551a93f9'),(63112,1825,'threats_icons_0_thr_icon','1819'),(63113,1825,'_threats_icons_0_thr_icon','field_64ec2551a93fa'),(63114,1825,'threats_icons_0_thr_icon_text','The rich cultural heritage of our First Nations people and their continuous ties to country, dating back more than 50,000 years.'),(63115,1825,'_threats_icons_0_thr_icon_text','field_64ec2551a93fb'),(63116,1825,'threats_icons_1_thr_icon','1819'),(63117,1825,'_threats_icons_1_thr_icon','field_64ec2551a93fa'),(63118,1825,'threats_icons_1_thr_icon_text','Thousands of species of plant and animal which are now classified as threatened or endangered in Queensland.'),(63119,1825,'_threats_icons_1_thr_icon_text','field_64ec2551a93fb'),(63120,1825,'threats_icons_2_thr_icon','1819'),(63121,1825,'_threats_icons_2_thr_icon','field_64ec2551a93fa'),(63122,1825,'threats_icons_2_thr_icon_text','The access to nature that is central to the Queensland way of life.'),(63123,1825,'_threats_icons_2_thr_icon_text','field_64ec2551a93fb'),(63124,1825,'threat_icons_0_thr_icon','1824'),(63125,1825,'_threat_icons_0_thr_icon','field_64ec2551a93fa'),(63126,1825,'threat_icons_0_thr_icon_text','The rich cultural heritage of our First Nations people and their continuous ties to country, dating back more than 50,000 years.'),(63127,1825,'_threat_icons_0_thr_icon_text','field_64ec2551a93fb'),(63128,1825,'threat_icons_1_thr_icon','1824'),(63129,1825,'_threat_icons_1_thr_icon','field_64ec2551a93fa'),(63130,1825,'threat_icons_1_thr_icon_text','Thousands of species of plant and animal which are now classified as threatened or endangered in Queensland.'),(63131,1825,'_threat_icons_1_thr_icon_text','field_64ec2551a93fb'),(63132,1825,'threat_icons_2_thr_icon','1824'),(63133,1825,'_threat_icons_2_thr_icon','field_64ec2551a93fa'),(63134,1825,'threat_icons_2_thr_icon_text','The access to nature that is central to the Queensland way of life.'),(63135,1825,'_threat_icons_2_thr_icon_text','field_64ec2551a93fb'),(63136,1825,'threat_icons','3'),(63137,1825,'_threat_icons','field_64ec2551a93f9'),(63140,1827,'_edit_last','1'),(63141,1827,'_wp_page_template','front-page-dev.php'),(63142,1827,'banner_head',''),(63143,1827,'_banner_head','field_5b568121a8ffe'),(63144,1827,'banner_sub',''),(63145,1827,'_banner_sub','field_5b568139fd366'),(63146,1827,'banner_button','<a class=\"btn btn-home\" style=\"width: 200px;\" href=\"#project\">Sign the petition</a>'),(63147,1827,'_banner_button','field_5b568147fd367'),(63148,1827,'_edit_lock','1693267614:1'),(63149,1827,'support_section_title','How can Lifestart support you?'),(63150,1827,'_support_section_title','field_5b67c7d060398'),(63151,1827,'support_left_title','Services'),(63152,1827,'_support_left_title','field_5b67c298e7f8f'),(63153,1827,'support_left_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy.'),(63154,1827,'_support_left_cont','field_5b67c5f6e7f91'),(63155,1827,'support_left_button','<a class=\"btn btn-green\" href=\"/services/\">View all services</a>'),(63156,1827,'_support_left_button','field_5b67c60ae7f92'),(63157,1827,'support_ctr_title','Talk to us'),(63158,1827,'_support_ctr_title','field_5b67c62a58af3'),(6