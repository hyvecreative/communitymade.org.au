itle','Community'),(123387,2170,'_sec_2_title','field_5de6e3ef2798f'),(123388,2170,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(123389,2170,'_sec_2_text','field_5de78dc89e613'),(123390,2170,'sec_3_title','The Project'),(123391,2170,'_sec_3_title','field_5de6e3d37d8da'),(123392,2170,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(123393,2170,'_sec_3_text','field_5de6e4044e5e8'),(123394,2170,'page_col_image_2','436'),(123395,2170,'_page_col_image_2','field_5de6546e7c63a'),(123396,2170,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(123397,2170,'_sec_2_button','field_5de6e58c86706'),(123398,2170,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(123399,2170,'_sec_3_button','field_5de6e5a243c03'),(123400,2170,'page_col_image_4','455'),(123401,2170,'_page_col_image_4','field_5de70801090ce'),(123402,2170,'sec_4_title','Location'),(123403,2170,'_sec_4_title','field_5de7082a12a81'),(123404,2170,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(123405,2170,'_sec_4_text','field_5de7084812a82'),(123406,2170,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(123407,2170,'_sec_4_button','field_5de7085e12a83'),(123408,2170,'news_title','Project updates'),(123409,2170,'_news_title','field_5de78da3aabb9'),(123410,2170,'sec_2_text_copy',''),(123411,2170,'_sec_2_text_copy','field_5de78dc89e613'),(123412,2170,'timeline-title','Timeline'),(123413,2170,'_timeline-title','field_5de78df29e615'),(123414,2170,'timeline_title','Timeline'),(123415,2170,'_timeline_title','field_5de78df29e615'),(123416,2170,'contact_title','Contact us'),(123417,2170,'_contact_title','field_5de7981e06057'),(123418,2170,'contact_intro','Contact text...'),(123419,2170,'_contact_intro','field_5de7983506058'),(123420,2170,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(123421,2170,'_news_button','field_5de8329896e02'),(123422,2170,'timeline_intro','Introduction of timeline detail...'),(123423,2170,'_timeline_intro','field_5de98f5fb1781'),(123424,2170,'timeline_pic','477'),(123425,2170,'_timeline_pic','field_5de98f72b1782'),(123426,2170,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(123427,2170,'_timeline_button','field_5de99363677f8'),(123428,2170,'banner_image_position','center'),(123429,2170,'_banner_image_position','field_5f3bc4757dd02'),(123430,2170,'services_title','Our services'),(123431,2170,'_services_title','field_5f20f3cd80eb2'),(123432,2170,'services_items_0_services_item_image','1061'),(123433,2170,'_services_items_0_services_item_image','field_5f2121355be14'),(123434,2170,'services_items_0_sservices_item_title','1300 Telephone counselling line'),(123435,2170,'_services_items_0_sservices_item_title','field_605089efca82e'),(123436,2170,'services_items_0_services_item_text',''),(123437,2170,'_services_items_0_services_item_text','field_5f2121535be15'),(123438,2170,'services_items_0_services_link_url','#'),(123439,2170,'_services_items_0_services_link_url','field_6050866041225'),(123440,2170,'service