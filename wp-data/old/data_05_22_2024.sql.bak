d_5b67cb24ddf9b'),(20513,1091,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(20514,1091,'_second_image_button','field_5b67cb29ddf9c'),(20515,1091,'second_image_title','Lifestart is about supporting young children'),(20516,1091,'_second_image_title','field_5b67cb20ddf9a'),(20517,1091,'page_col_image','412'),(20518,1091,'_page_col_image','field_5de6546e7c63a'),(20519,1091,'page_col_image_3','437'),(20520,1091,'_page_col_image_3','field_5de6e3998e07e'),(20521,1091,'sec_2_title','Community'),(20522,1091,'_sec_2_title','field_5de6e3ef2798f'),(20523,1091,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(20524,1091,'_sec_2_text','field_5de78dc89e613'),(20525,1091,'sec_3_title','The Project'),(20526,1091,'_sec_3_title','field_5de6e3d37d8da'),(20527,1091,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(20528,1091,'_sec_3_text','field_5de6e4044e5e8'),(20529,1091,'page_col_image_2','436'),(20530,1091,'_page_col_image_2','field_5de6546e7c63a'),(20531,1091,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(20532,1091,'_sec_2_button','field_5de6e58c86706'),(20533,1091,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(20534,1091,'_sec_3_button','field_5de6e5a243c03'),(20535,1091,'page_col_image_4','455'),(20536,1091,'_page_col_image_4','field_5de70801090ce'),(20537,1091,'sec_4_title','Location'),(20538,1091,'_sec_4_title','field_5de7082a12a81'),(20539,1091,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(20540,1091,'_sec_4_text','field_5de7084812a82'),(20541,1091,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(20542,1091,'_sec_4_button','field_5de7085e12a83'),(20543,1091,'news_title','Project updates'),(20544,1091,'_news_title','field_5de78da3aabb9'),(20545,1091,'sec_2_text_copy',''),(20546,1091,'_sec_2_text_copy','field_5de78dc89e613'),(20547,1091,'timeline-title','Timeline'),(20548,1091,'_timeline-title','field_5de78df29e615'),(20549,1091,'timeline_title','Timeline'),(20550,1091,'_timeline_title','field_5de78df29e615'),(20551,1091,'contact_title','Contact us'),(20552,1091,'_contact_title','field_5de7981e06057'),(20553,1091,'contact_intro','Contact text...'),(20554,1091,'_contact_intro','field_5de7983506058'),(20555,1091,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(20556,1091,'_news_button','field_5de8329896e02'),(20557,1091,'timeline_intro','Introduction of timeline detail...'),(20558,1091,'_timeline_intro','field_5de98f5fb1781'),(20559,1091,'timeline_pic','477'),(20560,1091,'_timeline_pic','field_5de98f72b1782'),(20561,1091,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(20562,1091,'_timeline_button','field_5de99363677f8'),(20563,1091,'banner_image_position','center'),(20564,1091,'_banner_image_position','field_5f3bc4757dd02'),(20565,1091,'services_title','Our services'),(20566,1091,'_services_title','field_5f20f3cd80eb2'),(20567,1091,'services_items_0_services_item_image','1061'),(20568,1091,'_services_items_0_services_item_image','fie