22617,2163,'gh_block_home_2_help_url','#'),(122618,2163,'_gh_block_home_2_help_url','field_65262cf4143e4'),(122619,2163,'gh_block_home','3'),(122620,2163,'_gh_block_home','field_65262c8a143e1'),(122621,2163,'turn_on_insights',''),(122622,2163,'_turn_on_insights','field_645c4a2e654a6'),(122623,2163,'report_questions','a:3:{i:0;s:4:\"1997\";i:1;s:4:\"2067\";i:2;s:4:\"2089\";}'),(122624,2163,'_report_questions','field_6109ed5e02e5a'),(122625,2163,'intro_text','The Disability Dialogue is a place where people with disabilities, their families, organisations providing support, academics, and the wider community come together to work on things that matter to us.\r\n\r\nThe Dialogue is a hub of knowledge and collaboration, separate from government, where we work together to come up. With new ideas on important topics. Our ideas can make a big difference in how services and systems are set up for people with disabilities.'),(122626,2163,'_intro_text','field_66441acfe963c'),(122629,2164,'footnotes',''),(122631,2164,'banner_head',''),(122632,2164,'_banner_head','field_5b568121a8ffe'),(122633,2164,'banner_sub',''),(122634,2164,'_banner_sub','field_5b568139fd366'),(122635,2164,'banner_button','<a class=\"btn btn-home\" style=\"width: 200px;\" href=\"#project\">Sign the petition</a>'),(122636,2164,'_banner_button','field_5b568147fd367'),(122637,2164,'support_section_title','How can Lifestart support you?'),(122638,2164,'_support_section_title','field_5b67c7d060398'),(122639,2164,'support_left_title','Services'),(122640,2164,'_support_left_title','field_5b67c298e7f8f'),(122641,2164,'support_left_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy.'),(122642,2164,'_support_left_cont','field_5b67c5f6e7f91'),(122643,2164,'support_left_button','<a class=\"btn btn-green\" href=\"/services/\">View all services</a>'),(122644,2164,'_support_left_button','field_5b67c60ae7f92'),(122645,2164,'support_ctr_title','Talk to us'),(122646,2164,'_support_ctr_title','field_5b67c62a58af3'),(122647,2164,'support_ctr_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut laoreet.'),(122648,2164,'_support_ctr_cont','field_5b67c63158af4'),(122649,2164,'support_ctr_button','<a class=\"btn btn-orange\" href=\"/supports/\">Find us</a>'),(122650,2164,'_support_ctr_button','field_5b67c63658af5'),(122651,2164,'support_right_title','NDIS Registered provider'),(122652,2164,'_support_right_title','field_5b67c6a38c064'),(122653,2164,'support_right_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut.'),(122654,2164,'_support_right_cont','field_5b67c6c98c065'),(122655,2164,'support_right_button','<a class=\"btn btn-blue\" href=\"#\">Read more</a>'),(122656,2164,'_support_right_button','field_5b67c6dd8c066'),(122657,2164,'first_image_title','Lifestart is about supporting young children'),(122658,2164,'_first_image_title','field_5b67ca606afc4'),(122659,2164,'first_image_cont','from 0-24 years living with disabilities and their familes'),(122660,2164,'_first_image_cont','field_5b67caff6afc5'),(122661,2164,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(122662,2164,'_first_image_button','field_5b67cb0d6afc6'),(122663,2164,'second _image_title','Lifestart is about supporting young children'),(122664,2164,'_second _image_title','field_5b67cb20ddf9a'),(122665,2164,'second_image_cont','from 0-24 years living with disabilities and their familes'),(122666,2164,'_second_image_cont','field_5b67cb24ddf9b'),(122667,2164,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(122668,2164,'_second_image_button','field_5b67cb29ddf9c'),(122669,2164,'second_image_title','Lifestart is about supporting young children'),(122670,2164,'_second_image_title','field_5b67cb20ddf9a'),(122671,2164,'page_col_image','412'),(122672,2164,'_page_col_image','field_5de6546e7c63a'),(122673,2164,'page_col_image_3','437'),(122674,2164,'_page_col_image_3','field_5de6e3998e07e'),(122675,2164,'sec_2_title','Community'),(122676,2164,'_sec_2_title','field_5de6e3ef2798f'),(122677,2164,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(122678,2164,'_sec_2_text','field_5de78dc89e613'),(122679,2164,'sec_3_title','The Project'),(122680,2164,'_sec_3_title','field_5de6e3d37d8da'),(122681,2164,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(122682,2164,'_sec_3_text','field_5de6e4044e5e8'),(122683,2164,'page_col_image_2','436'),(122684,2164,'_page_col_image_2','field_5de6546e7c63a'),(122685,2164,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(122686,2164,'_sec_2_button','field_5de6e58c86706'),(122687,2164,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(122688,2164,'_sec_3_button','field_5de6e5a243c03'),(122689,2164,'page_col_image_4','455'),(122690,2164,'_page_col_image_4','field_5de70801090ce'),(122691,2164,'sec_4_title','Location'),(122692,2164,'_sec_4_title','field_5de7082a12a81'),(122693,2164,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(122694,2164,'_sec_4_text','field_5de7084812a82'),(122695,2164,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(122696,2164,'_sec_4_button','field_5de7085e12a83'),(122697,2164,'news_title','Project updates'),(122698,2164,'_news_title','field_5de78da3aabb9'),(122699,2164,'sec_2_text_copy',''),(122700,2164,'_sec_2_text_copy','field_5de78dc89e613'),(122701,2164,'timeline-title','Timeline'),(122702,2164,'_timeline-title','field_5de78df29e615'),(122703,2164,'timeline_title','Timeline'),(122704,2164,'_timeline_title','field_5de78df29e615'),(122705,2164,'contact_title','Contact us'),(122706,2164,'_contact_title','field_5de7981e06057'),(122707,2164,'contact_intro','Contact text...'),(122708,2164,'_contact_intro','field_5de7983506058'),(122709,2164,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(122710,2164,'_news_button','field_5de8329896e02'),(122711,2164,'timeline_intro','Introduction of timeline detail...'),(122712,2164,'_timeline_intro','field_5de98f5fb1781'),(122713,2164,'timeline_pic','477'),(122714,2164,'_timeline_pic','field_5de98f72b1782'),(122715,2164,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(122716,2164,'_timeline_button','field_5de99363677f8'),(122717,2164,'banner_image_position','center'),(122718,2164,'_banner_image_position','field_5f3bc4757dd02'),(122719,2164,'services_title','Our services'),(122720,2164,'_services_title','field_5f20f3cd80eb2'),(122721,2164,'services_items_0_services_item_image','1061'),(122722,2164,'_services_items_0_services_item_image','field_5f2121355be14'),(122723,2164,'services_items_0_sservices_item_title','1300 Telephone counselling line'),(122724,2164,'_services_items_0_sservices_item_title','field_605089efca82e'),(122725,2164,'services_items_0_services_item_text',''),(122726,2164,'_services_items_0_services_item_text','field_5f2121535be15'),(122727,2164,'services_items_0_services_link_url','#'),(122728,2164,'_services_item