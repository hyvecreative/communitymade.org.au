second_image_title','Lifestart is about supporting young children'),(21816,1102,'_second_image_title','field_5b67cb20ddf9a'),(21817,1102,'page_col_image','412'),(21818,1102,'_page_col_image','field_5de6546e7c63a'),(21819,1102,'page_col_image_3','437'),(21820,1102,'_page_col_image_3','field_5de6e3998e07e'),(21821,1102,'sec_2_title','Community'),(21822,1102,'_sec_2_title','field_5de6e3ef2798f'),(21823,1102,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(21824,1102,'_sec_2_text','field_5de78dc89e613'),(21825,1102,'sec_3_title','The Project'),(21826,1102,'_sec_3_title','field_5de6e3d37d8da'),(21827,1102,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(21828,1102,'_sec_3_text','field_5de6e4044e5e8'),(21829,1102,'page_col_image_2','436'),(21830,1102,'_page_col_image_2','field_5de6546e7c63a'),(21831,1102,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(21832,1102,'_sec_2_button','field_5de6e58c86706'),(21833,1102,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(21834,1102,'_sec_3_button','field_5de6e5a243c03'),(21835,1102,'page_col_image_4','455'),(21836,1102,'_page_col_image_4','field_5de70801090ce'),(21837,1102,'sec_4_title','Location'),(21838,1102,'_sec_4_title','field_5de7082a12a81'),(21839,1102,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(21840,1102,'_sec_4_text','field_5de7084812a82'),(21841,1102,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(21842,1102,'_sec_4_button','field_5de7085e12a83'),(21843,1102,'news_title','Project updates'),(21844,1102,'_news_title','field_5de78da3aabb9'),(21845,1102,'sec_2_text_copy',''),(21846,1102,'_sec_2_text_copy','field_5de78dc89e613'),(21847,1102,'timeline-title','Timeline'),(21848,1102,'_timeline-title','field_5de78df29e615'),(21849,1102,'timeline_title','Timeline'),(21850,1102,'_timeline_title','field_5de78df29e615'),(21851,1102,'contact_title','Contact us'),(21852,1102,'_contact_title','field_5de7981e06057'),(21853,1102,'contact_intro','Contact text...'),(21854,1102,'_contact_intro','field_5de7983506058'),(21855,1102,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(21856,1102,'_news_button','field_5de8329896e02'),(21857,1102,'timeline_intro','Introduction of timeline detail...'),(21858,1102,'_timeline_intro','field_5de98f5fb1781'),(21859,1102,'timeline_pic','477'),(21860,1102,'_timeline_pic','field_5de98f72b1782'),(21861,1102,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(21862,1102,'_timeline_button','field_5de99363677f8'),(21863,1102,'banner_image_position','center'),(21864,1102,'_banner_image_position','field_5f3bc4757dd02'),(21865,1102,'services_title','Our services'),(21866,1102,'_services_title','field_5f20f3cd80eb2'),(21867,1102,'services_items_0_services_item_image','1061'),(21868,1102,'_services_items_0_services_item_image','field_5f2121355be14'),(21869,1102,'services_items_0_sservices_item_title','1300 Telephone counselling line'),(21870,1102,'_services_items_0_sservices_item_title','field_605089efca82e'),(2