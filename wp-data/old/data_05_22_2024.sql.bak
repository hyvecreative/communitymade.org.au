0,1940,'problem_icons_3_prob_concerded_text','are highly concerned'),(91671,1940,'_problem_icons_3_prob_concerded_text','field_640fa10181d96'),(91672,1940,'problem_icons_3_prob_issue_text',''),(91673,1940,'_problem_icons_3_prob_issue_text','field_640fa11a81d97'),(91674,1940,'problem_icons_0_prob_concerned_text','House prices have doubled in a decade'),(91675,1940,'_problem_icons_0_prob_concerned_text','field_640fa10181d96'),(91676,1940,'problem_icons_1_prob_concerned_text','The gap between rich and poor is growing'),(91677,1940,'_problem_icons_1_prob_concerned_text','field_640fa10181d96'),(91678,1940,'problem_icons_2_prob_concerned_text','Construction of social housing is down'),(91679,1940,'_problem_icons_2_prob_concerned_text','field_640fa10181d96'),(91680,1940,'problem_icons_3_prob_concerned_text','Banks are making more than ever from housing'),(91681,1940,'_problem_icons_3_prob_concerned_text','field_640fa10181d96'),(91682,1940,'monitor_content','The Australian Housing Monitor is a large, nationally-representative survey covering public experiences and attitudes toward housing related issues. Questions range from how well the respondent is keeping up with their mortgage/rent, to what they think about social housing construction.\r\n\r\nA broad range of demographic criteria are included, such as gender, location, age, income, voting preference, educational level, tenure type, and employment status. These variables allow CEH researchers to understand the trends and diversity of opinion around the country.\r\n\r\nIt also incorporates questions from previous surveys to track trends over time.\r\nThe inaugural poll was conducted by Essential in December 2022, and was completed by 4,735 people.'),(91683,1940,'_monitor_content','field_640fcc4014404'),(91684,1940,'problem_head','Housing in Australia is not working, and Australians are concerned.'),(91685,1940,'_problem_head','field_641935436aded'),(91686,1940,'problem_signoff','Explore the research showing how concerned Australians are our about the housing situation.'),(91687,1940,'_problem_signoff','field_641935626adee'),(91688,1940,'sections','a:2:{i:0;s:4:\"hero\";i:1;s:9:\"news_grid\";}'),(91689,1940,'_sections','field_5dafb40b8143a'),(91690,1940,'sections_0_is_full_height','1'),(91691,1940,'_sections_0_is_full_height','field_61d6f6fd5a37e'),(91692,1940,'sections_0_image','1648'),(91693,1940,'_sections_0_image','field_61d6f6d45a37d'),(91694,1940,'sections_0_heading','Heading'),(91695,1940,'_sections_0_heading','field_61d6f69e5a379'),(91696,1940,'sections_0_subtitle','Ya ya '),(91697,1940,'_sections_0_subtitle','field_61d6f6ac5a37a'),(91698,1940,'sections_0_link_one',''),(91699,1940,'_sections_0_link_one','field_61d6f6b55a37b'),(91700,1940,'sections_0_link_two',''),(91701,1940,'_sections_0_link_two','field_61d6f6c35a37c'),(91702,1940,'sections_1_select_categories','a:1:{i:0;s:2:\"27\";}'),(91703,1940,'_sections_1_select_categories','field_637f04483b63b'),(91704,1940,'intro_head_major','Super Consumers Australia is <span>fighting</span> to ensure that the superannuation industry is <span>held accountable</span> for the outcomes they deliver to Australian consumers.'),(91705,1940,'_intro_head_major','field_64e828783ad9f'),(91706,1940,'intro_head_minor','We want super to work for everyone—not just super fund companies. With our research, journalism and campaigns we are creating the trustworthy and transparent superannuation system we all deserve.'),(91707,1940,'_intro_head_minor','field_64e8288c3ada0'),(91708,1940,'intro_icons_0_int_icon','1922'),(91709,1940,'_intro_icons_0_int_icon','field_64e828b33ada2'),(91710,1940,'intro_icons_0_int_icon_text','At 1,727,000 square kilometres, we’re 2.5 times the size of Texas. <span>Yeeha!</span>'),(91711,1940,'_intro_icons_0_int_icon_text','field_64e828e33ada3'),(91712,1940,'intro_icons_1_int_icon','1920'),(91713,1940,'_intro_icons_1_int_icon','field_64e828b33ada2'),(91714,1940,'intro_icons_1_int_icon_text','We have twice as many species of native plant and animal as any other Australian state or territory.'),(91715,1940,'_intro_icons_1_int_icon_text','field_64e828e33ada3'),(91716,1940,'intro_icons_2_int_icon','1921'),(91717,1940,'_intro_icons_2_int_icon','field_64e828b33ada2'),(91718,1940,'intro_icons_2_int_icon_text','We have less land classified as ‘protected’ than any other state or territory.'),(91719,1940,'_intro_icons_2_int_icon_text','field_64e828e33ada3'),(91720,1940,'intro_icons','3'),(91721,1940,'_intro_icons','field_64e828963ada1'),(91722,1940,'threat_head_major','What we stand to lose if we don’t act soon to protect beautiful Queensland:'),(91723,1940,'_threat_head_major','field_64ec258d9dbd1'),(91724,1940,'threats_icons','3'),(91725,1940,'_threats_icons','field_64ec2551a93f9'),(91726,1940,'threats_icons_0_thr_icon','1819'),(91727,1940,'_threats_icons_0_thr_icon','field_64ec2551a93fa'),(91728,1940,'threats_icons_0_thr_icon_text','The rich cultural heritage of our First Nations people and their continuous ties to country, dating back more than 50,000 years.'),(91729,1940,'_threats_icons_0_thr_icon_text','field_64ec2551a93fb'),(91730,1940,'threats_icons_1_thr_icon','1819'),(91731,1940,'_threats_icons_1_thr_icon','field_64ec2551a93fa'),(91732,1940,'threats_icons_1_thr_icon_text','Thousands of species of plant and animal which are now classified as threatened or endangered in Queensland.'),(91733,1940,'_threats_icons_1_thr_icon_text','field_64ec2551a93fb'),(91734,1940,'threats_icons_2_thr_icon','1819'),(91735,1940,'_threats_icons_2_thr_icon','field_64ec2551a93fa'),(91736,1940,'threats_icons_2_thr_icon_text','The access to nature that is central to the Queensland way of life.'),(91737,1940,'_threats_icons_2_thr_icon_text','field_64ec2551a93fb'),(91738,1940,'threat_icons_0_thr_icon',''),(91739,1940,'_threat_icons_0_thr_icon','field_64ec2551a93fa'),(91740,1940,'threat_icons_0_thr_icon_text','The <span>rich cultural heritage</span> of our First Nations people and their continuous ties to country, 