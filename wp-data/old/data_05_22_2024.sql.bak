lts'),(51428,1656,'_survey_index_7_survey_url_text','field_629456584223a'),(51429,1656,'survey_index','8'),(51430,1656,'_survey_index','field_6294561242236'),(51431,1656,'report_title','Download the report'),(51432,1656,'_report_title','field_62f30edfb57e1'),(51433,1656,'report_intro','Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus massa erat, consectetur at semper at, feugiat vel orci. '),(51434,1656,'_report_intro','field_62f30eedb57e2'),(51435,1656,'report_link_url','#'),(51436,1656,'_report_link_url','field_62f30ef4b57e3'),(51437,1656,'report_link_text','Download'),(51438,1656,'_report_link_text','field_62f30f01b57e4'),(51443,6,'solutions_content','The housing system is complex, and no one solution will solve the complex problems we now face but there are some critical first steps to be taken now.\r\n<ul>\r\n 	<li>Set out an ambitious national housing agreement between commonwealth and state governments with targets and funding for the construction of affordable homes.</li>\r\n 	<li>Phase out tax breaks for property investors and using the increase in revenue to build more public housing.</li>\r\n 	<li>Establish laws which limit rental increases beyond what is fair.</li>\r\n 	<li>Rebalance tenancy laws to provide renters with more security and control, such as eliminating no grounds evictions.</li>\r\n 	<li>Phase out stamp duty and replace it with a broad-based land tax.</li>\r\n</ul>\r\n<h4>While there are many opinions on what policy changes will fix the housing market, doing nothing is not an option.</h4>'),(51444,6,'_solutions_content','field_640e8b307a958'),(51445,1662,'banner_head',''),(51446,1662,'_banner_head','field_5b568121a8ffe'),(51447,1662,'banner_sub',''),(51448,1662,'_banner_sub','field_5b568139fd366'),(51449,1662,'banner_button','<a class=\"btn btn-home\" style=\"width: 200px;\" href=\"#project\">Sign the petition</a>'),(51450,1662,'_banner_button','field_5b568147fd367'),(51451,1662,'support_section_title','How can Lifestart support you?'),(51452,1662,'_support_section_title','field_5b67c7d060398'),(51453,1662,'support_left_title','Services'),(51454,1662,'_support_left_title','field_5b67c298e7f8f'),(51455,1662,'support_left_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy.'),(51456,1662,'_support_left_cont','field_5b67c5f6e7f91'),(51457,1662,'support_left_button','<a class=\"btn btn-green\" href=\"/services/\">View all services</a>'),(51458,1662,'_support_left_button','field_5b67c60ae7f92'),(51459,1662,'support_ctr_title','Talk to us'),(51460,1662,'_support_ctr_title','field_5b67c62a58af3'),(51461,1662,'support_ctr_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut laoreet.'),(51462,1662,'_support_ctr_cont','field_5b67c63158af4'),(51463,1662,'support_ctr_button','<a class=\"btn btn-orange\" href=\"/supports/\">Find us</a>'),(51464,1662,'_support_ctr_button','field_5b67c63658af5'),(51465,1662,'support_right_title','NDIS Registered provider'),(51466,1662,'_support_right_title','field_5b67c6a38c064'),(51467,1662,'support_right_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut.'),(51468,1662,'_support_right_cont','field_5b67c6c98c065'),(51469,1662,'support_right_button','<a class=\"btn btn-blue\" href=\"#\">Read more</a>'),(51470,1662,'_support_right_button','field_5b67c6dd8c066'),(51471,1662,'first_image_title','Lifestart is about supporting young children'),(51472,1662,'_first_image_title','field_5b67ca606afc4'),(51473,1662,'first_image_cont','from 0-24 years living with disabilities and their familes'),(51474,1662,'_first_image_cont','field_5b67caff6afc5'),(51475,1662,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(51476,1662,'_first_image_button','field_5b67cb0d6afc6'),(51477,1662,'second _image_title','Lifestart is about supporting young children'),(51478,1662,'_second _image_title','field_5b67cb20ddf9a'),(51479,1662,'second_image_cont','from 0-24 years living with disabilities and their familes'),(51480,1662,'_second_image_cont','field_5b67cb24ddf9b'),(51481,1662,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(51482,1662,'_second_image_button','field_5b67cb29ddf9c'),(51483,1662,'second_image_title','Lifestart is about supporting young children'),(51484,1662,'_second_image_title','field_5b67cb20ddf9a'),(51485,1662,'page_col_image','412'),(51486,1662,'_page_col_image','field_5de6546e7c63a'),(51487,1662,'page_col_image_3','437'),(51488,1662,'_page_col_image_3','field_5de6e3998e07e'),(51489,1662,'sec_2_title','Community'),(51490,1662,'_sec_2_title','field_5de6e3ef2798f'),(51491,1662,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(51492,1662,'_sec_2_text','field_5de78dc89e613'),(51493,1662,'sec_3_title','The Project'),(51494,1662,'_sec_3_title','field_5de6e3d37d8da'),(51495,1662,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(51496,1662,'_sec_3_text','field_5de6e4044e5e8'),(51497,1662,'page_col_image_2','436'),(51498,1662,'_page_col_image_2','field_5de6546e7c63a'),(51499,1662,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(51500,1662,'_sec_2_button','field_5de6e58c86706'),(51501,1662,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(51502,1662,'_sec_3_button','field_5de6e5a243c03'),(51503,1662,'page_col_image_4','455'),(51504,1662,'_page_col_image_4','field_5de70801090ce'),(51505,1662,'sec_4_title','Location'),(51506,1662,'_sec_4_title','field_5de7082a12a81'),(51507,1662,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(51508,1662,'_sec_4_text','field_5de7084812a82'),(51509,1662,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(51510,1662,'_sec_4_button','field_5de7085e12a83'),(51511,1662,'news_title','Project updates'),(51512,1662,'_news_title','field_5de78da3aabb9'),(51513,1662,'sec_2_text_copy',''),(51514,1662,'_sec_2_text_copy','field_5de78dc89e613'),(51515,1662,'timeline-title','Timeline'),(51516,1662,'_timeline-title','field_5de78df29e615'),(51517,1662,'timeline_title','Timeline'),(51518,1662,'_timeline_title','field_5de78df29e615'),(51519,1662,'contact_title','Contact us'),(51520,1662,'_contact_title','field_5de7981e06057'),(51521,1662,'contact_intro','Contact text...'),(51522,1662,'_contact_intro','field_5de7983506058'),(51523,1662,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(51524,1662,'_news_button','field_5de8329896e02'),(51525,1662,'timeline_intro','Introduction of timeline detail...'),(51526,1662,'_timeline_intro','field_5de98f5fb1781'),(51527,1662,'timeline_pic','477'),(51528,1662,'_timeline_pic','field_5de98f72b1782'),(51529,1662,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(51530,1662,'_timeline_button','field_5de99363677f8'),(51531,1662,'banner_image_position','center'),(51532,1662,'_banner_image_position','field_5f3bc4757dd02'),(51533,1662,'services_title','Our services'),(51534,1662,'_services_title','field_5f20f3cd80eb2')