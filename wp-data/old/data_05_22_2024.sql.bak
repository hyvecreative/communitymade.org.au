d_5b67c63158af4'),(116799,2125,'support_ctr_button','<a class=\"btn btn-orange\" href=\"/supports/\">Find us</a>'),(116800,2125,'_support_ctr_button','field_5b67c63658af5'),(116801,2125,'support_right_title','NDIS Registered provider'),(116802,2125,'_support_right_title','field_5b67c6a38c064'),(116803,2125,'support_right_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut.'),(116804,2125,'_support_right_cont','field_5b67c6c98c065'),(116805,2125,'support_right_button','<a class=\"btn btn-blue\" href=\"#\">Read more</a>'),(116806,2125,'_support_right_button','field_5b67c6dd8c066'),(116807,2125,'first_image_title','Lifestart is about supporting young children'),(116808,2125,'_first_image_title','field_5b67ca606afc4'),(116809,2125,'first_image_cont','from 0-24 years living with disabilities and their familes'),(116810,2125,'_first_image_cont','field_5b67caff6afc5'),(116811,2125,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(116812,2125,'_first_image_button','field_5b67cb0d6afc6'),(116813,2125,'second _image_title','Lifestart is about supporting young children'),(116814,2125,'_second _image_title','field_5b67cb20ddf9a'),(116815,2125,'second_image_cont','from 0-24 years living with disabilities and their familes'),(116816,2125,'_second_image_cont','field_5b67cb24ddf9b'),(116817,2125,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(116818,2125,'_second_image_button','field_5b67cb29ddf9c'),(116819,2125,'second_image_title','Lifestart is about supporting young children'),(116820,2125,'_second_image_title','field_5b67cb20ddf9a'),(116821,2125,'page_col_image','412'),(116822,2125,'_page_col_image','field_5de6546e7c63a'),(116823,2125,'page_col_image_3','437'),(116824,2125,'_page_col_image_3','field_5de6e3998e07e'),(116825,2125,'sec_2_title','Community'),(116826,2125,'_sec_2_title','field_5de6e3ef2798f'),(116827,2125,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(116828,2125,'_sec_2_text','field_5de78dc89e613'),(116829,2125,'sec_3_title','The Project'),(116830,2125,'_sec_3_title','field_5de6e3d37d8da'),(116831,2125,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(116832,2125,'_sec_3_text','field_5de6e4044e5e8'),(116833,2125,'page_col_image_2','436'),(116834,2125,'_page_col_image_2','field_5de6546e7c63a'),(116835,2125,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(116836,2125,'_sec_2_button','field_5de6e58c86706'),(116837,2125,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(116838,2125,'_sec_3_button','field_5de6e5a243c03'),(116839,2125,'page_col_image_4','455'),(116840,2125,'_page_col_image_4','field_5de70801090ce'),(116841,2125,'sec_4_title','Location'),(116842,2125,'_sec_4_title','field_5de7082a12a81'),(116843,2125,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(116844,2125,'_sec_4_text','field_5de7084812a82'),(116845,2125,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(116846,2125,'_sec_4_button','field_5de7085e12a83'),(116847,2125,'news_title',