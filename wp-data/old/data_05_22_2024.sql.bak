640fa0dd81d95'),(81556,1914,'problem_icons_3_prob_concerded_text','are highly concerned'),(81557,1914,'_problem_icons_3_prob_concerded_text','field_640fa10181d96'),(81558,1914,'problem_icons_3_prob_issue_text',''),(81559,1914,'_problem_icons_3_prob_issue_text','field_640fa11a81d97'),(81560,1914,'problem_icons_0_prob_concerned_text','House prices have doubled in a decade'),(81561,1914,'_problem_icons_0_prob_concerned_text','field_640fa10181d96'),(81562,1914,'problem_icons_1_prob_concerned_text','The gap between rich and poor is growing'),(81563,1914,'_problem_icons_1_prob_concerned_text','field_640fa10181d96'),(81564,1914,'problem_icons_2_prob_concerned_text','Construction of social housing is down'),(81565,1914,'_problem_icons_2_prob_concerned_text','field_640fa10181d96'),(81566,1914,'problem_icons_3_prob_concerned_text','Banks are making more than ever from housing'),(81567,1914,'_problem_icons_3_prob_concerned_text','field_640fa10181d96'),(81568,1914,'monitor_content','The Australian Housing Monitor is a large, nationally-representative survey covering public experiences and attitudes toward housing related issues. Questions range from how well the respondent is keeping up with their mortgage/rent, to what they think about social housing construction.\r\n\r\nA broad range of demographic criteria are included, such as gender, location, age, income, voting preference, educational level, tenure type, and employment status. These variables allow CEH researchers to understand the trends and diversity of opinion around the country.\r\n\r\nIt also incorporates questions from previous surveys to track trends over time.\r\nThe inaugural poll was conducted by Essential in December 2022, and was completed by 4,735 people.'),(81569,1914,'_monitor_content','field_640fcc4014404'),(81570,1914,'problem_head','Housing in Australia is not working, and Australians are concerned.'),(81571,1914,'_problem_head','field_641935436aded'),(81572,1914,'problem_signoff','Explore the research showing how concerned Australians are our about the housing situation.'),(81573,1914,'_problem_signoff','field_641935626adee'),(81574,1914,'sections','a:2:{i:0;s:4:\"hero\";i:1;s:9:\"news_grid\";}'),(81575,1914,'_sections','field_5dafb40b8143a'),(81576,1914,'sections_0_is_full_height','1'),(81577,1914,'_sections_0_is_full_height','field_61d6f6fd5a37e'),(81578,1914,'sections_0_image','1648'),(81579,1914,'_sections_0_image','field_61d6f6d45a37d'),(81580,1914,'sections_0_heading','Heading'),(81581,1914,'_sections_0_heading','field_61d6f69e5a379'),(81582,1914,'sections_0_subtitle','Ya ya '),(81583,1914,'_sections_0_subtitle','field_61d6f6ac5a37a'),(81584,1914,'sections_0_link_one',''),(81585,1914,'_sections_0_link_one','field_61d6f6b55a37b'),(81586,1914,'sections_0_link_two',''),(81587,1914,'_sections_0_link_two','field_61d6f6c35a37c'),(81588,1914,'sections_1_select_categories','a:1:{i:0;s:2:\"27\";}'),(81589,1914,'_sections_1_select_categories','field_637f04483b63b'),(81590,1914,'intro_head_major','Queenslanders are known for both our love of the great outdoors and our state pride…'),(81591,1914,'_intro_head_major','field_64e828783ad9f'),(81592,1914,'intro_head_minor','But there’s a few things you might not know about our beautiful state.'),(81593,1914,'_intro_head_minor','field_64e8288c3ada0'),(81594,1914,'intro_icons_0_int_icon',''),(81595,1914,'_intro_icons_0_int_icon','field_64e828b33ada2'),(81596,1914,'intro_icons_0_int_icon_text','At 1,727,000 square kilometres, we’re 2.5 times the size of Texas. <span>Yeeha!</span>'),(81597,1914,'_intro_icons_0_int_icon_text','field_64e828e33ada3'),(81598,1914,'intro_icons_1_int_icon',''),(81599,1914,'_intro_icons_1_int_icon','field_64e828b33ada2'),(81600,1914,'intro_icons_1_int_icon_text','We have twice as many species of native plant and animal as any other Australian state or territory.'),(81601,1914,'_intro_icons_1_int_icon_text','field_64e828e33ada3'),(81602,1914,'intro_icons_2_int_icon',''),(81603,1914,'_intro_icons_2_int_