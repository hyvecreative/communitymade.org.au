2158,'_second_image_title','field_5b67cb20ddf9a'),(119128,2158,'page_col_image','412'),(119129,2158,'_page_col_image','field_5de6546e7c63a'),(119130,2158,'page_col_image_3','437'),(119131,2158,'_page_col_image_3','field_5de6e3998e07e'),(119132,2158,'sec_2_title','Community'),(119133,2158,'_sec_2_title','field_5de6e3ef2798f'),(119134,2158,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(119135,2158,'_sec_2_text','field_5de78dc89e613'),(119136,2158,'sec_3_title','The Project'),(119137,2158,'_sec_3_title','field_5de6e3d37d8da'),(119138,2158,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(119139,2158,'_sec_3_text','field_5de6e4044e5e8'),(119140,2158,'page_col_image_2','436'),(119141,2158,'_page_col_image_2','field_5de6546e7c63a'),(119142,2158,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(119143,2158,'_sec_2_button','field_5de6e58c86706'),(119144,2158,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(119145,2158,'_sec_3_button','field_5de6e5a243c03'),(119146,2158,'page_col_image_4','455'),(119147,2158,'_page_col_image_4','field_5de70801090ce'),(119148,2158,'sec_4_title','Location'),(119149,2158,'_sec_4_title','field_5de7082a12a81'),(119150,2158,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(119151,2158,'_sec_4_text','field_5de7084812a82'),(119152,2158,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(119153,2158,'_sec_4_button','field_5de7085e12a83'),(119154,2158,'news_title','Project updates'),(119155,2158,'_news_title','field_5de78da3aabb9'),(119156,2158,'sec_2_text_copy',''),(119157,2158,'_sec_2_text_copy','field_5de78dc89e613'),(119158,2158,'timeline-title','Timeline'),(119159,2158,'_timeline-title','field_5de78df29e615'),(119160,2158,'timeline_title','Timeline'),(119161,2158,'_timeline_title','field_5de78df29e615'),(119162,2158,'contact_title','Contact us'),(119163,2158,'_contact_title','field_5de7981e06057'),(119164,2158,'contact_intro','Contact text...'),(119165,2158,'_contact_intro','field_5de7983506058'),(119166,2158,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(119167,2158,'_news_button','field_5de8329896e02'),(119168,2158,'timeline_intro','Introduction of timeline detail...'),(119169,2158,'_timeline_intro','field_5de98f5fb1781'),(119170,2158,'timeline_pic','477'),(119171,2158,'_timeline_pic','field_5de98f72b1782'),(119172,2158,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(119173,2158,'_timeline_button','field_5de99363677f8'),(119174,2158,'banner_image_position','center'),(119175,2158,'_banner_image_position','field_5f3bc4757dd02'),(119176,2158,'services_title','Our services'),(119177,2158,'_services_title','field_5f20f3cd80eb2'),(119178,2158,'services_items_0_services_item_image','1061'),(119179,2158,'_services_items_0_services_item_image','field_5f2121355be14'),(119180,2158,'services_items_0_sservices_item_title','1300 Telephone counselling line'),(119181,2158,'_services_items_0_sservices_item_title','field_605089efca82e'),(119182,2158,'services_