c5'),(25413,1127,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(25414,1127,'_first_image_button','field_5b67cb0d6afc6'),(25415,1127,'second _image_title','Lifestart is about supporting young children'),(25416,1127,'_second _image_title','field_5b67cb20ddf9a'),(25417,1127,'second_image_cont','from 0-24 years living with disabilities and their familes'),(25418,1127,'_second_image_cont','field_5b67cb24ddf9b'),(25419,1127,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(25420,1127,'_second_image_button','field_5b67cb29ddf9c'),(25421,1127,'second_image_title','Lifestart is about supporting young children'),(25422,1127,'_second_image_title','field_5b67cb20ddf9a'),(25423,1127,'page_col_image','412'),(25424,1127,'_page_col_image','field_5de6546e7c63a'),(25425,1127,'page_col_image_3','437'),(25426,1127,'_page_col_image_3','field_5de6e3998e07e'),(25427,1127,'sec_2_title','Community'),(25428,1127,'_sec_2_title','field_5de6e3ef2798f'),(25429,1127,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(25430,1127,'_sec_2_text','field_5de78dc89e613'),(25431,1127,'sec_3_title','The Project'),(25432,1127,'_sec_3_title','field_5de6e3d37d8da'),(25433,1127,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(25434,1127,'_sec_3_text','field_5de6e4044e5e8'),(25435,1127,'page_col_image_2','436'),(25436,1127,'_page_col_image_2','field_5de6546e7c63a'),(25437,1127,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(25438,1127,'_sec_2_button','field_5de6e58c86706'),(25439,1127,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(25440,1127,'_sec_3_button','field_5de6e5a243c03'),(25441,1127,'page_col_image_4','455'),(25442,1127,'_page_col_image_4','field_5de70801090ce'),(25443,1127,'sec_4_title','Location'),(25444,1127,'_sec_4_title','field_5de7082a12a81'),(25445,1127,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(25446,1127,'_sec_4_text','field_5de7084812a82'),(25447,1127,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(25448,1127,'_sec_4_button','field_5de7085e12a83'),(25449,1127,'news_title','Project updates'),(25450,1127,'_news_title','field_5de78da3aabb9'),(25451,1127,'sec_2_text_copy',''),(25452,1127,'_sec_2_text_copy','field_5de78dc89e613'),(25453,1127,'timeline-title','Timeline'),(25454,1127,'_timeline-title','field_5de78df29e615'),(25455,1127,'timeline_title','Timeline'),(25456,1127,'_timeline_title','field_5de78df29e615'),(25457,1127,'contact_title','Contact us'),(25458,1127,'_contact_title','field_5de7981e06057'),(25459,1127,'contact_intro','Contact text...'),(25460,1127,'_contact_intro','field_5de7983506058'),(25461,1127,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(25462,1127,'_news_button','field_5de8329896e02'),(25463,1127,'timeline_intro','Introduction of timeline detail...'),(25464,1127,'_timeline_intro','field_5de98f5fb1781'),(25465,1127,'timeline_pic','477'),(25466,1127,'_timeline_pic','field_5de98f72b1782'),(25467,1127,'timeline_button','<a class=\"btn btn-home btn-news\" h