26987,2202,'_turn_on_insights','field_645c4a2e654a6'),(126988,2202,'report_questions','a:3:{i:0;s:4:\"1997\";i:1;s:4:\"2067\";i:2;s:4:\"2089\";}'),(126989,2202,'_report_questions','field_6109ed5e02e5a'),(126990,2202,'intro_text','The Disability Dialogue is a place where people with disabilities, their families, organisations providing support, academics, and the wider community come together to work on things that matter to us.\r\n\r\nThe Dialogue is a hub of knowledge and collaboration, separate from government, where we work together to come up. With new ideas on important topics. Our ideas can make a big difference in how services and systems are set up for people with disabilities.'),(126991,2202,'_intro_text','field_66441acfe963c'),(126992,2202,'word_link','#'),(126993,2202,'_word_link','field_6646c69723804'),(126994,2202,'pdf_link','#'),(126995,2202,'_pdf_link','field_6646c6da23805'),(126998,2203,'footnotes',''),(127000,2203,'banner_head',''),(127001,2203,'_banner_head','field_5b568121a8ffe'),(127002,2203,'banner_sub',''),(127003,2203,'_banner_sub','field_5b568139fd366'),(127004,2203,'banner_button','<a class=\"btn btn-home\" style=\"width: 200px;\" href=\"#project\">Sign the petition</a>'),(127005,2203,'_banner_button','field_5b568147fd367'),(127006,2203,'support_section_title','How can Lifestart support you?'),(127007,2203,'_support_section_title','field_5b67c7d060398'),(127008,2203,'support_left_title','Services'),(127009,2203,'_support_left_title','field_5b67c298e7f8f'),(127010,2203,'support_left_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy.'),(127011,2203,'_support_left_cont','field_5b67c5f6e7f91'),(127012,2203,'support_left_button','<a class=\"btn btn-green\" href=\"/services/\">View all services</a>'),(127013,2203,'_support_left_button','field_5b67c60ae7f92'),(127014,2203,'support_ctr_title','Talk to us'),(127015,2203,'_support_ctr_title','field_5b67c62a58af3'),(127016,2203,'support_ctr_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut laoreet.'),(127017,2203,'_support_ctr_cont','field_5b67c63158af4'),(127018,2203,'support_ctr_button','<a class=\"btn btn-orange\" href=\"/supports/\">Find us</a>'),(127019,2203,'_support_ctr_button','field_5b67c63658af5'),(127020,2203,'support_right_title','NDIS Registered provider'),(127021,2203,'_support_right_title','field_5b67c6a38c064'),(127022,2203,'support_right_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut.'),(127023,2203,'_support_right_cont','field_5b67c6c98c065'),(127024,2203,'support_right_button','<a class=\"btn btn-blue\" href=\"#\">Read more</a>'),(127025,2203,'_support_right_button','field_5b67c6dd8c066'),(127026,2203,'first_image_title','Lifestart is about supporting young children'),(127027,2203,'_first_image_title','field_5b67ca606afc4'),(127028,2203,'first_image_cont','from 0-24 years living with disabilities and their familes'),(127029,2203,'_first_image_cont','field_5b67caff6afc5'),(127030,2203,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(127031,2203,'_first_image_button','field_5b67cb0d6afc6'),(127032,2203,'second _image_title','Lifestart is about supporting young children'),(127033,2203,'_second _image_title','field_5b67cb20ddf9a'),(127034,2203,'second_image_cont','from 0-24 years living with disabilities and their familes'),(127035,2203,'_second_image_cont','field_5b67cb24ddf9b'),(127036,2203,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(127037,2203,'_second_image_button','field_5b67cb29ddf9c'),(127038,2203,'second_image_title','Lifestart is about supporting young children'),(127039,2203,'_second_image_title','field_5b67cb20ddf9a'),(127040,2203,'page_col_image','412'),(127041,2203,'_page_col_image','field_5de6546e7c63a'),(127042,2203,'page_col_image_3','437'),(127043,2203,'_page_col_image_3','field_5de6e3998e07e'),(127044,2203,'sec_2_title','Community'),(127045,2203,'_sec_2_title','field_5de6e3ef2798f'),(127046,2203,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(127047,2203,'_sec_2_text','field_5de78dc89e613'),(127048,2203,'sec_3_title','The Project'),(127049,2203,'_sec_3_title','field_5de6e3d37d8da'),(127050,2203,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(127051,2203,'_sec_3_text','field_5de6e4044e5e8'),(127052,2203,'page_col_image_2','436'),(127053,2203,'_page_col_image_2','field_5de6546e7c63a'),(127054,2203,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(127055,2203,'_sec_2_button','field_5de6e58c86706'),(127056,2203,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(127057,2203,'_sec_3_button','field_5de6e5a243c03'),(127058,2203,'page_col_image_4','455'),(127059,2203,'_page_col_image_4','field_5de70801090ce'),(127060,2203,'sec_4_title','Location'),(127061,2203,'_sec_4_title','field_5de7082a12a81'),(127062,2203,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(127063,2203,'_sec_4_text','field_5de7084812a82'),(127064,2203,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(127065,2203,'_sec_4_button','field_5de7085e12a83'),(127066,2203,'news_title','Project updates'),(127067,2203,'_news_title','field_5de78da3aabb9'),(127068,2203,'sec_2_text_copy',''),(127069,2203,'_sec_2_text_copy','field_5de78dc89e613'),(127070,2203,'timeline-title','Timeline'),(127071,2203,'_timeline-title','field_5de78df29e615'),(127072,2203,'timeline_title','Timeline'),(127073,2203,'_timeline_title','field_5de78df29e615'),(127074,2203,'contact_title','Contact us'),(127075,2203,'_contact_title','field_5de7981e06057'),(127076,2203,'contact_intro','Contact text...'),(127077,2203,'_contact_intro','field_5de7983506058'),(127078,2203,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(127079,2203,'_news_button','field_5de8329896e02'),(127080,2203,'timeline_intro','Introduction of timeline detail...'),(127081,2203,'_timeline_intro','field_5de98f5fb1781'),(127082,2203,'timeline_pic','477'),(127083,2203,'_timeline_pic','field_5de98f72b1782'),(127084,2203,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(127085,2203,'_timeline_button','field_5de99363677f8'),(127086,2203,'banner_image_position','center'),(127087,2203,'_banner_image_position','field_5f3bc4757dd02'),(127088,2203,'services_title','Our services'),(127089,2203,'_services_title','field_5f20f3cd80eb2'),(127090,2203,'services_items_0_services_item_image','1061'),(127091,2203,'_services_items_0_services_item_image','field_5f2121355be14'),(127092,2203,'services_items_0_sservices_item_title','1300 Telephone counselling line'),(127093,2203,'_services_items_0_sservices_item_title','field_605089efca82e'),(127094,2203,'services_items_0_services_item_text',''),(127095,2203,'_services_items_0_services_item_text','field_5f2121535be15'),(127096,2203,'services_items_0_services_link_url','#'),(127097,2203,'_services_items_0_services_link_url','field_6050866041225'),(127098,2203,'services_items_0