7501,1873,'_survey_index','field_6294561242236'),(77502,1873,'report_title','Download the report'),(77503,1873,'_report_title','field_62f30edfb57e1'),(77504,1873,'report_intro','Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus massa erat, consectetur at semper at, feugiat vel orci. '),(77505,1873,'_report_intro','field_62f30eedb57e2'),(77506,1873,'report_link_url','#'),(77507,1873,'_report_link_url','field_62f30ef4b57e3'),(77508,1873,'report_link_text','Download'),(77509,1873,'_report_link_text','field_62f30f01b57e4'),(77510,1873,'solutions_content','The housing system is complex, and no one solution will solve the complex problems we now face but there are some critical first steps to be taken now.\r\n<ul>\r\n 	<li>Set out an ambitious national housing agreement between commonwealth and state governments with targets and funding for the construction of affordable homes.</li>\r\n 	<li>Phase out tax breaks for property investors and using the increase in revenue to build more public housing.</li>\r\n 	<li>Establish laws which limit rental increases beyond what is fair.</li>\r\n 	<li>Rebalance tenancy laws to provide renters with more security and control, such as eliminating no grounds evictions.</li>\r\n 	<li>Phase out stamp duty and replace it with a broad-based land tax.</li>\r\n</ul>\r\n<h4>While there are many opinions on what policy changes will fix the housing market, doing nothing is not an option.</h4>'),(77511,1873,'_solutions_content','field_640e8b307a958'),(77512,1873,'problem_icons_0_prob_icon','1699'),(77513,1873,'_problem_icons_0_prob_icon','field_640fa0291d519'),(77514,1873,'problem_icons_0_prob_concerned_stat','70% highly concerned'),(77515,1873,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(77516,1873,'problem_icons_0_prob_concerded_text','are highly concerned'),(77517,1873,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(77518,1873,'problem_icons_0_prob_issue_text',''),(77519,1873,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(77520,1873,'problem_icons','4'),(77521,1873,'_problem_icons','field_640fa0191d518'),(77522,1873,'ceh_content_left',''),(77523,1873,'_ceh_content_left','field_640e97e8f1c8c'),(77524,1873,'ceh_content_right',''),(77525,1873,'_ceh_content_right','field_640e97fdf1c8d'),(77526,1873,'pc_content_left',''),(77527,1873,'_pc_content_left','field_640e983bf1c8f'),(77528,1873,'pc_content_right',''),(77529,1873,'_pc_content_right','field_640e984df1c90'),(77530,1873,'problem_icons_1_prob_icon','1699'),(77531,1873,'_problem_icons_1_prob_icon','field_640fa0291d519'),(77532,1873,'problem_icons_1_prob_concerned_stat','69% highly concerned'),(77533,1873,'_problem_icons_1_prob_concerned_stat','field_640fa0dd81d95'),(77534,1873,'problem_icons_1_prob_concerded_text','are highly concerned'),(77535,1873,'_problem_icons_1_prob_concerded_text','field_640fa10181d96'),(77536,1873,'problem_icons_1_prob_issue_text',''),(77537,1873,'_problem_icons_1_prob_issue_text','field_640fa11a81d97'),(77538,1873,'problem_icons_2_prob_icon','1699'),(77539,1873,'_problem_icons_2_prob_icon','field_640fa0291d519'),(77540,1873,'problem_icons_2_prob_concerned_stat','64% highly concerned'),(77541,1873,'_problem_icons_2_prob_concerned_stat','field_640fa0dd81d95'),(77542,1873,'problem_icons_2_prob_concerded_text','are highly concerned'),(77543,1873,'_problem_icons_2_prob_concerded_text','field_640fa10181d96'),(77544,1873,'problem_icons_2_prob_issue_text',''),(77545,1873,'_problem_icons_2_prob_issue_text','field_640fa11a81d97'),(77546,1873,'problem_icons_3_prob_icon','1699'),(77547,1873,'_problem_icons_3_prob_icon','field_640fa0291d519'),(77548,1873,'problem_icons_3_prob_concerned_stat','64% highly concerned'),(77549,1873,'_problem_icons_3_prob_concerned_stat','field_640fa0dd81d95'),(77550,1873,'problem_icons_3_prob_concerded_text','are highly concerned'),(77551,1873,'_problem_icons_3_prob_concerded_text','field_640fa10181d96'),(77552,1873,'problem_icons_3_prob_issue_text',''),(77553,1873,'_problem_icons_3_prob_issue_text','field_640fa11a81d97'),(77554,1873,'problem_icons_0_prob_concerned_text','House prices have doubled in a decade'),(77555,1873,'_problem_icons_0_prob_concerned_text','field_640fa10181d96'),(77556,1873,'problem_icons_1_prob_concerned_text','The gap between rich and poor is growing'),(77557,1873,'_problem_icons_1_prob_concerned_text','field_640fa10181d96'),(77558,1873,'problem_icons_2_prob_concerned_text','Construction of social housing is down'),(77559,1873,'_problem_icons_2_prob_concerned_text','field_640fa10181d96'),(77560,1873,'problem_icons_3_prob_concerned_text','Banks are making more than ever from housing'),(77561,1873,'_problem_icons_3_prob_concerned_text','field_640fa10181d96'),(77562,1873,'monitor_content','The Australian Housing Monitor is a large, nationally-representative survey covering public experiences and attitudes toward housing related issues. Questions range from how well the respondent is keeping up with their mortgage/rent, to what they think about social housing construction.\r\n\r\nA broad range of demographic criteria are included, such as gender, location, age, income, voting preference, educational level, tenure type, and employment status. These variables allow CEH researchers to understand the trends and diversity of opinion around the country.\r\n\r\nIt also incorporates questions from previous surveys to track trends over time.\r\nThe inaugural poll was conducted by Essential in December 2022, and was completed by 4,735 people.'),(77563,1873,'_monitor_content','field_640fcc4014404'),(77564,1873,'problem_head','Housing in Australia is not working, and Australians are concerned.'),(77565,1873,'_problem_head','field_641935436aded'),(77566,1873,'problem_signoff','Explore the research showing how concerned Australians are our about the housing situation.'),(77567,1873,'_problem_signoff','field_641935626adee'),(77568,1873,'sections','a:2:{i:0;s:4:\"hero\";i:1;s:9:\"news_grid\";}'),(77569,1873,'_sections','field_5dafb40b8143a'),(77570,1873,'sections_0_is_full_height','1'),(77571,1873,'_sections_0_is_full_height','field_61d6f6fd5a37e'),(77572,1873,'sections_0_image','1648'),(77573,1873,'_sections_0_image','field_61d6f6d45a37d'),(77574,1873,'sections_0_heading','Heading'),(77575,1873,'_sections_0_heading','field_61d6f69e5a379'),(77576,1873,'sections_0_subtitle','Ya ya '),(77577,1873,'_sections_0_subtitle','field_61d6f6ac5a37a'),(77578,1873,'sections_0_link_one',''),(77579,1873,'_sections_0_link_one','field_61d6f6b55a37b'),(77580,1873,'sections_0_link_two',''),(77581,1873,'_sections_0_link_two','field_61d6f6c35a37c'),(77582,1873,'sections_1_select_categories','a:1:{i:0;s:2:\"27\";}'),(77583,1873,'_sections_1_select_categories','field_637f04483b63b'),(77584,1873,'intro_head_major','Queenslanders are known for both our love of the great outdoors and our state pride…'),(77585,1873,'_intro_head_major','field_64e828783ad9f'),(77586,1873,'intro_head_minor','But there’s a few things you might not know about our beautiful state.'),(77587,1873,'_intro_head_minor','field_64e8288c3ada0'),(77588,1873,'intro_icons_0_int_icon','1806'),(77589,1873,'_intro_icons_0_int_icon','field_64e828b33ada2'),(77590,1873,'intro_icons_0_int_icon_text','At 1,727,000 square kilometres, we’re 2.5 times the size of Texas. <span>Yeeha!</span>'),(77591,1873,'_intro_icons_0_int_icon_text','field_64e828e33ada3'),(77592,1873,'intro_icons_1_int_icon','1806'),(77593,1873,'_intro_icons_1_int_icon','field_64e828b33ada2'),(77594,1873,'intro_icons_1_int_icon_text','We have twice as many species of native plant and animal as any other Australian state or territory.'),(77595,1873,'_intro_icons_1_int_icon_text','field_64e828e33ada3'),(77596,1873,'intro_icons_2_int_icon','1806'),(77597,1873,'_intro_icons_2_int_icon','field_64e828b33ada2'),(77598,1873,'intro_icons_2_int_icon_text','We have less land classified as ‘protected’ than any other state or territory.'),(77599,1873,'_intro_icons_2_int_icon_text','field_64