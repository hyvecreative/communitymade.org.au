8c86706'),(111712,2069,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(111713,2069,'_sec_3_button','field_5de6e5a243c03'),(111714,2069,'page_col_image_4','455'),(111715,2069,'_page_col_image_4','field_5de70801090ce'),(111716,2069,'sec_4_title','Location'),(111717,2069,'_sec_4_title','field_5de7082a12a81'),(111718,2069,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(111719,2069,'_sec_4_text','field_5de7084812a82'),(111720,2069,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(111721,2069,'_sec_4_button','field_5de7085e12a83'),(111722,2069,'news_title','Project updates'),(111723,2069,'_news_title','field_5de78da3aabb9'),(111724,2069,'sec_2_text_copy',''),(111725,2069,'_sec_2_text_copy','field_5de78dc89e613'),(111726,2069,'timeline-title','Timeline'),(111727,2069,'_timeline-title','field_5de78df29e615'),(111728,2069,'timeline_title','Timeline'),(111729,2069,'_timeline_title','field_5de78df29e615'),(111730,2069,'contact_title','Contact us'),(111731,2069,'_contact_title','field_5de7981e06057'),(111732,2069,'contact_intro','Contact text...'),(111733,2069,'_contact_intro','field_5de7983506058'),(111734,2069,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(111735,2069,'_news_button','field_5de8329896e02'),(111736,2069,'timeline_intro','Introduction of timeline detail...'),(111737,2069,'_timeline_intro','field_5de98f5fb1781'),(111738,2069,'timeline_pic','477'),(111739,2069,'_timeline_pic','field_5de98f72b1782'),(111740,2069,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(111741,2069,'_timeline_button','field_5de99363677f8'),(111742,2069,'banner_