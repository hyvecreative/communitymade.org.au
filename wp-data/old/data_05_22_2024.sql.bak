38c064'),(28163,1220,'support_right_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut.'),(28164,1220,'_support_right_cont','field_5b67c6c98c065'),(28165,1220,'support_right_button','<a class=\"btn btn-blue\" href=\"#\">Read more</a>'),(28166,1220,'_support_right_button','field_5b67c6dd8c066'),(28167,1220,'first_image_title','Lifestart is about supporting young children'),(28168,1220,'_first_image_title','field_5b67ca606afc4'),(28169,1220,'first_image_cont','from 0-24 years living with disabilities and their familes'),(28170,1220,'_first_image_cont','field_5b67caff6afc5'),(28171,1220,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(28172,1220,'_first_image_button','field_5b67cb0d6afc6'),(28173,1220,'second _image_title','Lifestart is about supporting young children'),(28174,1220,'_second _image_title','field_5b67cb20ddf9a'),(28175,1220,'second_image_cont','from 0-24 years living with disabilities and their familes'),(28176,1220,'_second_image_cont','field_5b67cb24ddf9b'),(28177,1220,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(28178,1220,'_second_image_button','field_5b67cb29ddf9c'),(28179,1220,'second_image_title','Lifestart is about supporting young children'),(28180,1220,'_second_image_title','field_5b67cb20ddf9a'),(28181,1220,'page_col_image','412'),(28182,1220,'_page_col_image','field_5de6546e7c63a'),(28183,1220,'page_col_image_3','437'),(28184,1220,'_page_col_image_3','field_5de6e3998e07e'),(28185,1220,'sec_2_title','Community'),(28186,1220,'_sec_2_title','field_5de6e3ef2798f'),(28187,1220,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(28188,1220,'_sec_2_text','field_5de78dc89e613'),(28189,1220,'sec_3_title','The Project'),(28190,1220,'_sec_3_title','field_5de6e3d37d8da'),(28191,1220,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(28192,1220,'_sec_3_text','field_5de6e4044e5e8'),(28193,1220,'page_col_image_2','436'),(28194,1220,'_page_col_image_2','field_5de6546e7c63a'),(28195,1220,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(28196,1220,'_sec_2_button','field_5de6e58c86706'),(28197,1220,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(28198,1220,'_sec_3_button','field_5de6e5a243c03'),(28199,1220,'page_col_image_4','455'),(28200,1220,'_page_col_image_4','field_5de70801090ce'),(28201,1220,'sec_4_title','Location'),(28202,1220,'_sec_4_title','field_5de7082a12a81'),(28203,1220,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(28204,1220,'_sec_4_text','field_5de7084812a82'),(28205,1220,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(28206,1220,'_sec_4_button','field_5de7085e12a83'),(28207,1220,'news_title','Project updates'),(28208,1220,'_news_title','field_5de78da3aabb9'),(28209,1220,'sec_2_text_copy',''),(28210,1220,'_sec_2_text_copy','field_5de78dc89e613'),(28211,1220,'timeline-title','Timeline'),(28212,1220,'_timeline-title','field_5de78df29e615'),(28213,1220,'timeline_title','Timeline'),(28214,1220,'_timeline_title','field_5de