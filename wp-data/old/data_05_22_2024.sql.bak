,(121193,2161,'_banner_button','field_5b568147fd367'),(121194,2161,'support_section_title','How can Lifestart support you?'),(121195,2161,'_support_section_title','field_5b67c7d060398'),(121196,2161,'support_left_title','Services'),(121197,2161,'_support_left_title','field_5b67c298e7f8f'),(121198,2161,'support_left_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy.'),(121199,2161,'_support_left_cont','field_5b67c5f6e7f91'),(121200,2161,'support_left_button','<a class=\"btn btn-green\" href=\"/services/\">View all services</a>'),(121201,2161,'_support_left_button','field_5b67c60ae7f92'),(121202,2161,'support_ctr_title','Talk to us'),(121203,2161,'_support_ctr_title','field_5b67c62a58af3'),(121204,2161,'support_ctr_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut laoreet.'),(121205,2161,'_support_ctr_cont','field_5b67c63158af4'),(121206,2161,'support_ctr_button','<a class=\"btn btn-orange\" href=\"/supports/\">Find us</a>'),(121207,2161,'_support_ctr_button','field_5b67c63658af5'),(121208,2161,'support_right_title','NDIS Registered provider'),(121209,2161,'_support_right_title','field_5b67c6a38c064'),(121210,2161,'support_right_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut.'),(121211,2161,'_support_right_cont','field_5b67c6c98c065'),(121212,2161,'support_right_button','<a class=\"btn btn-blue\" href=\"#\">Read more</a>'),(121213,2161,'_support_right_button','field_5b67c6dd8c066'),(121214,2161,'first_image_title','Lifestart is about supporting young children'),(121215,2161,'_first_image_title','field_5b67ca606afc4'),(121216,2161,'first_image_cont','from 0-24 years living with disabilities and their familes'),(121217,2161,'_first_image_cont','field_5b67caff6afc5'),(121218,2161,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(121219,2161,'_first_image_button','field_5b67cb0d6afc6'),(121220,2161,'second _image_title','Lifestart is about supporting young children'),(121221,2161,'_second _image_title','field_5b67cb20ddf9a'),(121222,2161,'second_image_cont','from 0-24 years living with disabilities and their familes'),(121223,2161,'_second_image_cont','field_5b67cb24ddf9b'),(121224,2161,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(121225,2161,'_second_image_button','field_5b67cb29ddf9c'),(121226,2161,'second_image_title','Lifestart is about supporting young children'),(121227,2161,'_second_image_title','field_5b67cb20ddf9a'),(121228,2161,'page_col_image','412'),(121229,2161,'_page_col_image','field_5de6546e7c63a'),(121230,2161,'page_col_image_3','437'),(121231,2161,'_page_col_image_3','field_5de6e3998e07e'),(121232,2161,'sec_2_title','Community'),(121233,2161,'_sec_2_title','field_5de6e3ef2798f'),(121234,2161,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(121235,2161,'_sec_2_text','field_5de78dc89e613'),(121236,2161,'sec_3_title','The Project'),(121237,2161,'_sec_3_title','field_5de6e3d37d8da'),(121238,2161,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(121239,2161,'_sec_3_text','field_5de6e4044e5e8'),(121240,2161,'page_col_image_2','436'),(121241,2161,'_page_col_image_2','field_5de6546e7c63a'),(121242,2161,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(121243,2161,'_sec_2_button','field_5de6e58c86706'),(121244,2161,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(121245,2161,'_sec_3_button','field_5de6e5a243c03'),(121246,2161,'page_col_image_4','455'),(121247,2161,'_page_col_image_4','field_5de70801090ce'),(121248,2161,'sec_4_title','Location'),(121249,2161,'_sec_4_title','field_5de7082a12a81'),(121250,2161,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(121251,2161,'_sec_4_text','field_5de7084812a82'),(121252,2161,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(121253,2161,'_sec_4_button','field_5de7085e12a83'),(121254,2161,'news_title','Project updates'),(121255,2161,'_news_title','field_5de78da3aabb9'),(121256,2161,'sec_2_text_copy',''),(121257,2161,'_sec_2_text_copy','field_5de78dc89e613'),(121258,2161,'timeline-title','Timeline'),(121259,2161,'_timeline-title','field_5de78df29e615'),(121260,2161,'timeline_title','Timeline'),(121261,2161,'_timeline_title','field_5de78df29e615'),(121262,2161,'contact_title','Contact us'),(121263,2161,'_contact_title','field_5de7981e06057'),(121264,2161,'contact_intro','Contact text...'),(121265,2161,'_contact_intro','field_5de7983506058'),(121266,2161,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(121267,2161,'_news_button','field_5de8329896e02'),(121268,2161,'timeline_intro','Introduction of timeline detail...'),(121269,2161,'_timeline_intro','field_5de98f5fb1781'),(121270,2161,'timeline_pic','477'),(121271,2161,'_timeline_pic','field_5de98f72b1782'),(121272,2161,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(121273,2161,'_timeline_button','field_5de99363677f8'),(121274,2161,