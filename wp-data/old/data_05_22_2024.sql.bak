le','field_5b67cb20ddf9a'),(71260,1864,'page_col_image','412'),(71261,1864,'_page_col_image','field_5de6546e7c63a'),(71262,1864,'page_col_image_3','437'),(71263,1864,'_page_col_image_3','field_5de6e3998e07e'),(71264,1864,'sec_2_title','Community'),(71265,1864,'_sec_2_title','field_5de6e3ef2798f'),(71266,1864,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(71267,1864,'_sec_2_text','field_5de78dc89e613'),(71268,1864,'sec_3_title','The Project'),(71269,1864,'_sec_3_title','field_5de6e3d37d8da'),(71270,1864,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(71271,1864,'_sec_3_text','field_5de6e4044e5e8'),(71272,1864,'page_col_image_2','436'),(71273,1864,'_page_col_image_2','field_5de6546e7c63a'),(71274,1864,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(71275,1864,'_sec_2_button','field_5de6e58c86706'),(71276,1864,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(71277,1864,'_sec_3_button','field_5de6e5a243c03'),(71278,1864,'page_col_image_4','455'),(71279,1864,'_page_col_image_4','field_5de70801090ce'),(71280,1864,'sec_4_title','Location'),(71281,1864,'_sec_4_title','field_5de7082a12a81'),(71282,1864,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(71283,1864,'_sec_4_text','field_5de7084812a82'),(71284,1864,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(71285,1864,'_sec_4_button','field_5de7085e12a83'),(71286,1864,'news_title','Project updates'),(71287,1864,'_news_title','field_5de78da3aabb9'),(71288,1864,'sec_2_text_copy',''),(71289,1864,'_sec_2_text_copy','field_5de78dc89e613'),(71290,1864,'timeline-title','Timeline'),(71291,1864,'_timeline-title','field_5de78df29e615'),(71292,1864,'timeline_title','Timeline'),(71293,1864,'_timeline_title','field_5de78df29e615'),(71294,1864,'contact_title','Contact us'),(71295,1864,'_contact_title','field_5de7981e06057'),(71296,1864,'contact_intro','Contact text...'),(71297,1864,'_contact_intro','field_5de7983506058'),(71298,1864,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(71299,1864,'_news_button','field_5de8329896e02'),(71300,1864,'timeline_intro','Introduction of timeline detail...'),(71301,1864,'_timeline_intro','field_5de98f5fb1781'),(71302,1864,'timeline_pic','477'),(71303,1864,'_timeline_pic','field_5de98f72b1782'),(71304,1864,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(71305,1864,'_timeline_button','field_5de99363677f8'),(71306,1864,'banner_image_position','center'),(71307,1864,'_banner_image_position','field_5f3bc4757dd02'),(71308,1864,'services_title','Our services'),(71309,1864,'_services_title','field_5f20f3cd80eb2'),(71310,1864,'services_items_0_services_item_image','1061'),(71311,1864,'_services_items_0_services_item_image','field_5f2121355be14'),(71312,1864,'services_items_0_sservices_item_title','1300 Telephone counselling line'),(71313,1864,'_services_items_0_sservices_item_title','field_605089efca82e'),(71314,1864,'services_items_0_services_item_text',''),(71315,1864,'_services_items_0_services_item_t