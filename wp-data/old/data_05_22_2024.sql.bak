f9c'),(18960,1062,'second_image_title','Lifestart is about supporting young children'),(18961,1062,'_second_image_title','field_5b67cb20ddf9a'),(18962,1062,'page_col_image','412'),(18963,1062,'_page_col_image','field_5de6546e7c63a'),(18964,1062,'page_col_image_3','437'),(18965,1062,'_page_col_image_3','field_5de6e3998e07e'),(18966,1062,'sec_2_title','Community'),(18967,1062,'_sec_2_title','field_5de6e3ef2798f'),(18968,1062,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(18969,1062,'_sec_2_text','field_5de78dc89e613'),(18970,1062,'sec_3_title','The Project'),(18971,1062,'_sec_3_title','field_5de6e3d37d8da'),(18972,1062,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(18973,1062,'_sec_3_text','field_5de6e4044e5e8'),(18974,1062,'page_col_image_2','436'),(18975,1062,'_page_col_image_2','field_5de6546e7c63a'),(18976,1062,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(18977,1062,'_sec_2_button','field_5de6e58c86706'),(18978,1062,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(18979,1062,'_sec_3_button','field_5de6e5a243c03'),(18980,1062,'page_col_image_4','455'),(18981,1062,'_page_col_image_4','field_5de70801090ce'),(18982,1062,'sec_4_title','Location'),(18983,1062,'_sec_4_title','field_5de7082a12a81'),(18984,