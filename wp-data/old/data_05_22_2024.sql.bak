ey_index_6_survey_title','field_6294564042238'),(78782,1876,'survey_index_6_survey_url','#'),(78783,1876,'_survey_index_6_survey_url','field_6294564e42239'),(78784,1876,'survey_index_6_survey_url_text','View Results'),(78785,1876,'_survey_index_6_survey_url_text','field_629456584223a'),(78786,1876,'survey_index_7_survey_icon','1493'),(78787,1876,'_survey_index_7_survey_icon','field_6294562942237'),(78788,1876,'survey_index_7_survey_title','Going Off-grid'),(78789,1876,'_survey_index_7_survey_title','field_6294564042238'),(78790,1876,'survey_index_7_survey_url','#'),(78791,1876,'_survey_index_7_survey_url','field_6294564e42239'),(78792,1876,'survey_index_7_survey_url_text','View Results'),(78793,1876,'_survey_index_7_survey_url_text','field_629456584223a'),(78794,1876,'survey_index','8'),(78795,1876,'_survey_index','field_6294561242236'),(78796,1876,'report_title','Download the report'),(78797,1876,'_report_title','field_62f30edfb57e1'),(78798,1876,'report_intro','Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus massa erat, consectetur at semper at, feugiat vel orci. '),(78799,1876,'_report_intro','field_62f30eedb57e2'),(78800,1876,'report_link_url','#'),(78801,1876,'_report_link_url','field_62f30ef4b57e3'),(78802,1876,'report_link_text','Download'),(78803,1876,'_report_link_text','field_62f30f01b57e4'),(78804,1876,'solutions_content','The housing system is complex, and no one solution will solve the complex problems we now face but there are some critical first steps to be taken now.\r\n<ul>\r\n 	<li>Set out an ambitious national housing agreement between commonwealth and state governments with targets and funding for the construction of affordable homes.</li>\r\n 	<li>Phase out tax breaks for property investors and using the increase in revenue to build more public housing.</li>\r\n 	<li>Establish laws which limit rental increases beyond what is fair.</li>\r\n 	<li>Rebalance tenancy laws to provide renters with more security and control, such as eliminating no grounds evictions.</li>\r\n 	<li>Phase out stamp duty and replace it with a broad-based land tax.</li>\r\n</ul>\r\n<h4>While there are many opinions on what policy changes will fix the housing market, doing nothing is not an option.</h4>'),(78805,1876,'_solutions_content','field_640e8b307a958'),(78806,1876,'problem_icons_0_prob_icon','1699'),(78807,1876,'_problem_icons_0_prob_icon','field_640fa0291d519'),(78808,1876,'problem_icons_0_prob_concerned_stat','70% highly concerned'),(78809,1876,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(78810,1876,'problem_icons_0_prob_concerded_text','are highly concerned'),(78811,1876,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(78812,1876,'problem_icons_0_prob_issue_text',''),(78813,1876,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(78814,1876,'problem_icons','4'),(78815,1876,'_problem_icons','field_640fa0191d518'),(78816,1876,'ceh_content_left',''),(78817,1876,'_ceh_content_left','field_640e97e8f1c8c'),(78818,1876,'ceh_content_right',''),(78819,1876,'_ceh_content_right','field_640e97fdf1c8d'),(78820,1876,'pc_content_left',''),(78821,1876,'_pc_content_left','field_640e983bf1c8f'),(78822,1876,'pc_content_right',''),(78823,1876,'_pc_content_right','field_640e984df1c90'),(78824,1876,'problem_icons_1_prob_icon','1699'),(78825,1876,'_problem_icons_1_prob_icon','field_640fa0291d519'),(78826,1876,'problem_icons_1_prob_concerned_stat','69% highly concerned'),(78827,1876,'_problem_icons_1_prob_concerned_stat','field_640fa0dd81d95'),(78828,1876,'problem_icons_1_prob_concerded_text','are highly concerned'),(78829,1876,'_problem_icons_1_prob_concerded_text','field_640fa10181d96'),(78830,1876,'problem_icons_1_prob_issue_text',''),(78831,1876,'_problem_icons_1_prob_issue_text','field_640fa11a81d97'),(78832,1876,'problem_icons_2_prob_icon','1699'),(78833,1876,'_problem_icons_2_prob_icon','field_640fa0291d519'),(78834,1876,'problem_icons_2_prob_concerned_stat','64% highly concerned'),(78835,1876,'_problem_icons_2_prob_concerned_stat','field_640fa0dd81d95'),(78836,1876,'problem_icons_2_prob_concerded_text','are highly concerned'),(78837,1876,'_problem_icons_2_prob_concerded_text','field_640fa10181d96'),(78838,1876,'problem_icons_2_prob_issue_text',''),(78839,1876,'_problem_icons_2_prob_issue_text','field_640fa11a81d97'),(78840,1876,'problem_icons_3_prob_icon','1699'),(78841,1876,'_problem_icons_3_prob_icon','field_640fa0291d519'),(78842,1876,'problem_icons_3_prob_concerned_stat','64% highly concerned'),(78843,1876,'_problem_icons_3_prob_concerned_stat','field_640fa0dd81d95'),(78844,1876,'problem_icons_3_prob_concerded_text','are highly concerned'),(78845,1876,'_problem_icons_3_prob_concerded_text','field_640fa10181d96'),(78846,1876,'problem_icons_3_prob_issue_text',''),(78847,1876,'_problem_icons_3_prob_issue_text','field_640fa11a81d97'),(78848,1876,'problem_icons_0_prob_concerned_text','House prices have doubled in a decade'),(78849,1876,'_problem_icons_0_prob_concerned_text','field_640fa10181d96'),(78850,1876,'problem_icons_1_prob_concerned_text','The gap between rich and poor is growing'),(78851,1876,'_problem_icons_1_prob_concerned_text','field_640fa10181d96'),(78852,1876,'problem_icons_2_prob_concerned_text','Construction of social housing is down'),(78853,1876,'_problem_icons_2_prob_concerned_text','field_640fa10181d96'),(78854,1876,'problem_icons_3_prob_concerned_text','Banks are making more than ever from housing'),(78855,1876,'_problem_icons_3_prob_concerned_text','field_640fa10181d96'),(78856,1876,'monitor_content','The Australian Housing Monitor is a large, nationally-representative survey covering public experiences and attitudes toward housing related issues. Questions range from how well the respondent is keeping up with their mortgage/rent, to what they think about social housing construction.\r\n\r\nA broad range of demographic criteria are included, such as gender, location, age, income, voting preference, educational level, tenure type, and employment status. These variables allow CEH researchers to understand the trends and diversity of opinion around the country.\r\n\r\nIt also incorporates questions from previous surveys to track trends over time.\r\nThe inaugural poll was conducted by Essential in December 2022, and was completed by 4,735 people.'),(78857,1876,'_monitor_content','field_640fcc4014404'),(78858,1876,'problem_head','Housing in Australia is not working, and Australians are concerned.'),(78859,1876,'_problem_head','field_641935436aded'),(78860,1876,'problem_signoff','Explore the research showing how concerned Australians are our about the housing situation.'),(78861,1876,'_problem_signoff','field_641935626adee'),(78862,1876,'sections','a:2:{i:0;s:4:\"hero\";i:1;s:9:\"news_grid\";}'),(78863,1876,'_sections','field_5dafb40b8143a'),(78864,1876,'sections_0_is_full_height','1'),(78865,1876,'_sections_0_is_full_height','field_61d6f6fd5a37e'),(78866,1876,'sections_0_image','1648'),(78867,1876,'_sections_0_image','field_61d6f6d45a37d'),(78868,1876,'sections_0_heading','Heading'),(78869,1876,'_sections_0_heading','field_61d6f69e5a379'),(78870,1876,'sections_0_subtitle','Ya ya '),(78871,1876,'_sections_0_subtitle','field_61d6f6ac5a37a'),(78872,1876,'sections_0_link_one',''),(78873,1876,'_sections_0_link_one','field_61d6f6b55a37b'),(78874,1876,'sections_0_link_two',''),(78875,1876,'_sections_0_link_two','field_61d6f6c35a37c'),(78876,1876,'sections_1_select_categories','a:1:{i:0;s:2:\"27\";}'),(78877,1876,'_sections_1_select_categories','field_637f04483b63b'),(78878,1876,'intro_head_major','Queenslanders are known for both our love of the great outdoors and our state pride…'),(78879,1876,'_intro_head_major','field_64e828783ad9f'),(78880,1876,'intro_head_minor','But there’s a few things you might not know about our beautiful state.'),(78881,1876,'_intro_head_minor','field_64e8288c3ada0'),(78882,1876,'intro_icons_0_int_icon','1806'),(78883,1876,'_intro_icons_0_int_icon','field_64e828b33ada2'