ul state and safeguard our way of life.'),(125393,2177,'_signup_subhead','field_64fd834dd90ab'),(125394,2177,'signup_form',''),(125395,2177,'_signup_form','field_64fd8361d90ac'),(125396,2177,'signup_head','Join the campaign'),(125397,2177,'_signup_head','field_64fd83dc6b0b1'),(125398,2177,'boxes_section_title','Boxes'),(125399,2177,'_boxes_section_title','field_65262bbfd17fc'),(125400,2177,'intro_boxes_0_box_icon','1943'),(125401,2177,'_intro_boxes_0_box_icon','field_65262db5d36ee'),(125402,2177,'intro_boxes_0_box_title','Campaigning and policy'),(125403,2177,'_intro_boxes_0_box_title','field_65262d29ed8e3'),(125404,2177,'intro_boxes_0_box_dropdown','Our rigorous, conflict-free research and data analysis lifts the lid on fund performance, fees and insurance. Drawing on our policy expertise, we turn this analysis into action by using it to back reform and make super easier for people to understand. <a href=\"//localhost:4000:4000:4000:4000:4000/how/\">More</a> '),(125405,2177,'_intro_boxes_0_box_dropdown','field_65262dead0a0c'),(125406,2177,'intro_boxes_1_box_icon','1941'),(125407,2177,'_intro_boxes_1_box_icon','field_65262db5d36ee'),(125408,2177,'intro_boxes_1_box_title','Investigative journalism'),(125409,2177,'_intro_boxes_1_box_title','field_65262d29ed8e3'),(125410,2177,'intro_boxes_1_box_dropdown','Dropdown text'),(125411,2177,'_intro_boxes_1_box_dropdown','field_65262dead0a0c'),(125412,2177,'intro_boxes_2_box_icon','1937'),(125413,2177,'_intro_boxes_2_box_icon','field_65262db5d36ee'),(125414,2177,'intro_boxes_2_box_title','Research'),(125415,2177,'_intro_boxes_2_box_title','field_65262d29ed8e3'),(125416,2177,'intro_boxes_2_box_dropdown','Dropdown text'),(125417,2177,'_intro_boxes_2_box_dropdown','field_65262dead0a0c'),(125418,2177,'intro_boxes','3'),(125419,2177,'_intro_boxes','field_65262d14ed8e2'),(125420,2177,'get_help_section_title','Get Help'),(125421,2177,'_get_help_section_title','field_65262c35143de'),(125422,2177,'get_help_block_home',''),(125423,2177,'_get_help_block_home','field_65262c8a143e1'),(125424,2177,'gh_block_home_0_help_image','1956'),(125425,2177,'_gh_block_home_0_help_image','field_65262cd0143e2'),(125426,2177,'gh_block_home_0_help_title','How much do I need to retire? '),(125427,2177,'_gh_block_home_0_help_title','field_65262cec143e3'),(125428,2177,'gh_block_home_0_help_url','#'),(125429,2177,'_gh_block_home_0_help_url','field_65262cf4143e4'),(125430,2177,'gh_block_home_1_help_image','1962'),(125431,2177,'_gh_block_home_1_help_image','field_65262cd0143e2'),(125432,2177,'gh_block_home_1_help_title','I have a problem with  my super fund'),(125433,2177,'_gh_block_home_1_help_title','field_65262cec143e3'),(125434,2177,'gh_block_home_1_help_url','#'),(125435,2177,'_gh_block_home_1_help_url','field_65262cf4143e4'),(125436,2177,'gh_block_home_2_help_image','1961'),(125437,2177,'_gh_block_home_2_help_image','field_65262cd0143e2'),(125438,2177,'gh_block_home_2_help_title','How do I choose the right super? '),(125439,2177,'_gh_block_home_2_help_title','field_65262cec143e3'),(125440,2177,'gh_block_home_2_help_url','#'),(125441,2177,'_gh_block_home_2_help_url','field_65262cf4143e4'),(125442,2177,'gh_block_home','3'),(125443,2177,'_gh_block_home','field_65262c8a143e1'),(125444,2177,'turn_on_insights',''),(125445,2177,'_turn_on_insights','field_645c4a2e654a6'),(125446,2177,'report_questions','a:3:{i:0;s:4:\"1997\";i:1;s:4:\"2067\";i:2;s:4:\"2089\";}'),(125447,2177,'_report_questions','field_6109ed5e02e5a'),(125448,2177,'intro_text','The Disability Dialogue is a place where people with disabilities, their families, organisations providing support, academics, and the wider community come together to work on things that matter to us.\r\n\r\nThe Dialogue is a hub of knowledge and collaboration, separate from government, where we work together to come up. With new ideas on important topics. Our ideas can make a big difference in how services and systems are set up for people with disabilities.'),(125449,2177,'_intro_text','field_66441acfe963c'),(125450,2173,'_wp_trash_meta_status','publish'),(125451,2173,'_wp_trash_meta_time','1715751194'),(125452,2173,'_wp_desired_post_slug','new-project'),(125453,2179,'_wp_attached_file','2024/05/project-hero-wide.jpg'),(125454,2179,'_wp_attachment_metadata','a:6:{s:5:\"width\";i:660;s:6:\"height\";i:371;s:4:\"file\";s:29:\"2024/05/project-hero-wide.jpg\";s:8:\"filesize\";i:51166;s:5:\"sizes\";a:2:{s:9:\"thumbnail\";a:5:{s:4:\"file\";s:29:\"project-hero-wide-450x371.jpg\";s:5:\"width\";i:450;s:6:\"height\";i:371;s:9:\"mime-type\";s:10:\"image/jpeg\";s:8:\"filesize\";i:31642;}s:4:\"news\";a:5:{s:4:\"file\";s:29:\"project-hero-wide-565x367.jpg\";s:5:\"width\";i:565;s:6:\"height\";i:367;s:9:\"mime-type\";s:10:\"image/jpeg\";s:8:\"filesize\";i:35791;}}s:10:\"image_meta\";a:12:{s:8:\"aperture\";s:1:\"0\";s:6:\"credit\";s:0:\"\";s:6:\"camera\";s:0:\"\";s:7:\"caption\";s:0:\"\";s:17:\"created_timestamp\";s:1:\"0\";s:9:\"copyright\";s:0:\"\";s:12:\"focal_length\";s:1:\"0\";s:3:\"iso\";s:1:\"0\";s:13:\"shutter_speed\";s:1:\"0\";s:5:\"title\";s:0:\"\";s:11:\"orientation\";s:1:\"0\";s:8:\"keywords\";a:0:{}}}'),(125455,2180,'_wp_attached_file','2024/05/project-hero-sq.jpg'),(125456,2180,'_wp_attachment_metadata','a:6:{s:5:\"width\";i:447;s:6:\"height\";i:447;s:4:\"file\";s:27:\"2024/05/project-hero-sq.jpg\";s:8:\"filesize\";i:43408;s:5:\"sizes\";a:1:{s:4:\"news\";a:5:{s:4:\"file\";s:27:\"project-hero-sq-447x367.jpg\";s:5:\"width\";i:447;s:6:\"height\";i:367;s:9:\"mime-type\";s:10:\"image/jpeg\";s:8:\"filesize\";i:33093;}}s:10:\"image_meta\";a:12:{s:8:\"aperture\";s:1:\"0\";s:6:\"credit\";s:0:\"\";s:6:\"camera\";s:0:\"\";s:7:\"caption\";s:0:\"\";s:17:\"created_timestamp\";s:1:\"0\";s:9:\"copyright\";s:0:\"\";s:12:\"focal_length\";s:1:\"0\";s:3:\"iso\";s:1:\"0\";s:13:\"shutter_speed\";s:1:\"0\";s:5:\"title\";s:0:\"\";s:11:\"orientation\";s:1:\"0\";s:8:\"keywords\";a:0:{}}}'),(125457,2180,'_wp_attachment_image_alt','Man sits in engaged silence'),(125458,2149