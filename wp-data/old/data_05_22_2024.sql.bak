e_cont','from 0-24 years living with disabilities and their familes'),(98794,1960,'_second_image_cont','field_5b67cb24ddf9b'),(98795,1960,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(98796,1960,'_second_image_button','field_5b67cb29ddf9c'),(98797,1960,'second_image_title','Lifestart is about supporting young children'),(98798,1960,'_second_image_title','field_5b67cb20ddf9a'),(98799,1960,'page_col_image','412'),(98800,1960,'_page_col_image','field_5de6546e7c63a'),(98801,1960,'page_col_image_3','437'),(98802,1960,'_page_col_image_3','field_5de6e3998e07e'),(98803,1960,'sec_2_title','Community'),(98804,1960,'_sec_2_title','field_5de6e3ef2798f'),(98805,1960,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(98806,1960,'_sec_2_text','field_5de78dc89e613'),(98807,1960,'sec_3_title','The Project'),(98808,1960,'_sec_3_title','field_5de6e3d37d8da'),(98809,1960,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(98810,1960,'_sec_3_text','field_5de6e4044e5e8'),(98811,1960,'page_col_image_2','436'),(98812,1960,'_page_col_image_2','field_5de6546e7c63a'),(98813,1960,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(98814,1960,'_sec_2_button','field_5de6e58c86706'),(98815,1960,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(98816,1960,'_sec_3_button','field_5de6e5a243c03'),(98817,1960,'page_col_image_4','455'),(98818,1960,'_page_col_image_4','field_5de70801090ce'),(98819,1960,'sec_4_title','Location'),(98820,1960,'_sec_4_title','field_5de7082a12a81'),(98821,1960,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(98822,1960,'_sec_4_text','field_5de7084812a82'),(98823,1960,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(98824,1960,'_sec_4_button','field_5de7085e12a83'),(98825,1960,'news_title','Project updates'),(98826,1960,'_news_title','field_5de78da3aabb9'),(98827,1960,'sec_2_text_copy',''),(98828,1960,'_sec_2_text_copy','field_5de78dc89e613'),(98829,1960,'timeline-title','Timeline'),(98830,1960,'_timeline-title','field_5de78df29e615'),(98831,1960,'timeline_title','Timeline'),(98832,1960,'_timeline_title','field_5de78df29e615'),(98833,1960,'contact_title','Contact us'),(98834,1960,'_contact_title','field_5de7981e06057'),(98835,1960,'contact_intro','Contact text...'),(98836,1960,'_contact_intro','field_5de7983506058'),(98837,1960,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(98838,1960,'_news_button','field_5de8329896e02'),(98839,1960,'timeline_intro','Introduction of timeline detail...'),(98840,1960,'_timeline_intro','field_5de98f5fb1781'),(98841,1960,'timeline_pic','477'),(98842,1960,'_timeline_pic','field_5de98f72b1782'),(98843,1960,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(98844,1960,'_timeline_button','field_5de99363677f8'),(98845,1960,'banner_image_position','center'),(98846,1960,'_banner_image_position','field_5f3bc4757dd02'),(98847,1960,'services_title','Our services'),(98848,1960,'_services_title','field_5f20f3cd80eb2'),(98849,