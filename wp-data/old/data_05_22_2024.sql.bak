),(46320,1593,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(46321,1593,'_first_image_button','field_5b67cb0d6afc6'),(46322,1593,'second _image_title','Lifestart is about supporting young children'),(46323,1593,'_second _image_title','field_5b67cb20ddf9a'),(46324,1593,'second_image_cont','from 0-24 years living with disabilities and their familes'),(46325,1593,'_second_image_cont','field_5b67cb24ddf9b'),(46326,1593,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(46327,1593,'_second_image_button','field_5b67cb29ddf9c'),(46328,1593,'second_image_title','Lifestart is about supporting young children'),(46329,1593,'_second_image_title','field_5b67cb20ddf9a'),(46330,1593,'page_col_image','412'),(46331,1593,'_page_col_image','field_5de6546e7c63a'),(46332,1593,'page_col_image_3','437'),(46333,1593,'_page_col_image_3','field_5de6e3998e07e'),(46334,1593,'sec_2_title','Community'),(46335,1593,'_sec_2_title','field_5de6e3ef2798f'),(46336,1593,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(46337,1593,'_sec_2_text','field_5de78dc89e613'),(46338,1593,'sec_3_title','The Project'),(46339,1593,'_sec_3_title','field_5de6e3d37d8da'),(46340,1593,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(46341,1593,'_sec_3_text','field_5de6e4044e5e8'),(46342,1593,'page_col_image_2','436'),(46343,1593,'_page_col_image_2','field_5de6546e7c63a'),(46344,1593,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(46345,1593,'_sec_2_button','field_5de6e58c86706'),(46346,1593,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(46347,1593,'_sec_3_button','field_5de6e5a243c03'),(46348,1593,'page_col_image_4','455'),(46349,1593,'_page_col_image_4','field_5de70801090ce'),(46350,1593,'sec_4_title','Location'),(46351,1593,'_sec_4_title','field_5de7082a12a81'),(46352,1593,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(46353,1593,'_sec_4_text','field_5de7084812a82'),(46354,1593,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(46355,1593,'_sec_4_button','field_5de7085e12a83'),(46356,1593,'news_title','Project updates'),(46357,1593,'_news_title','field_5de78da3aabb9'),(46358,1593,'sec_2_text_copy',''),(46359,1593,'_sec_2_text_copy','field_5de78dc89e613'),(46360,1593,'timeline-title','Timeline'),(46361,1593,'_timeline-title','field_5de78df29e615'),(46362,1593,'timeline_title','Timeline'),(46363,1593,'_timeline_title','field_5de78df29e615'),(46364,1593,'contact_title','Contact us'),(46365,1593,'_contact_title','field_5de7981e06057'),(46366,1593,'contact_intro','Contact text...'),(46367,1593,'_contact_intro','field_5de7983506058'),(46368,1593,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(46369,1593,'_news_button','field_5de8329896e02'),(46370,1593,'timeline_intro','Introduction of timeline detail...'),(46371,1593,'_timeline_intro','field_5de98f5fb1781'),(46372,1593,'timeline_pic','477'),(46373,1593,'_timeline_pic','field_5de98f72b1782'),(46374,1593,'timeline_button','<a class=\"btn btn-home btn-news\" href