e_title','field_5b67cb20ddf9a'),(24815,1124,'page_col_image','412'),(24816,1124,'_page_col_image','field_5de6546e7c63a'),(24817,1124,'page_col_image_3','437'),(24818,1124,'_page_col_image_3','field_5de6e3998e07e'),(24819,1124,'sec_2_title','Community'),(24820,1124,'_sec_2_title','field_5de6e3ef2798f'),(24821,1124,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(24822,1124,'_sec_2_text','field_5de78dc89e613'),(24823,1124,'sec_3_title','The Project'),(24824,1124,'_sec_3_title','field_5de6e3d37d8da'),(24825,1124,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(24826,1124,'_sec_3_text','field_5de6e4044e5e8'),(24827,1124,'page_col_image_2','436'),(24828,1124,'_page_col_image_2','field_5de6546e7c63a'),(24829,1124,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(24830,1124,'_sec_2_button','field_5de6e58c86706'),(24831,1124,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(24832,1124,'_sec_3_button','field_5de6e5a243c03'),(24833,1124,'page_col_image_4','455'),(24834,1124,'_page_col_image_4','field_5de70801090ce'),(24835,1124,'sec_4_title','Location'),(24836,1124,'_sec_4_title','field_5de7082a12a81'),(24837,1124,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(24838,1124,'_sec_4_text','field_5de7084812a82'),(24839,1124,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(24840,1124,'_sec_4_button','field_5de7085e12a83'),(24841,1124,'news_title','Project updates'),(24842,1124,'_news_title','field_5de78da3aabb9'),(24843,1124,'sec_2_text_copy',''),(24844,1124,'_sec_2_text_copy','field_5de78dc89e613'),(24845,1124,'timeline-title','Timeline'),(24846,1124,'_timeline-title','field_5de78df29e615'),(24847,1124,'timeline_title','Timeline'),(24848,1124,'_timeline_title','field_5de78df29e615'),(24849,1124,'contact_title','Contact us'),(24850,1124,'_contact_title','field_5de7981e06057'),(24851,1124,'contact_intro','Contact text...'),(24852,1124,'_contact_intro','field_5de7983506058'),(24853,1124,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(24854,1124,'_news_button','field_5de8329896e02'),(24855,1124,'timeline_intro','Introduction of timeline detail...'),(24856,1124,'_timeline_intro','field_5de98f5fb1781'),(24857,1124,'timeline_pic','477'),(24858,1124,'_timeline_pic','field_5de98f72b1782'),(24859,1124,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(24860,1124,'_timeline_button','field_5de99363677f8'),(24861,1124,'banner_image_position','center'),(24862,1124,'_banner_image_position','field_5f3bc4757dd02'),(24863,1124,'services_title','Our services'),(24864,1124,'_services_title','field_5f20f3cd80eb2'),(24865,1124,'services_items_0_services_item_image','1061'),(24866,1124,'_services_items_0_services_item_image','field_5f2121355be14'),(24867,1124,'services_items_0_sservices_item_title','1300 Telephone counselling line'),(24868,1124,'_services_items_0_sservices_item_title','field_605089efca82e'),(24869,1124,'services_items_0_services_item_text',''),(24870,1124,'_services_items_0_services_i