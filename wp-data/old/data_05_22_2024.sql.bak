126757,2202,'_survey_index_7_survey_url','field_6294564e42239'),(126758,2202,'survey_index_7_survey_url_text','View Results'),(126759,2202,'_survey_index_7_survey_url_text','field_629456584223a'),(126760,2202,'survey_index','8'),(126761,2202,'_survey_index','field_6294561242236'),(126762,2202,'report_title','Download the report'),(126763,2202,'_report_title','field_62f30edfb57e1'),(126764,2202,'report_intro','Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus massa erat, consectetur at semper at, feugiat vel orci. '),(126765,2202,'_report_intro','field_62f30eedb57e2'),(126766,2202,'report_link_url','#'),(126767,2202,'_report_link_url','field_62f30ef4b57e3'),(126768,2202,'report_link_text','Download'),(126769,2202,'_report_link_text','field_62f30f01b57e4'),(126770,2202,'solutions_content','The housing system is complex, and no one solution will solve the complex problems we now face but there are some critical first steps to be taken now.\r\n<ul>\r\n 	<li>Set out an ambitious national housing agreement between commonwealth and state governments with targets and funding for the construction of affordable homes.</li>\r\n 	<li>Phase out tax breaks for property investors and using the increase in revenue to build more public housing.</li>\r\n 	<li>Establish laws which limit rental increases beyond what is fair.</li>\r\n 	<li>Rebalance tenancy laws to provide renters with more security and control, such as eliminating no grounds evictions.</li>\r\n 	<li>Phase out stamp duty and replace it with a broad-based land tax.</li>\r\n</ul>\r\n<h4>While there are many opinions on what policy changes will fix the housing market, doing nothing is not an option.</h4>'),(126771,2202,'_solutions_content','field_640e8b307a958'),(126772,2202,'problem_icons_0_prob_icon','1699'),(126773,2202,'_problem_icons_0_prob_icon','field_640fa0291d519'),(126774,2202,'problem_icons_0_prob_concerned_stat','70% highly concerned'),(126775,2202,'_problem_icons_0_prob_concerned_stat','field_