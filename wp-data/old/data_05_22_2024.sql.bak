7c6c98c065'),(26756,1147,'support_right_button','<a class=\"btn btn-blue\" href=\"#\">Read more</a>'),(26757,1147,'_support_right_button','field_5b67c6dd8c066'),(26758,1147,'first_image_title','Lifestart is about supporting young children'),(26759,1147,'_first_image_title','field_5b67ca606afc4'),(26760,1147,'first_image_cont','from 0-24 years living with disabilities and their familes'),(26761,1147,'_first_image_cont','field_5b67caff6afc5'),(26762,1147,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(26763,1147,'_first_image_button','field_5b67cb0d6afc6'),(26764,1147,'second _image_title','Lifestart is about supporting young children'),(26765,1147,'_second _image_title','field_5b67cb20ddf9a'),(26766,1147,'second_image_cont','from 0-24 years living with disabilities and their familes'),(26767,1147,'_second_image_cont','field_5b67cb24ddf9b'),(26768,1147,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(26769,1147,'_second_image_button','field_5b67cb29ddf9c'),(26770,1147,'second_image_title','Lifestart is about supporting young children'),(26771,1147,'_second_image_title','field_5b67cb20ddf9a'),(26772,1147,'page_col_image','412'),(26773,1147,'_page_col_image','field_5de6546e7c63a'),(26774,1147,'page_col_image_3','437'),(26775,1147,'_page_col_image_3','field_5de6e3998e07e'),(26776,1147,'sec_2_title','Community'),(26777,1147,'_sec_2_title','field_5de6e3ef2798f'),(26778,1147,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(26779,1147,'_sec_2_text','field_5de78dc89e613'),(26780,1147,'sec_3_title','The Project'),(26781,1147,'_sec_3_title','field_5de6e3d37d8da'),(26782,1147,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(26783,1147,'_sec_3_text','field_5de6e4044e5e8'),(26784,1147,'page_col_image_2','436'),(26785,1147,'_page_col_image_2','field_5de6546e7c63a'),(26786,1147,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(26787,1147,'_sec_2_button','field_5de6e58c86706'),(26788,1147,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(26789,1147,'_sec_3_button','field_5de6e5a243c03'),(26790,1147,'page_col_image_4','455'),(26791,1147,'_page_col_image_4','field_5de70801090ce'),(26792,1147,'sec_4_title','Location'),(26793,1147,'_sec_4_title','field_5de7082a12a81'),(26794,1147,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(26795,1147,'_sec_4_text','field_5de7084812a82'),(26796,1147,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(26797,1147,'_sec_4_button','field_5de7085e12a83'),(26798,1147,'news_title','Project updates'),(26799,1147,'_news_title','field_5de78da3aabb9'),(26800,1147,'sec_2_text_copy',''),(26801,1147,'_sec_2_text_copy','field_5de78dc89e613'),(26802,1147,'timeline-title','Timeline'),(26803,1147,'_timeline-title','field_5de78df29e615'),(26804,1147,'timeline_title','Timeline'),(26805,1147,'_timeline_title','field_5de78df29e615'),(26806,1147,'contact_title','Contact us'),(26807,1147,'_contact_title','field_5de7981e06057'),(26808,1147,'contact_intro','Contact text...'),(26809,1147,'_contact_intro','field_5