_image_title','field_5b67ca606afc4'),(26154,1144,'first_image_cont','from 0-24 years living with disabilities and their familes'),(26155,1144,'_first_image_cont','field_5b67caff6afc5'),(26156,1144,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(26157,1144,'_first_image_button','field_5b67cb0d6afc6'),(26158,1144,'second _image_title','Lifestart is about supporting young children'),(26159,1144,'_second _image_title','field_5b67cb20ddf9a'),(26160,1144,'second_image_cont','from 0-24 years living with disabilities and their familes'),(26161,1144,'_second_image_cont','field_5b67cb24ddf9b'),(26162,1144,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(26163,1144,'_second_image_button','field_5b67cb29ddf9c'),(26164,1144,'second_image_title','Lifestart is about supporting young children'),(26165,1144,'_second_image_title','field_5b67cb20ddf9a'),(26166,1144,'page_col_image','412'),(26167,1144,'_page_col_image','field_5de6546e7c63a'),(26168,1144,'page_col_image_3','437'),(26169,1144,'_page_col_image_3','field_5de6e3998e07e'),(26170,1144,'sec_2_title','Community'),(26171,1144,'_sec_2_title','field_5de6e3ef2798f'),(26172,1144,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(26173,1144,'_sec_2_text','field_5de78dc89e613'),(26174,1144,'sec_3_title','The Project'),(26175,1144,'_sec_3_title','field_5de6e3d37d8da'),(26176,1144,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(26177,1144,'_sec_3_text','field_5de6e4044e5e8'),(26178,1144,'page_col_image_2','436'),(26179,1144,'_page_col_image_2','field_5de6546e7c63a'),(26180,1144,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(26181,1144,'_sec_2_button','field_5de6e58c86706'),(26182,1144,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(26183,1144,'_sec_3_button','field_5de6e5a243c03'),(26184,1144,'page_col_image_4','455'),(26185,1144,'_page_col_image_4','field_5de70801090ce'),(26186,1144,'sec_4_title','Location'),(26187,1144,'_sec_4_title','field_5de7082a12a81'),(26188,1144,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(26189,1144,'_sec_4_text','field_5de7084812a82'),(26190,1144,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(26191,1144,'_sec_4_button','field_5de7085e12a83'),(26192,1144,'news_title','Project updates'),(26193,1144,'_news_title','field_5de78da3aabb9'),(26194,1144,'sec_2_text_copy',''),(26195,1144,'_sec_2_text_copy','field_5de78dc89e613'),(26196,1144,'timeline-title','Timeline'),(26197,1144,'_timeline-title','field_5de78df29e615'),(26198,1144,'timeline_title','Timeline'),(26199,1144,'_timeline_title','field_5de78df29e615'),(26200,1144,'contact_title','Contact us'),(26201,1144,'_contact_title','field_5de7981e06057'),(26202,1144,'contact_intro','Contact text...'),(26203,1144,'_contact_intro','field_5de7983506058'),(26204,1144,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(26205,1144,'_news_button','field_5de8329896e02'),(26206,1144,'timeline_intro','Introduction of timeline detail...'),(26207,1144,'_timeline_in