(112380,2070,'first_image_cont','from 0-24 years living with disabilities and their familes'),(112381,2070,'_first_image_cont','field_5b67caff6afc5'),(112382,2070,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(112383,2070,'_first_image_button','field_5b67cb0d6afc6'),(112384,2070,'second _image_title','Lifestart is about supporting young children'),(112385,2070,'_second _image_title','field_5b67cb20ddf9a'),(112386,2070,'second_image_cont','from 0-24 years living with disabilities and their familes'),(112387,2070,'_second_image_cont','field_5b67cb24ddf9b'),(112388,2070,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(112389,2070,'_second_image_button','field_5b67cb29ddf9c'),(112390,2070,'second_image_title','Lifestart is about supporting young children'),(112391,2070,'_second_image_title','field_5b67cb20ddf9a'),(112392,2070,'page_col_image','412'),(112393,2070,'_page_col_image','field_5de6546e7c63a'),(112394,2070,'page_col_image_3','437'),(112395,2070,'_page_col_image_3','field_5de6e3998e07e'),(112396,2070,'sec_2_title','Community'),(112397,2070,'_sec_2_title','field_5de6e3ef2798f'),(112398,2070,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(112399,2070,'_sec_2_text','field_5de78dc89e613'),(112400,2070,'sec_3_title','The Project'),(112401,2070,'_sec_3_title','field_5de6e3d37d8da'),(112402,2070,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(112403,2070,'_sec_3_text','field_5de6e4044e5e8'),(112404,2070,'page_col_image_2','436'),(112405,2070,'_page_col_image_2','field_5de6546e7c63a'),(112406,2070,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(112407,2070,'_sec_2_button','field_5de6e58c86706'),(112408,2070,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(112409,2070,'_sec_3_button','field_5de6e5a243c03'),(112410,2070,'page_col_image_4','455'),(112411,2070,'_page_col_image_4','field_5de70801090ce'),(112412,2070,'sec_4_title','Location'),(112413,2070,'_sec_4_title','field_5de7082a12a81'),(112414,2070,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(112415,2070,'_sec_4_text','field_5de7084812a82'),(112416,2070,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(112417,2070,'_sec_4_button','field_5de7085e12a83'),(112418,2070,'news_title','Project updates'),(112419,2070,'_news_title','field_5de78da3aabb9'),(112420,2070,'sec_2_text_copy',''),(112421,2070,'_sec_2_text_copy','field_5de78dc89e613'),(112422,2070,'timeline-title','Timeline'),(112423,2070,'_timeline-title','field_5de78df29e615'),(112424,2070,'timeline_title','Timeline'),(112425,2070,'_timeline_title','field_5de78df29e615'),(112426,2070,'contact_title','Contact us'),(112427,2070,'_contact_title','field_5de7981e06057'),(112428,2070,'contact_intro','Contact text...'),(112429,2070,'_contact_intro','field_5de7983506058'),(112430,2070,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(112431,2070,'_news_button','field_5de8329896e02'),(112432,2070,'timeline_intro','Introduction of timeline detail...'),(112433,2