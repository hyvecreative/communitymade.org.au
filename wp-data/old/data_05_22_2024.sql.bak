853,'problem_icons_0_prob_icon','1699'),(69155,1853,'_problem_icons_0_prob_icon','field_640fa0291d519'),(69156,1853,'problem_icons_0_prob_concerned_stat','70% highly concerned'),(69157,1853,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(69158,1853,'problem_icons_0_prob_concerded_text','are highly concerned'),(69159,1853,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(69160,1853,'problem_icons_0_prob_issue_text',''),(69161,1853,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(69162,1853,'problem_icons','4'),(69163,1853,'_problem_icons','field_640fa0191d518'),(69164,1853,'ceh_content_left',''),(69165,1853,'_ceh_content_left','field_640e97e8f1c8c'),(69166,1853,'ceh_content_right',''),(69167,1853,'_ceh_content_right','field_640e97fdf1c8d'),(69168,1853,'pc_content_left',''),(69169,1853,'_pc_content_left','field_640e983bf1c8f'),(69170,1853,'pc_content_right',''),(69171,1853,'_pc_content_right','field_640e984df1c90'),(69172,1853,'problem_icons_1_prob_icon','1699'),(69173,1853,'_problem_icons_1_prob_icon','field_640fa0291d519'),(69174,1853,'problem_icons_1_prob_concerned_stat','69% highly concerned'),(69175,1853,'_problem_icons_1_prob_concerned_stat','field_640fa0dd81d95'),(69176,1853,'problem_icons_1_prob_concerded_text','are highly concerned'),(69177,1853,'_problem_icons_1_prob_concerded_text','field_640fa10181d96'),(69178,1853,'problem_icons_1_prob_issue_text',''),(69179,1853,'_problem_icons_1_prob_issue_text','field_640fa11a81d97'),(69180,1853,'problem_icons_2_prob_icon','1699'),(69181,1853,'_problem_icons_2_prob_icon','field_640fa0291d519'),(69182,1853,'problem_icons_2_prob_concerned_stat','64% highly concerned'),(69183,1853,'_problem_icons_2_prob_concerned_stat','field_640fa0dd81d95'),(69184,1853,'problem_icons_2_prob_concerded_text','are highly concerned'),(69185,1853,'_problem_icons_2_prob_concerded_text','field_640fa10181d96'),(69186,1853,'problem_icons_2_prob_issue_text',''),(69187,1853,'_problem_icons_2_prob_issue_text','field_640fa11a81d97'),(69188,1853,'problem_icons_3_prob_icon','1699'),(69189,1853,'_problem_icons_3_prob_icon','field_640fa0291d519'),(69190,1853,'problem_icons_3_prob_concerned_stat','64% highly concerned'),(69191,1853,'_problem_icons_3_prob_concerned_stat','field_640fa0dd81d95'),(69192,1853,'problem_icons_3_prob_concerded_text','are highly concerned'),(69193,1853,'_problem_icons_3_prob_concerded_text','field_640fa10181d96'),(69194,1853,'problem_icons_3_prob_issue_text',''),(69195,1853,'_problem_icons_3_prob_issue_text','field_640fa11a81d97'),(69196,1853,'problem_icons_0_prob_concerned_text','House prices have doubled in a decade'),(69197,1853,'_problem_icons_0_prob_concerned_text','field_640fa10181d96'),(69198,1853,'problem_icons_1_prob_concerned_text','The gap between rich and poor is growing'),(69199,1853,'_problem_icons_1_prob_concerned_text','field_640fa10181d96'),(69200,1853,'problem_icons_2_prob_concerned_text','Construction of social housing is down'),(69201,1853,'_problem_icons_2_prob_concerned_text','field_640fa10181d96'),(69202,1853,'problem_icons_3_prob_concerned_text','Banks are making more than ever from housing'),(69203,1853,'_problem_icons_3_prob_concerned_text','field_640fa10181d96'),(69204,1853,'monitor_content','The Australian Housing Monitor is a large, nationally-representative survey covering public experiences and attitudes toward housing related issues. Questions range from how well the respondent is keeping up with their mortgage/rent, to what they think about social housing construction.\r\n\r\nA broad range of demographic criteria are included, such as gender, location, age, income, voting preference, educational level, tenure type, and employment status. These variables allow CEH researchers to understand the trends and diversity of opinion around the country.\r\n\r\nIt also incorporates questions from previous surveys to track trends over time.\r\nThe inaugural poll was conducted by Essential in December 2022, and was completed by 4,735 people.'),(69205,1853,'_monitor_content','field_640fcc4014404'),(69206,1853,'problem_head','Housing in Australia is not working, and Australians are concerned.'),(69207,1853,'_problem_head','field_641935436aded'),(69208,1853,'problem_signoff','Explore the research showing how concerned Australians are our about the housing situation.'),(69209,1853,'_problem_signoff','field_641935626adee'),(69210,1853,'sections','a:2:{i:0;s:4:\"hero\";i:1;s:9:\"news_grid\";}'),(69211,1853,'_sections','field_5dafb40b8143a'),(69212,1853,'sections_0_is_full_height','1'),(69213,1853,'_sections_0_is_full_height','field_61d6f6fd5a37e'),(69214,1853,'sections_0_image','1648'),(69215,1853,'_sections_0_image','field_61d6f6d45a37d'),(69216,1853,'sections_0_heading','Heading'),(69217,1853,'_sections_0_heading','field_61d6f69e5a379'),(69218,1853,'sections_0_subtitle','Ya ya '),(69219,1853,'_sections_0_subtitle','field_61d6f6ac5a37a'),(69220,1853,'sections_0_link_one',''),(69221,1853,'_sections_0_link_one','field_61d6f6b55a37b'),(69222,1853,'sections_0_link_two',''),(69223,1853,'_sections_0_link_two','field_61d6f6c35a37c'),(69224,1853,'sections_1_select_categories','a:1:{i:0;s:2:\"27\";}'),(69225,1853,'_sections_1_select_categories','field_637f04483b63b'),(69226,1853,'intro_head_major','Queenslanders are known for both our love of the great outdoors and our state pride…'),(69227,1853,'_intro_head_major','field_64e828783ad9f'),(69228,1853,'intro_head_minor','But there’s a few things you might not know about our beautiful state.'),(69229,1853,'_intro_head_minor','field_64e8288c3ada0'),(69230,1853,'intro_icons_0_int_icon','1806'),(69231,1853,'_intro_icons_0_int_icon','field_64e828b33ada2'),(69232,1853,'intro_icons_0_int_icon_text','At 1,727,000 square kilometres, we’re 2.5 times the size of Texas. <span>Yeeha!</span>'),(69233,1853,'_intro_icons_0_int_icon_text','field_64e828e33ada3'),(69234,1853,'intro_icons_1_int_icon','1806'),(69235,1853,'_intro_icons_1_int_icon','field_64e828b33ada2'),(69236,1853,