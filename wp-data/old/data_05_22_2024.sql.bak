on','field_5b67c6dd8c066'),(98093,1959,'first_image_title','Lifestart is about supporting young children'),(98094,1959,'_first_image_title','field_5b67ca606afc4'),(98095,1959,'first_image_cont','from 0-24 years living with disabilities and their familes'),(98096,1959,'_first_image_cont','field_5b67caff6afc5'),(98097,1959,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(98098,1959,'_first_image_button','field_5b67cb0d6afc6'),(98099,1959,'second _image_title','Lifestart is about supporting young children'),(98100,1959,'_second _image_title','field_5b67cb20ddf9a'),(98101,1959,'second_image_cont','from 0-24 years living with disabilities and their familes'),(98102,1959,'_second_image_cont','field_5b67cb24ddf9b'),(98103,1959,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(98104,1959,'_second_image_button','field_5b67cb29ddf9c'),(98105,1959,'second_image_title','Lifestart is about supporting young children'),(98106,1959,'_second_image_title','field_5b67cb20ddf9a'),(98107,1959,'page_col_image','412'),(98108,1959,'_page_col_image','field_5de6546e7c63a'),(98109,1959,'page_col_image_3','437'),(98110,1959,'_page_col_image_3','field_5de6e3998e07e'),(98111,1959,'sec_2_title','Community'),(98112,1959,'_sec_2_title','field_5de6e3ef2798f'),(98113,1959,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(98114,1959,'_sec_2_text','field_5de78dc89e613'),(98115,1959,'sec_3_title','The Project'),(98116,1959,'_sec_3_title','field_5de6e3d37d8da'),(98117,1959,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(98118,1959,'_sec_3_text','field_5de6e4044e5e8'),(98119,1959,'page_col_image_2','436'),(98120,1959,'_page_col_image_2','field_5de6546e7c63a'),(98121,1959,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(98122,1959,'_sec_2_button','field_5de6e58c86706'),(98123,1959,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(98124,1959,'_sec_3_button','field_5de6e5a243c03'),(98125,1959,'page_col_image_4','455'),(98126,1959,'_page_col_image_4','field_5de70801090ce'),(98127,1959,'sec_4_title','Location'),(98128,1959,'_sec_4_title','field_5de7082a12a81'),(98129,1959,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(98130,1959,'_sec_4_text','field_5de7084812a82'),(98131,1959,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(98132,1959,'_sec_4_button','field_5de7085e12a83'),(98133,1959,'news_title','Project updates'),(98134,1959,'_news_title','field_5de78da3aabb9'),(98135,1959,'sec_2_text_copy',''),(98136,1959,'_sec_2_text_copy','field_5de78dc89e613'),(98137,1959,'timeline-title','Timeline'),(98138,1959,'_timeline-title','field_5de78df29e615'),(98139,1959,'timeline_title','Timeline'),(98140,1959,'_timeline_title','field_5de78df29e615'),(98141,1959,'contact_title','Contact us'),(98142,1959,'_contact_title','field_5de7981e06057'),(98143,1959,'contact_intro','Contact text...'),(98144,1959,'_contact_intro','field_5de7983506058'),(98145,1959,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(98146,1959,'_ne