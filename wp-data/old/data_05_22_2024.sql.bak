0,1813,'_first_image_title','field_5b67ca606afc4'),(59451,1813,'first_image_cont','from 0-24 years living with disabilities and their familes'),(59452,1813,'_first_image_cont','field_5b67caff6afc5'),(59453,1813,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(59454,1813,'_first_image_button','field_5b67cb0d6afc6'),(59455,1813,'second _image_title','Lifestart is about supporting young children'),(59456,1813,'_second _image_title','field_5b67cb20ddf9a'),(59457,1813,'second_image_cont','from 0-24 years living with disabilities and their familes'),(59458,1813,'_second_image_cont','field_5b67cb24ddf9b'),(59459,1813,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(59460,1813,'_second_image_button','field_5b67cb29ddf9c'),(59461,1813,'second_image_title','Lifestart is about supporting young children'),(59462,1813,'_second_image_title','field_5b67cb20ddf9a'),(59463,1813,'page_col_image','412'),(59464,1813,'_page_col_image','field_5de6546e7c63a'),(59465,1813,'page_col_image_3','437'),(59466,1813,'_page_col_image_3','field_5de6e3998e07e'),(59467,1813,'sec_2_title','Community'),(59468,1813,'_sec_2_title','field_5de6e3ef2798f'),(59469,1813,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(59470,1813,'_sec_2_text','field_5de78dc89e613'),(59471,1813,'sec_3_title','The Project'),(59472,1813,'_sec_3_title','field_5de6e3d37d8da'),(59473,1813,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(59474,1813,'_sec_3_text','field_5de6e4044e5e8'),(59475,1813,'page_col_image_2','436'),(59476,1813,'_page_col_image_2','field_5de6546e7c63a'),(59477,1813,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(59478,1813,'_sec_2_button','field_5de6e58c86706'),(59479,1813,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(59480,1813,'_sec_3_button','field_5de6e5a243c03'),(59481,1813,'page_col_image_4','455'),(59482,1813,'_page_col_image_4','field_5de70801090ce'),(59483,1813,'sec_4_title','Location'),(59484,1813,'_sec_4_title','field_5de7082a12a81'),(59485,1813,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(59486,1813,'_sec_4_text','field_5de7084812a82'),(59487,1813,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(59488,1813,'_sec_4_button','field_5de7085e12a83'),(59489,1813,'news_title','Project updates'),(59490,1813,'_news_title','field_5de78da3aabb9'),(59491,1813,'sec_2_text_copy',''),(59492,1813,'_sec_2_text_copy','field_5de78dc89e613'),(59493,1813,'timeline-title','Timeline'),(59494,1813,'_timeline-title','field_5de78df29e615'),(59495,1813,'timeline_title','Timeline'),(59496,1813,'_timeline_title','field_5de78df29e615'),(59497,1813,'contact_title','Contact us'),(59498,1813,'_contact_title','field_5de7981e06057'),(59499,1813,'contact_intro','Contact text...'),(59500,1813,'_contact_intro','field_5de7983506058'),(59501,1813,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(59502,1813,'_news_button','field_5de8329896e02'),(59503,1813,'timeline_intro','Introduction of timeline detail...'),(59504,1813