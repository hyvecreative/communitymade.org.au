2578,1825,'second_image_title','Lifestart is about supporting young children'),(62579,1825,'_second_image_title','field_5b67cb20ddf9a'),(62580,1825,'page_col_image','412'),(62581,1825,'_page_col_image','field_5de6546e7c63a'),(62582,1825,'page_col_image_3','437'),(62583,1825,'_page_col_image_3','field_5de6e3998e07e'),(62584,1825,'sec_2_title','Community'),(62585,1825,'_sec_2_title','field_5de6e3ef2798f'),(62586,1825,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(62587,1825,'_sec_2_text','field_5de78dc89e613'),(62588,1825,'sec_3_title','The Project'),(62589,1825,'_sec_3_title','field_5de6e3d37d8da'),(62590,1825,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(62591,1825,'_sec_3_text','field_5de6e4044e5e8'),(62592,1825,'page_col_image_2','436'),(62593,1825,'_page_col_image_2','field_5de6546e7c63a'),(62594,1825,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(62595,1825,'_sec_2_button','field_5de6e58c86706'),(62596,1825,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(62597,1825,'_sec_3_button','field_5de6e5a243c03'),(62598,1825,'page_col_image_4','455'),(62599,1825,'_page_col_image_4','field_5de70801090ce'),(62600,1825,'sec_4_title','Location'),(62601,1825,'_sec_4_title','field_5de7082a12a81'),(62602,1825,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(62603,1825,'_sec_4_text','field_5de7084812a82'),(62604,1825,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(62605,1825,'_sec_4_button','field_5de7085e12a83'),(62606,1825,'news_title','Project updates'),(62607,1825,'_news_title','field_5de78da3aabb9'),(62608,1825,'sec_2_text_copy',''),(62609,1825,'_sec_2_text_copy','field_5de78dc89e613'),(62610,1825,'timeline-title','Timeline'),(62611,1825,'_timeline-title','field_5de78df29e615'),(62612,1825,'timeline_title','Timeline'),(62613,1825,'_timeline_title','field_5de78df29e615'),(62614,1825,'contact_title','Contact us'),(62615,1825,'_contact_title','field_5de7981e06057'),(62616,1825,'contact_intro','Contact text...'),(62617,1825,'_contact_intro','field_5de7983506058'),(62618,1825,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(62619,1825,'_news_button','field_5de8329896e02'),(62620,1825,'timeline_intro','Introduction of timeline detail...'),(62621,1825,'_timeline_intro','field_5de98f5fb1781'),(62622,1825,'timeline_pic','477'),(62623,1825,'_timeline_pic','field_5de98f72b1782'),(62624,1825,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(62625,1825,'_timeline_button','field_5de99363677f8'),(62626,1825,'banner_image_position','center'),(62627,1825,'_banner_image_position','field_5f3bc4757dd02'),(62628,1825,'services_title','Our services'),(62629,1825,'_services_title','field_5f20f3cd80eb2'),(62630,1825,'services_items_0_services_item_image','1061'),(62631,1825,'_services_items_0_services_item_image','field_5f2121355be14'),(62632,1825,'services_items_0_sservices_item_title','1300 Telephone counselling line'),(62633,1825,'_services_items_0_sservices_item_title','field_605089e