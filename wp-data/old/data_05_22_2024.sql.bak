_5de6e3998e07e'),(91198,1940,'sec_2_title','Community'),(91199,1940,'_sec_2_title','field_5de6e3ef2798f'),(91200,1940,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(91201,1940,'_sec_2_text','field_5de78dc89e613'),(91202,1940,'sec_3_title','The Project'),(91203,1940,'_sec_3_title','field_5de6e3d37d8da'),(91204,1940,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(91205,1940,'_sec_3_text','field_5de6e4044e5e8'),(91206,1940,'page_col_image_2','436'),(91207,1940,'_page_col_image_2','field_5de6546e7c63a'),(91208,1940,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(91209,1940,'_sec_2_button','field_5de6e58c86706'),(91210,1940,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(91211,1940,'_sec_3_button','field_5de6e5a243c03'),(91212,1940,'page_col_image_4','455'),(91213,1940,'_page_col_image_4','field_5de70801090ce'),(91214,1940,'sec_4_title','Location'),(91215,1940,'_sec_4_title','field_5de7082a12a81'),(91216,1940,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(91217,1940,'_sec_4_text','field_5de7084812a82'),(91218,1940,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(91219,1940,'_sec_4_button','field_5de7085e12a83'),(91220,1940,'news_title','Project updates'),(91221,1940,'_news_title','field_5de78da3aabb9'),(91222,1940,'sec_2_text_copy',''),(91223,1940,'_sec_2_text_copy','field_5de78dc89e613'),(91224,1940,'timeline-title','Timeline'),(91225,1940,'_timeline-title','field_5de78df29e615'),(91226,1940,'timeline_title','Timeline'),(91227,1940,'_timeline_title','field_5de78df29e615'),(91228,1940,'contact_title','Contact us'),(91229,1940,'_contact_title','field_5de7981e06057'),(91230,1940,'contact_intro','Contact text...'),(91231,1940,'_contact_intro','field_5de7983506058'),(91232,1940,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(91233,1940,'_news_button','field_5de8329896e02'),(91234,1940,'timeline_intro','Introduction of timeline detail...'),(91235,1940,'_timeline_intro','field_5de98f5fb1781'),(91236,1940,'timeline_pic','477'),(91237,1940,'_timeline_pic','field_5de98f72b1782'),(91238,1940,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(91239,1940,'_timeline_button','field_5de99363677f8'),(91240,1940,'banner_image_position','center'),(91241,1940,'_banner_image_position','field_5f3bc4757dd02'),(91242,1940,'services_title','Our services'),(91243,1940,'_services_title','field_5f20f3cd80eb2'),(91244,1940,'services_items_0_services_item_image','1061'),(91245,1940,'_services_items_0_services_item_image','field_5f2121355be14'),(91246,1940,'services_items_0_sservices_item_title','1300 Telephone counselling line'),(91247,1940,'_services_items_0_sservices_item_title','field_605089efca82e'),(91248,1940,'services_items_0_services_item_text',''),(91249,1940,'_services_items_0_services_item_text','field_5f2121535be15'),(91250,1940,'services_items_0_services_link_url','#'),(91251,1940,'_services_items_0_services_link_url','field_6050866041225'),(91252,1940,'services_items_0_service