2102,'intro_boxes_0_box_dropdown','Our rigorous, conflict-free research and data analysis lifts the lid on fund performance, fees and insurance. Drawing on our policy expertise, we turn this analysis into action by using it to back reform and make super easier for people to understand. <a href=\"//localhost:4000:4000:4000:4000/how/\">More</a> '),(114485,2102,'_intro_boxes_0_box_dropdown','field_65262dead0a0c'),(114486,2102,'intro_boxes_1_box_icon','1941'),(114487,2102,'_intro_boxes_1_box_icon','field_65262db5d36ee'),(114488,2102,'intro_boxes_1_box_title','Investigative journalism'),(114489,2102,'_intro_boxes_1_box_title','field_65262d29ed8e3'),(114490,2102,'intro_boxes_1_box_dropdown','Dropdown text'),(114491,2102,'_intro_boxes_1_box_dropdown','field_65262dead0a0c'),(114492,2102,'intro_boxes_2_box_icon','1937'),(114493,2102,'_intro_boxes_2_box_icon','field_65262db5d36ee'),(114494,2102,'intro_boxes_2_box_title','Research'),(114495,2102,'_intro_boxes_2_box_title','field_65262d29ed8e3'),(114496,2102,'intro_boxes_2_box_dropdown','Dropdown text'),(114497,2102,'_intro_boxes_2_box_dropdown','field_65262dead0a0c'),(114498,2102,'intro_boxes','3'),(114499,2102,'_intro_boxes','field_65262d14ed8e2'),(114500,2102,'get_help_section_title','Get Help'),(114501,2102,'_get_help_section_title','field_65262c35143de'),(114502,2102,'get_help_block_home',''),(114503,2102,'_get_help_block_home','field_65262c8a143e1'),(114504,2102,'gh_block_home_0_help_image','1956'),(114505,2102,'_gh_block_home_0_help_image','field_65262cd0143e2'),(114506,2102,'gh_block_home_0_help_title','How much do I need to retire? '),(114507,2102,'_gh_block_home_0_help_title','field_65262cec143e3'),(114508,2102,'gh_block_home_0_help_url','#'),(114509,2102,'_gh_block_home_0_help_url','field_65262cf4143e4'),(114510,2102,'gh_block_home_1_help_image','1962'),(114511,2102,'_gh_block_home_1_help_image','field_65262cd0143e2'),(114512,2102,'gh_block_home_1_help_title','I have a problem with  my super fund'),(114513,2102,'_gh_