col_image','field_5de6546e7c63a'),(47849,1636,'page_col_image_3','437'),(47850,1636,'_page_col_image_3','field_5de6e3998e07e'),(47851,1636,'sec_2_title','Community'),(47852,1636,'_sec_2_title','field_5de6e3ef2798f'),(47853,1636,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(47854,1636,'_sec_2_text','field_5de78dc89e613'),(47855,1636,'sec_3_title','The Project'),(47856,1636,'_sec_3_title','field_5de6e3d37d8da'),(47857,1636,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(47858,1636,'_sec_3_text','field_5de6e4044e5e8'),(47859,1636,'page_col_image_2','436'),(47860,1636,'_page_col_image_2','field_5de6546e7c63a'),(47861,1636,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(47862,1636,'_sec_2_button','field_5de6e58c86706'),(47863,1636,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(47864,1636,'_sec_3_button','field_5de6e5a243c03'),(47865,1636,'page_col_image_4','455'),(47866,1636,'_page_col_image_4','field_5de70801090ce'),(47867,1636,'sec_4_title','Location'),(47868,1636,'_sec_4_title','field_5de7082a12a81'),(47869,1636,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(47870,1636,'_sec_4_text','field_5de7084812a82'),(47871,1636,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(47872,1636,'_sec_4_button','field_5de7085e12a83'),(47873,1636,'news_title','Project updates'),(47874,1636,'_news_title','field_5de78da3aabb9'),(47875,1636,'sec_2_text_copy',''),(47876,1636,'_sec_2_text_copy','field_5de78dc89e613'),(47877,1636,'timeline-title','Timeline'),(47878,1636,'_timeline-title','field_5de78df29e615'),(47879,1636,'timeline_title','Timeline'),(47880,1636,'_timeline_title','field_5de78df29e615'),(47881,1636,'contact_title','Contact us'),(47882,1636,'_contact_title','field_5de7981e06057'),(47883,1636,'contact_intro','Contact text...'),(47884,1636,'_contact_intro','field_5de7983506058'),(47885,1636,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(47886,1636,'_news_button','field_5de8329896e02'),(47887,1636,'timeline_intro','Introduction of timeline detail...'),(47888,1636,'_timeline_intro','field_5de98f5fb1781'),(47889,1636,'timeline_pic','477'),(47890,1636,'_timeline_pic','field_5de98f72b1782'),(47891,1636,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(47892,1636,'_timeline_button','field_5de99363677f8'),(47893,1636,'banner_image_position','center'),(47894,1636,'_banner_image_position','field_5f3bc4757dd02'),(47895,1636,'services_title','Our services'),(47896,1636,'_services_title','field_5f20f3cd80eb2'),(47897,1636,'services_items_0_services_item_image','1061'),(47898,1636,'_services_items_0_services_item_image','field_5f2121355be14'),(47899,1636,'services_items_0_sservices_item_title','1300 Telephone counselling line'),(47900,1636,'_services_items_0_sservices_item_title','field_605089efca82e'),(47901,1636,'services_items_0_services_item_text',''),(47902,1636,'_services_items_0_services_item_text','field_5f2121535be15'),(47903,1636,'services_items_0_services_link_url','#'),