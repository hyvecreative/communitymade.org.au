sum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut laoreet.'),(39160,1527,'_support_ctr_cont','field_5b67c63158af4'),(39161,1527,'support_ctr_button','<a class=\"btn btn-orange\" href=\"/supports/\">Find us</a>'),(39162,1527,'_support_ctr_button','field_5b67c63658af5'),(39163,1527,'support_right_title','NDIS Registered provider'),(39164,1527,'_support_right_title','field_5b67c6a38c064'),(39165,1527,'support_right_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut.'),(39166,1527,'_support_right_cont','field_5b67c6c98c065'),(39167,1527,'support_right_button','<a class=\"btn btn-blue\" href=\"#\">Read more</a>'),(39168,1527,'_support_right_button','field_5b67c6dd8c066'),(39169,1527,'first_image_title','Lifestart is about supporting young children'),(39170,1527,'_first_image_title','field_5b67ca606afc4'),(39171,1527,'first_image_cont','from 0-24 years living with disabilities and their familes'),(39172,1527,'_first_image_cont','field_5b67caff6afc5'),(39173,1527,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(39174,1527,'_first_image_button','field_5b67cb0d6afc6'),(39175,1527,'second _image_title','Lifestart is about supporting young children'),(39176,1527,'_second _image_title','field_5b67cb20ddf9a'),(39177,1527,'second_image_cont','from 0-24 years living with disabilities and their familes'),(39178,1527,'_second_image_cont','field_5b67cb24ddf9b'),(39179,1527,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(39180,1527,'_second_image_button','field_5b67cb29ddf9c'),(39181,1527,'second_image_title','Lifestart is about supporting young children'),(39182,1527,'_second_image_title','field_5b67cb20ddf9a'),(39183,1527,'page_col_image','412'),(39184,1527,'_page_col_image','field_5de6546e7c63a'),(39185,1527,'page_col_image_3','437'),(39186,1527,'_page_col_image_3','field_5de6e3998e07e'),(39187,1527,'sec_2_title','Community'),(39188,1527,'_sec_2_title','field_5de6e3ef2798f'),(39189,1527,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(39190,1527,'_sec_2_text','field_5de78dc89e613'),(39191,1527,'sec_3_title','The Project'),(39192,1527,'_sec_3_title','field_5de6e3d37d8da'),(39193,1527,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(39194,1527,'_sec_3_text','field_5de6e4044e5e8'),(39195,1527,'page_col_image_2','436'),(39196,1527,'_page_col_image_2','field_5de6546e7c63a'),(39197,1527,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(39198,1527,'_sec_2_button','field_5de6e58c86706'),(39199,1527,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(39200,1527,'_sec_3_button','field_5de6e5a243c03'),(39201,1527,'page_col_image_4','455'),(39202,1527,'_page_col_image_4','field_5de70801090ce'),(39203,1527,'sec_4_title','Location'),(39204,1527,'_sec_4_title','field_5de7082a12a81'),(39205,1527,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(39206,1527,'_sec_4_text','field_5de7084812a82'),(39207,1527,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(39208,1527,'_sec_4_button','field_5de7085e12a83'),(39209,1527,'news_title','Project updates'),(39210,1527,'_news_title','field_5de78da3aabb9'),(39211,1527,'sec_2_text_copy',''),(39212,1527,'_sec_2_text_copy','field_5de78dc89e613'),(39213,1527,'timeline-title','Timeline'),(39214,1527,'_timeline-title','field_5de78df29e615'),(39215,1527,'timeline_title','Timeline'),(39216,1527,'_timeline_title','field_5de78df29e615'),(39217,1527,'contact_title','Contact us'),(39218,1527,'_contact_title','field_5de7981e06057'),(39219,1527,'contact_intro','Contact text...'),(39220,1527,'_contact_intro','field_5de7983506058'),(39221,1527,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(39222,1527,'_news_button','field_5de8329896e02'),(39223,1527,'timeline_intro','Introduction of timeline detail...'),(39224,1527,'_timeline_intro','field_5de98f5fb1781'),(39225,1527,'timeline_pic','477'),(39226,1527,'_timeline_pic','field_5de98f72b1782'),(39227,1527,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(39228,1527,'_timeline_button','field_5de99363677f8'),(39229,1527,'banner_image_position','center'),(39230,1527,'_banner_image_position','field_5f3bc4757dd02'),(39231,1527,'services_title','Our services'),(39232,1527,'_services_title','field_5f20f3cd80eb2'),(39233,1527,'services_items_0_services_item_image','1061'),(39234,1527,'_services_items_0_services_item_image','field_5f2121355be14'),(39235,1527,'services_items_0_sservices_item_title','1300 Telephone counselling line'),(39236,1527,'_services_items_0_sservices_item_title','field_605089efca82e'),(39237,1527,'services_items_0_services_item_text',''),(39238,1527,'_services_items_0_services_item_text','field_5f2121535be15'),(39239,1527,'services_items_0_services_link_url','#'),(39240,1527,'_services_items_0_services_link_url','field_6050866041225'),(39241,1527,'services_items_0_services_link_text','Find out more'),(39242,1527,'_services_items_