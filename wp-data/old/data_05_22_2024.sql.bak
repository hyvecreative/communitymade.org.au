 Interdum et malesuada fames ac ante ipsum primis in faucibus.'),(54047,1703,'_solutions_content','field_640e8b307a958'),(54048,1703,'problem_icons_0_prob_icon','1699'),(54049,1703,'_problem_icons_0_prob_icon','field_640fa0291d519'),(54050,1703,'problem_icons_0_prob_concerned_stat','70%'),(54051,1703,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(54052,1703,'problem_icons_0_prob_concerded_text','are highly concerned'),(54053,1703,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(54054,1703,'problem_icons_0_prob_issue_text','House prices have doubled in a decade'),(54055,1703,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(54056,1703,'problem_icons','4'),(54057,1703,'_problem_icons','field_640fa0191d518'),(54058,1703,'ceh_content_left',''),(54059,1703,'_ceh_content_left','field_640e97e8f1c8c'),(54060,1703,'ceh_content_right',''),(54061,1703,'_ceh_content_right','field_640e97fdf1c8d'),(54062,1703,'pc_content_left',''),(54063,1703,'_pc_content_left','field_640e983bf1c8f'),(54064,1703,'pc_content_right',''),(54065,1703,'_pc_content_right','field_640e984df1c90'),(54066,1703,'problem_icons_1_prob_icon','1699'),(54067,1703,'_problem_icons_1_prob_icon','field_640fa0291d519'),(54068,1703,'problem_icons_1_prob_concerned_stat','69%'),(54069,1703,'_problem_icons_1_prob_concerned_stat','field_640fa0dd81d95'),(54070,1703,'problem_icons_1_prob_concerded_text','are highly concerned'),(54071,1703,'_problem_icons_1_prob_concerded_text','field_640fa10181d96'),(54072,1703,'problem_icons_1_prob_issue_text','The gap between rich and poor is growing'),(54073,1703,'_problem_icons_1_prob_issue_text','field_640fa11a81d97'),(54074,1703,'problem_icons_2_prob_icon','1699'),(54075,1703,'_problem_icons_2_prob_icon','field_640fa0291d519'),(54076,1703,'problem_icons_2_prob_concerned_stat','64%'),(54077,1703,'_problem_icons_2_prob_concerned_stat','field_640fa0dd81d95'),(54078,1703,'problem_icons_2_prob_concerded_text','are highly concerned'),(54079,1703,'_prob