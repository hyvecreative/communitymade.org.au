2a58af3'),(41035,1534,'support_ctr_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut laoreet.'),(41036,1534,'_support_ctr_cont','field_5b67c63158af4'),(41037,1534,'support_ctr_button','<a class=\"btn btn-orange\" href=\"/supports/\">Find us</a>'),(41038,1534,'_support_ctr_button','field_5b67c63658af5'),(41039,1534,'support_right_title','NDIS Registered provider'),(41040,1534,'_support_right_title','field_5b67c6a38c064'),(41041,1534,'support_right_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut.'),(41042,1534,'_support_right_cont','field_5b67c6c98c065'),(41043,1534,'support_right_button','<a class=\"btn btn-blue\" href=\"#\">Read more</a>'),(41044,1534,'_support_right_button','field_5b67c6dd8c066'),(41045,1534,'first_image_title','Lifestart is about supporting young children'),(41046,1534,'_first_image_title','field_5b67ca606afc4'),(41047,1534,'first_image_cont','from 0-24 years living with disabilities and their familes'),(41048,1534,'_first_image_cont','field_5b67caff6afc5'),(41049,1534,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(41050,1534,'_first_image_button','field_5b67cb0d6afc6'),(41051,1534,'second _image_title','Lifestart is about supporting young children'),(41052,1534,'_second _image_title','field_5b67cb20ddf9a'),(41053,1534,'second_image_cont','from 0-24 years living with disabilities and their familes'),(41054,1534,'_second_image_cont','field_5b67cb24ddf9b'),(41055,1534,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(41056,1534,'_second_image_button','field_5b67cb29ddf9c'),(41057,1534,'second_image_title','Lifestart is about supporting young children'),(41058,1534,'_second_image_title','field_5b67cb20ddf9a'),(41059,1534,'page_col_image','412'),(41060,1534,'_page_col_image','field_5de6546e7c63a'),(41061,1534,'page_col_image_3','437'),(41062,1534,'_page_col_image_3','field_5de6e3998e07e'),(41063,1534,'sec_2_title','Community'),(41064,1534,'_sec_2_title','field_5de6e3ef2798f'),(41065,1534,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(41066,1534,'_sec_2_text','field_5de78dc89e613'),(41067,1534,'sec_3_title','The Project'),(41068,1534,'_sec_3_title','field_5de6e3d37d8da'),(41069,1534,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(41070,1534,'_sec_3_text','field_5de6e4044e5e8'),(41071,1534,'page_col_image_2','436'),(41072,1534,'_page_col_image_2','field_5de6546e7c63a'),(41073,1534,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(41074,1534,'_sec_2_button','field_5de6e58c86706'),(41075,1534,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(41076,1534,'_sec_3_button','field_5de6e5a243c03'),(41077,1534,'page_col_image_4','455'),(41078,1534,'_page_col_image_4','field_5de70801090ce'),(41079,1534,'sec_4_title','Location'),(41080,1534,'_sec_4_title','field_5de7082a12a81'),(41081,1534,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(41082,1534,'_sec_4_text','field_5de7084812a82'),(41083,1534,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(41084,1534,'_sec_4_button','field_5de7085e12a83'),(41085,1534,'news_title','Project updates'),(41086,1534,'_news_title','field_5de78da3aabb9'),(41087,1534,'sec_2_text_copy',''),(41088,1534,'_sec_2_text_copy','field_5de78dc89e613'),(41089,1534,'timeline-title','Timeline'),(41090,1534,'_timeline-title','field_5de78df29e615'),(41091,1534,'timeline_title','Timeline'),(41092,1534,'_timeline_title','field_5de78df29e615'),(41093,1534,'contact_title','Contact us'),(41094,1534,'_contact_title','field_5de7981e06057'),(41095,1534,'contact_intro','Contact text...'),(41096,1534,'_contact_intro','field_5de7983506058'),(41097,1534,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(41098,1534,'_news_button','field_5de8329896e02'),(41099,1534,'timeline_intro','Introduction of timeline detail...'),(41100,1534,'_timeline_intro','field_5de98f5fb1781'),(41101,1534,'timeline_pic','477'),(41102,1534,'_timeline_pic','field_5de98f72b1782'),(41103,1534,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(41104,1534,'_timeline_button','field_5de99363677f8'),(41105,1534,'banner_image_position','center'),(41106,1534,'_banner_image_position','field_5f3bc4757dd02'),(41107,1534,'services_title','Our services'),(41108,1534,'_services_title','field_5f20f3cd80eb2'),(41109,1534,'services_items_0_services_item_image','1061'),(41110,1534,'_services_items_0_services_item_image','field_5f2121355be14'),(41111,1534,'services_items_0_sservices_item_title','1300 Telephone counselling line'),(41112,1534,'_services_items_0_sservices_item_title','field_605089efca82e'),(41113,1534,'services_items_0_services_item_text',''),(41114,1534,'_services_items_0_services_item_text','field_5f2121535be15'),(41115,1534,'services_items_0_services_link_url','#'),(41116,1534,'_services_items_0_services_link_url','field_6050866041225'),(41117,1534,'services_items_0_services_link_te