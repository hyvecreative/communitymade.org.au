provider'),(22388,1116,'_support_right_title','field_5b67c6a38c064'),(22389,1116,'support_right_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut.'),(22390,1116,'_support_right_cont','field_5b67c6c98c065'),(22391,1116,'support_right_button','<a class=\"btn btn-blue\" href=\"#\">Read more</a>'),(22392,1116,'_support_right_button','field_5b67c6dd8c066'),(22393,1116,'first_image_title','Lifestart is about supporting young children'),(22394,1116,'_first_image_title','field_5b67ca606afc4'),(22395,1116,'first_image_cont','from 0-24 years living with disabilities and their familes'),(22396,1116,'_first_image_cont','field_5b67caff6afc5'),(22397,1116,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(22398,1116,'_first_image_button','field_5b67cb0d6afc6'),(22399,1116,'second _image_title','Lifestart is about supporting young children'),(22400,1116,'_second _image_title','field_5b67cb20ddf9a'),(22401,1116,'second_image_cont','from 0-24 years living with disabilities and their familes'),(22402,1116,'_second_image_cont','field_5b67cb24ddf9b'),(22403,1116,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(22404,1116,'_second_image_button','field_5b67cb29ddf9c'),(22405,1116,'second_image_title','Lifestart is about supporting young children'),(22406,1116,'_second_image_title','field_5b67cb20ddf9a'),(22407,1116,'page_col_image','412'),(22408,1116,'_page_col_image','field_5de6546e7c63a'),(22409,1116,'page_col_image_3','437'),(22410,1116,'_page_col_image_3','field_5de6e3998e07e'),(22411,1116,'sec_2_title','Community'),(22412,1116,'_sec_2_title','field_5de6e3ef2798f'),(22413,1116,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(22414,1116,'_sec_2_text','field_5de78dc89e613'),(22415,1116,'sec_3_title','The Project'),(22416,1116,'_sec_3_title','field_5de6e3d37d8da'),(22417,1116,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(22418,1116,'_sec_3_text','field_5de6e4044e5e8'),(22419,1116,'page_col_image_2','436'),(22420,1116,'_page_col_image_2','field_5de6546e7c63a'),(22421,1116,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(22422,1116,'_sec_2_button','field_5de6e58c86706'),(22423,1116,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(22424,1116,'_sec_3_button','field_5de6e5a243c03'),(22425,1116,'page_col_image_4','455'),(22426,1116,'_page_col_image_4','field_5de70801090ce'),(22427,1116,'sec_4_title','Location'),(22428,1116,'_sec_4_title','field_5de7082a12a81'),(22429,1116,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(22430,1116,'_sec_4_text','field_5de7084812a82'),(22431,1116,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(22432,1116,'_sec_4_button','field_5de7085e12a83'),(22433,1116,'news_title','Project updates'),(22434,1116,'_news_title','field_5de78da3aabb9'),(22435,1116,'sec_2_text_copy',''),(22436,1116,'_sec_2_text_copy','field_5de78dc89e613'),(22437,1116,'timeline-title','Timeline'),(22438,1116,'_timeline-title','field_5de78df29e615'),(22439,1116,'timeline