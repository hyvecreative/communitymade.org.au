Australia is not working, and Australians are concerned.'),(58555,1795,'_problem_head','field_641935436aded'),(58556,1795,'problem_signoff','Explore the research showing how concerned Australians are our about the housing situation.'),(58557,1795,'_problem_signoff','field_641935626adee'),(58558,1795,'sections','a:2:{i:0;s:4:\"hero\";i:1;s:9:\"news_grid\";}'),(58559,1795,'_sections','field_5dafb40b8143a'),(58560,1795,'sections_0_is_full_height','1'),(58561,1795,'_sections_0_is_full_height','field_61d6f6fd5a37e'),(58562,1795,'sections_0_image','1648'),(58563,1795,'_sections_0_image','field_61d6f6d45a37d'),(58564,1795,'sections_0_heading','Heading'),(58565,1795,'_sections_0_heading','field_61d6f69e5a379'),(58566,1795,'sections_0_subtitle','Ya ya '),(58567,1795,'_sections_0_subtitle','field_61d6f6ac5a37a'),(58568,1795,'sections_0_link_one',''),(58569,1795,'_sections_0_link_one','field_61d6f6b55a37b'),(58570,1795,'sections_0_link_two',''),(58571,1795,'_sections_0_link_two','field_61d6f6c35a37c'),(58572,1795,'sections_1_select_categories','a:1:{i:0;s:2:\"27\";}'),(58573,1795,'_sections_1_select_categories','field_637f04483b63b'),(58574,183,'_wp_old_date','2023-07-23'),(58580,989,'_wp_old_date','2020-12-03'),(58584,1798,'_wp_attached_file','2023/08/protect-beautiful-queensland-hero.jpg'),(58585,1798,'_wp_attachment_metadata','a:6:{s:5:\"width\";i:1920;s:6:\"height\";i:1045;s:4:\"file\";s:45:\"2023/08/protect-beautiful-queensland-hero.jpg\";s:8:\"filesize\";i:700567;s:5:\"sizes\";a:6:{s:6:\"medium\";a:5:{s:4:\"file\";s:45:\"protect-beautiful-queensland-hero-700x381.jpg\";s:5:\"width\";i:700;s:6:\"height\";i:381;s:9:\"mime-type\";s:10:\"image/jpeg\";s:8:\"filesize\";i:92323;}s:5:\"large\";a:5:{s:4:\"file\";s:46:\"protect-beautiful-queensland-hero-1024x557.jpg\";s:5:\"width\";i:1024;s:6:\"height\";i:557;s:9:\"mime-type\";s:10:\"image/jpeg\";s:8:\"filesize\";i:193606;}s:9:\"thumbnail\";a:5:{s:4:\"file\";s:45:\"protect-beautiful-queensland-hero-450x450.jpg\";s:5:\"width\";i:450