566,2071,'problem_icons_3_prob_issue_text',''),(113567,2071,'_problem_icons_3_prob_issue_text','field_640fa11a81d97'),(113568,2071,'problem_icons_0_prob_concerned_text','House prices have doubled in a decade'),(113569,2071,'_problem_icons_0_prob_concerned_text','field_640fa10181d96'),(113570,2071,'problem_icons_1_prob_concerned_text','The gap between rich and poor is growing'),(113571,2071,'_problem_icons_1_prob_concerned_text','field_640fa10181d96'),(113572,2071,'problem_icons_2_prob_concerned_text','Construction of social housing is down'),(113573,2071,'_problem_icons_2_prob_concerned_text','field_640fa10181d96'),(113574,2071,'problem_icons_3_prob_concerned_text','Banks are making more than ever from housing'),(113575,2071,'_problem_icons_3_prob_concerned_text','field_640fa10181d96'),(113576,2071,'monitor_content','The Australian Housing Monitor is a large, nationally-representative survey covering public experiences and attitudes toward housing related issues. Questions range from how well the respondent is keeping up with their mortgage/rent, to what they think about social housing construction.\r\n\r\nA broad range of demographic criteria are included, such as gender, location, age, income, voting preference, educational level, tenure type, and employment status. These variables allow CEH researchers to understand the trends and diversity of opinion around the country.\r\n\r\nIt also incorporates questions from previous surveys to track trends over time.\r\nThe inaugural poll was conducted by Essential in December 2022, and was completed by 4,735 people.'),(113577,2071,'_monitor_content','field_640fcc4014404'),(113578,2071,'problem_head','Housing in Australia is not working, and Australians are concerned.'),(113579,2071,'_problem_head','field_641935436aded'),(113580,2071,'problem_signoff','Explore the research showing how concerned Australians are our about the housing situation.'),(113581,2071,'_problem_signoff','field_641935626adee'),(113582,2071,'sections','a:2:{i:0;s:4:\"hero\";i:1;s:9:\"news_grid\";}'),(113583,2071,'_sections','field_5dafb40b8143a'),(113584,2071,'sections_0_is_full_height','1'),(113585,2071,'_sections_0_is_full_height','field_61d6f6fd5a37e'),(113586,2071,'sections_0_image','1648'),(113587,2071,'_sections_0_image','field_61d6f6d45a37d'),(113588,2071,'sections_0_heading','Heading'),(113589,2071,'_sections_0_heading','field_61d6f69e5a379'),(113590,2071,'sections_0_subtitle','Ya ya '),(113591,2071,'_sections_0_subtitle','field_61d6f6ac5a37a'),(113592,2071,'sections_0_link_one',''),(113593,2071,'_sections_0_link_one','field_61d6f6b55a37b'),(113594,2071,'sections_0_link_two',''),(113595,2071,'_sections_0_link_two','field_61d6f6c35a37c'),(113596,2071,'sections_1_select_categories','a:1:{i:0;s:2:\"27\";}'),(113597,2071,'_sections_1_select_categories','field_637f04483b63b'),(113598,2071,'intro_head_major','Super Consumers Australia is <span>fighting</span> to ensure that the superannuation industry is <span>held accountable</span> for the outcomes they deliver to Australian consumers.'),(113599,2071,'_intro_head_major','field_64e828783ad9f'),(113600,2071,'intro_head_minor','We want super to work for everyone—not just super fund companies. With our research, journalism and campaigns we are creating the trustworthy and transparent superannuation system we all deserve.'),(113601,2071,'_intro_head_minor','field_64e8288c3ada0'),(113602,2071,'intro_icons_0_int_icon','1922'),(113603,2071,'_intro_icons_0_int_icon','field_64e828b33ada2'),(113604,2071,'intro_icons_0_int_icon_text','At 1,727,000 square kilometres, we’re 2.5 times the size of Texas. <span>Yeeha!</span>'),(113605,2071,'_intro_icons_0_int_icon_text','field_64e828e33ada3'),(113606,2071,'intro_icons_1_int_icon','1920'),(113607,2071,'_intro_icons_1_int_icon','field_64e828b33ada2'),(113608,2071,'intro_icons_1_int_icon_text','We have twice as many species of native plant and animal as any other Australian state or territory.'),(113609,2071,'_intro_icons_1_int_i