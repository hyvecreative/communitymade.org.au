7,2164,'survey_index_6_survey_url_text','View Results'),(123088,2164,'_survey_index_6_survey_url_text','field_629456584223a'),(123089,2164,'survey_index_7_survey_icon','1493'),(123090,2164,'_survey_index_7_survey_icon','field_6294562942237'),(123091,2164,'survey_index_7_survey_title','Going Off-grid'),(123092,2164,'_survey_index_7_survey_title','field_6294564042238'),(123093,2164,'survey_index_7_survey_url','#'),(123094,2164,'_survey_index_7_survey_url','field_6294564e42239'),(123095,2164,'survey_index_7_survey_url_text','View Results'),(123096,2164,'_survey_index_7_survey_url_text','field_629456584223a'),(123097,2164,'survey_index','8'),(123098,2164,'_survey_index','field_6294561242236'),(123099,2164,'report_title','Download the report'),(123100,2164,'_report_title','field_62f30edfb57e1'),(123101,2164,'report_intro','Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus massa erat, consectetur at semper at, feugiat vel orci. '),(123102,2164,'_report_intro','field_62f30eedb57e2'),(123103,2164,'report_link_url','#'),(123104,2164,'_report_link_url','field_62f30ef4b57e3'),(123105,2164,'report_link_text','Download'),(123106,2164,'_report_link_text','field_62f30f01b57e4'),(123107,2164,'solutions_content','The housing system is complex, and no one solution will solve the complex problems we now face but there are some critical first steps to be taken now.\r\n<ul>\r\n 	<li>Set out an ambitious national housing agreement between commonwealth and state governments with targets and funding for the construction of affordable homes.</li>\r\n 	<li>Phase out tax breaks for property investors and using the increase in revenue to build more public housing.</li>\r\n 	<li>Establish laws which limit rental increases beyond what is fair.</li>\r\n 	<li>Rebalance tenancy laws to provide renters with more security and control, such as eliminating no grounds evictions.</li>\r\n 	<li>Phase out stamp duty and replace it with a broad-based land tax.</li>\r\n</ul>\r\n<h4>While there are many opinions on what policy changes will fix the housing market, doing nothing is not an option.</h4>'),(123108,2164,'_solutions_content','field_640e8b307a958'),(123109,2164,'problem_icons_0_prob_icon','1699'),(123110,2164,'_problem_icons_0_prob_icon','field_640fa0291d519'),(123111,2164,'problem_icons_0_prob_concerned_stat','70% highly concerned'),(123112,2164,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(123113,2164,'problem_icons_0_prob_concerded_text','are highly concerned'),(123114,2164,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(123115,2164,'problem_icons_0_prob_issue_text',''),(123116,2164,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(123117,2164,'problem_icons','4'),(123118,2164,'_problem_icons','field_640fa0191d518'),(123119,2164,'ceh_content_left',''),(123120,2164,'_ceh_content_left','field_640e97e8f1c8c'),(123121,2164,'ceh_content_right',''),(123122,2164,'_ceh_content_right','field_640e97fdf1c8d'),(123123,2164,'pc_content_left',''),(123124,2164,'_pc_content_left','field_640e983bf1c8f'),(123125,2164,'pc_content_right',''),(123126,2164,'_pc_content_right','field_640e984df1c90'),(123127,2164,'problem_icons_1_prob_icon','1699'),(123128,2164,'_problem_icons_1_prob_icon','field_640fa0291d519'),(123129,2164,'problem_icons_1_prob_concerned_stat','69% highly concerned'),(123130,2164,'_problem_icons_1_prob_concerned_stat','field_640fa0dd81d95'),(123131,2164,'problem_icons_1_prob_concerded_text','are highly concerned'),(123132,2164,'_problem_icons_1_prob_concerded_text','field_640fa10181d96'),(123133,2164,'problem_icons_1_prob_issue_text',''),(123134,2164,'_problem_icons_1_prob_issue_text','field_640fa11a81d97'),(123135,2164,'problem_icons_2_prob_icon','1699'),(123136,2164,'_problem_icons_2_prob_icon','field_640fa0291d519'),(123137,2164,'problem_icons_2_prob_concerned_stat','64% highly concerned'),(123138,2164,'_problem_icons_2_prob_concerned_stat','field_640fa0dd81d95'),(123139,2164,'problem_icons_2_prob_concerded_text','are highly concerned'),(123140,2164,'_problem_icons_2_prob_concerded_text','field_640fa10181d96'),(123141,2164,'problem_icons_2_prob_issue_text',''),(123142,2164,'_problem_icons_2_prob_issue_text','field_640fa11a81d97'),(123143,2164,'problem_icons_3_prob_icon','1699'),(123144,2164,'_problem_icons_3_prob_icon','field_640fa0291d519'),(123145,2164,'problem_icons_3_prob_concerned_stat','64% highly concerned'),(123146,2164,'_problem_icons_3_prob_concerned_stat','field_640fa0dd81d95'),(123147,2164,'problem_icons_3_prob_concerded_text','are highly concerned'),(123148,2164,'_problem_icons_3_prob_concerded_text','field_640fa10181d96'),(123149,2164,'problem_icons_3_prob_issue_text',''),(123150,2164,'_problem_icons_3_prob_issue_text','field_640fa11a81d97'),(123151,2164,'problem_icons_0_prob_concerned_text','House prices have doubled in a decade'),(123152,2164,'_problem_icons_0_prob_concerned_text','field_640fa10181d96'),(123153,2164,'problem_icons_1_prob_concerned_text','The gap between rich and poor is growing'),(123154,2164,'_problem_icons_1_prob_concerned_text','field_640fa10181d96'),(123155,2164,'problem_icons_2_prob_concerned_text','Construction of social housing is down'),(123156,2164,'_problem_icons_2_prob_concerned_text','field_640fa10181d96'),(123157,2164,'problem_icons_3_prob_concerned_text','Banks are making more than ever from housing'),(123158,2164,'_problem_icons_3_prob_concerned_text','field_640fa10181d96'),(123159,2164,'monitor_content','The Australian Housing Monitor is a large, nationally-representative survey covering public experiences and attitudes toward housing related issues. Questions range from how well the respondent is keeping up with their mortgage/rent, to what they think about social housing construction.\r\n\r\nA broad range of demographic criteria are included, such as gender, location, age, income, voting preference, educational level, tenure type, and employment status. These variables allow CEH researchers to understand the trends and diversity of opinion around the country.\r\n\r\nIt also incorporates questions from previous surveys to track trends over time.\r\nThe inaugural poll was conducted by Essential in December 2022, and was completed by 4,735 people.'),(123160,2164,'_monitor_content','field_640fcc4014404'),(123161,2164,'problem_head','Housing in Australia is not working, and Australians are concerned.'),(123162,2164,'_problem_head','field_641935436aded'),(123163,2164,'problem_signoff','Explore the research showing how concerned Australians are our about the housing situation.'),(123164,2164,'_problem_signoff','field_641935626adee'),(123165,2164,'sections','a:2:{i:0;s:4:\"hero\";i:1;s:9:\"news_grid\";}'),(123166,2164,'_sections','field_5dafb40b8143a'),(123167,2164,'sections_0_is_full_height','1'),(123168,2164,'_sections_0_is_full_height','field_61d6f6fd5a37e'),(123169,2164,'sections_0_image','1648'),(123170,2164,'_sections_0_image','field_61d6f6d45a37d'),(123171,2164,'sections_0_heading','Heading'),(123172,2164,'_sections_0_heading','field_61d6f69e5a379'),(123173,2164,'sections_0_subtitle','Ya ya '),(123174,2164,'_sections_0_subtitle','field_61d6f6ac5a37a'),(123175,2164,'sections_0_link_one',''),(123176,2164,'_sections_0_link_one','field_61d6f6b55a37b'),(123177,2164,'sections_0_link_two',''),(123178,2164,'_sections_0_link_two','field_61d6f6c35a37c'),(123179,2164,'sections_1_select_categories','a:1:{i:0;s:2:\"27\";}'),(123180,2164,'_sections_1_select_categories','field_637f04483b63b'),(123181,2164,'intro_head_major','Welcome to the Disability Dialogue'),(123182,2164,'_intro_head_major','field_64e828783ad9f'),(123183,2164,'intro_head_minor',''),(123184,2164,'_intro_head_minor','field_64e8288c3ada0'),(123185,2164,'intro_icons_0_int_icon','1922'),(123186,2164,'_intro_icons_0_int_icon','field_64e828b33ada2'),(123187,2164,'intro_icons_0_int_icon_text','At 1,727,000 square kilometres, we’re 2.5 times the size of Texas. <span>Yeeha!</span>'),(123188,2164,'_intro_icons_0_int_icon_text','fie