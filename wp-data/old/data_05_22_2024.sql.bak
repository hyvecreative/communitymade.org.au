87,1827,'sec_2_title','Community'),(63188,1827,'_sec_2_title','field_5de6e3ef2798f'),(63189,1827,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(63190,1827,'_sec_2_text','field_5de78dc89e613'),(63191,1827,'sec_3_title','The Project'),(63192,1827,'_sec_3_title','field_5de6e3d37d8da'),(63193,1827,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(63194,1827,'_sec_3_text','field_5de6e4044e5e8'),(63195,1827,'page_col_image_2','436'),(63196,1827,'_page_col_image_2','field_5de6546e7c63a'),(63197,1827,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(63198,1827,'_sec_2_button','field_5de6e58c86706'),(63199,1827,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(63200,1827,'_sec_3_button','field_5de6e5a243c03'),(63201,1827,'page_col_image_4','455'),(63202,1827,'_page_col_image_4','field_5de70801090ce'),(63203,1827,'sec_4_title','Location'),(63204,1827,'_sec_4_title','field_5de7082a12a81'),(63205,1827,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(63206,1827,'_sec_4_text','field_5de7084812a82'),(63207,1827,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(63208,1827,'_sec_4_button','field_5de7085e12a83'),(63209,1827,'news_title','Project updates'),(63210,1827,'_news_title','field_5de78da3aabb9'),(63211,1827,'sec_2_text_copy',''),(63212,1827,'_sec_2_text_copy','field_5de78dc89e613'),(63213,1827,'timeline-title','Timeline'),(63214,1827,'_timeline-title','field_5de78df29e615'),(63215,1827,'timeline_title','Timeline'),(63216,1827,'_timeline_title','field_5de78df29e615'),(63217,1827,'contact_title','Contact us'),(63218,1827,'_contact_title','field_5de7981e06057'),(63219,1827,'contact_intro','Contact text...'),(63220,1827,'_contact_intro','field_5de7983506058'),(63221,1827,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(63222,1827,'_news_button','field_5de8329896e02'),(63223,1827,'timeline_intro','Introduction of timeline detail...'),(63224,1827,'_timeline_intro','field_5de98f5fb1781'),(63225,1827,'timeline_pic','477'),(63226,1827,'_timeline_pic','field_5de98f72b1782'),(63227,1827,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(63228,1827,'_timeline_button','field_5de99363677f8'),(63229,1827,'banner_image_position','center'),(63230,1827,'_banner_image_position','field_5f3bc4757dd02'),(63231,1827,'services_title','Our services'),(63232,1827,'_services_title','field_5f20f3cd80eb2'),(63233,1827,'services_items_0_services_item_image','1061'),(63234,1827,'_services_items_0_services_item_image','field_5f2121355be14'),(63235,1827,'services_items_0_sservices_item_title','1300 Telephone counselling line'),(63236,1827,'_services_items_0_sservices_item_title','field_605089efca82e'),(63237,1827,'services_items_0_services_item_text',''),(63238,1827,'_services_items_0_services_item_text','field_5f2121535be15'),(63239,1827,'services_items_0_services_link_url','#'),(63240,1827,'_services_items_0_services_link_url','field_6050866041225'),(63241,1827,'services_items_0_services_link_text','Find ou