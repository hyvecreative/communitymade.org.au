llis ut. Mauris pretium, massa non efficitur lacinia, sapien turpis blandit erat, nec dictum turpis metus quis dolor. Interdum et malesuada fames ac ante ipsum primis in faucibus.'),(51922,1662,'_solutions_content','field_640e8addd2577'),(51984,6,'problem_icons_0_prob_icon','1699'),(51985,6,'_problem_icons_0_prob_icon','field_640fa0291d519'),(51986,6,'problem_icons_0_prob_concerned_stat','70% highly concerned'),(51987,6,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(51988,6,'problem_icons_0_prob_concerded_text','are highly concerned'),(51989,6,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(51990,6,'problem_icons_0_prob_issue_text',''),(51991,6,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(51992,6,'problem_icons','4'),(51993,6,'_problem_icons','field_640fa0191d518'),(51994,6,'ceh_content_left',''),(51995,6,'_ceh_content_left','field_640e97e8f1c8c'),(51996,6,'ceh_content_right',''),(51997,6,'_ceh_content_right','field_640e97fdf1c8d'),(51998,6,'pc_content_left',''),(51999,6,'_pc_content_left','field_640e983bf1c8f'),(52000,6,'pc_content_right',''),(52001,6,'_pc_content_right','field_640e984df1c90'),(52002,1700,'banner_head',''),(52003,1700,'_banner_head','field_5b568121a8ffe'),(52004,1700,'banner_sub',''),(52005,1700,'_banner_sub','field_5b568139fd366'),(52006,1700,'banner_button','<a class=\"btn btn-home\" style=\"width: 200px;\" href=\"#project\">Sign the petition</a>'),(52007,1700,'_banner_button','field_5b568147fd367'),(52008,1700,'support_section_title','How can Lifestart support you?'),(52009,1700,'_support_section_title','field_5b67c7d060398'),(52010,1700,'support_left_title','Services'),(52011,1700,'_support_left_title','field_5b67c298e7f8f'),(52012,1700,'support_left_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy.'),(52013,1700,'_support_left_cont','field_5b67c5f6e7f91'),(52014,1700,'support_left_button','<a class=\"btn btn-green\" href=\"/services/\">View all services</a>'),(52015,