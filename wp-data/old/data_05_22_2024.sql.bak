button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(110997,2068,'_second_image_button','field_5b67cb29ddf9c'),(110998,2068,'second_image_title','Lifestart is about supporting young children'),(110999,2068,'_second_image_title','field_5b67cb20ddf9a'),(111000,2068,'page_col_image','412'),(111001,2068,'_page_col_image','field_5de6546e7c63a'),(111002,2068,'page_col_image_3','437'),(111003,2068,'_page_col_image_3','field_5de6e3998e07e'),(111004,2068,'sec_2_title','Community'),(111005,2068,'_sec_2_title','field_5de6e3ef2798f'),(111006,2068,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(111007,2068,'_sec_2_text','field_5de78dc89e613'),(111008,2068,'sec_3_title','The Project'),(111009,2068,'_sec_3_title','field_5de6e3d37d8da'),(111010,2068,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(111011,2068,'_sec_3_text','field_5de6e4044e5e8'),(111012,2068,'page_col_image_2','436'),(111013,2068,'_page_col_image_2','field_5de6546e7c63a'),(111014,2068,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(111015,2068,'_sec_2_button','field_5de6e58c86706'),(111016,2068,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(111017,2068,'_sec_3_button','field_5de6e5a243c03'),(111018,2068,'page_col_image_4','455'),(111019,2068,'_page_col_image_4','field_5de70801090ce'),(111020,2068,'sec_4_title','Location'),(111021,2068,'_sec_4_title','field_5de7082a12a81'),(111022,2068,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(111023,2068,'_sec_4_text','field_5de7084812a82'),(111024,2068,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(111025,2068,'_sec_4_button','field_5de7085e12a83'),(111026,2068,'news_title','Project updates'),(111027,2068,'_news_title','field_5de78da3aabb9'),(111028,2068,'sec_2_text_copy',''),(111029,2068,'_sec_2_text_copy','field_5de78dc89e613'),(111030,2068,'timeline-title','Timeline'),(111031,2068,'_timeline-title','field_5de78df29e615'),(111032,2068,'timeline_title','Timeline'),(111033,2068,'_timeline_title','field_5de78df29e615'),(111034,2068,'contact_title','Contact us'),(111035,2068,'_contact_title','field_5de7981e06057'),(111036,2068,'contact_intro','Contact text...'),(111037,2068,'_contact_intro','field_5de7983506058'),(111038,2068,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(111039,2068,'_news_button','field_5de8329896e02'),(111040,2068,'timeline_intro','Introduction of timeline detail...'),(111041,2068,'_timeline_intro','field_5de98f5fb1781'),(111042,2068,'timeline_pic','477'),(111043,2068,'_timeline_pic','field_5de98f72b1782'),(111044,2068,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(111045,2068,'_timeline_button','field_5de99363677f8'),(111046,2068,'banner_image_position','center'),(111047,2068,'_banner_image_position','field_5f3bc4757dd02'),(111048,2068,'services_title','Our services'),(111049,2068,'_services_title','field_5f20f3cd80eb2'),(111050,2068,'services_items_0_services_item_image','1061'),(111051,2068,'_services_items_0_services_item_