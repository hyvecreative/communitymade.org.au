y_index_6_survey_url_text','field_629456584223a'),(127458,2203,'survey_index_7_survey_icon','1493'),(127459,2203,'_survey_index_7_survey_icon','field_6294562942237'),(127460,2203,'survey_index_7_survey_title','Going Off-grid'),(127461,2203,'_survey_index_7_survey_title','field_6294564042238'),(127462,2203,'survey_index_7_survey_url','#'),(127463,2203,'_survey_index_7_survey_url','field_6294564e42239'),(127464,2203,'survey_index_7_survey_url_text','View Results'),(127465,2203,'_survey_index_7_survey_url_text','field_629456584223a'),(127466,2203,'survey_index','8'),(127467,2203,'_survey_index','field_6294561242236'),(127468,2203,'report_title','Download the report'),(127469,2203,'_report_title','field_62f30edfb57e1'),(127470,2203,'report_intro','Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus massa erat, consectetur at semper at, feugiat vel orci. '),(127471,2203,'_report_intro','field_62f30eedb57e2'),(127472,2203,'report_link_url','#'),(127473,2203,'_report_link_url','field_62f30ef4b57e3'),(127474,2203,'report_link_text','Download'),(127475,2203,'_report_link_text','field_62f30f01b57e4'),(127476,2203,'solutions_content','The housing system is complex, and no one solution will solve the complex problems we now face but there are some critical first steps to be taken now.\r\n<ul>\r\n 	<li>Set out an ambitious national housing agreement between commonwealth and state governments with targets and funding for the construction of affordable homes.</li>\r\n 	<li>Phase out tax breaks for property investors and using the increase in revenue to build more public housing.</li>\r\n 	<li>Establish laws which limit rental increases beyond what is fair.</li>\r\n 	<li>Rebalance tenancy laws to provide renters with more security and control, such as eliminating no grounds evictions.</li>\r\n 	<li>Phase out stamp duty and replace it with a broad-based land tax.</li>\r\n</ul>\r\n<h4>While there are many opinions on what policy changes will fix the housing market, doing nothing is not an option.</h4>'),(127477,2203,'_solutions_content','field_640e8b307a958'),(127478,2203,'problem_icons_0_prob_icon','1699'),(127479,2203,'_problem_icons_0_prob_icon','field_640fa0291d519'),(127480,2203,'problem_icons_0_prob_concerned_stat','70% highly concerned'),(127481,2203,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(127482,2203,'problem_icons_0_prob_concerded_text','are highly concerned'),(127483,2203,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(127484,2203,'problem_icons_0_prob_issue_text',''),(127485,2203,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(127486,2203,'problem_icons','4'),(127487,2203,'_problem_icons','field_640fa0191d518'),(127488,2203,'ceh_content_left',''),(127489,2203,'_ceh_content_left','field_640e97e8f1c8c'),(127490,2203,'ceh_content_right',''),(127491,2203,'_ceh_content_right','field_640e97fdf1c8d'),(127492,2203,'pc_content_left',''),(127493,2203,'_pc_content_left','field_640e983bf1c8f'),(127494,2203,'pc_content_right',''),(127495,2203,'_pc_content_right','field_640e984df1c90'),(127496,2203,'problem_icons_1_prob_icon','1699'),(127497,2203,'_problem_icons_1_prob_icon','field_640fa0291d519'),(127498,2203,'problem_icons_1_prob_concerned_stat','69% highly concerned'),(127499,2203,'_problem_icons_1_prob_concerned_stat','field_640fa0dd81d95'),(127500,2203,'problem_icons_1_prob_concerded_text','are highly concerned'),(127501,2203,'_problem_icons_1_prob_concerded_text','field_640fa10181d96'),(127502,2203,'problem_icons_1_prob_issue_text',''),(127503,2203,'_problem_icons_1_prob_issue_text','field_640fa11a81d97'),(127504,2203,'problem_icons_2_prob_icon','1699'),(127505,2203,'_problem_icons_2_prob_icon','field_640fa0291d519'),(127506,2203,'problem_icons_2_prob_concerned_stat','64% highly concerned'),(127507,2203,'_problem_icons_2_prob_concerned_stat','field_640fa0dd81d95'),(127508,2203,'problem_icons_2_prob_concerded_text','are highly concerned'),(127509,2203,'_problem_icons_2_prob_concerded_text','field_640fa10181d96'),(127510,2203,'problem_icons_2_prob_issue_text',''),(127511,2203,'_problem_icons_2_prob_issue_text','field_640fa11a81d97'),(127512,2203,'problem_icons_3_prob_icon','1699'),(127513,2203,'_problem_icons_3_prob_icon','field_640fa0291d519'),(127514,2203,'problem_icons_3_prob_concerned_stat','64% highly concerned'),(127515,2203,'_problem_icons_3_prob_concerned_stat','field_640fa0dd81d95'),(127516,2203,'problem_icons_3_prob_concerded_text','are highly concerned'),(127517,2203,'_problem_icons_3_prob_concerded_text','field_640fa10181d96'),(127518,2203,'problem_icons_3_prob_issue_text',''),(127519,2203,'_problem_icons_3_prob_issue_text','field_640fa11a81d97'),(127520,2203,'problem_icons_0_prob_concerned_text','House prices have doubled in a decade'),(127521,2203,'_problem_icons_0_prob_concerned_text','field_640fa10181d96'),(127522,2203,'problem_icons_1_prob_concerned_text','The gap between rich and poor is growing'),(127523,2203,'_problem_icons_1_prob_concerned_text','field_640fa10181d96'),(127524,2203,'problem_icons_2_prob_concerned_text','Construction of social housing is down'),(127525,2203,'_problem_icons_2_prob_concerned_text','field_640fa10181d96'),(127526,2203,'problem_icons_3_prob_concerned_text','Banks are making more than ever from housing'),(127527,2203,'_problem_icons_3_prob_concerned_text','field_640fa10181d96'),(127528,2203,'monitor_content','The Australian Housing Monitor is a large, nationally-representative survey covering public experiences and attitudes toward housing related issues. Questions range from how well the respondent is keeping up with their mortgage/rent, to what they think about social housing construction.\r\n\r\nA broad range of demographic criteria are included, such as gender, location, age, income, voting preference, educational level, tenure type, and employment status. These variables allow CEH researchers to understand the trends and diversity of opinion around the country.\r\n\r\nIt also incorporates questions from previous surveys to track trends over time.\r\nThe inaugural poll was conducted by Essential in December 2022, and was completed by 4,735 people.'),(127529,2203,'_monitor_content','field_640fcc4014404'),(127530,2203,'problem_head','Housing in Australia is not working, and Australians are concerned.'),(127531,2203,'_problem_head','field_641935436aded'),(127532,2203,'problem_signoff','Explore the research showing how concerned Australians are our about the housing situation.'),(127533,2203,'_problem_signoff','field_641935626adee'),(127534,2203,'sections','a:2:{i:0;s:4:\"hero\";i:1;s:9:\"news_grid\";}'),(127535,2203,'_sections','field_5dafb40b8143a'),(127536,2203,'sections_0_is_full_height','1'),(127537,2203,'_sections_0_is_full_height','field_61d6f6fd5a37e'),(127538,2203,'sections_0_image','1648'),(127539,2203,'_sections_0_image','field_61d6f6d45a37d'),(127540,2203,'sections_0_heading','Heading'),(127541,2203,'_sections_0_heading','field_61d6f69e5a379'),(127542,2203,'sections_0_subtitle','Ya ya '),(127543,2203,'_sections_0_subtitle','field_61d6f6ac5a37a'),(127544,2203,'sections_0_link_one',''),(127545,2203,'_sections_0_link_one','field_61d6f6b55a37b'),(127546,2203,'sections_0_link_two',''),(127547,2203,'_sections_0_link_two','field_61d6f6c35a37c'),(127548,2203,'sections_1_select_categories','a:1:{i:0;s:2:\"27\";}'),(127549,2203,'_sections_1_select_categories','field_637f04483b63b'),(127550,2203,'intro_head_major','Welcome to the Disability Dialogue'),(127551,2203,'_intro_head_major','field_64e828783ad9f'),(127552,2203,'intro_head_minor',''),(127553,2203,'_intro_head_minor','field_64e8288c3ada0'),(127554,2203,'intro_icons_0_int_icon','1922'),(127555,2203,'_intro_icons_0_int_icon','field_64e828b33ada2'),(127556,2203,'intro_icons_0_int_icon_text','At 1,727,000 square kilometres, we’re 2.5 times the size of Texas. <span>Yeeha!</span>'),(127557,2203,'_intro_icons_0_int_icon_text','field_64e828e33ada3'),(127558,2203,'intro_icons_1_int_icon','1920'),(127559,2203,'_intro_icons_1_int_icon','field_64e828b33ada2'),(127560,2203,'intro_icons_1_int_icon_text','We have twice as many species of native plant and animal as any other Australian state or territory.'),(127561,2203,'_intro_icons_1_int_icon_text','field_64e828e33ada3'),(127562,2203,'intro_icons_2_int_icon','1921'),(127563,2203,'_intro_icons_2_int_icon','field_64e828b33ada2'),(127564,2203,'intro_icons_2_int_icon_text','We have less land classified as ‘protected’ than any other state or territory.'),(127565,2203,'_intro_icons_2_int_icon_text','field_64e828e33ada3'),(127566,2203,'intro_icons','3'),(127567,2203,'_intro_icons','field_64e828963ada1'),(127568,2203,'threat_head_major','What we stand to lose if we don’t act soon to protect beautiful Queensland:'),(127569,2203,'_threat_head_major','field_64ec258d9dbd1'),(127570,2203,'threats_icons','3'),(127571,2203,'_threats_icons','field_64ec2551a93f9'),(127572,2203,'threats_icons_0_thr_icon','1819'),(127573,2203,'_threats_icons_0_thr_icon','field_64ec2551a93fa'),(127574,2203,'threats_icons_0_thr_icon_text','The rich cultural heritage of our First Nations people and their continuous ties to country, dating back more than 50,000 years.'),(127575,2203,'_threats_icons_0_thr_icon_text','field_64ec2551a93fb'),(127576,2203,'threats_icons_1_thr_icon','1819'),(127577,2203,'_threats_icons_1_thr_icon','field_64ec2551a93fa'),(127578,2203,'threats_icons_1_thr_icon_text','Thousands of species of plant and animal which are now classified as threatened or endangered in Queensland.'),(127579,2203,'_threats_icons_1_thr_icon_text','field_64ec2551a93fb'),(127580,2203,'threats_icons_2_thr_icon','1819'),(127581,2203,'_threats_icons_2_thr_icon','field_64ec2551a93fa'),(127582,2203,'threats_icons_2_thr_icon_text','The access to nature that is central to the Queensland way of life.'),(127583,2203,'_threats_icons_2_thr_icon_text','field_64ec2551a93fb'),(127584,2203,'threat_icons_0_thr_icon',''),(127585,2203,'_threat_icons_0_thr_icon','field_64ec2551a93fa