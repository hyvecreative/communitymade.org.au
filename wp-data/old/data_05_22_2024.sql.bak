8362,1876,'second_image_cont','from 0-24 years living with disabilities and their familes'),(78363,1876,'_second_image_cont','field_5b67cb24ddf9b'),(78364,1876,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(78365,1876,'_second_image_button','field_5b67cb29ddf9c'),(78366,1876,'second_image_title','Lifestart is about supporting young children'),(78367,1876,'_second_image_title','field_5b67cb20ddf9a'),(78368,1876,'page_col_image','412'),(78369,1876,'_page_col_image','field_5de6546e7c63a'),(78370,1876,'page_col_image_3','437'),(78371,1876,'_page_col_image_3','field_5de6e3998e07e'),(78372,1876,'sec_2_title','Community'),(78373,1876,'_sec_2_title','field_5de6e3ef2798f'),(78374,1876,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(78375,1876,'_sec_2_text','field_5de78dc89e613'),(78376,1876,'sec_3_title','The Project'),(78377,1876,'_sec_3_title','field_5de6e3d37d8da'),(78378,1876,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(78379,1876,'_sec_3_text','field_5de6e4044e5e8'),(78380,1876,'page_col_image_2','436'),(78381,1876,'_page_col_image_2','field_5de6546e7c63a'),(78382,1876,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(78383,1876,'_sec_2_button','field_5de6e58c86706'),(78384,1876,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(78385,1876,'_sec_3_button','field_5de6e5a243c03'),(78386,1876,'page_col_image_4','455'),(78387,1876,'_page_col_image_4','field_5de70801090ce'),(78388,1876,'sec_4_title','Location'),(78389,1876,'_sec_4_title','field_5de7082a12a81'),(78390,1876,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(78391,1876,'_sec_4_text','field_5de7084812a82'),(78392,1876,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(78393,1876,'_sec_4_button','field_5de7085e12a83'),(78394,1876,'news_title','Project updates'),(78395,1876,'_news_title','field_5de78da3aabb9'),(78396,1876,'sec_2_text_copy',''),(78397,1876,'_sec_2_text_copy','field_5de78dc89e613'),(78398,1876,'timeline-title','Timeline'),(78399,1876,'_timeline-title','field_5de78df29e615'),(78400,1876,'timeline_title','Timeline'),(78401,1876,'_timeline_title','field_5de78df29e615'),(78402,1876,'contact_title','Contact us'),(78403,1876,'_contact_title','field_5de7981e06057'),(78404,1876,'contact_intro','Contact text...'),(78405,1876,'_contact_intro','field_5de7983506058'),(78406,1876,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(78407,1876,'_news_button','field_5de8329896e02'),(78408,1876,'timeline_intro','Introduction of timeline detail...'),(78409,1876,'_timeline_intro','field_5de98f5fb1781'),(78410,1876,'timeline_pic','477'),(78411,1876,'_timeline_pic','field_5de98f72b1782'),(78412,1876,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(78413,1876,'_timeline_button','field_5de99363677f8'),(78414,1876,'banner_image_position','center'),(78415,1876,'_banner_image_position','field_5f3bc4757dd02'),(78416,1876,'services_title','Our services'),(78417,1876,'_services_title','field_5