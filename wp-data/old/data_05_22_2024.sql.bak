30ef4b57e3'),(66031,1835,'report_link_text','Download'),(66032,1835,'_report_link_text','field_62f30f01b57e4'),(66033,1835,'solutions_content','The housing system is complex, and no one solution will solve the complex problems we now face but there are some critical first steps to be taken now.\r\n<ul>\r\n 	<li>Set out an ambitious national housing agreement between commonwealth and state governments with targets and funding for the construction of affordable homes.</li>\r\n 	<li>Phase out tax breaks for property investors and using the increase in revenue to build more public housing.</li>\r\n 	<li>Establish laws which limit rental increases beyond what is fair.</li>\r\n 	<li>Rebalance tenancy laws to provide renters with more security and control, such as eliminating no grounds evictions.</li>\r\n 	<li>Phase out stamp duty and replace it with a broad-based land tax.</li>\r\n</ul>\r\n<h4>While there are many opinions on what policy changes will fix the housing market, doing nothing is not an option.</h4>'),(66034,1835,'_solutions_content','field_640e8b307a958'),(66035,1835,'problem_icons_0_prob_icon','1699'),(66036,1835,'_problem_icons_0_prob_icon','field_640fa0291d519'),(66037,1835,'problem_icons_0_prob_concerned_stat','70% highly concerned'),(66038,1835,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(66039,1835,'problem_icons_0_prob_concerded_text','are highly concerned'),(66040,1835,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(66041,1835,'problem_icons_0_prob_issue_text',''),(66042,1835,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(66043,1835,'problem_icons','4'),(66044,1835,'_problem_icons','field_640fa0191d518'),(66045,1835,'ceh_content_left',''),(66046,1835,'_ceh_content_left','field_640e97e8f1c8c'),(66047,1835,'ceh_content_right',''),(66048,1835,'_ceh_content_right','field_640e97fdf1c8d'),(66049,1835,'pc_content_left',''),(66050,1835,'_pc_content_left','field_640e983bf1c8f'),(66051,1835,'pc_content_right',''),(66