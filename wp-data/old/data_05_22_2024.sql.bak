x_5_survey_url_text','field_629456584223a'),(111410,2068,'survey_index_6_survey_icon','1492'),(111411,2068,'_survey_index_6_survey_icon','field_6294562942237'),(111412,2068,'survey_index_6_survey_title','Energy Management'),(111413,2068,'_survey_index_6_survey_title','field_6294564042238'),(111414,2068,'survey_index_6_survey_url','#'),(111415,2068,'_survey_index_6_survey_url','field_6294564e42239'),(111416,2068,'survey_index_6_survey_url_text','View Results'),(111417,2068,'_survey_index_6_survey_url_text','field_629456584223a'),(111418,2068,'survey_index_7_survey_icon','1493'),(111419,2068,'_survey_index_7_survey_icon','field_6294562942237'),(111420,2068,'survey_index_7_survey_title','Going Off-grid'),(111421,2068,'_survey_index_7_survey_title','field_6294564042238'),(111422,2068,'survey_index_7_survey_url','#'),(111423,2068,'_survey_index_7_survey_url','field_6294564e42239'),(111424,2068,'survey_index_7_survey_url_text','View Results'),(111425,2068,'_survey_index_7_survey_url_text','field_629456584223a'),(111426,2068,'survey_index','8'),(111427,2068,'_survey_index','field_6294561242236'),(111428,2068,'report_title','Download the report'),(111429,2068,'_report_title','field_62f30edfb57e1'),(111430,2068,'report_intro','Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus massa erat, consectetur at semper at, feugiat vel orci. '),(111431,2068,'_report_intro','field_62f30eedb57e2'),(111432,2068,'report_link_url','#'),(111433,2068,'_report_link_url','field_62f30ef4b57e3'),(111434,2068,'report_link_text','Download'),(111435,2068,'_report_link_text','field_62f30f01b57e4'),(111436,2068,'solutions_content','The housing system is complex, and no one solution will solve the complex problems we now face but there are some critical first steps to be taken now.\r\n<ul>\r\n 	<li>Set out an ambitious national housing agreement between commonwealth and state governments with targets and funding for the construction of affordable homes.</li>\r\n 	<li>Phase out tax breaks for property investors and using the increase in revenue to build more public housing.</li>\r\n 	<li>Establish laws which limit rental increases beyond what is fair.</li>\r\n 	<li>Rebalance tenancy laws to provide renters with more security and control, such as eliminating no grounds evictions.</li>\r\n 	<li>Phase out stamp duty and replace it with a broad-based land tax.</li>\r\n</ul>\r\n<h4>While there are many opinions on what policy changes will fix the housing market, doing nothing is not an option.</h4>'),(111437,2068,'_solutions_content','field_640e8b307a958'),(111438,2068,'problem_icons_0_prob_icon','1699'),(111439,2068,'_problem_icons_0_prob_icon','field_640fa0291d519'),(111440,2068,'problem_icons_0_prob_concerned_stat','70% highly concerned'),(111441,2068,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(111442,2068,'problem_icons_0_prob_concerded_text','are highly concerned'),(111443,2068,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(111444,2068,'problem_icons_0_prob_issue_text',''),(111445,2068,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(111446,2068,'problem_icons','4'),(111447,2068,'_problem_icons','field_640fa0191d518'),(111448,2068,'ceh_content_left',''),(111449,2068,'_ceh_content_left','field_640e97e8f1c8c'),(111450,2068,'ceh_content_right',''),(111451,2068,'_ceh_content_right','field_640e97fdf1c8d'),(111452,2068,'pc_content_left',''),(111453,2068,'_pc_content_left','field_640e983bf1c8f'),(111454,2068,'pc_content_right',''),(111455,2068,'_pc_content_right','field_640e984df1c90'),(111456,2068,'problem_icons_1_prob_icon','1699'),(111457,2068,'_problem_icons_1_prob_icon','field_640fa0291d519'),(111458,2068,'problem_icons_1_prob_concerned_stat','69% highly concerned'),(111459,2068,'_problem_icons_1_prob_concerned_stat','field_640fa0dd81d95'),(111460,2068,'problem_icons_1_prob_concerded_text','are highly concerned'),(111461,2068,'_problem_icons_1_prob_concerded_text','field_640fa10181d96'),(111462,2068,'prob