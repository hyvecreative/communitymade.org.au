_image_title','Lifestart is about supporting young children'),(66258,1846,'_first_image_title','field_5b67ca606afc4'),(66259,1846,'first_image_cont','from 0-24 years living with disabilities and their familes'),(66260,1846,'_first_image_cont','field_5b67caff6afc5'),(66261,1846,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(66262,1846,'_first_image_button','field_5b67cb0d6afc6'),(66263,1846,'second _image_title','Lifestart is about supporting young children'),(66264,1846,'_second _image_title','field_5b67cb20ddf9a'),(66265,1846,'second_image_cont','from 0-24 years living with disabilities and their familes'),(66266,1846,'_second_image_cont','field_5b67cb24ddf9b'),(66267,1846,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(66268,1846,'_second_image_button','field_5b67cb29ddf9c'),(66269,1846,'second_image_title','Lifestart is about supporting young children'),(66270,1846,'_second_image_title','field_5b67cb20ddf9a'),(66271,1846,'page_col_image','412'),(66272,1846,'_page_col_image','field_5de6546e7c63a'),(66273,1846,'page_col_image_3','437'),(66274,1846,'_page_col_image_3','field_5de6e3998e07e'),(66275,1846,'sec_2_title','Community'),(66276,1846,'_sec_2_title','field_5de6e3ef2798f'),(66277,1846,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(66278,1846,'_sec_2_text','field_5de78dc89e613'),(66279,1846,'sec_3_title','The Project'),(66280,1846,'_sec_3_title','field_5de6e3d37d8da'),(66281,1846,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(66282,1846,'_sec_3_text','field_5de6e4044e5e8'),(66283,1846,'page_col_image_2','436'),(66284,1846,'_page_col_image_2','field_5de6546e7c63a'),(66285,1846,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(66286,1846,'_sec_2_button','field_5de6e58c86706'),(66287,1846,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(66288,1846,'_sec_3_button','field_5de6e5a243c03'),(66289,1846,'page_col_image_4','455'),(66290,1846,'_page_col_image_4','field_5de70801090ce'),(66291,1846,'sec_4_title','Location'),(66292,1846,'_sec_4_title','field_5de7082a12a81'),(66293,1846,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(66294,1846,'_sec_4_text','field_5de7084812a82'),(66295,1846,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(66296,1846,'_sec_4_button','field_5de7085e12a83'),(66297,1846,'news_title','Project updates'),(66298,1846,'_news_title','field_5de78da3aabb9'),(66299,1846,'sec_2_text_copy',''),(66300,1846,'_sec_2_text_copy','field_5de78dc89e613'),(66301,1846,'timeline-title','Timeline'),(66302,1846,'_timeline-title','field_5de78df29e615'),(66303,1846,'timeline_title','Timeline'),(66304,1846,'_timeline_title','field_5de78df29e615'),(66305,1846,'contact_title','Contact us'),(66306,1846,'_contact_title','field_5de7981e06057'),(66307,1846,'contact_intro','Contact text...'),(66308,1846,'_contact_intro','field_5de7983506058'),(66309,1846,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(66310,1846,'_news_button','field_5de8329896e02'),(66311,1846