0405,1913,'_second_image_button','field_5b67cb29ddf9c'),(80406,1913,'second_image_title','Lifestart is about supporting young children'),(80407,1913,'_second_image_title','field_5b67cb20ddf9a'),(80408,1913,'page_col_image','412'),(80409,1913,'_page_col_image','field_5de6546e7c63a'),(80410,1913,'page_col_image_3','437'),(80411,1913,'_page_col_image_3','field_5de6e3998e07e'),(80412,1913,'sec_2_title','Community'),(80413,1913,'_sec_2_title','field_5de6e3ef2798f'),(80414,1913,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(80415,1913,'_sec_2_text','field_5de78dc89e613'),(80416,1913,'sec_3_title','The Project'),(80417,1913,'_sec_3_title','field_5de6e3d37d8da'),(80418,1913,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(80419,1913,'_sec_3_text','field_5de6e4044e5e8'),(80420,1913,'page_col_image_2','436'),(80421,1913,'_page_col_image_2','field_5de6546e7c63a'),(80422,1913,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(80423,1913,'_sec_2_button','field_5de6e58c86706'),(80424,1913,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(80425,1913,'_sec_3_button','field_5de6e5a243c03'),(80426,1913,'page_col_image_4','455'),(80427,1913,'_page_col_image_4','field_5de70801090ce'),(80428,1913,'sec_4_title','Location'),(80429,1913,'_sec_4_title','field_5de7082a12a81'),(80430,1913,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(80431,1913,'_sec_4_text','field_5de7084812a82'),(80432,1913,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(80433,1913,'_sec_4_button','field_5de7085e12a83'),(80434,1913,'news_title','Project updates'),(80435,1913,'_news_title','field_5de78da3aabb9'),(80436,1913,'sec_2_text_copy',''),(80437,1913,'_sec_2_text_copy','field_5de78dc89e613'),(80438,1913,'timeline-title','Timeline'),(80439,1913,'_timeline-title','field_5de78df29e615'),(80440,1913,'timeline_title','Timeline'),(80441,1913,'_timeline_title','field_5de78df29e615'),(80442,1913,'contact_title','Contact us'),(80443,1913,'_contact_title','field_5de7981e06057'),(80444,1913,'contact_intro','Contact text...'),(80445,1913,'_contact_intro','field_5de7983506058'),(80446,1913,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(80447,1913,'_news_button','field_5de8329896e02'),(80448,1913,'timeline_intro','Introduction of timeline detail...'),(80449,1913,'_timeline_intro','field_5de98f5fb1781'),(80450,1913,'timeline_pic','477'),(80451,1913,'_timeline_pic','field_5de98f72b1782'),(80452,1913,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(80453,1913,'_timeline_button','field_5de99363677f8'),(80454,1913,'banner_image_position','center'),(80455,1913,'_banner_image_position','field_5f3bc4757dd02'),(80456,1913,'services_title','Our services'),(80457,1913,'_services_title','field_5f20f3cd80eb2'),(80458,1913,'services_items_0_services_item_image','1061'),(80459,1913,'_services_items_0_services_item_image','field_5f2121355be14'),(80460,1913,'services_items_0_sservices_item_title','1300 Telephone counselling line'),(80461,19