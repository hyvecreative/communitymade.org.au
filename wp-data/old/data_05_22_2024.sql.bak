page_col_image_3','419'),(2715,420,'_page_col_image_3','field_5de6e02f51be0'),(2722,6,'sec_2_title','Community'),(2723,6,'_sec_2_title','field_5de6e3ef2798f'),(2724,6,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(2725,6,'_sec_2_text','field_5de78dc89e613'),(2726,6,'sec_3_title','The Project'),(2727,6,'_sec_3_title','field_5de6e3d37d8da'),(2728,6,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(2729,6,'_sec_3_text','field_5de6e4044e5e8'),(2730,428,'banner_head','A future that’s wind'),(2731,428,'_banner_head','field_5b568121a8ffe'),(2732,428,'banner_sub','Lorem ipsum dolor sit amet consectetuer adipisc aldulte dolor sit interdum'),(2733,428,'_banner_sub','field_5b568139fd366'),(2734,428,'banner_button','<a class=\"btn btn-home\" href=\"#\">The project</a> <a class=\"btn btn-home\" href=\"#\">Location</a> <a class=\"btn btn-home\" href=\"#\">Community</a>'),(2735,428,'_banner_button','field_5b568147fd367'),(2736,428,'support_section_title','How can Lifestart support you?'),(2737,428,'_support_section_title','field_5b67c7d060398'),(2738,428,'support_left_title','Services'),(2739,428,'_support_left_title','field_5b67c298e7f8f'),(2740,428,'support_left_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy.'),(2741,428,'_support_left_cont','field_5b67c5f6e7f91'),(2742,428,'support_left_button','<a class=\"btn btn-green\" href=\"/services/\">View all services</a>'),(2743,428,'_support_left_button','field_5b67c60ae7f92'),(2744,428,'support_ctr_title','Talk to us'),(2745,428,'_support_ctr_title','field