vider'),(20000,1089,'_support_right_title','field_5b67c6a38c064'),(20001,1089,'support_right_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut.'),(20002,1089,'_support_right_cont','field_5b67c6c98c065'),(20003,1089,'support_right_button','<a class=\"btn btn-blue\" href=\"#\">Read more</a>'),(20004,1089,'_support_right_button','field_5b67c6dd8c066'),(20005,1089,'first_image_title','Lifestart is about supporting young children'),(20006,1089,'_first_image_title','field_5b67ca606afc4'),(20007,1089,'first_image_cont','from 0-24 years living with disabilities and their familes'),(20008,1089,'_first_image_cont','field_5b67caff6afc5'),(20009,1089,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(20010,1089,'_first_image_button','field_5b67cb0d6afc6'),(20011,1089,'second _image_title','Lifestart is about supporting young children'),(20012,1089,'_second _image_title','field_5b67cb20ddf9a'),(20013,1089,'second_image_cont','from 0-24 years living with disabilities and their familes'),(20014,1089,'_second_image_cont','field_5b67cb24ddf9b'),(20015,1089,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(20016,1089,'_second_image_button','field_5b67cb29ddf9c'),(20017,1089,'second_image_title','Lifestart is about supporting young children'),(20018,1089,'_second_image_title','field_5b67cb20ddf9a'),(20019,1089,'page_col_image','412'),(20020,1089,'_page_col_image','field_5de6546e7c63a'),(20021,1089,'page_col_image_3','437'),(20022,1089,'_page_col_image_3','field_5de6e3998e07e'),(20023,1089,'sec_2_title','Community'),(20024,1089,'_sec_2_title','field_5de6e3ef2798f'),(20025,1089,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(20026,1089,'_sec_2_text','field_5de78dc89e613'),(20027,1089,'sec_3_title','The Project'),(20028,1089,'_sec_3_title','field_5de6e3d37d8da'),(20029,1089,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(20030,1089,'_sec_3_text','field_5de6e4044e5e8'),(20031,1089,'page_col_image_2','436'),(20032,1089,'_page_col_image_2','field_5de6546e7c63a'),(20033,1089,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(20034,1089,'_sec_2_button','field_5de6e58c86706'),(20035,1089,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(20036,1089,'_sec_3_button','field_5de6e5a243c03'),(20037,1089,'page_col_image_4','455'),(20038,1089,'_page_col_image_4','field_5de70801090ce'),(20039,1089,'sec_4_title','Location'),(20040,1089,'_sec_4_title','field_5de7082a12a81'),(20041,1089,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(20042,1089,'_sec_4_text','field_5de7084812a82'),(20043,1089,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(20044,1089,'_sec_4_button','field_5de7085e12a83'),(20045,1089,'news_title','Project updates'),(20046,1089,'_news_title','field_5de78da3aabb9'),(20047,1089,'sec_2_text_copy',''),(20048,1089,'_sec_2_text_copy','field_5de78dc89e613'),(20049,1089,'timeline-title','Timeline'),(20050,1089,'_timeline-title','field_5de78df29e615'),(20051,1089,'timeline_ti