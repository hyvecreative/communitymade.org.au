407,1916,'_support_right_cont','field_5b67c6c98c065'),(82408,1916,'support_right_button','<a class=\"btn btn-blue\" href=\"#\">Read more</a>'),(82409,1916,'_support_right_button','field_5b67c6dd8c066'),(82410,1916,'first_image_title','Lifestart is about supporting young children'),(82411,1916,'_first_image_title','field_5b67ca606afc4'),(82412,1916,'first_image_cont','from 0-24 years living with disabilities and their familes'),(82413,1916,'_first_image_cont','field_5b67caff6afc5'),(82414,1916,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(82415,1916,'_first_image_button','field_5b67cb0d6afc6'),(82416,1916,'second _image_title','Lifestart is about supporting young children'),(82417,1916,'_second _image_title','field_5b67cb20ddf9a'),(82418,1916,'second_image_cont','from 0-24 years living with disabilities and their familes'),(82419,1916,'_second_image_cont','field_5b67cb24ddf9b'),(82420,1916,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(82421,1916,'_second_image_button','field_5b67cb29ddf9c'),(82422,1916,'second_image_title','Lifestart is about supporting young children'),(82423,1916,'_second_image_title','field_5b67cb20ddf9a'),(82424,1916,'page_col_image','412'),(82425,1916,'_page_col_image','field_5de6546e7c63a'),(82426,1916,'page_col_image_3','437'),(82427,1916,'_page_col_image_3','field_5de6e3998e07e'),(82428,1916,'sec_2_title','Community'),(82429,1916,'_sec_2_title','field_5de6e3ef2798f'),(82430,1916,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(82431,1916,'_sec_2_text','field_5de78dc89e613'),(82432,1916,'sec_3_title','The Project'),(82433,1916,'_sec_3_title','field_5de6e3d37d8da'),(82434,1916,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(82435,1916,'_sec_3_text','field_5de6e4044e5e8'),(82436,1916,'page_col_image_2','436'),(82437,1916,'_page_col_image_2','field_5de6546e7c63a'),(82438,1916,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(82439,1916,'_sec_2_button','field_5de6e58c86706'),(82440,1916,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(82441,1916,'_sec_3_button','field_5de6e5a243c03'),(82442,1916,'page_col_image_4','455'),(82443,1916,'_page_col_image_4','field_5de70801090ce'),(82444,1916,'sec_4_title','Location'),(82445,1916,'_sec_4_title','field_5de7082a12a81'),(82446,1916,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(82447,1916,'_sec_4_text','field_5de7084812a82'),(82448,1916,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(82449,1916,'_sec_4_button','field_5de7085e12a83'),(82450,1916,'news_title','Project updates'),(82451,1916,'_news_title','field_5de78da3aabb9'),(82452,1916,'sec_2_text_copy',''),(82453,1916,'_sec_2_text_copy','field_5de78dc89e613'),(82454,1916,'timeline-title','Timeline'),(82455,1916,'_timeline-title','field_5de78df29e615'),(82456,1916,'timeline_title','Timeline'),(82457,1916,'_timeline_title','field_5de78df29e615'),(82458,1916,'contact_title','Contact us'),(82459,1916,'_contact_title','field_5de7981e06057'),(82460,1916,'contact_intro','Contact text..