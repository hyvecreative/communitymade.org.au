1852,1942,'support_right_button','<a class=\"btn btn-blue\" href=\"#\">Read more</a>'),(91853,1942,'_support_right_button','field_5b67c6dd8c066'),(91854,1942,'first_image_title','Lifestart is about supporting young children'),(91855,1942,'_first_image_title','field_5b67ca606afc4'),(91856,1942,'first_image_cont','from 0-24 years living with disabilities and their familes'),(91857,1942,'_first_image_cont','field_5b67caff6afc5'),(91858,1942,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(91859,1942,'_first_image_button','field_5b67cb0d6afc6'),(91860,1942,'second _image_title','Lifestart is about supporting young children'),(91861,1942,'_second _image_title','field_5b67cb20ddf9a'),(91862,1942,'second_image_cont','from 0-24 years living with disabilities and their familes'),(91863,1942,'_second_image_cont','field_5b67cb24ddf9b'),(91864,1942,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(91865,1942,'_second_image_button','field_5b67cb29ddf9c'),(91866,1942,'second_image_title','Lifestart is about supporting young children'),(91867,1942,'_second_image_title','field_5b67cb20ddf9a'),(91868,1942,'page_col_image','412'),(91869,1942,'_page_col_image','field_5de6546e7c63a'),(91870,1942,'page_col_image_3','437'),(91871,1942,'_page_col_image_3','field_5de6e3998e07e'),(91872,1942,'sec_2_title','Community'),(91873,1942,'_sec_2_title','field_5de6e3ef2798f'),(91874,1942,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(91875,1942,'_sec_2_text','field_5de78dc89e613'),(91876,1942,'sec_3_title','The Project'),(91877,1942,'_sec_3_title','field_5de6e3d37d8da'),(91878,1942,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(91879,1942,'_sec_3_text','field_5de6e4044e5e8'),(91880,1942,'page_col_image_2','436'),(91881,1942,'_page_col_image_2','field_5de6546e7c63a'),(91882,1942,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(91883,1942,'_sec_2_button','field_5de6e58c86706'),(91884,1942,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(91885,1942,'_sec_3_button','field_5de6e5a243c03'),(91886,1942,'page_col_image_4','455'),(91887,1942,'_page_col_image_4','field_5de70801090ce'),(91888,1942,'sec_4_title','Location'),(91889,1942,'_sec_4_title','field_5de7082a12a81'),(91890,1942,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(91891,1942,'_sec_4_text','field_5de7084812a82'),(91892,1942,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(91893,1942,'_sec_4_button','field_5de7085e12a83'),(91894,1942,'news_title','Project updates'),(91895,1942,'_news_title','field_5de78da3aabb9'),(91896,1942,'sec_2_text_copy',''),(91897,1942,'_sec_2_text_copy','field_5de78dc89e613'),(91898,1942,'timeline-title','Timeline'),(91899,1942,'_timeline-title','field_5de78df29e615'),(91900,1942,'timeline_title','Timeline'),(91901,1942,'_timeline_title','field_5de78df29e615'),(91902,1942,'contact_title','Contact us'),(91903,1942,'_contact_title','field_5de7981e06057'),(91904,1942,'contact_intro','Contact text...'),(91905,1942,'_contact_intro','field_5de7983506058'),