d_5b67cb20ddf9a'),(58064,1795,'page_col_image','412'),(58065,1795,'_page_col_image','field_5de6546e7c63a'),(58066,1795,'page_col_image_3','437'),(58067,1795,'_page_col_image_3','field_5de6e3998e07e'),(58068,1795,'sec_2_title','Community'),(58069,1795,'_sec_2_title','field_5de6e3ef2798f'),(58070,1795,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(58071,1795,'_sec_2_text','field_5de78dc89e613'),(58072,1795,'sec_3_title','The Project'),(58073,1795,'_sec_3_title','field_5de6e3d37d8da'),(58074,1795,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(58075,1795,'_sec_3_text','field_5de6e4044e5e8'),(58076,1795,'page_col_image_2','436'),(58077,1795,'_page_col_image_2','field_5de6546e7c63a'),(58078,1795,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(58079,1795,'_sec_2_button','field_5de6e58c86706'),(58080,1795,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(58081,1795,'_sec_3_button','field_5de6e5a243c03'),(58082,1795,'page_col_image_4','455'),(58083,1795,'_page_col_image_4','field_5de70801090ce'),(58084,1795,'sec_4_title','Location'),(58085,1795,'_sec_4_title','field_5de7082a12a81'),(58086,1795,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(58087,1795,'_sec_4_text','field_5de7084812a82'),(58088,1795,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(58089,1795,'_sec_4_button','field_5de7085e12a83'),(58090,1795,'news_title','Project updates'),(58091,1795,'_news_title','field_5de78da3aabb9'),(58092,1795,'sec_2_text_copy',''),(58093,1795,'_sec_2_text_copy','field_5de78dc89e613'),(58094,1795,'timeline-title','Timeline'),(58095,1795,'_timeline-title','field_5de78df29e615'),(58096,1795,'timeline_title','Timeline'),(58097,1795,'_timeline_title','field_5de78df29e615'),(58098,1795,'contact_title','Contact us'),(58099,1795,'_contact_title','field_5de7981e06057'),(58100,1795,'contact_intro','Contact text...'),(58101,1795,'_contact_intro','field_5de7983506058'),(58102,1795,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(58103,1795,'_news_button','field_5de8329896e02'),(58104,1795,'timeline_intro','Introduction of timeline detail...'),(58105,1795,'_timeline_intro','field_5de98f5fb1781'),(58106,1795,'timeline_pic','477'),(58107,1795,'_timeline_pic','field_5de98f72b1782'),(58108,1795,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(58109,1795,'_timeline_button','field_5de99363677f8'),(58110,1795,'banner_image_position','center'),(58111,1795,'_banner_image_position','field_5f3bc4757dd02'),(58112,1795,'services_title','Our services'),(58113,1795,'_services_title','field_5f20f3cd80eb2'),(58114,1795,'services_items_0_services_item_image','1061'),(58115,1795,'_services_items_0_services_item_image','field_5f2121355be14'),(58116,1795,'services_items_0_sservices_item_title','1300 Telephone counselling line'),(58117,1795,'_services_items_0_sservices_item_title','field_605089efca82e'),(58118,1795,'services_items_0_services_item_text',''),(58119,1795,'_services_items_0_services_item_text','fie