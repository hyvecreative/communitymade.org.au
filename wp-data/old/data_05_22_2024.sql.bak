r_title','Talk to us'),(90497,1939,'_support_ctr_title','field_5b67c62a58af3'),(90498,1939,'support_ctr_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut laoreet.'),(90499,1939,'_support_ctr_cont','field_5b67c63158af4'),(90500,1939,'support_ctr_button','<a class=\"btn btn-orange\" href=\"/supports/\">Find us</a>'),(90501,1939,'_support_ctr_button','field_5b67c63658af5'),(90502,1939,'support_right_title','NDIS Registered provider'),(90503,1939,'_support_right_title','field_5b67c6a38c064'),(90504,1939,'support_right_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut.'),(90505,1939,'_support_right_cont','field_5b67c6c98c065'),(90506,1939,'support_right_button','<a class=\"btn btn-blue\" href=\"#\">Read more</a>'),(90507,1939,'_support_right_button','field_5b67c6dd8c066'),(90508,1939,'first_image_title','Lifestart is about supporting young children'),(90509,1939,'_first_image_title','field_5b67ca606afc4'),(90510,1939,'first_image_cont','from 0-24 years living with disabilities and their familes'),(90511,1939,'_first_image_cont','field_5b67caff6afc5'),(90512,1939,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(90513,1939,'_first_image_button','field_5b67cb0d6afc6'),(90514,1939,'second _image_title','Lifestart is about supporting young children'),(90515,1939,'_second _image_title','field_5b67cb20ddf9a'),(90516,1939,'second_image_cont','from 0-24 years living with disabilities and their familes'),(90517,1939,'_second_image_cont','field_5b67cb24ddf9b'),(90518,1939,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(90519,1939,'_second_image_button','field_5b67cb29ddf9c'),(90520,1939,'second_image_title','Lifestart is about supporting young children'),(90521,1939,'_second_image_title','field_5b67cb20ddf9a'),(90522,1939,'page_col_image','412'),(90523,1939,'_page_col_image','field_5de6546e7c63a'),(90524,1939,'page_col_image_3','437'),(90525,1939,'_page_col_image_3','field_5de6e3998e07e'),(90526,1939,'sec_2_title','Community'),(90527,1939,'_sec_2_title','field_5de6e3ef2798f'),(90528,1939,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(90529,1939,'_sec_2_text','field_5de78dc89e613'),(90530,1939,'sec_3_title','The Project'),(90531,1939,'_sec_3_title','field_5de6e3d37d8da'),(90532,1939,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(90533,1939,'_sec_3_text','field_5de6e4044e5e8'),(90534,1939,'page_col_image_2','436'),(90535,1939,'_page_col_image_2','field_5de6546e7c63a'),(90536,1939,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(90537,1939,'_sec_2_button','field_5de6e58c86706'),(90538,1939,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(90539,1939,'_sec_3_button','field_5de6e5a243c03'),(90540,1939,'page_col_image_4','455'),(90541,1939,'_page_col_image_4','field_5de70801090ce'),(90542,1939,'sec_4_title','Location'),(90543,1939,'_sec_4_title','field_5de7082a12a81'),(90544,1939,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(90545,1939,'_sec_4_text','field_5de7084812a82'),(90546,1939,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(90547,1939,'_sec_4_button','field_5de7085e12a83'),(90548,1939,'news_title','Project updates'),(90549,1939,'_news_title','field_5de78da3aabb9'),(90550,1939,'sec_2_text_copy',''),(90551,1939,'_sec_2_text_copy','field_5de78dc89e613'),(90552,1939,'timeline-title','Timeline'),(90553,1939,'_timeline-title','field_5de78df29e615'),(90554,1939,'timeline_title','Timeline'),(90555,1939,'_timeline_title','field_5de78df29e615'),(90556,1939,'contact_title','Contact us'),(90557,1939,'_contact_title','field_5de7981e06057'),(90558,1939,'contact_intro','Contact text...'),(90559,1939,'_contact_intro','field_5de7983506058'),(90560,1939,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(90561,1939,'_news_button','field_5de8329896e02'),(90562,1939,'timeline_intro','Introduction of timeline detail...'),(90563,1939,'_timeline_intro','field_5de98f5fb1781'),(90564,1939,'timeline_pic','477'),(90565,1939,'_timeline_pic','field_5de98f72b1782'),(90566,1939,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(90567,1939,'_timeline_button','field_5de99363677f8'),(90568,1939,'banner_image_position','center'),(90569,1939,'_banner_image_position','field_5f3bc4757dd02'),(90570,1939,'services_title','Our services'),(90571,1939,'_services_title','field_5f20f3cd80eb2'),(90572,1939,'services_items_0_services_item_image','1061'),(90573,1939,'_services_items_0_services_item_image','field_5f2121355be14'),(90574,1939,'services_items_0_sservices_item_title','1300 Telephone counselling line'),(90575,1939,'_services_items_0_sservices_item_title','field_605089efca82e'),(90576,1939,'services_items_0_services_item_text',''),(90577,1939,'_services_items_0_services_item_text','field_5f2121535be15'),(90578,1939,'services_items_0_services_link_url','#'),(90579,1939,'_services_items_0_services_link_url',