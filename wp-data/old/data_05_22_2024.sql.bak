n','field_6294562942237'),(88910,1932,'survey_index_6_survey_title','Energy Management'),(88911,1932,'_survey_index_6_survey_title','field_6294564042238'),(88912,1932,'survey_index_6_survey_url','#'),(88913,1932,'_survey_index_6_survey_url','field_6294564e42239'),(88914,1932,'survey_index_6_survey_url_text','View Results'),(88915,1932,'_survey_index_6_survey_url_text','field_629456584223a'),(88916,1932,'survey_index_7_survey_icon','1493'),(88917,1932,'_survey_index_7_survey_icon','field_6294562942237'),(88918,1932,'survey_index_7_survey_title','Going Off-grid'),(88919,1932,'_survey_index_7_survey_title','field_6294564042238'),(88920,1932,'survey_index_7_survey_url','#'),(88921,1932,'_survey_index_7_survey_url','field_6294564e42239'),(88922,1932,'survey_index_7_survey_url_text','View Results'),(88923,1932,'_survey_index_7_survey_url_text','field_629456584223a'),(88924,1932,'survey_index','8'),(88925,1932,'_survey_index','field_6294561242236'),(88926,1932,'report_title','Download the report'),(88927,1932,'_report_title','field_62f30edfb57e1'),(88928,1932,'report_intro','Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus massa erat, consectetur at semper at, feugiat vel orci. '),(88929,1932,'_report_intro','field_62f30eedb57e2'),(88930,1932,'report_link_url','#'),(88931,1932,'_report_link_url','field_62f30ef4b57e3'),(88932,1932,'report_link_text','Download'),(88933,1932,'_report_link_text','field_62f30f01b57e4'),(88934,1932,'solutions_content','The housing system is complex, and no one solution will solve the complex problems we now face but there are some critical first steps to be taken now.\r\n<ul>\r\n 	<li>Set out an ambitious national housing agreement between commonwealth and state governments with targets and funding for the construction of affordable homes.</li>\r\n 	<li>Phase out tax breaks for property investors and using the increase in revenue to build more public housing.</li>\r\n 	<li>Establish laws which limit rental increases beyond what is fair.</li>\r\n 	<li>Rebalance tenancy laws to provide renters with more security and control, such as eliminating no grounds evictions.</li>\r\n 	<li>Phase out stamp duty and replace it with a broad-based land tax.</li>\r\n</ul>\r\n<h4>While there are many opinions on what policy changes will fix the housing market, doing nothing is not an option.</h4>'),(88935,1932,'_solutions_content','field_640e8b307a958'),(88936,1932,'problem_icons_0_prob_icon','1699'),(88937,1932,'_problem_icons_0_prob_icon','field_640fa0291d519'),(88938,1932,'problem_icons_0_prob_concerned_stat','70% highly concerned'),(88939,1932,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(88940,1932,'problem_icons_0_prob_concerded_text','are highly concerned'),(88941,1932,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(88942,1932,'problem_icons_0_prob_issue_text',''),(88943,1932,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(88944,1932,'problem_icons','4'),(88945,1932,'_problem_icons','field_640fa0191d518'),(88946,1932,'ceh_content_left',''),(88947,1932,'_ceh_content_left','field_640e97e8f1c8c'),(88948,1932,'ceh_content_right',''),(88949,1932,'_ceh_content_right','field_640e97fdf1c8d'),(88950,1932,'pc_content_left',''),(88951,1932,'_pc_content_left','field_640e983bf1c8f'),(88952,1932,'pc_content_right',''),(88953,1932,'_pc_content_right','field_640e984df1c90'),(88954,1932,'problem_icons_1_prob_icon','1699'),(88955,1932,'_problem_icons_1_prob_icon','field_640fa0291d519'),(88956,1932,'problem_icons_1_prob_concerned_stat','69% highly concerned'),(88957,1932,'_problem_icons_1_prob_concerned_stat','field_640fa0dd81d95'),(88958,1932,'problem_icons_1_prob_concerded_text','are highly concerned'),(88959,1932,'_problem_icons_1_prob_concerded_text','field_640fa10181d96'),(88960,1932,'problem_icons_1_prob_issue_text',''),(88961,1932,'_problem_icons_1_prob_issue_text','field_640fa11a81d97'),(88962,1932,'problem_icons_2_prob_icon','1699'),(88963,1932,'_problem_icons_2_prob_icon','field_640fa0291d519'),(88964,1932,'problem_icons_2_prob_concerned_stat','64% highly concerned'),(88965,1932,'_problem_icons_2_prob_concerned_stat','field_640fa0dd81d95'),(88966,1932,'problem_icons_2_prob_concerded_text','are highly concerned'),(88967,1932,'_problem_icons_2_prob_concerded_text','field_640fa10181d96'),(88968,1932,'problem_icons_2_prob_issue_text',''),(88969,1932,'_problem_icons_2_prob_issue_text','field_640fa11a81d97'),(88970,1932,'problem_icons_3_prob_icon','1699'),(88971,1932,'_problem_icons_3_prob_icon','field_640fa0291d519'),(88972,1932,'problem_icons_3_prob_concerned_stat','64% highly concerned'),(88973,1932,'_problem_icons_3_prob_concerned_stat','field_640fa0dd81d95'),(88974,1932,'problem_icons_3_prob_concerded_text','are highly concerned'),(88975,1932,'_problem_icons_3_prob_concerded_text','field_640fa10181d96'),(88976,1932,'problem_icons_3_prob_issue_text',''),(88977,1932,'_problem_icons_3_prob_issue_text','field_640fa11a81d97'),(88978,1932,'problem_icons_0_prob_concerned_text','House prices have doubled in a decade'),(88979,1932,'_problem_icons_0_prob_concerned_text','field_640fa10181d96'),(88980,1932,'problem_icons_1_prob_concerned_text','The gap between rich and poor is growing'),(88981,1932,'_problem_icons_1_prob_concerned_text','field_640fa10181d96'),(88982,1932,'problem_icons_2_prob_concerned_text','Construction of social housing is down'),(88983,1932,'_problem_icons_2_prob_concerned_text','field_640fa10181d96'),(88984,1932,'problem_icons_3_prob_concerned_text','Banks are making more than ever from housing'),(88985,1932,'_problem_icons_3_prob_concerned_text','field_640fa10181d96'),(88986,1932,'monitor_content','The Australian Housing Monitor is a large, nationally-representative survey covering public experiences and attitudes toward housing related issues. Questions range from how well the respondent is keeping up with their mortgage/rent, to what they think about social housing construction.\r\n\r\nA broad range of demographic criteria are included, such as gender, location, age, income, voting preference, educational level, tenure type, and employment status. These variables allow CEH researchers to understand the trends and diversity of opinion around the country.\r\n\r\nIt also incorporates questions from previous surveys to track trends over time.\r\nThe inaugural poll was conducted by Essential in December 2022, and was completed by 4,735 people.'),(88987,1932,'_monitor_content','field_640fcc4014404'),(88988,1932,'problem_head','Housing in Australia is not working, and Australians are concerned.'),(88989,1932,'_problem_head','field_641935436aded'),(88990,1932,'problem_signoff','Explore the research showing how concerned Australians are our about the housing situation.'),(88991,1932,'_problem_signoff','field_641935626adee'),(88992,1932,'sections','a:2:{i:0;s:4:\"hero\";i:1;s:9:\"news_grid\";}'),(88993,1932,'_sections','field_5dafb40b8143a'),(88994,1932,'sections_0_is_full_height','1'),(88995,1932,'_sections_0_is_full_height','field_61d6f6fd5a37e'),(88996,1932,'sections_0_image','1648'),(88997,1932,'_sections_0_image','field_61d6f6d45a37d'),(88998,1932,'sections_0_heading','Heading'),(88999,1932,'_sections_0_heading','field_61d6f69e5a379'),(89000,1932,'sections_0_subtitle','Ya ya '),(89001,1932,'_sections_0_subtitle','field_61d6f6ac5a37a'),(89002,1932,'sections_0_link_one',''),(89003,1932,'_sections_0_link_one','field_61d6f6b55a37b'),(89004,1932,'sections_0_link_two',''),(89005,1932,'_sections_0_link_two','field_61d6f6c35a37c'),(89006,1932,'sections_1_select_categories','a:1:{i:0;s:2:\"27\";}'),(89007,1932,'_sections_1_select_categories','field_637f04483b63b'),(89008,1932,'intro_head_major','Super Consumers Australia is <span>fighting</span> to ensure that the superannuation industry is <span>held accountable</span> for the outcomes they deliver to Australian consumers.'),(89009,1932,'_intro_head_major','field_64e828783ad9f'),(89010,1932,'intro_head_minor','We want super to work for everyone—not just super fund companies. With our research, journalism and campaigns we are creating the trustworthy and transparent superannuation system we all deserve.'),(89011,1932,'_intro_head_minor','field_64e8288c3ada0'),(89012,1932,'intro_icons_0_int_icon','1922'),(89013,1932,'_intro_icons_0_int_icon','field_64e828b33ada2'),(89014,1932,'intro_icons_0_int_icon_text','At 1,727,000 square kilometres, we’re 2.5 times the size of Texas. <span>Yeeha!</span>'),(89015,1932,'_intro_icons_0_int_icon_text','field_64e828e33ada3'),(89016,1932,'intro_icons_1_int_icon','1920'),(89017,1932,'_intro_icons_1_int_icon','field_64e828b33ada2'),(89018,1932,'intro_icons_1_int_icon_text','We have twice as many species of native plant and animal as any other Australian state or territory.'),(89019,1932,'_intro_icons_1_int_icon_text','field_64e828e33ada3'),(89020,1932,'intro_icons_2_int_icon','1921'),(89021,1932,'_intro_icons_2_int_icon','field_64e828b33ada2'),(89022,1932,'intro_icons_2_int_icon_text','We have less land classified as ‘protected’ than any other state or territory.'),(89023,1932,'_intro_icons_2_int_icon_text','field_64e828e33ada3'),(89024,1932,'intro_icons','3'),(89025,1932,'_intro_icons','field_64e828963ada1'),(89026,1932,'threat_head_major','What we stand to lose if we don’t act soon to protect beautiful Queensland:'),(89027,1932,'_threat_head_major','field_64ec258d9dbd1'),(89028,1932,'threats_icons','3'),(89029,1932,'_threats_icons','field_64ec2551a93f9'),(89030,1932,'threats_icons_0_thr_icon','1819'),(89031,1932,'_threats_icons_0_thr_icon','field_64ec2551a93fa'),(89032,1932,'threats_icons_0_thr_icon_text','The rich cultural heritage of our First Nations people and their continuous ties to country, dating back more than 50,000 years.'),(89033,1932,'_threats_icons_0_thr_icon_text','field_64ec2551a93fb'),(89034,1932,'threats_icons_1_thr_icon','1819'),(89035,1932,'_threats_icons_1_thr_icon','field_64ec2551a93fa'),(89036,1932,'threats_icons_1_thr_icon_text','Thousands of species of plant and animal which are now classified as threatened or endangered in Queensland.'),(89037,1932,'_threats_icons_1_thr_icon_text','field_64ec2551a93fb'),(89038,1932,'threats_icons_2_thr_icon','1819'),(89039,1932,'_threats_icons_2_thr_icon','field_64ec2551a93fa'),(89040,1932,'threats_icons_2_thr_icon_text','The access to nature that is central to the Queensland way of life.'),(89041,1932,'_threats_icons_2_thr_icon_text','field_64ec2551a93fb'),(89042,1932,'threat_icons_0_thr_icon',''),(89043,1932,'_threat_icons_0_thr_icon','field_64ec2551a93fa'),(89044,1932,'threat_icons_0_thr_icon_text','The <span>rich cultural heritage</span> of our First Nations people and their continuous ties to country, dating back more than 50,000 years.'),(89045,1932,'_threat_icons_0_thr_icon_text','field_64ec2551a93fb'),(89046,1932,'threat_icons_1_thr_icon',''),(89047,1932,'_threat_icons_1_thr_icon','field_64ec2551a93fa'),(89048,1932,'threat_icons_1_thr_icon_text','Thousands of species of plant and animal which are now classified as threatened or endangered in Queensland.'),(89049,1932,'_threat_icons_1_thr_icon_text','field_64ec2551a93fb'),(89050,1932,'threat_icons_2_thr_icon',''),(89051,1932,'_threat_icons_2_thr_icon','field_64ec2551a93fa'),(89052,1932,'threat_icons_2_thr_icon_text','The access to nature that is central to the Queensland way of life.'),(89053,1932,'_threat_icons_2_thr_icon_text','field_64ec2551a93fb'),(89054,1932,'threat_icons','3'),(89055,1932,'_threat_icons','field_64ec2551a93f9'),(89056,1932,'hm_hero_title','<span>Fighting for a fairer </span> superannuation system'),(89057,1932,'_hm_hero_title','field_64ed36e15d521'),(89058,1932,'hm_sub_title',''),(89059,1932,'_hm_sub_title','field_64ed37241effa'),(89060,1932,'home_form','<link href=\'https://actionnetwork.org/css/style-embed-whitelabel-v3.css\' rel=\'stylesheet\' type=\'text/css\' /><script src=\'https://actionnetwork.org/widgets/v5/form/signup-to-the-campaign?format=js&source=widget\'></script><div id=\'can-