6_survey_url_text','field_629456584223a'),(80826,1913,'survey_index_7_survey_icon','1493'),(80827,1913,'_survey_index_7_survey_icon','field_6294562942237'),(80828,1913,'survey_index_7_survey_title','Going Off-grid'),(80829,1913,'_survey_index_7_survey_title','field_6294564042238'),(80830,1913,'survey_index_7_survey_url','#'),(80831,1913,'_survey_index_7_survey_url','field_6294564e42239'),(80832,1913,'survey_index_7_survey_url_text','View Results'),(80833,1913,'_survey_index_7_survey_url_text','field_629456584223a'),(80834,1913,'survey_index','8'),(80835,1913,'_survey_index','field_6294561242236'),(80836,1913,'report_title','Download the report'),(80837,1913,'_report_title','field_62f30edfb57e1'),(80838,1913,'report_intro','Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus massa erat, consectetur at semper at, feugiat vel orci. '),(80839,1913,'_report_intro','field_62f30eedb57e2'),(80840,1913,'report_link_url','#'),(80841,1913,'_report_link_url','field_62f30ef4b57e3'),(80842,1913,'report_link_text','Download'),(80843,1913,'_report_link_text','field_62f30f01b57e4'),(80844,1913,'solutions_content','The housing system is complex, and no one solution will solve the complex problems we now face but there are some critical first steps to be taken now.\r\n<ul>\r\n 	<li>Set out an ambitious national housing agreement between commonwealth and state governments with targets and funding for the construction of affordable homes.</li>\r\n 	<li>Phase out tax breaks for property investors and using the increase in revenue to build more public housing.</li>\r\n 	<li>Establish laws which limit rental increases beyond what is fair.</li>\r\n 	<li>Rebalance tenancy laws to provide renters with more security and control, such as eliminating no grounds evictions.</li>\r\n 	<li>Phase out stamp duty and replace it with a broad-based land tax.</li>\r\n</ul>\r\n<h4>While there are many opinions on what policy changes will fix the housing market, doing nothing is not an option.</h4>'),(80845,1913,'_solutions_content','field_640e8b307a958'),(80846,1913,'problem_icons_0_prob_icon','1699'),(80847,1913,'_problem_icons_0_prob_icon','field_640fa0291d519'),(80848,1913,'problem_icons_0_prob_concerned_stat','70% highly concerned'),(80849,1913,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(80850,1913,'problem_icons_0_prob_concerded_text','are highly concerned'),(80851,1913,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(80852,1913,'problem_icons_0_prob_issue_text',''),(80853,1913,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(80854,1913,'problem_icons','4'),(80855,1913,'_problem_icons','field_640fa0191d518'),(80856,1913,'ceh_content_left',''),(80857,1913,'_ceh_content_left','field_640e97e8f1c8c'),(80858,1913,'ceh_content_right',''),(80859,1913,'_ceh_content_right','field_640e97fdf1c8d'),(80860,1913,'pc_content_left',''),(80861,1913,'_pc_content_left','field_640e983bf1c8f'),(80862,1913,'pc_content_right',''),(80863,1913,'_pc_content_right','field_640e984df1c90'),(80864,1913,'problem_icons_1_prob_icon','1699'),(80865,1913,'_problem_icons_1_prob_icon','field_640fa0291d519'),(80866,1913,'problem_icons_1_prob_concerned_stat','69% highly concerned'),(80867,1913,'_problem_icons_1_prob_concerned_stat','field_640fa0dd81d95'),(80868,1913,'problem_icons_1_prob_concerded_text','are highly concerned'),(80869,1913,'_problem_icons_1_prob_concerded_text','field_640fa10181d96'),(80870,1913,'problem_icons_1_prob_issue_text',''),(80871,1913,'_problem_icons_1_prob_issue_text','field_640fa11a81d97'),(80872,1913,'problem_icons_2_prob_icon','1699'),(80873,1913,'_problem_icons_2_prob_icon','field_640fa0291d519'),(80874,1913,'problem_icons_2_prob_concerned_stat','64% highly concerned'),(80875,1913,'_problem_icons_2_prob_concerned_stat','field_640fa0dd81d95'),(80876,1913,'problem_icons_2_prob_concerded_text','are highly concerned'),(80877,1913,'_problem_icons_2_prob_concerded_text','field_640fa10181d96'),(80878,1913,'problem_icons_2_prob_issue_text',''),(80879,1913,'_problem_icons_2_prob_issue_text','field_640fa11a81d97'),(80880,1913,'problem_icons_3_prob_icon','1699'),(80881,1913,'_problem_icons_3_prob_icon','field_640fa0291d519'),(80882,1913,'problem_icons_3_prob_concerned_stat','64% highly concerned'),(80883,1913,'_problem_icons_3_prob_concerned_stat','field_640fa0dd81d95'),(80884,1913,'problem_icons_3_prob_concerded_text','are highly concerned'),(80885,1913,'_problem_icons_3_prob_concerded_text','field_640fa10181d96'),(80886,1913,'problem_icons_3_prob_issue_text',''),(80887,1913,'_problem_icons_3_prob_issue_text','field_640fa11a81d97'),(80888,1913,'problem_icons_0_prob_concerned_text','House prices have doubled in a decade'),(80889,1913,'_problem_icons_0_prob_concerned_text','field_640fa10181d96'),(80890,1913,'problem_icons_1_prob_concerned_text','The gap between rich and poor is growing'),(80891,1913,'_problem_icons_1_prob_concerned_text','field_640fa10181d96'),(80892,1913,'problem_icons_2_prob_concerned_text','Construction of social housing is down'),(80893,1913,'_problem_icons_2_prob_concerned_text','field_640fa10181d96'),(80894,1913,'problem_icons_3_prob_concerned_text','Banks are making more than ever from housing'),(80895,1913,'_problem_icons_3_prob_concerned_text','field_640fa10181d96'),(80896,1913,'monitor_content','The Australian Housing Monitor is a large, nationally-representative survey covering public experiences and attitudes toward housing related issues. Questions range from how well the respondent is keeping up with their mortgage/rent, to what they think about social housing construction.\r\n\r\nA broad range of demographic criteria are included, such as gender, location, age, income, voting preference, educational level, tenure type, and employment status. These variables allow CEH researchers to understand the trends and diversity of opinion around the country.\r\n\r\nIt also incorporates questions from previous surveys to track trends over time.\r\nThe inaugural poll was conducted by Essential in December 2022, and was completed by 4,735 people.'),(80897,1913,'_monitor_content','field_640fcc4014404'),(80898,1913,'problem_head','Housing in Australia is not working, and Australians are concerned.'),(80899,1913,'_problem_head','field_641935436aded'),(80900,1913,'problem_signoff','Explore the research showing how concerned Australians are our about the housing situation.'),(80901,1913,'_problem_signoff','field_641935626adee'),(80902,1913,'sections','a:2:{i:0;s:4:\"hero\";i:1;s:9:\"news_grid\";}'),(80903,1913,'_sections','field_5dafb40b8143a'),(80904,1913,'sections_0_is_full_height','1'),(80905,1913,'_sections_0_is_full_height','field_61d6f6fd5a37e'),(80906,1913,'sections_0_image','1648'),(80907,1913,'_sections_0_image','field_61d6f6d45a37d'),(80908,1913,'sections_0_heading','Heading'),(80909,1913,'_sections_0_heading','field_61d6f69e5a379'),(80910,1913,'sections_0_subtitle','Ya ya '),(80911,1913,'_sections_0_subtitle','field_61d6f6ac5a37a'),(80912,1913,'sections_0_link_one',''),(80913,1913,'_sections_0_link_one','field_61d6f6b55a37b'),(80914,1913,'sections_0_link_two',''),(80915,1913,'_sections_0_link_two','field_61d6f6c35a37c'),(80916,1913,'sections_1_select_categories','a:1:{i:0;s:2:\"27\";}'),(80917,1913,'_sections_1_select_categories','field_637f04483b63b'),(80918,1913,'intro_head_major','Queenslanders are known for both our love of the great outdoors and our state pride…'),(80919,1913,'_intro_head_major','field_64e828783ad9f'),(80920,1913,'intro_head_minor','But there’s a few things you might not know about our beautiful state.'),(80921,1913,'_intro_head_minor','field_64e8288c3ada0'),(80922,1913,'intro_icons_0_int_icon',''),(80923,1913,'_intro_icons_0_int_icon','field_64e828b33ada2'),(80924,1913,'intro_icons_0_int_icon_text','At 1,727,000 square kilometres, we’re 2.5 times the size of Texas. <span>Yeeha!</span>'),(80925,1913,'_intro_icons_0_int_icon_text','field_64e828e33ada3'),(80926,1913,'intro_icons_1_int_icon',''),(80927,1