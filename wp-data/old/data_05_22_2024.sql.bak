e_button','field_5b67cb0d6afc6'),(84432,1919,'second _image_title','Lifestart is about supporting young children'),(84433,1919,'_second _image_title','field_5b67cb20ddf9a'),(84434,1919,'second_image_cont','from 0-24 years living with disabilities and their familes'),(84435,1919,'_second_image_cont','field_5b67cb24ddf9b'),(84436,1919,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(84437,1919,'_second_image_button','field_5b67cb29ddf9c'),(84438,1919,'second_image_title','Lifestart is about supporting young children'),(84439,1919,'_second_image_title','field_5b67cb20ddf9a'),(84440,1919,'page_col_image','412'),(84441,1919,'_page_col_image','field_5de6546e7c63a'),(84442,1919,'page_col_image_3','437'),(84443,1919,'_page_col_image_3','field_5de6e3998e07e'),(84444,1919,'sec_2_title','Community'),(84445,1919,'_sec_2_title','field_5de6e3ef2798f'),(84446,1919,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(84447,1919,'_sec_2_text','field_5de78dc89e613'),(84448,1919,'sec_3_title','The Project'),(84449,1919,'_sec_3_title','field_5de6e3d37d8da'),(84450,1919,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(84451,1919,'_sec_3_text','field_5de6e4044e5e8'),(84452,1919,'page_col_image_2','436'),(84453,1919,'_page_col_image_2','field_5de6546e7c63a'),(84454,1919,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(84455,1919,'_sec_2_button','field_5de6e58c86706'),(84456,1919,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(84457,1919,'_sec_3_button','field_5de6e5a243c03'),(84458,1919,'page_col_image_4','455'),(84459,1919,'_page_col_image_4','field_5de70801090ce'),(84460,1919,'sec_4_title','Location'),(84461,1919,'_sec_4_title','field_5de7082a12a81'),(84462,1919,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(84463,1919,'_sec_4_text','field_5de7084812a82'),(84464,1919,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(84465,1919,'_sec_4_button','field_5de7085e12a83'),(84466,1919,'news_title','Project updates'),(84467,1919,'_news_title','field_5de78da3aabb9'),(84468,1919,'sec_2_text_copy',''),(84469,1919,'_sec_2_text_copy','field_5de78dc89e613'),(84470,1919,'timeline-title','Timeline'),(84471,1919,'_timeline-title','field_5de78df29e615'),(84472,1919,'timeline_title','Timeline'),(84473,1919,'_timeline_title','field_5de78df29e615'),(84474,1919,'contact_title','Contact us'),(84475,1919,'_contact_title','field_5de7981e06057'),(84476,1919,'contact_intro','Contact text...'),(84477,1919,'_contact_intro','field_5de7983506058'),(84478,1919,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(84479,1919,'_news_button','field_5de8329896e02'),(84480,1919,'timeline_intro','Introduction of timeline detail...'),(84481,1919,'_timeline_intro','field_5de98f5fb1781'),(84482,1919,'timeline_pic','477'),(84483,1919,'_timeline_pic','field_5de98f72b1782'),(84484,1919,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(84485,1919,'_timeline_button','field_5de99363677f8'),(84486,1919,'b