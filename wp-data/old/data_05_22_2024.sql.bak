b57e3'),(82858,1916,'report_link_text','Download'),(82859,1916,'_report_link_text','field_62f30f01b57e4'),(82860,1916,'solutions_content','The housing system is complex, and no one solution will solve the complex problems we now face but there are some critical first steps to be taken now.\r\n<ul>\r\n 	<li>Set out an ambitious national housing agreement between commonwealth and state governments with targets and funding for the construction of affordable homes.</li>\r\n 	<li>Phase out tax breaks for property investors and using the increase in revenue to build more public housing.</li>\r\n 	<li>Establish laws which limit rental increases beyond what is fair.</li>\r\n 	<li>Rebalance tenancy laws to provide renters with more security and control, such as eliminating no grounds evictions.</li>\r\n 	<li>Phase out stamp duty and replace it with a broad-based land tax.</li>\r\n</ul>\r\n<h4>While there are many opinions on what policy changes will fix the housing market, doing nothing is not an option.</h4>'),(82861,1916,'_solutions_content','field_640e8b307a958'),(82862,1916,'problem_icons_0_prob_icon','1699'),(82863,1916,'_problem_icons_0_prob_icon','field_640fa0291d519'),(82864,1916,'problem_icons_0_prob_concerned_stat','70% highly concerned'),(82865,1916,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(82866,1916,'problem_icons_0_prob_concerded_text','are highly concerned'),(82867,1916,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(82868,1916,'problem_icons_0_prob_issue_text',''),(82869,1916,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(82870,1916,'problem_icons','4'),(82871,1916,'_problem_icons','field_640fa0191d518'),(82872,1916,'ceh_content_left',''),(82873,1916,'_ceh_content_left','field_640e97e8f1c8c'),(82874,1916,'ceh_content_right',''),(82875,1916,'_ceh_content_right','field_640e97fdf1c8d'),(82876,1916,'pc_content_left',''),(82877,1916,'_pc_content_left','field_640e983bf1c8f'),(82878,1916,'pc_content_right',''),(82879,1