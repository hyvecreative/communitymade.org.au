ey_index_7_survey_url','#'),(103230,1991,'_survey_index_7_survey_url','field_6294564e42239'),(103231,1991,'survey_index_7_survey_url_text','View Results'),(103232,1991,'_survey_index_7_survey_url_text','field_629456584223a'),(103233,1991,'survey_index','8'),(103234,1991,'_survey_index','field_6294561242236'),(103235,1991,'report_title','Download the report'),(103236,1991,'_report_title','field_62f30edfb57e1'),(103237,1991,'report_intro','Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus massa erat, consectetur at semper at, feugiat vel orci. '),(103238,1991,'_report_intro','field_62f30eedb57e2'),(103239,1991,'report_link_url','#'),(103240,1991,'_report_link_url','field_62f30ef4b57e3'),(103241,1991,'report_link_text','Download'),(103242,1991,'_report_link_text','field_62f30f01b57e4'),(103243,1991,'solutions_content','The housing system is complex, and no one solution will solve the complex problems we now face but there are some critical first steps to be taken now.\r\n<ul>\r\n 	<li>Set out an ambitious national housing agreement between commonwealth and state governments with targets and funding for the construction of affordable homes.</li>\r\n 	<li>Phase out tax breaks for property investors and using the increase in revenue to build more public housing.</li>\r\n 	<li>Establish laws which limit rental increases beyond what is fair.</li>\r\n 	<li>Rebalance tenancy laws to provide renters with more security and control, such as eliminating no grounds evictions.</li>\r\n 	<li>Phase out stamp duty and replace it with a broad-based land tax.</li>\r\n</ul>\r\n<h4>While there are many opinions on what policy changes will fix the housing market, doing nothing is not an option.</h4>'),(103244,1991,'_solutions_content','field_640e8b307a958'),(103245,1991,'problem_icons_0_prob_icon','1699'),(103246,1991,'_problem_icons_0_prob_icon','field_640fa0291d519'),(103247,1991,'problem_icons_0_prob_concerned_stat','70% highly concerned'),(103248,1991,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(103249,1991,'problem_icons_0_prob_concerded_text','are highly concerned'),(103250,1991,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(103251,1991,'problem_icons_0_prob_issue_text',''),(103252,1991,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(103253,1991,'problem_icons','4'),(103254,1991,'_problem_icons','field_640fa0191d518'),(103255,1991,'ceh_content_left',''),(103256,1991,'_ceh_content_left','field_640e97e8f1c8c'),(103257,1991,'ceh_content_right',''),(103258,1991,'_ceh_content_right','field_640e97fdf1c8d'),(103259,1991,'pc_content_left',''),(103260,1991,'_pc_content_left','field_640e983bf1c8f'),(103261,1991,'pc_content_right',''),(103262,1991,'_pc_content_right','field_640e984df1c90'),(103263,1991,'problem_icons_1_prob_icon','1699'),(103264,1991,'_problem_icons_1_prob_icon','field_640fa0291d519'),(103265,1991,'problem_icons_1_prob_concerned_stat','69% highly concerned'),(103266,1991,'_problem_icons_1_prob_concerned_stat','field_640fa0dd81d95'),(103267,1991,'problem_icons_1_prob_concerded_text','are highly concerned'),(103268,1991,'_problem_icons_1_prob_concerded_text','field_640fa10181d96'),(103269,1991,'problem_icons_1_prob_issue_text',''),(103270,1991,'_problem_icons_1_prob_issue_text','field_640fa11a81d97'),(103271,1991,'problem_icons_2_prob_icon','1699'),(103272,1991,'_problem_icons_2_prob_icon','field_640fa0291d519'),(103273,1991,'problem_icons_2_prob_concerned_stat','64% highly concerned'),(103274,1991,'_problem_icons_2_prob_concerned_stat','field_640fa0dd81d95'),(103275,1991,'problem_icons_2_prob_concerded_text','are highly concerned'),(103276,1991,'_problem_icons_2_prob_concerded_text','field_640fa10181d96'),(103277,1991,'problem_icons_2_prob_issue_text',''),(103278,1991,'_problem_icons_2_prob_issue_text','field_640fa11a81d97'),(103279,1991,'problem_icons_3_prob_icon','1699'),(103280,1991,'_problem_icons_3_prob_icon','field_640fa0291d519'),(103281,1991,'problem_icons_3_prob_concerned_stat','64% highly concerned'),(103282,1991,'_problem_icons_3_prob_concerned_stat','field_640fa0dd81d95'),(103283,1991,'problem_icons_3_prob_concerded_text','are highly concerned'),(103284,1991,'_problem_icons_3_prob_concerded_text','field_640fa10181d96'),(103285,1991,'problem_icons_3_prob_issue_text',''),(103286,1991,'_problem_icons_3_prob_issue_text','field_640fa11a81d97'),(103287,1991,'problem_icons_0_prob_concerned_text','House prices have doubled in a decade'),(103288,1991,'_problem_icons_0_prob_concerned_text','field_640fa10181d96'),(103289,1991,'problem_icons_1_prob_concerned_text','The gap between rich and poor is growing'),(103290,1991,'_problem_icons_1_prob_concerned_text','field_640fa10181d96'),(103291,1991,'problem_icons_2_prob_concerned_text','Construction of social housing is down'),(103292,1991,'_problem_icons_2_prob_concerned_text','field_640fa10181d96'),(103293,1991,'problem_icons_3_prob_concerned_text','Banks are making more than ever from housing'),(103294,1991,'_problem_icons_3_prob_concerned_text','field_640fa10181d96'),(103295,1991,'monitor_content','The Australian Housing Monitor is a large, nationally-representative survey covering public experiences and attitudes toward housing related issues. Questions range from how well the respondent is keeping up with their mortgage/rent, to what they think about social housing construction.\r\n\r\nA broad range of demographic criteria are included, such as gender, location, age, income, voting preference, educational level, tenure type, and employment status. These variables allow CEH researchers to understand the trends and diversity of opinion around the country.\r\n\r\nIt also incorporates questions from previous surveys to track trends over time.\r\nThe inaugural poll was conducted by Essential in December 2022, and was completed by 4,735 people.'),(103296,1991,'_monitor_content','field_640fcc4014404'),(103297,1991,'problem_head','Housing in Australia is not working, and Australians are concerned.'),(103298,1991,'_problem_head','field_641935436aded'),(103299,1991,'problem_signoff','Explore the research showing how concerned Australians are our about the housing situation.'),(103300,1991,'_problem_signoff','field_641935626adee'),(103301,1991,'sections','a:2:{i:0;s:4:\"hero\";i:1;s:9:\"news_grid\";}'),(103302,1991,'_sections','field_5dafb40b8143a'),(103303,1991,'sections_0_is_full_height','1'),(103304,1991,'_sections_0_is_full_height','field_61d6f6fd5a37e'),(103305,1991,'sections_0_image','1648'),(103306,1991,'_sections_0_image','field_61d6f6d45a37d'),(103307,1991,'sections_0_heading','Heading'),(103308,1991,'_sections_0_heading','field_61d6f69e5a379'),(103309,1991,'sections_0_subtitle','Ya ya '),(103310,1991,'_sections_0_subtitle','field_61d6f6ac5a37a'),(103311,1991,'sections_0_link_one',''),(103312,1991,'_sections_0_link_one','field_61d6f6b55a37b'),(103313,1991,'sections_0_link_two',''),(103314,1991,'_sections_0_link_two','field_61d6f6c35a37c'),(103315,1991,'sections_1_select_categories','a:1:{i:0;s:2:\"27\";}'),(103316,1991,'_sections_1_select_categories','field_637f04483b63b'),(103317,1991,'intro_head_major','Super Consumers Australia is <span>fighting</span> to ensure that the superannuation industry is <span>held accountable</span> for the outcomes they deliver to Australian consumers.'),(103318,1991,'_intro_head_major','field_64e828783ad9f'),(103319,1991,'intro_head_minor','We want super to work for everyone—not just super fund companies. With our research, journalism and campaigns we are creating the trustworthy and transparent superannuation system we all deserve.'),(103320,1991,'_intro_head_minor','field_64e8288c3ada0'),(103321,1991,'intro_icons_0_int_icon','1922'),(103322,1991,'_intro_icons_0_int_icon','field_64e828b33ada2'),(103323,1991,'intro_icons_0_int_icon_text','At 1,727,000 square kilometres, we’re 2.5 times the size of Texas. <span>Yeeha!</span>'),(103324,1991,'_intro_icons_0_int_icon_text','field_64e828e33ada3'),(103325,1991,'intro_icons_1_int_icon','1920'),(103326,1991,'_intro_icons_1_int_icon','field_64e828b33ada2'),(103327,1991,'intro_icons_1_int_icon_text','We have twice as many species of native plant and animal as any other Australian state or territory.'),(103328,1991,'_intro_icons_1_int_icon_text','field_64e828e33ada3'),(103329,1991,'intro_icons_2_int_icon','1921'),(103330,1991,'_intro_icons_2_int_icon','field_64e828b33ada2'),(103331,1991,'intro_icons_2_int_icon_text','We have less land classified as ‘protected’ than any other state or territory.'),(103332,1991,'_intro_icons_2_int_icon_text','field_64e828e33ada3'),(103333,1991,'intro_icons','3'),(103334,1991,'_intro_icons','field_64e828963ada1'),(103335,1991,'threat_head_major','What we stand to lose if we don’t act soon to protect beautiful Queensland:'),(103336,1991,'_threat_head_major','field_64ec258d9dbd1'),(103337,1991,'threats_icons','3'),(103338,1991,'_threats_icons','field_64ec2551a93f9'),(103339,1991,'threats_icons_0_thr_icon','1819'),(103340,1991,'_threats_icons_0_thr_icon','field_64ec2551a93fa'),(103341,1991,'threats_icons_0_thr_icon_text','The rich cultural heritage of our First Nations people and their continuous ties to country, dating back more than 50,000 years.'),(103342,1991,'_threats_icons_0_thr_icon_text','field_64ec2551a93fb'),(103343,1991,'threats_icons_1_thr_icon','1819'),(103344,1991,'_threats_icons_1_thr_icon','field_64ec2551a93fa'),(103345,1991,'threats_icons_1_thr_icon_text','Thousands of species of plant and animal which are now classified as threatened or endangered in Queensland.'),(103346,1991,'_threats_icons_1_thr_icon_text','field_64ec2551a93fb'),(103347,1991,'threats_icons_2_thr_icon','1819'),(103348,1991,'_threats_icons_2_thr_icon','field_64ec2551a93fa'),(103349,1991,'threats_icons_2_thr_icon_text','The access to nature that is central to the Queensland way of life.'),(103350,1991,'_threats_icons_2_thr_icon_text','field_64ec2551a93fb'),(103351,1991,'threat_icons_0_thr_icon',''),(103352,1991,'_threat_icons_0_