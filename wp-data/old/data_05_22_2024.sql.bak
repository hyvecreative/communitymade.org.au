6,1098,'_first_image_cont','field_5b67caff6afc5'),(20767,1098,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(20768,1098,'_first_image_button','field_5b67cb0d6afc6'),(20769,1098,'second _image_title','Lifestart is about supporting young children'),(20770,1098,'_second _image_title','field_5b67cb20ddf9a'),(20771,1098,'second_image_cont','from 0-24 years living with disabilities and their familes'),(20772,1098,'_second_image_cont','field_5b67cb24ddf9b'),(20773,1098,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(20774,1098,'_second_image_button','field_5b67cb29ddf9c'),(20775,1098,'second_image_title','Lifestart is about supporting young children'),(20776,1098,'_second_image_title','field_5b67cb20ddf9a'),(20777,1098,'page_col_image','412'),(20778,1098,'_page_col_image','field_5de6546e7c63a'),(20779,1098,'page_col_image_3','437'),(20780,1098,'_page_col_image_3','field_5de6e3998e07e'),(20781,1098,'sec_2_title','Community'),(20782,1098,'_sec_2_title','field_5de6e3ef2798f'),(20783,1098,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(20784,1098,'_sec_2_text','field_5de78dc89e613'),(20785,1098,'sec_3_title','The Project'),(20786,1098,'_sec_3_title','field_5de6e3d37d8da'),(20787,1098,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(20788,1098,'_sec_3_text','field_5de6e4044e5e8'),(20789,1098,'page_col_image_2','436'),(20790,1098,'_page_col_image_2','field_5de6546e7c63a'),(20791,1098,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(20792,1098,'_sec_2_button','field_5de6e58c86706'),(20793,1098,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(20794,1098,'_sec_3_button','field_5de6e5a243c03'),(20795,1098,'page_col_image_4','455'),(20796,1098,'_page_col_image_4','field_5de70801090ce'),(20797,1098,'sec_4_title','Location'),(20798,1098,'_sec_4_title','field_5de7082a12a81'),(20799,1098,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(20800,1098,'_sec_4_text','field_5de7084812a82'),(20801,1098,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(20802,1098,'_sec_4_button','field_5de7085e12a83'),(20803,1098,'news_title','Project updates'),(20804,1098,'_news_title','field_5de78da3aabb9'),(20805,1098,'sec_2_text_copy',''),(20806,1098,'_sec_2_text_copy','field_5de78dc89e613'),(20807,1098,'timeline-title','Timeline'),(20808,1098,'_timeline-title','field_5de78df29e615'),(20809,1098,'timeline_title','Timeline'),(20810,1098,'_timeline_title','field_5de78df29e615'),(20811,1098,'contact_title','Contact us'),(20812,1098,'_contact_title','field_5de7981e06057'),(20813,1098,'contact_intro','Contact text...'),(20814,1098,'_contact_intro','field_5de7983506058'),(20815,1098,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(20816,1098,'_news_button','field_5de8329896e02'),(20817,1098,'timeline_intro','Introduction of timeline detail...'),(20818,1098,'_timeline_intro','field_5de98f5fb1781'),(20819,1098,'timeline_pic','477'),(20820,1098,'_timeline_pic','field_5de98f72b1782'),(20821,1098,'timeline_