12'),(52043,1700,'_page_col_image','field_5de6546e7c63a'),(52044,1700,'page_col_image_3','437'),(52045,1700,'_page_col_image_3','field_5de6e3998e07e'),(52046,1700,'sec_2_title','Community'),(52047,1700,'_sec_2_title','field_5de6e3ef2798f'),(52048,1700,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(52049,1700,'_sec_2_text','field_5de78dc89e613'),(52050,1700,'sec_3_title','The Project'),(52051,1700,'_sec_3_title','field_5de6e3d37d8da'),(52052,1700,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(52053,1700,'_sec_3_text','field_5de6e4044e5e8'),(52054,1700,'page_col_image_2','436'),(52055,1700,'_page_col_image_2','field_5de6546e7c63a'),(52056,1700,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(52057,1700,'_sec_2_button','field_5de6e58c86706'),(52058,1700,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(52059,1700,'_sec_3_button','field_5de6e5a243c03'),(52060,1700,'page_col_image_4','455'),(52061,1700,'_page_col_image_4','field_5de70801090ce'),(52062,1700,'sec_4_title','Location'),(52063,1700,'_sec_4_title','field_5de7082a12a81'),(52064,1700,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(52065,1700,'_sec_4_text','field_5de7084812a82'),(52066,1700,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(52067,1700,'_sec_4_button','field_5de7085e12a83'),(52068,1700,'news_title','Project updates'),(52069,1700,'_news_title','field_5de78da3aabb9'),(52070,1700,'sec_2_text_copy',''),(52071,1700,'_sec_2_text_copy','field_5de78dc89e613'),(52072,1700,'timeline-title','Timeline'),(52073,1700,'_timeline-title','field_5de78df29e615'),(52074,1700,'timeline_title','Timeline'),(52075,1700,'_timeline_title','field_5de78df29e615'),(52076,1700,'contact_title','Contact us'),(52077,1700,'_contact_title','field_5de7981e06057'),(52078,1700,'contact_intro','Contact text...'),(52079,1700,'_contact_intro','field_5de7983506058'),(52080,1700,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(52081,1700,'_news_button','field_5de8329896e02'),(52082,1700,'timeline_intro','Introduction of timeline detail...'),(52083,1700,'_timeline_intro','field_5de98f5fb1781'),(52084,1700,'timeline_pic','477'),(52085,1700,'_timeline_pic','field_5de98f72b1782'),(52086,1700,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(52087,1700,'_timeline_button','field_5de99363677f8'),(52088,1700,'banner_image_position','center'),(52089,1700,'_banner_image_position','field_5f3bc4757dd02'),(52090,1700,'services_title','Our services'),(52091,1700,'_services_title','field_5f20f3cd80eb2'),(52092,1700,'services_items_0_services_item_image','1061'),(52093,1700,'_services_items_0_services_item_image','field_5f2121355be14'),(52094,1700,'services_items_0_sservices_item_title','1300 Telephone counselling line'),(52095,1700,'_services_items_0_sservices_item_title','field_605089efca82e'),(52096,1700,'services_items_0_services_item_text',''),(52097,1700,'_services_items_0_services_item_text','field_5f2121535be15'),(52098,1700,'services_items_0_