42238'),(93628,1945,'survey_index_6_survey_url','#'),(93629,1945,'_survey_index_6_survey_url','field_6294564e42239'),(93630,1945,'survey_index_6_survey_url_text','View Results'),(93631,1945,'_survey_index_6_survey_url_text','field_629456584223a'),(93632,1945,'survey_index_7_survey_icon','1493'),(93633,1945,'_survey_index_7_survey_icon','field_6294562942237'),(93634,1945,'survey_index_7_survey_title','Going Off-grid'),(93635,1945,'_survey_index_7_survey_title','field_6294564042238'),(93636,1945,'survey_index_7_survey_url','#'),(93637,1945,'_survey_index_7_survey_url','field_6294564e42239'),(93638,1945,'survey_index_7_survey_url_text','View Results'),(93639,1945,'_survey_index_7_survey_url_text','field_629456584223a'),(93640,1945,'survey_index','8'),(93641,1945,'_survey_index','field_6294561242236'),(93642,1945,'report_title','Download the report'),(93643,1945,'_report_title','field_62f30edfb57e1'),(93644,1945,'report_intro','Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus massa erat, consectetur at semper at, feugiat vel orci. '),(93645,1945,'_report_intro','field_62f30eedb57e2'),(93646,1945,'report_link_url','#'),(93647,1945,'_report_link_url','field_62f30ef4b57e3'),(93648,1945,'report_link_text','Download'),(93649,1945,'_report_link_text','field_62f30f01b57e4'),(93650,1945,'solutions_content','The housing system is complex, and no one solution will solve the complex problems we now face but there are some critical first steps to be taken now.\r\n<ul>\r\n 	<li>Set out an ambitious national housing agreement between commonwealth and state governments with targets and funding for the construction of affordable homes.</li>\r\n 	<li>Phase out tax breaks for property investors and using the increase in revenue to build more public housing.</li>\r\n 	<li>Establish laws which limit rental increases beyond what is fair.</li>\r\n 	<li>Rebalance tenancy laws to provide renters with more security and control, such as eliminating no grounds evictions.</li>\r\n 	<li>Phase out stamp duty and replace it with a broad-based land tax.</li>\r\n</ul>\r\n<h4>While there are many opinions on what policy changes will fix the housing market, doing nothing is not an option.</h4>'),(93651,1945,'_solutions_content','field_640e8b307a958'),(93652,1945,'problem_icons_0_prob_icon','1699'),(93653,1945,'_problem_icons_0_prob_icon','field_640fa0291d519'),(93654,1945,'problem_icons_0_prob_concerned_stat','70% highly concerned'),(93655,1945,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(93656,1945,'problem_icons_0_prob_concerded_text','are highly concerned'),(93657,1945,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(93658,1945,'problem_icons_0_prob_issue_text',''),(93659,1945,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(93660,1945,'problem_icons','4'),(93661,1945,'_problem_icons','field_640fa0191d518'),(93662,1945,'ceh_content_left',''),(93663,1945,'_ceh_content_left','field_640e97e8f1c8c'),(93664,1945,'ceh_content_right',''),(93665,1945,'_ceh_content_right','field_640e97fdf1c8d'),(93666,1945,'pc_content_left',''),(93667,1945,'_pc_content_left','field_640e983bf1c8f'),(93668,1945,'pc_content_right',''),(93669,1945,'_pc_content_right','field_640e984df1c90'),(93670,1945,'problem_icons_1_prob_icon','1699'),(93671,1945,'_problem_icons_1_prob_icon','field_640fa0291d519'),(93672,1945,'problem_icons_1_prob_concerned_stat','69% highly concerned'),(93673,1945,'_problem_icons_1_prob_concerned_stat','field_640fa0dd81d95'),(93674,1945,'problem_icons_1_prob_concerded_text','are highly concerned'),(93675,1945,'_problem_icons_1_prob_concerded_text','field_640fa10181d96'),(93676,1945,'problem_icons_1_prob_issue_text',''),(93677,1945,'_problem_icons_1_prob_issue_text','field_640fa11a81d97'),(93678,1945,'problem_icons_2_prob_icon','1699'),(93679,1945,'_problem_icons_2_prob_icon','field_640fa0291d519'),(93680,1945,'problem_icons_2_prob_concerned_stat','64% highly concerned'),(93681,1945,'_problem_icons_2_prob_concerned_stat','field_640fa0dd81d95'),(93682,1945,'problem_icons_2_prob_concerded_text','are highly concerned'),(93683,1945,'_problem_icons_2_prob_concerded_text','field_640fa10181d96'),(93684,1945,'problem_icons_2_prob_issue_text',''),(93685,1945,'_problem_icons_2_prob_issue_text','field_640fa11a81d97'),(93686,1945,'problem_icons_3_prob_icon','1699'),(93687,1945,'_problem_icons_3_prob_icon','field_640fa0291d519'),(93688,1945,'problem_icons_3_prob_concerned_stat','64% highly concerned'),(93689,1945,'_problem_icons_3_prob_concerned_stat','field_640fa0dd81d95'),(93690,1945,'problem_icons_3_prob_concerded_text','are highly concerned'),(93691,1945,'_problem_icons_3_prob_concerded_text','field_640fa10181d96'),(93692,1945,'problem_icons_3_prob_issue_text',''),(93693,1945,'_problem_icons_3_prob_issue_text','field_640fa11a81d97'),(93694,1945,'problem_icons_0_prob_concerned_text','House prices have doubled in a decade'),(93695,1945,'_problem_icons_0_prob_concerned_text','field_640fa10181d96'),(93696,1945,'problem_icons_1_prob_concerned_text','The gap between rich and poor is growing'),(93697,1945,'_problem_icons_1_prob_concerned_text','field_640fa10181d96'),(93698,1945,'problem_icons_2_prob_concerned_text','Construction of social housing is down'),(93699,1945,'_problem_icons_2_prob_concerned_text','field_640fa10181d96'),(93700,1945,'problem_icons_3_prob_concerned_text','Banks are making more than ever from housing'),(93701,1945,'_problem_icons_3_prob_concerned_text','field_640fa10181d96'),(93702,1945,'monitor_content','The Australian Housing Monitor is a large, nationally-representative survey covering public experiences and attitudes toward housing related issues. Questions range from how well the respondent is keeping up with their mortgage/rent, to what they think about social housing construction.\r\n\r\nA broad range of demographic criteria are included, such as gender, location, age, income, voting preference, educational level, tenure type, and employment status. These variables allow CEH researchers to understand the trends and diversity of opinion around the country.\r\n\r\nIt also incorporates questions from previous surveys to track trends over time.\r\nThe inaugural poll was conducted by Essential in December 2022, and was completed by 4,735 people.'),(93703,1945,'_monitor_content','field_640fcc4014404'),(93704,1945,'problem_head','Housing in Australia is not working, and Australians are concerned.'),(93705,1945,'_problem_head','field_641935436aded'),(93706,1945,'problem_signoff','Explore the research showing how concerned Australians are our about the housing situation.'),(93707,1945,'_problem_signoff','field_641935626adee'),(93708,1945,'sections','a:2:{i:0;s:4:\"hero\";i:1;s:9:\"news_grid\";}'),(93709,1945,'_sections','field_5dafb40b8143a'),(93710,1945,'sections_0_is_full_height','1'),(93711,1945,'_sections_0_is_full_height','field_61d6f6fd5a37e'),(93712,1945,'sections_0_image','1648'),(93713,1945,'_sections_0_image','field_61d6f6d45a37d'),(93714,1945,'sections_0_heading','Heading'),(93715,1945,'_sections_0_heading','field_61d6f69e5a379'),(93716,1945,'sections_0_subtitle','Ya ya '),(93717,1945,'_sections_0_subtitle','field_61d6f6ac5a37a'),(93718,1945,'sections_0_link_one',''),(93719,1945,'_sections_0_link_one','field_61d6f6b55a37b'),(93720,1945,'sections_0_link_two',''),(93721,1945,'_sections_0_link_two','field_61d6f6c35a37c'),(93722,1945,'sections_1_select_categories','a:1:{i:0;s:2:\"27\";}'),(93723,1945,'_sections_1_select_categories','field_637f04483b63b'),(93724,1945,'intro_head_major','Super Consumers Australia is <span>fighting</span> to ensure that the superannuation industry is <span>held accountable</span> for the outcomes they deliver to Australian consumers.'),(93725,1945,'_intro_head_major','field_64e828783ad9f'),(93726,1945,'intro_head_minor','We want super to work for everyone—not just super fund companies. With our research, journalism and campaigns we are creating the trustworthy and transparent superannuation system we all deserve.'),(93727,1945,'_intro_head_minor','field_64e8288c3ada0'),(93728,1945,'intro_icons_0_int_icon','1922'),(93729,1945,'_intro_icons_0_int_icon','field_64e828b33ada2'),(93730,1945,'intro_icons_0_int_icon_text','At 1,727,000 square kilometres, we’re 2.5 times the size of Texas. <span>Yeeha!</span>'),(93731,1945,'_intro_icons_0_int_icon_text','field_64e828e33ada3'),(93732,1945,'intro_icons_1_int_icon','1920'),(93733,1945,'_intro_icons_1_int_icon','field_64e828b33ada2'),(93734,1945,'intro_icons_1_int_icon_text','We have twice as many species of native plant and animal as any other Australian state or territory.'),(93735,1945,'_intro_icons_1_int_icon_text','field_64e828e33ada3'),(93736,1945,'intro_icons_2_int_icon','1921'),(93737,1945,'_intro_icons_2_int_icon','field_64e828b33ada2'),(93738,1945,'intro_icons_2_int_icon_text','We have less land classified as ‘protected’ than any other state or territory.'),(93739,1945,'_intro_icons_2_int_icon_text','field_64e828e33ada3'),(93740,1945,'intro_icons','3'),(93741,1945,'_intro_icons','field_64e828963ada1'),(93742,1945,'threat_head_major','What we stand to lose if we don’t act soon to protect beautiful Queensland:'),(93743,1945,'_threat_head_major','field_64ec258d9dbd1'),(93744,1945,'threats_icons','3'),(93745,1945,'_threats_icons','field_64ec2551a93f9'),(93746,1945,'threats_icons_0_thr_icon','1819'),(93747,1945,'_threats_icons_0_thr_icon','field_64ec2551a93fa'),(93748,1945,'threats_icons_0_thr_icon_text','The rich cultural heritage of our First Nations people and their continuous ties to country, dating back more than 50,000 years.'),(93749,1945,'_threats_icons_0_thr_icon_text','field_64ec2551a93fb'),(93750,1945,'threats_icons_1_thr_icon','1819'),(93751,1945,'_threats_icons_1_thr_icon','field_64ec2551a93fa'),(93752,1945,'threats_icons_1_thr_icon_text','Thousands of species of plant and animal which are now classified as threatened or endangered in Queensland.'),(93753,1945,'_threats_icons_1_thr_icon_text','field