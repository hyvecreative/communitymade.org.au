66,'survey_index_7_survey_icon','1493'),(72971,1866,'_survey_index_7_survey_icon','field_6294562942237'),(72972,1866,'survey_index_7_survey_title','Going Off-grid'),(72973,1866,'_survey_index_7_survey_title','field_6294564042238'),(72974,1866,'survey_index_7_survey_url','#'),(72975,1866,'_survey_index_7_survey_url','field_6294564e42239'),(72976,1866,'survey_index_7_survey_url_text','View Results'),(72977,1866,'_survey_index_7_survey_url_text','field_629456584223a'),(72978,1866,'survey_index','8'),(72979,1866,'_survey_index','field_6294561242236'),(72980,1866,'report_title','Download the report'),(72981,1866,'_report_title','field_62f30edfb57e1'),(72982,1866,'report_intro','Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus massa erat, consectetur at semper at, feugiat vel orci. '),(72983,1866,'_report_intro','field_62f30eedb57e2'),(72984,1866,'report_link_url','#'),(72985,1866,'_report_link_url','field_62f30ef4b57e3'),(72986,1866,'report_link_text','Download'),(72987,1866,'_report_link_text','field_62f30f01b57e4'),(72988,1866,'solutions_content','The housing system is complex, and no one solution will solve the complex problems we now face but there are some critical first steps to be taken now.\r\n<ul>\r\n 	<li>Set out an ambitious national housing agreement between commonwealth and state governments with targets and funding for the construction of affordable homes.</li>\r\n 	<li>Phase out tax breaks for property investors and using the increase in revenue to build more public housing.</li>\r\n 	<li>Establish laws which limit rental increases beyond what is fair.</li>\r\n 	<li>Rebalance tenancy laws to provide renters with more security and control, such as eliminating no grounds evictions.</li>\r\n 	<li>Phase out stamp duty and replace it with a broad-based land tax.</li>\r\n</ul>\r\n<h4>While there are many opinions on what policy changes will fix the housing market, doing nothing is not an option.</h4>'),(72989,1866,'_solutions_content','field_640e8b307a958'),(72990,1866,'problem_icons_0_prob_icon','1699'),(72991,1866,'_problem_icons_0_prob_icon','field_640fa0291d519'),(72992,1866,'problem_icons_0_prob_concerned_stat','70% highly concerned'),(72993,1866,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(72994,1866,'problem_icons_0_prob_concerded_text','are highly concerned'),(72995,1866,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(72996,1866,'problem_icons_0_prob_issue_text',''),(72997,1866,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(72998,1866,'problem_icons','4'),(72999,1866,'_problem_icons','field_640fa0191d518'),(73000,1866,'ceh_content_left',''),(73001,1866,'_ceh_content_left','field_640e97e8f1c8c'),(73002,1866,'ceh_content_right',''),(73003,1866,'_ceh_content_right','field_640e97fdf1c8d'),(73004,1866,'pc_content_left',''),(73005,1866,'_pc_content_left','field_640e983bf1c8f'),(73006,1866,'pc_content_right',''),(73007,1866,'_pc_content_right','field_640e984df1c90'),(73008,1866,'problem_icons_1_prob_icon','1699'),(73009,1866,'_problem_icons_1_prob_icon','field_640fa0291d519'),(73010,1866,'problem_icons_1_prob_concerned_stat','69% highly concerned'),(73011,1866,'_problem_icons_1_prob_concerned_stat','field_640fa0dd81d95'),(73012,1866,'problem_icons_1_prob_concerded_text','are highly concerned'),(73013,1866,'_problem_icons_1_prob_concerded_text','field_640fa10181d96'),(73014,1866,'problem_icons_1_prob_issue_text',''),(73015,1866,'_problem_icons_1_prob_issue_text','field_640fa11a81d97'),(73016,1866,'problem_icons_2_prob_icon','1699'),(73017,1866,'_problem_icons_2_prob_icon','field_640fa0291d519'),(73018,1866,'problem_icons_2_prob_concerned_stat','64% highly concerned'),(73019,1866,'_problem_icons_2_prob_concerned_stat','field_640fa0dd81d95'),(73020,1866,'problem_icons_2_prob_concerded_text','are highly concerned'),(73021,1866,'_problem_icons_2_prob_concerded_text','field_640fa10181d96'),(73022,1866,'problem_icons_2_prob_issue_text',''),(73023,1866,'_problem_icons_2_prob_issue_text','field_640fa11a81d97'),(73024,1866,'problem_icons_3_prob_icon','1699'),(73025,1866,'_problem_icons_3_prob_icon','field_640fa0291d519'),(73026,1866,'problem_icons_3_prob_concerned_stat','64% highly concerned'),(73027,1866,'_problem_icons_3_prob_concerned_stat','field_640fa0dd81d95'),(73028,1866,'problem_icons_3_prob_concerded_text','are highly concerned'),(73029,1866,'_problem_icons_3_prob_concerded_text','field_640fa10181d96'),(73030,1866,'problem_icons_3_prob_issue_text',''),(73031,1866,'_problem_icons_3_prob_issue_text','field_640fa11a81d97'),(73032,1866,'problem_icons_0_prob_concerned_text','House prices have doubled in a decade'),(73033,1866,'_problem_icons_0_prob_concerned_text','field_640fa10181d96'),(73034,1866,'problem_icons_1_prob_concerned_text','The gap between rich and poor is growing'),(73035,1866,'_problem_icons_1_prob_concerned_text','field_640fa10181d96'),(73036,1866,'problem_icons_2_prob_concerned_text','Construction of social housing is down'),(73037,1866,'_problem_icons_2_prob_concerned_text','field_640fa10181d96'),(73038,1866,'problem_icons_3_prob_concerned_text','Banks are making more than ever from housing'),(73039,1866,'_problem_icons_3_prob_concerned_text','field_640fa10181d96'),(73040,1866,'monitor_content','The Australian Housing Monitor is a large, nationally-representative survey covering public experiences and attitudes toward housing related issues. Questions range from how well the respondent is keeping up with their mortgage/rent, to what they think about social housing construction.\r\n\r\nA broad range of demographic criteria are included, such as gender, location, age, income, voting preference, educational level, tenure type, and employment status. These variables allow CEH researchers to understand the trends and diversity of opinion around the country.\r\n\r\nIt also incorporates questions from previous surveys to track trends over time.\r\nThe inaugural poll was conducted by Essential in December 2022, and was completed by 4,735 people.'),(73041,1866,'_monitor_content','field_640fcc4014404'),(73042,1866,'problem_head','Housing in Australia is not working, and Australians are concerned.'),(73043,1866,'_problem_head','field_641935436aded'),(73044,1866,'problem_signoff','Explore the research showing how concerned Australians are our about the housing situation.'),(73045,1866,'_problem_signoff','field_641935626adee'),(73046,1866,'sections','a:2:{i:0;s:4:\"hero\";i:1;s:9:\"news_grid\";}'),(73047,1866,'_sections','field_5dafb40b8143a'),(73048,1866,'sections_0_is_full_height','1'),(73049,1866,'_sections_0_is_full_height','field_61d6f6fd5a37e'),(73050,1866,'sections_0_image','1648'),(73051,1866,'_sections_0_image','field_61d6f6d45a37d'),(73052,1866,'sections_0_heading','Heading'),(73053,1866,'_sections_0_heading','field_61d6f69e5a379'),(73054,1866,'sections_0_subtitle','Ya ya '),(73055,1866,'_sections_0_subtitle','field_61d6f6ac5a37a'),(73056,1866,'sections_0_link_one',''),(73057,1866,'_sections_0_link_one','field_61d6f6b55a37b'),(73058,1866,'sections_0_link_two',''),(73059,1866,'_sections_0_link_two','field_61d6f6c35a37c'),(73060,1866,'sections_1_select_categories','a:1:{i:0;s:2:\"27\";}'),(73061,1866,'_sections_1_select_categories','field_637f04483b63b'),(73062,1866,'intro_head_major','Queenslanders are known for both our love of the great outdoors and our state pride…'),(73063,1866,'_intro_head_major','field_64e828783ad9f'),(73064,1866,'intro_head_minor','But there’s a few things you might not know about our beautiful state.'),(73065,1866,'_intro_head_minor','field_64e8288c3ada0'),(73066,1866,'intro_icons_0_int_icon','1806'),(73067,1866,'_intro_icons_0_int_icon','field_64e828b33ada2'),(73068,1866,'intro_icons_0_int_icon_text','At 1,727,000 square kilometres, we’re 2.5 times the size of Texas. <span>Yeeha!</span>'),(73069,1866,'_intro_icons_0_int_icon_text','field_64e828e33ada3'),(73070,1866,'intro_icons_1_int_icon','1806'),(73071,1866,'_intro_icons_1_int_icon','field_64e828