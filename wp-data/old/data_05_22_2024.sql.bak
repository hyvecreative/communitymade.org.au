field_65262d29ed8e3'),(80348,6,'intro_boxes_0_box_dropdown','Our rigorous, conflict-free research and data analysis lifts the lid on fund performance, fees and insurance. Drawing on our policy expertise, we turn this analysis into action by using it to back reform and make super easier for people to understand. <a href=\"//localhost:4000:4000:4000:4000:4000:4000:4000/how/\">More</a> '),(80349,6,'_intro_boxes_0_box_dropdown','field_65262dead0a0c'),(80350,6,'intro_boxes_1_box_icon','1941'),(80351,6,'_intro_boxes_1_box_icon','field_65262db5d36ee'),(80352,6,'intro_boxes_1_box_title','Investigative journalism'),(80353,6,'_intro_boxes_1_box_title','field_65262d29ed8e3'),(80354,6,'intro_boxes_1_box_dropdown','Dropdown text'),(80355,6,'_intro_boxes_1_box_dropdown','field_65262dead0a0c'),(80356,6,'intro_boxes_2_box_icon','1937'),(80357,6,'_intro_boxes_2_box_icon','field_65262db5d36ee'),(80358,6,'intro_boxes_2_box_title','Research'),(80359,6,'_intro_boxes_2_box_title','field_65262d29ed8e3'),(80360,6,'intro_boxes_2_box_dropdown','Dropdown text'),(80361,6,'_intro_boxes_2_box_dropdown','field_65262dead0a0c'),(80362,6,'intro_boxes','3'),(80363,6,'_intro_boxes','field_65262d14ed8e2'),(80364,6,'get_help_section_title','Get Help'),(80365,6,'_get_help_section_title','field_65262c35143de'),(80366,6,'get_help_block_home',''),(80367,6,'_get_help_block_home','field_65262c8a143e1'),(80368,1913,'banner_head',''),(80369,1913,'_banner_head','field_5b568121a8ffe'),(80370,1913,'banner_sub',''),(80371,1913,'_banner_sub','field_5b568139fd366'),(80372,1913,'banner_button','<a class=\"btn btn-home\" style=\"width: 200px;\" href=\"#project\">Sign the petition</a>'),(80373,1913,'_banner_button','field_5b568147fd367'),(80374,1913,'support_section_title','How can Lifestart support you?'),(80375,1913,'_support_section_title','field_5b67c7d060398'),(80376,1913,'support_left_title','Services'),(80377,1913,'_support_left_title','field_5b67c298e7f8f'),(80378,1913,'support_left_cont','Lorem ipsum dolor sit 