e','field_5de6546e7c63a'),(23297,1119,'page_col_image_3','437'),(23298,1119,'_page_col_image_3','field_5de6e3998e07e'),(23299,1119,'sec_2_title','Community'),(23300,1119,'_sec_2_title','field_5de6e3ef2798f'),(23301,1119,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(23302,1119,'_sec_2_text','field_5de78dc89e613'),(23303,1119,'sec_3_title','The Project'),(23304,1119,'_sec_3_title','field_5de6e3d37d8da'),(23305,1119,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(23306,1119,'_sec_3_text','field_5de6e4044e5e8'),(23307,1119,'page_col_image_2','436'),(23308,1119,'_page_col_image_2','field_5de6546e7c63a'),(23309,1119,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(23310,1119,'_sec_2_button','field_5de6e58c86706'),(23311,1119,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(23312,1119,'_sec_3_button','field_5de6e5a243c03'),(23313,1119,'page_col_image_4','455'),(23314,1119,'_page_col_image_4','field_5de70801090ce'),(23315,1119,'sec_4_title','Location'),(23316,1119,'_sec_4_title','field_5de7082a12a81'),(23317,1119,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(23318,1119,'_sec_4_text','field_5de7084812a82'),(23319,1119,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(23320,1119,'_sec_4_button','field_5de7085e12a83'),(23321,1119,'news_title','Project updates'),(23322,1119,'_news_title','field_5de78da3aabb9'),(23323,1119,'sec_2_text_copy',''),(23324,1119,'_sec_2_text_copy','field_5de78dc89e613'),(23325,1119,'timeline-title','Timeline'),(23326,1119,'_timeline-title','field_5de78df29e615'),(23327,1119,'timeline_title','Timeline'),(23328,1119,'_timeline_title','field_5de78df29e615'),(23329,1119,'contact_title','Contact us'),(23330,1119,'_contact_title','field_5de7981e06057'),(23331,1119,'contact_intro','Contact text...'),(23332,1119,'_contact_intro','field_5de7983506058'),(23333,1119,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(23334,1119,'_news_button','field_5de8329896e02'),(23335,1119,'timeline_intro','Introduction of timeline detail...'),(23336,1119,'_timeline_intro','field_5de98f5fb1781'),(23337,1119,'timeline_pic','477'),(23338,1119,'_timeline_pic','field_5de98f72b1782'),(23339,1119,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(23340,1119,'_timeline_button','field_5de99363677f8'),(23341,1119,'banner_image_position','center'),(23342,1119,'_banner_image_position','field_5f3bc4757dd02'),(23343,1119,'services_title','Our services'),(23344,1119,'_services_title','field_5f20f3cd80eb2'),(23345,1119,'services_items_0_services_item_image','1061'),(23346,1119,'_services_items_0_services_item_image','field_5f2121355be14'),(23347,1119,'services_items_0_sservices_item_title','1300 Telephone counselling line'),(23348,1119,'_services_items_0_sservices_item_title','field_605089efca82e'),(23349,1119,'services_items_0_services_item_text',''),(23350,1119,'_services_items_0_services_item_text','field_5f2121535be15'),(23351,1119,'services_items_0_services_link_url','#'),(23352,1