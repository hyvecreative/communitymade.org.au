ey_index_7_survey_url','#'),(90945,1939,'_survey_index_7_survey_url','field_6294564e42239'),(90946,1939,'survey_index_7_survey_url_text','View Results'),(90947,1939,'_survey_index_7_survey_url_text','field_629456584223a'),(90948,1939,'survey_index','8'),(90949,1939,'_survey_index','field_6294561242236'),(90950,1939,'report_title','Download the report'),(90951,1939,'_report_title','field_62f30edfb57e1'),(90952,1939,'report_intro','Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus massa erat, consectetur at semper at, feugiat vel orci. '),(90953,1939,'_report_intro','field_62f30eedb57e2'),(90954,1939,'report_link_url','#'),(90955,1939,'_report_link_url','field_62f30ef4b57e3'),(90956,1939,'report_link_text','Download'),(90957,1939,'_report_link_text','field_62f30f01b57e4'),(90958,1939,'solutions_content','The housing system is complex, and no one solution will solve the complex problems we now face but there are some critical first steps to be taken now.\r\n<ul>\r\n 	<li>Set out an ambitious national housing agreement between commonwealth and state governments with targets and funding for the construction of affordable homes.</li>\r\n 	<li>Phase out tax breaks for property investors and using the increase in revenue to build more public housing.</li>\r\n 	<li>Establish laws which limit rental increases beyond what is fair.</li>\r\n 	<li>Rebalance tenancy laws to provide renters with more security and control, such as eliminating no grounds evictions.</li>\r\n 	<li>Phase out stamp duty and replace it with a broad-based land tax.</li>\r\n</ul>\r\n<h4>While there are many opinions on what policy changes will fix the housing market, doing nothing is not an option.</h4>'),(90959,1939,'_solutions_content','field_640e8b307a958'),(90960,1939,'problem_icons_0_prob_icon','1699'),(90961,1939,'_problem_icons_0_prob_icon','field_640fa0291d519'),(90962,1939,'problem_icons_0_prob_concerned_stat','70% highly concerned'),(90963,1939,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(90964,1939,'problem_icons_0_prob_concerded_text','are highly concerned'),(90965,1939,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(90966,1939,'problem_icons_0_prob_issue_text',''),(90967,1939,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(90968,1939,'problem_icons','4'),(90969,1939,'_problem_icons','field_640fa0191d518'),(90970,1939,'ceh_content_left',''),(90971,1939,'_ceh_content_left','field_640e97e8f1c8c'),(90972,1939,'ceh_content_right',''),(90973,1939,'_ceh_content_right','field_640e97fdf1c8d'),(90974,1939,'pc_content_left',''),(90975,1939,'_pc_content_left','field_640e983bf1c8f'),(90976,1939,'pc_content_right',''),(90977,1939,'_pc_content_right','field_640e984df1c90'),(90978,1939,'problem_icons_1_prob_icon','1699'),(90979,1939,'_problem_icons_1_prob_icon','field_640fa0291d519'),(90980,1939,'problem_icons_1_prob_concerned_stat','69% highly concerned'),(90981,1939,'_problem_icons_1_prob_concerned_stat','field_640fa0dd81d95'),(90982,1939,'problem_icons_1_prob_concerded_text','are highly concerned'),(90983,1939,'_problem_icons_1_prob_concerded_text','field_640fa10181d96'),(90984,1939,'problem_icons_1_prob_issue_text',''),(90985,1939,'_problem_icons_1_prob_issue_text','field_640fa11a81d97'),(90986,1939,'problem_icons_2_prob_icon','1699'),(90987,1939,'_problem_icons_2_prob_icon','field_640fa0291d519'),(90988,1939,'problem_icons_2_prob_concerned_stat','64% highly concerned'),(90989,1939,'_problem_icons_2_prob_concerned_stat','field_640fa0dd81d95'),(90990,1939,'problem_icons_2_prob_concerded_text','are highly concerned'),(90991,1939,'_problem_icons_2_prob_concerded_text','field_640fa10181d96'),(90992,1939,'problem_icons_2_prob_issue_text',''),(90993,1939,'_problem_icons_2_prob_issue_text','field_640fa11a81d97'),(90994,1939,'problem_icons_3_prob_icon','1699'),(90995,1939,'_problem_icons_3_prob_icon','field_640fa0291d519'),(90996,1939,'problem_icons_3_prob_concerned_stat','64% highly concerned'),(90997,1939,'_problem_icons_3_prob_concerned_stat','field_640fa0dd81d95'),(90998,1939,'problem_icons_3_prob_concerded_text','are highly concerned'),(90999,1939,'_problem_icons_3_prob_concerded_text','field_640fa10181d96'),(91000,1939,'problem_icons_3_prob_issue_text',''),(91001,1939,'_problem_icons_3_prob_issue_text','field_640fa11a81d97'),(91002,1939,'problem_icons_0_prob_concerned_text','House prices have doubled in a decade'),(91003,1939,'_problem_icons_0_prob_concerned_text','field_640fa10181d96'),(91004,1939,'problem_icons_1_prob_concerned_text','The gap between rich and poor is growing'),(91005,1939,'_problem_icons_1_prob_concerned_text','field_640fa10181d96'),(91006,1939,'problem_icons_2_prob_concerned_text','Construction of social housing is down'),(91007,1939,'_problem_icons_2_prob_concerned_text','field_640fa10181d96'),(91008,1939,'problem_icons_3_prob_concerned_text','Banks are making more than ever from housing'),(91009,1939,'_problem_icons_3_prob_concerned_text','field_640fa10181d96'),(91010,1939,'monitor_content','The Australian Housing Monitor is a large, nationally-representative survey covering public experiences and attitudes toward housing related issues. Questions range from how well the respondent is keeping up with their mortgage/rent, to what they think about social housing construction.\r\n\r\nA broad range of demographic criteria are included, such as gender, location, age, income, voting preference, educational level, tenure type, and employment status. These variables allow CEH researchers to understand the trends and diversity of opinion around the country.\r\n\r\nIt also incorporates questions from previous surveys to track trends over time.\r\nThe inaugural poll was conducted by Essential in December 2022, and was completed by 4,735 people.'),(91011,1939,'_monitor_content','field_640fcc4014404'),(91012,1939,'problem_head','Housing in Australia is not working, and Australians are concerned.'),(91013,1939,'_problem_head','field_641935436aded'),(91014,1939,'problem_signoff','Explore the research showing how concerned Australians are our about the housing situation.'),(91015,1939,'_problem_signoff','field_641935626adee'),(91016,1939,'sections','a:2:{i:0;s:4:\"hero\";i:1;s:9:\"news_grid\";}'),(91017,1939,'_sections','field_5dafb40b8143a'),(91018,1939,'sections_0_is_full_height','1'),(91019,1939,'_sections_0_is_full_height','field_61d6f6fd5a37e'),(91020,1939,'sections_0_image','1648'),(91021,1939,'_sections_0_image','field_61d6f6d45a37d'),(91022,1939,'sections_0_heading','Heading'),(91023,1939,'_sections_0_heading','field_61d6f69e5a379'),(91024,1939,'sections_0_subtitle','Ya ya '),(91025,1939,'_sections_0_subtitle','field_61d6f6ac5a37a'),(91026,1939,'sections_0_link_one',''),(91027,1939,'_sections_0_link_one','field_61d6f6b55a37b'),(91028,1939,'sections_0_link_two',''),(91029,1939,'_sections_0_link_two','field_61d6f6c35a37c'),(91030,1939,'sections_1_select_categories','a:1:{i:0;s:2:\"27\";}'),(91031,1939,'_sections_1_select_categories','field_637f04483b63b'),(91032,1939,'intro_head_major','Super Consumers Australia is <span>fighting</span> to ensure that the superannuation industry is <span>held accountable</span> for the outcomes they deliver to Australian consumers.'),(91033,1939,'_intro_head_major','field_64e828783ad9f'),(91034,1939,'intro_head_minor','We want super to work for everyone—not just super fund companies. With our research, journalism and campaigns we are creating the trustworthy and transparent superannuation system we all deserve.'),(91035,1939,'_intro_head_minor','field_64e8288c3ada0'),(91036,1939,'intro_icons_0_int_icon','1922'),(91037,1939,'_intro_icons_0_int_icon','field_64e828b33ada2'),(91038,1939,'intro_icons_0_int_icon_text','At 1,727,000 square kilometres, we’re 2.5 times the size of Texas. <span>Yeeha!</span>'),(91039,1939,'_intro_icons_0_int_icon_text','field_64e828e33ada3'),(91040,1939,'intro_icons_1_int_icon','1920'),(91041,1939,'_intro_icons_1_int_icon','field_64e828b33ada2'),(91042,1939,'int