t_cont','field_5b67c6c98c065'),(105153,2007,'support_right_button','<a class=\"btn btn-blue\" href=\"#\">Read more</a>'),(105154,2007,'_support_right_button','field_5b67c6dd8c066'),(105155,2007,'first_image_title','Lifestart is about supporting young children'),(105156,2007,'_first_image_title','field_5b67ca606afc4'),(105157,2007,'first_image_cont','from 0-24 years living with disabilities and their familes'),(105158,2007,'_first_image_cont','field_5b67caff6afc5'),(105159,2007,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(105160,2007,'_first_image_button','field_5b67cb0d6afc6'),(105161,2007,'second _image_title','Lifestart is about supporting young children'),(105162,2007,'_second _image_title','field_5b67cb20ddf9a'),(105163,2007,'second_image_cont','from 0-24 years living with disabilities and their familes'),(105164,2007,'_second_image_cont','field_5b67cb24ddf9b'),(105165,2007,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(105166,2007,'_second_image_button','field_5b67cb29ddf9c'),(105167,2007,'second_image_title','Lifestart is about supporting young children'),(105168,2007,'_second_image_title','field_5b67cb20ddf9a'),(105169,2007,'page_col_image','412'),(105170,2007,'_page_col_image','field_5de6546e7c63a'),(105171,2007,'page_col_image_3','437'),(105172,2007,'_page_col_image_3','field_5de6e3998e07e'),(105173,2007,'sec_2_title','Community'),(105174,2007,'_sec_2_title','field_5de6e3ef2798f'),(105175,2007,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(105176,2007,'_sec_2_text','field_5de78dc89e613'),(105177,2007,'sec_3_title','The Project'),(105178,2007,'_sec_3_title','field_5de6e3d37d8da'),(105179,2007,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(105180,2007,'_sec_3_text','field_5de6e4044e5e8'),(105181,2007,'page_col_image_2','436'),(105182,2007,'_page_col_image_2','field_5de6546e7c63a'),(105183,2007,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(105184,2007,'_sec_2_button','field_5de6e58c86706'),(105185,2007,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(105186,2007,'_sec_3_button','field_5de6e5a243c03'),(105187,2007,'page_col_image_4','455'),(105188,2007,'_page_col_image_4','field_5de70801090ce'),(105189,2007,'sec_4_title','Location'),(105190,2007,'_sec_4_title','field_5de7082a12a81'),(105191,2007,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(105192,2007,'_sec_4_text','field_5de7084812a82'),(105193,2007,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(105194,2007,'_sec_4_button','field_5de7085e12a83'),(105195,2007,'news_title','Project updates'),(105196,2007,'_news_title','field_5de78da3aabb9'),(105197,2007,'sec_2_text_copy',''),(105198,2007,'_sec_2_text_copy','field_5de78dc89e613'),(105199,2007,'timeline-title','Timeline'),(105200,2007,'_timeline-title','field_5de78df29e615'),(105201,2007,'timeline_title','Timeline'),(105202,2007,'_timeline_title','field_5de78df29e615'),(105203,2007,'contact_title','Contact us'),(105204,2007,'_contact_title','field_5de7981e06057'),(105205,2007,'