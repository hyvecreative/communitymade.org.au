),(114583,2122,'first_image_cont','from 0-24 years living with disabilities and their familes'),(114584,2122,'_first_image_cont','field_5b67caff6afc5'),(114585,2122,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(114586,2122,'_first_image_button','field_5b67cb0d6afc6'),(114587,2122,'second _image_title','Lifestart is about supporting young children'),(114588,2122,'_second _image_title','field_5b67cb20ddf9a'),(114589,2122,'second_image_cont','from 0-24 years living with disabilities and their familes'),(114590,2122,'_second_image_cont','field_5b67cb24ddf9b'),(114591,2122,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(114592,2122,'_second_image_button','field_5b67cb29ddf9c'),(114593,2122,'second_image_title','Lifestart is about supporting young children'),(114594,2122,'_second_image_title','field_5b67cb20ddf9a'),(114595,2122,'page_col_image','412'),(114596,2122,'_page_col_image','field_5de6546e7c63a'),(114597,2122,'page_col_image_3','437'),(114598,2122,'_page_col_image_3','field_5de6e3998e07e'),(114599,2122,'sec_2_title','Community'),(114600,2122,'_sec_2_title','field_5de6e3ef2798f'),(114601,2122,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(114602,2122,'_sec_2_text','field_5de78dc89e613'),(114603,2122,'sec_3_title','The Project'),(114604,2122,'_sec_3_title','field_5de6e3d37d8da'),(114605,2122,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(114606,2122,'_sec_3_text','field_5de6e4044e5e8'),(114607,2122,'page_col_image_2','436'),(114608,2122,'_page_col_image_2','field_5de6546e7c63a'),(114609,2122,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(114610,2122,'_sec_2_button','field_5de6e58c86706'),(114611,2122,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(114612,2122,'_sec_3_button','field_5de6e5a243c03'),(114613,2122,'page_col_image_4','455'),(114614,2122,'_page_col_image_4','field_5de70801090ce'),(114615,2122,'sec_4_title','Location'),(114616,2122,'_sec_4_title','field_5de7082a12a81'),(114617,2122,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(114618,2122,'_sec_4_text','field_5de7084812a82'),(114619,2122,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(114620,2122,'_sec_4_button','field_5de7085e12a83'),(114621,2122,'news_title','Project updates'),(114622,2122,'_news_title','field_5de78da3aabb9'),(114623,2122,'sec_2_text_copy',''),(114624,2122,'_sec_2_text_copy','field_5de78dc89e613'),(114625,2122,'timeline-title','Timeline'),(114626,2122,'_timeline-title','field_5de78df29e615'),(114627,2122,'timeline_title','Timeline'),(114628,2122,'_timeline_title','field_5de78df29e615'),(114629,2122,'contact_title','Contact us'),(114630,2122,'_contact_title','field_5de7981e06057'),(114631,2122,'contact_intro','Contact text...'),(114632,2122,'_contact_intro','field_5de7983506058'),(114633,2122,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(114634,2122,'_news_button','field_5de8329896e02'),(114635,2122,'timeline_intro','Introduction of timeline detail...'),(114636