e_title','field_5b67cb20ddf9a'),(26470,1146,'page_col_image','412'),(26471,1146,'_page_col_image','field_5de6546e7c63a'),(26472,1146,'page_col_image_3','437'),(26473,1146,'_page_col_image_3','field_5de6e3998e07e'),(26474,1146,'sec_2_title','Community'),(26475,1146,'_sec_2_title','field_5de6e3ef2798f'),(26476,1146,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(26477,1146,'_sec_2_text','field_5de78dc89e613'),(26478,1146,'sec_3_title','The Project'),(26479,1146,'_sec_3_title','field_5de6e3d37d8da'),(26480,1146,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(26481,1146,'_sec_3_text','field_5de6e4044e5e8'),(26482,1146,'page_col_image_2','436'),(26483,1146,'_page_col_image_2','field_5de6546e7c63a'),(26484,1146,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(26485,1146,'_sec_2_button','field_5de6e58c86706'),(26486,1146,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(26487,1146,'_sec_3_button','field_5de6e5a243c03'),(26488,1146,'page_col_image_4','455'),(26489,1146,'_page_col_image_4','field_5de70801090ce'),(26490,1146,'sec_4_title','Location'),(26491,1146,'_sec_4_title','field_5de7082a12a81'),(26492,1146,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(26493,1146,'_sec_4_text','field_5de7084812a82'),(26494,1146,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(26495,1146,'_sec_4_button','field_5de7085e12a83'),(26496,1146,'news_title','Project updates'),(26497,1146,'_news_title','field_5de78da3aabb9'),(26498,1146,'sec_2_text_copy',''),(26499,1146,'_sec_2_text_copy','field_5de78dc89e613'),(26500,1146,'timeline-title','Timeline'),(26501,1146,'_timeline-title','field_5de78df29e615'),(26502,1146,'timeline_title','Timeline'),(26503,1146,'_timeline_title','field_5de78df29e615'),(26504,1146,'contact_title','Contact us'),(26505,1146,'_contact_title','field_5de7981e06057'),(26506,1146,'contact_intro','Contact text...'),(26507,1146,'_contact_intro','field_5de7983506058'),(26508,1146,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(26509,1146,'_news_button','field_5de8329896e02'),(26510,1146,'timeline_intro','Introduction of timeline detail...'),(26511,1146,'_timeline_intro','field_5de98f5fb1781'),(26512,1146,'timeline_pic','477'),(26513,1146,'_timeline_pic','field_5de98f72b1782'),(26514,1146,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(26515,1146,'_timeline_button','field_5de99363677f8'),(26516,1146,'banner_image_position','center'),(26517,1146,'_banner_image_position','field_5f3bc4757dd02'),(26518,1146,'services_title','Our services'),(26519,1146,'_services_title','field_5f20f3cd80eb2'),(26520,1146,'services_items_0_services_item_image','1061'),(26521,1146,'_services_items_0_services_item_image','field_5f2121355be14'),(26522,1146,'services_items_0_sservices_item_title','1300 Telephone counselling line'),(26523,1146,'_services_items_0_sservices_item_title','field_605089efca82e'),(26524,1146,'services_items_0_services_item_text',''),(26525,1146,'_services_items_0_services_i