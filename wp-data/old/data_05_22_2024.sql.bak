field_5b67c6dd8c066'),(100175,1968,'first_image_title','Lifestart is about supporting young children'),(100176,1968,'_first_image_title','field_5b67ca606afc4'),(100177,1968,'first_image_cont','from 0-24 years living with disabilities and their familes'),(100178,1968,'_first_image_cont','field_5b67caff6afc5'),(100179,1968,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(100180,1968,'_first_image_button','field_5b67cb0d6afc6'),(100181,1968,'second _image_title','Lifestart is about supporting young children'),(100182,1968,'_second _image_title','field_5b67cb20ddf9a'),(100183,1968,'second_image_cont','from 0-24 years living with disabilities and their familes'),(100184,1968,'_second_image_cont','field_5b67cb24ddf9b'),(100185,1968,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(100186,1968,'_second_image_button','field_5b67cb29ddf9c'),(100187,1968,'second_image_title','Lifestart is about supporting young children'),(100188,1968,'_second_image_title','field_5b67cb20ddf9a'),(100189,1968,'page_col_image','412'),(100190,1968,'_page_col_image','field_5de6546e7c63a'),(100191,1968,'page_col_image_3','437'),(100192,1968,'_page_col_image_3','field_5de6e3998e07e'),(100193,1968,'sec_2_title','Community'),(100194,1968,'_sec_2_title','field_5de6e3ef2798f'),(100195,1968,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(100196,1968,'_sec_2_text','field_5de78dc89e613'),(100197,1968,'sec_3_title','The Project'),(100198,1968,'_sec_3_title','field_5de6e3d37d8da'),(100199,1968,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(100200,1968,'_sec_3_text','field_5de6e4044e5e8'),(100201,1968,'page_col_image_2','436'),(100202,1968,'_page_col_image_2','field_5de6546e7c63a'),(100203,1968,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(100204,1968,'_sec_2_button','field_5de6e58c86706'),(100205,1968,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(100206,1968,'_sec_3_button','field_5de6e5a243c03'),(100207,1968,'page_col_image_4','455'),(100208,1968,'_page_col_image_4','field_5de70801090ce'),(100209,1968,'sec_4_title','Location'),(100210,1968,'_sec_4_title','field_5de7082a12a81'),(100211,1968,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(100212,1968,'_sec_4_text','field_5de7084812a82'),(100213,1968,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(100214,1968,'_sec_4_button','field_5de7085e12a83'),(100215,1968,'news_title','Project updates'),(100216,1968,'_news_title','field_5de78da3aabb9'),(100217,1968,'sec_2_text_copy',''),(100218,1968,'_sec_2_text_copy','field_5de78dc89e613'),(100219,1968,'timeline-title','Timeline'),(100220,1968,'_timeline-title','field_5de78df29e615'),(100221,1968,'timeline_title','Timeline'),(100222,1968,'_timeline_title','field_5de78df29e615'),(100223,1968,'contact_title','Contact us'),(100224,1968,'_contact_title','field_5de7981e06057'),(100225,1968,'contact_intro','Contact text...'),(100226,1968,'_contact_intro','field_5de7983506058'),(100227,1968,'news_button','<a class=\"btn btn-home btn-news\" href=\"/u