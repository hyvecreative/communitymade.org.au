970,'_problem_icons_2_prob_concerned_text','field_640fa10181d96'),(102079,1970,'problem_icons_3_prob_concerned_text','Banks are making more than ever from housing'),(102080,1970,'_problem_icons_3_prob_concerned_text','field_640fa10181d96'),(102081,1970,'monitor_content','The Australian Housing Monitor is a large, nationally-representative survey covering public experiences and attitudes toward housing related issues. Questions range from how well the respondent is keeping up with their mortgage/rent, to what they think about social housing construction.\r\n\r\nA broad range of demographic criteria are included, such as gender, location, age, income, voting preference, educational level, tenure type, and employment status. These variables allow CEH researchers to understand the trends and diversity of opinion around the country.\r\n\r\nIt also incorporates questions from previous surveys to track trends over time.\r\nThe inaugural poll was conducted by Essential in December 2022, and was completed by 4,735 people.'),(102082,1970,'_monitor_content','field_640fcc4014404'),(102083,1970,'problem_head','Housing in Australia is not working, and Australians are concerned.'),(102084,1970,'_problem_head','field_641935436aded'),(102085,1970,'problem_signoff','Explore the research showing how concerned Australians are our about the housing situation.'),(102086,1970,'_problem_signoff','field_641935626adee'),(102087,1970,'sections','a:2:{i:0;s:4:\"hero\";i:1;s:9:\"news_grid\";}'),(102088,1970,'_sections','field_5dafb40b8143a'),(102089,1970,'sections_0_is_full_height','1'),(102090,1970,'_sections_0_is_full_height','field_61d6f6fd5a37e'),(102091,1970,'sections_0_image','1648'),(102092,1970,'_sections_0_image','field_61d6f6d45a37d'),(102093,1970,'sections_0_heading','Heading'),(102094,1970,'_sections_0_heading','field_61d6f69e5a379'),(102095,1970,'sections_0_subtitle','Ya ya '),(102096,1970,'_sections_0_subtitle','field_61d6f6ac5a37a'),(102097,1970,'sections_0_link_one',''),(102098,1970,'_sections_0_link_one','field_61d6f6b55a37b'),(102099,1970,'sections_0_link_two',''),(102100,1970,'_sections_0_link_two','field_61d6f6c35a37c'),(102101,1970,'sections_1_select_categories','a:1:{i:0;s:2:\"27\";}'),(102102,1970,'_sections_1_select_categories','field_637f04483b63b'),(102103,1970,'intro_head_major','Super Consumers Australia is <span>fighting</span> to ensure that the superannuation industry is <span>held accountable</span> for the outcomes they deliver to Australian consumers.'),(102104,1970,'_intro_head_major','field_64e828783ad9f'),(102105,1970,'intro_head_minor','We want super to work for everyone—not just super fund companies. With our research, journalism and campaigns we are creating the trustworthy and transparent superannuation system we all deserve.'),(102106,1970,'_intro_head_minor','field_64e8288c3ada0'),(102107,1970,'intro_icons_0_int_icon','1922'),(102108,1970,'_intro_icons_0_int_icon','field_64e828b33ada2'),(102109,1970,'intro_icons_0_int_icon_text','At 1,727,000 square kilometres, we’re 2.5 times the size of Texas. <span>Yeeha!</span>'),(102110,1970,'_intro_icons_0_int_icon_text','field_64e828e33ada3'),(102111,1970,'intro_icons_1_int_icon','1920'),(102112,1970,'_intro_icons_1_int_icon','field_64e828b33ada2'),(102113,1970,'intro_icons_1_int_icon_text','We have twice as many species of native plant and animal as any other Australian state or territory.'),(102114,1970,'_intro_icons_1_int_icon_text','field_64e828e33ada3'),(102115,1970,'intro_icons_2_int_icon','1921'),(102116,1970,'_intro_icons_2_int_icon','field_64e828b33ada2'),(102117,1970,'intro_icons_2_int_icon_text','We have less land classified as ‘protected’ than any other state or territory.'),(102118,1970,'_intro_icons_2_int_icon_text','field_64e828e33ada3'),(102119,1970,'intro_icons','3'),(102120,1970,'_intro_icons','field_64e828963ada1'),(102121,1970,'threat_head_major','What we stand to lose if we don’t act soon to protect beautiful Queensland:'),(102122,1970,'_threat_head_major','field_64ec258d9dbd1'),(102123,1970,'threats_icons','3'),(102124,1970,'_threats_icons','field_64ec2551a93f9'),(102125,1970,'threats_icons_0_thr_icon','1819'),(102126,1970,'_threats_icons_0_thr_icon','field_64ec2551a93fa'),(102127,1970,'threats_icons_0_thr_icon_text','The rich cultural heritage of our First Nations people and their continuous ties to country, dating back more than 50,000 years.'),(102128,1970,'_threats_icons_0_thr_icon_text','field_64ec2551a93fb'),(102129,1970,'threats_icons_1_thr_icon','1819'),(102130,1970,'_threats_icons_1_thr_icon','field_64ec2551a93fa'),(102131,1970,'threats_icons_1_thr_icon_text','Thousands of species of plant and animal which are now classified as threatened or endangered in Queensland.'),(102132,1970,'_threats_icons_1_thr_icon_text','field_64ec2551a93fb'),(102133,1970,'threats_icons_2_thr_icon','1819'),(102134,1970,'_threats_icons_2_thr_icon','field_64ec2551a93fa'),(102135,1970,'threats_icons_2_thr_icon_text','The access to nature that is central to the Queensland way of life.'),(102136,1970,'_threats_icons_2_thr_icon_text','field_64ec2551a93fb'),(102137,1970,'threat_icons_0_thr_icon',''),(102138,1970,'_threat_icons_0_thr_icon','field_64ec2551a93fa'),(102139,1970,'threat_icons_0_thr_icon_text','The <span>rich cultural heritage</span> of our First Nations people and their continuous ties to country, dating back more than 50,000 years.'),(102140,1970,'_threat_icons_0_thr_icon_text','field_64ec2551a93fb'),(102141,1970,'threat_icons_1_thr_icon',''),(102142,1970,'_threat_icons_1_thr_icon','field_64ec2551a93fa'),(102143,1970,'threat_icons_1_thr_icon_text','Thousands of species of plant and animal which are now classified as threatened or endangered in Queensland.'),(102144,1970,'_threat_icons_1_thr_icon_text','field_64ec2551a93fb'),(102145,1970,'threat_icons_2_thr_icon',''),(102146,1970,'_threat_icons_2_thr_icon','field_64ec2551a93fa'),(102147,1970,'threat_icons_2_thr_icon_text','The access to nature that is central to the Quee