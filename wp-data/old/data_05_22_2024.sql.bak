irst_image_button','field_5b67cb0d6afc6'),(58644,1808,'second _image_title','Lifestart is about supporting young children'),(58645,1808,'_second _image_title','field_5b67cb20ddf9a'),(58646,1808,'second_image_cont','from 0-24 years living with disabilities and their familes'),(58647,1808,'_second_image_cont','field_5b67cb24ddf9b'),(58648,1808,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(58649,1808,'_second_image_button','field_5b67cb29ddf9c'),(58650,1808,'second_image_title','Lifestart is about supporting young children'),(58651,1808,'_second_image_title','field_5b67cb20ddf9a'),(58652,1808,'page_col_image','412'),(58653,1808,'_page_col_image','field_5de6546e7c63a'),(58654,1808,'page_col_image_3','437'),(58655,1808,'_page_col_image_3','field_5de6e3998e07e'),(58656,1808,'sec_2_title','Community'),(58657,1808,'_sec_2_title','field_5de6e3ef2798f'),(58658,1808,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(58659,1808,'_sec_2_text','field_5de78dc89e613'),(58660,1808,'sec_3_title','The Project'),(58661,1808,'_sec_3_title','field_5de6e3d37d8da'),(58662,1808,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(58663,1808,'_sec_3_text','field_5de6e4044e5e8'),(58664,1808,'page_col_image_2','436'),(58665,1808,'_page_col_image_2','field_5de6546e7c63a'),(58666,1808,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(58667,1808,'_sec_2_button','field_5de6e58c86706'),(58668,1808,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(58669,1808,'_sec_3_button','field_5de6e5a243c03'),(58670,1808,'page_col_image_4','455'),(58671,1808,'_page_col_image_4','field_5de70801090ce'),(58672,1808,'sec_4_title','Location'),(58673,1808,'_sec_4_title','field_5de7082a12a81'),(58674,1808,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(58675,1808,'_sec_4_text','field_5de7084812a82'),(58676,1808,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(58677,1808,'_sec_4_button','field_5de7085e12a83'),(58678,1808,'news_title','Project updates'),(58679,1808,'_news_title','field_5de78da3aabb9'),(58680,1808,'sec_2_text_copy',''),(58681,1808,'_sec_2_text_copy','field_5de78dc89e613'),(58682,1808,'timeline-title','Timeline'),(58683,1808,'_timeline-title','field_5de78df29e615'),(58684,1808,'timeline_title','Timeline'),(58685,1808,'_timeline_title','field_5de78df29e615'),(58686,1808,'contact_title','Contact us'),(58687,1808,'_contact_title','field_5de7981e06057'),(58688,1808,'contact_intro','Contact text...'),(58689,1808,'_contact_intro','field_5de7983506058'),(58690,1808,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(58691,1808,'_news_button','field_5de8329896e02'),(58692,1808,'timeline_intro','Introduction of timeline detail...'),(58693,1808,'_timeline_intro','field_5de98f5fb1781'),(58694,1808,'timeline_pic','477'),(58695,1808,'_timeline_pic','field_5de98f72b1782'),(58696,1808,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(58697,1808,'_timeline_button','field_5de99363677f8'),(5869