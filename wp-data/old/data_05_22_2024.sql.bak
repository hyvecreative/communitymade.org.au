7cb0d6afc6'),(40583,1533,'second _image_title','Lifestart is about supporting young children'),(40584,1533,'_second _image_title','field_5b67cb20ddf9a'),(40585,1533,'second_image_cont','from 0-24 years living with disabilities and their familes'),(40586,1533,'_second_image_cont','field_5b67cb24ddf9b'),(40587,1533,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(40588,1533,'_second_image_button','field_5b67cb29ddf9c'),(40589,1533,'second_image_title','Lifestart is about supporting young children'),(40590,1533,'_second_image_title','field_5b67cb20ddf9a'),(40591,1533,'page_col_image','412'),(40592,1533,'_page_col_image','field_5de6546e7c63a'),(40593,1533,'page_col_image_3','437'),(40594,1533,'_page_col_image_3','field_5de6e3998e07e'),(40595,1533,'sec_2_title','Community'),(40596,1533,'_sec_2_title','field_5de6e3ef2798f'),(40597,1533,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(40598,1533,'_sec_2_text','field_5de78dc89e613'),(40599,1533,'sec_3_title','The Project'),(40600,1533,'_sec_3_title','field_5de6e3d37d8da'),(40601,1533,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(40602,1533,'_sec_3_text','field_5de6e4044e5e8'),(40603,1533,'page_col_image_2','436'),(40604,1533,'_page_col_image_2','field_5de6546e7c63a'),(40605,1533,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(40606,1533,'_sec_2_button','field_5de6e58c86706'),(40607,1533,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(40608,1533,'_sec_3_button','field_5de6e5a243c03'),(40609,1533,'page_col_image_4','455'),(40610,1533,'_page_col_image_4','field_5de70801090ce'),(40611,1533,'sec_4_title','Location'),(40612,1533,'_sec_4_title','field_5de7082a12a81'),(40613,1533,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(40614,1533,'_sec_4_text','field_5de7084812a82'),(40615,1533,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(40616,1533,'_sec_4_button','field_5de7085e12a83'),(40617,1533,'news_title','Project updates'),(40618,1533,'_news_title','field_5de78da3aabb9'),(40619,1533,'sec_2_text_copy',''),(40620,1533,'_sec_2_text_copy','field_5de78dc89e613'),(40621,1533,'timeline-title','Timeline'),(40622,1533,'_timeline-title','field_5de78df29e615'),(40623,1533,'timeline_title','Timeline'),(40624,1533,'_timeline_title','field_5de78df29e615'),(40625,1533,'contact_title','Contact us'),(40626,1533,'_contact_title','field_5de7981e06057'),(40627,1533,'contact_intro','Contact text...'),(40628,1533,'_contact_intro','field_5de7983506058'),(40629,1533,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(40630,1533,'_news_button','field_5de8329896e02'),(40631,1533,'timeline_intro','Introduction of timeline detail...'),(40632,1533,'_timeline_intro','field_5de98f5fb1781'),(40633,1533,'timeline_pic','477'),(40634,1533,'_timeline_pic','field_5de98f72b1782'),(40635,1533,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(40636,1533,'_timeline_button','field_5de99363677f8'),(40637,1533,'banner_image_position