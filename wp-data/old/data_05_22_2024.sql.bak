2,2156,'_report_link_url','field_62f30ef4b57e3'),(118863,2156,'report_link_text','Download'),(118864,2156,'_report_link_text','field_62f30f01b57e4'),(118865,2156,'solutions_content','The housing system is complex, and no one solution will solve the complex problems we now face but there are some critical first steps to be taken now.\r\n<ul>\r\n 	<li>Set out an ambitious national housing agreement between commonwealth and state governments with targets and funding for the construction of affordable homes.</li>\r\n 	<li>Phase out tax breaks for property investors and using the increase in revenue to build more public housing.</li>\r\n 	<li>Establish laws which limit rental increases beyond what is fair.</li>\r\n 	<li>Rebalance tenancy laws to provide renters with more security and control, such as eliminating no grounds evictions.</li>\r\n 	<li>Phase out stamp duty and replace it with a broad-based land tax.</li>\r\n</ul>\r\n<h4>While there are many opinions on what policy changes will fix the housing market, doing nothing is not an option.</h4>'),(118866,2156,'_solutions_content','field_640e8b307a958'),(118867,2156,'problem_icons_0_prob_icon','1699'),(118868,2156,'_problem_icons_0_prob_icon','field_640fa0291d519'),(118869,2156,'problem_icons_0_prob_concerned_stat','70% highly concerned'),(118870,2156,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(118871,2156,'problem_icons_0_prob_concerded_text','are highly concerned'),(118872,2156,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(118873,2156,'problem_icons_0_prob_issue_text',''),(118874,2156,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(118875,2156,'problem_icons','4'),(118876,2156,'_problem_icons','field_640fa0191d518'),(118877,2156,'ceh_content_left',''),(118878,2156,'_ceh_content_left','field_640e97e8f1c8c'),(118879,2156,'ceh_content_right',''),(118880,2156,'_ceh_content_right','field_640e97fdf1c8d'),(118881,2156,'pc_content_left',''),(118882,2156,'_pc_content_left','field_640e983bf1c8f'),(118883,2156,'pc_content_right',''),(118884,2156,'_pc_content_right','field_640e984df1c90'),(118885,2156,'problem_icons_1_prob_icon','1699'),(118886,2156,'_problem_icons_1_prob_icon','field_640fa0291d519'),(118887,2156,'problem_icons_1_prob_concerned_stat','69% highly concerned'),(118888,2156,'_problem_icons_1_prob_concerned_stat','field_640fa0dd81d95'),(118889,2156,'problem_icons_1_prob_concerded_text','are highly concerned'),(118890,2156,'_problem_icons_1_prob_concerded_text','field_640fa10181d96'),(118891,2156,'problem_icons_1_prob_issue_text',''),(118892,2156,'_problem_icons_1_prob_issue_text','field_640fa11a81d97'),(118893,2156,'problem_icons_2_prob_icon','1699'),(118894,2156,'_problem_icons_2_prob_icon','field_640fa0291d519'),(118895,2156,'problem_icons_2_prob_concerned_stat','64% highly concerned'),(118896,2156,'_problem_icons_2_prob_concerned_stat','field_640fa0dd81d95'),(118897,2156,'problem_icons_2_prob_concerded_text','are highly concerned'),(118898,2156,'_problem_icons_2_prob_concerded_text','field_640fa10181d96'),(118899,2156,'problem_icons_2_prob_issue_text',''),(118900,2156,'_problem_icons_2_prob_issue_text','field_640fa11a81d97'),(118901,2156,'problem_icons_3_prob_icon','1699'),(118902,2156,'_problem_icons_3_prob_icon','field_640fa0291d519'),(118903,2156,'problem_icons_3_prob_concerned_stat','64% highly concerned'),(118904,2156,'_problem_icons_3_prob_concerned_stat','field_640fa0dd81d95'),(118905,2156,'problem_icons_3_prob_concerded_text','are highly concerned'),(118906,2156,'_problem_icons_3_prob_concerded_text','field_640fa10181d96'),(118907,2156,'problem_icons_3_prob_issue_text',''),(118908,2156,'_problem_icons_3_prob_issue_text','field_640fa11a81d97'),(118909,2156,'problem_icons_0_prob_concerned_text','House prices have doubled in a decade'),(118910,2156,'_problem_icons_0_prob_concerned_text','field_640fa10181d96'),(118911,2156,'problem_icons_1_prob_concerned_text','The gap between rich and poor is growing'),(118912,2156,'_problem_icons_1_prob_concerned_text','field_640fa10181d96'),(118913,2156,'problem_icons_2_prob_concerned_text','Construction of social housing is down'),(118914,2156,'_problem_icons_2_prob_concerned_text','field_640fa10181d96'),(118915,2156,'problem_icons_3_prob_concerned_text','Banks are making more than ever from housing'),(118916,2156,'_problem_icons_3_prob_concerned_text','field_640fa10181d96'),(118917,2156,'monitor_content','The Australian Housing Monitor is a large, nationally-representative survey covering public experiences and attitudes toward housing related issues. Questions range from how well the respondent is keeping up with their mortgage/rent, to what they think about social housing construction.\r\n\r\nA broad range of demographic criteria are included, such as gender, location, age, income, voting preference, educational level, tenure type, and employment status. These variables allow CEH researchers to understand the trends and diversity of opinion around the country.\r\n\r\nIt also incorporates questions from previous surveys to track trends over time.\r\nThe inaugural poll was conducted by Essential in December 2022, and was completed by 4,735 people.'),(118918,2156,'_monitor_content','field_640fcc4014404'),(118919,2156,'problem_head','Housing in Australia is not working, and Australians are concerned.'),(118920,2156,'_problem_head','field_641935436aded'),(118921,2156,'problem_signoff','Explore the research showing how concerned Australians are our about the housing situation.'),(118922,2156,'_problem_signoff','field_641935626adee'),(118923,2156,'sections','a:2:{i:0;s:4:\"hero\";i:1;s:9:\"news_grid\";}'),(118924,2156,'_sections','field_5dafb40b8143a'),(118925,2156,'sections_0_is_full_height','1'),(118926,2156,'_sections_0_is_full_height','field_61d6f6fd5a37e'),(118927,2156,'sections_0_image','1648'),(118928,2156,'_sections_0_image','field_61d6f6d45a37d'),(118929,2156,'sections_0_heading','Heading'),(118930,2156,'_sections_0_heading','field_61d6f69e5a379'),(118931,2156,'sections_0_subtitle','Ya ya '),(118932,2156,'_sections_0_subtitle','field_61d6f6ac5a37a'),(118933,2156,'sections_0_link_one',''),(118934,2156,'_sections_0_link_one','field_61d6f6b55a37b'),(118935,2156,'sections_0_link_two',''),(118936,2156,'_sections_0_link_two','field_61d6f6c35a37c'),(118937,2156,'sections_1_select_categories','a:1:{i:0;s:2:\"27\";}'),(118938,2156,'_sections_1_select_categories','field_637f04483b63b'),(118939,2156,'intro_head_major','Super Consumers Australia is <span>fighting</span> to ensure that the superannuation industry is <span>held accountable</span> for the outcomes they deliver to Australian consumers.'),(118940,2156,'_intro_head_major','field_64e828783ad9f'),(118941,2156,'intro_head_minor','We want super to work for everyone—not just super fund companies. With our research, journalism and campaigns we are creating the trustworthy and transparent superannuation system we all deserve.'),(118942,2156,'_intro_head_minor','field_64e8288c3ada0'),(118943,2156,'intro_icons_0_int_icon','1922'),(118944,2156,'_intro_icons_0_int_icon','field_64e828b33ada2'),(118945,2156,'intro_icons_0_int_icon_text','At 1,727,000 square kilometres, we’re 2.5 times the size of Texas. <span>Yeeha!</span>'),(118946,2156,'_intro_icons_0_int_icon_text','field_64e828e33ada3'),(118947,2156,'intro_icons_1_int_icon','1920'),(118948,2156,'_intro_icons_1_int_icon','field_64e828b33ada2'),(118949,2156,'intro_icons_1_int_icon_text','We have twice as many species of native plant and animal as any other Australian state or territory.'),(118950,2156,'_intro_icons_1_int_icon_text','field_64e828e33ada3'),(118951,2156,'intro_icons_2_int_icon','1921'),(118952,2156,'_intro_icons_2_int_icon','field_64e828b33ada2'),(118953,2156,'intro_icons_2_int_icon_text','We have less land classified as ‘protected’ than any other state or territory.'),(118954,2156,'_intro_icons_2_int_icon_text','field_64e828e33ada3'),(118955,2156,'intro_icons','3'),(118956,2156,'_intro_icons','field_64e828963ada1'),(118957,2156,'threat_head_major','What we stand to lose if we don’t act soon to protect beautiful Queensland:'),(118958,2156,'_threat_head_major','field_64ec258d9dbd1'),(118959,2156,'threats_icons','3'),(118960,2156,'_threats_icons','field_64ec2551a93f9'),(118961,2156,'threats_icons_0_thr_icon','1819'),(118962,2156,'_threats_icons_0_thr_icon','field_64ec2551a93fa'),(118963,2156,'threats_icons_0_thr_icon_text','The rich cultural heritage of our First Nations people and their continuous ties to country, dating back more than 50,000 years.'),(118964,2156,'_threats_icons_0_thr_icon_text','field_64ec2551a93fb'),(118965,2156,'threats_icons_1_thr_icon','1819'),(118966,2156,'_threats_icons_1_thr_icon','field_64ec2551a93fa'),(118967,2156,'threats_icons_1_thr_icon_text','Thousands of species of plant and animal which are now classified as threatened or endangered in Queensland.'),(118968,2156,'_threats_icons_1_thr_icon_text','field_64ec2551a93fb'),(118969,2156,'threats_icons_2_thr_icon','1819'),(118970,2156,'_threats_icons_2_thr_icon','field_64ec2551a93fa'),(118971,2156,'threats_icons_2_thr_icon_text','The access to nature that is central to the Queensland way of life.'),(118972,2156,'_threats_icons_2_thr_icon_text','field_64ec2551a93fb'),(118973,2156,'threat_icons_0_thr_icon',''),(118974,2156,'_threat_icons_0_thr_icon','field_64ec2551a93fa'),(118975,2156,'threat_icons_0_thr_icon_text','The <span>rich cultural heritage</span> of our First Nations people and their continuous ties to country, dating back more than 50,000 years.'),(118976,2156,'_threat_icons_0_thr_icon_text','field_64ec2551a93fb'),(118977,2156,'threat_icons_1_thr_icon',''),(118978,2156,'_threat_icons_1_thr_icon','field_64ec2551a93fa'),(118979,2156,'threat_icons_1_thr_icon_text','Thousands of species of plant and animal which are now classified as threatened or endangered in Queensland.'),(118980,2156,'_threat_icons_1_thr_icon_text','field_64ec2551a93fb'),(118981,2156,'threat_icons_2_thr_icon','')