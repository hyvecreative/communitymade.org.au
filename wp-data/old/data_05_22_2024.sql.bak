02,'support_right_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut.'),(113855,2102,'_support_right_cont','field_5b67c6c98c065'),(113856,2102,'support_right_button','<a class=\"btn btn-blue\" href=\"#\">Read more</a>'),(113857,2102,'_support_right_button','field_5b67c6dd8c066'),(113858,2102,'first_image_title','Lifestart is about supporting young children'),(113859,2102,'_first_image_title','field_5b67ca606afc4'),(113860,2102,'first_image_cont','from 0-24 years living with disabilities and their familes'),(113861,2102,'_first_image_cont','field_5b67caff6afc5'),(113862,2102,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(113863,2102,'_first_image_button','field_5b67cb0d6afc6'),(113864,2102,'second _image_title','Lifestart is about supporting young children'),(113865,2102,'_second _image_title','field_5b67cb20ddf9a'),(113866,2102,'second_image_cont','from 0-24 years living with disabilities and their familes'),(113867,2102,'_second_image_cont','field_5b67cb24ddf9b'),(113868,2102,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(113869,2102,'_second_image_button','field_5b67cb29ddf9c'),(113870,2102,'second_image_title','Lifestart is about supporting young children'),(113871,2102,'_second_image_title','field_5b67cb20ddf9a'),(113872,2102,'page_col_image','412'),(113873,2102,'_page_col_image','field_5de6546e7c63a'),(113874,2102,'page_col_image_3','437'),(113875,2102,'_page_col_image_3','field_5de6e3998e07e'),(113876,2102,'sec_2_title','Community'),(113877,2102,'_sec_2_title','field_5de6e3ef2798f'),(113878,2102,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(113879,2102,'_sec_2_text','field_5de78dc89e613'),(113880,2102,'sec_3_title','The Project'),(113881,2102,'_sec_3_title','field_5de6e3d37d8da'),(113882,2102,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(113883,2102,'_sec_3_text','field_5de6e4044e5e8'),(113884,2102,'page_col_image_2','436'),(113885,2102,'_page_col_image_2','field_5de6546e7c63a'),(113886,2102,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(113887,2102,'_sec_2_button','field_5de6e58c86706'),(113888,2102,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(113889,2102,'_sec_3_button','field_5de6e5a243c03'),(113890,2102,'page_col_image_4','455'),(113891,2102,'_page_col_image_4','field_5de70801090ce'),(113892,2102,'sec_4_title','Location'),(113893,2102,'_sec_4_title','field_5de7082a12a81'),(113894,2102,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(113895,2102,'_sec_4_text','field_5de7084812a82'),(113896,2102,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(113897,2102,'_sec_4_button','field_5de7085e12a83'),(113898,2102,'news_title','Project updates'),(113899,2102,'_news_title','field_5de78da3aabb9'),(113900,2102,'sec_2_text_copy',''),(113901,2102,'_sec_2_text_copy','field_5de78dc89e613'),(113902,2102,'timeline-title','Timeline'),(113903,2102,'_timeline-title','field_5de78df29e615'),(113904,2102,'timeline_title','Timeline'),(113905,