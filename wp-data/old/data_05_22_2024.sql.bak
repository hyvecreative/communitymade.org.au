30,1954,'second_image_cont','from 0-24 years living with disabilities and their familes'),(95331,1954,'_second_image_cont','field_5b67cb24ddf9b'),(95332,1954,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(95333,1954,'_second_image_button','field_5b67cb29ddf9c'),(95334,1954,'second_image_title','Lifestart is about supporting young children'),(95335,1954,'_second_image_title','field_5b67cb20ddf9a'),(95336,1954,'page_col_image','412'),(95337,1954,'_page_col_image','field_5de6546e7c63a'),(95338,1954,'page_col_image_3','437'),(95339,1954,'_page_col_image_3','field_5de6e3998e07e'),(95340,1954,'sec_2_title','Community'),(95341,1954,'_sec_2_title','field_5de6e3ef2798f'),(95342,1954,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(95343,1954,'_sec_2_text','field_5de78dc89e613'),(95344,1954,'sec_3_title','The Project'),(95345,1954,'_sec_3_title','field_5de6e3d37d8da'),(95346,1954,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(95347,1954,'_sec_3_text','field_5de6e4044e5e8'),(95348,1954,'page_col_image_2','436'),(95349,1954,'_page_col_image_2','field_5de6546e7c63a'),(95350,1954,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(95351,1954,'_sec_2_button','field_5de6e58c86706'),(95352,1954,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(95353,1954,'_sec_3_button','field_5de6e5a243c03'),(95354,1954,'page_col_image_4','455'),(95355,1954,'_page_col_image_4','field_5de70801090ce'),(95356,1954,'sec_4_title','Location'),(95357,1954,'_sec_4_title','field_5de7082a12a81'),(95358,1954,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(95359,1954,'_sec_4_text','field_5de7084812a82'),(95360,1954,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(95361,1954,'_sec_4_button','field_5de7085e12a83'),(95362,1954,'news_title','Project updates'),(95363,1954,'_news_title','field_5de78da3aabb9'),(95364,1954,'sec_2_text_copy',''),(95365,1954,'_sec_2_text_copy','field_5de78dc89e613'),(95366,1954,'timeline-title','Timeline'),(95367,1954,'_timeline-title','field_5de78df29e615'),(95368,1954,'timeline_title','Timeline'),(95369,1954,'_timeline_title','field_5de78df29e615'),(95370,1954,'contact_title','Contact us'),(95371,1954,'_contact_title','field_5de7981e06057'),(95372,1954,'contact_intro','Contact text...'),(95373,1954,'_contact_intro','field_5de7983506058'),(95374,1954,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(95375,1954,'_news_button','field_5de8329896e02'),(95376,1954,'timeline_intro','Introduction of timeline detail...'),(95377,1954,'_timeline_intro','field_5de98f5fb1781'),(95378,1954,'timeline_pic','477'),(95379,1954,'_timeline_pic','field_5de98f72b1782'),(95380,1954,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(95381,1954,'_timeline_button','field_5de99363677f8'),(95382,1954,'banner_image_position','center'),(95383,1954,'_banner_image_position','field_5f3bc4757dd02'),(95384,1954,'services_title','Our services'),(95385,1954,'_services_title','field_5f2