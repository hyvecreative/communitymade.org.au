31,1946,'_survey_index_7_survey_url_text','field_629456584223a'),(94332,1946,'survey_index','8'),(94333,1946,'_survey_index','field_6294561242236'),(94334,1946,'report_title','Download the report'),(94335,1946,'_report_title','field_62f30edfb57e1'),(94336,1946,'report_intro','Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus massa erat, consectetur at semper at, feugiat vel orci. '),(94337,1946,'_report_intro','field_62f30eedb57e2'),(94338,1946,'report_link_url','#'),(94339,1946,'_report_link_url','field_62f30ef4b57e3'),(94340,1946,'report_link_text','Download'),(94341,1946,'_report_link_text','field_62f30f01b57e4'),(94342,1946,'solutions_content','The housing system is complex, and no one solution will solve the complex problems we now face but there are some critical first steps to be taken now.\r\n<ul>\r\n 	<li>Set out an ambitious national housing agreement between commonwealth and state governments with targets and funding for the construction of affordable homes.</li>\r\n 	<li>Phase out tax breaks for property investors and using the increase in revenue to build more public housing.</li>\r\n 	<li>Establish laws which limit rental increases beyond what is fair.</li>\r\n 	<li>Rebalance tenancy laws to provide renters with more security and control, such as eliminating no grounds evictions.</li>\r\n 	<li>Phase out stamp duty and replace it with a broad-based land tax.</li>\r\n</ul>\r\n<h4>While there are many opinions on what policy changes will fix the housing market, doing nothing is not an option.</h4>'),(94343,1946,'_solutions_content','field_640e8b307a958'),(94344,1946,'problem_icons_0_prob_icon','1699'),(94345,1946,'_problem_icons_0_prob_icon','field_640fa0291d519'),(94346,1946,'problem_icons_0_prob_concerned_stat','70% highly concerned'),(94347,1946,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(94348,1946,'problem_icons_0_prob_concerded_text','are highly concerned'),(94349,1946,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(94350,1946,'problem_icons_0_prob_issue_text',''),(94351,1946,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(94352,1946,'problem_icons','4'),(94353,1946,'_problem_icons','field_640fa0191d518'),(94354,1946,'ceh_content_left',''),(94355,1946,'_ceh_content_left','field_640e97e8f1c8c'),(94356,1946,'ceh_content_right',''),(94357,1946,'_ceh_content_right','field_640e97fdf1c8d'),(94358,1946,'pc_content_left',''),(94359,1946,'_pc_content_left','field_640e983bf1c8f'),(94360,1946,'pc_content_right',''),(94361,1946,'_pc_content_right','field_640e984df1c90'),(94362,1946,'problem_icons_1_prob_icon','1699'),(94363,1946,'_problem_icons_1_prob_icon','field_640fa0291d519'),(94364,1946,'problem_icons_1_prob_concerned_stat','69% highly concerned'),(94365,1946,'_problem_icons_1_prob_concerned_stat','field_640fa0dd81d95'),(94366,1946,'problem_icons_1_prob_concerded_text','are highly concerned'),(94367,1946,'_problem_icons_1_prob_concerded_text','field_640fa10181d96'),(94368,1946,'problem_icons_1_prob_issue_text',''),(94369,1946,'_problem_icons_1_prob_issue_text','field_640fa11a81d97'),(94370,1946,'problem_icons_2_prob_icon','1699'),(94371,1946,'_problem_icons_2_prob_icon','field_640fa0291d519'),(94372,1946,'problem_icons_2_prob_concerned_stat','64% highly concerned'),(94373,1946,'_problem_icons_2_prob_concerned_stat','field_640fa0dd81d95'),(94374,1946,'problem_icons_2_prob_concerded_text','are highly concerned'),(94375,1946,'_problem_icons_2_prob_concerded_text','field_640fa10181d96'),(94376,1946,'problem_icons_2_prob_issue_text',''),(94377,1946,'_problem_icons_2_prob_issue_text','field_640fa11a81d97'),(94378,1946,'problem_icons_3_prob_icon','1699'),(94379,1946,'_problem_icons_3_prob_icon','field_640fa0291d519'),(94380,1946,'problem_icons_3_prob_concerned_stat','64% highly concerned'),(94381,1946,'_problem_icons_3_prob_concerned_stat','field_640fa0dd81d95'),(94382,1946,'problem_icons_3_prob_concerded_text','are highly concerned'),(94383,1946,'_problem_icons_3_prob_concerded_text','field_640fa10181d96'),(94384,1946,'problem_icons_3_prob_issue_text',''),(94385,1946,'_problem_icons_3_prob_issue_text','field_640fa11a81d97'),(94386,1946,'problem_icons_0_prob_concerned_text','House prices have doubled in a decade'),(94387,1946,'_problem_icons_0_prob_concerned_text','field_640fa10181d96'),(94388,1946,'problem_icons_1_prob_concerned_text','The gap between rich and poor is growing'),(94389,1946,'_problem_icons_1_prob_concerned_text','field_640fa10181d96'),(94390,1946,'problem_icons_2_prob_concerned_text','Construction of social housing is down'),(94391,1946,'_problem_icons_2_prob_concerned_text','field_640fa10181d96'),(94392,1946,'problem_icons_3_prob_concerned_text','Banks are making more than ever from housing'),(94393,1946,'_problem_icons_3_prob_concerned_text','field_640fa10181d96'),(94394,1946,'monitor_content','The Australian Housing Monitor is a large, nationally-representative survey covering public experiences and attitudes toward housing related issues. Questions range from how well the respondent is keeping up with their mortgage/rent, to what they think about social housing construction.\r\n\r\nA broad range of demographic criteria are included, such as gender, location, age, income, voting preference, educational level, tenure type, and employment status. These variables allow CEH researchers to understand the trends and diversity of opinion around the country.\r\n\r\nIt also incorporates questions from previous surveys to track trends over time.\r\nThe inaugural poll was conducted by Essential in December 2022, and was completed by 4,735 people.'),(94395,1946,'_monitor_content','field_640fcc4014404'),(94396,1946,'problem_head','Housing in Australia is not working, and Australians are concerned.'),(94397,1946,'_problem_head','field_641935436aded'),(94398,1946,'problem_signoff','Explore the research showing how concerned Australians are our about the housing situation.'),(94399,1946,'_problem_signoff','field_641935626adee'),(94400,1946,'sections','a:2:{i:0;s:4:\"hero\";i:1;s:9:\"news_grid\";}'),(94401,1946,'_sections','field_5dafb40b8143a'),(94402,1946,'sections_0_is_full_height','1'),(94403,1946,'_sections_0_is_full_height','field_61d6f6fd5a37e'),(94404,1946,'sections_0_image','1648'),(94405,1946,'_sections_0_image','field_61d6f6d45a37d'),(94406,1946,'sections_0_heading','Heading'),(94407,1946,'_sections_0_heading','field_61d6f69e5a379'),(94408,1946,'sections_0_subtitle','Ya ya '),(94409,1946,'_sections_0_subtitle','field_61d6f6ac5a37a'),(94410,1946,'sections_0_link_one',''),(94411,1946,'_sections_0_link_one','field_61d6f6b55a37b'),(94412,1946,'sections_0_link_two',''),(94413,1946,'_sections_0_link_two','field_61d6f6c35a37c'),(94414,1946,'sections_1_select_categories','a:1:{i:0;s:2:\"27\";}'),(94415,1946,'_sections_1_select_categories','field_637f04483b63b'),(94416,1946,'intro_head_major','Super Consumers Australia is <span>fighting</span> to ensure that the superannuation industry is <span>held accountable</span> for the outcomes they deliver to Australian consumers.'),(94417,1946,'_intro_head_major','field_64e828783ad9f'),(94418,1946,'intro_head_minor','We want super to work for everyone—not just super fund companies. With our research, journalism and campaigns we are creating the trustworthy and transparent superannuation system we all deserve.'),(94419,1946,'_intro_head_minor','field_64e8288c3ada0'),(94420,1946,'intro_icons_0_int_icon','1922'),(94421,1946,'_intro_icons_0_int_icon','field_64e828b33ada2'),(94422,1946,'intro_icons_0_int_icon_text','At 1,727,000 square kilometres, we’re 2.5 times the size of Texas. <span>Yeeha!</span>'),(94423,1946,'_intro_icons_0_int_icon_text','field_64e828e33ada3'),(94424,1946,'intro_icons_1_int_icon','1920'),(94425,1946,'_intro_icons_1_int_icon','field_64e828b33ada2'),(94426,1946,'intro_icons_1_int_icon_text','We have twice as many species of native plant and animal as any other Australian state or territory.'),(94427,1946,'_intro_icons_1