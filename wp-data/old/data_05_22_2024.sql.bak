ond_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(19768,1088,'_second_image_button','field_5b67cb29ddf9c'),(19769,1088,'second_image_title','Lifestart is about supporting young children'),(19770,1088,'_second_image_title','field_5b67cb20ddf9a'),(19771,1088,'page_col_image','412'),(19772,1088,'_page_col_image','field_5de6546e7c63a'),(19773,1088,'page_col_image_3','437'),(19774,1088,'_page_col_image_3','field_5de6e3998e07e'),(19775,1088,'sec_2_title','Community'),(19776,1088,'_sec_2_title','field_5de6e3ef2798f'),(19777,1088,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(19778,1088,'_sec_2_text','field_5de78dc89e613'),(19779,1088,'sec_3_title','The Project'),(19780,1088,'_sec_3_title','field_5de6e3d37d8da'),(19781,1088,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(19782,1088,'_sec_3_text','field_5de6e4044e5e8'),(19783,1088,'page_col_image_2','436'),(19784,1088,'_page_col_image_2','field_5de6546e7c63a'),(19785,1088,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(19786,1088,'_sec_2_button','field_5de6e58c86706'),(19787,1088,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(19788,1088,'_sec_3_button','field_5de6e5a243c03'),(19789,1088,'page_col_image_4','455'),(19790,1088,'_page_col_image_4','field_5de70801090ce'),(19791,1088,'sec_4_title','Location'),(19792,1088,'_sec_4_title','field_5de7082a12a81'),(19793,1088,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(19794,1088,'_sec_4_text','field_5de7084812a82'),(19795,1088,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(19796,1088,'_sec_4_button','field_5de7085e12a83'),(19797,1088,'news_title','Project updates'),(19798,1088,'_news_title','field_5de78da3aabb9'),(19799,1088,'sec_2_text_copy',''),(19800,1088,'_sec_2_text_copy','field_5de78dc89e613'),(19801,1088,'timeline-title','Timeline'),(19802,1088,'_timeline-title','field_5de78df29e615'),(19803,1088,'timeline_title','Timeline'),(19804,1088,'_timeline_title','field_5de78df29e615'),(19805,1088,'contact_title','Contact us'),(19806,1088,'_contact_title','field_5de7981e06057'),(19807,1088,'contact_intro','Contact text...'),(19808,1088,'_contact_intro','field_5de7983506058'),(19809,1088,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(19810,1088,'_news_button','field_5de8329896e02'),(19811,1088,'timeline_intro','Introduction of timeline detail...'),(19812,1088,'_timeline_intro','field_5de98f5fb1781'),(19813,1088,'timeline_pic','477'),(19814,1088,'_timeline_pic','field_5de98f72b1782'),(19815,1088,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(19816,1088,'_timeline_button','field_5de99363677f8'),(19817,1088,'banner_image_position','center'),(19818,1088,'_banner_image_position','field_5f3bc4757dd02'),(19819,1088,'services_title','Our services'),(19820,1088,'_services_title','field_5f20f3cd80eb2'),(19821,1088,'services_items_0_services_item_image','1061'),(19822,1088,'_services_items_0_services_item_image','field_5f2121355be14'),(19823,1088,'se