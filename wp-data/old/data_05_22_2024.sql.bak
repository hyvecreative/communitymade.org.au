itle','field_5b67cb20ddf9a'),(85784,1924,'second_image_cont','from 0-24 years living with disabilities and their familes'),(85785,1924,'_second_image_cont','field_5b67cb24ddf9b'),(85786,1924,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(85787,1924,'_second_image_button','field_5b67cb29ddf9c'),(85788,1924,'second_image_title','Lifestart is about supporting young children'),(85789,1924,'_second_image_title','field_5b67cb20ddf9a'),(85790,1924,'page_col_image','412'),(85791,1924,'_page_col_image','field_5de6546e7c63a'),(85792,1924,'page_col_image_3','437'),(85793,1924,'_page_col_image_3','field_5de6e3998e07e'),(85794,1924,'sec_2_title','Community'),(85795,1924,'_sec_2_title','field_5de6e3ef2798f'),(85796,1924,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(85797,1924,'_sec_2_text','field_5de78dc89e613'),(85798,1924,'sec_3_title','The Project'),(85799,1924,'_sec_3_title','field_5de6e3d37d8da'),(85800,1924,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(85801,1924,'_sec_3_text','field_5de6e4044e5e8'),(85802,1924,'page_col_image_2','436'),(85803,1924,'_page_col_image_2','field_5de6546e7c63a'),(85804,1924,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(85805,1924,'_sec_2_button','field_5de6e58c86706'),(85806,1924,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(85807,1924,'_sec_3_button','field_5de6e5a243c03'),(85808,1924,'page_col_image_4','455'),(85809,1924,'_page_col_image_4','field_5de70801090ce'),(85810,1924,'sec_4_title','Location'),(85811,1924,'_sec_4_title','field_5de7082a12a81'),(85812,1924,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(85813,1924,'_sec_4_text','field_5de7084812a82'),(85814,1924,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(85815,1924,'_sec_4_button','field_5de7085e12a83'),(85816,1924,'news_title','Project updates'),(85817,1924,'_news_title','field_5de78da3aabb9'),(85818,1924,'sec_2_text_copy',''),(85819,1924,'_sec_2_text_copy','field_5de78dc89e613'),(85820,1924,'timeline-title','Timeline'),(85821,1924,'_timeline-title','field_5de78df29e615'),(85822,1924,'timeline_title','Timeline'),(85823,1924,'_timeline_title','field_5de78df29e615'),(85824,1924,'contact_title','Contact us'),(85825,1924,'_contact_title','field_5de7981e06057'),(85826,1924,'contact_intro','Contact text...'),(85827,1924,'_contact_intro','field_5de7983506058'),(85828,1924,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(85829,1924,'_news_button','field_5de8329896e02'),(85830,1924,'timeline_intro','Introduction of timeline detail...'),(85831,1924,'_timeline_intro','field_5de98f5fb1781'),(85832,1924,'timeline_pic','477'),(85833,1924,'_timeline_pic','field_5de98f72b1782'),(85834,1924,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(85835,1924,'_timeline_button','field_5de99363677f8'),(85836,1924,'banner_image_position','center'),(85837,1924,'_banner_image_position','field_5f3bc4757dd02'),(85838,1924,'services_title','Our services'),(85839,