_image_button','field_5b67cb29ddf9c'),(56960,1791,'second_image_title','Lifestart is about supporting young children'),(56961,1791,'_second_image_title','field_5b67cb20ddf9a'),(56962,1791,'page_col_image','412'),(56963,1791,'_page_col_image','field_5de6546e7c63a'),(56964,1791,'page_col_image_3','437'),(56965,1791,'_page_col_image_3','field_5de6e3998e07e'),(56966,1791,'sec_2_title','Community'),(56967,1791,'_sec_2_title','field_5de6e3ef2798f'),(56968,1791,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(56969,1791,'_sec_2_text','field_5de78dc89e613'),(56970,1791,'sec_3_title','The Project'),(56971,1791,'_sec_3_title','field_5de6e3d37d8da'),(56972,1791,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(56973,1791,'_sec_3_text','field_5de6e4044e5e8'),(56974,1791,'page_col_image_2','436'),(56975,1791,'_page_col_image_2','field_5de6546e7c63a'),(56976,1791,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(56977,1791,'_sec_2_button','field_5de6e58c86706'),(56978,1791,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(56979,1791,'_sec_3_button','field_5de6e5a243c03'),(56980,1791,'page_col_image_4','455'),(56981,1791,'_page_col_image_4','field_5de70801090ce'),(56982,1791,'sec_4_title','Location'),(56983,1791,'_sec_4_title','field_5de7082a12a81'),(56984,1791,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(56985,1791,'_sec_4_text','field_5de7084812a82'),(56986,1791,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(56987,1791,'_sec_4_button','field_5de7085e12a83'),(56988,1791,'news_title','Project updates'),(56989,1791,'_news_title','field_5de78da3aabb9'),(56990,1791,'sec_2_text_copy',''),(56991,1791,'_sec_2_text_copy','field_5de78dc89e613'),(56992,1791,'timeline-title','Timeline'),(56993,1791,'_timeline-title','field_5de78df29e615'),(56994,1791,'timeline_title','Timeline'),(56995,1791,'_timeline_title','field_5de78df29e615'),(56996,1791,'contact_title','Contact us'),(56997,1791,'_contact_title','field_5de7981e06057'),(56998,1791,'contact_intro','Contact text...'),(56999,1791,'_contact_intro','field_5de7983506058'),(57000,1791,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(57001,1791,'_news_button','field_5de8329896e02'),(57002,1791,'timeline_intro','Introduction of timeline detail...'),(57003,1791,'_timeline_intro','field_5de98f5fb1781'),(57004,1791,'timeline_pic','477'),(57005,1791,'_timeline_pic','field_5de98f72b1782'),(57006,1791,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(57007,1791,'_timeline_button','field_5de99363677f8'),(57008,1791,'banner_image_position','center'),(57009,1791,'_banner_image_position','field_5f3bc4757dd02'),(57010,1791,'services_title','Our services'),(57011,1791,'_services_title','field_5f20f3cd80eb2'),(57012,1791,'services_items_0_services_item_image','1061'),(57013,1791,'_services_items_0_services_item_image','field_5f2121355be14'),(57014,1791,'services_items_0_sservices_item_title','1300 Telephone counselling line'),(57015,1791,'_services_item