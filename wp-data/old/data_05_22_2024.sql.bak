(76912,1872,'problem_icons_2_prob_concerned_text','Construction of social housing is down'),(76913,1872,'_problem_icons_2_prob_concerned_text','field_640fa10181d96'),(76914,1872,'problem_icons_3_prob_concerned_text','Banks are making more than ever from housing'),(76915,1872,'_problem_icons_3_prob_concerned_text','field_640fa10181d96'),(76916,1872,'monitor_content','The Australian Housing Monitor is a large, nationally-representative survey covering public experiences and attitudes toward housing related issues. Questions range from how well the respondent is keeping up with their mortgage/rent, to what they think about social housing construction.\r\n\r\nA broad range of demographic criteria are included, such as gender, location, age, income, voting preference, educational level, tenure type, and employment status. These variables allow CEH researchers to understand the trends and diversity of opinion around the country.\r\n\r\nIt also incorporates questions from previous surveys to track trends over time.\r\nThe inaugural poll was conducted by Essential in December 2022, and was completed by 4,735 people.'),(76917,1872,'_monitor_content','field_640fcc4014404'),(76918,1872,'problem_head','Housing in Australia is not working, and Australians are concerned.'),(76919,1872,'_problem_head','field_641935436aded'),(76920,1872,'problem_signoff','Explore the research showing how concerned Australians are our about the housing situation.'),(76921,1872,'_problem_signoff','field_641935626adee'),(76922,1872,'sections','a:2:{i:0;s:4:\"hero\";i:1;s:9:\"news_grid\";}'),(76923,1872,'_sections','field_5dafb40b8143a'),(76924,1872,'sections_0_is_full_height','1'),(76925,1872,'_sections_0_is_full_height','field_61d6f6fd5a37e'),(76926,1872,'sections_0_image','1648'),(76927,1872,'_sections_0_image','field_61d6f6d45a37d'),(76928,1872,'sections_0_heading','Heading'),(76929,1872,'_sections_0_heading','field_61d6f69e5a379'),(76930,1872,'sections_0_subtitle','Ya ya '),(76931,1872,'_sections_