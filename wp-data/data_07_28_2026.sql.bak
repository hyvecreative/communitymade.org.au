,(183167,2677,'_boxes_section_title','field_65262bbfd17fc'),(183168,2677,'intro_boxes_0_box_icon','1943'),(183169,2677,'_intro_boxes_0_box_icon','field_65262db5d36ee'),(183170,2677,'intro_boxes_0_box_title','Events'),(183171,2677,'_intro_boxes_0_box_title','field_65262d29ed8e3'),(183172,2677,'intro_boxes_0_box_dropdown','Our rigorous, conflict-free research and data analysis lifts the lid on fund performance, fees and insurance. Drawing on our policy expertise, we turn this analysis into action by using it to back reform and make super easier for people to understand. <a href=\"//localhost:4000:4000:4000:4000:4000:4000:/how/\">More</a>'),(183173,2677,'_intro_boxes_0_box_dropdown','field_65262dead0a0c'),(183174,2677,'intro_boxes_1_box_icon','1941'),(183175,2677,'_intro_boxes_1_box_icon','field_65262db5d36ee'),(183176,2677,'intro_boxes_1_box_title','Projects'),(183177,2677,'_intro_boxes_1_box_title','field_65262d29ed8e3'),(183178,2677,'intro_boxes_1_box_dropdown','Our rigorous, conflict-free research and data analysis lifts the lid on fund performance, fees and insurance. Drawing on our policy expertise, we turn this analysis into action by using it to back reform and make super easier for people to understand. <a href=\"//localhost:4000:4000:4000:4000:4000:4000:/how/\">More</a>'),(183179,2677,'_intro_boxes_1_box_dropdown','field_65262dead0a0c'),(183180,2677,'intro_boxes_2_box_icon','1937'),(183181,2677,'_intro_boxes_2_box_icon','field_65262db5d36ee'),(183182,2677,'intro_boxes_2_box_title','Ideas'),(183183,2677,'_intro_boxes_2_box_title','field_65262d29ed8e3'),(183184,2677,'intro_boxes_2_box_dropdown','Our rigorous, conflict-free research and data analysis lifts the lid on fund performance, fees and insurance. Drawing on our policy expertise, we turn this analysis into action by using it to back reform and make super easier for people to understand. <a href=\"//localhost:4000:4000:4000:4000:4000:4000:/how/\">More</a>'),(183185,2677,'_intro_boxes_2_box_dropdown','field_65262dead0a0c'),(183186,2677,'intro_boxes','3'),(183187,2677,'_intro_boxes','field_65262d14ed8e2'),(183188,2677,'get_help_section_title','Get Help'),(183189,2677,'_get_help_section_title','field_65262c35143de'),(183190,2677,'get_help_block_home',''),(183191,2677,'_get_help_block_home','field_65262c8a143e1'),(183192,2677,'gh_block_home_0_help_image','1956'),(183193,2677,'_gh_block_home_0_help_image','field_65262cd0143e2'),(183194,2677,'gh_block_home_0_help_title','How much do I need to retire? '),(183195,2677,'_gh_block_home_0_help_title','field_65262cec143e3'),(183196,2677,'gh_block_home_0_help_url','#'),(183197,2677,'_gh_block_home_0_help_url','field_65262cf4143e4'),(183198,2677,'gh_block_home_1_help_image','1962'),(183199,2677,'_gh_block_home_1_help_image','field_65262cd0143e2'),(183200,2677,'gh_block_home_1_help_title','I have a problem with  my super fund'),(183201,2677,'_gh_block_home_1_help_title','field_65262cec143e3'),(183202,2677,'gh_block_home_1_help_url','#'),(183203,2677,'_gh_block_home_1_help_url','field_65262cf4143e4'),(183204,2677,'gh_block_home_2_help_image','1961'),(183205,2677,'_gh_block_home_2_help_image','field_65262cd0143e2'),(183206,2677,'gh_block_home_2_help_title','How do I choose the right super? '),(183207,2677,'_gh_block_home_2_help_title','field_65262cec143e3'),(183208,2677,'gh_block_home_2_help_url','#'),(183209,2677,'_gh_block_home_2_help_url','field_65262cf4143e4'),(183210,2677,'gh_block_home','3'),(183211,2677,'_gh_block_home','field_65262c8a143e1'),(183212,2677,'turn_on_insights',''),(183213,2677,'_turn_on_insights','field_645c4a2e654a6'),(183214,2677,'report_questions','a:3:{i:0;s:2:\"59\";i:1;s:2:\"61\";i:2;s:4:\"2587\";}'),(183215,2677,'_report_questions','field_6109ed5e02e5a'),(183216,2677,'intro_text','The Disability Dialogue is a place where people with disabilities, their families, organisations providing support, academics, and the wider community come together to work on things that matter to us.\r\n\r\nThe Dialogue is a hub of knowledge and collaboration, separate from government, where we work together to come up. With new ideas on important topics. Our ideas can make a big difference in how services and systems are set up for people with disabilities.'),(183217,2677,'_intro_text','field_66441acfe963c'),(183218,2677,'word_link','#'),(183219,2677,'_word_link','field_6646c69723804'),(183220,2677,'pdf_link','#'),(183221,2677,'_pdf_link','field_6646c6da23805'),(183222,2677,'intro_boxes_0_box_image','2241'),(183223,2677,'_intro_boxes_0_box_image','field_65262db5d36ee'),(183224,2677,'intro_boxes_1_box_image','2179'),(183225,2677,'_intro_boxes_1_box_image','field_65262db5d36ee'),(183226,2677,'intro_boxes_2_box_image','2012'),(183227,2677,'_intro_boxes_2_box_image','field_65262db5d36ee'),(183228,2677,'intro_boxes_0_box_excerpt','Excerpt text here just a sentance or so and no more.'),(183229,2677,'_intro_boxes_0_box_excerpt','field_665975273e827'),(183230,2677,'intro_boxes_1_box_excerpt','Excerpt text here just a sentance or so and no more.'),(183231,2677,'_intro_boxes_1_box_excerpt','field_665975273e827'),(183232,2677,'intro_boxes_2_box_excerpt','Excerpt text here just a sentance or so and no more.'),(183233,2677,'_intro_boxes_2_box_excerpt','field_665975273e827'),(183234,2677,'intro_boxes_0_btn-text','Latest events'),(183235,2677,'_intro_boxes_0_btn-text','field_665abda8b8d4b'),(183236,2677,'intro_boxes_1_btn-text','Latest projects'),(183237,2677,'_intro_boxes_1_btn-text','field_665abda8b8d4b'),(183238,2677,'intro_boxes_2_btn-text','Latest ideas'),(183239,2677,'_intro_boxes_2_btn-text','field_665abda8b8d4b'),(183240,2677,'display-easy-read',''),(183241,2677,'_display-easy-read','field_666129bd2da00'),(183242,2677,'hm_hero_sum','Statement about the issue and lost life savings'),(183243,2677,'_hm_hero_sum','field_64ed37241effa'),(183244,2677,'hm_hero_sub','<span>Are you one of them? </span>'),(183245,2677,'_hm_hero_sub','field_64ed37241effa'),(183246,2677,'intro_head','We’re here to help.'),(183247,2677,'_intro_head','field_64e828783ad9f'),(183248,2677,'intro_content','About 12,000 people invested their hard-earned super savings in two investment funds which have now collapsed, called Shield Master Fund and First Guardian Master Fund. Most people will be entitled to get some money back, but you need to take action soon. This website has information and tools to help you understand what happened, where to get help and how to take back your super.'),(183249,2677,'_intro_content','field_66441acfe963c'),(183250,2677,'deadline_heading','Important deadlines'),(183251,2677,'_deadline_heading','field_69365ff82e6f2'),(183252,2677,'deadline_content','You need to take action before the deadline to take your super back.'),(183253,2677,'_deadline_content','field_693660342e6f3'),(183254,2677,'deadline_button_text','Find out more'),(183255,2677,'_deadline_button_text','field_693660482e6f4'),(183256,2677,'deadline_button_url','/key-deadlines/'),(183257,2677,'_deadline_button_url','field_693660912e6f5'),(183258,2677,'what_head','What happened?'),(183259,2677,'_what_head','field_69366611096ac'),(183260,2677,'what_happened_0_happ_sub','What are Shield and First Guardian?'),(183261,2677,'_what_happened_0_happ_sub','field_693d4a8b4197d'),(183262,2677,'what_happened_0_happ_content','About 12,000 people invested their hard-earned super savings in two investment funds called Shield Master Fund and First Guardian Master Fund. Those funds have collapsed, and a large part of the $1.2 billion people invested is gone.\r\n\r\nMost people invested through financial advisers who contacted them after they clicked on a social media ad offering a free super comparison or review.'),(183263,2677,'_what_happened_0_happ_content','field_693d4aa84197e'),(183264,2677,'what_happened_0_happ_url','/what-happened/'),(183265,2677,'_what_happened_0_happ_url','field_693d4aba4197f'),(183266,2677,'what_happened_0_happ_link_text','More'),(183267,2677,'_what_happened_0_happ_link_text','field_693d4ad641980'),(183268,2677,'what_happened_1_happ_sub','What is being done about this?'),(183269,2677,'_what_happened_1_happ_sub','field_693d4a8b4197d'),(183270,2677,'what_happened_1_happ_content','There is a lot of work being done to try to get money back for people who invested.\r\n\r\nThe regulator is also investigating what happened and has started enforcement action against a number of different people and companies for their involvement in the collapses of Shield and First Guardian Master Funds. Learn about the progress of this work'),(183271,2677,'_what_happened_1_happ_content','field_693d4aa84197e'),(183272,2677,'what_happened_1_happ_url','/what-happened/'),(183273,2677,'_what_happened_1_happ_url','field_693d4aba4197f'),(183274,2677,'what_happened_1_happ_link_text','More'),(183275,2677,'_what_happened_1_happ_link_text','field_693d4ad641980'),(183276,2677,'what_happened','2'),(183277,2677,'_what_happened','field_693d4a6f4197c'),(183278,2677,'what_happened_0_happ_icon','2605'),(183279,2677,'_what_happened_0_happ_icon','field_693d4c9b3ec4d'),(183280,2677,'what_happened_1_happ_icon','2604'),(183281,2677,'_what_happened_1_happ_icon','field_693d4c9b3ec4d'),(183282,2677,'display_news_section',''),(183283,2677,'_display_news_section','field_69434cc6d5f7d'),(183284,2566,'_wpa_old_event','a:2:{i:0;O:8:\"stdClass\":3:{s:1:\"0\";s:9:\"skiplinks\";s:1:\"1\";a:2:{i:0;s:14:\"control-titles\";i:1;s:1:\"1\";}s:9:\"timestamp\";s:0:\"\";}i:1;O:8:\"stdClass\":5:{s:1:\"0\";s:9:\"skiplinks\";s:1:\"1\";a:2:{i:0;s:14:\"control-titles\";i:1;s:1:\"1\";}s:1:\"2\";a:2:{i:0;s:12:\"link-targets\";i:1;s:1:\"8\";}s:1:\"3\";a:2:{i:0;s:16:\"control-tabindex\";i:1;s:1:\"3\";}s:9:\"timestamp\";s:0:\"\";}}'),(183285,2566,'_wpa_event','{\"0\":\"skiplinks\",\"1\":[\"control-titles\",\"1\"],\"timestamp\":1766098398}'),(183286,2146,'_wpa_old_event','a:2:{i:0;O:8:\"stdClass\":5:{s:1:\"0\";s:9:\"skiplinks\";s:1:\"1\";a:2:{i:0;s:14:\"control-titles\";i:1;s:1:\"1\";}s:1:\"2\";a:2:{i:0;s:12:\"link-targets\";i:1;s: