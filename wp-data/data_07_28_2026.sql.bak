INSERT INTO `wp_postmeta` VALUES (173285,2586,'_report_questions','field_6109ed5e02e5a'),(173286,2586,'intro_text','The Disability Dialogue is a place where people with disabilities, their families, organisations providing support, academics, and the wider community come together to work on things that matter to us.\r\n\r\nThe Dialogue is a hub of knowledge and collaboration, separate from government, where we work together to come up. With new ideas on important topics. Our ideas can make a big difference in how services and systems are set up for people with disabilities.'),(173287,2586,'_intro_text','field_66441acfe963c'),(173288,2586,'word_link','#'),(173289,2586,'_word_link','field_6646c69723804'),(173290,2586,'pdf_link','#'),(173291,2586,'_pdf_link','field_6646c6da23805'),(173292,2586,'intro_boxes_0_box_image','2241'),(173293,2586,'_intro_boxes_0_box_image','field_65262db5d36ee'),(173294,2586,'intro_boxes_1_box_image','2179'),(173295,2586,'_intro_boxes_1_box_image','field_65262db5d36ee'),(173296,2586,'intro_boxes_2_box_image','2012'),(173297,2586,'_intro_boxes_2_box_image','field_65262db5d36ee'),(173298,2586,'intro_boxes_0_box_excerpt','Excerpt text here just a sentance or so and no more.'),(173299,2586,'_intro_boxes_0_box_excerpt','field_665975273e827'),(173300,2586,'intro_boxes_1_box_excerpt','Excerpt text here just a sentance or so and no more.'),(173301,2586,'_intro_boxes_1_box_excerpt','field_665975273e827'),(173302,2586,'intro_boxes_2_box_excerpt','Excerpt text here just a sentance or so and no more.'),(173303,2586,'_intro_boxes_2_box_excerpt','field_665975273e827'),(173304,2586,'intro_boxes_0_btn-text','Latest events'),(173305,2586,'_intro_boxes_0_btn-text','field_665abda8b8d4b'),(173306,2586,'intro_boxes_1_btn-text','Latest projects'),(173307,2586,'_intro_boxes_1_btn-text','field_665abda8b8d4b'),(173308,2586,'intro_boxes_2_btn-text','Latest ideas'),(173309,2586,'_intro_boxes_2_btn-text','field_665abda8b8d4b'),(173310,2586,'display-easy-read',''),(17331