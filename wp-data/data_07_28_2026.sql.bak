children'),(52561,1701,'_second_image_title','field_5b67cb20ddf9a'),(52562,1701,'page_col_image','412'),(52563,1701,'_page_col_image','field_5de6546e7c63a'),(52564,1701,'page_col_image_3','437'),(52565,1701,'_page_col_image_3','field_5de6e3998e07e'),(52566,1701,'sec_2_title','Community'),(52567,1701,'_sec_2_title','field_5de6e3ef2798f'),(52568,1701,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(52569,1701,'_sec_2_text','field_5de78dc89e613'),(52570,1701,'sec_3_title','The Project'),(52571,1701,'_sec_3_title','field_5de6e3d37d8da'),(52572,1701,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(52573,1701,'_sec_3_text','field_5de6e4044e5e8'),(52574,1701,'page_col_image_2','436'),(52575,1701,'_page_col_image_2','field_5de6546e7c63a'),(52576,1701,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(52577,1701,'_sec_2_button','field_5de6e58c86706'),(52578,1701,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(52579,1701,'_sec_3_button','field_5de6e5a243c03'),(52580,1701,'page_col_image_4','455'),(52581,1701,'_page_col_image_4','field_5de70801090ce'),(52582,1701,'sec_4_title','Location'),(52583,1701,'_sec_4_title','field_5de7082a12a81'),(52584,1701,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(52585,1701,'_sec_4_text','field_5de7084812a82'),(52586,1701,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(52587,1701,'_sec_4_button','field_5de7085e12a83'),(52588,1701,'news_title','Project updates'),(52589,1701,'_news_title','field_5de78da3aabb9'),(52590,1701,'sec_2_text_copy',''),(52591,1701,'_sec_2_text_copy','field_5de78dc89e613'),(52592,1701,'timeline-title','Timeline'),(52593,1701,'_timeline-title','field_5de78df29e615'),(52594,1701,'timeline_title','Timeline'),(52595,1701,'_timeline_title','field_5de78df29e615'),(52596,1701,'contact_title','Contact us'),(52597,1701,'_contact_title','field_5de7981e06057'),(52598,1701,'contact_intro','Contact text...'),(52599,1701,'_contact_intro','field_5de7983506058'),(52600,1701,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(52601,1701,'_news_button','field_5de8329896e02'),(52602,1701,'timeline_intro','Introduction of timeline detail...'),(52603,1701,'_timeline_intro','field_5de98f5fb1781'),(52604,1701,'timeline_pic','477'),(52605,1701,'_timeline_pic','field_5de98f72b1782'),(52606,1701,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(52607,1701,'_timeline_button','field_5de99363677f8'),(52608,1701,'banner_image_position','center'),(52609,1701,'_banner_image_position','field_5f3bc4757dd02'),(52610,1701,'services_title','Our services'),(52611,1701,'_services_title','field_5f20f3cd80eb2'),(52612,1701,'services_items_0_services_item_image','1061'),(52613,1701,'_services_items_0_services_item_image','field_5f2121355be14'),(52614,1701,'services_items_0_sservices_item_title','1300 Telephone counselling line'),(52615,1701,'_services_items_0_sservices_item_title','field_605089efca82e'),(52616,1701,'services_items_0_services_item_text',''),(5261