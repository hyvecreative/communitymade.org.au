ng children'),(57501,1794,'_first_image_title','field_5b67ca606afc4'),(57502,1794,'first_image_cont','from 0-24 years living with disabilities and their familes'),(57503,1794,'_first_image_cont','field_5b67caff6afc5'),(57504,1794,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(57505,1794,'_first_image_button','field_5b67cb0d6afc6'),(57506,1794,'second _image_title','Lifestart is about supporting young children'),(57507,1794,'_second _image_title','field_5b67cb20ddf9a'),(57508,1794,'second_image_cont','from 0-24 years living with disabilities and their familes'),(57509,1794,'_second_image_cont','field_5b67cb24ddf9b'),(57510,1794,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(57511,1794,'_second_image_button','field_5b67cb29ddf9c'),(57512,1794,'second_image_title','Lifestart is about supporting young children'),(57513,1794,'_second_image_title','field_5b67cb20ddf9a'),(57514,1794,'page_col_image','412'),(57515,1794,'_page_col_image','field_5de6546e7c63a'),(57516,1794,'page_col_image_3','437'),(57517,1794,'_page_col_image_3','field_5de6e3998e07e'),(57518,1794,'sec_2_title','Community'),(57519,1794,'_sec_2_title','field_5de6e3ef2798f'),(57520,1794,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(57521,1794,'_sec_2_text','field_5de78dc89e613'),(57522,1794,'sec_3_title','The Project'),(57523,1794,'_sec_3_title','field_5de6e3d37d8da'),(57524,1794,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(57525,1794,'_sec_3_text','field_5de6e4044e5e8'),(57526,1794,'page_col_image_2','436'),(57527,1794,'_page_col_image_2','field_5de6546e7c63a'),(57528,1794,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(57529,1794,'_sec_2_button','field_5de6e58c86706'),(57530,1794,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(57531,1794,'_sec_3_button','field_5de6e5a243c03'),(57532,1794,'page_col_image_4','455'),(57533,1794,'_page_col_image_4','field_5de70801090ce'),(57534,1794,'sec_4_title','Location'),(57535,1794,'_sec_4_title','field_5de7082a12a81'),(57536,1794,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(57537,1794,'_sec_4_text','field_5de7084812a82'),(57538,1794,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(57539,1794,'_sec_4_button','field_5de7085e12a83'),(57540,1794,'news_title','Project updates'),(57541,1794,'_news_title','field_5de78da3aabb9'),(57542,1794,'sec_2_text_copy',''),(57543,1794,'_sec_2_text_copy','field_5de78dc89e613'),(57544,1794,'timeline-title','Timeline'),(57545,1794,'_timeline-title','field_5de78df29e615'),(57546,1794,'timeline_title','Timeline'),(57547,1794,'_timeline_title','field_5de78df29e615'),(57548,1794,'contact_title','Contact us'),(57549,1794,'_contact_title','field_5de7981e06057'),(57550,1794,'contact_intro','Contact text...'),(57551,1794,'_contact_intro','field_5de7983506058'),(57552,1794,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(57553,1794,'_news_button','field_5de8329896e02'),(57554,1794,'timeline_intro','Introduction of timeline deta