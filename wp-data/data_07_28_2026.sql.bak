page_col_image','field_5de6546e7c63a'),(19314,1074,'page_col_image_3','437'),(19315,1074,'_page_col_image_3','field_5de6e3998e07e'),(19316,1074,'sec_2_title','Community'),(19317,1074,'_sec_2_title','field_5de6e3ef2798f'),(19318,1074,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(19319,1074,'_sec_2_text','field_5de78dc89e613'),(19320,1074,'sec_3_title','The Project'),(19321,1074,'_sec_3_title','field_5de6e3d37d8da'),(19322,1074,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(19323,1074,'_sec_3_text','field_5de6e4044e5e8'),(19324,1074,'page_col_image_2','436'),(19325,1074,'_page_col_image_2','field_5de6546e7c63a'),(19326,1074,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(19327,1074,'_sec_2_button','field_5de6e58c86706'),(19328,1074,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(19329,1074,'_sec_3_button','field_5de6e5a243c03'),(19330,1074,'page_col_image_4','455'),(19331,1074,'_page_col_image_4','field_5de70801090ce'),(19332,1074,'sec_4_title','Location'),(19333,1074,'_sec_4_title','field_5de7082a12a81'),(19334,1074,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(19335,1074,'_sec_4_text','field_5de7084812a82'),(19336,1074,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(19337,1074,'_sec_4_button','field_5de7085e12a83'),(19338,1074,'news_title','Project updates'),(19339,1074,'_news_title','field_5de78da3aabb9'),(19340,1074,'sec_2_text_copy',''),(19341,1074,'_sec_2_text_copy','field_5de78dc89e613'),(19342,1074,'timeline-title','Timeline'),(19343,1074,'_timeline-title','field_5de78df29e615'),(19344,1074,'timeline_title','Timeline'),(19345,1074,'_timeline_title','field_5de78df29e615'),(19346,1074,'contact_title','Contact us'),(19347,1074,'_contact_title','field_5de7981e06057'),(19348,1074,'contact_intro','Contact text...'),(19349,1074,'_contact_intro','field_5de7983506058'),(19350,1074,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(19351,1074,'_news_button','field_5de8329896e02'),(19352,1074,'timeline_intro','Introduction of timeline detail...'),(19353,1074,'_timeline_intro','field_5de98f5fb1781'),(19354,1074,'timeline_pic','477'),(19355,1074,'_timeline_pic','field_5de98f72b1782'),(19356,1074,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(19357,1074,'_timeline_button','field_5de99363677f8'),(19358,1074,'banner_image_position','center'),(19359,1074,'_banner_image_position','field_5f3bc4757dd02'),(19360,1074,'services_title','Our services'),(19361,1074,'_services_title','field_5f20f3cd80eb2'),(19362,1074,'services_items_0_services_item_image','1061'),(19363,1074,'_services_items_0_services_item_image','field_5f2121355be14'),(19364,1074,'services_items_0_sservices_item_title','1300 Telephone counselling line'),(19365,1074,'_services_items_0_sservices_item_title','field_605089efca82e'),(19366,1074,'services_items_0_services_item_text',''),(19367,1074,'_services_items_0_services_item_text','field_5f2121535be15'),(19368,1074,'services_items_0_services_link_url',