(50993,1656,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(50994,1656,'_first_image_button','field_5b67cb0d6afc6'),(50995,1656,'second _image_title','Lifestart is about supporting young children'),(50996,1656,'_second _image_title','field_5b67cb20ddf9a'),(50997,1656,'second_image_cont','from 0-24 years living with disabilities and their familes'),(50998,1656,'_second_image_cont','field_5b67cb24ddf9b'),(50999,1656,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(51000,1656,'_second_image_button','field_5b67cb29ddf9c'),(51001,1656,'second_image_title','Lifestart is about supporting young children'),(51002,1656,'_second_image_title','field_5b67cb20ddf9a'),(51003,1656,'page_col_image','412'),(51004,1656,'_page_col_image','field_5de6546e7c63a'),(51005,1656,'page_col_image_3','437'),(51006,1656,'_page_col_image_3','field_5de6e3998e07e'),(51007,1656,'sec_2_title','Community'),(51008,1656,'_sec_2_title','field_5de6e3ef2798f'),(51009,1656,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(51010,1656,'_sec_2_text','field_5de78dc89e613'),(51011,1656,'sec_3_title','The Project'),(51012,1656,'_sec_3_title','field_5de6e3d37d8da'),(51013,1656,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(51014,1656,'_sec_3_text','field_5de6e4044e5e8'),(51015,1656,'page_col_image_2','436'),(51016,1656,'_page_col_image_2','field_5de6546e7c63a'),(51017,1656,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(51018,1656,'_sec_2_button','field_5de6e58c86706'),(51019,1656,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(51020,1656,'_sec_3_button','field_5de6e5a243c03'),(51021,1656,'page_col_image_4','455'),(51022,1656,'_page_col_image_4','field_5de70801090ce'),(51023,1656,'sec_4_title','Location'),(51024,1656,'_sec_4_title','field_5de7082a12a81'),(51025,1656,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(51026,1656,'_sec_4_text','field_5de7084812a82'),(51027,1656,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(51028,1656,'_sec_4_button','field_5de7085e12a83'),(51029,1656,'news_title','Project updates'),(51030,1656,'_news_title','field_5de78da3aabb9'),(51031,1656,'sec_2_text_copy',''),(51032,1656,'_sec_2_text_copy','field_5de78dc89e613'),(51033,1656,'timeline-title','Timeline'),(51034,1656,'_timeline-title','field_5de78df29e615'),(51035,1656,'timeline_title','Timeline'),(51036,1656,'_timeline_title','field_5de78df29e615'),(51037,1656,'contact_title','Contact us'),(51038,1656,'_contact_title','field_5de7981e06057'),(51039,1656,'contact_intro','Contact text...'),(51040,1656,'_contact_intro','field_5de7983506058'),(51041,1656,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(51042,1656,'_news_button','field_5de8329896e02'),(51043,1656,'timeline_intro','Introduction of timeline detail...'),(51044,1656,'_timeline_intro','field_5de98f5fb1781'),(51045,1656,'timeline_pic','477'),(51046,1656,'_timeline_pic','field_5de98f72b1782'),(51047,1656,'timeline_button','<a class=\"btn btn-home btn-news\" href=\