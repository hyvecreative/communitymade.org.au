_boxes_0_box_icon','field_65262db5d36ee'),(187131,2702,'intro_boxes_0_box_title','Events'),(187132,2702,'_intro_boxes_0_box_title','field_65262d29ed8e3'),(187133,2702,'intro_boxes_0_box_dropdown','Our rigorous, conflict-free research and data analysis lifts the lid on fund performance, fees and insurance. Drawing on our policy expertise, we turn this analysis into action by using it to back reform and make super easier for people to understand. <a href=\"//localhost:4000:4000:4000:4000:4000:4000:/how/\">More</a>'),(187134,2702,'_intro_boxes_0_box_dropdown','field_65262dead0a0c'),(187135,2702,'intro_boxes_1_box_icon','1941'),(187136,2702,'_intro_boxes_1_box_icon','field_65262db5d36ee'),(187137,2702,'intro_boxes_1_box_title','Projects'),(187138,2702,'_intro_boxes_1_box_title','field_65262d29ed8e3'),(187139,2702,'intro_boxes_1_box_dropdown','Our rigorous, conflict-free research and data analysis lifts the lid on fund performance, fees and insurance. Drawing on our policy expertise, we turn this analysis into action by using it to back reform and make super easier for people to understand. <a href=\"//localhost:4000:4000:4000:4000:4000:4000:/how/\">More</a>'),(187140,2702,'_intro_boxes_1_box_dropdown','field_65262dead0a0c'),(187141,2702,'intro_boxes_2_box_icon','1937'),(187142,2702,'_intro_boxes_2_box_icon','field_65262db5d36ee'),(187143,2702,'intro_boxes_2_box_title','Ideas'),(187144,2702,'_intro_boxes_2_box_title','field_65262d29ed8e3'),(187145,2702,'intro_boxes_2_box_dropdown','Our rigorous, conflict-free research and data analysis lifts the lid on fund performance, fees and insurance. Drawing on our policy expertise, we turn this analysis into action by using it to back reform and make super easier for people to understand. <a href=\"//localhost:4000:4000:4000:4000:4000:4000:/how/\">More</a>'),(187146,2702,'_intro_boxes_2_box_dropdown','field_65262dead0a0c'),(187147,2702,'intro_boxes','3'),(187148,2702,'_intro_boxes','field_65262d14ed8e2'),(187149,2702,'get_help_section_title','Get Help'),(187150,2702,'_get_help_section_title','field_65262c35143de'),(187151,2702,'get_help_block_home',''),(187152,2702,'_get_help_block_home','field_65262c8a143e1'),(187153,2702,'gh_block_home_0_help_image','1956'),(187154,2702,'_gh_block_home_0_help_image','field_65262cd0143e2'),(187155,2702,'gh_block_home_0_help_title','How much do I need to retire? '),(187156,2702,'_gh_block_home_0_help_title','field_65262cec143e3'),(187157,2702,'gh_block_home_0_help_url','#'),(187158,2702,'_gh_block_home_0_help_url','field_65262cf4143e4'),(187159,2702,'gh_block_home_1_help_image','1962'),(187160,2702,'_gh_block_home_1_help_image','field_65262cd0143e2'),(187161,2702,'gh_block_home_1_help_title','I have a problem with  my super fund'),(187162,2702,'_gh_block_home_1_help_title','field_65262cec143e3'),(187163,2702,'gh_block_home_1_help_url','#'),(187164,2702,'_gh_block_home_1_help_url','field_65262cf4143e4'),(187165,2702,'gh_block_home_2_help_image','1961'),(187166,2702,'_gh_block_home_2_help_image','field_65262cd0143e2'),(187167,2702,'gh_block_home_2_help_title','How do I choose the right super? '),(187168,2702,'_gh_block_home_2_help_title','field_65262cec143e3'),(187169,2702,'gh_block_home_2_help_url','#'),(187170,2702,'_gh_block_home_2_help_url','field_65262cf4143e4'),(187171,2702,'gh_block_home','3'),(187172,2702,'_gh_block_home','field_65262c8a143e1'),(187173,2702,'turn_on_insights',''),(187174,2702,'_turn_on_insights','field_645c4a2e654a6'),(187175,2702,'report_questions','a:3:{i:0;s:2:\"59\";i:1;s:2:\"61\";i:2;s:4:\"2587\";}'),(187176,2702,'_report_questions','field_6109ed5e02e5a'),(187177,2702,'intro_text','The Disability Dialogue is a place where people with disabilities, their families, organisations providing support, academics, and the wider community come together to work on things that matter to us.\r\n\r\nThe Dialogue is a hub of knowledge and collaboration, separate from government, where we work together to come up. With new ideas on important topics. Our ideas can make a big difference in how services and systems are set up for people with disabilities.'),(187178,2702,'_intro_text','field_66441acfe963c'),(187179,2702,'word_link','#'),(187180,2702,'_word_link','field_6646c69723804'),(187181,2702,'pdf_link','#'),(187182,2702,'_pdf_link','field_6646c6da23805'),(187183,2702,'intro_boxes_0_box_image','2241'),(187184,2702,'_intro_boxes_0_box_image','field_65262db5d36ee'),(187185,2702,'intro_boxes_1_box_image','2179'),(187186,2702,'_intro_boxes_1_box_image','field_65262db5d36ee'),(187187,2702,'intro_boxes_2_box_image','2012'),(187188,2702,'_intro_boxes_2_box_image','field_65262db5d36ee'),(187189,2702,'intro_boxes_0_box_excerpt','Excerpt text here just a sentance or so and no more.'),(187190,2702,'_intro_boxes_0_box_excerpt','field_665975273e827'),(187191,2702,'intro_boxes_1_box_excerpt','Excerpt text here just a sentance or so and no more.'),(187192,2702,'_intro_boxes_1_box_excerpt','field_665975273e827'),(187193,2702,'intro_boxes_2_box_excerpt','Excerpt text here just a sentance or so and no more.'),(187194,2702,'_intro_boxes_2_box_excerpt','field_665975273e827'),(187195,2702,'intro_boxes_0_btn-text','Latest events'),(187196,2702,'_intro_boxes_0_btn-text','field_665abda8b8d4b'),(187197,2702,'intro_boxes_1_btn-text','Latest projects'),(187198,2702,'_intro_boxes_1_btn-text','field_665abda8b8d4b'),(187199,2702,'intro_boxes_2_btn-text','Latest ideas'),(187200,2702,'_intro_boxes_2_btn-text','field_665abda8b8d4b'),(187201,2702,'display-easy-read',''),(187202,2702,'_display-easy-read','field_666129bd2da00'),(187203,2702,'hm_hero_sum','Statement about the issue and lost life savings'),(187204,2702,'_hm_hero_sum','field_64ed37241effa'),(187205,2702,'hm_hero_sub','When housing is affordable, communities thrive – that’s what  community made means. Homes built and managed by not-for-profits with purpose, not profit.'),(187206,2702,'_hm_hero_sub','field_64ed37241effa'),(187207,2702,'intro_head','We’re here to help.'),(187208,2702,'_intro_head','field_64e828783ad9f'),(187209,2702,'intro_content','About 12,000 people invested their hard-earned super savings in two investment funds which have now collapsed, called Shield Master Fund and First Guardian Master Fund. Most people will be entitled to get some money back, but you need to take action soon. This website has information and tools to help you understand what happened, where to get help and how to take back your super.'),(187210,2702,'_intro_content','field_66441acfe963c'),(187211,2702,'deadline_heading','Important deadlines'),(187212,2702,'_deadline_heading','field_69365ff82e6f2'),(187213,2702,'deadline_content','You need to take action before the deadline to take your super back.'),(187214,2702,'_deadline_content','field_693660342e6f3'),(187215,2702,'deadline_button_text','Find out more'),(187216,2702,'_deadline_button_text','field_693660482e6f4'),(187217,2702,'deadline_button_url','/key-deadlines/'),(187218,2702,'_deadline_button_url','field_693660912e6f5'),(187219,2702,'what_head','What happened?'),(187220,2702,'_what_head','field_69366611096ac'),(187221,2702,'what_happened_0_happ_sub','What are Shield and First Guardian?'),(187222,2702,'_what_happened_0_happ_sub','field_693d4a8b4197d'),(187223,2702,'what_happened_0_happ_content','About 12,000 people invested their hard-earned super savings in two investment funds called Shield Master Fund and First Guardian Master Fund. Those funds have collapsed, and a large part of the $1.2 billion people invested is gone.\r\n\r\nMost people invested through financial advisers who contacted them after they clicked on a social media ad offering a free super comparison or review.'),(187224,2702,'_what_happened_0_happ_content','field_693d4aa84197e'),(187225,2702,'what_happened_0_happ_url','/what-happened/'),(187226,2702,'_what_happened_0_happ_url','field_693d4aba4197f'),(187227,2702,'what_happened_0_happ_link_text','More'),(187228,2702,'_what_happened_0_happ_link_text','field_693d4ad641980'),(187229,2702,'what_happened_1_happ_sub','What is being done about this?'),(187230,2702,'_what_happened_1_happ_sub','field_693d4a8b4197d'),(187231,2702,'what_happened_1_happ_content','There is a lot of work being done to try to get money back for people who invested.\r\n\r\nThe regulator is also investigating what happened and has started enforcement action against a number of different people and companies for their involvement in the collapses of Shield and First Guardian Master Funds. Learn about the progress of this work'),(187232,2702,'_what_happened_1_happ_content','field_693d4aa84197e'),(187233,2702,'what_happened_1_happ_url','/what-happened/'),(187234,2702,'_what_happened_1_happ_url','field_693d4aba4197f'),(187235,2702,'what_happened_1_happ_link_text','More'),(187236,2702,'_what_happened_1_happ_link_text','field_693d4ad641980'),(187237,2702,'what_happened','2'),(187238,2702,'_what_happened','field_693d4a6f4197c'),(187239,2702,'what_happened_0_happ_icon','2605'),(187240,2702,'_what_happened_0_happ_icon','field_693d4c9b3ec4d'),(187241,2702,'what_happened_1_happ_icon','2604'),(187242,2702,'_what_happened_1_happ_icon','field_693d4c9b3ec4d'),(187243,2702,'display_news_section',''),(187244,2702,'_display_news_section','field_69434cc6d5f7d'),(187245,2702,'issues_head','The Issues'),(187246,2702,'_issues_head','field_6a3b076406aef'),(187247,2702,'issues_items_0_issue_icon','2604'),(187248,2702,'_issues_items_0_issue_icon','field_6a3b07b506af1'),(187249,2702,'issues_items_0_issues_item_hd','The problem'),(187250,2702,'_issues_items_0_issues_item_hd','field_6a3b07d706af2'),(187251,2702,'issues_items_0_issues_item_txt','Rents are rising, waitlists are growing and more people are experiencing housing stress for the first time.'),(187252,2702,'_issues_items_0_issues_item_txt','field_6a3b07fc06af3'),(187253,2702,'issues_items_0_issues_link_text','Find out more'),(187254,2702,'_issues_items_0_issues_link_text','field_6a3b080f06af4'),(187255,2702,'issues_items_0_issues_target_url','#'),(187256,2702,'_issues_items_0_issues_target_url','field_6a3b082b06af5'),(187257,2702,'issues_items','2'),(187258,2702,'_issues_items','field_6a3b078206af0'),(187259,2702,'issues_items_1_issue_icon','2605'),(187260,2702,'_issues_items_1_issue_icon','field_6a3b07b506af1'),(187261,2702,'issues_items_1_issues_item_hd','Scaling the solution'),(187262,2702,'_issues_items_1_issues_item_hd','field_6a3b07d706af2'),(187263,2702,'issues_items_1_issues_item_txt','Governments, communities and not-for-profit community housing providers are working together to make rental housing more affordable for everyone who calls NSW home.'),(187264,2702,'_issues_items_1_issues_item_txt','field_6a3b07fc06af3'),(187265,2702,'issues_items_1_issues_link_text','Find out more'),(187266,2702,'_issues_items_1_issues_link_text','field_6a3b080f06af4'),(187267,2702,'issues_items_1_issues_target_url','#'),(187268,2702,'_issues_items_1_issues_target_url','field_6a3b082b06af5'),(187269,2702,'issues_items_0_issues_sub_head','The housing crisis is spiralling. '),(187270,2702,'_issues_items_0_issues_sub_head','field_6a3b0aa79365e'),(187271,2702,'issues_items_1_issues_sub_head','Community housing is social infrastructure.'),(187272,2702,'_issues_items_1_issues_sub_head','field_6a3b0aa79365e'),(187273,2578,'_wpa_old_event','a:2:{i:0;O:8:\"stdClass\":4:{s:1:\"0\";s:9:\"skiplinks\";s:1:\"1\";a:2:{i:0;s:14:\"control-titles\";i:1;s:1:\"2\";}s:1:\"2\";a:2:{i:0;s:16:\"control-tabindex\";i:1;s:1:\"1\";}s:9:\"timestamp\";s:0:\"\";}i:1;O:8:\"stdClass\":5:{s:1:\"0\";s:9:\"skiplinks\";s:1:\"1\";a:2:{i:0;s:14:\"control-titles\";i:1;s:1:\"1\";}s:1:\"2\";a:2:{i:0;s:12:\"link-targets\";i:1;s:1:\"8\";}s:1:\"3\";a:2:{i:0;s:16:\"control-tabindex\";i:1;s:1:\"3\";}s:9:\"timestamp\";s:0:\"\";}}'),(187274,2578,'_wpa_event','{\"0\":\"skiplinks\",\"1\":[\"control-titles\",\"2\"],\"2\":[\"control-tabindex\",\"1\"],\"timestamp\":1782254591}'),(187275,2703,'_wp_attached_file','2026/06/cm_icon_3.svg'),(187276,2703,'_wp_attachment