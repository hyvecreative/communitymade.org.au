ctetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut.'),(53593,1703,'_support_right_cont','field_5b67c6c98c065'),(53594,1703,'support_right_button','<a class=\"btn btn-blue\" href=\"#\">Read more</a>'),(53595,1703,'_support_right_button','field_5b67c6dd8c066'),(53596,1703,'first_image_title','Lifestart is about supporting young children'),(53597,1703,'_first_image_title','field_5b67ca606afc4'),(53598,1703,'first_image_cont','from 0-24 years living with disabilities and their familes'),(53599,1703,'_first_image_cont','field_5b67caff6afc5'),(53600,1703,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(53601,1703,'_first_image_button','field_5b67cb0d6afc6'),(53602,1703,'second _image_title','Lifestart is about supporting young children'),(53603,1703,'_second _image_title','field_5b67cb20ddf9a'),(53604,1703,'second_image_cont','from 0-24 years living with disabilities and their familes'),(53605,1703,'_second_image_cont','field_5b67cb24ddf9b'),(53606,1703,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(53607,1703,'_second_image_button','field_5b67cb29ddf9c'),(53608,1703,'second_image_title','Lifestart is about supporting young children'),(53609,1703,'_second_image_title','field_5b67cb20ddf9a'),(53610,1703,'page_col_image','412'),(53611,1703,'_page_col_image','field_5de6546e7c63a'),(53612,1703,'page_col_image_3','437'),(53613,1703,'_page_col_image_3','field_5de6e3998e07e'),(53614,1703,'sec_2_title','Community'),(53615,1703,'_sec_2_title','field_5de6e3ef2798f'),(53616,1703,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(53617,1703,'_sec_2_text','field_5de78dc89e613'),(53618,1703,'sec_3_title','The Project'),(53619,1703,'_sec_3_title','field_5de6e3d37d8da'),(53620,1703,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(53621,1703,'_sec_3_text','field_5de6e4044e5e8'),(53622,1703,'page_col_image_2','436'),(53623,1703,'_page_col_image_2','field_5de6546e7c63a'),(53624,1703,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(53625,1703,'_sec_2_button','field_5de6e58c86706'),(53626,1703,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(53627,1703,'_sec_3_button','field_5de6e5a243c03'),(53628,1703,'page_col_image_4','455'),(53629,1703,'_page_col_image_4','field_5de70801090ce'),(53630,1703,'sec_4_title','Location'),(53631,1703,'_sec_4_title','field_5de7082a12a81'),(53632,1703,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(53633,1703,'_sec_4_text','field_5de7084812a82'),(53634,1703,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(53635,1703,'_sec_4_button','field_5de7085e12a83'),(53636,1703,'news_title','Project updates'),(53637,1703,'_news_title','field_5de78da3aabb9'),(53638,1703,'sec_2_text_copy',''),(53639,1703,'_sec_2_text_copy','field_5de78dc89e613'),(53640,1703,'timeline-title','Timeline'),(53641,1703,'_timeline-title','field_5de78df29e615'),(53642,1703,'timeline_title','Timeline'),(53643,1703,'_timeline_title','field_5de78df29e615'),(53644,1703,'contact_title','Contact us'),(53645,1703,'_contact