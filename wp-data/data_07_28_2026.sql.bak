second_image_cont','from 0-24 years living with disabilities and their familes'),(82419,1916,'_second_image_cont','field_5b67cb24ddf9b'),(82420,1916,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(82421,1916,'_second_image_button','field_5b67cb29ddf9c'),(82422,1916,'second_image_title','Lifestart is about supporting young children'),(82423,1916,'_second_image_title','field_5b67cb20ddf9a'),(82424,1916,'page_col_image','412'),(82425,1916,'_page_col_image','field_5de6546e7c63a'),(82426,1916,'page_col_image_3','437'),(82427,1916,'_page_col_image_3','field_5de6e3998e07e'),(82428,1916,'sec_2_title','Community'),(82429,1916,'_sec_2_title','field_5de6e3ef2798f'),(82430,1916,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(82431,1916,'_sec_2_text','field_5de78dc89e613'),(82432,1916,'sec_3_title','The Project'),(82433,1916,'_sec_3_title','field_5de6e3d37d8da'),(82434,1916,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(82435,1916,'_sec_3_text','field_5de6e4044e5e8'),(82436,1916,'page_col_image_2','436'),(82437,1916,'_page_col_image_2','field_5de6546e7c63a'),(82438,1916,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(82439,1916,'_sec_2_button','field_5de6e58c86706'),(82440,1916,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(82441,1916,'_sec_3_button','field_5de6e5a243c03'),(82442,1916,'page_col_image_4','455'),(82443,1916,'_page_col_image_4','field_5de70801090ce'),(82444,1916,'sec_4_title','Location'),(82445,1916,'_sec_4_title','field_5de7082a12a81'),(82446,1916,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(82447,1916,'_sec_4_text','field_5de7084812a82'),(82448,1916,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(82449,1916,'_sec_4_button','field_5de7085e12a83'),(82450,1916,'news_title','Project updates'),(82451,1916,'_news_title','field_5de78da3aabb9'),(82452,1916,'sec_2_text_copy',''),(82453,1916,'_sec_2_text_copy','field_5de78dc89e613'),(82454,1916,'timeline-title','Timeline'),(82455,1916,'_timeline-title','field_5de78df29e615'),(82456,1916,'timeline_title','Timeline'),(82457,1916,'_timeline_title','field_5de78df29e615'),(82458,1916,'contact_title','Contact us'),(82459,1916,'_contact_title','field_5de7981e06057'),(82460,1916,'contact_intro','Contact text...'),(82461,1916,'_contact_intro','field_5de7983506058'),(82462,1916,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(82463,1916,'_news_button','field_5de8329896e02'),(82464,1916,'timeline_intro','Introduction of timeline detail...'),(82465,1916,'_timeline_intro','field_5de98f5fb1781'),(82466,1916,'timeline_pic','477'),(82467,1916,'_timeline_pic','field_5de98f72b1782'),(82468,1916,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(82469,1916,'_timeline_button','field_5de99363677f8'),(82470,1916,'banner_image_position','center'),(82471,1916,'_banner_image_position','field_5f3bc4757dd02'),(82472,1916,'services_title','Our services'),(82473,1916,'_services_title','field_5f20f3cd80eb