,'412'),(124091,2174,'_page_col_image','field_5de6546e7c63a'),(124092,2174,'page_col_image_3','437'),(124093,2174,'_page_col_image_3','field_5de6e3998e07e'),(124094,2174,'sec_2_title','Community'),(124095,2174,'_sec_2_title','field_5de6e3ef2798f'),(124096,2174,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(124097,2174,'_sec_2_text','field_5de78dc89e613'),(124098,2174,'sec_3_title','The Project'),(124099,2174,'_sec_3_title','field_5de6e3d37d8da'),(124100,2174,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(124101,2174,'_sec_3_text','field_5de6e4044e5e8'),(124102,2174,'page_col_image_2','436'),(124103,2174,'_page_col_image_2','field_5de6546e7c63a'),(124104,2174,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(124105,2174,'_sec_2_button','field_5de6e58c86706'),(124106,2174,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(124107,2174,'_sec_3_button','field_5de6e5a243c03'),(124108,2174,'page_col_image_4','455'),(124109,2174,'_page_col_image_4','field_5de70801090ce'),(124110,2174,'sec_4_title','Location'),(124111,2174,'_sec_4_title','field_5de7082a12a81'),(124112,2174,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are 