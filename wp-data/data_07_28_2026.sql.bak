52,2732,'display_news_section',''),(201153,2732,'_display_news_section','field_69434cc6d5f7d'),(201154,2732,'issues_head','These are the issues'),(201155,2732,'_issues_head','field_6a3b076406aef'),(201156,2732,'issues_items_0_issue_icon','2705'),(201157,2732,'_issues_items_0_issue_icon','field_6a3b07b506af1'),(201158,2732,'issues_items_0_issues_item_hd','A secure home is slipping out of reach'),(201159,2732,'_issues_items_0_issues_item_hd','field_6a3b07d706af2'),(201160,2732,'issues_items_0_issues_item_txt','•	A shortage of 132,000 social and affordable rental homes\r\n•	70,000+ households waiting for social housing\r\n•	Record-high private market rents\r\n•	Home ownership increasingly out of reach for generations'),(201161,2732,'_issues_items_0_issues_item_txt','field_6a3b07fc06af3'),(201162,2732,'issues_items_0_issues_link_text',''),(201163,2732,'_issues_items_0_issues_link_text','field_6a3b080f06af4'),(201164,2732,'issues_items_0_issues_target_url',''),(201165,2732,'_issues_items_0_issues_target_url','field_6a3b082b06af5'),(201166,2732,'issues_items','3'),(201167,2732,'_issues_items','field_6a3b078206af0'),(201168,2732,'issues_items_1_issue_icon','2708'),(201169,2732,'_issues_items_1_issue_icon','field_6a3b07b506af1'),(201170,2732,'issues_items_1_issues_item_hd','The solutions we need '),(201171,2732,'_issues_items_1_issues_item_hd','field_6a3b07d706af2'),(201172,2732,'issues_items_1_issues_item_txt','Community housing works. We’re calling on the next NSW Government for three actions: long-term investment for new community housing, more funding to future-proof existing homes, and support to help people stayed housed.'),(201173,2732,'_issues_items_1_issues_item_txt','field_6a3b07fc06af3'),(201174,2732,'issues_items_1_issues_link_text',''),(201175,2732,'_issues_items_1_issues_link_text','field_6a3b080f06af4'),(201176,2732,'issues_items_1_issues_target_url',''),(201177,2732,'_issues_items_1_issues_target_url','field_6a3b082b06af5'),(201178,2732,'issues_items_0_issues_sub_head',''),(201179,2732,'_issues_items_0_issues_sub_head','field_6a3b0aa79365e'),(201180,2732,'issues_items_1_issues_sub_head',''),(201181,2732,'_issues_items_1_issues_sub_head','field_6a3b0aa79365e'),(201182,2732,'issues_items_2_issue_icon','2703'),(201183,2732,'_issues_items_2_issue_icon','field_6a3b07b506af1'),(201184,2732,'issues_items_2_issues_item_hd','The people next door'),(201185,2732,'_issues_items_2_issues_item_hd','field_6a3b07d706af2'),(201186,2732,'issues_items_2_issues_sub_head',''),(201187,2732,'_issues_items_2_issues_sub_head','field_6a3b0aa79365e'),(201188,2732,'issues_items_2_issues_item_txt','Nurses. Childcare workers. Single parents. Older Australians who want to stay near the people they love. Community housing is the solution.'),(201189,2732,'_issues_items_2_issues_item_txt','field_6a3b07fc06af3'),(201190,2732,'issues_items_2_issues_link_text',''),(201191,2732,'_issues_items_2_issues_link_text','field_6a3b080f06af4'),(201192,2732,'issues_items_2_issues_target_url',''),(201193,2732,'_issues_items_2_issues_target_url','field_6a3b082b06af5'),(201194,2732,'video_head','The people next door'),(201195,2732,'_video_head','field_6a5ff269ef234'),(201198,2263,'_oembed_0f581e4b1352d4b70914e448822e2a2a','<iframe title=\"Activate Australia&amp;apos;s Skills\" width=\"500\" height=\"281\" src=\"https://www.youtube.com/embed/pE5IoC1H-KM?feature=oembed\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen></iframe>'),(201199,2263,'_oembed_time_0f581e4b1352d4b70914e448822e2a2a','1784711085'),(201200,2734,'footnotes',''),(201201,2734,'banner_head',''),(201202,2734,'_banner_head','field_5b568121a8ffe'),(201203,2734,'banner_sub',''),(201204,2734,'_banner_sub','field_5b568139fd366'),(201205,2734,'banner_button','<a class=\"btn btn-home\" style=\"width: 200px;\" href=\"#project\">Sign the petition</a>'),(201206,2734,'_b