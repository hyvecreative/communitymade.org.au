1636,'first_image_title','Lifestart is about supporting young children'),(47834,1636,'_first_image_title','field_5b67ca606afc4'),(47835,1636,'first_image_cont','from 0-24 years living with disabilities and their familes'),(47836,1636,'_first_image_cont','field_5b67caff6afc5'),(47837,1636,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(47838,1636,'_first_image_button','field_5b67cb0d6afc6'),(47839,1636,'second _image_title','Lifestart is about supporting young children'),(47840,1636,'_second _image_title','field_5b67cb20ddf9a'),(47841,1636,'second_image_cont','from 0-24 years living with disabilities and their familes'),(47842,1636,'_second_image_cont','field_5b67cb24ddf9b'),(47843,1636,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(47844,1636,'_second_image_button','field_5b67cb29ddf9c'),(47845,1636,'second_image_title','Lifestart is about supporting young children'),(47846,1636,'_second_image_title','field_5b67cb20ddf9a'),(47847,1636,'page_col_image','412'),(47848,1636,'_page_col_image','field_5de6546e7c63a'),(47849,1636,'page_col_image_3','437'),(47850,1636,'_page_col_image_3','field_5de6e3998e07e'),(47851,1636,'sec_2_title','Community'),(47852,1636,'_sec_2_title','field_5de6e3ef2798f'),(47853,1636,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(47854,1636,'_sec_2_text','field_5de78dc89e613'),(47855,1636,'sec_3_title','The Project'),(47856,1636,'_sec_3_title','field_5de6e3d37d8da'),(47857,1636,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(47858,1636,'_sec_3_text','field_5de6e4044e5e8'),(47859,1636,'page_col_image_2','436'),(47860,1636,'_page_col_image_2','field_5de6546e7c63a'),(47861,1636,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(47862,1636,'_sec_2_button','field_5de6e58c86706'),(47863,1636,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(47864,1636,'_sec_3_button','field_5de6e5a243c03'),(47865,1636,'page_col_image_4','455'),(47866,1636,'_page_col_image_4','field_5de70801090ce'),(47867,1636,'sec_4_title','Location'),(47868,1636,'_sec_4_title','field_5de7082a12a81'),(47869,1636,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(47870,1636,'_sec_4_text','field_5de7084812a82'),(47871,1636,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(47872,1636,'_sec_4_button','field_5de7085e12a83'),(47873,1636,'news_title','Project updates'),(47874,1636,'_news_title','field_5de78da3aabb9'),(47875,1636,'sec_2_text_copy',''),(47876,1636,'_sec_2_text_copy','field_5de78dc89e613'),(47877,1636,'timeline-title','Timeline'),(47878,1636,'_timeline-title','field_5de78df29e615'),(47879,1636,'timeline_title','Timeline'),(47880,1636,'_timeline_title','field_5de78df29e615'),(47881,1636,'contact_title','Contact us'),(47882,1636,'_contact_title','field_5de7981e06057'),(47883,1636,'contact_intro','Contact text...'),(47884,1636,'_contact_intro','field_5de7983506058'),(47885,1636,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(47886,1636,'_news_button','field_5de8329896e02'),