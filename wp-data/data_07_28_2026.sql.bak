6e3998e07e'),(49758,1644,'sec_2_title','Community'),(49759,1644,'_sec_2_title','field_5de6e3ef2798f'),(49760,1644,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(49761,1644,'_sec_2_text','field_5de78dc89e613'),(49762,1644,'sec_3_title','The Project'),(49763,1644,'_sec_3_title','field_5de6e3d37d8da'),(49764,1644,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(49765,1644,'_sec_3_text','field_5de6e4044e5e8'),(49766,1644,'page_col_image_2','436'),(49767,1644,'_page_col_image_2','field_5de6546e7c63a'),(49768,1644,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(49769,1644,'_sec_2_button','field_5de6e58c86706'),(49770,1644,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(49771,1644,'_sec_3_button','field_5de6e5a243c03'),(49772,1644,'page_col_image_4','455'),(49773,1644,'_page_col_image_4','field_5de70801090ce'),(49774,1644,'sec_4_title','Location'),(49775,1644,'_sec_4_title','field_5de7082a12a81'),(49776,1644,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(49777,1644,'_sec_4_text','field_5de7084812a82'),(49778,1644,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(49779,1644,'_sec_4_button','field_5de7085e12a83'),(49780,1644,'news_title','Project updates'),(49781,1644,'_news_title','field_5de78da3aabb9'),(49782,1644,'sec_2_text_copy',''),(49783,1644,'_sec_2_text_copy','field_5de78dc89e613'),(49784,1644,'timeline-title','Timeline'),(49785,1644,'_timeline-title','field_5de78df29e615'),(49786,1644,'timeline_title','Timeline'),(49787,1644,'_timeline_title','field_5de78df29e615'),(49788,1644,'contact_title','Contact us'),(49789,1644,'_contact_title','field_5de7981e06057'),(49790,1644,'contact_intro','Contact text...'),(49791,1644,'_contact_intro','field_5de7983506058'),(49792,1644,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(49793,1644,'_news_button','field_5de8329896e02'),(49794,1644,'timeline_intro','Introduction of timeline detail...'),(49795,1644,'_timeline_intro','field_5de98f5fb1781'),(49796,1644,'timeline_pic','477'),(49797,1644,'_timeline_pic','field_5de98f72b1782'),(49798,1644,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(49799,1644,'_timeline_button','field_5de99363677f8'),(49800,1644,'banner_image_position','center'),(49801,1644,'_banner_image_position','field_5f3bc4757dd02'),(49802,1644,'services_title','Our services'),(49803,1644,'_services_title','field_5f20f3cd80eb2'),(49804,1644,'services_items_0_services_item_image','1061'),(49805,1644,'_services_items_0_services_item_image','field_5f2121355be14'),(49806,1644,'services_items_0_sservices_item_title','1300 Telephone counselling line'),(49807,1644,'_services_items_0_sservices_item_title','field_605089efca82e'),(49808,1644,'services_items_0_services_item_text',''),(49809,1644,'_services_items_0_services_item_text','field_5f2121535be15'),(49810,1644,'services_items_0_services_link_url','#'),(49811,1644,'_services_items_0_services_link_url','field_6050866041225'),(49812,1644,'services_items_0_services_li