e super easier for people to understand. <a href=\"//localhost:4000:4000:4000:4000:4000:4000:4000/how/\">More</a> '),(130852,2243,'_intro_boxes_0_box_dropdown','field_65262dead0a0c'),(130853,2243,'intro_boxes_1_box_icon','1941'),(130854,2243,'_intro_boxes_1_box_icon','field_65262db5d36ee'),(130855,2243,'intro_boxes_1_box_title','Projects'),(130856,2243,'_intro_boxes_1_box_title','field_65262d29ed8e3'),(130857,2243,'intro_boxes_1_box_dropdown','Dropdown text'),(130858,2243,'_intro_boxes_1_box_dropdown','field_65262dead0a0c'),(130859,2243,'intro_boxes_2_box_icon','1937'),(130860,2243,'_intro_boxes_2_box_icon','field_65262db5d36ee'),(130861,2243,'intro_boxes_2_box_title','Ideas'),(130862,2243,'_intro_boxes_2_box_title','field_65262d29ed8e3'),(130863,2243,'intro_boxes_2_box_dropdown','Dropdown text'),(130864,2243,'_intro_boxes_2_box_dropdown','field_65262dead0a0c'),(130865,2243,'intro_boxes','3'),(130866,2243,'_intro_boxes','field_65262d14ed8e2'),(130867,2243,'get_help_section_title','Get Help'),(130868,2243,'_get_help_section_title','field_65262c35143de'),(130869,2243,'get_help_block_home',''),(130870,2243,'_get_help_block_home','field_65262c8a143e1'),(130871,2243,'gh_block_home_0_help_image','1956'),(130872,2243,'_gh_block_home_0_help_image','field_65262cd0143e2'),(130873,2243,'gh_block_home_0_help_title','How much do I need to retire? '),(130874,2243,'_gh_block_home_0_help_title','field_65262cec143e3'),(130875,2243,'gh_block_home_0_help_url','#'),(130876,2243,'_gh_block_home_0_help_url','field_65262cf4143e4'),(130877,2243,'gh_block_home_1_help_image','1962'),(130878,2243,'_gh_block_home_1_help_image','field_65262cd0143e2'),(130879,2243,'gh_block_home_1_help_title','I have a problem with  my super fund'),(130880,2243,'_gh_block_home_1_help_title','field_65262cec143e3'),(130881,2243,'gh_block_home_1_help_url','#'),(130882,2243,'_gh_block_home_1_help_url','field_65262cf4143e4'),(130883,2243,'gh_block_home_2_help_image','1961'),(130884,2243,'_gh_block_home_2_help_image','field_65262cd0143e2'),(130885,2243,'gh_block_home_2_help_title','How do I choose the right super? '),(130886,2243,'_gh_block_home_2_help_title','field_65262cec143e3'),(130887,2243,'gh_block_home_2_help_url','#'),(130888,2243,'_gh_block_home_2_help_url','field_65262cf4143e4'),(130889,2243,'gh_block_home','3'),(130890,2243,'_gh_block_home','field_65262c8a143e1'),(130891,2243,'turn_on_insights',''),(130892,2243,'_turn_on_insights','field_645c4a2e654a6'),(130893,2243,'report_questions','a:3:{i:0;s:4:\"1997\";i:1;s:4:\"2067\";i:2;s:4:\"2089\";}'),(130894,2243,'_report_questions','field_6109ed5e02e5a'),(130895,2243,'intro_text','The Disability Dialogue is a place where people with disabilities, their families, organisations providing support, academics, and the wider community come together to work on things that matter to us.\r\n\r\nThe Dialogue is a hub of knowledge and collaboration, separate from government, where we work together to come up. With new ideas on important topics. Our ideas can make a big difference in how services and systems are set up for people with disabilities.'),(130896,2243,'_intro_text','field_66441acfe963c'),(130897,2243,'word_link','#'),(130898,2243,'_word_link','field_6646c69723804'),(130899,2243,'pdf_link','#'),(130900,2243,'_pdf_link','field_6646c6da23805'),(130903,2244,'footnotes',''),(130905,6,'intro_boxes_0_box_image','2241'),(130906,6,'_intro_boxes_0_box_image','field_65262db5d36ee'),(130907,6,'intro_boxes_1_box_image','2179'),(130908,6,'_intro_boxes_1_box_image','field_65262db5d36ee'),(130909,6,'intro_boxes_2_box_image','2012'),(130910,6,'_intro_boxes_2_box_image','field_65262db5d36ee'),(130911,2244,'banner_head',''),(130912,2244,'_banner_head','field_5b568121a8ffe'),(130913,2244,'banner_sub',''),(130914,2244,'_banner_sub','field_5b568139fd366'),(130915,2244,'banner_button','<a class=\"btn btn-home\" style=\"width: 200px;\" href=\"#project\">Sign the petition</a>'),(130916,2244,'_banner_button','field_5b568147fd367'),(130917,2244,'support_section_title','How can Lifestart support you?'),(130918,2244,'_support_section_title','field_5b67c7d060398'),(130919,2244,'support_left_title','Services'),(130920,2244,'_support_left_title','field_5b67c298e7f8f'),(130921,2244,'support_left_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy.'),(130922,2244,'_support_left_cont','field_5b67c5f6e7f91'),(130923,2244,'support_left_button','<a class=\"btn btn-green\" href=\"/services/\">View all services</a>'),(130924,2244,'_support_left_button','field_5b67c60ae7f92'),(130925,2244,'support_ctr_title','Talk to us'),(130926,2244,'_support_ctr_title','field_5b67c62a58af3'),(130927,2244,'support_ctr_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut laoreet.'),(130928,2244,'_support_ctr_cont','field_5b67c63158af4'),(130929,2244,'support_ctr_button','<a class=\"btn btn-orange\" href=\"/supports/\">Find us</a>'),(130930,2244,'_support_ctr_button','field_5b67c63658af5'),(130931,2244,'support_right_title','NDIS Registered provider'),(130932,2244,'_support_right_title','field_5b67c6a38c064'),(130933,2244,'support_right_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut.'),(130934,2244,'_support_right_cont','field_5b67c6c98c065'),(130935,2244,'support_right_button','<a class=\"btn btn-blue\" href=\"#\">Read more</a>'),(130936,2244,'_support_right_button','field_5b67c6dd8c066'),(130937,2244,'first_image_title','Lifestart is about supporting young children'),(130938,2244,'_first_image_title','field_5b67ca606afc4'),(130939,2244,'first_image_cont','from 0-24 years living with disabilities and their familes'),(130940,2244,'_first_image_cont','field_5b67caff6afc5'),(130941,2244,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(130942,2244,'_first_image_button','field_5b67cb0d6afc6'),(130943,2244,'second _image_title','Lifestart is about supporting young children'),(130944,2244,'_second _image_title','field_5b67cb20ddf9a'),(130945,2244,'second_image_cont','from 0-24 years living with disabilities and their familes'),(130946,2244,'_second_image_cont','field_5b67cb24ddf9b'),(130947,2244,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(130948,2244,'_second_image_button','field_5b67cb29ddf9c'),(130949,2244,'second_image_title','Lifestart is about supporting young children'),(130950,2244,'_second_image_title','field_5b67cb20ddf9a'),(130951,2244,'page_col_image','412'),(130952,2244,'_page_col_image','field_5de6546e7c63a'),(130953,2244,'page_col_image_3','437'),(130954,2244,'_page_col_image_3','field_5de6e3998e07e'),(130955,2244,'sec_2_title','Community'),(130956,2244,'_sec_2_title','field_5de6e3ef2798f'),(130957,2244,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(130958,2244,'_sec_2_text','field_5de78dc89e613'),(130959,2244,'sec_3_title','The Project'),(130960,2244,'_sec_3_title','field_5de6e3d37d8da'),(130961,2244,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(130962,2244,'_sec_3_text','field_5de6e4044e5e8'),(130963,2244,'page_col_image_2','436'),(130964,2244,'_page_col_image_2','field_5de6546e7c63a'),(130965,2244,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(130966,2244,'_sec_2_button','field_5de6e58c86706'),(130967,2244,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(130968,2244,'_sec_3_button','field_5de6e5a243c03'),(130969,2244,'page_col_image_4','455'),(130970,2244,'_page_col_image_4','field_5de70801090ce'),(130971,2244,'sec_4_title','Location'),(130972,2244,'_sec_4_title','field_5de7082a12a81'),(130973,2244,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(130974,2244,'_sec_4_text','field_5de7084812a82'),(130975,2244,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(130976,2244,'_sec_4_button','field_5de7085e12a83'),(130977,2244,'news_title','Project updates'),(130978,2244,'_news_title','field_5de78da3aabb9'),(130979,2244,'sec_2_text_copy',''),(130980,2244,'_sec_2_text_copy','field_5de78dc89e613'),(130981,2244,'timeline-title','Timeline'),(130982,2244,'_timeline-title','field_5de78df29e615'),(130983,2244,'timeline_title','Timeline'),(130984,2244,'_timeline_title','field_5de78df29e615'),(130985,2244,'contact_title','Contact us'),(130986,2244,'_contact_title','field_5de7981e06057'),(130987,2244,'contact_intro','Contact text...'),(130988,2244,'_contact_intro','field_5de7983506058'),(130989,2244,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(130990,2244,'_news_button','field_5de8329896e02'),(130991,2244,'timeline_intro','Introduction of timeline detail...'),(130992,2244,'_timeline_intro','field_5de98f5fb1781'),(130993,2244,'timeline_pic','477'),(130994,2244,'_timeline_pic','field_5de98f72b1782'),(130995,2244,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(130996,2244,'_timeline_button','field_5de99363677f8'),(130997,2244,'banner_image_position','center'),(130998,2244,'_banner_image_position'