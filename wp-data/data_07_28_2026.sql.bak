dex_5_survey_title','Battery Storage'),(176177,2606,'_survey_index_5_survey_title','field_6294564042238'),(176178,2606,'survey_index_5_survey_url','#'),(176179,2606,'_survey_index_5_survey_url','field_6294564e42239'),(176180,2606,'survey_index_5_survey_url_text','View Results'),(176181,2606,'_survey_index_5_survey_url_text','field_629456584223a'),(176182,2606,'survey_index_6_survey_icon','1492'),(176183,2606,'_survey_index_6_survey_icon','field_6294562942237'),(176184,2606,'survey_index_6_survey_title','Energy Management'),(176185,2606,'_survey_index_6_survey_title','field_6294564042238'),(176186,2606,'survey_index_6_survey_url','#'),(176187,2606,'_survey_index_6_survey_url','field_6294564e42239'),(176188,2606,'survey_index_6_survey_url_text','View Results'),(176189,2606,'_survey_index_6_survey_url_text','field_629456584223a'),(176190,2606,'survey_index_7_survey_icon','1493'),(176191,2606,'_survey_index_7_survey_icon','field_6294562942237'),(176192,2606,'survey_index_7_survey_title','Going Off-grid'),(176193,2606,'_survey_index_7_survey_title','field_6294564042238'),(176194,2606,'survey_index_7_survey_url','#'),(176195,2606,'_survey_index_7_survey_url','field_6294564e42239'),(176196,2606,'survey_index_7_survey_url_text','View Results'),(176197,2606,'_survey_index_7_survey_url_text','field_629456584223a'),(176198,2606,'survey_index','8'),(176199,2606,'_survey_index','field_6294561242236'),(176200,2606,'report_title','Download the report'),(176201,2606,'_report_title','field_62f30edfb57e1'),(176202,2606,'report_intro','Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus massa erat, consectetur at semper at, feugiat vel orci. '),(176203,2606,'_report_intro','field_62f30eedb57e2'),(176204,2606,'report_link_url','#'),(176205,2606,'_report_link_url','field_62f30ef4b57e3'),(176206,2606,'report_link_text','Download'),(176207,2606,'_report_link_text','field_62f30f01b57e4'),(176208,2606,'solutions_content','The housing system is complex, and no one solution will solve the complex problems we now face but there are some critical first steps to be taken now.\r\n<ul>\r\n 	<li>Set out an ambitious national housing agreement between commonwealth and state governments with targets and funding for the construction of affordable homes.</li>\r\n 	<li>Phase out tax breaks for property investors and using the increase in revenue to build more public housing.</li>\r\n 	<li>Establish laws which limit rental increases beyond what is fair.</li>\r\n 	<li>Rebalance tenancy laws to provide renters with more security and control, such as eliminating no grounds evictions.</li>\r\n 	<li>Phase out stamp duty and replace it with a broad-based land tax.</li>\r\n</ul>\r\n<h4>While there are many opinions on what policy changes will fix the housing market, doing nothing is not an option.</h4>'),(176209,2606,'_solutions_content','field_640e8b307a958'),(176210,2606,'problem_icons_0_prob_icon','1699'),(176211,2606,'_problem_icons_0_prob_icon','field_640fa0291d519'),(176212,2606,'problem_icons_0_prob_concerned_stat','70% highly concerned'),(176213,2606,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(176214,2606,'problem_icons_0_prob_concerded_text','are highly concerned'),(176215,2606,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(176216,2606,'problem_icons_0_prob_issue_text',''),(176217,2606,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(176218,2606,'problem_icons','4'),(176219,2606,'_problem_icons','field_640fa0191d518'),(176220,2606,'ceh_content_left',''),(176221,2606,'_ceh_content_left','field_640e97e8f1c8c'),(176222,2606,'ceh_content_right',''),(176223,2606,'_ceh_content_right','field_640e97fdf1c8d'),(176224,2606,'pc_content_left',''),(176225,2606,'_pc_content_left','field_640e983bf1c8f'),(176226,2606,'pc_content_right',''),(176227,2606,'_pc_content_right','field_640e984df1c90'),(176228,2606,'problem_icons_1_prob_icon','1699'),(176229,2606,'_problem_icons_1_prob_icon','field_640fa0291d519'),(176230,2606,