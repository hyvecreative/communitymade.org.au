'),(93065,1944,'_intro_icons_2_int_icon','field_64e828b33ada2'),(93066,1944,'intro_icons_2_int_icon_text','We have less land classified as ‘protected’ than any other state or territory.'),(93067,1944,'_intro_icons_2_int_icon_text','field_64e828e33ada3'),(93068,1944,'intro_icons','3'),(93069,1944,'_intro_icons','field_64e828963ada1'),(93070,1944,'threat_head_major','What we stand to lose if we don’t act soon to protect beautiful Queensland:'),(93071,1944,'_threat_head_major','field_64ec258d9dbd1'),(93072,1944,'threats_icons','3'),(93073,1944,'_threats_icons','field_64ec2551a93f9'),(93074,1944,'threats_icons_0_thr_icon','1819'),(93075,1944,'_threats_icons_0_thr_icon','field_64ec2551a93fa'),(93076,1944,'threats_icons_0_thr_icon_text','The rich cultural heritage of our First Nations people and their continuous ties to country, dating back more than 50,000 years.'),(93077,1944,'_threats_icons_0_thr_icon_text','field_64ec2551a93fb'),(93078,1944,'threats_icons_1_thr_icon','1819'),(93079,1944,'_threats_icons_1_thr_icon','field_64ec2551a93fa'),(93080,1944,'threats_icons_1_thr_icon_text','Thousands of species of plant and animal which are now classified as threatened or endangered in Queensland.'),(93081,1944,'_threats_icons_1_thr_icon_text','field_64ec2551a93fb'),(93082,1944,'threats_icons_2_thr_icon','1819'),(93083,1944,'_threats_icons_2_thr_icon','field_64ec2551a93fa'),(93084,1944,'threats_icons_2_thr_icon_text','The access to nature that is central to the Queensland way of life.'),(93085,1944,'_threats_icons_2_thr_icon_text','field_64ec2551a93fb'),(93086,1944,'threat_icons_0_thr_icon',''),(93087,1944,'_threat_icons_0_thr_icon','field_64ec2551a93fa'),(93088,1944,'threat_icons_0_thr_icon_text','The <span>rich cultural heritage</span> of our First Nations people and their continuous ties to country, dating back more than 50,000 years.'),(93089,1944,'_threat_icons_0_thr_icon_text','field_64ec2551a93fb'),(93090,1944,'threat_icons_1_thr_icon',''),(93091,1944,'_threat_icons_1_th