ren'),(37766,1524,'_first_image_title','field_5b67ca606afc4'),(37767,1524,'first_image_cont','from 0-24 years living with disabilities and their familes'),(37768,1524,'_first_image_cont','field_5b67caff6afc5'),(37769,1524,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(37770,1524,'_first_image_button','field_5b67cb0d6afc6'),(37771,1524,'second _image_title','Lifestart is about supporting young children'),(37772,1524,'_second _image_title','field_5b67cb20ddf9a'),(37773,1524,'second_image_cont','from 0-24 years living with disabilities and their familes'),(37774,1524,'_second_image_cont','field_5b67cb24ddf9b'),(37775,1524,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(37776,1524,'_second_image_button','field_5b67cb29ddf9c'),(37777,1524,'second_image_title','Lifestart is about supporting young children'),(37778,1524,'_second_image_title','field_5b67cb20ddf9a'),(37779,1524,'page_col_image','412'),(37780,1524,'_page_col_image','field_5de6546e7c63a'),(37781,1524,'page_col_image_3','437'),(37782,1524,'_page_col_image_3','field_5de6e3998e07e'),(37783,1524,'sec_2_title','Community'),(37784,1524,'_sec_2_title','field_5de6e3ef2798f'),(37785,1524,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(37786,1524,'_sec_2_text','field_5de78dc89e613'),(37787,1524,'sec_3_title','The Project'),(37788,1524,'_sec_3_title','field_5de6e3d37d8da'),(37789,1524,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(37790,1524,'_sec_3_text','field_5de6e4044e5e8'),(37791,1524,'page_col_image_2','436'),(37792,1524,'_page_col_image_2','field_5de6546e7c63a'),(37793,1524,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(37794,1524,'_sec_2_button','field_5de6e58c86706'),(37795,1524,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(37796,1524,'_sec_3_button','field_5de6e5a243c03'),(37797,1524,'page_col_image_4','455'),(37798,1524,'_page_col_image_4','field_5de70801090ce'),(37799,1524,'sec_4_title','Location'),(37800,1524,'_sec_4_title','field_5de7082a12a81'),(37801,1524,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(37802,1524,'_sec_4_text','field_5de7084812a82'),(37803,1524,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(37804,1524,'_sec_4_button','field_5de7085e12a83'),(37805,1524,'news_title','Project updates'),(37806,1524,'_news_title','field_5de78da3aabb9'),(37807,1524,'sec_2_text_copy',''),(37808,1524,'_sec_2_text_copy','field_5de78dc89e613'),(37809,1524,'timeline-title','Timeline'),(37810,1524,'_timeline-title','field_5de78df29e615'),(37811,1524,'timeline_title','Timeline'),(37812,1524,'_timeline_title','field_5de78df29e615'),(37813,1524,'contact_title','Contact us'),(37814,1524,'_contact_title','field_5de7981e06057'),(37815,1524,'contact_intro','Contact text...'),(37816,1524,'_contact_intro','field_5de7983506058'),(37817,1524,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(37818,1524,'_news_button','field_5de8329896e02'),(37819,1524,'timeline_intro','Introduction of timeline detail...'),