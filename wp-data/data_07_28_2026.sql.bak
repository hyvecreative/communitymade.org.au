o_icons_1_int_icon_text','field_64e828e33ada3'),(114394,2102,'intro_icons_2_int_icon','1921'),(114395,2102,'_intro_icons_2_int_icon','field_64e828b33ada2'),(114396,2102,'intro_icons_2_int_icon_text','We have less land classified as ‘protected’ than any other state or territory.'),(114397,2102,'_intro_icons_2_int_icon_text','field_64e828e33ada3'),(114398,2102,'intro_icons','3'),(114399,2102,'_intro_icons','field_64e828963ada1'),(114400,2102,'threat_head_major','What we stand to lose if we don’t act soon to protect beautiful Queensland:'),(114401,2102,'_threat_head_major','field_64ec258d9dbd1'),(114402,2102,'threats_icons','3'),(114403,2102,'_threats_icons','field_64ec2551a93f9'),(114404,2102,'threats_icons_0_thr_icon','1819'),(114405,2102,'_threats_icons_0_thr_icon','field_64ec2551a93fa'),(114406,2102,'threats_icons_0_thr_icon_text','The rich cultural heritage of our First Nations people and their continuous ties to country, dating back more than 50,000 years.'),(114407,2102,'_threats_icons_0_thr_icon_text','field_64ec2551a93fb'),(114408,2102,'threats_icons_1_thr_icon','1819'),(114409,2102,'_threats_icons_1_thr_icon','field_64ec2551a93fa'),(114410,2102,'threats_icons_1_thr_icon_text','Thousands of species of plant and animal which are now classified as threatened or endangered in Queensland.'),(114411,2102,'_threats_icons_1_thr_icon_text','field_64ec2551a93fb'),(114412,2102,'threats_icons_2_thr_icon','1819'),(114413,2102,'_threats_icons_2_thr_icon','field_64ec2551a93fa'),(114414,2102,'threats_icons_2_thr_icon_text','The access to nature that is central to the Queensland way of life.'),(114415,2102,'_threats_icons_2_thr_icon_text','field_64ec2551a93fb'),(114416,2102,'threat_icons_0_thr_icon',''),(114417,2102,'_threat_icons_0_thr_icon','field_64ec2551a93fa'),(114418,2102,'threat_icons_0_thr_icon_text','The <span>rich cultural heritage</span> of our First Nations people and their continuous ties to country, dating back more than 50,000 years.'),(114419,2102,'_threat_ico