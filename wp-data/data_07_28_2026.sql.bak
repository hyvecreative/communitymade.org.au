le','Battery Storage'),(96433,1955,'_survey_index_5_survey_title','field_6294564042238'),(96434,1955,'survey_index_5_survey_url','#'),(96435,1955,'_survey_index_5_survey_url','field_6294564e42239'),(96436,1955,'survey_index_5_survey_url_text','View Results'),(96437,1955,'_survey_index_5_survey_url_text','field_629456584223a'),(96438,1955,'survey_index_6_survey_icon','1492'),(96439,1955,'_survey_index_6_survey_icon','field_6294562942237'),(96440,1955,'survey_index_6_survey_title','Energy Management'),(96441,1955,'_survey_index_6_survey_title','field_6294564042238'),(96442,1955,'survey_index_6_survey_url','#'),(96443,1955,'_survey_index_6_survey_url','field_6294564e42239'),(96444,1955,'survey_index_6_survey_url_text','View Results'),(96445,1955,'_survey_index_6_survey_url_text','field_629456584223a'),(96446,1955,'survey_index_7_survey_icon','1493'),(96447,1955,'_survey_index_7_survey_icon','field_6294562942237'),(96448,1955,'survey_index_7_survey_title','Going Off-grid'),(96449,1955,'_survey_index_7_survey_title','field_6294564042238'),(96450,1955,'survey_index_7_survey_url','#'),(96451,1955,'_survey_index_7_survey_url','field_6294564e42239'),(96452,1955,'survey_index_7_survey_url_text','View Results'),(96453,1955,'_survey_index_7_survey_url_text','field_629456584223a'),(96454,1955,'survey_index','8'),(96455,1955,'_survey_index','field_6294561242236'),(96456,1955,'report_title','Download the report'),(96457,1955,'_report_title','field_62f30edfb57e1'),(96458,1955,'report_intro','Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus massa erat, consectetur at semper at, feugiat vel orci. '),(96459,1955,'_report_intro','field_62f30eedb57e2'),(96460,1955,'report_link_url','#'),(96461,1955,'_report_link_url','field_62f30ef4b57e3'),(96462,1955,'report_link_text','Download'),(96463,1955,'_report_link_text','field_62f30f01b57e4'),(96464,1955,'solutions_content','The housing system is complex, and no one solution will solve the complex problems we now face but there are some critical first steps to be taken now.\r\n<ul>\r\n 	<li>Set out an ambitious national housing agreement between commonwealth and state governments with targets and funding for the construction of affordable homes.</li>\r\n 	<li>Phase out tax breaks for property investors and using the increase in revenue to build more public housing.</li>\r\n 	<li>Establish laws which limit rental increases beyond what is fair.</li>\r\n 	<li>Rebalance tenancy laws to provide renters with more security and control, such as eliminating no grounds evictions.</li>\r\n 	<li>Phase out stamp duty and replace it with a broad-based land tax.</li>\r\n</ul>\r\n<h4>While there are many opinions on what policy changes will fix the housing market, doing nothing is not an option.</h4>'),(96465,1955,'_solutions_content','field_640e8b307a958'),(96466,1955,'problem_icons_0_prob_icon','1699'),(96467,1955,'_problem_icons_0_prob_icon','field_640fa0291d519'),(96468,1955,'problem_icons_0_prob_concerned_stat','70% highly concerned'),(96469,1955,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(96470,1955,'problem_icons_0_prob_concerded_text','are highly concerned'),(96471,1955,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(96472,1955,'problem_icons_0_prob_issue_text',''),(96473,1955,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(96474,1955,'problem_icons','4'),(96475,1955,'_problem_icons','field_640fa0191d518'),(96476,1955,'ceh_content_left',''),(96477,1955,'_ceh_content_left','field_640e97e8f1c8c'),(96478,1955,'ceh_content_right',''),(96479,1955,'_ceh_content_right','field_640e97fdf1c8d'),(96480,1955,'pc_content_left',''),(96481,1955,'_pc_content_left','field_640e983bf1c8f'),(96482,1955,'pc_content_right',''),(96483,1955,'_pc_content_right','field_640e984df1c90'),(96484,1955,'problem_icons_1_prob_icon','1699'),(96485,1955,'_problem_icons_1_prob_icon','field_640fa0291d519'),(96486,1955,'problem_icons_1_prob_concerned_stat','69% highly concerned'),(96487,1