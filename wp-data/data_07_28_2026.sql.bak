utton','field_5b67cb29ddf9c'),(156016,2469,'second_image_title','Lifestart is about supporting young children'),(156017,2469,'_second_image_title','field_5b67cb20ddf9a'),(156018,2469,'page_col_image','412'),(156019,2469,'_page_col_image','field_5de6546e7c63a'),(156020,2469,'page_col_image_3','437'),(156021,2469,'_page_col_image_3','field_5de6e3998e07e'),(156022,2469,'sec_2_title','Community'),(156023,2469,'_sec_2_title','field_5de6e3ef2798f'),(156024,2469,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(156025,2469,'_sec_2_text','field_5de78dc89e613'),(156026,2469,'sec_3_title','The Project'),(156027,2469,'_sec_3_title','field_5de6e3d37d8da'),(156028,2469,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(156029,2469,'_sec_3_text','field_5de6e4044e5e8'),(156030,2469,'page_col_image_2','436'),(156031,2469,'_page_col_image_2','field_5de6546e7c63a'),(156032,2469,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(156033,2469,'_sec_2_button','field_5de6e58c86706'),(156034,2469,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(156035,2469,'_sec_3_button','field_5de6e5a243c03'),(156036,2469,'page_col_image_4','455'),(156037,2469,'_page_col_image_4','field_5de70801090ce'),(156038,2469,'sec_4_title','Location'),(156039,2469,'_sec_4_title','field_5de7082a12a81'),(156040,2469,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(156041,2469,'_sec_4_text','field_5de7084812a82'),(156042,2469,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(156043,2469,'_sec_4_button','field_5de7085e12a83'),(156044,2469,'news_title','Project updates'),(156045,2469,'_news_title','field_5de78da3aabb9'),(156046,2469,'sec_2_text_copy',''),(156047,2469,'_sec_2_text_copy','field_5de78dc89e613'),(156048,2469,'timeline-title','Timeline'),(156049,2469,'_timeline-title','field_5de78df29e615'),(156050,2469,'timeline_title','Timeline'),(156051,2469,'_timeline_title','field_5de78df29e615'),(156052,2469,'contact_title','Contact us'),(156053,2469,'_contact_title','field_5de7981e06057'),(156054,2469,'contact_intro','Contact text...'),(156055,2469,'_contact_intro','field_5de7983506058'),(156056,2469,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(156057,2469,'_news_button','field_5de8329896e02'),(156058,2469,'timeline_intro','Introduction of timeline detail...'),(156059,2469,'_timeline_intro','field_5de98f5fb1781'),(156060,2469,'timeline_pic','477'),(156061,2469,'_timeline_pic','field_5de98f72b1782'),(156062,2469,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(156063,2469,'_timeline_button','field_5de99363677f8'),(156064,2469,'banner_image_position','center'),(156065,2469,'_banner_image_position','field_5f3bc4757dd02'),(156066,2469,'services_title','Our services'),(156067,2469,'_services_title','field_5f20f3cd80eb2'),(156068,2469,'services_items_0_services_item_image','1061'),(156069,2469,'_services_items_0_services_item_image','field_5f2121355be14'),(156070,2469,'services_items_0_sservices_item_title','1300 Telephone