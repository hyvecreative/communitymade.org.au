94564e42239'),(130655,2243,'survey_index_6_survey_url_text','View Results'),(130656,2243,'_survey_index_6_survey_url_text','field_629456584223a'),(130657,2243,'survey_index_7_survey_icon','1493'),(130658,2243,'_survey_index_7_survey_icon','field_6294562942237'),(130659,2243,'survey_index_7_survey_title','Going Off-grid'),(130660,2243,'_survey_index_7_survey_title','field_6294564042238'),(130661,2243,'survey_index_7_survey_url','#'),(130662,2243,'_survey_index_7_survey_url','field_6294564e42239'),(130663,2243,'survey_index_7_survey_url_text','View Results'),(130664,2243,'_survey_index_7_survey_url_text','field_629456584223a'),(130665,2243,'survey_index','8'),(130666,2243,'_survey_index','field_6294561242236'),(130667,2243,'report_title','Download the report'),(130668,2243,'_report_title','field_62f30edfb57e1'),(130669,2243,'report_intro','Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus massa erat, consectetur at semper at, feugiat vel orci. '),(130670,2243,'_report_intro','field_62f30eedb57e2'),(130671,2243,'report_link_url','#'),(130672,2243,'_report_link_url','field_62f30ef4b57e3'),(130673,2243,'report_link_text','Download'),(130674,2243,'_report_link_text','field_62f30f01b57e4'),(130675,2243,'solutions_content','The housing system is complex, and no one solution will solve the complex problems we now face but there are some critical first steps to be taken now.\r\n<ul>\r\n 	<li>Set out an ambitious national housing agreement between commonwealth and state governments with targets and funding for the construction of affordable homes.</li>\r\n 	<li>Phase out tax breaks for property investors and using the increase in revenue to build more public housing.</li>\r\n 	<li>Establish laws which limit rental increases beyond what is fair.</li>\r\n 	<li>Rebalance tenancy laws to provide renters with more security and control, such as eliminating no grounds evictions.</li>\r\n 	<li>Phase out stamp duty and replace it with a broad-based land tax.</li>\r\n</ul>\r\n<h4>While there are many opinions on what policy changes will fix the housing market, doing nothing is not an option.</h4>'),(130676,2243,'_solutions_content','field_640e8b307a958'),(130677,2243,'problem_icons_0_prob_icon','1699'),(130678,2243,'_problem_icons_0_prob_icon','field_640fa0291d519'),(130679,2243,'problem_icons_0_prob_concerned_stat','70% highly concerned'),(130680,2243,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(130681,2243,'problem_icons_0_prob_concerded_text','are highly concerned'),(130682,2243,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(130683,2243,'problem_icons_0_prob_issue_text',''),(130684,2243,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(130685,2243,'problem_icons','4'),(130686,2243,'_problem_icons','field_640fa0191d518'),(130687,2243,'ceh_content_left',''),(130688,2243,'_ceh_content_left','field_640e97e8f1c8c'),(130689,2243,'ceh_content_right',''),(130690,2243,'_ceh_content_right','field_640e97fdf1c8d'),(130691,2243,'pc_content_left',''),(130692,2243,'_pc_content_left','field_640e983bf1c8f'),(130693,2243,'pc_content_right',''),(130694,2243,'_pc_content_right','field_640e984df1c90'),(130695,2243,'problem_icons_1_prob_icon','1699'),(130696,2243,'_problem_icons_1_prob_icon','field_640fa0291d519'),(130697,2243,'problem_icons_1_prob_concerned_stat','69% highly concerned'),(130698,2243,'_problem_icons_1_prob_concerned_stat','field_640fa0dd81d95'),(130699,2243,'problem_icons_1_prob_concerded_text','are highly concerned'),(130700,2243,'_problem_icons_1_prob_concerded_text','field_640fa10181d96'),(130701,2243,'problem_icons_1_prob_issue_text',''),(130702,2243,'_problem_icons_1_prob_issue_text','field_640fa11a81d97'),(130703,2243,'problem_icons_2_prob_icon','1699'),(130704,2243,'_problem_icons_2_prob_icon','field_640fa0291d519'),(130705,2243,'problem_icons_2_prob_concerned_stat','64% highly concerned'),(130706,2243,'_problem_icons_2_prob_concerned_stat','field_640fa0dd81d95'),(130707,2243,'problem_icons_2_prob_concerded_text','are highly concerned'),(130708,2243,'_problem_icons_2_prob_concerded_text','field_640fa10181d96'),(130709,2243,'problem_icons_2_prob_issue_text',''),(130710,2243,'_problem_icons_2_prob_issue_text','field_640fa11a81d97'),(130711,2243,'problem_icons_3_prob_icon','1699'),(130712,2243,'_problem_icons_3_prob_icon','field_640fa0291d519'),(130713,2243,'problem_icons_3_prob_concerned_stat','64% highly concerned'),(130714,2243,'_problem_icons_3_prob_concerned_stat','field_640fa0dd81d95'),(130715,2243,'problem_icons_3_prob_concerded_text','are highly concerned'),(130716,2243,'_problem_icons_3_prob_concerded_text','field_640fa10181d96'),(130717,2243,'problem_icons_3_prob_issue_text',''),(130718,2243,'_problem_icons_3_prob_issue_text','field_640fa11a81d97'),(130719,2243,'problem_icons_0_prob_concerned_text','House prices have doubled in a decade'),(130720,2243,'_problem_icons_0_prob_concerned_text','field_640fa10181d96'),(130721,2243,'problem_icons_1_prob_concerned_text','The gap between rich and poor is growing'),(130722,2243,'_problem_icons_1_prob_concerned_text','field_640fa10181d96'),(130723,2243,'problem_icons_2_prob_concerned_text','Construction of social housing is down'),(130724,2243,'_problem_icons_2_prob_concerned_text','field_640fa10181d96'),(130725,2243,'problem_icons_3_prob_concerned_text','Banks are making more than ever from housing'),(130726,2243,'_problem_icons_3_prob_concerned_text','field_640fa10181d96'),(130727,2243,'monitor_content','The Australian Housing Monitor is a large, nationally-representative survey covering public experiences and attitudes toward housing related issues. Questions range from how well the respondent is keeping up with their mortgage/rent, to what they think about social housing construction.\r\n\r\nA broad range of demographic criteria are included, such as gender, location, age, income, voting preference, educational level, tenure type, and employment status. These variables allow CEH researchers to understand the trends and diversity of opinion around the country.\r\n\r\nIt also incorporates questions from previous surveys to track trends over time.\r\nThe inaugural poll was conducted by Essential in December 2022, and was completed by 4,735 people.'),(130728,2243,'_monitor_content','field_640fcc4014404'),(130729,2243,'problem_head','Housing in Australia is not working, and Australians are concerned.'),(130730,2243,'_problem_head','field_641935436aded'),(130731,2243,'problem_signoff','Explore the research showing how concerned Australians are our about the housing situation.'),(130732,2243,'_problem_signoff','field_641935626adee'),(130733,2243,'sections','a:2:{i:0;s:4:\"hero\";i:1;s:9:\"news_grid\";}'),(130734,2243,'_sections','field_5dafb40b8143a'),(130735,2243,'sections_0_is_full_height','1'),(130736,2243,'_sections_0_is_full_height','field_61d6f6fd5a37e'),(130737,2243,'sections_0_image','1648'),(130738,2243,'_sections_0_image','field_61d6f6d45a37d'),(130739,2243,'sections_0_heading','Heading'),(130740,2243,'_sections_0_heading','field_61d6f69e5a379'),(130741,2243,'sections_0_subtitle','Ya ya '),(130742,2243,'_sections_0_subtitle','field_61d6f6ac5a37a'),(130743,2243,'sections_0_link_one',''),(130744,2243,'_sections_0_link_one','field_61d6f6b55a37b'),(130745,2243,'sections_0_link_two',''),(130746,2243,'_sections_0_link_two','field_61d6f6c35a37c'),(130747,2243,'sections_1_select_categories','a:1:{i:0;s:2:\"27\";}'),(130748,2243,'_sections_1_select_categories','field_637f04483b63b'),(130749,2243,'intro_head_major','Welcome to the Disability Dialogue'),(130750,2243,'_intro_head_major','field_64e828783ad9f'),(130751,2243,'intro_head_minor',''),(130752,2243,'_intro_head_minor','field_64e8288c3ada0'),(130753,2243,'intro_icons_0_int_icon','1922'),(130754,2243,'_intro_icons_0_int_icon','field_64e828b33ada2'),(130755,2243,'intro_icons_0_int_icon_text','At 1,727,000 square kilometres, we’re 2.5 times the size of Texas. <span>Yeeha!</span>'),(130756,2243,'_intro_icons_0