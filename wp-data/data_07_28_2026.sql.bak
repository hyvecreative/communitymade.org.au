5b67c6c98c065'),(211568,2785,'support_right_button','<a class=\"btn btn-blue\" href=\"#\">Read more</a>'),(211569,2785,'_support_right_button','field_5b67c6dd8c066'),(211570,2785,'first_image_title','Lifestart is about supporting young children'),(211571,2785,'_first_image_title','field_5b67ca606afc4'),(211572,2785,'first_image_cont','from 0-24 years living with disabilities and their familes'),(211573,2785,'_first_image_cont','field_5b67caff6afc5'),(211574,2785,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(211575,2785,'_first_image_button','field_5b67cb0d6afc6'),(211576,2785,'second _image_title','Lifestart is about supporting young children'),(211577,2785,'_second _image_title','field_5b67cb20ddf9a'),(211578,2785,'second_image_cont','from 0-24 years living with disabilities and their familes'),(211579,2785,'_second_image_cont','field_5b67cb24ddf9b'),(211580,2785,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(211581,2785,'_second_image_button','field_5b67cb29ddf9c'),(211582,2785,'second_image_title','Lifestart is about supporting young children'),(211583,2785,'_second_image_title','field_5b67cb20ddf9a'),(211584,2785,'page_col_image','412'),(211585,2785,'_page_col_image','field_5de6546e7c63a'),(211586,2785,'page_col_image_3','437'),(211587,2785,'_page_col_image_3','field_5de6e3998e07e'),(211588,2785,'sec_2_title','Community'),(211589,2785,'_sec_2_title','field_5de6e3ef2798f'),(211590,2785,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(211591,2785,'_sec_2_text','field_5de78dc89e613'),(211592,2785,'sec_3_title','The Project'),(211593,2785,'_sec_3_title','field_5de6e3d37d8da'),(211594,2785,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(211595,2785,'_sec_3_text','field_5de6e4044e5e8'),(211596,2785,'page_col_image_2','436'),(211597,2785,'_page_col_image_2','field_5de6546e7c63a'),(211598,2785,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(211599,2785,'_sec_2_button','field_5de6e58c86706'),(211600,2785,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(211601,2785,'_sec_3_button','field_5de6e5a243c03'),(211602,2785,'page_col_image_4','455'),(211603,2785,'_page_col_image_4','field_5de70801090ce'),(211604,2785,'sec_4_title','Location'),(211605,2785,'_sec_4_title','field_5de7082a12a81'),(211606,2785,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(211607,2785,'_sec_4_text','field_5de7084812a82'),(211608,2785,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(211609,2785,'_sec_4_button','field_5de7085e12a83'),(211610,2785,'news_title','Project updates'),(211611,2785,'_news_title','field_5de78da3aabb9'),(211612,2785,'sec_2_text_copy',''),(211613,2785,'_sec_2_text_copy','field_5de78dc89e613'),(211614,2785,'timeline-title','Timeline'),(211615,2785,'_timeline-title','field_5de78df29e615'),(211616,2785,'timeline_title','Timeline'),(211617,2785,'_timeline_title','field_5de78df29e615'),(211618,2785,'contact_title','Contact us'),(211619,2785,'_contact_title','field_5de7981e06057'),(211620,2785,'contact_intro',