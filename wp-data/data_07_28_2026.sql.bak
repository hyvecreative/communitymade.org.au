_sub','field_5b568139fd366'),(120492,2160,'banner_button','<a class=\"btn btn-home\" style=\"width: 200px;\" href=\"#project\">Sign the petition</a>'),(120493,2160,'_banner_button','field_5b568147fd367'),(120494,2160,'support_section_title','How can Lifestart support you?'),(120495,2160,'_support_section_title','field_5b67c7d060398'),(120496,2160,'support_left_title','Services'),(120497,2160,'_support_left_title','field_5b67c298e7f8f'),(120498,2160,'support_left_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy.'),(120499,2160,'_support_left_cont','field_5b67c5f6e7f91'),(120500,2160,'support_left_button','<a class=\"btn btn-green\" href=\"/services/\">View all services</a>'),(120501,2160,'_support_left_button','field_5b67c60ae7f92'),(120502,2160,'support_ctr_title','Talk to us'),(120503,2160,'_support_ctr_title','field_5b67c62a58af3'),(120504,2160,'support_ctr_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut laoreet.'),(120505,2160,'_support_ctr_cont','field_5b67c63158af4'),(120506,2160,'support_ctr_button','<a class=\"btn btn-orange\" href=\"/supports/\">Find us</a>'),(120507,2160,'_support_ctr_button','field_5b67c63658af5'),(120508,2160,'support_right_title','NDIS Registered provider'),(120509,2160,'_support_right_title','field_5b67c6a38c064'),(120510,2160,'support_right_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut.'),(120511,2160,'_support_right_cont','field_5b67c6c98c065'),(120512,2160,'support_right_button','<a class=\"btn btn-blue\" href=\"#\">Read more</a>'),(120513,2160,'_support_right_button','field_5b67c6dd8c066'),(120514,2160,'first_image_title','Lifestart is about supporting young children'),(120515,2160,'_first_image_title','field_5b67ca606afc4'),(120516,2160,'first_image_cont','from 0-24 years living with disabilities and their familes'),(120517,2160,'_first_image_cont','field_5b67caff6afc5'),(120518,2160,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(120519,2160,'_first_image_button','field_5b67cb0d6afc6'),(120520,2160,'second _image_title','Lifestart is about supporting young children'),(120521,2160,'_second _image_title','field_5b67cb20ddf9a'),(120522,2160,'second_image_cont','from 0-24 years living with disabilities and their familes'),(120523,2160,'_second_image_cont','field_5b67cb24ddf9b'),(120524,2160,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(120525,2160,'_second_image_button','field_5b67cb29ddf9c'),(120526,2160,'second_image_title','Lifestart is about supporting young children'),(120527,2160,'_second_image_title','field_5b67cb20ddf9a'),(120528,2160,'page_col_image','412'),(120529,2160,'_page_col_image','field_5de6546e7c63a'),(120530,2160,'page_col_image_3','437'),(120531,2160,'_page_col_image_3','field_5de6e3998e07e'),(120532,2160,'sec_2_title','Community'),(120533,2160,'_sec_2_title','field_5de6e3ef2798f'),(120534,2160,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(120535,2160,'_sec_2_text','field_5de78dc89e613'),(120536,2160,'sec_3_title','The Project'),(120537,2160,'_sec_3_title','field_5de6e3d37d8da'),(120538,2160,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(120539,2160,'_sec_3_text','field_5de6e4044e5e8'),(120540,2160,'page_col_image_2','436'),(120541,2160,'_page_col_image_2','field_5de6546e7c63a'),(120542,2160,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(120543,2160,'_sec_2_button','field_5de6e58c86706'),(120544,2160,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(120545,2160,'_sec_3_button','field_5de6e5a243c03'),(120546,2160,'page_col_image_4','455'),(120547,2160,'_page_col_image_4','field_5de70801090ce'),(120548,2160,'sec_4_title','Location'),(120549,2160,'_sec_4_title','field_5de7082a12a81'),(120550,2160,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(120551,2160,'_sec_4_text','field_5de7084812a82'),(120552,2160,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(120553,2160,'_sec_4_button','field_5de7085e12a83'),(120554,2160,'news_title','Project updates'),(120555,2160,'_news_title','field_5de78da3aabb9'),(120556,2160,'sec_2_text_copy',''),(120557,2160,'_sec_2_text_copy','field_5de78dc89e613'),(120558,2160,'timeline-title','Timeline'),(120559,2160,'_timeline-title','field_5de78df29e615'),(120560,2160,'timeline_title','Timeline'),(120561,2160,'_timeline_title','field_5de78df29e615'),(120562,2160,'contact_title','Contact us'),(120563,2160,'_contact_title','field_5de7981e06057'),(120564,2160,'contact_intro','Contact text...'),(120565,2160,'_contact_intro','field_5de7983506058'),(120566,2160,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(120567,2160,'_news_button','field_5de8329896e02'),(120568,2160,'timeline_intro','Introduction of timeline detail...'),(120569,2160,'_timeline_intro','field_5de98f5fb1781'),(120570,2160,'timeline_pic','477'),(120571,2160,'_timeline_pic','field_5de98f72b1782'),(120572,2160,'timeline_but