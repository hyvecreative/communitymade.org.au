72,2346,'_team_members_3_first_name','field_5b7570cf26829'),(138073,2346,'team_members_3_last_name','Maneeva'),(138074,2346,'_team_members_3_last_name','field_5b7570de2682a'),(138075,2346,'team_members_3_member_text','Aliquam erat volutpat Ut wisi enim ad minim veniam laoreet dolore magna.'),(138076,2346,'_team_members_3_member_text','field_5b7570f12682b'),(138077,2346,'team_members_0_member_image','367'),(138078,2346,'_team_members_0_member_image','field_5b7572a89973e'),(138079,2346,'team_members_1_member_image','367'),(138080,2346,'_team_members_1_member_image','field_5b7572a89973e'),(138081,2346,'team_members_2_member_image','367'),(138082,2346,'_team_members_2_member_image','field_5b7572a89973e'),(138083,2346,'team_members_3_member_image','367'),(138084,2346,'_team_members_3_member_image','field_5b7572a89973e'),(138085,2346,'banner_button',''),(138086,2346,'_banner_button','field_5b568147fd367'),(138087,2346,'intro_col_1','The Take Control Campaign is a new movement of people who want to make Australia safer when it comes to drugs.'),(138088,2346,'_intro_col_1','field_5df5c6cef3ddb'),(138089,2346,'intro_col_2','The campaign has been launched by the Ted Noffs Foundation, Australia\'s largest provider of drug and alcohol treatment services for young people. The Foundation strives to help disadvantaged young people become advantaged and supports them on their journey to take back control of their lives.'),(138090,2346,'_intro_col_2','field_5df5c6deee1ca'),(138091,2346,'intro_col_3','With community support, the Take Control Campaign aims to change the conversation surrounding drugs and drug use in Australia. Through our common sense plan, we are demanding governments take control of the issue and fix our broken drug laws.'),(138092,2346,'_intro_col_3','field_5df5c6e99b7a8'),(138093,2346,'intro_logo','610'),(138094,2346,'_intro_logo','field_5df5c6f18c801'),(138095,2346,'intro_title','Decades of failed drug policy have resulted in unnecessary suffering. We have a secret and chaotic black market run by criminals and gangs. We have no control.'),(138096,2346,'_intro_title','field_5df5c6799cfec'),(138097,2346,'intro_bullets','Despite the best efforts of our police forces, for every drug dealer we catch, more simply start and operate with impunity.\r\n\r\nAny teenager can get drugs easily. People who use drugs can’t be sure what they are taking. Innocent young people who are just experimenting can buy themselves a death sentence.\r\n\r\nWorst of all, it’s often hard for people with problems to access help because they\'re treated like criminals.\r\n\r\nThis is because our governments refuse to take control of drugs.\r\n\r\nParents need greater tools and strategies to help their kids cope with the challenges of modern life.\r\n\r\nIt’s not good enough to put our heads in the sand and tell our kids to “just say no”. It doesn\'t work.\r\n\r\nIt\'s time to end the fear tactics. It\'s time to end the marketing gimmicks. People need real resources to reduce the harms associated with drug use.\r\n\r\nOur state and federal governments need to work together to get drug use under control by putting health and safety first.'),(138098,2346,'_intro_bullets','field_5df5c6799d05a'),(138099,2346,'intro_text',''),(138100,2346,'_intro_text','field_5df5c6799d0c6'),(138101,2346,'plan_title',''),(138102,2346,'_plan_title','field_5df5c6799d197'),(138103,2346,'plan_icons_row','5'),(138104,2346,'_plan_icons_row','field_5df5c6799d211'),(138105,2346,'plan_icons_row_0_plan_icon','516'),(138106,2346,'_plan_icons_row_0_plan_icon','field_5df5c679a8044'),(138107,2346,'plan_icons_row_0_plan_icon_text',' Roll out pill testing services nationally to reduce harm at music festivals and parties'),(138108,2346,'_plan_icons_row_0_plan_icon_text','field_5df5c679a80ae'),(138109,2346,'plan_icons_row_1_plan_icon','515'),(138110,2346,'_plan_icons_row_1_plan_icon','field_5df5c679a8044'),(138111,2346,'plan_icons_row_1_plan_icon_text','Expand treatment services for people suffering from drug problems'),(138112,2346,'_plan_icons_row_1_plan_icon_text','field_5df5c679a80ae'),(138113,2346,'plan_icons_row_2_plan_icon','514'),(138114,2346,'_plan_icons_row_2_plan_icon','field_5df5c679a8044'),(138115,2346,'plan_icons_row_2_plan_icon_text','Establish more drug monitoring rooms to save lives and improve communities'),(138116,2346,'_plan_icons_row_2_plan_icon_text','field_5df5c679a80ae'),(138117,2346,'plan_icons_row_3_plan_icon','513'),(138118,2346,'_plan_icons_row_3_plan_icon','field_5df5c679a8044'),(138119,2346,'plan_icons_row_3_plan_icon_text','Enhance engagement services for disadvantaged young people'),(138120,2346,'_plan_icons_row_3_plan_icon_text','field_5df5c679a80ae'),(138121,2346,'plan_icons_row_4_plan_icon','512'),(138122,2346,'_plan_icons_row_4_plan_icon','field_5df5c679a8044'),(138123,2346,'plan_icons_row_4_plan_icon_text','End criminal charges that make getting help harder and ruin young lives for minor possession of illicit drugs'),(138124,2346,'_plan_icons_row_4_plan_icon_text','field_5df5c679a80ae'),(138125,2346,'banner_image_position','center'),(138126,2346,'_banner_image_position','field_5f3bc4757dd02'),(138127,2346,'page_image','861'),(138128,2346,'_page_image','field_5f868320f904a'),(138129,2346,'echo_title','0'),(138130,2346,'_echo_title','field_5f868f339dd59'),(138131,2346,'problem_panel_title',''),(138132,2346,'_problem_panel_title','field_5f20f3cd80eb2'),(138133,2346,'problem_panel_items',''),(138134,2346,'_problem_panel_items','field_5f20f3dbe5a77'),(138135,2346,'problem_subhead',''),(138136,2346,'_problem_subhead','field_5f2121dff763d'),(138137,2346,'solution_title',''),(138138,2346,'_solution_title','field_5f21219394b8b'),(138139,2346,'solution_panel_items',''),(138140,2346,'_solution_panel_items','field_5f2121a594b8c'),(138141,2346,'mship_title',''),(138142,2346,'_mship_title','field_5f8fb9dc29b4c'),(138143,2346,'mship_intro',''),(138144,2346,'_mship_intro','field_5f8fb9f129b4d'),(138145,2346,'mship_benefit_items',''),(13