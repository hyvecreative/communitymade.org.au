ey_url','#'),(90265,1938,'_survey_index_6_survey_url','field_6294564e42239'),(90266,1938,'survey_index_6_survey_url_text','View Results'),(90267,1938,'_survey_index_6_survey_url_text','field_629456584223a'),(90268,1938,'survey_index_7_survey_icon','1493'),(90269,1938,'_survey_index_7_survey_icon','field_6294562942237'),(90270,1938,'survey_index_7_survey_title','Going Off-grid'),(90271,1938,'_survey_index_7_survey_title','field_6294564042238'),(90272,1938,'survey_index_7_survey_url','#'),(90273,1938,'_survey_index_7_survey_url','field_6294564e42239'),(90274,1938,'survey_index_7_survey_url_text','View Results'),(90275,1938,'_survey_index_7_survey_url_text','field_629456584223a'),(90276,1938,'survey_index','8'),(90277,1938,'_survey_index','field_6294561242236'),(90278,1938,'report_title','Download the report'),(90279,1938,'_report_title','field_62f30edfb57e1'),(90280,1938,'report_intro','Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus massa erat, consectetur at semper at, feugiat vel orci. '),(90281,1938,'_report_intro','field_62f30eedb57e2'),(90282,1938,'report_link_url','#'),(90283,1938,'_report_link_url','field_62f30ef4b57e3'),(90284,1938,'report_link_text','Download'),(90285,1938,'_report_link_text','field_62f30f01b57e4'),(90286,1938,'solutions_content','The housing system is complex, and no one solution will solve the complex problems we now face but there are some critical first steps to be taken now.\r\n<ul>\r\n 	<li>Set out an ambitious national housing agreement between commonwealth and state governments with targets and funding for the construction of affordable homes.</li>\r\n 	<li>Phase out tax breaks for property investors and using the increase in revenue to build more public housing.</li>\r\n 	<li>Establish laws which limit rental increases beyond what is fair.</li>\r\n 	<li>Rebalance tenancy laws to provide renters with more security and control, such as eliminating no grounds evictions.</li>\r\n 	<li>Phase out stamp duty and replace it with a broad-based land tax.</li>\r\n</ul>\r\n<h4>While there are many opinions on what policy changes will fix the housing market, doing nothing is not an option.</h4>'),(90287,1938,'_solutions_content','field_640e8b307a958'),(90288,1938,'problem_icons_0_prob_icon','1699'),(90289,1938,'_problem_icons_0_prob_icon','field_640fa0291d519'),(90290,1938,'problem_icons_0_prob_concerned_stat','70% highly concerned'),(90291,1938,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(90292,1938,'problem_icons_0_prob_concerded_text','are highly concerned'),(90293,1938,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(90294,1938,'problem_icons_0_prob_issue_text',''),(90295,1938,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(90296,1938,'problem_icons','4'),(90297,1938,'_problem_icons','field_640fa0191d518'),(90298,1938,'ceh_content_left',''),(90299,1938,'_ceh_content_left','field_640e97e8f1c8c'),(90300,1938,'ceh_content_right',''),(90301,1938,'_ceh_content_right','field_640e97fdf1c8d'),(90302,1938,'pc_content_left',''),(90303,1938,'_pc_content_left','field_640e983bf1c8f'),(90304,1938,'pc_content_right',''),(90305,1938,'_pc_content_right','field_640e984df1c90'),(90306,1938,'problem_icons_1_prob_icon','1699'),(90307,1938,'_problem_icons_1_prob_icon','field_640fa0291d519'),(90308,1938,'problem_icons_1_prob_concerned_stat','69% highly concerned'),(90309,1938,'_problem_icons_1_prob_concerned_stat','field_640fa0dd81d95'),(90310,1938,'problem_icons_1_prob_concerded_text','are highly concerned'),(90311,1938,'_problem_icons_1_prob_concerded_text','field_640fa10181d96'),(90312,1938,'problem_icons_1_prob_issue_text',''),(90313,1938,'_problem_icons_1_prob_issue_text','field_640fa11a81d97'),(90314,1938,'problem_icons_2_prob_icon','1699'),(90315,1938,'_problem_icons_2_prob_icon','field_640fa0291d519'),(90316,1938,'problem_icons_2_prob_concerned_stat','64% highly concerned'),(90317,1938,'_problem_icons_2_prob_concerned_stat','field_640fa0dd81d95'),(90318,1938,'problem_icons_2_prob_concerded_text','are highly concerned'),(90319,1938,'_problem_icons_2_prob_concerded_text','field_640fa10181d96'),(90320,1938,'problem_icons_2_prob_issue_text',''),(90321,1938,'_problem_icons_2_prob_issue_text','field_640fa11a81d97'),(90322,1938,'problem_icons_3_prob_icon','1699'),(90323,1938,'_problem_icons_3_prob_icon','field_640fa0291d519'),(90324,1938,'problem_icons_3_prob_concerned_stat','64% highly concerned'),(90325,1938,'_problem_icons_3_prob_concerned_stat','field_640fa0dd81d95'),(90326,1938,'problem_icons_3_prob_concerded_text','are highly concerned'),(90327,1938,'_problem_icons_3_prob_concerded_text','field_640fa10181d96'),(90328,1938,'problem_icons_3_prob_issue_text',''),(90329,1938,'_problem_icons_3_prob_issue_text','field_640fa11a81d97'),(90330,1938,'problem_icons_0_prob_concerned_text','House prices have doubled in a decade'),(90331,1938,'_problem_icons_0_prob_concerned_text','field_640fa10181d96'),(90332,1938,'problem_icons_1_prob_concerned_text','The gap between rich and poor is growing'),(90333,1938,'_problem_icons_1_prob_concerned_text','field_640fa10181d96'),(90334,1938,'problem_icons_2_prob_concerned_text','Construction of social housing is down'),(90335,1938,'_problem_icons_2_prob_concerned_text','field_640fa10181d96'),(90336,1938,'problem_icons_3_prob_concerned_text','Banks are making more than ever from housing'),(90337,1938,'_problem_icons_3_prob_concerned_text','field_640fa10181d96'),(90338,1938,'monitor_content','The Australian Housing Monitor is a large, nationally-representative survey covering public experiences and attitudes toward housing related issues. Questions range from how well the respondent is keeping up with their mortgage/rent, to what they think about social housing construction.\r\n\r\nA broad range of demographic criteria are included, such as gender, location, age, income, voting preference, educational level, tenure type, and employment status. These variables allow CEH researchers to understand the trends and diversity of opinion around the country.\r\n\r\nIt also incorporates questions from previous surveys to track trends over time.\r\nThe inaugural poll was conducted by Essential in December 2022, and was completed by 4,735 people.'),(90339,1938,'_monitor_content','field_640fcc4014404'),(90340,1938,'problem_head','Housing in Australia is not working, and Australians are concerned.'),(90341,1938,'_problem_head','field_641935436aded'),(90342,1938,'problem_signoff','Explore the research showing how concerned Australians are our about the housing situation.'),(90343,1938,'_problem_signoff','field_641935626adee'),(90344,1938,'sections','a:2:{i:0;s:4:\"hero\";i:1;s:9:\"news_grid\";}'),(90345,1938,'_sections','field_5dafb40b8143a'),(90346,1938,'sections_0_is_full_height','1'),(90347,1938,'_sections_0_is_full_height','field_61d6f6fd5a37e'),(90348,1938,'sections_0_image','1648'),(90349,1938,'_sections_0_image','field_61d6f6d45a37d'),(90350,1938,'sections_0_heading','Heading'),(90351,1938,'_sections_0_heading','field_61d6f69e5a379'),(90352,1938,'sections_0_subtitle','Ya ya '),(90353,1938,'_sections_0_subtitle','field_61d6f6ac5a37a'),(90354,1938,'sections_0_link_one',''),(90355,1938,'_sections_0_link_one','field_61d6f6b55a37b'),(90356,1938,'sections_0_link_two',''),(90357,1938,'_sections_0_link_two','field_61d6f6c35a37c'),(90358,1938,'sections_1_select_categories','a:1:{i:0;s:2:\"27\";}'),(90359,1938,'_sections_1_select_categories','field_637f04483b63b'),(90360,1938,'intro_head_major','Super Consumers Australia is <span>fighting</span> to ensure that the superannuation industry is <span>held accountable</span> for the outcomes they deliver to Australian consumers.'),(90361,1938,'_intro_head_major','field_64e828783ad9f'),(90362,1938,'intro_head_minor','We want super to work for everyone—not just super fund companies. With our research, journalism and campaigns we are creating the trustworthy and transparent superannuation system we all deserve.'),(90363,1938,'_intro_head_minor','field_64e8288c3ada0'),(90364,1938,'intro_icons_0_int_icon','1922'),(90365,1938,'_intro_icons_0_int_icon','field_64e828b33ada2'),(90366,1938,'intro_icons_0_int_icon_text','At 1,727,000 square kilometres, we’re 2.5 times the size of Texas. <span>Yeeha!</span>'),(90367,1938,'_intro_icons_0_int_icon_text','field_64e828e33ada3'),(90368,1938,'intro_icons_1_int_icon','1920'),(90369,1938,'_intro_icons_1_int_icon','field_64e828b33ada2'),(90370,1938,'intro_icons_1_int_icon_text','We have twice as many species of native plant and animal as any other Australian state or territory.'),(90371,1938,'_intro_icons_1_int_icon_text','field_64e828e33ada3'),(90372,1938,'intro_icons_2_int_icon','1921'),(90373,1938,'_intro_icons_2_int_icon','field_64e828b33ada2'),(90374,1938,'intro_icons_2_int_icon_text','We have less land classified as ‘protected’ than any other state or territory.'),(90375,1938,'_intro_icons_2_int_icon_text','field_64e828e33ada3'),(90376,1938,'intro_icons','3'),(90377,1938,'_intro_icons','field_64e828963ada1'),(90378,1938,'threat_head_major','What we stand to lose if we don’t act soon to protect beautiful Queensland:'),(90379,1938,'_threat_head_major','field_64ec258d9dbd1'),(90380,1938,'threats_icons','3'),(90381,1938,'_threats_icons','field_64ec2551a93f9'),(90382,1938,'threats_icons_0_thr_icon','1819'),(90383,1938,'_threats_icons_0_thr_icon','field_64ec2551a93fa'),(90384,1938,'threats_icons_0_thr_icon_text','The rich cultural heritage of our First Nations people and their continuous ties to country, dating back more than 50,000 years.'),(90385,1938,'_threats_icons_0_thr_icon_text','field_64ec2551a93fb'),(90386,1938,'threats_icons_1_thr_icon','1819'),(90387,1938,'_threats_icons_1_thr_icon','field_64ec2551a93fa'),(90388,1938,'threats_icons_1_thr_icon_text','Thousands of species of plant and animal which are now classified as threatened or endangered in Queensland.'),(90389,1938,'_threats_icons_1_thr_icon_text','field_64ec2551a93fb'),(90390,1938,'threats_ic