b_concerned_stat','field_640fa0dd81d95'),(208777,2763,'problem_icons_3_prob_concerded_text','are highly concerned'),(208778,2763,'_problem_icons_3_prob_concerded_text','field_640fa10181d96'),(208779,2763,'problem_icons_3_prob_issue_text',''),(208780,2763,'_problem_icons_3_prob_issue_text','field_640fa11a81d97'),(208781,2763,'problem_icons_0_prob_concerned_text','House prices have doubled in a decade'),(208782,2763,'_problem_icons_0_prob_concerned_text','field_640fa10181d96'),(208783,2763,'problem_icons_1_prob_concerned_text','The gap between rich and poor is growing'),(208784,2763,'_problem_icons_1_prob_concerned_text','field_640fa10181d96'),(208785,2763,'problem_icons_2_prob_concerned_text','Construction of social housing is down'),(208786,2763,'_problem_icons_2_prob_concerned_text','field_640fa10181d96'),(208787,2763,'problem_icons_3_prob_concerned_text','Banks are making more than ever from housing'),(208788,2763,'_problem_icons_3_prob_concerned_text','field_640fa10181d96'),(208789,2763,'monitor_content','The Australian Housing Monitor is a large, nationally-representative survey covering public experiences and attitudes toward housing related issues. Questions range from how well the respondent is keeping up with their mortgage/rent, to what they think about social housing construction.\r\n\r\nA broad range of demographic criteria are included, such as gender, location, age, income, voting preference, educational level, tenure type, and employment status. These variables allow CEH researchers to understand the trends and diversity of opinion around the country.\r\n\r\nIt also incorporates questions from previous surveys to track trends over time.\r\nThe inaugural poll was conducted by Essential in December 2022, and was completed by 4,735 people.'),(208790,2763,'_monitor_content','field_640fcc4014404'),(208791,2763,'problem_head','Housing in Australia is not working, and Australians are concerned.'),(208792,2763,'_problem_head','field_641935436aded'),(208793,2763,'problem_signoff','Explore the research showing how concerned Australians are our about the housing situation.'),(208794,2763,'_problem_signoff','field_641935626adee'),(208795,2763,'sections','a:2:{i:0;s:4:\"hero\";i:1;s:9:\"news_grid\";}'),(208796,2763,'_sections','field_5dafb40b8143a'),(208797,2763,'sections_0_is_full_height','1'),(208798,2763,'_sections_0_is_full_height','field_61d6f6fd5a37e'),(208799,2763,'sections_0_image','1648'),(208800,2763,'_sections_0_image','field_61d6f6d45a37d'),(208801,2763,'sections_0_heading','Heading'),(208802,2763,'_sections_0_heading','field_61d6f69e5a379'),(208803,2763,'sections_0_subtitle','Ya ya '),(208804,2763,'_sections_0_subtitle','field_61d6f6ac5a37a'),(208805,2763,'sections_0_link_one',''),(208806,2763,'_sections_0_link_one','field_61d6f6b55a37b'),(208807,2763,'sections_0_link_two',''),(208808,2763,'_sections_0_link_two','field_61d6f6c35a37c'),(208809,2763,'sections_1_select_categories','a:1:{i:0;s:2:\"27\";}'),(208810,2763,'_sections_1_select_categories','field_637f04483b63b'),(208811,2763,'intro_head_major','Welcome to the Disability Dialogue'),(208812,2763,'_intro_head_major','field_64e828783ad9f'),(208813,2763,'intro_head_minor',''),(208814,2763,'_intro_head_minor','field_64e8288c3ada0'),(208815,2763,'intro_icons_0_int_icon','1922'),(208816,2763,'_intro_icons_0_int_icon','field_64e828b33ada2'),(208817,2763,'intro_icons_0_int_icon_text','At 1,727,000 square kilometres, we’re 2.5 times the size of Texas. <span>Yeeha!</span>'),(208818,2763,'_intro_icons_0_int_icon_text','field_64e828e33ada3'),(208819,2763,'intro_icons_1_int_icon','1920'),(208820,2763,'_intro_icons_1_int_icon','field_64e828b33ada2'),(208821,2763,'intro_icons_1_int_icon_text','We have twice as many species of native plant and animal as any other Australian state or territory.'),(208822,2763,'_intro_icons_1_int_icon_text','field_64e828e33ada3'),(208823,2763,'intro_icons_2_int_icon','1921'),(208824,2763,'_intro_icons_2_int_icon','field_64e828b33ada2'),(20882