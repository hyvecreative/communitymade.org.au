t_button','field_5b67c6dd8c066'),(74476,1869,'first_image_title','Lifestart is about supporting young children'),(74477,1869,'_first_image_title','field_5b67ca606afc4'),(74478,1869,'first_image_cont','from 0-24 years living with disabilities and their familes'),(74479,1869,'_first_image_cont','field_5b67caff6afc5'),(74480,1869,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(74481,1869,'_first_image_button','field_5b67cb0d6afc6'),(74482,1869,'second _image_title','Lifestart is about supporting young children'),(74483,1869,'_second _image_title','field_5b67cb20ddf9a'),(74484,1869,'second_image_cont','from 0-24 years living with disabilities and their familes'),(74485,1869,'_second_image_cont','field_5b67cb24ddf9b'),(74486,1869,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(74487,1869,'_second_image_button','field_5b67cb29ddf9c'),(74488,1869,'second_image_title','Lifestart is about supporting young children'),(74489,1869,'_second_image_title','field_5b67cb20ddf9a'),(74490,1869,'page_col_image','412'),(74491,1869,'_page_col_image','field_5de6546e7c63a'),(74492,1869,'page_col_image_3','437'),(74493,1869,'_page_col_image_3','field_5de6e3998e07e'),(74494,1869,'sec_2_title','Community'),(74495,1869,'_sec_2_title','field_5de6e3ef2798f'),(74496,1869,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(74497,1869,'_sec_2_text','field_5de78dc89e613'),(74498,1869,'sec_3_title','The Project'),(74499,1869,'_sec_3_title','field_5de6e3d37d8da'),(74500,1869,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(74501,1869,'_sec_3_text','field_5de6e4044e5e8'),(74502,1869,'page_col_image_2','436'),(74503,1869,'_page_col_image_2','field_5de6546e7c63a'),(74504,1869,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(74505,1869,'_sec_2_button','field_5de6e58c86706'),(74506,1869,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(74507,1869,'_sec_3_button','field_5de6e5a243c03'),(74508,1869,'page_col_image_4','455'),(74509,1869,'_page_col_image_4','field_5de70801090ce'),(74510,1869,'sec_4_title','Location'),(74511,1869,'_sec_4_title','field_5de7082a12a81'),(74512,1869,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(74513,1869,'_sec_4_text','field_5de7084812a82'),(74514,1869,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(74515,1869,'_sec_4_button','field_5de7085e12a83'),(74516,1869,'news_title','Project updates'),(74517,1869,'_news_title','field_5de78da3aabb9'),(74518,1869,'sec_2_text_copy',''),(74519,1869,'_sec_2_text_copy','field_5de78dc89e613'),(74520,1869,'timeline-title','Timeline'),(74521,1869,'_timeline-title','field_5de78df29e615'),(74522,1869,'timeline_title','Timeline'),(74523,1869,'_timeline_title','field_5de78df29e615'),(74524,1869,'contact_title','Contact us'),(74525,1869,'_contact_title','field_5de7981e06057'),(74526,1869,'contact_intro','Contact text...'),(74527,1869,'_contact_intro','field_5de7983506058'),(74528,1869,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(74529,186