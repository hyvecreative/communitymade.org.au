1_box_icon','field_65262db5d36ee'),(182398,2672,'intro_boxes_1_box_title','Projects'),(182399,2672,'_intro_boxes_1_box_title','field_65262d29ed8e3'),(182400,2672,'intro_boxes_1_box_dropdown','Our rigorous, conflict-free research and data analysis lifts the lid on fund performance, fees and insurance. Drawing on our policy expertise, we turn this analysis into action by using it to back reform and make super easier for people to understand. <a href=\"//localhost:4000:4000:4000:4000:4000:4000:/how/\">More</a>'),(182401,2672,'_intro_boxes_1_box_dropdown','field_65262dead0a0c'),(182402,2672,'intro_boxes_2_box_icon','1937'),(182403,2672,'_intro_boxes_2_box_icon','field_65262db5d36ee'),(182404,2672,'intro_boxes_2_box_title','Ideas'),(182405,2672,'_intro_boxes_2_box_title','field_65262d29ed8e3'),(182406,2672,'intro_boxes_2_box_dropdown','Our rigorous, conflict-free research and data analysis lifts the lid on fund performance, fees and insurance. Drawing on our policy expertise, we turn this analysis into action by using it to back reform and make super easier for people to understand. <a href=\"//localhost:4000:4000:4000:4000:4000:4000:/how/\">More</a>'),(182407,2672,'_intro_boxes_2_box_dropdown','field_65262dead0a0c'),(182408,2672,'intro_boxes','3'),(182409,2672,'_intro_boxes','field_65262d14ed8e2'),(182410,2672,'get_help_section_title','Get Help'),(182411,2672,'_get_help_section_title','field_65262c35143de'),(182412,2672,'get_help_block_home',''),(182413,2672,'_get_help_block_home','field_65262c8a143e1'),(182414,2672,'gh_block_home_0_help_image','1956'),(182415,2672,'_gh_block_home_0_help_image','field_65262cd0143e2'),(182416,2672,'gh_block_home_0_help_title','How much do I need to retire? '),(182417,2672,'_gh_block_home_0_help_title','field_65262cec143e3'),(182418,2672,'gh_block_home_0_help_url','#'),(182419,2672,'_gh_block_home_0_help_url','field_65262cf4143e4'),(182420,2672,'gh_block_home_1_help_image','1962'),(182421,2672,'_gh_block_home_1_help_image','field_65262cd0143e2'),(182422,2672,'gh_block_home_1_help_title','I have a problem with  my super fund'),(182423,2672,'_gh_block_home_1_help_title','field_65262cec143e3'),(182424,2672,'gh_block_home_1_help_url','#'),(182425,2672,'_gh_block_home_1_help_url','field_65262cf4143e4'),(182426,2672,'gh_block_home_2_help_image','1961'),(182427,2672,'_gh_block_home_2_help_image','field_65262cd0143e2'),(182428,2672,'gh_block_home_2_help_title','How do I choose the right super? '),(182429,2672,'_gh_block_home_2_help_title','field_65262cec143e3'),(182430,2672,'gh_block_home_2_help_url','#'),(182431,2672,'_gh_block_home_2_help_url','field_65262cf4143e4'),(182432,2672,'gh_block_home','3'),(182433,2672,'_gh_block_home','field_65262c8a143e1'),(182434,2672,'turn_on_insights',''),(182435,2672,'_turn_on_insights','field_645c4a2e654a6'),(182436,2672,'report_questions','a:3:{i:0;s:2:\"59\";i:1;s:2:\"61\";i:2;s:4:\"2587\";}'),(182437,2672,'_report_questions','field_6109ed5e02e5a'),(182438,2672,'intro_text','The Disability Dialogue is a place where people with disabilities, their families, organisations providing support, academics, and the wider community come together to work on things that matter to us.\r\n\r\nThe Dialogue is a hub of knowledge and collaboration, separate from government, where we work together to come up. With new ideas on important topics. Our ideas can make a big difference in how services and systems are set up for people with disabilities.'),(182439,2672,'_intro_text','field_66441acfe963c'),(182440,2672,'word_link','#'),(182441,2672,'_word_link','field_6646c69723804'),(182442,2672,'pdf_link','#'),(182443,2672,'_pdf_link','field_6646c6da23805'),(182444,2672,'intro_boxes_0_box_image','2241'),(182445,2672,'_intro_boxes_0_box_image','field_65262db5d36ee'),(182446,2672,'intro_boxes_1_box_image','2179'),(182447,2672,'_intro_boxes_1_box_image','field_65262db5d36ee'),(182448,2672,'intro_boxes_2_box_image','2012'),(182449,2672,'_intro_boxes_2_box_image','field_65262db5d36ee'),(182450,2672,'intro_boxes_0_box_excerpt','Excerpt text here just a sentance or so and no more.'),(182451,2672,'_intro_boxes_0_box_excerpt','field_665975273e827'),(182452,2672,'intro_boxes_1_box_excerpt','Excerpt text here just a sentance or so and no more.'),(182453,2672,'_intro_boxes_1_box_excerpt','field_665975273e827'),(182454,2672,'intro_boxes_2_box_excerpt','Excerpt text here just a sentance or so and no more.'),(182455,2672,'_intro_boxes_2_box_excerpt','field_665975273e827'),(182456,2672,'intro_boxes_0_btn-text','Latest events'),(182457,2672,'_intro_boxes_0_btn-text','field_665abda8b8d4b'),(182458,2672,'intro_boxes_1_btn-text','Latest projects'),(182459,2672,'_intro_boxes_1_btn-text','field_665abda8b8d4b'),(182460,2672,'intro_boxes_2_btn-text','Latest ideas'),(182461,2672,'_intro_boxes_2_btn-text','field_665abda8b8d4b'),(182462,2672,'display-easy-read',''),(182463,2672,'_display-easy-read','field_666129bd2da00'),(182464,2672,'hm_hero_sum','Statement about the issue and lost life savings'),(182465,2672,'_hm_hero_sum','field_64ed37241effa'),(182466,2672,'hm_hero_sub','By investing in the Shield and First Guardian master funds'),(182467,2672,'_hm_hero_sub','field_64ed37241effa'),(182468,2672,'intro_head','We’re here to help.'),(182469,2672,'_intro_head','field_64e828783ad9f'),(182470,2672,'intro_content','About 12,000 people invested their hard-earned super savings in two investment funds which have now collapsed, called Shield Master Fund and First Guardian Master Fund. Most people will be entitled to get some money back, but you need to take action soon. This website has information and tools to help you understand what happened, where to get help and how to take back your super.'),(182471,2672,'_intro_content','field_66441acfe963c'),(182472,2672,'deadline_heading','Important deadlines'),(182473,2672,'_deadline_heading','field_69365ff82e6f2'),(182474,2672,'deadline_content','You need to take action before the deadline to take your super back.'),(182475,2672,'_deadline_content','field_693660342e6f3'),(182476,2672,'deadline_button_text','Find out more'),(182477,2672,'_deadline_button_text','field_693660482e6f4'),(182478,2672,'deadline_button_url','/key-deadlines/'),(182479,2672,'_deadline_button_url','field_693660912e6f5'),(182480,2672,'what_head','What happened?'),(182481,2672,'_what_head','field_69366611096ac'),(182482,2672,'what_happened_0_happ_sub','What are Shield and First Guardian?'),(182483,2672,'_what_happened_0_happ_sub','field_693d4a8b4197d'),(182484,2672,'what_happened_0_happ_content','About 12,000 people invested their hard-earned super savings in two investment funds called Shield Master Fund and First Guardian Master Fund. Those funds have collapsed, and a large part of the $1.2 billion people invested is gone.\r\n\r\nMost people invested through financial advisers who contacted them after they clicked on a social media ad offering a free super comparison or review.'),(182485,2672,'_what_happened_0_happ_content','field_693d4aa84197e'),(182486,2672,'what_happened_0_happ_url','/what-happened/'),(182487,2672,'_what_happened_0_happ_url','field_693d4aba4197f'),(182488,2672,'what_happened_0_happ_link_text','More'),(182489,2672,'_what_happened_0_happ_link_text','field_693d4ad641980'),(182490,2672,'what_happened_1_happ_sub','What is being done about this?'),(182491,2672,'_what_happened_1_happ_sub','field_693d4a8b4197d'),(182492,2672,'what_happened_1_happ_content','There is a lot of work being done to try to get money back for people who invested.\r\n\r\nThe regulator is also investigating what happened and has started enforcement action against a number of different people and companies for their involvement in the collapses of Shield and First Guardian Master Funds. Learn about the progress of this work'),(182493,2672,'_what_happened_1_happ_content','field_693d4aa84197e'),(182494,2672,'what_happened_1_happ_url','/what-happened/'),(182495,2672,'_what_happened_1_happ_url','field_693d4aba4197f'),(182496,2672,'what_happened_1_happ_link_text','More'),(182497,2672,'_what_happened_1_happ_link_text','field_693d4ad641980'),(182498,2672,'what_happened','2'),(182499,2672,'_what_happened','field_693d4a6f4197c'),(182500,2672,'what_happened_0_happ_icon','2605'),(182501,2672,'_what_happened_0_happ_icon','field_693d4c9b3ec4d'),(182502,2672,'what_happened_1_happ_icon','2604'),(182503,2672,'_what_happened_1_happ_icon','field_693d4c9b3ec4d'),(182504,2672,'display_news_section',''),(182505,2672,'_display_news_section','field_69434cc6d5f7d'),(182506,2673,'show_modified_date',''),(182507,2673,'_show_modified_date','field_6941f3e775d5f'),(182508,2674,'show_modified_date',''),(182509,2674,'_show_modified_date','field_6941f3e775d5f'),(182510,2675,'show_modified_date',''),(182511,2675,'_show_modified_date','field_6941f3e775d5f'),(182512,2676,'show_modified_date',''),(182513,2676,'_show_modified_date','field_6941f3e775d5f'),(182514,2146,'_wpa_old_event','a:2:{i:0;O:8:\"stdClass\":3:{s:1:\"0\";s:9:\"skiplinks\";s:1:\"1\";a:2:{i:0;s:14:\"control-titles\";i:1;s:1:\"1\";}s:9:\"timestamp\";s:0:\"\";}i:1;O:8:\"stdClass\":5:{s:1:\"0\";s:9:\"skiplinks\";s:1:\"1\";a:2:{i:0;s:14:\"control-titles\";i:1;s:1:\"1\";}s:1:\"2\";a:2:{i:0;s:12:\"link-targets\";i:1;s:1:\"8\";}s:1:\"3\";a:2:{i:0;s:16:\"control-tabindex\";i:1;s:1:\"3\";}s:9:\"timestamp\";s:0:\"\";}}'),(182515,2146,'_wpa_event','{\"0\":\"skiplinks\",\"1\":[\"control-titles\",\"1\"],\"timestamp\":1766023031}'),(182518,2677,'footnotes',''),(182520,2677,'banner_head',''),(182521,2677,'_banner_head','field_5b568121a8ffe'),(182522,2677,'banner_sub',''),(182523,2677,'_banner_sub','field_5b568139fd366'),(182524,2677,'banner_button','<a class=\"btn btn-home\" style=\"width: 200px;\" href=\"#project\">Sign the petition</a>'),(182525,2677,'_banner_button','field_5b568147fd367'),(182526,2677,'support_section_title','How can Lifestart support you?'),(182527,2677,'_support_section_title','field_5b67c7d060398'),(182528,2677,'support_left_title','Services'),(182529,2677,'_support_lef