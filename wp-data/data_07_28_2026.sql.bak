,1515,'first_image_cont','from 0-24 years living with disabilities and their familes'),(36349,1515,'_first_image_cont','field_5b67caff6afc5'),(36350,1515,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(36351,1515,'_first_image_button','field_5b67cb0d6afc6'),(36352,1515,'second _image_title','Lifestart is about supporting young children'),(36353,1515,'_second _image_title','field_5b67cb20ddf9a'),(36354,1515,'second_image_cont','from 0-24 years living with disabilities and their familes'),(36355,1515,'_second_image_cont','field_5b67cb24ddf9b'),(36356,1515,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(36357,1515,'_second_image_button','field_5b67cb29ddf9c'),(36358,1515,'second_image_title','Lifestart is about supporting young children'),(36359,1515,'_second_image_title','field_5b67cb20ddf9a'),(36360,1515,'page_col_image','412'),(36361,1515,'_page_col_image','field_5de6546e7c63a'),(36362,1515,'page_col_image_3','437'),(36363,1515,'_page_col_image_3','field_5de6e3998e07e'),(36364,1515,'sec_2_title','Community'),(36365,1515,'_sec_2_title','field_5de6e3ef2798f'),(36366,1515,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(36367,1515,'_sec_2_text','field_5de78dc89e613'),(36368,1515,'sec_3_title','The Project'),(36369,1515,'_sec_3_title','field_5de6e3d37d8da'),(36370,1515,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(36371,1515,'_sec_3_text','field_5de6e4044e5e8'),(36372,1515,'page_col_image_2','436'),(36373,1515,'_page_col_image_2','field_5de6546e7c63a'),(36374,1515,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(36375,1515,'_sec_2_button','field_5de6e58c86706'),(36376,1515,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(36377,1515,'_sec_3_button','field_5de6e5a243c03'),(36378,1515,'page_col_image_4','455'),(36379,1515,'_page_col_image_4','field_5de70801090ce'),(36380,1515,'sec_4_title','Location'),(36381,1515,'_sec_4_title','field_5de7082a12a81'),(36382,1515,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(36383,1515,'_sec_4_text','field_5de7084812a82'),(36384,1515,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(36385,1515,'_sec_4_button','field_5de7085e12a83'),(36386,1515,'news_title','Project updates'),(36387,1515,'_news_title','field_5de78da3aabb9'),(36388,1515,'sec_2_text_copy',''),(36389,1515,'_sec_2_text_copy','field_5de78dc89e613'),(36390,1515,'timeline-title','Timeline'),(36391,1515,'_timeline-title','field_5de78df29e615'),(36392,1515,'timeline_title','Timeline'),(36393,1515,'_timeline_title','field_5de78df29e615'),(36394,1515,'contact_title','Contact us'),(36395,1515,'_contact_title','field_5de7981e06057'),(36396,1515,'contact_intro','Contact text...'),(36397,1515,'_contact_intro','field_5de7983506058'),(36398,1515,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(36399,1515,'_news_button','field_5de8329896e02'),(36400,1515,'timeline_intro','Introduction of timeline detail...'),(36401,1515,'_timeline_intro','field_5de98f5fb1781'),(36402,1515,'ti