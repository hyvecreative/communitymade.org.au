,1928,'_survey_index','field_6294561242236'),(86896,1928,'report_title','Download the report'),(86897,1928,'_report_title','field_62f30edfb57e1'),(86898,1928,'report_intro','Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus massa erat, consectetur at semper at, feugiat vel orci. '),(86899,1928,'_report_intro','field_62f30eedb57e2'),(86900,1928,'report_link_url','#'),(86901,1928,'_report_link_url','field_62f30ef4b57e3'),(86902,1928,'report_link_text','Download'),(86903,1928,'_report_link_text','field_62f30f01b57e4'),(86904,1928,'solutions_content','The housing system is complex, and no one solution will solve the complex problems we now face but there are some critical first steps to be taken now.\r\n<ul>\r\n 	<li>Set out an ambitious national housing agreement between commonwealth and state governments with targets and funding for the construction of affordable homes.</li>\r\n 	<li>Phase out tax breaks for property investors and using the increase in revenue to build more public housing.</li>\r\n 	<li>Establish laws which limit rental increases beyond what is fair.</li>\r\n 	<li>Rebalance tenancy laws to provide renters with more security and control, such as eliminating no grounds evictions.</li>\r\n 	<li>Phase out stamp duty and replace it with a broad-based land tax.</li>\r\n</ul>\r\n<h4>While there are many opinions on what policy changes will fix the housing market, doing nothing is not an option.</h4>'),(86905,1928,'_solutions_content','field_640e8b307a958'),(86906,1928,'problem_icons_0_prob_icon','1699'),(86907,1928,'_problem_icons_0_prob_icon','field_640fa0291d519'),(86908,1928,'problem_icons_0_prob_concerned_stat','70% highly concerned'),(86909,1928,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(86910,1928,'problem_icons_0_prob_concerded_text','are highly concerned'),(86911,1928,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(86912,1928,'problem_icons_0_prob_issue_text',''),(86913,1928,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(86914,1928,'problem_icons','4'),(86915,1928,'_problem_icons','field_640fa0191d518'),(86916,1928,'ceh_content_left',''),(86917,1928,'_ceh_content_left','field_640e97e8f1c8c'),(86918,1928,'ceh_content_right',''),(86919,1928,'_ceh_content_right','field_640e97fdf1c8d'),(86920,1928,'pc_content_left',''),(86921,1928,'_pc_content_left','field_640e983bf1c8f'),(86922,1928,'pc_content_right',''),(86923,1928,'_pc_content_right','field_640e984df1c90'),(86924,1928,'problem_icons_1_prob_icon','1699'),(86925,1928,'_problem_icons_1_prob_icon','field_640fa0291d519'),(86926,1928,'problem_icons_1_prob_concerned_stat','69% highly concerned'),(86927,1928,'_problem_icons_1_prob_concerned_stat','field_640fa0dd81d95'),(86928,1928,'problem_icons_1_prob_concerded_text','are highly concerned'),(86929,1928,'_problem_icons_1_prob_concerded_text','field_640fa10181d96'),(86930,1928,'problem_icons_1_prob_issue_text',''),(86931,1928,'_problem_icons_1_prob_issue_text','field_640fa11a81d97'),(86932,1928,'problem_icons_2_prob_icon','1699'),(86933,1928,'_problem_icons_2_prob_icon','field_640fa0291d519'),(86934,1928,'problem_icons_2_prob_concerned_stat','64% highly concerned'),(86935,1928,'_problem_icons_2_prob_concerned_stat','field_640fa0dd81d95'),(86936,1928,'problem_icons_2_prob_concerded_text','are highly concerned'),(86937,1928,'_problem_icons_2_prob_concerded_text','field_640fa10181d96'),(86938,1928,'problem_icons_2_prob_issue_text',''),(86939,1928,'_problem_icons_2_prob_issue_text','field_640fa11a81d97'),(86940,1928,'problem_icons_3_prob_icon','1699'),(86941,1928,'_problem_icons_3_prob_icon','field_640fa0291d519'),(86942,1928,'problem_icons_3_prob_concerned_stat','64% highly concerned'),(86943,1928,'_problem_icons_3_prob_concerned_stat','field_640fa0dd81d95'),(86944,1928,'problem_icons_3_prob_concerded_text','are highly concerned'),(86945,1928,'_problem_icons_3_prob_concerded_text','field_640fa10181d96'),(86946,1928,'problem_icons_3_prob_issue_text',''),(86947,1928,'_problem_icons_3_prob_issue_text','field_640fa11a81d97'),(86948,1928,'problem_icons_0_prob_concerned_text','House prices have doubled in a decade'),(86949,1928,'_problem_icons_0_prob_concerned_text','field_640fa10181d96'),(86950,1928,'problem_icons_1_prob_concerned_text','The gap between rich and poor is growing'),(86951,1928,'_problem_icons_1_prob_concerned_text','field_640fa10181d96'),(86952,1928,'problem_icons_2_prob_concerned_text','Construction of social housing is down'),(86953,1928,'_problem_icons_2_prob_concerned_text','field_640fa10181d96'),(86954,1928,'problem_icons_3_prob_concerned_text','Banks are making more than ever from housing'),(86955,1928,'_problem_icons_3_prob_concerned_text','field_640fa10181d96'),(86956,1928,'monitor_content','The Australian Housing Monitor is a large, nationally-representative survey covering public experiences and attitudes toward housing related issues. Questions range from how well the respondent is keeping up with their mortgage/rent, to what they think about social housing construction.\r\n\r\nA broad range of demographic criteria are included, such as gender, location, age, income, voting preference, educational level, tenure type, and employment status. These variables allow CEH researchers to understand the trends and diversity of opinion around the country.\r\n\r\nIt also incorporates questions from previous surveys to track trends over time.\r\nThe inaugural poll was conducted by Essential in December 2022, and was completed by 4,735 people.'),(86957,1928,'_monitor_content','field_640fcc4014404'),(86958,1928,'problem_head','Housing in Australia is not working, and Australians are concerned.'),(86959,1928,'_problem_head','field_641935436aded'),(86960,1928,'problem_signoff','Explore the research showing how concerned Australians are our about the housing situation.'),(86961,1928,'_problem_signoff','field_641935626adee'),(86962,1928,'sections','a:2:{i:0;s:4:\"hero\";i:1;s:9:\"news_grid\";}'),(86963,1928,'_sections','field_5dafb40b8143a'),(86964,1928,'sections_0_is_full_height','1'),(86965,1928,'_sections_0_is_full_height','field_61d6f6fd5a37e'),(86966,1928,'sections_0_image','1648'),(86967,1928,'_sections_0_image','field_61d6f6d45a37d'),(86968,1928,'sections_0_heading','Heading'),(86969,1928,'_sections_0_heading','field_61d6f69e5a379'),(86970,1928,'sections_0_subtitle','Ya ya '),(86971,1928,'_sections_0_subtitle','field_61d6f6ac5a37a'),(86972,1928,'sections_0_link_one',''),(86973,1928,'_sections_0_link_one','field_61d6f6b55a37b'),(86974,1928,'sections_0_link_two',''),(86975,1928,'_sections_0_link_two','field_61d6f6c35a37c'),(86976,1928,'sections_1_select_categories','a:1:{i:0;s:2:\"27\";}'),(86977,1928,'_sections_1_select_categories','field_637f04483b63b'),(86978,1928,'intro_head_major','Super Consumers Australia is <span>fighting</span> to ensure that the superannuation industry is <span>held accountable</span> for the outcomes they deliver to Australian consumers.'),(86979,1928,'_intro_head_major','field_64e828783ad9f'),(86980,1928,'intro_head_minor','We want super to work for everyone—not just super fund companies. With our research, journalism and campaigns we are creating the trustworthy and transparent superannuation system we all deserve.'),(86981,1928,'_intro_head_minor','field_64e8288c3ada0'),(86982,1928,'intro_icons_0_int_icon','1922'),(86983,1928,'_intro_icons_0_int_icon','field_64e828b33ada2'),(86984,1928,'intro_icons_0_int_icon_text','At 1,727,000 square kilometres, we’re 2.5 times the size of Texas. <span>Yeeha!</span>'),(86985,1928,'_intro_icons_0_int_icon_text','field_64e828e33ada3'),(86986,1928,'intro_icons_1_int_icon','1920'),(86987,1928,'_intro_icons_1_int_icon','field_64e828b33ada2'),(86988,1928,'intro_icons_1_int_icon_text','We have twice as many species of native plant and animal as any other Australian state or territory.'),(86989,1928,'_intro_icons_1_int_icon_text','field_64e828e33ada3'),(86990,1928,'intro_icons_2_int_icon','1921'),(86991,1928,'_intro_icons_2_int_icon','field_64e828b33ada2'),(86992,1928,'intro_icons_2_int_icon_text','We have less land classified as ‘protected’ than any other state or territory.'),(86993,1928,'_intro_icons_2_int_icon_text','field_64e828e33ada3'),(86994,1928,'intro_icons','3'),(86995,1928,'_intro_icons','field_64e828963ada1'),(86996,1928,'threat_head_major','What we stand to lose if we don’t act soon to protect beautiful Queensland:'),(86997,1928,'_threat_head_major','field_64ec258d9dbd1'),(86998,1928,'threats_icons','3'),(86999,1928,'_threats_icons','field_64ec2551a93f9'),(87000,1928,'threats_icons_0_thr_icon','1819'),(87001,1928,'_threats_icons_0_thr_icon','field_64ec2551a93fa'),(87002,1928,'threats_icons_0_thr_icon_text','The rich cultural heritage of our First Nations people and their continuous ties to country, dating back more than 50,000 years.'),(87003,1928,'_threats_icons_0_thr_icon_text','field_64ec2551a93fb'),(87004,1928,'threats_icons_1_thr_icon','1819'),(87005,1928,'_threats_icons_1_thr_icon','field_64ec2551a93fa'),(87006,1928,'threats_icons_1_thr_icon_text','Thousands of species of plant and animal which are now classified as threatened or endangered in Queensland.'),(87007,1928,'_threats_icons_1_thr_icon_text','field_64ec2551a93fb'),(87008,1928,'threats_icons_2_thr_icon','1819'),(87009,1928,'_threats_icons_2_thr_icon','field_64ec2551a93fa'),(87010,1928,'threats_icons_2_thr_icon_text','The access to nature that is central to the Queensland way of life.'),(87011,1928,'_threats_icons_2_thr_icon_text','field_64ec2551a93fb'),(87012,1928,'threat_icons_0_thr_icon',''),(87013,1928,'_threat_icons_0_thr_icon','field_64ec2551a93fa'),(87014,1928,'threat_icons_0_thr_icon_text','The <span>rich cultural heritage</span> of our First Nations people and their continuous ties to country, dating back more than 50,000 years.'),(87015,1928,'_threat_icons_0_thr_icon_text','field_64ec2551a93fb'),(87016,1928,'threat_icons_1_thr_icon',''),(87017,1928,'_threat_icons_1_thr_icon','field_64ec255