y_index_5_survey_url','#'),(80134,1894,'_survey_index_5_survey_url','field_6294564e42239'),(80135,1894,'survey_index_5_survey_url_text','View Results'),(80136,1894,'_survey_index_5_survey_url_text','field_629456584223a'),(80137,1894,'survey_index_6_survey_icon','1492'),(80138,1894,'_survey_index_6_survey_icon','field_6294562942237'),(80139,1894,'survey_index_6_survey_title','Energy Management'),(80140,1894,'_survey_index_6_survey_title','field_6294564042238'),(80141,1894,'survey_index_6_survey_url','#'),(80142,1894,'_survey_index_6_survey_url','field_6294564e42239'),(80143,1894,'survey_index_6_survey_url_text','View Results'),(80144,1894,'_survey_index_6_survey_url_text','field_629456584223a'),(80145,1894,'survey_index_7_survey_icon','1493'),(80146,1894,'_survey_index_7_survey_icon','field_6294562942237'),(80147,1894,'survey_index_7_survey_title','Going Off-grid'),(80148,1894,'_survey_index_7_survey_title','field_6294564042238'),(80149,1894,'survey_index_7_survey_url','#'),(80150,1894,'_survey_index_7_survey_url','field_6294564e42239'),(80151,1894,'survey_index_7_survey_url_text','View Results'),(80152,1894,'_survey_index_7_survey_url_text','field_629456584223a'),(80153,1894,'survey_index','8'),(80154,1894,'_survey_index','field_6294561242236'),(80155,1894,'report_title','Download the report'),(80156,1894,'_report_title','field_62f30edfb57e1'),(80157,1894,'report_intro','Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus massa erat, consectetur at semper at, feugiat vel orci. '),(80158,1894,'_report_intro','field_62f30eedb57e2'),(80159,1894,'report_link_url','#'),(80160,1894,'_report_link_url','field_62f30ef4b57e3'),(80161,1894,'report_link_text','Download'),(80162,1894,'_report_link_text','field_62f30f01b57e4'),(80163,1894,'solutions_content','The housing system is complex, and no one solution will solve the complex problems we now face but there are some critical first steps to be taken now.\r\n<ul>\r\n 	<li>Set out an ambitious national housing agreement between commonwealth and state governments with targets and funding for the construction of affordable homes.</li>\r\n 	<li>Phase out tax breaks for property investors and using the increase in revenue to build more public housing.</li>\r\n 	<li>Establish laws which limit rental increases beyond what is fair.</li>\r\n 	<li>Rebalance tenancy laws to provide renters with more security and control, such as eliminating no grounds evictions.</li>\r\n 	<li>Phase out stamp duty and replace it with a broad-based land tax.</li>\r\n</ul>\r\n<h4>While there are many opinions on what policy changes will fix the housing market, doing nothing is not an option.</h4>'),(80164,1894,'_solutions_content','field_640e8b307a958'),(80165,1894,'problem_icons_0_prob_icon','1699'),(80166,1894,'_problem_icons_0_prob_icon','field_640fa0291d519'),(80167,1894,'problem_icons_0_prob_concerned_stat','70% highly concerned'),(80168,1894,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(80169,1894,'problem_icons_0_prob_concerded_text','are highly concerned'),(80170,1894,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(80171,1894,'problem_icons_0_prob_issue_text',''),(80172,1894,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(80173,1894,'problem_icons','4'),(80174,1894,'_problem_icons','field_640fa0191d518'),(80175,1894,'ceh_content_left',''),(80176,1894,'_ceh_content_left','field_640e97e8f1c8c'),(80177,1894,'ceh_content_right',''),(80178,1894,'_ceh_content_right','field_640e97fdf1c8d'),(80179,1894,'pc_content_left',''),(80180,1894,'_pc_content_left','field_640e983bf1c8f'),(80181,1894,'pc_content_right',''),(80182,1894,'_pc_content_right','field_640e984df1c90'),(80183,1894,'problem_icons_1_prob_icon','1699'),(80184,1894,'_problem_icons_1_prob_icon','field_640fa0291d519'),(80185,1894,'problem_icons_1_prob_concerned_stat','69% highly concerned'),(80186,1894,'_problem_icons_1_prob_concerned_stat','field_640fa0dd81d95'),(80187,1894,'problem_icons_1_prob_concerd