_home_2_help_url','field_65262cf4143e4'),(126278,2201,'gh_block_home','3'),(126279,2201,'_gh_block_home','field_65262c8a143e1'),(126280,2201,'turn_on_insights',''),(126281,2201,'_turn_on_insights','field_645c4a2e654a6'),(126282,2201,'report_questions','a:3:{i:0;s:4:\"1997\";i:1;s:4:\"2067\";i:2;s:4:\"2089\";}'),(126283,2201,'_report_questions','field_6109ed5e02e5a'),(126284,2201,'intro_text','The Disability Dialogue is a place where people with disabilities, their families, organisations providing support, academics, and the wider community come together to work on things that matter to us.\r\n\r\nThe Dialogue is a hub of knowledge and collaboration, separate from government, where we work together to come up. With new ideas on important topics. Our ideas can make a big difference in how services and systems are set up for people with disabilities.'),(126285,2201,'_intro_text','field_66441acfe963c'),(126286,2201,'word_link','#'),(126287,2201,'_word_link','field_6646c69723804'),(126288,2201,'pdf_link','#'),(126289,2201,'_pdf_link','field_6646c6da23805'),(126292,2202,'footnotes',''),(126294,2202,'banner_head',''),(126295,2202,'_banner_head','field_5b568121a8ffe'),(126296,2202,'banner_sub',''),(126297,2202,'_banner_sub','field_5b568139fd366'),(126298,2202,'banner_button','<a class=\"btn btn-home\" style=\"width: 200px;\" href=\"#project\">Sign the petition</a>'),(126299,2202,'_banner_button','field_5b568147fd367'),(126300,2202,'support_section_title','How can Lifestart support you?'),(126301,2202,'_support_section_title','field_5b67c7d060398'),(126302,2202,'support_left_title','Services'),(126303,2202,'_support_left_title','field_5b67c298e7f8f'),(126304,2202,'support_left_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy.'),(126305,2202,'_support_left_cont','field_5b67c5f6e7f91'),(126306,2202,'support_left_button','<a class=\"btn btn-green\" href=\"/services/\">View all services</a>'),(126307,2202,'_support_left_button','field_5b67c60ae7