,(85595,1923,'_problem_icons_3_prob_concerded_text','field_640fa10181d96'),(85596,1923,'problem_icons_3_prob_issue_text',''),(85597,1923,'_problem_icons_3_prob_issue_text','field_640fa11a81d97'),(85598,1923,'problem_icons_0_prob_concerned_text','House prices have doubled in a decade'),(85599,1923,'_problem_icons_0_prob_concerned_text','field_640fa10181d96'),(85600,1923,'problem_icons_1_prob_concerned_text','The gap between rich and poor is growing'),(85601,1923,'_problem_icons_1_prob_concerned_text','field_640fa10181d96'),(85602,1923,'problem_icons_2_prob_concerned_text','Construction of social housing is down'),(85603,1923,'_problem_icons_2_prob_concerned_text','field_640fa10181d96'),(85604,1923,'problem_icons_3_prob_concerned_text','Banks are making more than ever from housing'),(85605,1923,'_problem_icons_3_prob_concerned_text','field_640fa10181d96'),(85606,1923,'monitor_content','The Australian Housing Monitor is a large, nationally-representative survey covering public experiences and attitudes toward housing related issues. Questions range from how well the respondent is keeping up with their mortgage/rent, to what they think about social housing construction.\r\n\r\nA broad range of demographic criteria are included, such as gender, location, age, income, voting preference, educational level, tenure type, and employment status. These variables allow CEH researchers to understand the trends and diversity of opinion around the country.\r\n\r\nIt also incorporates questions from previous surveys to track trends over time.\r\nThe inaugural poll was conducted by Essential in December 2022, and was completed by 4,735 people.'),(85607,1923,'_monitor_content','field_640fcc4014404'),(85608,1923,'problem_head','Housing in Australia is not working, and Australians are concerned.'),(85609,1923,'_problem_head','field_641935436aded'),(85610,1923,'problem_signoff','Explore the research showing how concerned Australians are our about the housing situation.'),(85611,1923,'_problem_signoff','field_641935626adee'),(85612,1923,'sections','a:2:{i:0;s:4:\"hero\";i:1;s:9:\"news_grid\";}'),(85613,1923,'_sections','field_5dafb40b8143a'),(85614,1923,'sections_0_is_full_height','1'),(85615,1923,'_sections_0_is_full_height','field_61d6f6fd5a37e'),(85616,1923,'sections_0_image','1648'),(85617,1923,'_sections_0_image','field_61d6f6d45a37d'),(85618,1923,'sections_0_heading','Heading'),(85619,1923,'_sections_0_heading','field_61d6f69e5a379'),(85620,1923,'sections_0_subtitle','Ya ya '),(85621,1923,'_sections_0_subtitle','field_61d6f6ac5a37a'),(85622,1923,'sections_0_link_one',''),(85623,1923,'_sections_0_link_one','field_61d6f6b55a37b'),(85624,1923,'sections_0_link_two',''),(85625,1923,'_sections_0_link_two','field_61d6f6c35a37c'),(85626,1923,'sections_1_select_categories','a:1:{i:0;s:2:\"27\";}'),(85627,1923,'_sections_1_select_categories','field_637f04483b63b'),(85628,1923,'intro_head_major','Super Consumers Australia is <span>fighting</span> to ensure that the superannuation industry is <span>held accountable</span> for the outcomes they deliver to Australian consumers.'),(85629,1923,'_intro_head_major','field_64e828783ad9f'),(85630,1923,'intro_head_minor','We want super to work for everyone—not just super fund companies. With our research, journalism and campaigns we are creating the trustworthy and transparent superannuation system we all deserve.'),(85631,1923,'_intro_head_minor','field_64e8288c3ada0'),(85632,1923,'intro_icons_0_int_icon','1922'),(85633,1923,'_intro_icons_0_int_icon','field_64e828b33ada2'),(85634,1923,'intro_icons_0_int_icon_text','At 1,727,000 square kilometres, we’re 2.5 times the size of Texas. <span>Yeeha!</span>'),(85635,1923,'_intro_icons_0_int_icon_text','field_64e828e33ada3'),(85636,1923,'intro_icons_1_int_icon','1920'),(85637,1923,'_intro_icons_1_int_icon','field_64e828b33ada2'),(85638,1923,'intro_icons_1_int_icon_text','We have twice as many species of native plant and animal as any other Australian state or territory.'),(85639,1923,'_intro_icons_1_int_icon_text','field_64e828e33ada3'),(85640,1923,'intro_icons_2_int_icon','1921'),(85641,1923,'_intro_icons_2_int_icon','field_64e828b33ada2'),(85642,1923,'intro_icons_2_int_icon_text','We have less land classified as ‘protected’ than any other state or territory.'),(85643,1923,'_intro_icons_2_int_icon_text','field_64e828e33ada3'),(85644,1923,'intro_icons','3'),(85645,1923,'_intro_icons','field_64e828963ada1'),(85646,1923,'threat_head_major','What we stand to lose if we don’t act soon to protect beautiful Queensland:'),(85647,1923,'_threat_head_major','field_64ec258d9dbd1'),(85648,1923,'threats_icons','3'),(85649,1923,'_threats_icons','field_64ec2551a93f9'),(85650,1923,'threats_icons_0_thr_icon','1819'),(85651,1923,'_threats_icons_0_thr_icon','field_64ec2551a93fa'),(85652,1923,'threats_icons_0_thr_icon_text','The rich cultural heritage of our First Nations people and their continuous ties to country, dating back more than 50,000 years.'),(85653,1923,'_threats_icons_0_thr_icon_text','field_64ec2551a93fb'),(85654,1923,'threats_icons_1_thr_icon','1819'),(85655,1923,'_threats_icons_1_thr_icon','field_64ec2551a93fa'),(85656,1923,'threats_icons_1_thr_icon_text','Thousands of species of plant and animal which are now classified as threatened or endangered in Queensland.'),(85657,1923,'_threats_icons_1_thr_icon_text','field_64ec2551a93fb'),(85658,1923,'threats_icons_2_thr_icon','1819'),(85659,1923,'_threats_icons_2_thr_icon','field_64ec2551a93fa'),(85660,1923,'threats_icons_2_thr_icon_text','The access to nature that is central to the Queensland way of life.'),(85661,1923,'_threats_icons_2_thr_icon_text','field_64ec2551a93fb'),(85662,1923,'threat_icons_0_thr_icon',''),(85663,1923,'_threat_icons_0_thr_icon','field_64ec2551a93fa'),(85664,1923,'threat_icons_0_thr_icon_text','The <span>rich cultural heritage</span> of our First Nations people and their continuous ties to country, dating back more than 50,000 years.'),(85665,1923,'_threat_icons_0_t