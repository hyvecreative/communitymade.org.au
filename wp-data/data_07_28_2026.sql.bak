17590,2126,'_page_col_image','field_5de6546e7c63a'),(117591,2126,'page_col_image_3','437'),(117592,2126,'_page_col_image_3','field_5de6e3998e07e'),(117593,2126,'sec_2_title','Community'),(117594,2126,'_sec_2_title','field_5de6e3ef2798f'),(117595,2126,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(117596,2126,'_sec_2_text','field_5de78dc89e613'),(117597,2126,'sec_3_title','The Project'),(117598,2126,'_sec_3_title','field_5de6e3d37d8da'),(117599,2126,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(117600,2126,'_sec_3_text','field_5de6e4044e5e8'),(117601,2126,'page_col_image_2','436'),(117602,2126,'_page_col_image_2','field_5de6546e7c63a'),(117603,2126,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(117604,2126,'_sec_2_button','field_5de6e58c86706'),(117605,2126,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(117606,2126,'_sec_3_button','field_5de6e5a243c03'),(117607,2126,'page_col_image_4','455'),(117608,2126,'_page_col_image_4','field_5de70801090ce'),(117609,2126,'sec_4_title','Location'),(117610,2126,'_sec_4_title','field_5de7082a12a81'),(117611,2126,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(117612,2126,'_sec_4_text','field_5de7084812a82'),(117613,2126,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(117614,2126,'_sec_4_button','field_5de7085e12a83'),(117615,2126,'news_title','Project updates'),(117616,2126,'_news_title','field_5de78da3aabb9'),(117617,2126,'sec_2_text_copy',''),(117618,2126,'_sec_2_text_copy','field_5de78dc89e613'),(117619,2126,'timeline-title','Timeline'),(117620,2126,'_timeline-title','field_5de78df29e615'),(117621,2126,'timeline_title','Timeline'),(117622,2126,'_timeline_title','field_5de78df29e615'),(117623,2126,'contact_title','Contact us'),(117624,2126,'_contact_title','field_5de7981e06057'),(117625,2126,'contact_intro','Contact text...'),(117626,2126,'_contact_intro','field_5de7983506058'),(117627,2126,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(117628,2126,'_news_button','field_5de8329896e02'),(117629,2126,'timeline_intro','Introduction of timeline detail...'),(117630,2126,'_timeline_intro','field_5de98f5fb1781'),(117631,2126,'timeline_pic','477'),(117632,2126,'_timeline_pic','field_5de98f72b1782'),(117633,2126,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(117634,2126,'_timeline_button','field_5de99363677f8'),(117635,2126,'banner_image_position','center'),(117636,2126,'_banner_image_position','field_5f3bc4757dd02'),(117637,2126,'services_title','Our services'),(117638,2126,'_services_title','field_5f20f3cd80eb2'),(117639,2126,'services_items_0_services_item_image','1061'),(117640,2126,'_services_items_0_services_item_image','field_5f2121355be14'),(117641,2126,'services_items_0_sservices_item_title','1300 Telephone counselling line'),(117642,2126,'_services_items_0_sservices_item_title','field_605089efca82e'),(117643,2126,'services_items_0_services_item_text',''),(117644,2126,'_services_items_0_services_item_text','fiel