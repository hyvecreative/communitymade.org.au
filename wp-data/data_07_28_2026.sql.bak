ces_items_3_services_item_text',''),(18913,6,'_services_items_3_services_item_text','field_5f2121535be15'),(18914,6,'services_items_3_services_link_url','#'),(18915,6,'_services_items_3_services_link_url','field_6050866041225'),(18916,6,'services_items_3_services_link_text','Find out more'),(18917,6,'_services_items_3_services_link_text','field_6050866d41226'),(18918,6,'services_items','4'),(18919,6,'_services_items','field_5f20f3dbe5a77'),(18920,6,'services_intro_text','Services introduction paragraph - range of options, benefits statement.'),(18921,6,'_services_intro_text','field_5f2121dff763d'),(18922,1062,'banner_head','Our drug laws are hurting our kids'),(18923,1062,'_banner_head','field_5b568121a8ffe'),(18924,1062,'banner_sub','We can get drugs under control by putting health and safety first.'),(18925,1062,'_banner_sub','field_5b568139fd366'),(18926,1062,'banner_button','<a style=\"width: 200px;\" class=\"btn btn-home\" href=\"#project\">Sign the petition</a>'),(18927,1062,'_banner_button','field_5b568147fd367'),(18928,1062,'support_section_title','How can Lifestart support you?'),(18929,1062,'_support_section_title','field_5b67c7d060398'),(18930,1062,'support_left_title','Services'),(18931,1062,'_support_left_title','field_5b67c298e7f8f'),(18932,1062,'support_left_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy.'),(18933,1062,'_support_left_cont','field_5b67c5f6e7f91'),(18934,1062,'support_left_button','<a class=\"btn btn-green\" href=\"/services/\">View all services</a>'),(18935,1062,'_support_left_button','field_5b67c60ae7f92'),(18936,1062,'support_ctr_title','Talk to us'),(18937,1062,'_support_ctr_title','field_5b67c62a58af3'),(18938,1062,'support_ctr_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut laoreet.'),(18939,1062,'_support_ctr_cont','field_5b67c63158af4'),(18940,1062,'support_ctr_button','<a class=\"btn btn-orange\" href=\"/supports/\">Find us</a>'),(18941,1062,'_support_ctr_button','field_5b67c63658af5'),(18942,1062,'support_right_title','NDIS Registered provider'),(18943,1062,'_support_right_title','field_5b67c6a38c064'),(18944,1062,'support_right_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut.'),(18945,1062,'_support_right_cont','field_5b67c6c98c065'),(18946,1062,'support_right_button','<a class=\"btn btn-blue\" href=\"#\">Read more</a>'),(18947,1062,'_support_right_button','field_5b67c6dd8c066'),(18948,1062,'first_image_title','Lifestart is about supporting young children'),(18949,1062,'_first_image_title','field_5b67ca606afc4'),(18950,1062,'first_image_cont','from 0-24 years living with disabilities and their familes'),(18951,1062,'_first_image_cont','field_5b67caff6afc5'),(18952,1062,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(18953,1062,'_first_image_button','field_5b67cb0d6afc6'),(18954,1062,'second _image_title','Lifestart is about supporting young children'),(18955,1062,'_second _image_title','field_5b67cb20ddf9a'),(18956,1062,'second_image_cont','from 0-24 years living with disabilities and their familes'),(18957,1062,'_second_image_cont','field_5b67cb24ddf9b'),(18958,1062,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(18959,1062,'_second_image_button','field_5b67cb29ddf9c'),(18960,1062,'second_image_title','Lifestart is about supporting young children'),(18961,1062,'_second_image_title','field_5b67cb20ddf9a'),(18962,1062,'page_col_image','412'),(18963,1062,'_page_col_image','field_5de6546e7c63a'),(18964,1062,'page_col_image_3','437'),(18965,1062,'_page_col_image_3','field_5de6e3998e07e'),(18966,1062,'sec_2_title','Community'),(18967,1062,'_sec_2_title','field_5de6e3ef2798f'),(18968,1062,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(18969,1062,'_sec_2_text','field_5de78dc89e613'),(18970,1062,'sec_3_title','The Project'),(18971,1062,'_sec_3_title','field_5de6e3d37d8da'),(18972,1062,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(18973,1062,'_sec_3_text','field_5de6e4044e5e8'),(18974,1062,'page_col_image_2','436'),(18975,1062,'_page_col_image_2','field_5de6546e7c63a'),(18976,1062,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(18977,1062,'_sec_2_button','field_5de6e58c86706'),(18978,1062,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(18979,1062,'_sec_3_button','field_5de6e5a243c03'),(18980,1062,'page_col_image_4','455'),(18981,1062,'_page_col_image_4','field_5de70801090ce'),(18982,1062,'sec_4_title','Location'),(18983,1062,'_sec_4_title','field_5de7082a12a81'),(18984,1062,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(18985,1062,'_sec_4_text','field_5de7084812a82'),(18986,1062,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(18987,1062,'_sec_4_button','field_5de7085e12a83'),(18988,1062,'news_title','Project updates'),(18989,1062,'_news_title','field_5de78da3aabb9'),(18990,1062,'sec_2_text_copy',''),(18991,1062,'_sec_2_text_copy','field_5de78dc89e613'),(18992,1062