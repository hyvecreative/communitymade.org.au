065'),(178270,2653,'support_right_button','<a class=\"btn btn-blue\" href=\"#\">Read more</a>'),(178271,2653,'_support_right_button','field_5b67c6dd8c066'),(178272,2653,'first_image_title','Lifestart is about supporting young children'),(178273,2653,'_first_image_title','field_5b67ca606afc4'),(178274,2653,'first_image_cont','from 0-24 years living with disabilities and their familes'),(178275,2653,'_first_image_cont','field_5b67caff6afc5'),(178276,2653,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(178277,2653,'_first_image_button','field_5b67cb0d6afc6'),(178278,2653,'second _image_title','Lifestart is about supporting young children'),(178279,2653,'_second _image_title','field_5b67cb20ddf9a'),(178280,2653,'second_image_cont','from 0-24 years living with disabilities and their familes'),(178281,2653,'_second_image_cont','field_5b67cb24ddf9b'),(178282,2653,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(178283,2653,'_second_image_button','field_5b67cb29ddf9c'),(178284,2653,'second_image_title','Lifestart is about supporting young children'),(178285,2653,'_second_image_title','field_5b67cb20ddf9a'),(178286,2653,'page_col_image','412'),(178287,2653,'_page_col_image','field_5de6546e7c63a'),(178288,2653,'page_col_image_3','437'),(178289,2653,'_page_col_image_3','field_5de6e3998e07e'),(178290,2653,'sec_2_title','Community'),(178291,2653,'_sec_2_title','field_5de6e3ef2798f'),(178292,2653,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(178293,2653,'_sec_2_text','field_5de78dc89e613'),(178294,2653,'sec_3_title','The Project'),(178295,2653,'_sec_3_title','field_5de6e3d37d8da'),(178296,2653,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(178297,2653,'_sec_3_text','field_5de6e4044e5e8'),(178298,2653,'page_col_image_2','436'),(178299,2653,'_page_col_image_2','field_5de6546e7c63a'),(178300,2653,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(178301,2653,'_sec_2_button','field_5de6e58c86706'),(178302,2653,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(178303,2653,'_sec_3_button','field_5de6e5a243c03'),(178304,2653,'page_col_image_4','455'),(178305,2653,'_page_col_image_4','field_5de70801090ce'),(178306,2653,'sec_4_title','Location'),(178307,2653,'_sec_4_title','field_5de7082a12a81'),(178308,2653,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(178309,2653,'_sec_4_text','field_5de7084812a82'),(178310,2653,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(178311,2653,'_sec_4_button','field_5de7085e12a83'),(178312,2653,'news_title','Project updates'),(178313,2653,'_news_title','field_5de78da3aabb9'),(178314,2653,'sec_2_text_copy',''),(178315,2653,'_sec_2_text_copy','field_5de78dc89e613'),(178316,2653,'timeline-title','Timeline'),(178317,2653,'_timeline-title','field_5de78df29e615'),(178318,2653,'timeline_title','Timeline'),(178319,2653,'_timeline_title','field_5de78df29e615'),(178320,2653,'contact_title','Contact us'),(178321,2653,'_contact_title','field_5de7981e06057'),(178322,2653,'contact_intro','Contact t