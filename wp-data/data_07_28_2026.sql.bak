8962,2494,'team_members_1_last_name','Henderson'),(158963,2494,'_team_members_1_last_name','field_5b7570de2682a'),(158964,2494,'team_members_1_member_text','Aliquam erat volutpat Ut wisi enim ad minim veniam laoreet dolore magna.'),(158965,2494,'_team_members_1_member_text','field_5b7570f12682b'),(158966,2494,'team_members_2_member_title','Manager'),(158967,2494,'_team_members_2_member_title','field_5b7570b326828'),(158968,2494,'team_members_2_first_name','John'),(158969,2494,'_team_members_2_first_name','field_5b7570cf26829'),(158970,2494,'team_members_2_last_name','Jones'),(158971,2494,'_team_members_2_last_name','field_5b7570de2682a'),(158972,2494,'team_members_2_member_text','Laoreet dolore magna aliquam erat volutpat. Ut wisi enim ad minim veniam.'),(158973,2494,'_team_members_2_member_text','field_5b7570f12682b'),(158974,2494,'team_members','4'),(158975,2494,'_team_members','field_5b75708c26827'),(158976,2494,'team_members_3_member_title','Manager'),(158977,2494,'_team_members_3_member_title','field_5b7570b326828'),(158978,2494,'team_members_3_first_name','Josh'),(158979,2494,'_team_members_3_first_name','field_5b7570cf26829'),(158980,2494,'team_members_3_last_name','Maneeva'),(158981,2494,'_team_members_3_last_name','field_5b7570de2682a'),(158982,2494,'team_members_3_member_text','Aliquam erat volutpat Ut wisi enim ad minim veniam laoreet dolore magna.'),(158983,2494,'_team_members_3_member_text','field_5b7570f12682b'),(158984,2494,'team_members_0_member_image','367'),(158985,2494,'_team_members_0_member_image','field_5b7572a89973e'),(158986,2494,'team_members_1_member_image','367'),(158987,2494,'_team_members_1_member_image','field_5b7572a89973e'),(158988,2494,'team_members_2_member_image','367'),(158989,2494,'_team_members_2_member_image','field_5b7572a89973e'),(158990,2494,'team_members_3_member_image','367'),(158991,2494,'_team_members_3_member_image','field_5b7572a89973e'),(158992,2494,'banner_button',''),(158993,2494,'_banner_button','field_5b568147fd367'),(158994,2494,'intro_col_1','The Take Control Campaign is a new movement of people who want to make Australia safer when it comes to drugs.'),(158995,2494,'_intro_col_1','field_5df5c6cef3ddb'),(158996,2494,'intro_col_2','The campaign has been launched by the Ted Noffs Foundation, Australia\'s largest provider of drug and alcohol treatment services for young people. The Foundation strives to help disadvantaged young people become advantaged and supports them on their journey to take back control of their lives.'),(158997,2494,'_intro_col_2','field_5df5c6deee1ca'),(158998,2494,'intro_col_3','With community support, the Take Control Campaign aims to change the conversation surrounding drugs and drug use in Australia. Through our common sense plan, we are demanding governments take control of the issue and fix our broken drug laws.'),(158999,2494,'_intro_col_3','field_5df5c6e99b7a8'),(159000,2494,'intro_logo','610'),(159001,2494,'_intro_logo','field_5df5c6f18c801'),(159002,2494,'intro_title','Decades of failed drug policy have resulted in unnecessary suffering. We have a secret and chaotic black market run by criminals and gangs. We have no control.'),(159003,2494,'_intro_title','field_5df5c6799cfec'),(159004,2494,'intro_bullets','Despite the best efforts of our police forces, for every drug dealer we catch, more simply start and operate with impunity.\r\n\r\nAny teenager can get drugs easily. People who use drugs can’t be sure what they are taking. Innocent young people who are just experimenting can buy themselves a death sentence.\r\n\r\nWorst of all, it’s often hard for people with problems to access help because they\'re treated like criminals.\r\n\r\nThis is because our governments refuse to take control of drugs.\r\n\r\nParents need greater tools and strategies to help their kids cope with the challenges of modern life.\r\n\r\nIt’s not good enough to put our heads in the sand and tell our kids to “just say no”. It doesn\'t work.\r\n\r\nIt\'s time to end the fear tactics. It\'s time to end the marketing gimmicks. People need real resources to reduce the harms associated with drug use.\r\n\r\nOur state and federal governments need to work together to get drug use under control by putting health and safety first.'),(159005,2494,'_intro_bullets','field_5df5c6799d05a'),(159006,2494,'intro_text',''),(159007,2494,'_intro_text','field_5df5c6799d0c6'),(159008,2494,'plan_title',''),(159009,2494,'_plan_title','field_5df5c6799d197'),(159010,2494,'plan_icons_row','5'),(159011,2494,'_plan_icons_row','field_5df5c6799d211'),(159012,2494,'plan_icons_row_0_plan_icon','516'),(159013,2494,'_plan_icons_row_0_plan_icon','field_5df5c679a8044'),(159014,2494,'plan_icons_row_0_plan_icon_text',' Roll out pill testing services nationally to reduce harm at music festivals and parties'),(159015,2494,'_plan_icons_row_0_plan_icon_text','field_5df5c679a80ae'),(159016,2494,'plan_icons_row_1_plan_icon','515'),(159017,2494,'_plan_icons_row_1_plan_icon','field_5df5c679a8044'),(159018,2494,'plan_icons_row_1_plan_icon_text','Expand treatment services for people suffering from drug problems'),(159019,2494,'_plan_icons_row_1_plan_icon_text','field_5df5c679a80ae'),(159020,2494,'plan_icons_row_2_plan_icon','514'),(159021,2494,'_plan_icons_row_2_plan_icon','field_5df5c679a8044'),(159022,2494,'plan_icons_row_2_plan_icon_text','Establish more drug monitoring rooms to save lives and improve communities'),(159023,2494,'_plan_icons_row_2_plan_icon_text','field_5df5c679a80ae'),(159024,2494,'plan_icons_row_3_plan_icon','513'),(159025,2494,'_plan_icons_row_3_plan_icon','field_5df5c679a8044'),(159026,2494,'plan_icons_row_3_plan_icon_text','Enhance engagement services for disadvantaged young people'),(159027,2494,'_plan_icons_row_3_plan_icon_text','field_5df5c679a80ae'),(159028,2494,'plan_icons_row_4_plan_icon','512'),(159029,2494,'_plan_icons_row_4_plan_icon','field_5df5c679a8044'),(159030,2494,'plan_icons_row_4_plan_icon_text','End criminal charges that make getting help harder and ruin young lives for minor possession of illicit drugs'),(159031,2494,'_plan_icons_row_4_plan_icon_text','field_5df5c679a80ae'),(159032,2494,'banner_image_position','center'),(159033,2494,'_banner_image_position','field_5f3bc4757dd02'),(159034,2494,'page_image','861'),(159035,2494,'_page_image','field_5f868320f904a'),(159036,2494,'echo_title','0'),(159037,2494,'_echo_title','field_5f868f339dd59'),(159038,2494,'problem_panel_title',''),(159039,2494,'_problem_panel_title','field_5f20f3cd80eb2'),(159040,2494,'problem_panel_items',''),(159041,2494,'_problem_panel_items','field_5f20f3dbe5a77'),(159042,2494,'problem_subhead',''),(159043,2494,'_problem_subhead','field_5f2121dff763d'),(159044,2494,'solution_title',''),(159045,2494,'_solution_title','field_5f21219394b8b'),(159046,2494,'solution_panel_items',''),(159047,2494,'_solution_panel_items','field_5f2121a594b8c'),(159048,2494,'mship_title',''),(159049,2494,'_mship_title','field_5f8fb9dc29b4c'),(159050,2494,'mship_intro',''),(159051,2494,'_mship_intro','field_5f8fb9f129b4d'),(159052,2494,'mship_benefit_items',''),(159053,2494,'_mship_benefit_items','field_5f8fba0629b4e'),(159054,2494,'mship_more_button_text',''),(159055,2494,'_mship_more_button_text','field_5f8fbac3a6ace'),(159056,2494,'mship_more_url',''),(159057,2494,'_mship_more_url','field_5f8fbaeaa6acf'),(159058,2494,'mship_apprl_button_text',''),(159059,2494,'_mship_apprl_button_text','field_5f8fbb25feba0'),(159060,2494,'mship_apply_url',''),(159061,2494,'_mship_apply_url','field_5f8fbb3afeba1'),(159062,2494,'petition_intro_head',''),(159063,2494,'_petition_intro_head','field_5deed527179d8'),(159064,2494,'petition_intro_text',''),(159065,2494,'_petition_intro_text','field_5deed54b179d9'),(159066,2494,'petition_read_more',''),(159067,2494,'_petition_read_more','field_5deed566179da'),(159068,2494,'petition_form_title',''),(159069,2494,'_petition_form_title','field_5deed58b77e6b'),(159070,2494,'petition_form',''),(159071,2494,'_petition_form','field_5deed