2682b'),(165360,2532,'team_members','4'),(165361,2532,'_team_members','field_5b75708c26827'),(165362,2532,'team_members_3_member_title','Manager'),(165363,2532,'_team_members_3_member_title','field_5b7570b326828'),(165364,2532,'team_members_3_first_name','Josh'),(165365,2532,'_team_members_3_first_name','field_5b7570cf26829'),(165366,2532,'team_members_3_last_name','Maneeva'),(165367,2532,'_team_members_3_last_name','field_5b7570de2682a'),(165368,2532,'team_members_3_member_text','Aliquam erat volutpat Ut wisi enim ad minim veniam laoreet dolore magna.'),(165369,2532,'_team_members_3_member_text','field_5b7570f12682b'),(165370,2532,'team_members_0_member_image','367'),(165371,2532,'_team_members_0_member_image','field_5b7572a89973e'),(165372,2532,'team_members_1_member_image','367'),(165373,2532,'_team_members_1_member_image','field_5b7572a89973e'),(165374,2532,'team_members_2_member_image','367'),(165375,2532,'_team_members_2_member_image','field_5b7572a89973e'),(165376,2532,'team_members_3_member_image','367'),(165377,2532,'_team_members_3_member_image','field_5b7572a89973e'),(165378,2532,'banner_button',''),(165379,2532,'_banner_button','field_5b568147fd367'),(165380,2532,'intro_col_1','The Take Control Campaign is a new movement of people who want to make Australia safer when it comes to drugs.'),(165381,2532,'_intro_col_1','field_5df5c6cef3ddb'),(165382,2532,'intro_col_2','The campaign has been launched by the Ted Noffs Foundation, Australia\'s largest provider of drug and alcohol treatment services for young people. The Foundation strives to help disadvantaged young people become advantaged and supports them on their journey to take back control of their lives.'),(165383,2532,'_intro_col_2','field_5df5c6deee1ca'),(165384,2532,'intro_col_3','With community support, the Take Control Campaign aims to change the conversation surrounding drugs and drug use in Australia. Through our common sense plan, we are demanding governments take control of the issue and fix our broken drug laws.'),(165385,2532,'_intro_col_3','field_5df5c6e99b7a8'),(165386,2532,'intro_logo','610'),(165387,2532,'_intro_logo','field_5df5c6f18c801'),(165388,2532,'intro_title','Decades of failed drug policy have resulted in unnecessary suffering. We have a secret and chaotic black market run by criminals and gangs. We have no control.'),(165389,2532,'_intro_title','field_5df5c6799cfec'),(165390,2532,'intro_bullets','Despite the best efforts of our police forces, for every drug dealer we catch, more simply start and operate with impunity.\r\n\r\nAny teenager can get drugs easily. People who use drugs can’t be sure what they are taking. Innocent young people who are just experimenting can buy themselves a death sentence.\r\n\r\nWorst of all, it’s often hard for people with problems to access help because they\'re treated like criminals.\r\n\r\nThis is because our governments refuse to take control of drugs.\r\n\r\nParents need greater tools and strategies to help their kids cope with the challenges of modern life.\r\n\r\nIt’s not good enough to put our heads in the sand and tell our kids to “just say no”. It doesn\'t work.\r\n\r\nIt\'s time to end the fear tactics. It\'s time to end the marketing gimmicks. People need real resources to reduce the harms associated with drug use.\r\n\r\nOur state and federal governments need to work together to get drug use under control by putting health and safety first.'),(165391,2532,'_intro_bullets','field_5df5c6799d05a'),(165392,2532,'intro_text',''),(165393,2532,'_intro_text','field_5df5c6799d0c6'),(165394,2532,'plan_title',''),(165395,2532,'_plan_title','field_5df5c6799d197'),(165396,2532,'plan_icons_row','5'),(165397,2532,'_plan_icons_row','field_5df5c6799d211'),(165398,2532,'plan_icons_row_0_plan_icon','516'),(165399,2532,'_plan_icons_row_0_plan_icon','field_5df5c679a8044'),(165400,2532,'plan_icons_row_0_plan_icon_text',' Roll out pill testing services nationally to reduce harm at music festivals and parties'),(165401,2532,'_plan_icons_row_0_plan_icon_text','field_5df5c679a80ae'),(165402,2532,'plan_icons_row_1_plan_icon','515'),(165403,2532,'_plan_icons_row_1_plan_icon','field_5df5c679a8044'),(165404,2532,'plan_icons_row_1_plan_icon_text','Expand treatment services for people suffering from drug problems'),(165405,2532,'_plan_icons_row_1_plan_icon_text','field_5df5c679a80ae'),(165406,2532,'plan_icons_row_2_plan_icon','514'),(165407,2532,'_plan_icons_row_2_plan_icon','field_5df5c679a8044'),(165408,2532,'plan_icons_row_2_plan_icon_text','Establish more drug monitoring rooms to save lives and improve communities'),(165409,2532,'_plan_icons_row_2_plan_icon_text','field_5df5c679a80ae'),(165410,2532,'plan_icons_row_3_plan_icon','513'),(165411,2532,'_plan_icons_row_3_plan_icon','field_5df5c679a8044'),(165412,2532,'plan_icons_row_3_plan_icon_text','Enhance engagement services for disadvantaged young people'),(165413,2532,'_plan_icons_row_3_plan_icon_text','field_5df5c679a80ae'),(165414,2532,'plan_icons_row_4_plan_icon','512'),(165415,2532,'_plan_icons_row_4_plan_icon','field_5df5c679a8044'),(165416,2532,'plan_icons_row_4_plan_icon_text','End criminal charges that make getting help harder and ruin young lives for minor possession of illicit drugs'),(165417,2532,'_plan_icons_row_4_plan_icon_text','field_5df5c679a80ae'),(165418,2532,'banner_image_position','center'),(165419,2532,'_banner_image_position','field_5f3bc4757dd02'),(165420,2532,'page_image','861'),(165421,2532,'_page_image','field_5f868320f904a'),(165422,2532,'echo_title','0'),(165423,2532,'_echo_title','field_5f868f339dd59'),(165424,2532,'problem_panel_title',''),(165425,2532,'_problem_panel_title','field_5f20f3cd80eb2'),(165426,2532,'problem_panel_items',''),(165427,2532,'_problem_panel_items','field_5f20f3dbe5a77'),(165428,2532,'problem_subhead',''),(165429,2532,'_problem_subhead','field_5f2121dff763d'),(165430,2532,'solution_title',''),(165431,2532,'_solution_title','field_5f21219394b8b'),(165432,2532,'solution_panel_items',''