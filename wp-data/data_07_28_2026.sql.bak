st_image_title','Lifestart is about supporting young children'),(25712,1128,'_first_image_title','field_5b67ca606afc4'),(25713,1128,'first_image_cont','from 0-24 years living with disabilities and their familes'),(25714,1128,'_first_image_cont','field_5b67caff6afc5'),(25715,1128,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(25716,1128,'_first_image_button','field_5b67cb0d6afc6'),(25717,1128,'second _image_title','Lifestart is about supporting young children'),(25718,1128,'_second _image_title','field_5b67cb20ddf9a'),(25719,1128,'second_image_cont','from 0-24 years living with disabilities and their familes'),(25720,1128,'_second_image_cont','field_5b67cb24ddf9b'),(25721,1128,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(25722,1128,'_second_image_button','field_5b67cb29ddf9c'),(25723,1128,'second_image_title','Lifestart is about supporting young children'),(25724,1128,'_second_image_title','field_5b67cb20ddf9a'),(25725,1128,'page_col_image','412'),(25726,1128,'_page_col_image','field_5de6546e7c63a'),(25727,1128,'page_col_image_3','437'),(25728,1128,'_page_col_image_3','field_5de6e3998e07e'),(25729,1128,'sec_2_title','Community'),(25730,1128,'_sec_2_title','field_5de6e3ef2798f'),(25731,1128,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(25732,1128,'_sec_2_text','field_5de78dc89e613'),(25733,1128,'sec_3_title','The Project'),(25734,1128,'_sec_3_title','field_5de6e3d37d8da'),(25735,1128,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(25736,1128,'_sec_3_text','field_5de6e4044e5e8'),(25737,1128,'page_col_image_2','436'),(25738,1128,'_page_col_image_2','field_5de6546e7c63a'),(25739,1128,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(25740,1128,'_sec_2_button','field_5de6e58c86706'),(25741,1128,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(25742,1128,'_sec_3_button','field_5de6e5a243c03'),(25743,1128,'page_col_image_4','455'),(25744,1128,'_page_col_image_4','field_5de70801090ce'),(25745,1128,'sec_4_title','Location'),(25746,1128,'_sec_4_title','field_5de7082a12a81'),(25747,1128,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(25748,1128,'_sec_4_text','field_5de7084812a82'),(25749,1128,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(25750,1128,'_sec_4_button','field_5de7085e12a83'),(25751,1128,'news_title','Project updates'),(25752,1128,'_news_title','field_5de78da3aabb9'),(25753,1128,'sec_2_text_copy',''),(25754,1128,'_sec_2_text_copy','field_5de78dc89e613'),(25755,1128,'timeline-title','Timeline'),(25756,1128,'_timeline-title','field_5de78df29e615'),(25757,1128,'timeline_title','Timeline'),(25758,1128,'_timeline_title','field_5de78df29e615'),(25759,1128,'contact_title','Contact us'),(25760,1128,'_contact_title','field_5de7981e06057'),(25761,1128,'contact_intro','Contact text...'),(25762,1128,'_contact_intro','field_5de7983506058'),(25763,1128,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(25764,1128,'_news_button','field_5de8329896e02'),(25765,11