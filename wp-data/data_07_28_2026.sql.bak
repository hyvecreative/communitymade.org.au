618,2046,'_team_members_2_member_title','field_5b7570b326828'),(108619,2046,'team_members_2_first_name','John'),(108620,2046,'_team_members_2_first_name','field_5b7570cf26829'),(108621,2046,'team_members_2_last_name','Jones'),(108622,2046,'_team_members_2_last_name','field_5b7570de2682a'),(108623,2046,'team_members_2_member_text','Laoreet dolore magna aliquam erat volutpat. Ut wisi enim ad minim veniam.'),(108624,2046,'_team_members_2_member_text','field_5b7570f12682b'),(108625,2046,'team_members','4'),(108626,2046,'_team_members','field_5b75708c26827'),(108627,2046,'team_members_3_member_title','Manager'),(108628,2046,'_team_members_3_member_title','field_5b7570b326828'),(108629,2046,'team_members_3_first_name','Josh'),(108630,2046,'_team_members_3_first_name','field_5b7570cf26829'),(108631,2046,'team_members_3_last_name','Maneeva'),(108632,2046,'_team_members_3_last_name','field_5b7570de2682a'),(108633,2046,'team_members_3_member_text','Aliquam erat volutpat Ut wisi enim ad minim veniam laoreet dolore magna.'),(108634,2046,'_team_members_3_member_text','field_5b7570f12682b'),(108635,2046,'team_members_0_member_image','367'),(108636,2046,'_team_members_0_member_image','field_5b7572a89973e'),(108637,2046,'team_members_1_member_image','367'),(108638,2046,'_team_members_1_member_image','field_5b7572a89973e'),(108639,2046,'team_members_2_member_image','367'),(108640,2046,'_team_members_2_member_image','field_5b7572a89973e'),(108641,2046,'team_members_3_member_image','367'),(108642,2046,'_team_members_3_member_image','field_5b7572a89973e'),(108643,2046,'banner_button',''),(108644,2046,'_banner_button','field_5b568147fd367'),(108645,2046,'intro_col_1','The Take Control Campaign is a new movement of people who want to make Australia safer when it comes to drugs.'),(108646,2046,'_intro_col_1','field_5df5c6cef3ddb'),(108647,2046,'intro_col_2','The campaign has been launched by the Ted Noffs Foundation, Australia\'s largest provider of drug and alcohol treatment services for young people. The Foundation strives to help disadvantaged young people become advantaged and supports them on their journey to take back control of their lives.'),(108648,2046,'_intro_col_2','field_5df5c6deee1ca'),(108649,2046,'intro_col_3','With community support, the Take Control Campaign aims to change the conversation surrounding drugs and drug use in Australia. Through our common sense plan, we are demanding governments take control of the issue and fix our broken drug laws.'),(108650,2046,'_intro_col_3','field_5df5c6e99b7a8'),(108651,2046,'intro_logo','610'),(108652,2046,'_intro_logo','field_5df5c6f18c801'),(108653,2046,'intro_title','Decades of failed drug policy have resulted in unnecessary suffering. We have a secret and chaotic black market run by criminals and gangs. We have no control.'),(108654,2046,'_intro_title','field_5df5c6799cfec'),(108655,2046,'intro_bullets','Despite the best efforts of our police forces, for every drug dealer we catch, more simply start and operate with impunity.\r\n\r\nAny teenager can get drugs easily. People who use drugs can’t be sure what they are taking. Innocent young people who are just experimenting can buy themselves a death sentence.\r\n\r\nWorst of all, it’s often hard for people with problems to access help because they\'re treated like criminals.\r\n\r\nThis is because our governments refuse to take control of drugs.\r\n\r\nParents need greater tools and strategies to help their kids cope with the challenges of modern life.\r\n\r\nIt’s not good enough to put our heads in the sand and tell our kids to “just say no”. It doesn\'t work.\r\n\r\nIt\'s time to end the fear tactics. It\'s time to end the marketing gimmicks. People need real resources to reduce the harms associated with drug use.\r\n\r\nOur state and federal governments need to work together to get drug use under control by putting health and safety first.'),(108656,2046,'_intro_bullets','field_5df5c6799d05a'),(108657,2046,'intro_text',''),(108658,2046,'_intro_text','field_5df5c6799d0c6'),(108659,2046,'plan_title',''),(108660,2046,'_plan_title','field_5df5c6799d197'),(108661,2046,'plan_icons_row','5'),(108662,2046,'_plan_icons_row','field_5df5c6799d211'),(108663,2046,'plan_icons_row_0_plan_icon','516'),(108664,2046,'_plan_icons_row_0_plan_icon','field_5df5c679a8044'),(108665,2046,'plan_icons_row_0_plan_icon_text',' Roll out pill testing services nationally to reduce harm at music festivals and parties'),(108666,2046,'_plan_icons_row_0_plan_icon_text','field_5df5c679a80ae'),(108667,2046,'plan_icons_row_1_plan_icon','515'),(108668,2046,'_plan_icons_row_1_plan_icon','field_5df5c679a8044'),(108669,2046,'plan_icons_row_1_plan_icon_text','Expand treatment services for people suffering from drug problems'),(108670,2046,'_plan_icons_row_1_plan_icon_text','field_5df5c679a80ae'),(108671,2046,'plan_icons_row_2_plan_icon','514'),(108672,2046,'_plan_icons_row_2_plan_icon','field_5df5c679a8044'),(108673,2046,'plan_icons_row_2_plan_icon_text','Establish more drug monitoring rooms to save lives and improve communities'),(108674,2046,'_plan_icons_row_2_plan_icon_text','field_5df5c679a80ae'),(108675,2046,'plan_icons_row_3_plan_icon','513'),(108676,2046,'_plan_icons_row_3_plan_icon','field_5df5c679a8044'),(108677,2046,'plan_icons_row_3_plan_icon_text','Enhance engagement services for disadvantaged young people'),(108678,2046,'_plan_icons_row_3_plan_icon_text','field_5df5c679a80ae'),(108679,2046,'plan_icons_row_4_plan_icon','512'),(108680,2046,'_plan_icons_row_4_plan_icon','field_5df5c679a8044'),(108681,2046,'plan_icons_row_4_plan_icon_text','End criminal charges that make getting help harder and ruin young lives for minor possession of illicit drugs'),(108682,2046,'_plan_icons_row_4_plan_icon_text','field_5df5c679a80ae'),(108683,2046,'banner_image_position','center'),(108684,2046,'_banner_image_position','field_5f3bc4757dd02'),(108685,2046,'page_image','861'),(108686,2046,'_page_image','field_5f868320f904a'),(108687,2046,'echo_title',