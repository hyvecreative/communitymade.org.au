_text','field_693d4ad641980'),(205199,2740,'what_happened','2'),(205200,2740,'_what_happened','field_693d4a6f4197c'),(205201,2740,'what_happened_0_happ_icon','2703'),(205202,2740,'_what_happened_0_happ_icon','field_693d4c9b3ec4d'),(205203,2740,'what_happened_1_happ_icon','2703'),(205204,2740,'_what_happened_1_happ_icon','field_693d4c9b3ec4d'),(205205,2740,'display_news_section',''),(205206,2740,'_display_news_section','field_69434cc6d5f7d'),(205207,2740,'issues_head','These are the issues'),(205208,2740,'_issues_head','field_6a3b076406aef'),(205209,2740,'issues_items_0_issue_icon','2705'),(205210,2740,'_issues_items_0_issue_icon','field_6a3b07b506af1'),(205211,2740,'issues_items_0_issues_item_hd','A secure home is slipping out of reach'),(205212,2740,'_issues_items_0_issues_item_hd','field_6a3b07d706af2'),(205213,2740,'issues_items_0_issues_item_txt','•	A shortage of 132,000 social and affordable rental homes\r\n•	70,000+ households waiting for social housing\r\n•	Record-high private market rents\r\n•	Home ownership increasingly out of reach for generations'),(205214,2740,'_issues_items_0_issues_item_txt','field_6a3b07fc06af3'),(205215,2740,'issues_items_0_issues_link_text',''),(205216,2740,'_issues_items_0_issues_link_text','field_6a3b080f06af4'),(205217,2740,'issues_items_0_issues_target_url',''),(205218,2740,'_issues_items_0_issues_target_url','field_6a3b082b06af5'),(205219,2740,'issues_items','2'),(205220,2740,'_issues_items','field_6a3b078206af0'),(205221,2740,'issues_items_1_issue_icon','2708'),(205222,2740,'_issues_items_1_issue_icon','field_6a3b07b506af1'),(205223,2740,'issues_items_1_issues_item_hd','The solutions we need '),(205224,2740,'_issues_items_1_issues_item_hd','field_6a3b07d706af2'),(205225,2740,'issues_items_1_issues_item_txt','Community housing works. We’re calling on the next NSW Government for three actions: long-term investment for new community housing, more funding to future-proof existing homes, and support to help people stayed housed.'),(205226,2740,'_issues_items_1_issues_item_txt','field_6a3b07fc06af3'),(205227,2740,'issues_items_1_issues_link_text',''),(205228,2740,'_issues_items_1_issues_link_text','field_6a3b080f06af4'),(205229,2740,'issues_items_1_issues_target_url',''),(205230,2740,'_issues_items_1_issues_target_url','field_6a3b082b06af5'),(205231,2740,'issues_items_0_issues_sub_head',''),(205232,2740,'_issues_items_0_issues_sub_head','field_6a3b0aa79365e'),(205233,2740,'issues_items_1_issues_sub_head',''),(205234,2740,'_issues_items_1_issues_sub_head','field_6a3b0aa79365e'),(205235,2740,'video_head','The people next door'),(205236,2740,'_video_head','field_6a5ff269ef234'),(205237,2740,'video_intro','Nurses. Childcare workers. Single parents. Older Australians who want to stay near the people they love. Community housing is the solution.'),(205238,2740,'_video_intro','field_6a606161b34b6'),(205239,2741,'footnotes',''),(205240,19,'show_modified_date',''),(205241,19,'_show_modified_date','field_6941f3e775d5f'),(205242,2741,'banner_head','About'),(205243,2741,'_banner_head','field_5b568121a8ffe'),(205244,2741,'banner_sub','Sub Head'),(205245,2741,'_banner_sub','field_5b568139fd366'),(205246,2741,'first_image_title','The Lifestart difference'),(205247,2741,'_first_image_title','field_5b67ca606afc4'),(205248,2741,'first_image_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut laoreet. \r\n\r\nLorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut laoreet.'),(205249,2741,'_first_image_cont','field_5b67caff6afc5'),(205250,2741,'first_image_button',''),(205251,2741,'_first_image_button','field_5b67cb0d6afc6'),(205252,2741,'second_image_title','Our Philosophy'),(205253,2741,'_second_image_title','field_5b67cb20ddf9a'),(205254,2741,'second_image_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut laoreet. \r\n\r\nLorem ipsum dolor sit amet, cons