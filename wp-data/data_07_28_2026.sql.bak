2'),(180471,2657,'_gh_block_home_1_help_image','field_65262cd0143e2'),(180472,2657,'gh_block_home_1_help_title','I have a problem with  my super fund'),(180473,2657,'_gh_block_home_1_help_title','field_65262cec143e3'),(180474,2657,'gh_block_home_1_help_url','#'),(180475,2657,'_gh_block_home_1_help_url','field_65262cf4143e4'),(180476,2657,'gh_block_home_2_help_image','1961'),(180477,2657,'_gh_block_home_2_help_image','field_65262cd0143e2'),(180478,2657,'gh_block_home_2_help_title','How do I choose the right super? '),(180479,2657,'_gh_block_home_2_help_title','field_65262cec143e3'),(180480,2657,'gh_block_home_2_help_url','#'),(180481,2657,'_gh_block_home_2_help_url','field_65262cf4143e4'),(180482,2657,'gh_block_home','3'),(180483,2657,'_gh_block_home','field_65262c8a143e1'),(180484,2657,'turn_on_insights',''),(180485,2657,'_turn_on_insights','field_645c4a2e654a6'),(180486,2657,'report_questions','a:3:{i:0;s:2:\"59\";i:1;s:2:\"61\";i:2;s:4:\"2587\";}'),(180487,2657,'_report_questions','field_6109ed5e02e5a'),(180488,2657,'intro_text','The Disability Dialogue is a place where people with disabilities, their families, organisations providing support, academics, and the wider community come together to work on things that matter to us.\r\n\r\nThe Dialogue is a hub of knowledge and collaboration, separate from government, where we work together to come up. With new ideas on important topics. Our ideas can make a big difference in how services and systems are set up for people with disabilities.'),(180489,2657,'_intro_text','field_66441acfe963c'),(180490,2657,'word_link','#'),(180491,2657,'_word_link','field_6646c69723804'),(180492,2657,'pdf_link','#'),(180493,2657,'_pdf_link','field_6646c6da23805'),(180494,2657,'intro_boxes_0_box_image','2241'),(180495,2657,'_intro_boxes_0_box_image','field_65262db5d36ee'),(180496,2657,'intro_boxes_1_box_image','2179'),(180497,2657,'_intro_boxes_1_box_image','field_65262db5d36ee'),(180498,2657,'intro_boxes_2_box_image','2012'),(180499,2657,'_intro_boxes_2_box_image','field_65262db5d36ee'),(180500,2657,'intro_boxes_0_box_excerpt','Excerpt text here just a sentance or so and no more.'),(180501,2657,'_intro_boxes_0_box_excerpt','field_665975273e827'),(180502,2657,'intro_boxes_1_box_excerpt','Excerpt text here just a sentance or so and no more.'),(180503,2657,'_intro_boxes_1_box_excerpt','field_665975273e827'),(180504,2657,'intro_boxes_2_box_excerpt','Excerpt text here just a sentance or so and no more.'),(180505,2657,'_intro_boxes_2_box_excerpt','field_665975273e827'),(180506,2657,'intro_boxes_0_btn-text','Latest events'),(180507,2657,'_intro_boxes_0_btn-text','field_665abda8b8d4b'),(180508,2657,'intro_boxes_1_btn-text','Latest projects'),(180509,2657,'_intro_boxes_1_btn-text','field_665abda8b8d4b'),(180510,2657,'intro_boxes_2_btn-text','Latest ideas'),(180511,2657,'_intro_boxes_2_btn-text','field_665abda8b8d4b'),(180512,2657,'display-easy-read',''),(180513,2657,'_display-easy-read','field_666129bd2da00'),(180514,2657,'hm_hero_sum','Statement about the issue and lost life savings'),(180515,2657,'_hm_hero_sum','field_64ed37241effa'),(180516,2657,'hm_hero_sub','By investing in the Shield and First Guardian master funds'),(180517,2657,'_hm_hero_sub','field_64ed37241effa'),(180518,2657,'intro_head','We’re here to help.'),(180519,2657,'_intro_head','field_64e828783ad9f'),(180520,2657,'intro_content','About 12,000 people invested their hard-earned super savings in two investment funds which have now collapsed, called Shield Master Fund and First Guardian Master Fund. Most people will be entitled to get some money back, but you need to take action soon. This website has information and tools to help you understand what happened, where to get help and how to take back your super.'),(180521,2657,'_intro_content','field_66441acfe963c'),(180522,2657,'deadline_heading','Important deadlines'),(180523,2657,'_deadline_heading','field_69365ff82e6f2'),(180524,2657,'deadline_content','You need to take action before the deadline to take your super back.'),(180525,2657,'_deadline_content','field_693660342e6f3'),(180526,2657,'deadline_button_text','Find out more'),(180527,2657,'_deadline_button_text','field_693660482e6f4'),(180528,2657,'deadline_button_url','/key-deadlines/'),(180529,2657,'_deadline_button_url','field_693660912e6f5'),(180530,2657,'what_head','What happened?'),(180531,2657,'_what_head','field_69366611096ac'),(180532,2657,'what_happened_0_happ_sub','What are Shield and First Guardian?'),(180533,2657,'_what_happened_0_happ_sub','field_693d4a8b4197d'),(180534,2657,'what_happened_0_happ_content','About 12,000 people invested their hard-earned super savings in two investment funds called Shield Master Fund and First Guardian Master Fund. Those funds have collapsed, and a large part of the $1.2 billion people invested is gone.\r\n\r\nMost people invested through financial advisers who contacted them after they clicked on a social media ad offering a free super comparison or review.'),(180535,2657,'_what_happened_0_happ_content','field_693d4aa84197e'),(180536,2657,'what_happened_0_happ_url','/what-happened/'),(180537,2657,'_what_happened_0_happ_url','field_693d4aba4197f'),(180538,2657,'what_happened_0_happ_link_text','More'),(180539,2657,'_what_happened_0_happ_link_text','field_693d4ad641980'),(180540,2657,'what_happened_1_happ_sub','What is being done about this?'),(180541,2657,'_what_happened_1_happ_sub','field_693d4a8b4197d'),(180542,2657,'what_happened_1_happ_content','There is a lot of work being done to try to get money back for people who invested.\r\n\r\nThe regulator is also investigating what happened and has started enforcement action against a number of different people and companies for their involvement in the collapses of Shield and First Guardian Master Funds. Learn about the progress of this work'),(180543,2657,'_what_happened_1_happ_content','field_693d4aa84197e'),(180544,2657,'what_happened_1_happ_url','/what-happened/'),(180545,2657,'_what_happened_1_happ_url','field_693d4aba4197f'),(180546,2657,'what_happened_1_happ_link_text','More'),(180547,2657,'_what_happened_1_happ_link_text','field_693d4ad641980'),(180548,2657,'what_happened','2'),(180549,2657,'_what_happened','field_693d4a6f4197c'),(180550,2657,'what_happened_0_happ_icon','2605'),(180551,2657,'_what_happened_0_happ_icon','field_693d4c9b3ec4d'),(180552,2657,'what_happened_1_happ_icon','2604'),(180553,2657,'_what_happened_1_happ_icon','field_693d4c9b3ec4d'),(180554,2150,'_wpa_old_event','a:2:{i:0;O:8:\"stdClass\":5:{s:1:\"0\";s:9:\"skiplinks\";s:1:\"1\";a:2:{i:0;s:14:\"control-titles\";i:1;s:1:\"1\";}s:1:\"2\";a:2:{i:0;s:12:\"link-targets\";i:1;s:1:\"8\";}s:1:\"3\";a:2:{i:0;s:16:\"control-tabindex\";i:1;s:1:\"3\";}s:9:\"timestamp\";s:0:\"\";}i:1;O:8:\"stdClass\":3:{s:1:\"0\";s:9:\"skiplinks\";s:1:\"1\";a:2:{i:0;s:14:\"control-titles\";i:1;s:1:\"1\";}s:9:\"timestamp\";s:0:\"\";}}'),(180555,2150,'_wpa_event','{\"0\":\"skiplinks\",\"1\":[\"control-titles\",\"1\"],\"2\":[\"link-targets\",\"8\"],\"3\":[\"control-tabindex\",\"3\"],\"timestamp\":1765926251}'),(180556,2658,'_wpa_browser','{\"name\":\"Safari\",\"version\":\"14.0.3\",\"platform\":\"iPhone\",\"update_url\":\"\",\"img_src\":\"\",\"img_src_ssl\":\"\",\"current_version\":\"\",\"upgrade\":false,\"insecure\":false,\"mobile\":true}'),(180557,2146,'_wpa_old_event','a:2:{i:0;O:8:\"stdClass\":5:{s:1:\"0\";s:9:\"skiplinks\";s:1:\"1\";a:2:{i:0;s:14:\"control-titles\";i:1;s:1:\"1\";}s:1:\"2\";a:2:{i:0;s:12:\"link-targets\";i:1;s:1:\"8\";}s:1:\"3\";a:2:{i:0;s:16:\"control-tabindex\";i:1;s:1:\"3\";}s:9:\"timestamp\";s:0:\"\";}i:1;O:8:\"stdClass\":3:{s:1:\"0\";s:9:\"skiplinks\";s:1:\"1\";a:2:{i:0;s:14:\"control-titles\";i:1;s:1:\"1\";}s:9:\"timestamp\";s:0:\"\";}}'),(180558,2146,'_wpa_event','{\"0\":\"skiplinks\",\"1\":[\"control-titles\",\"1\"],\"2\":[\"link-targets\",\"8\"],\"3\":[\"control-tabindex\",\"3\"],\"timestamp\":1765927229}'),(180562,2661,'_wpa_browser','{\"name\":\"Safari\",\"version\":\"14.0.3\",\"platform