work id=7]'),(176375,2606,'_signup_form','field_64fd8361d90ac'),(176376,2606,'signup_head','Join the campaign'),(176377,2606,'_signup_head','field_64fd83dc6b0b1'),(176378,2606,'boxes_section_title','Boxes'),(176379,2606,'_boxes_section_title','field_65262bbfd17fc'),(176380,2606,'intro_boxes_0_box_icon','1943'),(176381,2606,'_intro_boxes_0_box_icon','field_65262db5d36ee'),(176382,2606,'intro_boxes_0_box_title','Events'),(176383,2606,'_intro_boxes_0_box_title','field_65262d29ed8e3'),(176384,2606,'intro_boxes_0_box_dropdown','Our rigorous, conflict-free research and data analysis lifts the lid on fund performance, fees and insurance. Drawing on our policy expertise, we turn this analysis into action by using it to back reform and make super easier for people to understand. <a href=\"//localhost:4000:4000:4000:4000:4000:4000:/how/\">More</a>'),(176385,2606,'_intro_boxes_0_box_dropdown','field_65262dead0a0c'),(176386,2606,'intro_boxes_1_box_icon','1941'),(176387,2606,'_intro_boxes_1_box_icon','field_65262db5d36ee'),(176388,2606,'intro_boxes_1_box_title','Projects'),(176389,2606,'_intro_boxes_1_box_title','field_65262d29ed8e3'),(176390,2606,'intro_boxes_1_box_dropdown','Our rigorous, conflict-free research and data analysis lifts the lid on fund performance, fees and insurance. Drawing on our policy expertise, we turn this analysis into action by using it to back reform and make super easier for people to understand. <a href=\"//localhost:4000:4000:4000:4000:4000:4000:/how/\">More</a>'),(176391,2606,'_intro_boxes_1_box_dropdown','field_65262dead0a0c'),(176392,2606,'intro_boxes_2_box_icon','1937'),(176393,2606,'_intro_boxes_2_box_icon','field_65262db5d36ee'),(176394,2606,'intro_boxes_2_box_title','Ideas'),(176395,2606,'_intro_boxes_2_box_title','field_65262d29ed8e3'),(176396,2606,'intro_boxes_2_box_dropdown','Our rigorous, conflict-free research and data analysis lifts the lid on fund performance, fees and insurance. Drawing on our policy expertise, we turn this analysis into action by using it to back reform and make super easier for people to understand. <a href=\"//localhost:4000:4000:4000:4000:4000:4000:/how/\">More</a>'),(176397,2606,'_intro_boxes_2_box_dropdown','field_65262dead0a0c'),(176398,2606,'intro_boxes','3'),(176399,2606,'_intro_boxes','field_65262d14ed8e2'),(176400,2606,'get_help_section_title','Get Help'),(176401,2606,'_get_help_section_title','field_65262c35143de'),(176402,2606,'get_help_block_home',''),(176403,2606,'_get_help_block_home','field_65262c8a143e1'),(176404,2606,'gh_block_home_0_help_image','1956'),(176405,2606,'_gh_block_home_0_help_image','field_65262cd0143e2'),(176406,2606,'gh_block_home_0_help_title','How much do I need to retire? '),(176407,2606,'_gh_block_home_0_help_title','field_65262cec143e3'),(176408,2606,'gh_block_home_0_help_url','#'),(176409,2606,'_gh_block_home_0_help_url','field_65262cf4143e4'),(176410,2606,'gh_block_home_1_help_image','1962'),(176411,2606,'_gh_block_home_1_help_image','field_65262cd0143e2'),(176412,2606,'gh_block_home_1_help_title','I have a problem with  my super fund'),(176413,2606,'_gh_block_home_1_help_title','field_65262cec143e3'),(176414,2606,'gh_block_home_1_help_url','#'),(176415,2606,'_gh_block_home_1_help_url','field_65262cf4143e4'),(176416,2606,'gh_block_home_2_help_image','1961'),(176417,2606,'_gh_block_home_2_help_image','field_65262cd0143e2'),(176418,2606,'gh_block_home_2_help_title','How do I choose the right super? '),(176419,2606,'_gh_block_home_2_help_title','field_65262cec143e3'),(176420,2606,'gh_block_home_2_help_url','#'),(176421,2606,'_gh_block_home_2_help_url','field_65262cf4143e4'),(176422,2606,'gh_block_home','3'),(176423,2606,'_gh_block_home','field_65262c8a143e1'),(176424,2606,'turn_on_insights',''),(176425,2606,'_turn_on_insights','field_645c4a2e654a6'),(176426,2606,'report_questions','a:3:{i:0;s:2:\"59\";i:1;s:2:\"61\";i:2;s:4:\"2587\";}'),(176427,2606,'_report_questions','field_6109ed5e02e5a'),(176428,2606,'intro_text','The Disability Dialogue is a place where people with disabilities, their families, organisations providing support, academics, and the wider community come together to work on things that matter to us.\r\n\r\nThe Dialogue is a hub of knowledge and collaboration, separate from government, where we work together to come up. With new ideas on important topics. Our ideas can make a big difference in how services and systems are set up for people with disabilities.'),(176429,2606,'_intro_text','field_66441acfe963c'),(176430,2606,'word_link','#'),(176431,2606,'_word_link','field_6646c69723804'),(176432,2606,'pdf_link','#'),(176433,2606,'_pdf_link','field_6646c6da23805'),(176434,2606,'intro_boxes_0_box_image','2241'),(176435,2606,'_intro_boxes_0_box_image','field_65262db5d36ee'),(176436,2606,'intro_boxes_1_box_image','2179'),(176437,2606,'_intro_boxes_1_box_image','field_65262db5d36ee'),(176438,2606,'intro_boxes_2_box_image','2012'),(176439,2606,'_intro_boxes_2_box_image','field_65262db5d36ee'),(176440,2606,'intro_boxes_0_box_excerpt','Excerpt text here just a sentance or so and no more.'),(176441,2606,'_intro_boxes_0_box_excerpt','field_665975273e827'),(176442,2606,'intro_boxes_1_box_excerpt','Excerpt text here just a sentance or so and no more.'),(176443,2606,'_intro_boxes_1_box_excerpt','field_665975273e827'),(176444,2606,'intro_boxes_2_box_excerpt','Excerpt text here just a sentance or so and no more.'),(176445,2606,'_intro_boxes_2_box_excerpt','field_665975273e827'),(176446,2606,'intro_boxes_0_btn-text','Latest events'),(176447,2606,'_intro_boxes_0_btn-text','field_665abda8b8d4b'),(176448,2606,'intro_boxes_1_btn-text','Latest projects'),(176449,2606,'_intro_boxes_1_btn-text','field_665abda8b8d4b'),(176450,2606,'intro_boxes_2_btn-text','Latest ideas'),(176451,2606,'_intro_boxes_2_btn-text','field_665abda8b8d4b'),(176452,2606,'display-easy-read',''),(176453,2606,'_display-easy-read','field_666129bd2da00'),(176454,2606,'hm_hero_sum','Statement about the issue and lost life savings'),(176455,26