6294564e42239'),(155688,2466,'survey_index_6_survey_url_text','View Results'),(155689,2466,'_survey_index_6_survey_url_text','field_629456584223a'),(155690,2466,'survey_index_7_survey_icon','1493'),(155691,2466,'_survey_index_7_survey_icon','field_6294562942237'),(155692,2466,'survey_index_7_survey_title','Going Off-grid'),(155693,2466,'_survey_index_7_survey_title','field_6294564042238'),(155694,2466,'survey_index_7_survey_url','#'),(155695,2466,'_survey_index_7_survey_url','field_6294564e42239'),(155696,2466,'survey_index_7_survey_url_text','View Results'),(155697,2466,'_survey_index_7_survey_url_text','field_629456584223a'),(155698,2466,'survey_index','8'),(155699,2466,'_survey_index','field_6294561242236'),(155700,2466,'report_title','Download the report'),(155701,2466,'_report_title','field_62f30edfb57e1'),(155702,2466,'report_intro','Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus massa erat, consectetur at semper at, feugiat vel orci. '),(155703,2466,'_report_intro','field_62f30eedb57e2'),(155704,2466,'report_link_url','#'),(155705,2466,'_report_link_url','field_62f30ef4b57e3'),(155706,2466,'report_link_text','Download'),(155707,2466,'_report_link_text','field_62f30f01b57e4'),(155708,2466,'solutions_content','The housing system is complex, and no one solution will solve the complex problems we now face but there are some critical first steps to be taken now.\r\n<ul>\r\n 	<li>Set out an ambitious national housing agreement between commonwealth and state governments with targets and funding for the construction of affordable homes.</li>\r\n 	<li>Phase out tax breaks for property investors and using the increase in revenue to build more public housing.</li>\r\n 	<li>Establish laws which limit rental increases beyond what is fair.</li>\r\n 	<li>Rebalance tenancy laws to provide renters with more security and control, such as eliminating no grounds evictions.</li>\r\n 	<li>Phase out stamp duty and replace it with a broad-based land tax.</li>\r\n</ul>\r\n<h4>While there are many opinions on what policy changes will fix the housing market, doing nothing is not an option.</h4>'),(155709,2466,'_solutions_content','field_640e8b307a958'),(155710,2466,'problem_icons_0_prob_icon','1699'),(155711,2466,'_problem_icons_0_prob_icon','field_640fa0291d519'),(155712,2466,'problem_icons_0_prob_concerned_stat','70% highly concerned'),(155713,2466,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(155714,2466,'problem_icons_0_prob_concerded_text','are highly concerned'),(155715,2466,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(155716,2466,'problem_icons_0_prob_issue_text',''),(155717,2466,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(155718,2466,'problem_icons','4'),(155719,2466,'_problem_icons','field_640fa0191d518'),(155720,2466,'ceh_content_left',''),(155721,2466,'_ceh_content_left','field_640e97e8f1c8c'),(155722,2466,'ceh_content_right',''),(155723,2466,'_ceh_content_right','field_640e97fdf1c8d'),(155724,2466,'pc_content_left',''),(155725,2466,'_pc_content_left','field_640e983bf1c8f'),(155726,2466,'pc_content_right',''),(155727,2466,'_pc_content_right','field_640e984df1c90'),(155728,2466,'problem_icons_1_prob_icon','1699'),(155729,2466,'_problem_icons_1_prob_icon','field_640fa0291d519'),(155730,2466,'problem_icons_1_prob_concerned_stat','69% highly concerned'),(155731,2466,'_problem_icons_1_prob_concerned_stat','field_640fa0dd81d95'),(155732,2466,'problem_icons_1_prob_concerded_text','are highly concerned'),(155733,2466,'_problem_icons_1_prob_concerded_text','field_640fa10181d96'),(155734,2466,'problem_icons_1_prob_issue_text',''),(155735,2466,'_problem_icons_1_prob_issue_text','field_640fa11a81d97'),(155736,2466,'problem_icons_2_prob_icon','1699'),(155737,2466,'_problem_icons_2_prob_icon','field_640fa0291d519'),(155738,2466,'problem_icons_2_prob_concerned_stat','64% highly concerned'),(155739,2466,'_problem_icons_2_prob_concerned_stat','field_640fa0dd81d95'),(155740,2466,'problem_icons_2_prob_concerded_text','are highly concerned'),(155741,2466,'_problem_icons_2_prob_concerded_text','field_640fa10181d96'),(155742,2466,'problem_icons_2_prob_issue_text',''),(155743,2466,'_problem_icons_2_prob_issue_text','field_640fa11a81d97'),(155744,2466,'problem_icons_3_prob_icon','1699'),(155745,2466,'_problem_icons_3_prob_icon','field_640fa0291d519'),(155746,2466,'problem_icons_3_prob_concerned_stat','64% highly concerned'),(155747,2466,'_problem_icons_3_prob_concerned_stat','field_640fa0dd81d95'),(155748,2466,'problem_icons_3_prob_concerded_text','are highly concerned'),(155749,2466,'_problem_icons_3_prob_concerded_text','field_640fa10181d96'),(155750,2466,'problem_icons_3_prob_issue_text',''),(155751,2466,'_problem_icons_3_prob_issue_text','field_640fa11a81d97'),(155752,2466,'problem_icons_0_prob_concerned_text','House prices have doubled in a decade'),(155753,2466,'_problem_icons_0_prob_concerned_text','field_640fa10181d96'),(155754,2466,'problem_icons_1_prob_concerned_text','The gap between rich and poor is growing'),(155755,2466,'_problem_icons_1_prob_concerned_text','field_640fa10181d96'),(155756,2466,'problem_icons_2_prob_concerned_text','Construction of social housing is down'),(155757,2466,'_problem_icons_2_prob_concerned_text','field_640fa10181d96'),(155758,2466,'problem_icons_3_prob_concerned_text','Banks are making more than ever from housing'),(155759,2466,'_problem_icons_3_prob_concerned_text','field_640fa10181d96'),(155760,2466,'monitor_content','The Australian Housing Monitor is a large, nationally-representative survey covering public experiences and attitudes toward housing related issues. Questions range from how well the respondent is keeping up with their mortgage/rent, to what they think about social housing construction.\r\n\r\nA broad range of demographic criteria are included, such as gender, location, age, income, voting preference, educational level, tenure type, and employment status. These variables allow CEH researchers to understand the trends and diversity of opinion around the country.\r\n\r\nIt also incorporates questions from previous surveys to track trends over time.\r\nThe inaugural poll was conducted by Essential in December 2022, and was completed by 4,735 people.'),(155761,2466,'_monitor_content','field_640fcc4014404'),(155762,2466,'problem_head','Housing in Australia is not working, and Australians are concerned.'),(155763,2466,'_problem_head','field_641935436aded'),(155764,2466,'problem_signoff','Explore the research showing how concerned Australians are our about the housing situation.'),(155765,2466,'_problem_signoff','field_641935626adee'),(155766,2466,'sections','a:2:{i:0;s:4:\"hero\";i:1;s:9:\"news_grid\";}'),(155767,2466,'_sections','field_5dafb40b8143a'),(155768,2466,'sections_0_is_full_height','1'),(155769,2466,'_sections_0_is_full_height','field_61d6f6fd5a37e'),(155770,2466,'sections_0_image','1648'),(155771,2466,'_sections_0_image','field_61d6f6d45a37d'),(155772,2466,'sections_0_heading','Heading'),(155773,2466,'_sections_0_heading','field_61d6f69e5a379'),(155774,2466,'sections_0_subtitle','Ya ya '),(155775,2466,'_sections_0_subtitle','field_61d6f6ac5a37a'),(155776,2466,'sections_0_link_one',''),(155777,2466,'_sections_0_link_one','field_61d6f6b55a37b'),(155778,2466,'sections_0_link_two',''),(155779,2466,'_sections_0_link_two','field_61d6f6c35a37c'),(155780,2466,'sections_1_select_categories','a:1:{i:0;s:2:\"27\";}'),(155781,2466,'_sections_1_select_categories','field_637f04483b63b'),(155782,2466,'intro_head_major','Welcome to the Disability Dialogue'),(155783,2466,'_intro_head_major','field_64e828783ad9f'),(155784,2466,'intro_head_minor',''),(155785,2466,'_intro_head_minor','field_64e8288c3ada0'),(155786,2466,'intro_icons_0_int_icon','1922'),(155787,2466,'_intro_icons_0_int_icon','field_64e828b33ada2'),(155788,2466,'intro_icons_0_int_icon_text','At 1,727,000 square kilometres, we’re 2.5 times the size of Texas. <span>Yeeha!</span>'),(155789,2466,'_intro_icons