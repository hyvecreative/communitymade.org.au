2654,'second_image_cont','from 0-24 years living with disabilities and their familes'),(179047,2654,'_second_image_cont','field_5b67cb24ddf9b'),(179048,2654,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(179049,2654,'_second_image_button','field_5b67cb29ddf9c'),(179050,2654,'second_image_title','Lifestart is about supporting young children'),(179051,2654,'_second_image_title','field_5b67cb20ddf9a'),(179052,2654,'page_col_image','412'),(179053,2654,'_page_col_image','field_5de6546e7c63a'),(179054,2654,'page_col_image_3','437'),(179055,2654,'_page_col_image_3','field_5de6e3998e07e'),(179056,2654,'sec_2_title','Community'),(179057,2654,'_sec_2_title','field_5de6e3ef2798f'),(179058,2654,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(179059,2654,'_sec_2_text','field_5de78dc89e613'),(179060,2654,'sec_3_title','The Project'),(179061,2654,'_sec_3_title','field_5de6e3d37d8da'),(179062,2654,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(179063,2654,'_sec_3_text','field_5de6e4044e5e8'),(179064,2654,'page_col_image_2','436'),(179065,2654,'_page_col_image_2','field_5de6546e7c63a'),(179066,2654,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(179067,2654,'_sec_2_button','field_5de6e58c86706'),(179068,2654,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(179069,2654,'_sec_3_button','field_5de6e5a243c03'),(179070,2654,'page_col_image_4','455'),(179071,2654,'_page_col_image_4','field_5de70801090ce'),(179072,2654,'sec_4_title','Location'),(179073,2654,'_sec_4_title','field_5de7082a12a81'),(179074,2654,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(179075,2654,'_sec_4_text','field_5de7084812a82'),(179076,2654,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(179077,2654,'_sec_4_button','field_5de7085e12a83'),(179078,2654,'news_title','Project updates'),(179079,2654,'_news_title','field_5de78da3aabb9'),(179080,2654,'sec_2_text_copy',''),(179081,2654,'_sec_2_text_copy','field_5de78dc89e613'),(179082,2654,'timeline-title','Timeline'),(179083,2654,'_timeline-title','field_5de78df29e615'),(179084,2654,'timeline_title','Timeline'),(179085,2654,'_timeline_title','field_5de78df29e615'),(179086,2654,'contact_title','Contact us'),(179087,2654,'_contact_title','field_5de7981e06057'),(179088,2654,'contact_intro','Contact text...'),(179089,2654,'_contact_intro','field_5de7983506058'),(179090,2654,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(179091,2654,'_news_button','field_5de8329896e02'),(179092,2654,'timeline_intro','Introduction of timeline detail...'),(179093,2654,'_timeline_intro','field_5de98f5fb1781'),(179094,2654,'timeline_pic','477'),(179095,2654,'_timeline_pic','field_5de98f72b1782'),(179096,2654,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(179097,2654,'_timeline_button','field_5de99363677f8'),(179098,2654,'banner_image_position','center'),(179099,2654,'_banner_image_position','field_5f3bc4757dd02'),(179100,2654,'services_title','Our 