ld_6294562942237'),(187733,2704,'survey_index_6_survey_title','Energy Management'),(187734,2704,'_survey_index_6_survey_title','field_6294564042238'),(187735,2704,'survey_index_6_survey_url','#'),(187736,2704,'_survey_index_6_survey_url','field_6294564e42239'),(187737,2704,'survey_index_6_survey_url_text','View Results'),(187738,2704,'_survey_index_6_survey_url_text','field_629456584223a'),(187739,2704,'survey_index_7_survey_icon','1493'),(187740,2704,'_survey_index_7_survey_icon','field_6294562942237'),(187741,2704,'survey_index_7_survey_title','Going Off-grid'),(187742,2704,'_survey_index_7_survey_title','field_6294564042238'),(187743,2704,'survey_index_7_survey_url','#'),(187744,2704,'_survey_index_7_survey_url','field_6294564e42239'),(187745,2704,'survey_index_7_survey_url_text','View Results'),(187746,2704,'_survey_index_7_survey_url_text','field_629456584223a'),(187747,2704,'survey_index','8'),(187748,2704,'_survey_index','field_6294561242236'),(187749,2704,'report_title','Download the report'),(187750,2704,'_report_title','field_62f30edfb57e1'),(187751,2704,'report_intro','Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus massa erat, consectetur at semper at, feugiat vel orci. '),(187752,2704,'_report_intro','field_62f30eedb57e2'),(187753,2704,'report_link_url','#'),(187754,2704,'_report_link_url','field_62f30ef4b57e3'),(187755,2704,'report_link_text','Download'),(187756,2704,'_report_link_text','field_62f30f01b57e4'),(187757,2704,'solutions_content','The housing system is complex, and no one solution will solve the complex problems we now face but there are some critical first steps to be taken now.\r\n<ul>\r\n 	<li>Set out an ambitious national housing agreement between commonwealth and state governments with targets and funding for the construction of affordable homes.</li>\r\n 	<li>Phase out tax breaks for property investors and using the increase in revenue to build more public housing.</li>\r\n 	<li>Establish laws which limit rental increases beyond what is fair.</li>\r\n 	<li>Rebalance tenancy laws to provide renters with more security and control, such as eliminating no grounds evictions.</li>\r\n 	<li>Phase out stamp duty and replace it with a broad-based land tax.</li>\r\n</ul>\r\n<h4>While there are many opinions on what policy changes will fix the housing market, doing nothing is not an option.</h4>'),(187758,2704,'_solutions_content','field_640e8b307a958'),(187759,2704,'problem_icons_0_prob_icon','1699'),(187760,2704,'_problem_icons_0_prob_icon','field_640fa0291d519'),(187761,2704,'problem_icons_0_prob_concerned_stat','70% highly concerned'),(187762,2704,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(187763,2704,'problem_icons_0_prob_concerded_text','are highly concerned'),(187764,2704,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(187765,2704,'problem_icons_0_prob_issue_text',''),(187766,2704,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(187767,2704,'problem_icons','4'),(187768,2704,'_problem_icons','field_640fa0191d518'),(187769,2704,'ceh_content_left',''),(187770,2704,'_ceh_content_left','field_640e97e8f1c8c'),(187771,2704,'ceh_content_right',''),(187772,2704,'_ceh_content_right','field_640e97fdf1c8d'),(187773,2704,'pc_content_left',''),(187774,2704,'_pc_content_left','field_640e983bf1c8f'),(187775,2704,'pc_content_right',''),(187776,2704,'_pc_content_right','field_640e984df1c90'),(187777,2704,'problem_icons_1_prob_icon','1699'),(187778,2704,'_problem_icons_1_prob_icon','field_640fa0291d519'),(187779,2704,'problem_icons_1_prob_concerned_stat','69% highly concerned'),(187780,2704,'_problem_icons_1_prob_concerned_stat','field_640fa0dd81d95'),(187781,2704,'problem_icons_1_prob_concerded_text','are highly concerned'),(187782,2704,'_problem_icons_1_prob_concerded_text','field_640fa10181d96'),(187783,2704,'problem_icons_1_prob_issue_text',''),(187784,2704,'_problem_icons_1_prob_issue_text','field_640fa11a81d97'),(187785,2704,'problem_icons_2_prob_icon','1699'),(187786,2704,'_problem_icons_2_prob_icon','field_640fa0291d519'),(187787,2704,'problem_icons_2_prob_concerned_stat','64% highly concerned'),(187788,2704,'_problem_icons_2_prob_concerned_stat','field_640fa0dd81d95'),(187789,2704,'problem_icons_2_prob_concerded_text','are highly concerned'),(187790,2704,'_problem_icons_2_prob_concerded_text','field_640fa10181d96'),(187791,2704,'problem_icons_2_prob_issue_text',''),(187792,2704,'_problem_icons_2_prob_issue_text','field_640fa11a81d97'),(187793,2704,'problem_icons_3_prob_icon','1699'),(187794,2704,'_problem_icons_3_prob_icon','field_640fa0291d519'),(187795,2704,'problem_icons_3_prob_concerned_stat','64% highly concerned'),(187796,2704,'_problem_icons_3_prob_concerned_stat','field_640fa0dd81d95'),(187797,2704,'problem_icons_3_prob_concerded_text','are highly concerned'),(187798,2704,'_problem_icons_3_prob_concerded_text','field_640fa10181d96'),(187799,2704,'problem_icons_3_prob_issue_text',''),(187800,2704,'_problem_icons_3_prob_issue_text','field_640fa11a81d97'),(187801,2704,'problem_icons_0_prob_concerned_text','House prices have doubled in a decade'),(187802,2704,'_problem_icons_0_prob_concerned_text','field_640fa10181d96'),(187803,2704,'problem_icons_1_prob_concerned_text','The gap between rich and poor is growing'),(187804,2704,'_problem_icons_1_prob_concerned_text','field_640fa10181d96'),(187805,2704,'problem_icons_2_prob_concerned_text','Construction of social housing is down'),(187806,2704,'_problem_icons_2_prob_concerned_text','field_640fa10181d96'),(187807,2704,'problem_icons_3_prob_concerned_text','Banks are making more than ever from housing'),(187808,2704,'_problem_icons_3_prob_concerned_text','field_640fa10181d96'),(187809,2704,'monitor_content','The Australian Housing Monitor is a large, nationally-representative survey covering public experiences and attitudes toward housing related issues. Questions range from how well the respondent is keeping up with their mortgage/rent, to what they think about social housing construction.\r\n\r\nA broad range of demographic criteria are included, such as gender, location, age, income, voting preference, educational level, tenure type, and employment status. These variables allow CEH researchers to understand the trends and diversity of opinion around the country.\r\n\r\nIt also incorporates questions from previous surveys to track trends over time.\r\nThe inaugural poll was conducted by Essential in December 2022, and was completed by 4,735 people.'),(187810,2704,'_monitor_content','field_640fcc4014404'),(187811,2704,'problem_head','Housing in Australia is not working, and Australians are concerned.'),(187812,2704,'_problem_head','field_641935436aded'),(187813,2704,'problem_signoff','Explore the research showing how concerned Australians are our about the housing situation.'),(187814,2704,'_problem_signoff','field_641935626adee'),(187815,2704,'sections','a:2:{i:0;s:4:\"hero\";i:1;s:9:\"news_grid\";}'),(187816,2704,'_sections','field_5dafb40b8143a'),(187817,2704,'sections_0_is_full_height','1'),(187818,2704,'_sections_0_is_full_height','field_61d6f6fd5a37e'),(187819,2704,'sections_0_image','1648'),(187820,2704,'_sections_0_image','field_61d6f6d45a37d'),(187821,2704,'sections_0_heading','Heading'),(187822,2704,'_sections_0_heading','field_61d6f69e5a379'),(187823,2704,'sections_0_subtitle','Ya ya '),(187824,2704,'_sections_0_subtitle','field_61d6f6ac5a37a'),(187825,2704,'sections_0_link_one',''),(187826,2704,'_sections_0_link_one','field_61d6f6b55a37b'),(187827,2704,'sections_0_link_two',''),(187828,2704,'_sections_0_link_two','field_61d6f6c35a37c'),(187829,2704,'sections_1_select_categories','a:1:{i:0;s:2:\"27\";}'),(187830,2704,'_sections_1_select_categories','field_637f04483b63b'),(187831,2704,'intro_head_major','Welcome to the Disability Dialogue'),(187832,2704,'_intro_head_major','field_64e828783ad9f'),(187833,2704,'intro_head_minor',''),(187834,2704,'_intro_head_minor','field_64e8288c3ada0'),(187835,2704,'intro_ic