d_image_cont','from 0-24 years living with disabilities and their familes'),(38710,1526,'_second_image_cont','field_5b67cb24ddf9b'),(38711,1526,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(38712,1526,'_second_image_button','field_5b67cb29ddf9c'),(38713,1526,'second_image_title','Lifestart is about supporting young children'),(38714,1526,'_second_image_title','field_5b67cb20ddf9a'),(38715,1526,'page_col_image','412'),(38716,1526,'_page_col_image','field_5de6546e7c63a'),(38717,1526,'page_col_image_3','437'),(38718,1526,'_page_col_image_3','field_5de6e3998e07e'),(38719,1526,'sec_2_title','Community'),(38720,1526,'_sec_2_title','field_5de6e3ef2798f'),(38721,1526,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(38722,1526,'_sec_2_text','field_5de78dc89e613'),(38723,1526,'sec_3_title','The Project'),(38724,1526,'_sec_3_title','field_5de6e3d37d8da'),(38725,1526,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(38726,1526,'_sec_3_text','field_5de6e4044e5e8'),(38727,1526,'page_col_image_2','436'),(38728,1526,'_page_col_image_2','field_5de6546e7c63a'),(38729,1526,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(38730,1526,'_sec_2_button','field_5de6e58c86706'),(38731,1526,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(38732,1526,'_sec_3_button','field_5de6e5a243c03'),(38733,1526,'page_col_image_4','455'),(38734,1526,'_page_col_image_4','field_5de70801090ce'),(38735,1526,'sec_4_title','Location'),(38736,1526,'_sec_4_title','field_5de7082a12a81'),(38737,1526,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(38738,1526,'_sec_4_text','field_5de7084812a82'),(38739,1526,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(38740,1526,'_sec_4_button','field_5de7085e12a83'),(38741,1526,'news_title','Project updates'),(38742,1526,'_news_title','field_5de78da3aabb9'),(38743,1526,'sec_2_text_copy',''),(38744,1526,'_sec_2_text_copy','field_5de78dc89e613'),(38745,1526,'timeline-title','Timeline'),(38746,1526,'_timeline-title','field_5de78df29e615'),(38747,1526,'timeline_title','Timeline'),(38748,1526,'_timeline_title','field_5de78df29e615'),(38749,1526,'contact_title','Contact us'),(38750,1526,'_contact_title','field_5de7981e06057'),(38751,1526,'contact_intro','Contact text...'),(38752,1526,'_contact_intro','field_5de7983506058'),(38753,1526,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(38754,1526,'_news_button','field_5de8329896e02'),(38755,1526,'timeline_intro','Introduction of timeline detail...'),(38756,1526,'_timeline_intro','field_5de98f5fb1781'),(38757,1526,'timeline_pic','477'),(38758,1526,'_timeline_pic','field_5de98f72b1782'),(38759,1526,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(38760,1526,'_timeline_button','field_5de99363677f8'),(38761,1526,'banner_image_position','center'),(38762,1526,'_banner_image_position','field_5f3bc4757dd02'),(38763,1526,'services_title','Our services'),(38764,1526,'_services_title','field_5f20f3cd80eb2'),(