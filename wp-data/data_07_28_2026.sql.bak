4,2174,'survey_index_6_survey_url','#'),(124505,2174,'_survey_index_6_survey_url','field_6294564e42239'),(124506,2174,'survey_index_6_survey_url_text','View Results'),(124507,2174,'_survey_index_6_survey_url_text','field_629456584223a'),(124508,2174,'survey_index_7_survey_icon','1493'),(124509,2174,'_survey_index_7_survey_icon','field_6294562942237'),(124510,2174,'survey_index_7_survey_title','Going Off-grid'),(124511,2174,'_survey_index_7_survey_title','field_6294564042238'),(124512,2174,'survey_index_7_survey_url','#'),(124513,2174,'_survey_index_7_survey_url','field_6294564e42239'),(124514,2174,'survey_index_7_survey_url_text','View Results'),(124515,2174,'_survey_index_7_survey_url_text','field_629456584223a'),(124516,2174,'survey_index','8'),(124517,2174,'_survey_index','field_6294561242236'),(124518,2174,'report_title','Download the report'),(124519,2174,'_report_title','field_62f30edfb57e1'),(124520,2174,'report_intro','Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus massa erat, consectetur at semper at, feugiat vel orci. '),(124521,2174,'_report_intro','field_62f30eedb57e2'),(124522,2174,'report_link_url','#'),(124523,2174,'_report_link_url','field_62f30ef4b57e3'),(124524,2174,'report_link_text','Download'),(124525,2174,'_report_link_text','field_62f30f01b57e4'),(124526,2174,'solutions_content','The housing system is complex, and no one solution will solve the complex problems we now face but there are some critical first steps to be taken now.\r\n<ul>\r\n 	<li>Set out an ambitious national housing agreement between commonwealth and state governments with targets and funding for the construction of affordable homes.</li>\r\n 	<li>Phase out tax breaks for property investors and using the increase in revenue to build more public housing.</li>\r\n 	<li>Establish laws which limit rental increases beyond what is fair.</li>\r\n 	<li>Rebalance tenancy laws to provide renters with more security and control, such as eliminating no grounds evictions.</li>\r\n 	<li>Phase out stamp duty and replace it with a broad-based land tax.</li>\r\n</ul>\r\n<h4>While there are many opinions on what policy changes will fix the housing market, doing nothing is not an option.</h4>'),(124527,2174,'_solutions_content','field_640e8b307a958'),(124528,2174,'problem_icons_0_prob_icon','1699'),(124529,2174,'_problem_icons_0_prob_icon','field_640fa0291d519'),(124530,2174,'problem_icons_0_prob_concerned_stat','70% highly concerned'),(124531,2174,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(124532,2174,'problem_icons_0_prob_concerded_text','are highly concerned'),(124533,2174,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(124534,2174,'problem_icons_0_prob_issue_text',''),(124535,2174,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(124536,2174,'problem_icons','4'),(124537,2174,'_problem_icons','field_640fa0191d518'),(124538,2174,'ceh_content_left',''),(124539,2174,'_ceh_content_left','field_640e97e8f1c8c'),(124540,2174,'ceh_content_right',''),(124541,2174,'_ceh_content_right','field_640e97fdf1c8d'),(124542,2174,'pc_content_left',''),(124543,2174,'_pc_content_left','field_640e983bf1c8f'),(124544,2174,'pc_content_right',''),(124545,2174,'_pc_content_right','field_640e984df1c90'),(124546,2174,'problem_icons_1_prob_icon','1699'),(124547,2174,'_problem_icons_1_prob_icon','field_640fa0291d519'),(124548,2174,'problem_icons_1_prob_concerned_stat','69% highly concerned'),(124549,2174,'_problem_icons_1_prob_concerned_stat','field_640fa0dd81d95'),(124550,2174,'problem_icons_1_prob_concerded_text','are highly concerned'),(124551,2174,'_problem_icons_1_prob_concerded_text','field_640fa10181d96'),(124552,2174,'problem_icons_1_prob_issue_text',''),(124553,2174,'_problem_icons_1_prob_issue_text','field_640fa11a81d97'),(124554,2174,'problem_icons_2_prob_icon','1699'),(124555,2174,'_problem_icons_2_prob_icon','field_640fa0291d519'),(124556,2174,'problem_icons_2_prob_concerned_stat','64% highly concerned'),(124557,2174,'_problem_icons_2_prob_concerned_stat','field_640fa0dd81d95'),(124558,2174,'problem_icons_2_prob_concerded_text','are highly concerned'),(124559,2174,'_problem_icons_2_prob_concerded_text','field_640fa10181d96'),(124560,2174,'problem_icons_2_prob_issue_text',''),(124561,2174,'_problem_icons_2_prob_issue_text','field_640fa11a81d97'),(124562,2174,'problem_icons_3_prob_icon','1699'),(124563,2174,'_problem_icons_3_prob_icon','field_640fa0291d519'),(124564,2174,'problem_icons_3_prob_concerned_stat','64% highly concerned'),(124565,2174,'_problem_icons_3_prob_concerned_stat','field_640fa0dd81d95'),(124566,2174,'problem_icons_3_prob_concerded_text','are highly concerned'),(124567,2174,'_problem_icons_3_prob_concerded_text','field_640fa10181d96'),(124568,2174,'problem_icons_3_prob_issue_text',''),(124569,2174,'_problem_icons_3_prob_issue_text','field_640fa11a81d97'),(124570,2174,'problem_icons_0_prob_concerned_text','House prices have doubled in a decade'),(124571,2174,'_problem_icons_0_prob_concerned_text','field_640fa10181d96'),(124572,2174,'problem_icons_1_prob_concerned_text','The gap between rich and poor is growing'),(124573,2174,'_problem_icons_1_prob_concerned_text','field_640fa10181d96'),(124574,2174,'problem_icons_2_prob_concerned_text','Construction of social housing is down'),(124575,2174,'_problem_icons_2_prob_concerned_text','field_640fa10181d96'),(124576,2174,'problem_icons_3_prob_concerned_text','Banks are making more than ever from housing'),(124577,2174,'_problem_icons_3_prob_concerned_text','field_640fa10181d96'),(124578,2174,'monitor_content','The Australian Housing Monitor is a large, nationally-representative survey covering public experiences and attitudes toward housing related issues. Questions range from how well the respondent is keeping up with their mortgage/rent, to what they think about social housing construction.\r\n\r\nA broad range of demographic criteria are included, such as gender, location, age, income, voting preference, educational level, tenure type, and employment status. These variables allow CEH researchers to understand the trends and diversity of opinion around the country.\r\n\r\nIt also incorporates questions from previous surveys to track trends over time.\r\nThe inaugural poll was conducted by Essential in December 2022, and was completed by 4,735 people.'),(124579,2174,'_monitor_content','field_640fcc4014404'),(124580,2174,'problem_head','Housing in Australia is not working, and Australians are concerned.'),(124581,2174,'_problem_head','field_641935436aded'),(124582,2174,'problem_signoff','Explore the research showing how concerned Australians are our about the housing situation.'),(124583,2174,'_problem_signoff','field_641935626adee'),(124584,2174,'sections','a:2:{i:0;s:4:\"hero\";i:1;s:9:\"news_grid\";}'),(124585,2174,'_sections','field_5dafb40b8143a'),(124586,2174,'sections_0_is_full_height','1'),(124587,2174,'_sections_0_is_full_height','field_61d6f6fd5a37e'),(124588,2174,'sections_0_image','1648'),(124589,2174,'_sections_0_image','field_61d6f6d45a37d'),(124590,2174,'sections_0_heading','Heading'),(124591,2174,'_sections_0_heading','field_61d6f69e5a379'),(124592,2174,'sections_0_subtitle','Ya ya '),(124593,2174,'_sections_0_subtitle','field_61d6f6ac5a37a'),(124594,2174,'sections_0_link_one',''),(124595,2174,'_sections_0_link_one','field_61d6f6b55a37b'),(124596,2174,'sections_0_link_two',''),(124597,2174,'_sections_0_link_two','field_61d6f6c35a37c'),(124598,2174,'sections_1_select_categories','a:1:{i:0;s:2:\"27\";}'),(124599,2174,'_sections_1_select_categories','field_637f04483b63b'),(124600,2174,'intro_head_major','Welcome to the Disability Dialogue'),(124601,2174,'_intro_head_major','field_64e828783ad9f'),(124602,2174,'intro_head_minor',''),(124603,2174,'_intro_head_minor','field_64e8288c3ada0'),(124604,2174,'intro_icons_0_int_icon','1922'),(124605,2174,'_intro_icons_0_int_icon','field_64e828b33ada2'),(124606,2174,'intro_icons_0_int_icon_text','At 1,727,000 square kilometres, we’re 2.5 times the size of Texas. <span>Yeeha!</span>'),(124607,2174,'_intro_icons_0_int_icon_text','field_64e828e33ada3'),(124608,2174,'intro_icons_1_int_icon','1920'),(124609,2174,'_intro_icons_1_int_icon','field_64e828b33ada2'),(124610,2174,'intro_icons_1_int_icon_text','We have twice as many species of native plant and animal as any other Australian state or territory.'),(124611,2174,'_intro_icons_1_int_icon_text','field_64e828e33ada3'),(124612,2174,'intro_icons_2_int_icon','1921'),(124613,2174,'_intro_icons_2_int_icon','field_64e828b33ada2'),(124614,2174,'intro_icons_2_int_icon_text','We have less land classified as ‘protected’ than any other state or territory.'),(124615,2174,'_intro_icons_2_int_icon_text','field_64e828e33ada3'),(124616,2174,'intro_icons','3'),(124617,2174,'_intro_icons','field_64e828963ada1'),(124618,2174,'threat_head_major','What we stand to lose if we don’t act soon to protect beautiful Queensland:'),(124619,2174,'_threat_head_major','field_64ec258d9dbd1'),(124620,2174,'threats_icons','3'),(124621,2174,'_threats_icons','field_64ec2551a93f9'),(124622,2174,'threats_icons_0_thr_icon','1819'),(124623,2174,'_threats_icons_0_thr_icon','field_64ec2551a93fa'),(124624,2174,'threats_icons_0_thr_icon_text','The rich cultural heritage of our First Nations people and their continuous ties to country, dating back more than 50,000 years.'),(124625,2174,'_threats_icons_0_thr_icon_text','field_64ec2551a93fb'),(124626,2174,'threats_icons_1_thr_icon','1819'),(124627,2174,'_threats_icons_1_thr_icon','field_64ec2551a93fa'),(124628,2174,'threats_icons_1_thr_icon_text','Thousands of species of plant and animal which are now classified as threatened or endangered in Queensland.'),(124629,2174,'_threats_icons_1_thr_icon_text','field_64ec2551a93fb'),(124630,2174,'threats_icons_2_thr_icon','1819'),(124631,2174,'_threats_icons_2_thr_icon','field_64ec2551a93fa'),(124632,2174,'threats_icons_2_thr_icon_text','The access to nature that is central to the Queensland 