','field_6a3b07d706af2'),(210665,2782,'issues_items_0_issues_item_txt','•	A shortage of 132,000 social and affordable rental homes\r\n•	70,000+ households waiting for social housing\r\n•	Record-high private market rents\r\n•	Home ownership increasingly out of reach for generations'),(210666,2782,'_issues_items_0_issues_item_txt','field_6a3b07fc06af3'),(210667,2782,'issues_items_0_issues_link_text',''),(210668,2782,'_issues_items_0_issues_link_text','field_6a3b080f06af4'),(210669,2782,'issues_items_0_issues_target_url',''),(210670,2782,'_issues_items_0_issues_target_url','field_6a3b082b06af5'),(210671,2782,'issues_items','2'),(210672,2782,'_issues_items','field_6a3b078206af0'),(210673,2782,'issues_items_1_issue_icon','2708'),(210674,2782,'_issues_items_1_issue_icon','field_6a3b07b506af1'),(210675,2782,'issues_items_1_issues_item_hd','The solutions we need '),(210676,2782,'_issues_items_1_issues_item_hd','field_6a3b07d706af2'),(210677,2782,'issues_items_1_issues_item_txt','Community housing works. We’re calling on the next NSW Government for three actions: long-term investment for new community housing, more funding to future-proof existing homes, and support to help people stayed housed.'),(210678,2782,'_issues_items_1_issues_item_txt','field_6a3b07fc06af3'),(210679,2782,'issues_items_1_issues_link_text',''),(210680,2782,'_issues_items_1_issues_link_text','field_6a3b080f06af4'),(210681,2782,'issues_items_1_issues_target_url',''),(210682,2782,'_issues_items_1_issues_target_url','field_6a3b082b06af5'),(210683,2782,'issues_items_0_issues_sub_head',''),(210684,2782,'_issues_items_0_issues_sub_head','field_6a3b0aa79365e'),(210685,2782,'issues_items_1_issues_sub_head',''),(210686,2782,'_issues_items_1_issues_sub_head','field_6a3b0aa79365e'),(210687,2782,'video_head','The people next door'),(210688,2782,'_video_head','field_6a5ff269ef234'),(210689,2782,'_oembed_0f581e4b1352d4b70914e448822e2a2a','<iframe title=\"Activate Australia&amp;apos;s Skills\" width=\"500\" height=\"281\" src=\"https://www.youtube.com/embed/pE5IoC1H-KM?feature=oembed\" frameborder=\"0\" allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share\" referrerpolicy=\"strict-origin-when-cross-origin\" allowfullscreen></iframe>'),(210690,2782,'_oembed_time_0f581e4b1352d4b70914e448822e2a2a','1784784036'),(210691,2782,'video_intro','Nurses. Childcare workers. Single parents. Older Australians who want to stay near the people they love. Community housing is the solution.'),(210692,2782,'_video_intro','field_6a606161b34b6'),(210693,2782,'hm_hero_title_sm','because we all deserve a safe, secure and affordable home'),(210694,2782,'_hm_hero_title_sm','field_6a607121b523f'),(210695,2783,'footnotes',''),(210696,2782,'solutions_head','The solutions we need this election'),(210697,2782,'_solutions_head','field_6a61a1aaac606'),(210698,2782,'solutions_items','3'),(210699,2782,'_solutions_items','field_6a61a1aeac607'),(210700,2783,'banner_head',''),(210701,2783,'_banner_head','field_5b568121a8ffe'),(210702,2783,'banner_sub',''),(210703,2783,'_banner_sub','field_5b568139fd366'),(210704,2783,'banner_button','<a class=\"btn btn-home\" style=\"width: 200px;\" href=\"#project\">Sign the petition</a>'),(210705,2783,'_banner_button','field_5b568147fd367'),(210706,2783,'support_section_title','How can Lifestart support you?'),(210707,2783,'_support_section_title','field_5b67c7d060398'),(210708,2783,'support_left_title','Services'),(210709,2783,'_support_left_title','field_5b67c298e7f8f'),(210710,2783,'support_left_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy.'),(210711,2783,'_support_left_cont','field_5b67c5f6e7f91'),(210712,2783,'support_left_button','<a class=\"btn btn-green\" href=\"/services/\">View all services</a>'),(210713,2783,'_support_left_button','field_5b67c60ae7f92'),(210714,2783,'support_ctr_title','Talk to us'),(210715,2783,'_support_ctr_title','field_5b67c62a58af3'),(210716,2783,'support_ctr_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut laoreet.'),(210717,2783,'_support_ctr_cont','field_5b67c63158af4'),(210718,2783,'support_ctr_button','<a class=\"btn btn-orange\" href=\"/supports/\">Find us</a>'),(210719,2783,'_support_ctr_button','field_5b67c63658af5'),(210720,2783,'support_right_title','NDIS Registered provider'),(210721,2783,'_support_right_title','field_5b67c6a38c064'),(210722,2783,'support_right_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut.'),(210723,2783,'_support_right_cont','field_5b67c6c98c065'),(210724,2783,'support_right_button','<a class=\"btn btn-blue\" href=\"#\">Read more</a>'),(210725,2783,'_support_right_button','field_5b67c6dd8c066'),(210726,2783,'first_image_title','Lifestart is about supporting young children'),(210727,2783,'_first_image_title','field_5b67ca606afc4'),(210728,2783,'first_image_cont','from 0-24 years living with disabilities and their familes'),(210729,2783,'_first_image_cont','field_5b67caff6afc5'),(210730,2783,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(210731,2783,'_first_image_button','field_5b67cb0d6afc6'),(210732,2783,'second _image_title','Lifestart is about supporting young children'),(210733,2783,'_second _image_title','field_5b67cb20ddf9a'),(210734,2783,'second_image_cont','from 0-24 years living with disabilities and their familes'),(210735,2783,'_second_image_cont','field_5b67cb24ddf9b'),(210736,2783,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(210737,2783,'_second_image_button','field_5b67cb29ddf9c'),(210738,2783,'second_image_title','Lifestart is about supporting young children'),(210739,2783,'_second_image_title','field_5b67cb20ddf9a'),(210740,2783,'page_col_image','412'),(210741,2783,'_page_col_image','field_5de6546e7c63a'),(210742,2783,'page_col_image_3','437'),(210743,2783,'_page_col_image_3','field_5de6e3998e07e'),(210744,2783,'sec_2_title','Community'),(210745,2783,'_sec_2_title','field_5de6e3ef2798f'),(210746,2783,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(210747,2783,'_sec_2_text','field_5de78dc89e613'),(210748,2783,'sec_3_title','The Project'),(210749,2783,'_sec_3_title','field_5de6e3d37d8da'),(210750,2783,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(210751,2783,'_sec_3_text','field_5de6e4044e5e8'),(210752,2783,'page_col_image_2','436'),(210753,2783,'_page_col_image_2','field_5de6546e7c63a'),(210754,2783,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(210755,2783,'_sec_2_button','field_5de6e58c86706'),(210756,2783,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(210757,2783,'_sec_3_button','field_5de6e5a243c03'),(210758,2783,'page_col_image_4','455'),(210759,2783,'_page_col_image_4','field_5de70801090ce'),(210760,2783,'sec_4_title','Location'),(210761,2783,'_sec_4_title','field_5de7082a12a81'),(210762,2783,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(210763,2783,'_sec_4_text','field_5de7084812a82'),(210764,2783,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(210765,2783,'_sec_4_button','field_5de7085e12a83'),(210766,2783,'news_title','Project updates'),(210767,2783,'_news_title','field_5de78da3aabb9'),(210768,2783,'sec_2_text_copy',''),(210769,2783,'_sec_2_text_copy','field_5de78dc89e613'),(210770,2783,'timeline-title','Timeline'),(210771,2783,'_timeline-title','field_5de78df29e615'),(210772,2783,'timeline_title','Timeline'),(210773,2783,'_timeline_title','field_5de78df29e615'),(210774,2783,'contact_title','Contact us'),(210775,2783,'_contact_title','field_5de7981e06057'),(210776,2783,'contact_intro','Contact text...'),(210777,2783,'_contact_intro','field_5de7983506058'),(210778,2783,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(210779,2783,'_news_button','field_5de8329896e02'),(210780,2783,'timeline_intro','Introduction of timeline detail...'),(210781,2783,'_timeline_intro','field_5de98f5fb1781'),(210782,2783,'timeline_pic','477'),(210783,2783,'_timeline_pic','field_5de98f72b1782'),(210784,2783,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(210785,2783,'_timeline_button','field_5de99363677f8'),(210786,2783,'banner_image_position','center'),(210787,2783,'_banner_image_position','field_5f3bc4757dd02'),(210788,2783,'services_title','Our services'),(210789,2783,'_services_title','field_5f20f3cd80eb2'),(210790,2783,'services_items_0_services_item_image','1061'),(210791,2783,'_services_items_0_services_item_image','field_5f2121355be14'),(210792,2783,'services_items_0_sservices_item_title','1300 Telephone counselling line'),(210793,2783,'_services_items_0_sservices_item_title','field_605089efca82e'),(210794,2783,'services_items_0_services_item_text',''),(210795,2783,'_services_items_0_services_item_text','field_5f2121535be15'),(210796,2783,'services_items_0_services_link_url','#'),(210797,2783,'_services_items_0_services_link_url','field_6050866041225