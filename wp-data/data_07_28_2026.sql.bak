'_page_col_image','field_5de6546e7c63a'),(126336,2202,'page_col_image_3','437'),(126337,2202,'_page_col_image_3','field_5de6e3998e07e'),(126338,2202,'sec_2_title','Community'),(126339,2202,'_sec_2_title','field_5de6e3ef2798f'),(126340,2202,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(126341,2202,'_sec_2_text','field_5de78dc89e613'),(126342,2202,'sec_3_title','The Project'),(126343,2202,'_sec_3_title','field_5de6e3d37d8da'),(126344,2202,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(126345,2202,'_sec_3_text','field_5de6e4044e5e8'),(126346,2202,'page_col_image_2','436'),(126347,2202,'_page_col_image_2','field_5de6546e7c63a'),(126348,2202,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(126349,2202,'_sec_2_button','field_5de6e58c86706'),(126350,2202,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(126351,2202,'_sec_3_button','field_5de6e5a243c03'),(126352,2202,'page_col_image_4','455'),(126353,2202,'_page_col_image_4','field_5de70801090ce'),(126354,2202,'sec_4_title','Location'),(126355,2202,'_sec_4_title','field_5de7082a12a81'),(126356,2202,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(126357,2202,'_sec_4_text','field_5de7084812a82'),(126358,2202,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(126359,2202,'_sec_4_button','field_5de7085e12a83'),(126360,2202,'news_title','Project updates'),(126361,2202,'_news_title','field_5de78da3aabb9'),(126362,2202,'sec_2_text_copy',''),(126363,2202,'_sec_2_text_copy','field_5de78dc89e613'),(126364,2202,'timeline-title','Timeline'),(126365,2202,'_timeline-title','field_5de78df29e615'),(126366,2202,'timeline_title','Timeline'),(126367,2202,'_timeline_title','field_5de78df29e615'),(126368,2202,'contact_title','Contact us'),(126369,2202,'_contact_title','field_5de7981e06057'),(126370,2202,'contact_intro','Contact text...'),(126371,2202,'_contact_intro','field_5de7983506058'),(126372,2202,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(126373,2202,'_news_button','field_5de8329896e02'),(126374,2202,'timeline_intro','Introduction of timeline detail...'),(126375,2202,'_timeline_intro','field_5de98f5fb1781'),(126376,2202,'timeline_pic','477'),(126377,2202,'_timeline_pic','field_5de98f72b1782'),(126378,2202,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(126379,2202,'_timeline_button','field_5de99363677f8'),(126380,2202,'banner_image_position','center'),(126381,2202,'_banner_image_position','field_5f3bc4757dd02'),(126382,2202,'services_title','Our services'),(126383,2202,'_services_title','field_5f20f3cd80eb2'),(126384,2202,'services_items_0_services_item_image','1061'),(126385,2202,'_services_items_0_services_item_image','field_5f2121355be14'),(126386,2202,'services_items_0_sservices_item_title','1300 Telephone counselling line'),(126387,2202,'_services_items_0_sservices_item_title','field_605089efca82e'),(126388,2202,'services_items_0_services_item_text',''),(126389,2202,'_services_items_0_services_item_text','field_5f2121535