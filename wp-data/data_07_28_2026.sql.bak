ield_629456584223a'),(186931,2702,'survey_index_6_survey_icon','1492'),(186932,2702,'_survey_index_6_survey_icon','field_6294562942237'),(186933,2702,'survey_index_6_survey_title','Energy Management'),(186934,2702,'_survey_index_6_survey_title','field_6294564042238'),(186935,2702,'survey_index_6_survey_url','#'),(186936,2702,'_survey_index_6_survey_url','field_6294564e42239'),(186937,2702,'survey_index_6_survey_url_text','View Results'),(186938,2702,'_survey_index_6_survey_url_text','field_629456584223a'),(186939,2702,'survey_index_7_survey_icon','1493'),(186940,2702,'_survey_index_7_survey_icon','field_6294562942237'),(186941,2702,'survey_index_7_survey_title','Going Off-grid'),(186942,2702,'_survey_index_7_survey_title','field_6294564042238'),(186943,2702,'survey_index_7_survey_url','#'),(186944,2702,'_survey_index_7_survey_url','field_6294564e42239'),(186945,2702,'survey_index_7_survey_url_text','View Results'),(186946,2702,'_survey_index_7_survey_url_text','field_629456584223a'),(186947,2702,'survey_index','8'),(186948,2702,'_survey_index','field_6294561242236'),(186949,2702,'report_title','Download the report'),(186950,2702,'_report_title','field_62f30edfb57e1'),(186951,2702,'report_intro','Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus massa erat, consectetur at semper at, feugiat vel orci. '),(186952,2702,'_report_intro','field_62f30eedb57e2'),(186953,2702,'report_link_url','#'),(186954,2702,'_report_link_url','field_62f30ef4b57e3'),(186955,2702,'report_link_text','Download'),(186956,2702,'_report_link_text','field_62f30f01b57e4'),(186957,2702,'solutions_content','The housing system is complex, and no one solution will solve the complex problems we now face but there are some critical first steps to be taken now.\r\n<ul>\r\n 	<li>Set out an ambitious national housing agreement between commonwealth and state governments with targets and funding for the construction of affordable homes.</li>\r\n 	<li>Phase out tax breaks for property investors and using the increase in revenue to build more public housing.</li>\r\n 	<li>Establish laws which limit rental increases beyond what is fair.</li>\r\n 	<li>Rebalance tenancy laws to provide renters with more security and control, such as eliminating no grounds evictions.</li>\r\n 	<li>Phase out stamp duty and replace it with a broad-based land tax.</li>\r\n</ul>\r\n<h4>While there are many opinions on what policy changes will fix the housing market, doing nothing is not an option.</h4>'),(186958,2702,'_solutions_content','field_640e8b307a958'),(186959,2702,'problem_icons_0_prob_icon','1699'),(186960,2702,'_problem_icons_0_prob_icon','field_640fa0291d519'),(186961,2702,'problem_icons_0_prob_concerned_stat','70% highly concerned'),(186962,2702,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(186963,2702,'problem_icons_0_prob_concerded_text','are highly concerned'),(186964,2702,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(186965,2702,'problem_icons_0_prob_issue_text',''),(186966,2702,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(186967,2702,'problem_icons','4'),(186968,2702,'_problem_icons','field_640fa0191d518'),(186969,2702,'ceh_content_left',''),(186970,2702,'_ceh_content_left','field_640e97e8f1c8c'),(186971,2702,'ceh_content_right',''),(186972,2702,'_ceh_content_right','field_640e97fdf1c8d'),(186973,2702,'pc_content_left',''),(186974,2702,'_pc_content_left','field_640e983bf1c8f'),(186975,2702,'pc_content_right',''),(186976,2702,'_pc_content_right','field_640e984df1c90'),(186977,2702,'problem_icons_1_prob_icon','1699'),(186978,2702,'_problem_icons_1_prob_icon','field_640fa0291d519'),(186979,2702,'problem_icons_1_prob_concerned_stat','69% highly concerned'),(186980,2702,'_problem_icons_1_prob_concerned_stat','field_640fa0dd81d95'),(186981,2702,'problem_icons_1_prob_concerded_text','are highly concerned'),(186982,2702,'_problem_icons_1_prob_concerded_text','field_640fa10181d96'),(186983,2702,'problem_icons_1_prob_issue_text',''),(186984,2702,'_problem_icons_1_prob_issue_text','field_640fa11a81d97'),(186985,2702,'problem_icons_2_prob_icon','1699'),(186986,2702,'_problem_icons_2_prob_icon','field_640fa0291d519'),(186987,2702,'problem_icons_2_prob_concerned_stat','64% highly concerned'),(186988,2702,'_problem_icons_2_prob_concerned_stat','field_640fa0dd81d95'),(186989,2702,'problem_icons_2_prob_concerded_text','are highly concerned'),(186990,2702,'_problem_icons_2_prob_concerded_text','field_640fa10181d96'),(186991,2702,'problem_icons_2_prob_issue_text',''),(186992,2702,'_problem_icons_2_prob_issue_text','field_640fa11a81d97'),(186993,2702,'problem_icons_3_prob_icon','1699'),(186994,2702,'_problem_icons_3_prob_icon','field_640fa0291d519'),(186995,2702,'problem_icons_3_prob_concerned_stat','64% highly concerned'),(186996,2702,'_problem_icons_3_prob_concerned_stat','field_640fa0dd81d95'),(186997,2702,'problem_icons_3_prob_concerded_text','are highly concerned'),(186998,2702,'_problem_icons_3_prob_concerded_text','field_640fa10181d96'),(186999,2702,'problem_icons_3_prob_issue_text',''),(187000,2702,'_problem_icons_3_prob_issue_text','field_640fa11a81d97'),(187001,2702,'problem_icons_0_prob_concerned_text','House prices have doubled in a decade'),(187002,2702,'_problem_icons_0_prob_concerned_text','field_640fa10181d96'),(187003,2702,'problem_icons_1_prob_concerned_text','The gap between rich and poor is growing'),(187004,2702,'_problem_icons_1_prob_concerned_text','field_640fa10181d96'),(187005,2702,'problem_icons_2_prob_concerned_text','Construction of social housing is down'),(187006,2702,'_problem_icons_2_prob_concerned_text','field_640fa10181d96'),(187007,2702,'problem_icons_3_prob_concerned_text','Banks are making more than ever from housing'),(187008,2702,'_problem_icons_3_prob_concerned_text','field_640fa10181d96'),(187009,2702,'monitor_content','The Australian Housing Monitor is a large, nationally-representative survey covering public experiences and attitudes toward housing related issues. Questions range from how well the respondent is keeping up with their mortgage/rent, to what they think about social housing construction.\r\n\r\nA broad range of demographic criteria are included, such as gender, location, age, income, voting preference, educational level, tenure type, and employment status. These variables allow CEH researchers to understand the trends and diversity of opinion around the country.\r\n\r\nIt also incorporates questions from previous surveys to track trends over time.\r\nThe inaugural poll was conducted by Essential in December 2022, and was completed by 4,735 people.'),(187010,2702,'_monitor_content','field_640fcc4014404'),(187011,2702,'problem_head','Housing in Australia is not working, and Australians are concerned.'),(187012,2702,'_problem_head','field_641935436aded'),(187013,2702,'problem_signoff','Explore the research showing how concerned Australians are our about the housing situation.'),(187014,2702,'_problem_signoff','field_641935626adee'),(187015,2702,'sections','a:2:{i:0;s:4:\"hero\";i:1;s:9:\"news_grid\";}'),(187016,2702,'_sections','field_5dafb40b8143a'),(187017,2702,'sections_0_is_full_height','1'),(187018,2702,'_sections_0_is_full_height','field_61d6f6fd5a37e'),(187019,2702,'sections_0_image','1648'),(187020,2702,'_sections_0_image','field_61d6f6d45a37d'),(187021,2702,'sections_0_heading','Heading'),(187022,2702,'_sections_0_heading','field_61d6f69e5a379'),(187023,2702,'sections_0_subtitle','Ya ya '),(187024,2702,'_sections_0_subtitle','field_61d6f6ac5a37a'),(187025,2702,'sections_0_link_one',''),(187026,2702,'_sections_0_link_one','field_61d6f6b55a37b'),(187027,2702,'sections_0_link_two',''),(187028,2702,'_sections_0_link_two','field_61d6f6c35a37c'),(187029,2702,'sections_1_select_categories','a:1:{i:0;s:2:\"27\";}'),(187030,2702,'_sections_1_select_categories','field_637f04483b63b'),(187031,2702,'intro_head_major','Welcome to the Disability Dialogue'),(187032,2702,'_intro_head_major','field_64e828783ad9