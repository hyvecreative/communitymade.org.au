_ctr_title','Talk to us'),(209901,2782,'_support_ctr_title','field_5b67c62a58af3'),(209902,2782,'support_ctr_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut laoreet.'),(209903,2782,'_support_ctr_cont','field_5b67c63158af4'),(209904,2782,'support_ctr_button','<a class=\"btn btn-orange\" href=\"/supports/\">Find us</a>'),(209905,2782,'_support_ctr_button','field_5b67c63658af5'),(209906,2782,'support_right_title','NDIS Registered provider'),(209907,2782,'_support_right_title','field_5b67c6a38c064'),(209908,2782,'support_right_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut.'),(209909,2782,'_support_right_cont','field_5b67c6c98c065'),(209910,2782,'support_right_button','<a class=\"btn btn-blue\" href=\"#\">Read more</a>'),(209911,2782,'_support_right_button','field_5b67c6dd8c066'),(209912,2782,'first_image_title','Lifestart is about supporting young children'),(209913,2782,'_first_image_title','field_5b67ca606afc4'),(209914,2782,'first_image_cont','from 0-24 years living with disabilities and their familes'),(209915,2782,'_first_image_cont','field_5b67caff6afc5'),(209916,2782,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(209917,2782,'_first_image_button','field_5b67cb0d6afc6'),(209918,2782,'second _image_title','Lifestart is about supporting young children'),(209919,2782,'_second _image_title','field_5b67cb20ddf9a'),(209920,2782,'second_image_cont','from 0-24 years living with disabilities and their familes'),(209921,2782,'_second_image_cont','field_5b67cb24ddf9b'),(209922,2782,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(209923,2782,'_second_image_button','field_5b67cb29ddf9c'),(209924,2782,'second_image_title','Lifestart is about supporting young children'),(209925,2782,'_second_image_title','field_5b67cb20ddf9a'),(209926,2782,'page_col_image','412'),(209927,2782,'_page_col_image','field_5de6546e7c63a'),(209928,2782,'page_col_image_3','437'),(209929,2782,'_page_col_image_3','field_5de6e3998e07e'),(209930,2782,'sec_2_title','Community'),(209931,2782,'_sec_2_title','field_5de6e3ef2798f'),(209932,2782,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(209933,2782,'_sec_2_text','field_5de78dc89e613'),(209934,2782,'sec_3_title','The Project'),(209935,2782,'_sec_3_title','field_5de6e3d37d8da'),(209936,2782,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(209937,2782,'_sec_3_text','field_5de6e4044e5e8'),(209938,2782,'page_col_image_2','436'),(209939,2782,'_page_col_image_2','field_5de6546e7c63a'),(209940,2782,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(209941,2782,'_sec_2_button','field_5de6e58c86706'),(209942,2782,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(209943,2782,'_sec_3_button','field_5de6e5a243c03'),(209944,2782,'page_col_image_4','455'),(209945,2782,'_page_col_image_4','field_5de70801090ce'),(209946,2782,'sec_4_title','Location'),(209947,2782,'_sec_4_title','field_5de7082a12a81'),(209948,2782,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(209949,2782,'_sec_4_text','field_5de7084812a82'),(209950,2782,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(209951,2782,'_sec_4_button','field_5de7085e12a83'),(209952,2782,'news_title','Project updates'),(209953,2782,'_news_title','field_5de78da3aabb9'),(209954,2782,'sec_2_text_copy',''),(209955,2782,'_sec_2_text_copy','field_5de78dc89e613'),(209956,2782,'timeline-title','Timeline'),(209957,2782,'_timeline-title','field_5de78df29e615'),(209958,2782,'timeline_title','Timeline'),(209959,2782,'_timeline_title','field_5de78df29e615'),(209960,2782,'contact_title','Contact us'),(209961,2782,'_contact_title','field_5de7981e06057'),(209962,2782,'contact_intro','Contact text...'),(209963,2782,'_contact_intro','field_5de7983506058'),(209964,2782,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(209965,2782,'_news_button','field_5de8329896e02'),(209966,2782,'timeline_intro','Introduction of timeline detail...'),(209967,2782,'_timeline_intro','field_5de98f5fb1781'),(209968,2782,'timeline_pic','477'),(209969,2782,'_timeline_pic','field_5de98f72b1782'),(209970,2782,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(209971,2782,'_timeline_button','field_5de99363677f8'),(209972,2782,'banner_image_position','center'),(209973,2782,'_banner_image_position','field_5f3bc4757dd02'),(209974,2782,'services_title','Our services'),(209975,2782,'_services_title','field_5f20f3cd80eb2'),(209976,2782,'services_items_0_services_item_image','1061'),(209977,2782,'_services_items_0_services_item_image','field_5f2121355be14'),(209978,2782,'services_items_0_sservices_item_title','1300 Telephone counselling line'),(209979,2782,'_services_items_0_sservices_item_title','field_605089efca82e'),(209980,2782,'services_items_0_services_item_text',''),(209981,2782,'_services_items_0_services_item_text','field_5f2121535be15'),(209982,2782,'servic