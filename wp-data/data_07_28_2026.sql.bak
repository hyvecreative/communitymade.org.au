2266,'survey_index','8'),(136474,2266,'_survey_index','field_6294561242236'),(136475,2266,'report_title','Download the report'),(136476,2266,'_report_title','field_62f30edfb57e1'),(136477,2266,'report_intro','Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus massa erat, consectetur at semper at, feugiat vel orci. '),(136478,2266,'_report_intro','field_62f30eedb57e2'),(136479,2266,'report_link_url','#'),(136480,2266,'_report_link_url','field_62f30ef4b57e3'),(136481,2266,'report_link_text','Download'),(136482,2266,'_report_link_text','field_62f30f01b57e4'),(136483,2266,'solutions_content','The housing system is complex, and no one solution will solve the complex problems we now face but there are some critical first steps to be taken now.\r\n<ul>\r\n 	<li>Set out an ambitious national housing agreement between commonwealth and state governments with targets and funding for the construction of affordable homes.</li>\r\n 	<li>Phase out tax breaks for property investors and using the increase in revenue to build more public housing.</li>\r\n 	<li>Establish laws which limit rental increases beyond what is fair.</li>\r\n 	<li>Rebalance tenancy laws to provide renters with more security and control, such as eliminating no grounds evictions.</li>\r\n 	<li>Phase out stamp duty and replace it with a broad-based land tax.</li>\r\n</ul>\r\n<h4>While there are many opinions on what policy changes will fix the housing market, doing nothing is not an option.</h4>'),(136484,2266,'_solutions_content','field_640e8b307a958'),(136485,2266,'problem_icons_0_prob_icon','1699'),(136486,2266,'_problem_icons_0_prob_icon','field_640fa0291d519'),(136487,2266,'problem_icons_0_prob_concerned_stat','70% highly concerned'),(136488,2266,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(136489,2266,'problem_icons_0_prob_concerded_text','are highly concerned'),(136490,2266,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(136491,2266,'problem_icons_0_prob_issue_text',''),(136492,2266,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(136493,2266,'problem_icons','4'),(136494,2266,'_problem_icons','field_640fa0191d518'),(136495,2266,'ceh_content_left',''),(136496,2266,'_ceh_content_left','field_640e97e8f1c8c'),(136497,2266,'ceh_content_right',''),(136498,2266,'_ceh_content_right','field_640e97fdf1c8d'),(136499,2266,'pc_content_left',''),(136500,2266,'_pc_content_left','field_640e983bf1c8f'),(136501,2266,'pc_content_right',''),(136502,2266,'_pc_content_right','field_640e984df1c90'),(136503,2266,'problem_icons_1_prob_icon','1699'),(136504,2266,'_problem_icons_1_prob_icon','field_640fa0291d519'),(136505,2266,'problem_icons_1_prob_concerned_stat','69% highly concerned'),(136506,2266,'_problem_icons_1_prob_concerned_stat','field_640fa0dd81d95'),(136507,2266,'problem_icons_1_prob_concerded_text','are highly concerned'),(136508,2266,'_problem_icons_1_prob_concerded_text','field_640fa10181d96'),(136509,2266,'problem_icons_1_prob_issue_text',''),(136510,2266,'_problem_icons_1_prob_issue_text','field_640fa11a81d97'),(136511,2266,'problem_icons_2_prob_icon','1699'),(136512,2266,'_problem_icons_2_prob_icon','field_640fa0291d519'),(136513,2266,'problem_icons_2_prob_concerned_stat','64% highly concerned'),(136514,2266,'_problem_icons_2_prob_concerned_stat','field_640fa0dd81d95'),(136515,2266,'problem_icons_2_prob_concerded_text','are highly concerned'),(136516,2266,'_problem_icons_2_prob_concerded_text','field_640fa10181d96'),(136517,2266,'problem_icons_2_prob_issue_text',''),(136518,2266,'_problem_icons_2_prob_issue_text','field_640fa11a81d97'),(136519,2266,'problem_icons_3_prob_icon','1699'),(136520,2266,'_problem_icons_3_prob_icon','field_640fa0291d519'),(136521,2266,'problem_icons_3_prob_concerned_stat','64% highly concerned'),(136522,2266,'_problem_icons_3_prob_concerned_stat','field_640fa0dd81d95'),(136523,2266,'problem_icons_3_prob_concerded_text','are highly concerned'),(136524,2266,'_problem_icons_3_prob_concerded_text','field_640fa10181d96'),(136525,2266,'problem_icons_3_prob_issue_text',''),(136526,2266,'_problem_icons_3_prob_issue_text','field_640fa11a81d97'),(136527,2266,'problem_icons_0_prob_concerned_text','House prices have doubled in a decade'),(136528,2266,'_problem_icons_0_prob_concerned_text','field_640fa10181d96'),(136529,2266,'problem_icons_1_prob_concerned_text','The gap between rich and poor is growing'),(136530,2266,'_problem_icons_1_prob_concerned_text','field_640fa10181d96'),(136531,2266,'problem_icons_2_prob_concerned_text','Construction of social housing is down'),(136532,2266,'_problem_icons_2_prob_concerned_text','field_640fa10181d96'),(136533,2266,'problem_icons_3_prob_concerned_text','Banks are making more than ever from housing'),(136534,2266,'_problem_icons_3_prob_concerned_text','field_640fa10181d96'),(136535,2266,'monitor_content','The Australian Housing Monitor is a large, nationally-representative survey covering public experiences and attitudes toward housing related issues. Questions range from how well the respondent is keeping up with their mortgage/rent, to what they think about social housing construction.\r\n\r\nA broad range of demographic criteria are included, such as gender, location, age, income, voting preference, educational level, tenure type, and employment status. These variables allow CEH researchers to understand the trends and diversity of opinion around the country.\r\n\r\nIt also incorporates questions from previous surveys to track trends over time.\r\nThe inaugural poll was conducted by Essential in December 2022, and was completed by 4,735 people.'),(136536,2266,'_monitor_content','field_640fcc4014404'),(136537,2266,'problem_head','Housing in Australia is not working, and Australians are concerned.'),(136538,2266,'_problem_head','field_641935436aded'),(136539,2266,'problem_signoff','Explore the research showing how concerned Australians are our about the housing situation.'),(136540,2266,'_problem_signoff','field_641935626adee'),(136541,2266,'sections','a:2:{i:0;s:4:\"hero\";i:1;s:9:\"news_grid\";}'),(136542,2266,'_sections','field_5dafb40b8143a'),(136543,2266,'sections_0_is_full_height','1'),(136544,2266,'_sections_0_is_full_height','field_61d6f6fd5a37e'),(136545,2266,'sections_0_image','1648'),(136546,2266,'_sections_0_image','field_61d6f6d45a37d'),(136547,2266,'sections_0_heading','Heading'),(136548,2266,'_sections_0_heading','field_61d6f69e5a379'),(136549,2266,'sections_0_subtitle','Ya ya '),(136550,2266,'_sections_0_subtitle','field_61d6f6ac5a37a'),(136551,2266,'sections_0_link_one',''),(136552,2266,'_sections_0_link_one','field_61d6f6b55a37b'),(136553,2266,'sections_0_link_two',''),(136554,2266,'_sections_0_link_two','field_61d6f6c35a37c'),(136555,2266,'sections_1_select_categories','a:1:{i:0;s:2:\"27\";}'),(136556,2266,'_sections_1_select_categories','field_637f04483b63b'),(136557,2266,'intro_head_major','Welcome to the Disability Dialogue'),(136558,2266,'_intro_head_major','field_64e828783ad9f'),(136559,2266,'intro_head_minor',''),(136560,2266,'_intro_head_minor','field_64e8288c3ada0'),(136561,2266,'intro_icons_0_int_icon','1922'),(136562,2266,'_intro_icons_0_int_icon','field_64e828b33ada2'),(136563,2266,'intro_icons_0_int_icon_text','At 1,727,000 square kilometres, we’re 2.5 times the size of Texas. <span>Yeeha!</span>'),(136564,2266,'_intro_icons_0_int_icon_text','field_64e828e33ada3'),(136565,2266,'intro_icons_1_int_icon','1920'),(136566,2266,'_intro_icons_1_int_icon','field_64e828b33ada2'),(136567,2266,'intro_icons_1_int_icon_text','We have twice as many species of native plant and animal as any other Australian state or territory.'),(136568,2266,'_intro_icons_1_int_icon_text','field_64e828e33ada3'),(136569,2266,'intro_icons_2_int_icon','1921'),(136570,2266,'_intro_icons_2_int_icon','field_64e828b33ada2'),(136571,2266,'intro_icons_2_int_icon_text','We have less land classified as ‘protected’ than any other state or territory.'),(136572,2266,'_intro_icons_2_int_icon_text','fi