_link_text','field_693d4ad641980'),(213146,2788,'what_happened','2'),(213147,2788,'_what_happened','field_693d4a6f4197c'),(213148,2788,'what_happened_0_happ_icon','2703'),(213149,2788,'_what_happened_0_happ_icon','field_693d4c9b3ec4d'),(213150,2788,'what_happened_1_happ_icon','2703'),(213151,2788,'_what_happened_1_happ_icon','field_693d4c9b3ec4d'),(213152,2788,'display_news_section',''),(213153,2788,'_display_news_section','field_69434cc6d5f7d'),(213154,2788,'issues_head','These are the issues'),(213155,2788,'_issues_head','field_6a3b076406aef'),(213156,2788,'issues_items_0_issue_icon','2705'),(213157,2788,'_issues_items_0_issue_icon','field_6a3b07b506af1'),(213158,2788,'issues_items_0_issues_item_hd','A secure home is slipping out of reach'),(213159,2788,'_issues_items_0_issues_item_hd','field_6a3b07d706af2'),(213160,2788,'issues_items_0_issues_item_txt','•	A shortage of 132,000 social and affordable rental homes\r\n•	70,000+ households waiting for social housing\r\n•	Record-high private market rents\r\n•	Home ownership increasingly out of reach for generations'),(213161,2788,'_issues_items_0_issues_item_txt','field_6a3b07fc06af3'),(213162,2788,'issues_items_0_issues_link_text',''),(213163,2788,'_issues_items_0_issues_link_text','field_6a3b080f06af4'),(213164,2788,'issues_items_0_issues_target_url',''),(213165,2788,'_issues_items_0_issues_target_url','field_6a3b082b06af5'),(213166,2788,'issues_items','2'),(213167,2788,'_issues_items','field_6a3b078206af0'),(213168,2788,'issues_items_1_issue_icon','2708'),(213169,2788,'_issues_items_1_issue_icon','field_6a3b07b506af1'),(213170,2788,'issues_items_1_issues_item_hd','The solutions we need '),(213171,2788,'_issues_items_1_issues_item_hd','field_6a3b07d706af2'),(213172,2788,'issues_items_1_issues_item_txt','Community housing works. We’re calling on the next NSW Government for three actions: long-term investment for new community housing, more funding to future-proof existing homes, and support to help people stayed housed.'),(213173,2788,'_issues_items_1_issues_item_txt','field_6a3b07fc06af3'),(213174,2788,'issues_items_1_issues_link_text',''),(213175,2788,'_issues_items_1_issues_link_text','field_6a3b080f06af4'),(213176,2788,'issues_items_1_issues_target_url',''),(213177,2788,'_issues_items_1_issues_target_url','field_6a3b082b06af5'),(213178,2788,'issues_items_0_issues_sub_head',''),(213179,2788,'_issues_items_0_issues_sub_head','field_6a3b0aa79365e'),(213180,2788,'issues_items_1_issues_sub_head',''),(213181,2788,'_issues_items_1_issues_sub_head','field_6a3b0aa79365e'),(213182,2788,'video_head','The people next door'),(213183,2788,'_video_head','field_6a5ff269ef234'),(213184,2788,'video_intro','Nurses. Childcare workers. Single parents. Older Australians who want to stay near the people they love. Community housing is the solution.'),(213185,2788,'_video_intro','field_6a606161b34b6'),(213186,2788,'hm_hero_title_sm','because we all deserve a safe, secure and affordable home'),(213187,2788,'_hm_hero_title_sm','field_6a607121b523f'),(213188,2788,'solutions_head','The solutions we need this election'),(213189,2788,'_solutions_head','field_6a61a1aaac606'),(213190,2788,'solutions_items','3'),(213191,2788,'_solutions_items','field_6a61a1aeac607'),(213192,2788,'solutions_items_0_issue_icon','2703'),(213193,2788,'_solutions_items_0_issue_icon','field_6a61a1aeac608'),(213194,2788,'solutions_items_0_issues_item_hd',''),(213195,2788,'_solutions_items_0_issues_item_hd','field_6a61a1aeac609'),(213196,2788,'solutions_items_0_issues_sub_head','long-term investment for new community housing,'),(213197,2788,'_solutions_items_0_issues_sub_head','field_6a61a1aeac60a'),(213198,2788,'solutions_items_0_issues_item_txt',''),(213199,2788,'_solutions_items_0_issues_item_txt','field_6a61a1aeac60b'),(213200,2788,'solutions_items_0_issues_link_text',''),(213201,2788,'_solutions_items_0_issues_link_text','field_6a61a1aeac60c'),(213202,2788,'solutions_items_0_issues_target_url',''),(213203,2788,'_solutions_items_0_issues_target_url','field_6a61a1aeac60d'),(213204,2788,'solutions_items_1_issue_icon','2703'),(213205,2788,'_solutions_items_1_issue_icon','field_6a61a1aeac608'),(213206,2788,'solutions_items_1_issues_item_hd',''),(213207,2788,'_solutions_items_1_issues_item_hd','field_6a61a1aeac609'),(213208,2788,'solutions_items_1_issues_sub_head','More funding to future-proof existing homes'),(213209,2788,'_solutions_items_1_issues_sub_head','field_6a61a1aeac60a'),(213210,2788,'solutions_items_1_issues_item_txt',''),(213211,2788,'_solutions_items_1_issues_item_txt','field_6a61a1aeac60b'),(213212,2788,'solutions_items_1_issues_link_text',''),(213213,2788,'_solutions_items_1_issues_link_text','field_6a61a1aeac60c'),(213214,2788,'solutions_items_1_issues_target_url',''),(213215,2788,'_solutions_items_1_issues_target_url','field_6a61a1aeac60d'),(213216,2788,'solutions_items_2_issue_icon','2703'),(213217,2788,'_solutions_items_2_issue_icon','field_6a61a1aeac608'),(213218,2788,'solutions_items_2_issues_item_hd',''),(213219,2788,'_solutions_items_2_issues_item_hd','field_6a61a1aeac609'),(213220,2788,'solutions_items_2_issues_sub_head','Support to help people stayed housed.'),(213221,2788,'_solutions_items_2_issues_sub_head','field_6a61a1aeac60a'),(213222,2788,'solutions_items_2_issues_item_txt',''),(213223,2788,'_solutions_items_2_issues_item_txt','field_6a61a1aeac60b'),(213224,2788,'solutions_items_2_issues_link_text',''),(213225,2788,'_solutions_items_2_issues_link_text','field_6a61a1aeac60c'),(213226,2788,'solutions_items_2_issues_target_url',''),(213227,2788,'_solutions_items_2_issues_target_url','field_6a61a1aeac60d'),(213228,2788,'solutions_sub','Community housing works. We’re calling on the next NSW Government for three actions:'),(213229,2788,'_solutions_sub','field_6a61a4c7a3d28');
