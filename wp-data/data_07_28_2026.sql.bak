5b67cb20ddf9a'),(65591,1835,'second_image_cont','from 0-24 years living with disabilities and their familes'),(65592,1835,'_second_image_cont','field_5b67cb24ddf9b'),(65593,1835,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(65594,1835,'_second_image_button','field_5b67cb29ddf9c'),(65595,1835,'second_image_title','Lifestart is about supporting young children'),(65596,1835,'_second_image_title','field_5b67cb20ddf9a'),(65597,1835,'page_col_image','412'),(65598,1835,'_page_col_image','field_5de6546e7c63a'),(65599,1835,'page_col_image_3','437'),(65600,1835,'_page_col_image_3','field_5de6e3998e07e'),(65601,1835,'sec_2_title','Community'),(65602,1835,'_sec_2_title','field_5de6e3ef2798f'),(65603,1835,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(65604,1835,'_sec_2_text','field_5de78dc89e613'),(65605,1835,'sec_3_title','The Project'),(65606,1835,'_sec_3_title','field_5de6e3d37d8da'),(65607,1835,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(65608,1835,'_sec_3_text','field_5de6e4044e5e8'),(65609,1835,'page_col_image_2','436'),(65610,1835,'_page_col_image_2','field_5de6546e7c63a'),(65611,1835,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(65612,1835,'_sec_2_button','field_5de6e58c86706'),(65613,1835,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(65614,1835,'_sec_3_button','field_5de6e5a243c03'),(65615,1835,'page_col_image_4','455'),(65616,1835,'_page_col_image_4','field_5de70801090ce'),(65617,1835,'sec_4_title','Location'),(65618,1835,'_sec_4_title','field_5de7082a12a81'),(65619,1835,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(65620,1835,'_sec_4_text','field_5de7084812a82'),(65621,1835,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(65622,1835,'_sec_4_button','field_5de7085e12a83'),(65623,1835,'news_title','Project updates'),(65624,1835,'_news_title','field_5de78da3aabb9'),(65625,1835,'sec_2_text_copy',''),(65626,1835,'_sec_2_text_copy','field_5de78dc89e613'),(65627,1835,'timeline-title','Timeline'),(65628,1835,'_timeline-title','field_5de78df29e615'),(65629,1835,'timeline_title','Timeline'),(65630,1835,'_timeline_title','field_5de78df29e615'),(65631,1835,'contact_title','Contact us'),(65632,1835,'_contact_title','field_5de7981e06057'),(65633,1835,'contact_intro','Contact text...'),(65634,1835,'_contact_intro','field_5de7983506058'),(65635,1835,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(65636,1835,'_news_button','field_5de8329896e02'),(65637,1835,'timeline_intro','Introduction of timeline detail...'),(65638,1835,'_timeline_intro','field_5de98f5fb1781'),(65639,1835,'timeline_pic','477'),(65640,1835,'_timeline_pic','field_5de98f72b1782'),(65641,1835,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(65642,1835,'_timeline_button','field_5de99363677f8'),(65643,1835,'banner_image_position','center'),(65644,1835,'_banner_image_position','field_5f3bc4757dd02'),(65645,1835,'services_title','Our services'),(65646,1835,'_servic