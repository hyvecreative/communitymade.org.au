ob_concerned_stat','field_640fa0dd81d95'),(67355,1848,'problem_icons_3_prob_concerded_text','are highly concerned'),(67356,1848,'_problem_icons_3_prob_concerded_text','field_640fa10181d96'),(67357,1848,'problem_icons_3_prob_issue_text',''),(67358,1848,'_problem_icons_3_prob_issue_text','field_640fa11a81d97'),(67359,1848,'problem_icons_0_prob_concerned_text','House prices have doubled in a decade'),(67360,1848,'_problem_icons_0_prob_concerned_text','field_640fa10181d96'),(67361,1848,'problem_icons_1_prob_concerned_text','The gap between rich and poor is growing'),(67362,1848,'_problem_icons_1_prob_concerned_text','field_640fa10181d96'),(67363,1848,'problem_icons_2_prob_concerned_text','Construction of social housing is down'),(67364,1848,'_problem_icons_2_prob_concerned_text','field_640fa10181d96'),(67365,1848,'problem_icons_3_prob_concerned_text','Banks are making more than ever from housing'),(67366,1848,'_problem_icons_3_prob_concerned_text','field_640fa10181d96'),(67367,1848,'monitor_content','The Australian Housing Monitor is a large, nationally-representative survey covering public experiences and attitudes toward housing related issues. Questions range from how well the respondent is keeping up with their mortgage/rent, to what they think about social housing construction.\r\n\r\nA broad range of demographic criteria are included, such as gender, location, age, income, voting preference, educational level, tenure type, and employment status. These variables allow CEH researchers to understand the trends and diversity of opinion around the country.\r\n\r\nIt also incorporates questions from previous surveys to track trends over time.\r\nThe inaugural poll was conducted by Essential in December 2022, and was completed by 4,735 people.'),(67368,1848,'_monitor_content','field_640fcc4014404'),(67369,1848,'problem_head','Housing in Australia is not working, and Australians are concerned.'),(67370,1848,'_problem_head','field_641935436aded'),(67371,1848,'problem_signoff','Explore the research showing how concerned Australians are our about the housing situation.'),(67372,1848,'_problem_signoff','field_641935626adee'),(67373,1848,'sections','a:2:{i:0;s:4:\"hero\";i:1;s:9:\"news_grid\";}'),(67374,1848,'_sections','field_5dafb40b8143a'),(67375,1848,'sections_0_is_full_height','1'),(67376,1848,'_sections_0_is_full_height','field_61d6f6fd5a37e'),(67377,1848,'sections_0_image','1648'),(67378,1848,'_sections_0_image','field_61d6f6d45a37d'),(67379,1848,'sections_0_heading','Heading'),(67380,1848,'_sections_0_heading','field_61d6f69e5a379'),(67381,1848,'sections_0_subtitle','Ya ya '),(67382,1848,'_sections_0_subtitle','field_61d6f6ac5a37a'),(67383,1848,'sections_0_link_one',''),(67384,1848,'_sections_0_link_one','field_61d6f6b55a37b'),(67385,1848,'sections_0_link_two',''),(67386,1848,'_sections_0_link_two','field_61d6f6c35a37c'),(67387,1848,'sections_1_select_categories','a:1:{i:0;s:2:\"27\";}'),(67388,1848,'_sections_1_select_categories','field_637f04483b63b'),(67389,1848,'intro_head_major','Queenslanders are known for both our love of the great outdoors and our state pride…'),(67390,1848,'_intro_head_major','field_64e828783ad9f'),(67391,1848,'intro_head_minor','But there’s a few things you might not know about our beautiful state.'),(67392,1848,'_intro_head_minor','field_64e8288c3ada0'),(67393,1848,'intro_icons_0_int_icon','1806'),(67394,1848,'_intro_icons_0_int_icon','field_64e828b33ada2'),(67395,1848,'intro_icons_0_int_icon_text','At 1,727,000 square kilometres, we’re 2.5 times the size of Texas. <span>Yeeha!</span>'),(67396,1848,'_intro_icons_0_int_icon_text','field_64e828e33ada3'),(67397,1848,'intro_icons_1_int_icon','1806'),(67398,1848,'_intro_icons_1_int_icon','field_64e828b33ada2'),(67399,1848,'intro_icons_1_int_icon_text','We have twice as many species of native plant and animal as any other Australian state or territory.'),(67400,1848,'_intro_icons_1_int_icon_text','field_64e828e33ada3'),(67401,1848,'intro_icons_2_int_icon','1