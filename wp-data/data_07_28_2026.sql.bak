e_cont','field_5b67caff6afc5'),(81742,1915,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(81743,1915,'_first_image_button','field_5b67cb0d6afc6'),(81744,1915,'second _image_title','Lifestart is about supporting young children'),(81745,1915,'_second _image_title','field_5b67cb20ddf9a'),(81746,1915,'second_image_cont','from 0-24 years living with disabilities and their familes'),(81747,1915,'_second_image_cont','field_5b67cb24ddf9b'),(81748,1915,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(81749,1915,'_second_image_button','field_5b67cb29ddf9c'),(81750,1915,'second_image_title','Lifestart is about supporting young children'),(81751,1915,'_second_image_title','field_5b67cb20ddf9a'),(81752,1915,'page_col_image','412'),(81753,1915,'_page_col_image','field_5de6546e7c63a'),(81754,1915,'page_col_image_3','437'),(81755,1915,'_page_col_image_3','field_5de6e3998e07e'),(81756,1915,'sec_2_title','Community'),(81757,1915,'_sec_2_title','field_5de6e3ef2798f'),(81758,1915,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(81759,1915,'_sec_2_text','field_5de78dc89e613'),(81760,1915,'sec_3_title','The Project'),(81761,1915,'_sec_3_title','field_5de6e3d37d8da'),(81762,1915,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(81763,1915,'_sec_3_text','field_5de6e4044e5e8'),(81764,1915,'page_col_image_2','436'),(81765,1915,'_page_col_image_2','field_5de6546e7c63a'),(81766,1915,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(81767,1915,'_sec_2_button','field_5de6e58c86706'),(81768,1915,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(81769,1915,'_sec_3_button','field_5de6e5a243c03'),(81770,1915,'page_col_image_4','455'),(81771,1915,'_page_col_image_4','field_5de70801090ce'),(81772,1915,'sec_4_title','Location'),(81773,1915,'_sec_4_title','field_5de7082a12a81'),(81774,1915,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(81775,1915,'_sec_4_text','field_5de7084812a82'),(81776,1915,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(81777,1915,'_sec_4_button','field_5de7085e12a83'),(81778,1915,'news_title','Project updates'),(81779,1915,'_news_title','field_5de78da3aabb9'),(81780,1915,'sec_2_text_copy',''),(81781,1915,'_sec_2_text_copy','field_5de78dc89e613'),(81782,1915,'timeline-title','Timeline'),(81783,1915,'_timeline-title','field_5de78df29e615'),(81784,1915,'timeline_title','Timeline'),(81785,1915,'_timeline_title','field_5de78df29e615'),(81786,1915,'contact_title','Contact us'),(81787,1915,'_contact_title','field_5de7981e06057'),(81788,1915,'contact_intro','Contact text...'),(81789,1915,'_contact_intro','field_5de7983506058'),(81790,1915,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(81791,1915,'_news_button','field_5de8329896e02'),(81792,1915,'timeline_intro','Introduction of timeline detail...'),(81793,1915,'_timeline_intro','field_5de98f5fb1781'),(81794,1915,'timeline_pic','477'),(81795,1915,'_timeline_pic','field_5de98f72b1782'),(81796,1915,'timeline_button','<a class=\