r familes'),(89845,1938,'_second_image_cont','field_5b67cb24ddf9b'),(89846,1938,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(89847,1938,'_second_image_button','field_5b67cb29ddf9c'),(89848,1938,'second_image_title','Lifestart is about supporting young children'),(89849,1938,'_second_image_title','field_5b67cb20ddf9a'),(89850,1938,'page_col_image','412'),(89851,1938,'_page_col_image','field_5de6546e7c63a'),(89852,1938,'page_col_image_3','437'),(89853,1938,'_page_col_image_3','field_5de6e3998e07e'),(89854,1938,'sec_2_title','Community'),(89855,1938,'_sec_2_title','field_5de6e3ef2798f'),(89856,1938,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(89857,1938,'_sec_2_text','field_5de78dc89e613'),(89858,1938,'sec_3_title','The Project'),(89859,1938,'_sec_3_title','field_5de6e3d37d8da'),(89860,1938,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(89861,1938,'_sec_3_text','field_5de6e4044e5e8'),(89862,1938,'page_col_image_2','436'),(89863,1938,'_page_col_image_2','field_5de6546e7c63a'),(89864,1938,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(89865,1938,'_sec_2_button','field_5de6e58c86706'),(89866,1938,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(89867,1938,'_sec_3_button','field_5de6e5a243c03'),(89868,1938,'page_col_image_4','455'),(89869,1938,'_page_col_image_4','field_5de70801090ce'),(89870,1938,'sec_4_title','Location'),(89871,1938,'_sec_4_title','field_5de7082a12a81'),(89872,1938,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(89873,1938,'_sec_4_text','field_5de7084812a82'),(89874,1938,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(89875,1938,'_sec_4_button','field_5de7085e12a83'),(89876,1938,'news_title','Project updates'),(89877,1938,'_news_title','field_5de78da3aabb9'),(89878,1938,'sec_2_text_copy',''),(89879,1938,'_sec_2_text_copy','field_5de78dc89e613'),(89880,1938,'timeline-title','Timeline'),(89881,1938,'_timeline-title','field_5de78df29e615'),(89882,1938,'timeline_title','Timeline'),(89883,1938,'_timeline_title','field_5de78df29e615'),(89884,1938,'contact_title','Contact us'),(89885,1938,'_contact_title','field_5de7981e06057'),(89886,1938,'contact_intro','Contact text...'),(89887,1938,'_contact_intro','field_5de7983506058'),(89888,1938,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(89889,1938,'_news_button','field_5de8329896e02'),(89890,1938,'timeline_intro','Introduction of timeline detail...'),(89891,1938,'_timeline_intro','field_5de98f5fb1781'),(89892,1938,'timeline_pic','477'),(89893,1938,'_timeline_pic','field_5de98f72b1782'),(89894,1938,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(89895,1938,'_timeline_button','field_5de99363677f8'),(89896,1938,'banner_image_position','center'),(89897,1938,'_banner_image_position','field_5f3bc4757dd02'),(89898,1938,'services_title','Our services'),(89899,1938,'_services_title','field_5f20f3cd80eb2'),(89900,1938,'services_items_0_services_item_image','1061'),(89901