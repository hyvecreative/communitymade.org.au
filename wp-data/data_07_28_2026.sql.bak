,'V3_survey_results',''),(110636,2064,'_V3_survey_results','field_62b26257acd63'),(110637,2064,'nav_links_0_navlink','a:3:{s:5:\"title\";s:8:\"About us\";s:3:\"url\";s:38:\"//localhost:4000:4000:4000:4000/about/\";s:6:\"target\";s:0:\"\";}'),(110638,2064,'_nav_links_0_navlink','field_652fad2b0ea23'),(110639,2064,'nav_links_1_navlink','a:3:{s:5:\"title\";s:8:\"The team\";s:3:\"url\";s:15:\"/about/the-team\";s:6:\"target\";s:0:\"\";}'),(110640,2064,'_nav_links_1_navlink','field_652fad2b0ea23'),(110641,2064,'nav_links','4'),(110642,2064,'_nav_links','field_652face121365'),(110643,2064,'nav_links_2_navlink','a:3:{s:5:\"title\";s:18:\"Research committee\";s:3:\"url\";s:20:\"/research-committee/\";s:6:\"target\";s:0:\"\";}'),(110644,2064,'_nav_links_2_navlink','field_652fad2b0ea23'),(110645,2064,'nav_links_3_navlink','a:3:{s:5:\"title\";s:16:\"Policy Committee\";s:3:\"url\";s:18:\"/policy-committee/\";s:6:\"target\";s:0:\"\";}'),(110646,2064,'_nav_links_3_navlink','field_652fad2b0ea23'),(110647,2064,'people_profiles_0_people_icon','2059'),(110648,2064,'_people_profiles_0_people_icon','field_653891808ed10'),(110649,2064,'people_profiles_0_people_title','Rod Stowe (Chair)'),(110650,2064,'_people_profiles_0_people_title','field_653891928ed11'),(110651,2064,'people_profiles_0_people_content','Super Consumers Australia was founded in 2013 as a voice for consumers in the superannuation sector. We were created to advocate for fairness and transparency in a sector that is too often confusing and dominated by industry interests. As the leading voice for superannuation consumers, our mission is to ensure all Australians have access to are served by a super system that supports financial wellbeing in retirement.'),(110652,2064,'_people_profiles_0_people_content','field_6538919c8ed12'),(110653,2064,'people_profiles_1_people_icon','2057'),(110654,2064,'_people_profiles_1_people_icon','field_653891808ed10'),(110655,2064,'people_profiles_1_people_title','Delia Rickard'),(110656,2064,'_p