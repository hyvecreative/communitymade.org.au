0_box_title','field_65262d29ed8e3'),(187933,2704,'intro_boxes_0_box_dropdown','Our rigorous, conflict-free research and data analysis lifts the lid on fund performance, fees and insurance. Drawing on our policy expertise, we turn this analysis into action by using it to back reform and make super easier for people to understand. <a href=\"//localhost:4000:4000:4000:4000:4000:4000:/how/\">More</a>'),(187934,2704,'_intro_boxes_0_box_dropdown','field_65262dead0a0c'),(187935,2704,'intro_boxes_1_box_icon','1941'),(187936,2704,'_intro_boxes_1_box_icon','field_65262db5d36ee'),(187937,2704,'intro_boxes_1_box_title','Projects'),(187938,2704,'_intro_boxes_1_box_title','field_65262d29ed8e3'),(187939,2704,'intro_boxes_1_box_dropdown','Our rigorous, conflict-free research and data analysis lifts the lid on fund performance, fees and insurance. Drawing on our policy expertise, we turn this analysis into action by using it to back reform and make super easier for people to understand. <a href=\"//localhost:4000:4000:4000:4000:4000:4000:/how/\">More</a>'),(187940,2704,'_intro_boxes_1_box_dropdown','field_65262dead0a0c'),(187941,2704,'intro_boxes_2_box_icon','1937'),(187942,2704,'_intro_boxes_2_box_icon','field_65262db5d36ee'),(187943,2704,'intro_boxes_2_box_title','Ideas'),(187944,2704,'_intro_boxes_2_box_title','field_65262d29ed8e3'),(187945,2704,'intro_boxes_2_box_dropdown','Our rigorous, conflict-free research and data analysis lifts the lid on fund performance, fees and insurance. Drawing on our policy expertise, we turn this analysis into action by using it to back reform and make super easier for people to understand. <a href=\"//localhost:4000:4000:4000:4000:4000:4000:/how/\">More</a>'),(187946,2704,'_intro_boxes_2_box_dropdown','field_65262dead0a0c'),(187947,2704,'intro_boxes','3'),(187948,2704,'_intro_boxes','field_65262d14ed8e2'),(187949,2704,'get_help_section_title','Get Help'),(187950,2704,'_get_help_section_title','field_65262c35143de'),(187951,2704,'get_help_block_home',''),(187952,2704,'_get_help_block_home','field_65262c8a143e1'),(187953,2704,'gh_block_home_0_help_image','1956'),(187954,2704,'_gh_block_home_0_help_image','field_65262cd0143e2'),(187955,2704,'gh_block_home_0_help_title','How much do I need to retire? '),(187956,2704,'_gh_block_home_0_help_title','field_65262cec143e3'),(187957,2704,'gh_block_home_0_help_url','#'),(187958,2704,'_gh_block_home_0_help_url','field_65262cf4143e4'),(187959,2704,'gh_block_home_1_help_image','1962'),(187960,2704,'_gh_block_home_1_help_image','field_65262cd0143e2'),(187961,2704,'gh_block_home_1_help_title','I have a problem with  my super fund'),(187962,2704,'_gh_block_home_1_help_title','field_65262cec143e3'),(187963,2704,'gh_block_home_1_help_url','#'),(187964,2704,'_gh_block_home_1_help_url','field_65262cf4143e4'),(187965,2704,'gh_block_home_2_help_image','1961'),(187966,2704,'_gh_block_home_2_help_image','field_65262cd0143e2'),(187967,2704,'gh_block_home_2_help_title','How do I choose the right super? '),(187968,2704,'_gh_block_home_2_help_title','field_65262cec143e3'),(187969,2704,'gh_block_home_2_help_url','#'),(187970,2704,'_gh_block_home_2_help_url','field_65262cf4143e4'),(187971,2704,'gh_block_home','3'),(187972,2704,'_gh_block_home','field_65262c8a143e1'),(187973,2704,'turn_on_insights',''),(187974,2704,'_turn_on_insights','field_645c4a2e654a6'),(187975,2704,'report_questions','a:3:{i:0;s:2:\"59\";i:1;s:2:\"61\";i:2;s:4:\"2587\";}'),(187976,2704,'_report_questions','field_6109ed5e02e5a'),(187977,2704,'intro_text','The Disability Dialogue is a place where people with disabilities, their families, organisations providing support, academics, and the wider community come together to work on things that matter to us.\r\n\r\nThe Dialogue is a hub of knowledge and collaboration, separate from government, where we work together to come up. With new ideas on important topics. Our ideas can make a big difference in how services and systems are set up for people with disabilities.'),(187978,2704,'_intro_text','field_66441acfe963c'),(187979,2704,'word_link','#'),(187980,2704,'_word_link','field_6646c69723804'),(187981,2704,'pdf_link','#'),(187982,2704,'_pdf_link','field_6646c6da23805'),(187983,2704,'intro_boxes_0_box_image','2241'),(187984,2704,'_intro_boxes_0_box_image','field_65262db5d36ee'),(187985,2704,'intro_boxes_1_box_image','2179'),(187986,2704,'_intro_boxes_1_box_image','field_65262db5d36ee'),(187987,2704,'intro_boxes_2_box_image','2012'),(187988,2704,'_intro_boxes_2_box_image','field_65262db5d36ee'),(187989,2704,'intro_boxes_0_box_excerpt','Excerpt text here just a sentance or so and no more.'),(187990,2704,'_intro_boxes_0_box_excerpt','field_665975273e827'),(187991,2704,'intro_boxes_1_box_excerpt','Excerpt text here just a sentance or so and no more.'),(187992,2704,'_intro_boxes_1_box_excerpt','field_665975273e827'),(187993,2704,'intro_boxes_2_box_excerpt','Excerpt text here just a sentance or so and no more.'),(187994,2704,'_intro_boxes_2_box_excerpt','field_665975273e827'),(187995,2704,'intro_boxes_0_btn-text','Latest events'),(187996,2704,'_intro_boxes_0_btn-text','field_665abda8b8d4b'),(187997,2704,'intro_boxes_1_btn-text','Latest projects'),(187998,2704,'_intro_boxes_1_btn-text','field_665abda8b8d4b'),(187999,2704,'intro_boxes_2_btn-text','Latest ideas'),(188000,2704,'_intro_boxes_2_btn-text','field_665abda8b8d4b'),(188001,2704,'display-easy-read',''),(188002,2704,'_display-easy-read','field_666129bd2da00'),(188003,2704,'hm_hero_sum','Statement about the issue and lost life savings'),(188004,2704,'_hm_hero_sum','field_64ed37241effa'),(188005,2704,'hm_hero_sub','When housing is affordable, communities thrive – that’s what  community made means. Homes built and managed by not-for-profits with purpose, not profit.'),(188006,2704,'_hm_hero_sub','field_64ed37241effa'),(188007,2704,'intro_head','We’re here to help.'),(188008,2704,'_intro_head','field_64e828783ad9f'),(188009,2704,'intro_content','About 12,000 people invested their hard-earned super savings in two investment funds which have now collapsed, called Shield Master Fund and First Guardian Master Fund. Most people will be entitled to get some money back, but you need to take action soon. This website has information and tools to help you understand what happened, where to get help and how to take back your super.'),(188010,2704,'_intro_content','field_66441acfe963c'),(188011,2704,'deadline_heading','Important deadlines'),(188012,2704,'_deadline_heading','field_69365ff82e6f2');
INSERT INTO `wp_postmeta` VALUES (188013,2704,'deadline_content','You need to take action before the deadline to take your super back.'),(188014,2704,'_deadline_content','field_693660342e6f3'),(188015,2704,'deadline_button_text','Find out more'),(188016,2704,'_deadline_button_text','field_693660482e6f4'),(188017,2704,'deadline_button_url','/key-deadlines/'),(188018,2704,'_deadline_button_url','field_693660912e6f5'),(188019,2704,'what_head','What happened?'),(188020,2704,'_what_head','field_69366611096ac'),(188021,2704,'what_happened_0_happ_sub','What are Shield and First Guardian?'),(188022,2704,'_what_happened_0_happ_sub','field_693d4a8b4197d'),(188023,2704,'what_happened_0_happ_content','About 12,000 people invested their hard-earned super savings in two investment funds called Shield Master Fund and First Guardian Master Fund. Those funds have collapsed, and a large part of the $1.2 billion people invested is gone.\r\n\r\nMost people invested through financial advisers who contacted them after they clicked on a social media ad offering a free super comparison or review.'),(188024,2704,'_what_happened_0_happ_content','field_693d4aa84197e'),(188025,2704,'what_happened_0_happ_url','/what-happened/'),(188026,2704,'_what_happened_0_happ_url','field_693d4aba4197f'),(188027,2704,'what_happened_0_happ_link_text','More'),(188028,2704,'_what_happened_0_happ_link_text','field_693d4ad641980'),(188029,2704,'what_happened_1_happ_sub','What is being done about this?'),(188030,2704,'_what_happened_1_happ_sub','field_693d4a8b4197d'),(188031,2704,'what_happened_1_happ_content','There is a lot of work being done to try to get money back for people who invested.\r\n\r\nThe regulator is also investigating what happened and has started enforcement action against a number of different people and companies for their involvement in the collapses of Shield and First Guardian Master Funds. Learn about the progress of this work'),(188032,2704,'_what_happened_1_happ_content','field_693d4aa84197e'),(188033,2704,'what_happened_1_happ_url','/what-happened/'),(188034,2704,'_what_happened_1_happ_url','field_693d4aba4197f'),(188035,2704,'what_happened_1_happ_link_text','More'),(188036,2704,'_what_happened_1_happ_link_text','field_693d4ad641980'),(188037,2704,'what_happened','2'),(188038,2704,'_what_happened','field_693d4a6f4197c'),(188039,2704,'what_happened_0_happ_icon','2605'),(188040,2704,'_what_happened_0_happ_icon','field_693d4c9b3ec4d'),(188041,2704,'what_happened_1_happ_icon','2604'),(188042,2704,'_what_happened_1_happ_icon','field_693d4c9b3ec4d'),(188043,2704,'display_news_section',''),(188044,2704,'_display_news_section','field_69434cc6d5f7d'),(188045,2704,'issues_head','The Issues'),(188046,2704,'_issues_head','field_6a3b076406aef'),(188047,2704,'issues_items_0_issue_icon','2703'),(188048,2704,'_issues_items_0_issue_icon','field_6a3b07b506af1'),(188049,2704,'issues_items_0_issues_item_hd','The problem'),(188050,2704,'_issues_items_0_issues_item_hd','field_6a3b07d706af2'),(188051,2704,'issues_items_0_issues_item_txt','Rents are rising, waitlists are growing and more people are experiencing housing stress for the first time.'),(188052,2704,'_issues_items_0_issues_item_txt','field_6a3b07fc06af3'),(188053,2704,'issues_items_0_issues_link_text','Find out more'),(188054,2704,'_issues_items_0_issues_link_text','field_6a3b080f06af4'),(188055,2704,'issues_items_0_issues_target_url','#'),(188056,2704,'_issues_items_0_issues_target_url','field_6a3b082b06af5'),(188057,2704,'issues_items','2'),(188058,2704,'_issues_items','field_6a3b078206af0'),(188059,2704,'issues_items_1_issue_icon','2703'),(188060,2704,'_issues_items_1_issue_icon','field_6a3b07b506af1'),(188061,2704,'issues_items_1_issues_item_hd','Scaling the solution'),(188062,2704,'_issues_items_1_issues_item_hd','field_6a3b07d706af2'),(188063,2704,'issues_items_1_issues_item_txt','Governments, communities and not-for-profit community housing providers are working together to make rental housing more affo