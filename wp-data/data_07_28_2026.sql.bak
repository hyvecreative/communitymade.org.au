port_right_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut.'),(4159,479,'_support_right_cont','field_5b67c6c98c065'),(4160,479,'support_right_button','<a class=\"btn btn-blue\" href=\"#\">Read more</a>'),(4161,479,'_support_right_button','field_5b67c6dd8c066'),(4162,479,'first_image_title','Lifestart is about supporting young children'),(4163,479,'_first_image_title','field_5b67ca606afc4'),(4164,479,'first_image_cont','from 0-24 years living with disabilities and their familes'),(4165,479,'_first_image_cont','field_5b67caff6afc5'),(4166,479,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(4167,479,'_first_image_button','field_5b67cb0d6afc6'),(4168,479,'second _image_title','Lifestart is about supporting young children'),(4169,479,'_second _image_title','field_5b67cb20ddf9a'),(4170,479,'second_image_cont','from 0-24 years living with disabilities and their familes'),(4171,479,'_second_image_cont','field_5b67cb24ddf9b'),(4172,479,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(4173,479,'_second_image_button','field_5b67cb29ddf9c'),(4174,479,'second_image_title','Lifestart is about supporting young children'),(4175,479,'_second_image_title','field_5b67cb20ddf9a'),(4176,479,'page_col_image','412'),(4177,479,'_page_col_image','field_5de6546e7c63a'),(4178,479,'page_col_image_3','437'),(4179,479,'_page_col_image_3','field_5de6e3998e07e'),(4180,479,'sec_2_title','Community'),(4181,479,'_sec_2_title','field_5de6e3ef2798f'),(4182,479,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(4183,479,'_sec_2_text','field_5de78dc89e613'),(4184,479,'sec_3_title','The Project'),(4185,479,'_sec_3_title','field_5de6e3d37d8da'),(4186,479,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(4187,479,'_sec_3_text','field_5de6e4044e5e8'),(4188,479,'page_col_image_2','436'),(4189,479,'_page_col_image_2','field_5de6546e7c63a'),(4190,479,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(4191,479,'_sec_2_button','field_5de6e58c86706'),(4192,479,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(4193,479,'_sec_3_button','field_5de6e5a243c03'),(4194,479,'page_col_image_4','455'),(4195,479,'_page_col_image_4','field_5de70801090ce'),(4196,479,'sec_4_title','Location'),(4197,479,'_sec_4_title','field_5de7082a12a81'),(4198,479,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(4199,479,'_sec_4_text','field_5de7084812a82'),(4200,479,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(4201,479,'_sec_4_button','field_5de7085e12a83'),(4202,479,'news_title','Project updates'),(4203,479,'_news_title','field_5de78da3aabb9'),(4204,479,'sec_2_text_copy',''),(4205,479,'_sec_2_text_copy','field_5de78dc89e613'),(4206,479,'timeline-title','Timeline'),(4207,479,'_timeline-title','field_5de78df29e615'),(4208,479,'timeline_title','Timeline'),(4209,479,'_timeline_title','field_5de78df29e615'),(4210,479,'contact_title','Contact us'),(4211,479,'_contact_title','field_5de7981e06057'),(4212,479,'contact_intro