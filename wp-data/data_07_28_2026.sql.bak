732,'survey_index_5_survey_icon','1489'),(200833,2732,'_survey_index_5_survey_icon','field_6294562942237'),(200834,2732,'survey_index_5_survey_title','Battery Storage'),(200835,2732,'_survey_index_5_survey_title','field_6294564042238'),(200836,2732,'survey_index_5_survey_url','#'),(200837,2732,'_survey_index_5_survey_url','field_6294564e42239'),(200838,2732,'survey_index_5_survey_url_text','View Results'),(200839,2732,'_survey_index_5_survey_url_text','field_629456584223a'),(200840,2732,'survey_index_6_survey_icon','1492'),(200841,2732,'_survey_index_6_survey_icon','field_6294562942237'),(200842,2732,'survey_index_6_survey_title','Energy Management'),(200843,2732,'_survey_index_6_survey_title','field_6294564042238'),(200844,2732,'survey_index_6_survey_url','#'),(200845,2732,'_survey_index_6_survey_url','field_6294564e42239'),(200846,2732,'survey_index_6_survey_url_text','View Results'),(200847,2732,'_survey_index_6_survey_url_text','field_629456584223a'),(200848,2732,'survey_index_7_survey_icon','1493'),(200849,2732,'_survey_index_7_survey_icon','field_6294562942237'),(200850,2732,'survey_index_7_survey_title','Going Off-grid'),(200851,2732,'_survey_index_7_survey_title','field_6294564042238'),(200852,2732,'survey_index_7_survey_url','#'),(200853,2732,'_survey_index_7_survey_url','field_6294564e42239'),(200854,2732,'survey_index_7_survey_url_text','View Results'),(200855,2732,'_survey_index_7_survey_url_text','field_629456584223a'),(200856,2732,'survey_index','8'),(200857,2732,'_survey_index','field_6294561242236'),(200858,2732,'report_title','Download the report'),(200859,2732,'_report_title','field_62f30edfb57e1'),(200860,2732,'report_intro','Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus massa erat, consectetur at semper at, feugiat vel orci. '),(200861,2732,'_report_intro','field_62f30eedb57e2'),(200862,2732,'report_link_url','#'),(200863,2732,'_report_link_url','field_62f30ef4b57e3'),(200864,2732,'report_link_text','Download'),(200865,2732,'_report_link_text','field_62f30f01b57e4'),(200866,2732,'solutions_content','The housing system is complex, and no one solution will solve the complex problems we now face but there are some critical first steps to be taken now.\r\n<ul>\r\n 	<li>Set out an ambitious national housing agreement between commonwealth and state governments with targets and funding for the construction of affordable homes.</li>\r\n 	<li>Phase out tax breaks for property investors and using the increase in revenue to build more public housing.</li>\r\n 	<li>Establish laws which limit rental increases beyond what is fair.</li>\r\n 	<li>Rebalance tenancy laws to provide renters with more security and control, such as eliminating no grounds evictions.</li>\r\n 	<li>Phase out stamp duty and replace it with a broad-based land tax.</li>\r\n</ul>\r\n<h4>While there are many opinions on what policy changes will fix the housing market, doing nothing is not an option.</h4>'),(200867,2732,'_solutions_content','field_640e8b307a958'),(200868,2732,'problem_icons_0_prob_icon','1699'),(200869,2732,'_problem_icons_0_prob_icon','field_640fa0291d519'),(200870,2732,'problem_icons_0_prob_concerned_stat','70% highly concerned'),(200871,2732,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(200872,2732,'problem_icons_0_prob_concerded_text','are highly concerned'),(200873,2732,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(200874,2732,'problem_icons_0_prob_issue_text',''),(200875,2732,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(200876,2732,'problem_icons','4'),(200877,2732,'_problem_icons','field_640fa0191d518'),(200878,2732,'ceh_content_left',''),(200879,2732,'_ceh_content_left','field_640e97e8f1c8c'),(200880,2732,'ceh_content_right',''),(200881,2732,'_ceh_content_right','field_640e97fdf1c8d'),(200882,2732,'pc_content_left',''),(200883,2732,'_pc_content_left','field_640e983bf1c8f'),(200884,2732,'pc_content_right',''),(200885,2732,'_pc_content_right','field_640e984df1c90'),(200886,2732,'problem_icons_1_prob_icon','1699'),(200887,2732,'_problem_icons_1_prob_icon','field_640fa0291d519'),(200888,2732,'problem_icons_1_prob_concerned_stat','69% highly concerned'),(200889,2732,'_problem_icons_1_prob_concerned_stat','field_640fa0dd81d95'),(200890,2732,'problem_icons_1_prob_concerded_text','are highly concerned'),(200891,2732,'_problem_icons_1_prob_concerded_text','field_640fa10181d96'),(200892,2732,'problem_icons_1_prob_issue_text',''),(200893,2732,'_problem_icons_1_prob_issue_text','field_640fa11a81d97'),(200894,2732,'problem_icons_2_prob_icon','1699'),(200895,2732,'_problem_icons_2_prob_icon','field_640fa0291d519'),(200896,2732,'problem_icons_2_prob_concerned_stat','64% highly concerned'),(200897,2732,'_problem_icons_2_prob_concerned_stat','field_640fa0dd81d95'),(200898,2732,'problem_icons_2_prob_concerded_text','are highly concerned'),(200899,2732,'_problem_icons_2_prob_concerded_text','field_640fa10181d96'),(200900,2732,'problem_icons_2_prob_issue_text',''),(200901,2732,'_problem_icons_2_prob_issue_text','field_640fa11a81d97'),(200902,2732,'problem_icons_3_prob_icon','1699'),(200903,2732,'_problem_icons_3_prob_icon','field_640fa0291d519'),(200904,2732,'problem_icons_3_prob_concerned_stat','64% highly concerned'),(200905,2732,'_problem_icons_3_prob_concerned_stat','field_640fa0dd81d95'),(200906,2732,'problem_icons_3_prob_concerded_text','are highly concerned'),(200907,2732,'_problem_icons_3_prob_concerded_text','field_640fa10181d96'),(200908,2732,'problem_icons_3_prob_issue_text',''),(200909,2732,'_problem_icons_3_prob_issue_text','field_640fa11a81d97'),(200910,2732,'problem_icons_0_prob_concerned_text','House prices have doubled in a decade'),(200911,2732,'_problem_icons_0_prob_concerned_text','field_640fa10181d96'),(200912,2732,'problem_icons_1_prob_concerned_text','The gap between rich and poor is growing'),(200913,2732,'_problem_icons_1_prob_concerned_text','field_640fa10181d96'),(200914,2732,'problem_icons_2_prob_concerned_text','Construction of social housing is down'),(200915,2732,'_problem_icons_2_prob_concerned_text','field_640fa10181d96'),(200916,2732,'problem_icons_3_prob_concerned_text','Banks are making more than ever from housing'),(200917,2732,'_problem_icons_3_prob_concerned_text','field_640fa10181d96'),(200918,2732,'monitor_content','The Australian Housing Monitor is a large, nationally-representative survey covering public experiences and attitudes toward housing related issues. Questions range from how well the respondent is keeping up with their mortgage/rent, to what they think about social housing construction.\r\n\r\nA broad range of demographic criteria are included, such as gender, location, age, income, voting preference, educational level, tenure type, and employment status. These variables allow CEH researchers to understand the trends and diversity of opinion around the country.\r\n\r\nIt also incorporates questions from previous surveys to track trends over time.\r\nThe inaugural poll was conducted by Essential in December 2022, and was completed by 4,735 people.'),(200919,2732,'_monitor_content','field_640fcc4014404'),(200920,2732,'problem_head','Housing in Australia is not working, and Australians are concerned.'),(200921,2732,'_problem_head','field_641935436aded'),(200922,2732,'problem_signoff','Explore the research showing how concerned Australians are our about the housing situation.'),(200923,2732,'_problem_signoff','field_641935626adee'),(200924,2732,'sections','a:2:{i:0;s:4:\"hero\";i:1;s:9:\"news_grid\";}'),(200925,2732,'_sections','field_5dafb40b8143a'),(200926,2732,'sections_0_is_full_height','1'),(200927,2732,'_sections_0_is_full_height','field_61d6f6fd5a37e'),(200928,2732,'sections_0_image','1648'),(200929,2732,'_sections_0_image','field_61d6f6d45a37d'),(200930,2732,'sections_0_heading','Heading'),(200931,2732,'_sections_0_heading','field_61d6f69e5a379'),(200932,2732,'sections_0_subtitle','Ya ya '),(200933,2732,'_sections_0_subtitle','field_61d6f6ac5a37a'),(200934,2732,'sections_0_link_one',''),(200935,2732,'_sections_0_link_one','field_61d6f6b55a37b'),(200936,2732,'sections_0_link_two',''),(200937,2732,'_sections_0_link_two','field_61d6f6c35a37c'),(200938,2732,'sections_1_select_categories','a:1:{i:0;s:2:\"27\";}'),(200939,2732,'_sections_1_select_categories','field_637f04483b63b'),(200940,2732,'intro_head_major','Welcome to the Disability Dialogue'),(200941,2732,'_intro_head_major','field_64e828783ad9f'),(200942,2732,'intro_head_minor',''),(200943,2732,'_intro_head_minor','field_64e8288c3ada0'),(200944,2732,'intro_icons_0_int_icon','1922'),(200945,2732,'_intro_icons_0_int_icon','field_64e828b33ada2'),(200946,2732,'intro_icons_0_int_icon_text','At 1,727,000 square kilometres, we’re 2.5 times the size of Texas. <span>Yeeha!</span>'),(200947,2732,'_intro_icons_0_int_icon_text','field_64e828e33ada3'),(200948,2732,'intro_icons_1_int_icon','1920'),(200949,2732,'_intro_icons_1_int_icon','field_64e828b33ada2'),(200950,2732,'intro_icons_1_int_icon_text','We have twice as many species of native plant and animal as any other Australian state or territory.'),(200951,2732,'_intro_icons_1_int_icon_text','field_64e828e33ada3'),(200952,2732,'intro_icons_2_int_icon','1921'),(200953,2732,'_intro_icons_2_int_icon','field_64e828b33ada2'),(200954,2732,'intro_icons_2_int_icon_text','We have less land classified as ‘protected’ than any other state or territory.'),(200955,2732,'_intro_icons_2_int_icon_text','field_64e828e33ada3'),(200956,2732,'intro_icons','3'),(200957,2732,'_intro_icons','field_64e828963ada1'),(200958,2732,'threat_head_major','What we stand to lose if we don’t act soon to protect beautiful Queensland:'),(200959,2732,'_threat_head_major','field_64ec258d9dbd1'),(200960,2732,'threats_icons','3'),(200961,2732,'_threats_icons','field_64ec2551a93f9'),(200962,2732,'threats_icons_0_thr_icon','1819'),(200963,2732,'_threats_icons_0_thr_icon','field_64ec2551a93fa'),(200964,2732,'threats_icons_0_thr_icon_text','The rich cultural h