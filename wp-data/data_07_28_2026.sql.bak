first_image_title','field_5b67ca606afc4'),(183363,2685,'first_image_cont','from 0-24 years living with disabilities and their familes'),(183364,2685,'_first_image_cont','field_5b67caff6afc5'),(183365,2685,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(183366,2685,'_first_image_button','field_5b67cb0d6afc6'),(183367,2685,'second _image_title','Lifestart is about supporting young children'),(183368,2685,'_second _image_title','field_5b67cb20ddf9a'),(183369,2685,'second_image_cont','from 0-24 years living with disabilities and their familes'),(183370,2685,'_second_image_cont','field_5b67cb24ddf9b'),(183371,2685,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(183372,2685,'_second_image_button','field_5b67cb29ddf9c'),(183373,2685,'second_image_title','Lifestart is about supporting young children'),(183374,2685,'_second_image_title','field_5b67cb20ddf9a'),(183375,2685,'page_col_image','412'),(183376,2685,'_page_col_image','field_5de6546e7c63a'),(183377,2685,'page_col_image_3','437'),(183378,2685,'_page_col_image_3','field_5de6e3998e07e'),(183379,2685,'sec_2_title','Community'),(183380,2685,'_sec_2_title','field_5de6e3ef2798f'),(183381,2685,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(183382,2685,'_sec_2_text','field_5de78dc89e613'),(183383,2685,'sec_3_title','The Project'),(183384,2685,'_sec_3_title','field_5de6e3d37d8da'),(183385,2685,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(183386,2685,'_sec_3_text','field_5de6e4044e5e8'),(183387,2685,'page_col_image_2','436')