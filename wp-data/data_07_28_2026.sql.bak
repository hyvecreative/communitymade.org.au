t_right_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut.'),(199603,2729,'_support_right_cont','field_5b67c6c98c065'),(199604,2729,'support_right_button','<a class=\"btn btn-blue\" href=\"#\">Read more</a>'),(199605,2729,'_support_right_button','field_5b67c6dd8c066'),(199606,2729,'first_image_title','Lifestart is about supporting young children'),(199607,2729,'_first_image_title','field_5b67ca606afc4'),(199608,2729,'first_image_cont','from 0-24 years living with disabilities and their familes'),(199609,2729,'_first_image_cont','field_5b67caff6afc5'),(199610,2729,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(199611,2729,'_first_image_button','field_5b67cb0d6afc6'),(199612,2729,'second _image_title','Lifestart is about supporting young children'),(199613,2729,'_second _image_title','field_5b67cb20ddf9a'),(199614,2729,'second_image_cont','from 0-24 years living with disabilities and their familes'),(199615,2729,'_second_image_cont','field_5b67cb24ddf9b'),(199616,2729,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(199617,2729,'_second_image_button','field_5b67cb29ddf9c'),(199618,2729,'second_image_title','Lifestart is about supporting young children'),(199619,2729,'_second_image_title','field_5b67cb20ddf9a'),(199620,2729,'page_col_image','412'),(199621,2729,'_page_col_image','field_5de6546e7c63a'),(199622,2729,'page_col_image_3','437'),(199623,2729,'_page_col_image_3','field_5de6e3998e07e'),(199624,2729,'sec_2_title','Community'),(199625,2729,'_sec_2_title','field_5de6e3ef2798f'),(199626,2729,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(199627,2729,'_sec_2_text','field_5de78dc89e613'),(199628,2729,'sec_3_title','The Project'),(199629,2729,'_sec_3_title','field_5de6e3d37d8da'),(199630,2729,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(199631,2729,'_sec_3_text','field_5de6e4044e5e8'),(199632,2729,'page_col_image_2','436'),(199633,2729,'_page_col_image_2','field_5de6546e7c63a'),(199634,2729,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(199635,2729,'_sec_2_button','field_5de6e58c86706'),(199636,2729,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(199637,2729,'_sec_3_button','field_5de6e5a243c03'),(199638,2729,'page_col_image_4','455'),(199639,2729,'_page_col_image_4','field_5de70801090ce'),(199640,2729,'sec_4_title','Location'),(199641,2729,'_sec_4_title','field_5de7082a12a81'),(199642,2729,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(199643,2729,'_sec_4_text','field_5de7084812a82'),(199644,2729,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(199645,2729,'_sec_4_button','field_5de7085e12a83'),(199646,2729,'news_title','Project updates'),(199647,2729,'_news_title','field_5de78da3aabb9'),(199648,2729,'sec_2_text_copy',''),(199649,2729,'_sec_2_text_copy','field_5de78dc89e613'),(199650,2729,'timeline-title','Timeline'),(199651,2729,'_timeline-title','field_5de78df29e615'),(199652,2729,'timeline_title','Timeline'),(199653,2729,'_tim