92283,1942,'_survey_index_6_survey_url','field_6294564e42239'),(92284,1942,'survey_index_6_survey_url_text','View Results'),(92285,1942,'_survey_index_6_survey_url_text','field_629456584223a'),(92286,1942,'survey_index_7_survey_icon','1493'),(92287,1942,'_survey_index_7_survey_icon','field_6294562942237'),(92288,1942,'survey_index_7_survey_title','Going Off-grid'),(92289,1942,'_survey_index_7_survey_title','field_6294564042238'),(92290,1942,'survey_index_7_survey_url','#'),(92291,1942,'_survey_index_7_survey_url','field_6294564e42239'),(92292,1942,'survey_index_7_survey_url_text','View Results'),(92293,1942,'_survey_index_7_survey_url_text','field_629456584223a'),(92294,1942,'survey_index','8'),(92295,1942,'_survey_index','field_6294561242236'),(92296,1942,'report_title','Download the report'),(92297,1942,'_report_title','field_62f30edfb57e1'),(92298,1942,'report_intro','Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus massa erat, consectetur at semper at, feugiat vel orci. '),(92299,1942,'_report_intro','field_62f30eedb57e2'),(92300,1942,'report_link_url','#'),(92301,1942,'_report_link_url','field_62f30ef4b57e3'),(92302,1942,'report_link_text','Download'),(92303,1942,'_report_link_text','field_62f30f01b57e4'),(92304,1942,'solutions_content','The housing system is complex, and no one solution will solve the complex problems we now face but there are some critical first steps to be taken now.\r\n<ul>\r\n 	<li>Set out an ambitious national housing agreement between commonwealth and state governments with targets and funding for the construction of affordable homes.</li>\r\n 	<li>Phase out tax breaks for property investors and using the increase in revenue to build more public housing.</li>\r\n 	<li>Establish laws which limit rental increases beyond what is fair.</li>\r\n 	<li>Rebalance tenancy laws to provide renters with more security and control, such as eliminating no grounds evictions.</li>\r\n 	<li>Phase out stamp duty and replace it with a broad-based land tax.</li>\r\n</ul>\r\n<h4>While there are many opinions on what policy changes will fix the housing market, doing nothing is not an option.</h4>'),(92305,1942,'_solutions_content','field_640e8b307a958'),(92306,1942,'problem_icons_0_prob_icon','1699'),(92307,1942,'_problem_icons_0_prob_icon','field_640fa0291d519'),(92308,1942,'problem_icons_0_prob_concerned_stat','70% highly concerned'),(92309,1942,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(92310,1942,'problem_icons_0_prob_concerded_text','are highly concerned'),(92311,1942,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(92312,1942,'problem_icons_0_prob_issue_text',''),(92313,1942,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(92314,1942,'problem_icons','4'),(92315,1942,'_problem_icons','field_640fa0191d518'),(92316,1942,'ceh_content_left',''),(92317,1942,'_ceh_content_left','field_640e97e8f1c8c'),(92318,1942,'ceh_content_right',''),(92319,1942,'_ceh_content_right','field_640e97fdf1c8d'),(92320,1942,'pc_content_left',''),(92321,1942,'_pc_content_left','field_640e983bf1c8f'),(92322,1942,'pc_content_right',''),(92323,1942,'_pc_content_right','field_640e984df1c90'),(92324,1942,'problem_icons_1_prob_icon','1699'),(92325,1942,'_problem_icons_1_prob_icon','field_640fa0291d519'),(92326,1942,'problem_icons_1_prob_concerned_stat','69% highly concerned'),(92327,1942,'_problem_icons_1_prob_concerned_stat','field_640fa0dd81d95'),(92328,1942,'problem_icons_1_prob_concerded_text','are highly concerned'),(92329,1942,'_problem_icons_1_prob_concerded_text','field_640fa10181d96'),(92330,1942,'problem_icons_1_prob_issue_text',''),(92331,1942,'_problem_icons_1_prob_issue_text','field_640fa11a81d97'),(92332,1942,'problem_icons_2_prob_icon','1699'),(92333,1942,'_problem_icons_2_prob_icon','field_640fa0291d519'),(92334,1942,'problem_icons_2_prob_concerned_stat','64% highly concerned'),(92335,1942,'_problem_icons_2_prob_concerned_stat','field_640fa0dd81d95'),(92336,1942,'problem_icons_2_prob_concerded_text','are highly concerned'),(92337,1942,'_problem_icons_2_prob_concerded_text','field_640fa10181d96'),(92338,1942,'problem_icons_2_prob_issue_text',''),(92339,1942,'_problem_icons_2_prob_issue_text','field_640fa11a81d97'),(92340,1942,'problem_icons_3_prob_icon','1699'),(92341,1942,'_problem_icons_3_prob_icon','field_640fa0291d519'),(92342,1942,'problem_icons_3_prob_concerned_stat','64% highly concerned'),(92343,1942,'_problem_icons_3_prob_concerned_stat','field_640fa0dd81d95'),(92344,1942,'problem_icons_3_prob_concerded_text','are highly concerned'),(92345,1942,'_problem_icons_3_prob_concerded_text','field_640fa10181d96'),(92346,1942,'problem_icons_3_prob_issue_text',''),(92347,1942,'_problem_icons_3_prob_issue_text','field_640fa11a81d97'),(92348,1942,'problem_icons_0_prob_concerned_text','House prices have doubled in a decade'),(92349,1942,'_problem_icons_0_prob_concerned_text','field_640fa10181d96'),(92350,1942,'problem_icons_1_prob_concerned_text','The gap between rich and poor is growing'),(92351,1942,'_problem_icons_1_prob_concerned_text','field_640fa10181d96'),(92352,1942,'problem_icons_2_prob_concerned_text','Construction of social housing is down'),(92353,1942,'_problem_icons_2_prob_concerned_text','field_640fa10181d96'),(92354,1942,'problem_icons_3_prob_concerned_text','Banks are making more than ever from housing'),(92355,1942,'_problem_icons_3_prob_concerned_text','field_640fa10181d96'),(92356,1942,'monitor_content','The Australian Housing Monitor is a large, nationally-representative survey covering public experiences and attitudes toward housing related issues. Questions range from how well the respondent is keeping up with their mortgage/rent, to what they think about social housing construction.\r\n\r\nA broad range of demographic criteria are included, such as gender, location, age, income, voting preference, educational level, tenure type, and employment status. These variables allow CEH researchers to understand the trends and diversity of opinion around the country.\r\n\r\nIt also incorporates questions from previous surveys to track trends over time.\r\nThe inaugural poll was conducted by Essential in December 2022, and was completed by 4,735 people.'),(92357,1942,'_monitor_content','field_640fcc4014404'),(92358,1942,'problem_head','Housing in Australia is not working, and Australians are concerned.'),(92359,1942,'_problem_head','field_641935436aded'),(92360,1942,'problem_signoff','Explore the research showing how concerned Australians are our about the housing situation.'),(92361,1942,'_problem_signoff','field_641935626adee'),(92362,1942,'sections','a:2:{i:0;s:4:\"hero\";i:1;s:9:\"news_grid\";}'),(92363,1942,'_sections','field_5dafb40b8143a'),(92364,1942,'sections_0_is_full_height','1'),(92365,1942,'_sections_0_is_full_height','field_61d6f6fd5a37e'),(92366,1942,'sections_0_image','1648'),(92367,1942,'_sections_0_image','field_61d6f6d45a37d'),(92368,1942,'sections_0_heading','Heading'),(92369,1942,'_sections_0_heading','field_61d6f69e5a379'),(92370,1942,'sections_0_subtitle','Ya ya '),(92371,1942,'_sections_0_subtitle','field_61d6f6ac5a37a'),(92372,1942,'sections_0_link_one',''),(92373,1942,'_sections_0_link_one','field_61d6f6b55a37b'),(92374,1942,'sections_0_link_two',''),(92375,1942,'_sections_0_link_two','field_61d6f6c35a37c'),(92376,1942,'sections_1_select_categories','a:1:{i:0;s:2:\"27\";}'),(92377,1942,'_sections_1_select_categories','field_637f04483b63b'),(92378,1942,'intro_head_major','Super Consumers Australia is <span>fighting</span> to ensure that the superannuation industry is <span>held accountable</span> for the outcomes they deliver to Australian consumers.'),(92379,1942,'_intro_head_major','field_64e828783ad9f'),(92380,1942,'intro_head_minor','We want super to work for everyone—not just super fund companies. With our research, journalism and campaigns we are creating the trustworthy and transparent superannuation system we all deserve.'),(92381,1942,'_intro_head_minor','field_64e8288c3ada0'),(92382,1942,'intro_icons_0_int_icon','1922'),(92383,1942,'_intro_icons_0_int_icon','field_64e828b33ada2'),(92384,1942,'intro_icons_0_int_icon_text','At 1,727,000 square kilometres, we’re 2.5 times the size of Texas. <span>Yeeha!</span>'),(92385,1942,'_intro_icons_0_int_icon_text','field_64e828e33ada3'),(92386,1942,'intro_icons_1_int_icon','1920'),(92387,1942,'_intro_icons_1_int_icon','field_64e828b33ada2'),(92388,1942,'intro_icons_1_int_icon_text','We have twice as many species of native plant and animal as any other Australian state or territory.'),(92389,1942,'_intro_icons_1_int_icon_text','field_64e828e33ada3'),(92390,1942,'intro_icons_2_int_icon','1921'),(92391,1942,'_intro_icons_2_int_icon','field_64e828b33ada2'),(92392,1942,'intro_icons_2_int_icon_text','We have less land classified as ‘protected’ than any other state or territory.'),(92393,1942,'_intro_icons_2_int_icon_text','field_64e828e33ada3'),(92394,1942,'intro_icons','3'),(92395,1942,'_intro_icons','field_64e828963ada1'),(92396,1942,'threat_head_major','What we stand to lose if we don’t act soon to protect beautiful Queensland:'),(92397,1942,'_threat_head_major','field_64ec258d9dbd1'),(92398,1942,'threats_icons','3'),(92399,1942,'_threats_icons','field_64ec2551a93f9'),(92400,1942,'threats_icons_0_thr_icon','1819'),(92401,1942,'_threats_icons_0_thr_icon','field_64ec2551a93fa'),(92402,1942,'threats_icons_0_thr_icon_text','The rich cultural heritage of our First Nations people and their continuous ties to country, dating back more than 50,000 years.'),(92403,1942,'_threats_icons_0_thr_icon_text','field_64ec2551a93fb'),(92404,1942,'threats_icons_1_thr_icon','1819'),(92405,1942,'_threats_icons_1_thr_icon','field_64ec2551a93fa'),(92406,1942,'threats_icons_1_thr_icon_text','Thousands of species of plant and animal which are now classified as threatened or endangered in Queensland.'),(92407,1942,'_threats_icons_1_thr_icon_text','field_64ec2551a93fb'),(92408,1942,'threats_icons_2_thr_icon