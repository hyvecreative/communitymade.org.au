";s:0:\"\";s:7:\"prepend\";s:0:\"\";s:6:\"append\";s:0:\"\";}','Video Intro','video_intro','publish','closed','closed','','field_6a606161b34b6','','','2026-07-23 05:21:22','2026-07-23 05:21:22','',2631,'http://localhost/?post_type=acf-field&#038;p=2737',26,'acf-field','',0),(2738,1,'2026-07-22 06:22:36','2026-07-22 06:22:36','<!-- wp:embed {\"url\":\"https://www.youtube.com/watch?v=pE5IoC1H-KM\",\"type\":\"video\",\"providerNameSlug\":\"youtube\",\"responsive\":true,\"className\":\"wp-embed-aspect-16-9 wp-has-aspect-ratio\"} -->\n<figure class=\"wp-block-embed is-type-video is-provider-youtube wp-block-embed-youtube wp-embed-aspect-16-9 wp-has-aspect-ratio\"><div class=\"wp-block-embed__wrapper\">\nhttps://www.youtube.com/watch?v=pE5IoC1H-KM\n</div></figure>\n<!-- /wp:embed -->','Home temp','','inherit','closed','closed','','2263-revision-v1','','','2026-07-22 06:22:36','2026-07-22 06:22:36','',2263,'http://localhost/?p=2738',0,'revision','',0),(2739,1,'2026-07-22 06:25:51','2026-07-22 06:25:51','<!-- wp:embed {\"url\":\"https://www.youtube.com/watch?v=pE5IoC1H-KM\",\"type\":\"video\",\"providerNameSlug\":\"youtube\",\"responsive\":true,\"className\":\"wp-embed-aspect-16-9 wp-has-aspect-ratio\"} -->\n<figure class=\"wp-block-embed is-type-video is-provider-youtube wp-block-embed-youtube wp-embed-aspect-16-9 wp-has-aspect-ratio\"><div class=\"wp-block-embed__wrapper\">\nhttps://www.youtube.com/watch?v=pE5IoC1H-KM\n</div></figure>\n<!-- /wp:embed -->','Home temp','','inherit','closed','closed','','2263-revision-v1','','','2026-07-22 06:25:51','2026-07-22 06:25:51','',2263,'http://localhost/?p=2739',0,'revision','',0),(2740,1,'2026-07-22 06:35:39','2026-07-22 06:35:39','<!-- wp:embed {\"url\":\"https://www.youtube.com/watch?v=pE5IoC1H-KM\",\"type\":\"video\",\"providerNameSlug\":\"youtube\",\"responsive\":true,\"className\":\"wp-embed-aspect-16-9 wp-has-aspect-ratio\"} -->\n<figure class=\"wp-block-embed is-type-video is-provider-youtube wp-block-embed-youtube wp-embed-aspect-16-9 wp-has-aspect-ratio\"><div class=\"wp-block-embed__wrapper\">\nhttps://www.youtube.com/watch?v=pE5IoC1H-KM\n</div></figure>\n<!-- /wp:embed -->','Home temp','','inherit','closed','closed','','2263-revision-v1','','','2026-07-22 06:35:39','2026-07-22 06:35:39','',2263,'http://localhost/?p=2740',0,'revision','',0),(2741,1,'2026-07-22 07:08:38','2026-07-22 07:08:38','<!-- wp:heading -->\n<h2 class=\"wp-block-heading\">The Campaign</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Community Made is a campaign celebrating the people who live in community housing<strong>.</strong>&nbsp; residents, providers and experts across NSW to call for urgent action.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>Right now, housing affordability is the issue keeping people across NSW up at night. Rents and cost-of-living pressures keep climbing, social housing waitlists are at record highs, and home ownership is out of reach for a growing number of households.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>The pressure is real, and it’s growing. But a clear solution is already here – and it’s working.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p></p>\n<!-- /wp:paragraph -->','Who we are','','inherit','closed','closed','','19-revision-v1','','','2026-07-22 07:08:38','2026-07-22 07:08:38','',19,'http://localhost/?p=2741',0,'revision','',0),(2742,1,'2026-07-22 07:08:50','2026-07-22 07:08:50','<!-- wp:heading -->\n<h2 class=\"wp-block-heading\">The Campaign</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Community Made is a campaign celebrating the people who live in community housing<strong>.</strong>&nbsp; residents, providers and experts across NSW to call for urgent action.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>Right now, housing affordability is the issue keeping people across NSW up at night. Rents and cost-of-living pressures keep climbing, social housing waitlists are at record highs, and home ownership is out of reach for a growing number of households.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p><strong>The pressure is real, and it’s growing. But a clear solution is already here – and it’s working.</strong></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p></p>\n<!-- /wp:paragraph -->','Who we are','','inherit','closed','closed','','19-revision-v1','','','2026-07-22 07:08:50','2026-07-22 07:08:50','',19,'http://localhost/?p=2742',0,'revision','',0),(2743,1,'2026-07-22 07:12:18','2026-07-22 07:12:18','<!-- wp:heading -->\n<h2 class=\"wp-block-heading\">The Campaign</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Community Made is a campaign celebrating the people who live in community housing<strong>.</strong>&nbsp; residents, providers and experts across NSW to call for urgent action.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>Right now, housing affordability is the issue keeping people across NSW up at night. Rents and cost-of-living pressures keep climbing, social housing waitlists are at record highs, and home ownership is out of reach for a growing number of households.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p><strong>The pressure is real, and it’s growing. But a clear solution is already here – and it’s working.</strong></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>Across NSW, not-for-profit community housing providers are building and managing social and affordable rental homes that are here for the long term. The model works. What’s missing is the scale of investment to match the need.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>With the State election ahead, there’s a clear window of opportunity to change that. This is the moment to put community housing at the heart of the election.</p>\n<!-- /wp:paragraph -->','Who we are','','inherit','closed','closed','','19-revision-v1','','','2026-07-22 07:12:18','2026-07-22 07:12:18','',19,'http://localhost/?p=2743',0,'revision','',0),(2744,1,'2026-07-22 07:13:59','2026-07-22 07:13:59','<!-- wp:paragraph -->\n<p>Community housing works. We’re calling on the next NSW Government to take urgent action on housing by:</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:list -->\n<ul class=\"wp-block-list\"><!-- wp:list-item -->\n<li>Investing in a $26 billion Community Housing Enabling Fund to deliver <strong>50,000 community homes by 2050</strong></li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Creating a $4 billion Better Social Homes Program <strong>to bring all social housing up to a modern standard by 2040</strong></li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Establishing an indexed Housed and Healthy Fund of at least $200 million per annum, <strong>so more social housing residents can access critical support services</strong></li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list -->\n\n<!-- wp:paragraph -->\n<p></p>\n<!-- /wp:paragraph -->','Our Housing Blueprint','','publish','closed','closed','','our-housing-blueprint','','','2026-07-22 07:14:53','2026-07-22 07:14:53','',0,'http://localhost/?page_id=2744',0,'page','',0),(2745,1,'2026-07-22 07:13:59','2026-07-22 07:13:59','<!-- wp:paragraph -->\n<p>Community housing works. We’re calling on the next NSW Government to take urgent action on housing by:</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>To meet need – we’re asking for the next NSW Government to: s:</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:list -->\n<ul class=\"wp-block-list\"><!-- wp:list-item -->\n<li>Investing in a $26 billion Community Housing Enabling Fund to deliver <strong>50,000 community homes by 2050</strong></li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Creating a $4 billion Better Social Homes Program <strong>to bring all social housing up to a modern standard by 2040</strong></li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Establishing an indexed Housed and Healthy Fund of at least $200 million per annum, <strong>so more social housing residents can access critical support services</strong></li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list -->\n\n<!-- wp:paragraph -->\n<p></p>\n<!-- /wp:paragraph -->','Our Housing Blueprint','','inherit','closed','closed','','2744-revision-v1','','','2026-07-22 07:13:59','2026-07-22 07:13:59','',2744,'http://localhost/?p=2745',0,'revision','',0),(2746,1,'2026-07-22 07:14:02','2026-07-22 07:14:02','{\"0\":\"skiplinks\",\"1\":[\"control-titles\",\"2\"],\"2\":[\"link-targets\",\"9\"],\"3\":[\"control-tabindex\",\"5\"],\"timestamp\":1784704442}','/our-housing-blueprint/','','publish','closed','closed','','our-housing-blueprint','','','2026-07-22 07:14:02','2026-07-22 07:14:02','',0,'http://localhost/wpa-stats/our-housing-blueprint/',0,'wpa-stats','',0),(2747,1,'2026-07-22 07:14:22','2026-07-22 07:14:22','<!-- wp:paragraph -->\n<p>Community housing works. We’re calling on the next NSW Government to take urgent action on housing by:</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>To meet need – we’re asking for the next NSW Government to:</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:list -->\n<ul class=\"wp-block-list\"><!-- wp:list-item -->\n<li>Investing in a $26 billion Community Housing Enabling Fund to deliver <strong>50,000 community homes by 2050</strong></li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Creating a $4 billion Better Social Homes Program <strong>to bring all social housing up to a modern standard by 2040</strong></li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Establishing an indexed Housed and Healthy Fund of at least $200 million per annum, <strong>so more social housing residents can access critical support services</strong></li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list -->\n\n<!-- wp:paragraph -->\n<p></p>\n<!-- /wp:paragraph -->','Our Housing Blueprint','','inherit','closed','closed','','2744-revision-v1','','','2026-07-22 07:14:22','2026-07-22 07:14:22','',2744,'http://localhost/?p=2747',0,'revision','',0),(2748,1,'2026-07-22 07:14:37','2026-07-22 07:14:37','<!-- wp:paragraph -->\n<p>Community housing works. We’re calling on the next NSW Government to take urgent action on housing by:</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:list -->\n<ul class=\"wp-block-list\"><!-- wp:list-item -->\n<li>Investing in a $26 billion Community Housing Enabling Fund to deliver <strong>50,000 community homes by 2050</strong></li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Creating a $4 billion Better Social Homes Program <strong>to bring all social housing up to a modern standard by 2040</strong></li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Establishing an indexed Housed and Healthy Fund of at least $200 million per annum, <strong>so more social housing residents can access critical support services</strong></li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list -->\n\n<!-- wp:paragraph -->\n<p></p>\n<!-- /wp:paragraph -->','Our Housing Blueprint','','inherit','closed','closed','','2744-revision-v1','','','2026-07-22 07:14:37','2026-07-22 07:14:37','',2744,'http://localhost/?p=2748',0,'revision','',0),(2749,1,'2026-07-22 07:16:38','2026-07-22 07:16:38','<!-- wp:paragraph -->\n<p>Community housing has been part of NSW’s housing system for more than 40 years. We’re not-for-profit organisations that build and manage high-quality homes and resilient communities so that more people and families can thrive.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:list -->\n<ul class=\"wp-block-list\"><!-- wp:list-item -->\n<li>141 Community Housing Providers in NSW</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>67,000+ rental homes owned or managed</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>8,800 new homes built since 2012</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>$3.2 billion  invested in new homes since 2012</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>81% of community housing residents satisfied with their home</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list -->\n\n<!-- wp:paragraph -->\n<p>We build and retain homes for the long-term, so we can make a difference for generations to come.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>Community housing. That’s what we’ve always done – and that’s what we’ll always do.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p></p>\n<!-- /wp:paragraph -->','Who we are','','publish','closed','closed','','who-we-are','','','2026-07-22 07:17:02','2026-07-22 07:17:02','',0,'http://localhost/?page_id=2749',0,'page','',0),(2750,1,'2026-07-22 07:15:50','2026-07-22 07:15:50','<!-- wp:heading -->\n<h2 class=\"wp-block-heading\">The Campaign</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Community Made is a campaign celebrating the people who live in community housing<strong>.</strong>&nbsp; residents, providers and experts across NSW to call for urgent action.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>Right now, housing affordability is the issue keeping people across NSW up at night. Rents and cost-of-living pressures keep climbing, social housing waitlists are at record highs, and home ownership is out of reach for a growing number of households.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p><strong>The pressure is real, and it’s growing. But a clear solution is already here – and it’s working.</strong></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>Across NSW, not-for-profit community housing providers are building and managing social and affordable rental homes that are here for the long term. The model works. What’s missing is the scale of investment to match the need.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>With the State election ahead, there’s a clear window of opportunity to change that. This is the moment to put community housing at the heart of the election.</p>\n<!-- /wp:paragraph -->','About us','','inherit','closed','closed','','19-revision-v1','','','2026-07-22 07:15:50','2026-07-22 07:15:50','',19,'http://localhost/?p=2750',0,'revision','',0),(2751,1,'2026-07-22 07:16:38','2026-07-22 07:16:38','<!-- wp:heading -->\n<h2 class=\"wp-block-heading\">The Campaign</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Community Made is a campaign celebrating the people who live in community housing<strong>.</strong>&nbsp; residents, providers and experts across NSW to call for urgent action.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>Right now, housing affordability is the issue keeping people across NSW up at night. Rents and cost-of-living pressures keep climbing, social housing waitlists are at record highs, and home ownership is out of reach for a growing number of households.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p><strong>The pressure is real, and it’s growing. But a clear solution is already here – and it’s working.</strong></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>Across NSW, not-for-profit community housing providers are building and managing social and affordable rental homes that are here for the long term. The model works. What’s missing is the scale of investment to match the need.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>With the State election ahead, there’s a clear window of opportunity to change that. This is the moment to put community housing at the heart of the election.</p>\n<!-- /wp:paragraph -->','Who we are','','inherit','closed','closed','','2749-revision-v1','','','2026-07-22 07:16:38','2026-07-22 07:16:38','',2749,'http://localhost/?p=2751',0,'revision','',0),(2752,1,'2026-07-22 07:16:49','2026-07-22 07:16:49','<!-- wp:heading -->\n<h2 class=\"wp-block-heading\">The Campaign</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Community housing has been part of NSW’s housing system for more than 40 years. We’re not-for-profit organisations that build and manage high-quality homes and resilient communities so that more people and families can thrive.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:list -->\n<ul class=\"wp-block-list\"><!-- wp:list-item -->\n<li>141 Community Housing Providers in NSW</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>67,000+ rental homes owned or managed</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>8,800 new homes built since 2012</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>$3.2 billion  invested in new homes since 2012</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>81% of community housing residents satisfied with their home</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list -->\n\n<!-- wp:paragraph -->\n<p>We build and retain homes for the long-term, so we can make a difference for generations to come.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>Community housing. That’s what we’ve always done – and that’s what we’ll always do.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p></p>\n<!-- /wp:paragraph -->','Who we are','','inherit','closed','closed','','2749-revision-v1','','','2026-07-22 07:16:49','2026-07-22 07:16:49','',2749,'http://localhost/?p=2752',0,'revision','',0),(2753,1,'2026-07-22 07:17:02','2026-07-22 07:17:02','<!-- wp:paragraph -->\n<p>Community housing has been part of NSW’s housing system for more than 40 years. We’re not-for-profit organisations that build and manage high-quality homes and resilient communities so that more people and families can thrive.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:list -->\n<ul class=\"wp-block-list\"><!-- wp:list-item -->\n<li>141 Community Housing Providers in NSW</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>67,000+ rental homes owned or managed</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>8,800 new homes built since 2012</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>$3.2 billion  invested in new homes since 2012</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>81% of community housing residents satisfied with their home</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list -->\n\n<!-- wp:paragraph -->\n<p>We build and retain homes for the long-term, so we can make a difference for generations to come.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>Community housing. That’s what we’ve always done – and that’s what we’ll always do.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p></p>\n<!-- /wp:paragraph -->','Who we are','','inherit','closed','closed','','2749-revision-v1','','','2026-07-22 07:17:02','2026-07-22 07:17:02','',2749,'http://localhost/?p=2753',0,'revision','',0),(2754,1,'2026-07-22 07:49:26','2026-07-22 07:17:51',' ','','','publish','closed','closed','','2754','','','2026-07-22 07:49:26','2026-07-22 07:49:26','',0,'http://localhost/?p=2754',2,'nav_menu_item','',0),(2755,1,'2026-07-22 07:49:26','2026-07-22 07:18:13',' ','','','publish','closed','closed','','2755','','','2026-07-22 07:49:26','2026-07-22 07:49:26','',0,'http://localhost/?p=2755',4,'nav_menu_item','',0),(2756,1,'2026-07-22 07:48:18','2026-07-22 07:22:02',' ','','','publish','closed','closed','','2756','','','2026-07-22 07:48:18','2026-07-22 07:48:18','',0,'http://localhost/?p=2756',1,'nav_menu_item','',0),(2757,1,'2026-07-22 07:48:18','2026-07-22 07:22:02',' ','','','publish','closed','closed','','2757','','','2026-07-22 07:48:18','2026-07-22 07:48:18','',0,'http://localhost/?p=2757',4,'nav_menu_item','',0),(2758,1,'2026-07-22 07:48:18','2026-07-22 07:22:02',' ','','','publish','closed','closed','','2758','','','2026-07-22 07:48:18','2026-07-22 07:48:18','',0,'http://localhost/?p=2758',3,'nav_menu_item','',0),(2759,1,'2026-07-22 07:48:18','2026-07-22 07:22:02',' ','','','publish','closed','closed','','2759','','','2026-07-22 07:48:18','2026-07-22 07:48:18','',0,'http://localhost/?p=2759',2,'nav_menu_item','',0),(2760,1,'2026-07-22 07:22:13','2026-07-22 07:22:13','{\"0\":\"skiplinks\",\"1\":[\"control-titles\",\"2\"],\"2\":[\"link-targets\",\"9\"],\"3\":[\"control-tabindex\",\"5\"],\"timestamp\":1