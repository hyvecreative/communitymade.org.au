age','412'),(22078,1103,'_page_col_image','field_5de6546e7c63a'),(22079,1103,'page_col_image_3','437'),(22080,1103,'_page_col_image_3','field_5de6e3998e07e'),(22081,1103,'sec_2_title','Community'),(22082,1103,'_sec_2_title','field_5de6e3ef2798f'),(22083,1103,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(22084,1103,'_sec_2_text','field_5de78dc89e613'),(22085,1103,'sec_3_title','The Project'),(22086,1103,'_sec_3_title','field_5de6e3d37d8da'),(22087,1103,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(22088,1103,'_sec_3_text','field_5de6e4044e5e8'),(22089,1103,'page_col_image_2','436'),(22090,1103,'_page_col_image_2','field_5de6546e7c63a'),(22091,1103,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(22092,1103,'_sec_2_button','field_5de6e58c86706'),(22093,1103,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(22094,1103,'_sec_3_button','field_5de6e5a243c03'),(22095,1103,'page_col_image_4','455'),(22096,1103,'_page_col_image_4','field_5de70801090ce'),(22097,1103,'sec_4_title','Location'),(22098,1103,'_sec_4_title','field_5de7082a12a81'),(22099,1103,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(22100,1103,'_sec_4_text','field_5de7084812a82'),(22101,1103,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(22102,1103,'_sec_4_button','field_5de7085e12a83'),(22103,1103,'news_title','Project updates'),(22104,1103,'_news_title','field_5de78da3aabb9'),(22105,1103,'sec_2_text_copy',''),(22106,1103,'_sec_2_text_copy','field_5de78dc89e613'),(22107,1103,'timeline-title','Timeline'),(22108,1103,'_timeline-title','field_5de78df29e615'),(22109,1103,'timeline_title','Timeline'),(22110,1103,'_timeline_title','field_5de78df29e615'),(22111,1103,'contact_title','Contact us'),(22112,1103,'_contact_title','field_5de7981e06057'),(22113,1103,'contact_intro','Contact text...'),(22114,1103,'_contact_intro','field_5de7983506058'),(22115,1103,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(22116,1103,'_news_button','field_5de8329896e02'),(22117,1103,'timeline_intro','Introduction of timeline detail...'),(22118,1103,'_timeline_intro','field_5de98f5fb1781'),(22119,1103,'timeline_pic','477'),(22120,1103,'_timeline_pic','field_5de98f72b1782'),(22121,1103,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(22122,1103,'_timeline_button','field_5de99363677f8'),(22123,1103,'banner_image_position','center'),(22124,1103,'_banner_image_position','field_5f3bc4757dd02'),(22125,1103,'services_title','Our services'),(22126,1103,'_services_title','field_5f20f3cd80eb2'),(22127,1103,'services_items_0_services_item_image','1061'),(22128,1103,'_services_items_0_services_item_image','field_5f2121355be14'),(22129,1103,'services_items_0_sservices_item_title','1300 Telephone counselling line'),(22130,1103,'_services_items_0_sservices_item_title','field_605089efca82e'),(22131,1103,'services_items_0_services_item_text',''),(22132,1103,'_services_items_0_services_item_text','field_5f2121535be15'),(22133,1103,'services_i