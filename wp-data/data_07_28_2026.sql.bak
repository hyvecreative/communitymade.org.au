44,'_signup_head','field_64fd83dc6b0b1'),(131557,2244,'boxes_section_title','Boxes'),(131558,2244,'_boxes_section_title','field_65262bbfd17fc'),(131559,2244,'intro_boxes_0_box_icon','1943'),(131560,2244,'_intro_boxes_0_box_icon','field_65262db5d36ee'),(131561,2244,'intro_boxes_0_box_title','Events'),(131562,2244,'_intro_boxes_0_box_title','field_65262d29ed8e3'),(131563,2244,'intro_boxes_0_box_dropdown','Our rigorous, conflict-free research and data analysis lifts the lid on fund performance, fees and insurance. Drawing on our policy expertise, we turn this analysis into action by using it to back reform and make super easier for people to understand. <a href=\"//localhost:4000:/how/\">More</a> '),(131564,2244,'_intro_boxes_0_box_dropdown','field_65262dead0a0c'),(131565,2244,'intro_boxes_1_box_icon','1941'),(131566,2244,'_intro_boxes_1_box_icon','field_65262db5d36ee'),(131567,2244,'intro_boxes_1_box_title','Projects'),(131568,2244,'_intro_boxes_1_box_title','field_65262d29ed8e3'),(131569,2244,'intro_boxes_1_box_dropdown','Dropdown text'),(131570,2244,'_intro_boxes_1_box_dropdown','field_65262dead0a0c'),(131571,2244,'intro_boxes_2_box_icon','1937'),(131572,2244,'_intro_boxes_2_box_icon','field_65262db5d36ee'),(131573,2244,'intro_boxes_2_box_title','Ideas'),(131574,2244,'_intro_boxes_2_box_title','field_65262d29ed8e3'),(131575,2244,'intro_boxes_2_box_dropdown','Dropdown text'),(131576,2244,'_intro_boxes_2_box_dropdown','field_65262dead0a0c'),(131577,2244,'intro_boxes','3'),(131578,2244,'_intro_boxes','field_65262d14ed8e2'),(131579,2244,'get_help_section_title','Get Help'),(131580,2244,'_get_help_section_title','field_65262c35143de'),(131581,2244,'get_help_block_home',''),(131582,2244,'_get_help_block_home','field_65262c8a143e1'),(131583,2244,'gh_block_home_0_help_image','1956'),(131584,2244,'_gh_block_home_0_help_image','field_65262cd0143e2'),(131585,2244,'gh_block_home_0_help_title','How much do I need to retire? '),(131586,2244,'_gh_block_home_0_help_title','field_65262cec143e3'),(131587,2244,'gh_block_home_0_help_url','#'),(131588,2244,'_gh_block_home_0_help_url','field_65262cf4143e4'),(131589,2244,'gh_block_home_1_help_image','1962'),(131590,2244,'_gh_block_home_1_help_image','field_65262cd0143e2'),(131591,2244,'gh_block_home_1_help_title','I have a problem with  my super fund'),(131592,2244,'_gh_block_home_1_help_title','field_65262cec143e3'),(131593,2244,'gh_block_home_1_help_url','#'),(131594,2244,'_gh_block_home_1_help_url','field_65262cf4143e4'),(131595,2244,'gh_block_home_2_help_image','1961'),(131596,2244,'_gh_block_home_2_help_image','field_65262cd0143e2'),(131597,2244,'gh_block_home_2_help_title','How do I choose the right super? '),(131598,2244,'_gh_block_home_2_help_title','field_65262cec143e3'),(131599,2244,'gh_block_home_2_help_url','#'),(131600,2244,'_gh_block_home_2_help_url','field_65262cf4143e4'),(131601,2244,'gh_block_home','3'),(131602,2244,'_gh_block_home','field_65262c8a143e1'),(131603,2244,'turn_on_insights',''),(131604,2244,'_turn_on_insights','field_645c4a2e654a6'),(131605,2244,'report_questions','a:3:{i:0;s:4:\"1997\";i:1;s:4:\"2067\";i:2;s:4:\"2089\";}'),(131606,2244,'_report_questions','field_6109ed5e02e5a'),(131607,2244,'intro_text','The Disability Dialogue is a place where people with disabilities, their families, organisations providing support, academics, and the wider community come together to work on things that matter to us.\r\n\r\nThe Dialogue is a hub of knowledge and collaboration, separate from government, where we work together to come up. With new ideas on important topics. Our ideas can make a big difference in how services and systems are set up for people with disabilities.'),(131608,2244,'_intro_text','field_66441acfe963c'),(131609,2244,'word_link','#'),(131610,2244,'_word_link','field_6646c69723804'),(131611,2244,'pdf_link','#'),(131612,2244,'_pdf_link','field_6646c6da23805'),(131613,2244,'intro_boxes_0_box_image','2241'),(131614,2244,'_intro_boxes_0_box_image','field_65262db5d36e