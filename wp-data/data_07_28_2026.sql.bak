81d96'),(81566,1914,'problem_icons_3_prob_concerned_text','Banks are making more than ever from housing'),(81567,1914,'_problem_icons_3_prob_concerned_text','field_640fa10181d96'),(81568,1914,'monitor_content','The Australian Housing Monitor is a large, nationally-representative survey covering public experiences and attitudes toward housing related issues. Questions range from how well the respondent is keeping up with their mortgage/rent, to what they think about social housing construction.\r\n\r\nA broad range of demographic criteria are included, such as gender, location, age, income, voting preference, educational level, tenure type, and employment status. These variables allow CEH researchers to understand the trends and diversity of opinion around the country.\r\n\r\nIt also incorporates questions from previous surveys to track trends over time.\r\nThe inaugural poll was conducted by Essential in December 2022, and was completed by 4,735 people.'),(81569,1914,'_monitor_content','field_640fcc4014404'),(81570,1914,'problem_head','Housing in Australia is not working, and Australians are concerned.'),(81571,1914,'_problem_head','field_641935436aded'),(81572,1914,'problem_signoff','Explore the research showing how concerned Australians are our about the housing situation.'),(81573,1914,'_problem_signoff','field_641935626adee'),(81574,1914,'sections','a:2:{i:0;s:4:\"hero\";i:1;s:9:\"news_grid\";}'),(81575,1914,'_sections','field_5dafb40b8143a'),(81576,1914,'sections_0_is_full_height','1'),(81577,1914,'_sections_0_is_full_height','field_61d6f6fd5a37e'),(81578,1914,'sections_0_image','1648'),(81579,1914,'_sections_0_image','field_61d6f6d45a37d'),(81580,1914,'sections_0_heading','Heading'),(81581,1914,'_sections_0_heading','field_61d6f69e5a379'),(81582,1914,'sections_0_subtitle','Ya ya '),(81583,1914,'_sections_0_subtitle','field_61d6f6ac5a37a'),(81584,1914,'sections_0_link_one',''),(81585,1914,'_sections_0_link_one','field_61d6f6b55a37b'),(81586,1914,'sections_0_lin