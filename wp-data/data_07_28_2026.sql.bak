"parent_repeater\";s:19:\"field_6548453ec100e\";}','help url','help_url','publish','closed','closed','','field_65484574c1011','','','2023-11-06 01:53:35','2023-11-06 01:53:35','',1964,'http://localhost/?post_type=acf-field&p=2109',2,'acf-field','',0),(2113,1,'2023-11-06 01:53:35','2023-11-06 01:53:35','a:16:{s:10:\"aria-label\";s:0:\"\";s:4:\"type\";s:5:\"image\";s:12:\"instructions\";s:0:\"\";s:8:\"required\";i:0;s:17:\"conditional_logic\";i:0;s:7:\"wrapper\";a:3:{s:5:\"width\";s:0:\"\";s:5:\"class\";s:0:\"\";s:2:\"id\";s:0:\"\";}s:13:\"return_format\";s:2:\"id\";s:7:\"library\";s:3:\"all\";s:9:\"min_width\";s:0:\"\";s:10:\"min_height\";s:0:\"\";s:8:\"min_size\";s:0:\"\";s:9:\"max_width\";s:0:\"\";s:10:\"max_height\";s:0:\"\";s:8:\"max_size\";s:0:\"\";s:10:\"mime_types\";s:0:\"\";s:12:\"preview_size\";s:6:\"medium\";}','Help image','help_image','publish','closed','closed','','field_654845c2bedd7','','','2023-11-06 02:07:50','2023-11-06 02:07:50','',1964,'http://localhost/?post_type=acf-field&#038;p=2113',0,'acf-field','',0),(2114,1,'2023-11-06 01:53:35','2023-11-06 01:53:35','a:13:{s:10:\"aria-label\";s:0:\"\";s:4:\"type\";s:4:\"text\";s:12:\"instructions\";s:0:\"\";s:8:\"required\";i:0;s:17:\"conditional_logic\";i:0;s:7:\"wrapper\";a:3:{s:5:\"width\";s:0:\"\";s:5:\"class\";s:0:\"\";s:2:\"id\";s:0:\"\";}s:18:\"relevanssi_exclude\";i:0;s:13:\"default_value\";s:0:\"\";s:9:\"maxlength\";s:0:\"\";s:11:\"placeholder\";s:0:\"\";s:7:\"prepend\";s:0:\"\";s:6:\"append\";s:0:\"\";s:15:\"parent_repeater\";s:19:\"field_654845c2bedd6\";}','help title','help_title','publish','closed','closed','','field_654845c2bedd8','','','2023-11-06 01:53:35','2023-11-06 01:53:35','',1964,'http://localhost/?post_type=acf-field&p=2114',1,'acf-field','',0),(2115,1,'2023-11-06 01:53:35','2023-11-06 01:53:35','a:13:{s:10:\"aria-label\";s:0:\"\";s:4:\"type\";s:4:\"text\";s:12:\"instructions\";s:0:\"\";s:8:\"required\";i:0;s:17:\"conditional_logic\";i:0;s:7:\"wrapper\";a:3:{s:5:\"width\";s:0:\"\";s:5:\"class\";s:0:\"\";s:2:\"id\";s:0:\"\";}s:18:\"relevanssi_exclude\";i:0;s:13:\"default_value\";s:0:\"\";s:9:\"maxlength\";s:0:\"\";s:11:\"placeholder\";s:0:\"\";s:7:\"prepend\";s:0:\"\";s:6:\"append\";s:0:\"\";s:15:\"parent_repeater\";s:19:\"field_654845c2bedd6\";}','help url','help_url','publish','closed','closed','','field_654845c2bedd9','','','2023-11-06 01:53:35','2023-11-06 01:53:35','',1964,'http://localhost/?post_type=acf-field&p=2115',2,'acf-field','',0),(2119,1,'2023-11-06 01:53:35','2023-11-06 01:53:35','a:16:{s:10:\"aria-label\";s:0:\"\";s:4:\"type\";s:5:\"image\";s:12:\"instructions\";s:0:\"\";s:8:\"required\";i:0;s:17:\"conditional_logic\";i:0;s:7:\"wrapper\";a:3:{s:5:\"width\";s:0:\"\";s:5:\"class\";s:0:\"\";s:2:\"id\";s:0:\"\";}s:13:\"return_format\";s:2:\"id\";s:7:\"library\";s:3:\"all\";s:9:\"min_width\";s:0:\"\";s:10:\"min_height\";s:0:\"\";s:8:\"min_size\";s:0:\"\";s:9:\"max_width\";s:0:\"\";s:10:\"max_height\";s:0:\"\";s:8:\"max_size\";s:0:\"\";s:10:\"mime_types\";s:0:\"\";s:12:\"preview_size\";s:6:\"medium\";}','Help image','help_image','publish','closed','closed','','field_654845bebedd3','','','2023-11-06 02:08:10','2023-11-06 02:08:10','',1964,'http://localhost/?post_type=acf-field&#038;p=2119',0,'acf-field','',0),(2120,1,'2023-11-06 01:53:35','2023-11-06 01:53:35','a:13:{s:10:\"aria-label\";s:0:\"\";s:4:\"type\";s:4:\"text\";s:12:\"instructions\";s:0:\"\";s:8:\"required\";i:0;s:17:\"conditional_logic\";i:0;s:7:\"wrapper\";a:3:{s:5:\"width\";s:0:\"\";s:5:\"class\";s:0:\"\";s:2:\"id\";s:0:\"\";}s:18:\"relevanssi_exclude\";i:0;s:13:\"default_value\";s:0:\"\";s:9:\"maxlength\";s:0:\"\";s:11:\"placeholder\";s:0:\"\";s:7:\"prepend\";s:0:\"\";s:6:\"append\";s:0:\"\";s:15:\"parent_repeater\";s:19:\"field_654845bebedd2\";}','help title','help_title','publish','closed','closed','','field_654845bebedd4','','','2023-11-06 01:53:35','2023-11-06 01:53:35','',1964,'http://localhost/?post_type=acf-field&p=2120',1,'acf-field','',0),(2121,1,'2023-11-06 01:53:35','2023-11-06 01:53:35','a:13:{s:10:\"aria-label\";s:0:\"\";s:4:\"type\";s:4:\"text\";s:12:\"instructions\";s:0:\"\";s:8:\"required\";i:0;s:17:\"conditional_logic\";i:0;s:7:\"wrapper\";a:3:{s:5:\"width\";s:0:\"\";s:5:\"class\";s:0:\"\";s:2:\"id\";s:0:\"\";}s:18:\"relevanssi_exclude\";i:0;s:13:\"default_value\";s:0:\"\";s:9:\"maxlength\";s:0:\"\";s:11:\"placeholder\";s:0:\"\";s:7:\"prepend\";s:0:\"\";s:6:\"append\";s:0:\"\";s:15:\"parent_repeater\";s:19:\"field_654845bebedd2\";}','help url','help_url','publish','closed','closed','','field_654845bebedd5','','','2023-11-06 01:53:35','2023-11-06 01:53:35','',1964,'http://localhost/?post_type=acf-field&p=2121',2,'acf-field','',0),(2122,1,'2023-11-06 01:54:36','2023-11-06 01:54:36','<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\"></h3>\n<!-- /wp:heading -->','Get help','','inherit','closed','closed','','1951-revision-v1','','','2023-11-06 01:54:36','2023-11-06 01:54:36','',1951,'http://localhost/?p=2122',0,'revision','',0),(2123,1,'2023-11-06 02:06:11','2023-11-06 02:06:11','<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\"></h3>\n<!-- /wp:heading -->','Get help','','inherit','closed','closed','','1951-revision-v1','','','2023-11-06 02:06:11','2023-11-06 02:06:11','',1951,'http://localhost/?p=2123',0,'revision','',0),(2124,1,'2023-11-06 02:06:36','2023-11-06 02:06:36','<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\"></h3>\n<!-- /wp:heading -->','Get help','','inherit','closed','closed','','1951-revision-v1','','','2023-11-06 02:06:36','2023-11-06 02:06:36','',1951,'http://localhost/?p=2124',0,'revision','',0),(2125,1,'2023-11-06 02:09:15','2023-11-06 02:09:15','<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\"></h3>\n<!-- /wp:heading -->','Get help','','inherit','closed','closed','','1951-revision-v1','','','2023-11-06 02:09:15','2023-11-06 02:09:15','',1951,'http://localhost/?p=2125',0,'revision','',0),(2126,1,'2023-11-06 02:10:45','2023-11-06 02:10:45','<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\"></h3>\n<!-- /wp:heading -->','Get help','','inherit','closed','closed','','1951-revision-v1','','','2023-11-06 02:10:45','2023-11-06 02:10:45','',1951,'http://localhost/?p=2126',0,'revision','',0),(2128,1,'2023-11-28 22:59:07','2023-11-28 22:59:07','<!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Super Consumers Australia says the resource should be expanded to include more super products.</h2>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"need-to-know\",\"layout\":{\"type\":\"constrained\"},\"metadata\":{\"name\":\"Need to Know\"}} -->\n<div class=\"wp-block-group need-to-know\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Need to know</h3>\n<!-- /wp:heading -->\n\n<!-- wp:list -->\n<ul><!-- wp:list-item -->\n<li>The ATO\'s super fund comparison tool has had more than one million visits</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>There\'s evidence the tool is helping people leave underperforming funds</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Super Consumers Australia says the tool must be expanded to include choice products to make it even more useful</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list --></div>\n<!-- /wp:group -->\n\n<!-- wp:paragraph -->\n<p>Last year, the government introduced the ATO\'s new super fund comparison tool.&nbsp;</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>According to Super Consumer Australia director Xavier O\'Halloran,&nbsp;<a href=\"https://www.choice.com.au/money/financial-planning-and-investing/superannuation/articles/comparison-tool\">the tool is a breakthrough for fund members</a>. \"Its real benefit is highlighting those [funds] that passed their basic fitness,\" he says.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>The tool lets you compare the fees and seven-year performance of MySuper products.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>The tool has recorded more than one million hits. And there is evidence it\'s having a real impact on underperforming funds – in late 2021, the Australian Prudential Regulation Authority (APRA) reported that seven percent of people in an underperforming fund had closed their account.&nbsp;</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>This number may sound low, but Super Consumers Australia\'s analysis shows that this closure rate is more than double that of the same period the previous year.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p><strong>Read more:&nbsp;</strong><a href=\"https://www.choice.com.au/money/financial-planning-and-investing/superannuation/articles/choice-funds\" class=\"\">Choice super products: What you need to know before you join</a></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Your experience of using the tool</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>CHOICE member Megan found the tool \"relatively easy\" to navigate when she used it to compare the performance of her current and previous funds.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>\"I did use it over other comparison tools because I trusted it more coming from a government source, and I didn\'t want to spend too much time on it,\" she says. \"I wanted a quick answer from a trusted source.\"</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>On the CHOICE community forum, user Peterchu says the tool was useful when he helped two younger family members select their first fund.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>The tool \"worked well\", according to CHOICE reader Lena. \"Visually, it wasn\'t very interesting, but I found the fund I\'m in and was relieved to find it rated pretty well,\" Lena says. \"It was easy to use overall.\"</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p><strong>Read more:&nbsp;</strong><a href=\"https://www.choice.com.au/money/financial-planning-and-investing/superannuation/articles/claires-story-unpaid-super\" class=\"\">Claire was underpaid super for years – and she\'s not alone</a></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">What being in an underperforming fund means for you</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>It may seem that many super funds have roughly the same level of long-term performance, but research shows these differences can add up. APRA calculated that the difference between being in an outperforming MySuper product and an underperforming one was $11,387, or 12.6% over seven years.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:quote -->\n<blockquote class=\"wp-block-quote\"><!-- wp:paragraph -->\n<p>APRA calculated that the difference between being in an outperforming MySuper product and an underperforming one was $11,387, or 12.6% over seven years</p>\n<!-- /wp:paragraph --><cite>Add Citation.</cite></blockquote>\n<!-- /wp:quote -->\n\n<!-- wp:paragraph -->\n<p>APRA also made clear that high fees mean you retire with less. The regulator calculated that the difference between the median administration fees paid by a fund member in the highest fee choice products is $284 a year higher than for other products. It\'s important to remember that higher fees don\'t mean you\'re getting a better product.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>Moving your super to a better performing fund could see you enjoy more retirement income without having to work longer or go without during your working life.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:html -->\n<div class=\"infogram-embed\" data-id=\"019552b0-fd4c-4ea2-8102-0322b0c8876e\" data-type=\"interactive\" data-title=\"Why the super fund comparison tool is the way forward\"></div><script>!function(e,n,i,s){var d=\"InfogramEmbeds\";var o=e.getElementsByTagName(n)[0];if(window[d]&&window[d].initialized)window[d].process&&window[d].process();else if(!e.getElementById(i)){var r=e.createElement(n);r.async=1,r.id=i,r.src=s,o.parentNode.insertBefore(r,o)}}(document,\"script\",\"infogram-async\",\"https://e.infogram.com/js/dist/embed-loader-min.js\");</script>\n<!-- /wp:html -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">The view from the regulator</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>APRA says the fund comparison tool is the best place to start for members looking to make informed decisions about their super.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>APRA member Margaret Cole (who heads superannuation at the regulator) recently said that, since the introduction of the performance test (which is part of the tool), \"there has been heightened scrutiny on investment returns, fees and costs across the industry\".</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>Cole says this scrutiny will only become more intense. \"Passing the performance test does not necessarily mean you are in clear water and have escaped the APRA radar,\" she says.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>In a statement about the comparison tool, the regulator explained: \"Increased transparency is a powerful tool for regulators to bring about improvements in superannuation fund performance, but members should never forget they also have the power to make decisions that will better secure their future in retirement.\"</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p><strong>Read more:&nbsp;</strong><a href=\"https://www.choice.com.au/money/financial-planning-and-investing/superannuation/articles/finfluencers\" class=\"\">Finfluencers and your super</a></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Choice products</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>There is less consumer scrutiny of choice super products, which, as of June 2020, made up almost half (46%) of APRA-regulated super products.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>The fund comparison tool currently only lists MySuper products – it doesn\'t let you compare choice products. These are super products you can\'t be defaulted into – you have to make an active choice to join them.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>Jane Hume, Minister for Superannuation, has confirmed that the government intends to extend the tool to include choice products. It isn\'t clear when this extension will go ahead.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":4} -->\n<h4 class=\"wp-block-heading\">Strong support for inclusion of choice funds</h4>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>CHOICE member Ashley says including these products would be beneficial. \"I found it wasn\'t really granular enough to be useful – for instance [my specific product] just isn\'t listed. If I was sticking to a core investment strategy, then it might be useful, but in my case, not really.\"</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>Jodi, another CHOICE member, thinks the tool has potential. \"It looked pretty easy to compare fees and performance,\" he says. However, he couldn\'t compare his product, as he is in a different option from the balanced MySuper product for his fund.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>CHOICE community member Peterchu also found the tool didn\'t include his super product, as it\'s not part of the MySuper system.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:quote -->\n<blockquote class=\"wp-block-quote\"><!-- wp:paragraph -->\n<p>Extending the fund comparison tool would ultimately help more Australians find a better product or have peace of mind that they\'re in a product that is doing wellFranco Morelli, Super Consumers Australia policy manager</p>\n<!-- /wp:paragraph --></blockquote>\n<!-- /wp:quote -->\n\n<!-- wp:paragraph -->\n<p>Super Consumers Australia policy manager&nbsp;<a href=\"https://www.choice.com.au/authors/franco-morelli\">Franco Morelli</a>&nbsp;says the government should fund an extension of the comparison tool.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>\"People are using the tool, and it\'s already getting results in increasing the number of people exiting poor funds,\" he says.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>\"We need more transparency across the super sector. Extending the fund comparison tool would ultimately help more Australians find a better product or have peace of mind that they\'re in a product that is doing well in building up their retirement income.\"</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:html -->\n<div class=\"infogram-embed\" data-id=\"f0e9e693-777b-47fb-b1df-8dc695bf528b\" data-type=\"interactive\" data-title=\"The super fund comparison tool is helping Australians find a better super fund #2\"></div><script>!function(e,n,i,s){var d=\"InfogramEmbeds\";var o=e.getElementsByTagName(n)[0];if(window[d]&&window[d].initialized)window[d].process&&window[d].process();else if(!e.getElementById(i)){var r=e.createElement(n);r.async=1,r.id=i,r.src=s,o.parentNode.insertBefore(r,o)}}(document,\"script\",\"infogram-async\",\"https://e.infogram.com/js/dist/embed-loader-min.js\");</script>\n<!-- /wp:html -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Time for effective product information for all super products&nbsp;</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Super funds that offer MySuper products are required to display a \'dashboard\' on their website with information on how the product is performing and its fees.&nbsp;</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>But choice products dashboards have been delayed for nearly a decade by successive governments. There are now proposals to push back new dashboard requirements to 2027.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":4} -->\n<h4 class=\"wp-block-heading\">\'Overwhelming and complex\'</h4>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>As we covered previously,&nbsp;<a href=\"https://www.choice.com.au/money/financial-planning-and-investing/superannuation/articles/gauging-performance\">experts say these dashboards weren\'t encouraging fund switching.</a>&nbsp;The dashboards are often difficult to find, and the different formats and ways of displaying information make comparisons complex.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>A 2020 study by a group of academics found that the dashboards weren\'t useful in helping people compare fund performance. Similarly, the Productivity Commission found the information presented by funds was often \"overwhelming and complex\", and that most dashboards weren\'t effective.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:quote -->\n<blockquote class=\"wp-block-quote\"><!-- wp:paragraph -->\n<p>Clearer, simpler and more widely applied product dashboards are needed to help members compare the returns, fees and risks associated with all super productsProductivity Commission</p>\n<!-- /wp:paragraph --></blockquote>\n<!-- /wp:quote -->\n\n<!-- wp:paragraph -->\n<p>\"Clearer, simpler and more widely applied product dashboards are needed to help members compare the returns, fees and risks associated with all super products,\" the Commission says.&nbsp;</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":4} -->\n<h4 class=\"wp-block-heading\">Government action needed</h4>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Morelli agrees that the government needs to take steps to make sure consumers have the information to compare funds and make good decisions.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>\"First, we need to ensure the fund comparison tool includes choice products this year,\" says Morelli. \"This needs to be a priority.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>\"Second, it\'s time to review and consumer-test the information people need to ensure it\'s salient, simple and accessible. Useful product information covering both MySuper and choice products, harmonised with the comparison tool, would greatly help members get the most out of their super.\"</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p><strong>Read more:&nbsp;</strong><a class=\"\" href=\"https://www.choice.com.au/money/financial-planning-and-investing/superannuation/articles/financial-advice-survey\">Survey says: Conflicted financial advice still a problem</a></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p><em>This content was produced by Super Consumers Australia which is an independent, nonprofit consumer organisation partnering with CHOICE to advance and protect the interests of people in the Australian superannuation system.</em></p>\n<!-- /wp:paragraph -->','Sort your super – how the super fund comparison tool can help','','publish','closed','closed','','sort-your-super-how-the-super-fund-comparison-tool-can-help','','','2023-11-28 22:59:07','2023-11-28 22:59:07','',0,'http://localhost/?post_type=journalism&#038;p=2128',0,'journalism','',0),(2129,1,'2023-11-28 22:59:03','2023-11-28 22:59:03','','superannuation_dashboard_screen_on_laptop_at_home','','inherit','open','closed','','superannuation_dashboard_screen_on_laptop_at_home','','','2023-11-28 22:59:03','2023-11-28 22:59:03','',2128,'http://localhost/wp-content/uploads/2023/11/superannuation_dashboard_screen_on_laptop_at_home.jpeg',0,'attachment','image/jpeg',0),(2131,1,'2023-11-28 23:00:10','2023-11-28 23:00:10','.hmpgtxt-wrap li.core_field:nth-child(2),\n.hmpgtxt-wrap li.core_field:nth-child(3),\n.hmpgtxt-wrap li.core_field:nth-child(5) {\n    display: none;\n}\n\n\n\n@media (min-width: 992px) {\n.postid-476 h1 {font-size: 2.75rem;}\n}\n\n','superconsumers','','publish','closed','closed','','superconsumers','','','2023-11-29 00:35:12','2023-11-29 00:35:12','',0,'http://localhost/superconsumers/',0,'custom_css','',0),(2132,1,'2023-11-28 23:00:10','2023-11-28 23:00:10','.hmpgtxt-wrap li.core_field:nth-child(2),\n.hmpgtxt-wrap li.core_field:nth-child(3),\n.hmpgtxt-wrap li.core_field:nth-child(5) {\n    display: none;\n}\n\n.post-featute-img img {width: 100%;}\n\n@media (min-width: 992px) {\n.postid-476 h1 {font-size: 2.75rem;}\n}\n\n.need-to-know {Background: hsla(199,84%,85%,.25); padding: 1rem 1.5rem 1rem 1.5rem; margin: 2rem 0; border-left: solid 1.5rem hsla(200,97%,23%,.6)}\n\n.need-to-know h3 {margin: .5rem 0 1rem;} \n\n.need-to-know ul {padding: 0 0 0 1rem; list-style: none;} \n\n.need-to-know li {line-height: 1.42; margin-bottom: .5rem;} \n\n.need-to-know li::before {\n  content: \"\\2022\";\n  color: hsla(200,97%,23%,.6);\n  font-weight: bold;\n  display: inline-block; \n  width: 1em;\n  margin-left: -1em;\n	font-size: 1.2rem;\n}\n\nblockquote.wp-block-quote {\n	color: hsl(200,97%,23%);\n	position: relative;\n	Background: hsla(199,84%,85%,.25) ;\n  border: none;\n  padding: 1rem 2rem 1rem 3.5rem;\n  border-radius: 0;\n  margin: 1.5rem 0;\n	font-size: 1.2rem;\n}\n\nblockquote.wp-block-quote::before  {content: \" \"; color: #000; font-size: 4rem; position: absolute; top: .8rem; left: -.5rem; width: 3rem; height: 3rem; background:  url(\"https://super.essentialmedia.com.au/wp-content/themes/superconsumers/images/quote-blue.svg\") no-repeat; opacity: .6;}','superconsumers','','inherit','closed','closed','','2131-revision-v1','','','2023-11-28 23:00:10','2023-11-28 23:00:10','',2131,'http://localhost/?p=2132',0,'revision','',0),(2133,1,'2023-11-28 23:03:51','2023-11-28 23:03:51','<!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Super Consumers Australia says the resource should be expanded to include more super products.</h2>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"need-to-know\",\"layout\":{\"type\":\"constrained\"},\"metadata\":{\"name\":\"Need to Know\"}} -->\n<div class=\"wp-block-group need-to-know\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Need to know</h3>\n<!-- /wp:heading -->\n\n<!-- wp:list -->\n<ul><!-- wp:list-item -->\n<li>The ATO\'s super fund comparison tool has had more than one million visits</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>There\'s evidence the tool is helping people leave underperforming funds</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Super Consumers Australia says the tool must be expanded to include choice products to make it even more useful</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list --></div>\n<!-- /wp:group -->\n\n<!-- wp:paragraph -->\n<p>Last year, the government introduced the ATO\'s new super fund comparison tool.&nbsp;</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>According to Super Consumer Australia director Xavier O\'Halloran,&nbsp;<a href=\"https://www.choice.com.au/money/financial-planning-and-investing/superannuation/articles/comparison-tool\">the tool is a breakthrough for fund members</a>. \"Its real benefit is highlighting those [funds] that passed their basic fitness,\" he says.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>The tool lets you compare the fees and seven-year performance of MySuper products.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>The tool has recorded more than one million hits. And there is evidence it\'s having a real impact on underperforming funds – in late 2021, the Australian Prudential Regulation Authority (APRA) reported that seven percent of people in an underperforming fund had closed their account.&nbsp;</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>This number may sound low, but Super Consumers Australia\'s analysis shows that this closure rate is more than double that of the same period the previous year.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p><strong>Read more:&nbsp;</strong><a href=\"https://www.choice.com.au/money/financial-planning-and-investing/superannuation/articles/choice-funds\" class=\"\">Choice super products: What you need to know before you join</a></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Your experience of using the tool</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>CHOICE member Megan found the tool \"relatively easy\" to navigate when she used it to compare the performance of her current and previous funds.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>\"I did use it over other comparison tools because I trusted it more coming from a government source, and I didn\'t want to spend too much time on it,\" she says. \"I wanted a quick answer from a trusted source.\"</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>On the CHOICE community forum, user Peterchu says the tool was useful when he helped two younger family members select their first fund.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>The tool \"worked well\", according to CHOICE reader Lena. \"Visually, it wasn\'t very interesting, but I found the fund I\'m in and was relieved to find it rated pretty well,\" Lena says. \"It was easy to use overall.\"</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p><strong>Read more:&nbsp;</strong><a href=\"https://www.choice.com.au/money/financial-planning-and-investing/superannuation/articles/claires-story-unpaid-super\" class=\"\">Claire was underpaid super for years – and she\'s not alone</a></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">What being in an underperforming fund means for you</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>It may seem that many super funds have roughly the same level of long-term performance, but research shows these differences can add up. APRA calculated that the difference between being in an outperforming MySuper product and an underperforming one was $11,387, or 12.6% over seven years.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:quote -->\n<blockquote class=\"wp-block-quote\"><!-- wp:paragraph -->\n<p>APRA calculated that the difference between being in an outperforming MySuper product and an underperforming one was $11,387, or 12.6% over seven years</p>\n<!-- /wp:paragraph --><cite>Add Citation.</cite></blockquote>\n<!-- /wp:quote -->\n\n<!-- wp:paragraph -->\n<p>APRA also made clear that high fees mean you retire with less. The regulator calculated that the difference between the median administration fees paid by a fund member in the highest fee choice products is $284 a year higher than for other products. It\'s important to remember that higher fees don\'t mean you\'re getting a better product.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>Moving your super to a better performing fund could see you enjoy more retirement income without having to work longer or go without during your working life.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:html -->\n<div class=\"infogram-embed\" data-id=\"019552b0-fd4c-4ea2-8102-0322b0c8876e\" data-type=\"interactive\" data-title=\"Why the super fund comparison tool is the way forward\"></div><script>!function(e,n,i,s){var d=\"InfogramEmbeds\";var o=e.getElementsByTagName(n)[0];if(window[d]&&window[d].initialized)window[d].process&&window[d].process();else if(!e.getElementById(i)){var r=e.createElement(n);r.async=1,r.id=i,r.src=s,o.parentNode.insertBefore(r,o)}}(document,\"script\",\"infogram-async\",\"https://e.infogram.com/js/dist/embed-loader-min.js\");</script>\n<!-- /wp:html -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">The view from the regulator</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>APRA says the fund comparison tool is the best place to start for members looking to make informed decisions about their super.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>APRA member Margaret Cole (who heads superannuation at the regulator) recently said that, since the introduction of the performance test (which is part of the tool), \"there has been heightened scrutiny on investment returns, fees and costs across the industry\".</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>Cole says this scrutiny will only become more intense. \"Passing the performance test does not necessarily mean you are in clear water and have escaped the APRA radar,\" she says.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>In a statement about the comparison tool, the regulator explained: \"Increased transparency is a powerful tool for regulators to bring about improvements in superannuation fund performance, but members should never forget they also have the power to make decisions that will better secure their future in retirement.\"</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p><strong>Read more:&nbsp;</strong><a href=\"https://www.choice.com.au/money/financial-planning-and-investing/superannuation/articles/finfluencers\" class=\"\">Finfluencers and your super</a></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Choice products</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>There is less consumer scrutiny of choice super products, which, as of June 2020, made up almost half (46%) of APRA-regulated super products.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>The fund comparison tool currently only lists MySuper products – it doesn\'t let you compare choice products. These are super products you can\'t be defaulted into – you have to make an active choice to join them.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>Jane Hume, Minister for Superannuation, has confirmed that the government intends to extend the tool to include choice products. It isn\'t clear when this extension will go ahead.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":4} -->\n<h4 class=\"wp-block-heading\">Strong support for inclusion of choice funds</h4>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>CHOICE member Ashley says including these products would be beneficial. \"I found it wasn\'t really granular enough to be useful – for instance [my specific product] just isn\'t listed. If I was sticking to a core investment strategy, then it might be useful, but in my case, not really.\"</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>Jodi, another CHOICE member, thinks the tool has potential. \"It looked pretty easy to compare fees and performance,\" he says. However, he couldn\'t compare his product, as he is in a different option from the balanced MySuper product for his fund.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>CHOICE community member Peterchu also found the tool didn\'t include his super product, as it\'s not part of the MySuper system.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:quote -->\n<blockquote class=\"wp-block-quote\"><!-- wp:paragraph -->\n<p>Extending the fund comparison tool would ultimately help more Australians find a better product or have peace of mind that they\'re in a product that is doing wellFranco Morelli, Super Consumers Australia policy manager</p>\n<!-- /wp:paragraph --></blockquote>\n<!-- /wp:quote -->\n\n<!-- wp:paragraph -->\n<p>Super Consumers Australia policy manager&nbsp;<a href=\"https://www.choice.com.au/authors/franco-morelli\">Franco Morelli</a>&nbsp;says the government should fund an extension of the comparison tool.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>\"People are using the tool, and it\'s already getting results in increasing the number of people exiting poor funds,\" he says.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>\"We need more transparency across the super sector. Extending the fund comparison tool would ultimately help more Australians find a better product or have peace of mind that they\'re in a product that is doing well in building up their retirement income.\"</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:html -->\n<div class=\"infogram-embed\" data-id=\"f0e9e693-777b-47fb-b1df-8dc695bf528b\" data-type=\"interactive\" data-title=\"The super fund comparison tool is helping Australians find a better super fund #2\"></div><script>!function(e,n,i,s){var d=\"InfogramEmbeds\";var o=e.getElementsByTagName(n)[0];if(window[d]&&window[d].initialized)window[d].process&&window[d].process();else if(!e.getElementById(i)){var r=e.createElement(n);r.async=1,r.id=i,r.src=s,o.parentNode.insertBefore(r,o)}}(document,\"script\",\"infogram-async\",\"https://e.infogram.com/js/dist/embed-loader-min.js\");</script>\n<!-- /wp:html -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Time for effective product information for all super products&nbsp;</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Super funds that offer MySuper products are required to display a \'dashboard\' on their website with information on how the product is performing and its fees.&nbsp;</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>But choice products dashboards have been delayed for nearly a decade by successive governments. There are now proposals to push back new dashboard requirements to 2027.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":4} -->\n<h4 class=\"wp-block-heading\">\'Overwhelming and complex\'</h4>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>As we covered previously,&nbsp;<a href=\"https://www.choice.com.au/money/financial-planning-and-investing/superannuation/articles/gauging-performance\">experts say these dashboards weren\'t encouraging fund switching.</a>&nbsp;The dashboards are often difficult to find, and the different formats and ways of displaying information make comparisons complex.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>A 2020 study by a group of academics found that the dashboards weren\'t useful in helping people compare fund performance. Similarly, the Productivity Commission found the information presented by funds was often \"overwhelming and complex\", and that most dashboards weren\'t effective.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:quote -->\n<blockquote class=\"wp-block-quote\"><!-- wp:paragraph -->\n<p>Clearer, simpler and more widely applied product dashboards are needed to help members compare the returns, fees and risks associated with all super productsProductivity Commission</p>\n<!-- /wp:paragraph --></blockquote>\n<!-- /wp:quote -->\n\n<!-- wp:paragraph -->\n<p>\"Clearer, simpler and more widely applied product dashboards are needed to help members compare the returns, fees and risks associated with all super products,\" the Commission says.&nbsp;</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":4} -->\n<h4 class=\"wp-block-heading\">Government action needed</h4>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Morelli agrees that the government needs to take steps to make sure consumers have the information to compare funds and make good decisions.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>\"First, we need to ensure the fund comparison tool includes choice products this year,\" says Morelli. \"This needs to be a priority.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>\"Second, it\'s time to review and consumer-test the information people need to ensure it\'s salient, simple and accessible. Useful product information covering both MySuper and choice products, harmonised with the comparison tool, would greatly help members get the most out of their super.\"</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p><strong>Read more:&nbsp;</strong><a class=\"\" href=\"https://www.choice.com.au/money/financial-planning-and-investing/superannuation/articles/financial-advice-survey\">Survey says: Conflicted financial advice still a problem</a></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p><em>This content was produced by Super Consumers Australia which is an independent, nonprofit consumer organisation partnering with CHOICE to advance and protect the interests of people in the Australian superannuation system.</em></p>\n<!-- /wp:paragraph -->','Sort your super – how the super fund comparison tool can help','','inherit','closed','closed','','2128-autosave-v1','','','2023-11-28 23:03:51','2023-11-28 23:03:51','',2128,'http://localhost/?p=2133',0,'revision','',0),(2134,1,'2023-11-28 23:15:21','2023-11-28 23:15:21','<!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Super Consumers Australia says the resource should be expanded to include more super products.</h2>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"className\":\"need-to-know\",\"layout\":{\"type\":\"constrained\"},\"metadata\":{\"name\":\"Need to Know\"}} -->\n<div class=\"wp-block-group need-to-know\"><!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Need to know</h3>\n<!-- /wp:heading -->\n\n<!-- wp:list -->\n<ul><!-- wp:list-item -->\n<li>The ATO\'s super fund comparison tool has had more than one million visits</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>There\'s evidence the tool is helping people leave underperforming funds</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Super Consumers Australia says the tool must be expanded to include choice products to make it even more useful</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list --></div>\n<!-- /wp:group -->\n\n<!-- wp:paragraph -->\n<p>Last year, the government introduced the ATO\'s new super fund comparison tool.&nbsp;</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>According to Super Consumer Australia director Xavier O\'Halloran,&nbsp;<a href=\"https://www.choice.com.au/money/financial-planning-and-investing/superannuation/articles/comparison-tool\">the tool is a breakthrough for fund members</a>. \"Its real benefit is highlighting those [funds] that passed their basic fitness,\" he says.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>The tool lets you compare the fees and seven-year performance of MySuper products.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>The tool has recorded more than one million hits. And there is evidence it\'s having a real impact on underperforming funds – in late 2021, the Australian Prudential Regulation Authority (APRA) reported that seven percent of people in an underperforming fund had closed their account.&nbsp;</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>This number may sound low, but Super Consumers Australia\'s analysis shows that this closure rate is more than double that of the same period the previous year.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p><strong>Read more:&nbsp;</strong><a href=\"https://www.choice.com.au/money/financial-planning-and-investing/superannuation/articles/choice-funds\" class=\"\">Choice super products: What you need to know before you join</a></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Your experience of using the tool</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>CHOICE member Megan found the tool \"relatively easy\" to navigate when she used it to compare the performance of her current and previous funds.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>\"I did use it over other comparison tools because I trusted it more coming from a government source, and I didn\'t want to spend too much time on it,\" she says. \"I wanted a quick answer from a trusted source.\"</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>On the CHOICE community forum, user Peterchu says the tool was useful when he helped two younger family members select their first fund.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>The tool \"worked well\", according to CHOICE reader Lena. \"Visually, it wasn\'t very interesting, but I found the fund I\'m in and was relieved to find it rated pretty well,\" Lena says. \"It was easy to use overall.\"</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p><strong>Read more:&nbsp;</strong><a href=\"https://www.choice.com.au/money/financial-planning-and-investing/superannuation/articles/claires-story-unpaid-super\" class=\"\">Claire was underpaid super for years – and she\'s not alone</a></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">What being in an underperforming fund means for you</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>It may seem that many super funds have roughly the same level of long-term performance, but research shows these differences can add up. APRA calculated that the difference between being in an outperforming MySuper product and an underperforming one was $11,387, or 12.6% over seven years.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:quote -->\n<blockquote class=\"wp-block-quote\"><!-- wp:paragraph -->\n<p>APRA calculated that the difference between being in an outperforming MySuper product and an underperforming one was $11,387, or 12.6% over seven years</p>\n<!-- /wp:paragraph --><cite>Add Citation.</cite></blockquote>\n<!-- /wp:quote -->\n\n<!-- wp:paragraph -->\n<p>APRA also made clear that high fees mean you retire with less. The regulator calculated that the difference between the median administration fees paid by a fund member in the highest fee choice products is $284 a year higher than for other products. It\'s important to remember that higher fees don\'t mean you\'re getting a better product.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>Moving your super to a better performing fund could see you enjoy more retirement income without having to work longer or go without during your working life.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:html -->\n<div class=\"infogram-embed\" data-id=\"019552b0-fd4c-4ea2-8102-0322b0c8876e\" data-type=\"interactive\" data-title=\"Why the super fund comparison tool is the way forward\"></div><script>!function(e,n,i,s){var d=\"InfogramEmbeds\";var o=e.getElementsByTagName(n)[0];if(window[d]&&window[d].initialized)window[d].process&&window[d].process();else if(!e.getElementById(i)){var r=e.createElement(n);r.async=1,r.id=i,r.src=s,o.parentNode.insertBefore(r,o)}}(document,\"script\",\"infogram-async\",\"https://e.infogram.com/js/dist/embed-loader-min.js\");</script>\n<!-- /wp:html -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">The view from the regulator</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>APRA says the fund comparison tool is the best place to start for members looking to make informed decisions about their super.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>APRA member Margaret Cole (who heads superannuation at the regulator) recently said that, since the introduction of the performance test (which is part of the tool), \"there has been heightened scrutiny on investment returns, fees and costs across the industry\".</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>Cole says this scrutiny will only become more intense. \"Passing the performance test does not necessarily mean you are in clear water and have escaped the APRA radar,\" she says.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>In a statement about the comparison tool, the regulator explained: \"Increased transparency is a powerful tool for regulators to bring about improvements in superannuation fund performance, but members should never forget they also have the power to make decisions that will better secure their future in retirement.\"</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p><strong>Read more:&nbsp;</strong><a href=\"https://www.choice.com.au/money/financial-planning-and-investing/superannuation/articles/finfluencers\" class=\"\">Finfluencers and your super</a></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Choice products</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>There is less consumer scrutiny of choice super products, which, as of June 2020, made up almost half (46%) of APRA-regulated super products.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>The fund comparison tool currently only lists MySuper products – it doesn\'t let you compare choice products. These are super products you can\'t be defaulted into – you have to make an active choice to join them.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>Jane Hume, Minister for Superannuation, has confirmed that the government intends to extend the tool to include choice products. It isn\'t clear when this extension will go ahead.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":4} -->\n<h4 class=\"wp-block-heading\">Strong support for inclusion of choice funds</h4>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>CHOICE member Ashley says including these products would be beneficial. \"I found it wasn\'t really granular enough to be useful – for instance [my specific product] just isn\'t listed. If I was sticking to a core investment strategy, then it might be useful, but in my case, not really.\"</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>Jodi, another CHOICE member, thinks the tool has potential. \"It looked pretty easy to compare fees and performance,\" he says. However, he couldn\'t compare his product, as he is in a different option from the balanced MySuper product for his fund.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>CHOICE community member Peterchu also found the tool didn\'t include his super product, as it\'s not part of the MySuper system.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:quote -->\n<blockquote class=\"wp-block-quote\"><!-- wp:paragraph -->\n<p>Extending the fund comparison tool would ultimately help more Australians find a better product or have peace of mind that they\'re in a product that is doing wellFranco Morelli, Super Consumers Australia policy manager</p>\n<!-- /wp:paragraph --></blockquote>\n<!-- /wp:quote -->\n\n<!-- wp:paragraph -->\n<p>Super Consumers Australia policy manager&nbsp;<a href=\"https://www.choice.com.au/authors/franco-morelli\">Franco Morelli</a>&nbsp;says the government should fund an extension of the comparison tool.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>\"People are using the tool, and it\'s already getting results in increasing the number of people exiting poor funds,\" he says.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>\"We need more transparency across the super sector. Extending the fund comparison tool would ultimately help more Australians find a better product or have peace of mind that they\'re in a product that is doing well in building up their retirement income.\"</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:html -->\n<div class=\"infogram-embed\" data-id=\"f0e9e693-777b-47fb-b1df-8dc695bf528b\" data-type=\"interactive\" data-title=\"The super fund comparison tool is helping Australians find a better super fund #2\"></div><script>!function(e,n,i,s){var d=\"InfogramEmbeds\";var o=e.getElementsByTagName(n)[0];if(window[d]&&window[d].initialized)window[d].process&&window[d].process();else if(!e.getElementById(i)){var r=e.createElement(n);r.async=1,r.id=i,r.src=s,o.parentNode.insertBefore(r,o)}}(document,\"script\",\"infogram-async\",\"https://e.infogram.com/js/dist/embed-loader-min.js\");</script>\n<!-- /wp:html -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Time for effective product information for all super products&nbsp;</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Super funds that offer MySuper products are required to display a \'dashboard\' on their website with information on how the product is performing and its fees.&nbsp;</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>But choice products dashboards have been delayed for nearly a decade by successive governments. There are now proposals to push back new dashboard requirements to 2027.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":4} -->\n<h4 class=\"wp-block-heading\">\'Overwhelming and complex\'</h4>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>As we covered previously,&nbsp;<a href=\"https://www.choice.com.au/money/financial-planning-and-investing/superannuation/articles/gauging-performance\">experts say these dashboards weren\'t encouraging fund switching.</a>&nbsp;The dashboards are often difficult to find, and the different formats and ways of displaying information make comparisons complex.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>A 2020 study by a group of academics found that the dashboards weren\'t useful in helping people compare fund performance. Similarly, the Productivity Commission found the information presented by funds was often \"overwhelming and complex\", and that most dashboards weren\'t effective.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:quote -->\n<blockquote class=\"wp-block-quote\"><!-- wp:paragraph -->\n<p>Clearer, simpler and more widely applied product dashboards are needed to help members compare the returns, fees and risks associated with all super productsProductivity Commission</p>\n<!-- /wp:paragraph --></blockquote>\n<!-- /wp:quote -->\n\n<!-- wp:paragraph -->\n<p>\"Clearer, simpler and more widely applied product dashboards are needed to help members compare the returns, fees and risks associated with all super products,\" the Commission says.&nbsp;</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":4} -->\n<h4 class=\"wp-block-heading\">Government action needed</h4>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Morelli agrees that the government needs to take steps to make sure consumers have the information to compare funds and make good decisions.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>\"First, we need to ensure the fund comparison tool includes choice products this year,\" says Morelli. \"This needs to be a priority.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>\"Second, it\'s time to review and consumer-test the information people need to ensure it\'s salient, simple and accessible. Useful product information covering both MySuper and choice products, harmonised with the comparison tool, would greatly help members get the most out of their super.\"</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p><strong>Read more:&nbsp;</strong><a class=\"\" href=\"https://www.choice.com.au/money/financial-planning-and-investing/superannuation/articles/financial-advice-survey\">Survey says: Conflicted financial advice still a problem</a></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p><em>This content was produced by Super Consumers Australia which is an independent, nonprofit consumer organisation partnering with CHOICE to advance and protect the interests of people in the Australian superannuation system.</em></p>\n<!-- /wp:paragraph -->','Sort your super – how the super fund comparison tool can help version 2','','publish','closed','closed','','sort-your-super-how-the-super-fund-comparison-tool-can-help-version-2','','','2023-11-28 23:15:21','2023-11-28 23:15:21','',0,'http://localhost/?post_type=journalism&#038;p=2134',0,'journalism','',0),(2136,1,'2023-11-29 00:33:06','2023-11-29 00:33:06','.hmpgtxt-wrap li.core_field:nth-child(2),\n.hmpgtxt-wrap li.core_field:nth-child(3),\n.hmpgtxt-wrap li.core_field:nth-child(5) {\n    display: none;\n}\n\n.post-featute-img img {width: 100%;}\n\n@media (min-width: 992px) {\n.postid-476 h1 {font-size: 2.75rem;}\n}\n\n','superconsumers','','inherit','closed','closed','','2131-revision-v1','','','2023-11-29 00:33:06','2023-11-29 00:33:06','',2131,'http://localhost/?p=2136',0,'revision','',0),(2138,1,'2023-11-29 00:35:12','2023-11-29 00:35:12','.hmpgtxt-wrap li.core_field:nth-child(2),\n.hmpgtxt-wrap li.core_field:nth-child(3),\n.hmpgtxt-wrap li.core_field:nth-child(5) {\n    display: none;\n}\n\n\n\n@media (min-width: 992px) {\n.postid-476 h1 {font-size: 2.75rem;}\n}\n\n','superconsumers','','inherit','closed','closed','','2131-revision-v1','','','2023-11-29 00:35:12','2023-11-29 00:35:12','',2131,'http://localhost/?p=2138',0,'revision','',0),(2139,1,'2023-11-29 04:39:14','2023-11-29 04:39:14','<!-- wp:image {\"id\":2142,\"width\":\"840px\",\"height\":\"auto\",\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-large is-resized\"><img src=\"http://localhost/wp-content/uploads/2023/11/outcomes-1024x768.jpg\" alt=\"\" class=\"wp-image-2142\" style=\"width:840px;height:auto\"/></figure>\n<!-- /wp:image -->','Thriving communities','','publish','closed','closed','','chia-report','','','2023-11-29 05:02:55','2023-11-29 05:02:55','',0,'http://localhost/?page_id=2139',0,'page','',0),(2140,1,'2023-11-29 04:39:14','2023-11-29 04:39:14','','Chia report','','inherit','closed','closed','','2139-revision-v1','','','2023-11-29 04:39:14','2023-11-29 04:39:14','',2139,'http://localhost/?p=2140',0,'revision','',0),(2141,1,'2023-11-29 04:43:32','2023-11-29 04:43:32','','Thriving communities','','inherit','closed','closed','','2139-revision-v1','','','2023-11-29 04:43:32','2023-11-29 04:43:32','',2139,'http://localhost/?p=2141',0,'revision','',0),(2142,1,'2023-11-29 04:46:54','2023-11-29 04:46:54','','outcomes','','inherit','open','closed','','outcomes','','','2023-11-29 04:46:54','2023-11-29 04:46:54','',2139,'http://localhost/wp-content/uploads/2023/11/outcomes.jpg',0,'attachment','image/jpeg',0),(2143,1,'2023-11-29 04:47:03','2023-11-29 04:47:03','<!-- wp:image {\"id\":2142,\"width\":\"840px\",\"height\":\"auto\",\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-large is-resized\"><img src=\"http://localhost/wp-content/uploads/2023/11/outcomes-1024x768.jpg\" alt=\"\" class=\"wp-image-2142\" style=\"width:840px;height:auto\"/></figure>\n<!-- /wp:image -->','Thriving communities','','inherit','closed','closed','','2139-revision-v1','','','2023-11-29 04:47:03','2023-11-29 04:47:03','',2139,'http://localhost/?p=2143',0,'revision','',0),(2144,1,'2023-11-29 04:56:40','2023-11-29 04:56:40','','AdobeStock_259480361_report-header','','inherit','open','closed','','adobestock_259480361_report-header','','','2023-11-29 04:56:40','2023-11-29 04:56:40','',2139,'http://localhost/wp-content/uploads/2023/11/AdobeStock_259480361_report-header.jpg',0,'attachment','image/jpeg',0),(2146,1,'2024-05-14 05:03:26','2024-05-14 05:03:26','{\"0\":\"html-lang-direction\",\"1\":\"skiplinks\",\"2\":[\"control-titles\",\"1\"],\"3\":[\"input-titles\",\"1\"],\"timestamp\":1715663006}',':4000/','','publish','closed','closed','','4000','','','2024-05-14 05:03:26','2024-05-14 05:03:26','',0,'http://localhost/wpa-stats/4000/',0,'wpa-stats','',0),(2147,1,'2024-05-14 05:07:30','2024-05-14 05:07:30','{\"fontsize\":\"enabled\",\"timestamp\":1715663250}','4131849400','','publish','closed','closed','','4131849400','','','2024-05-14 05:07:30','2024-05-14 05:07:30','',0,'http://localhost/wpa-stats/4131849400/',0,'wpa-stats','',0),(2148,0,'2024-05-15 00:11:01','2024-05-15 00:11:01','{\"0\":\"html-lang-direction\",\"1\":\"skiplinks\",\"2\":[\"control-titles\",\"1\"],\"3\":[\"input-titles\",\"1\"],\"timestamp\":1715731861}',':4000/sasmin/','','publish','closed','closed','','4000-sasmin','','','2024-05-15 00:11:01','2024-05-15 00:11:01','',0,'http://localhost/wpa-stats/4000-sasmin/',0,'wpa-stats','',0),(2149,1,'2024-05-15 00:18:04','2024-05-15 00:18:04','<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">What’s this project about?</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>People with disabilities often need different kinds of support to live well. Sometimes these supports are easy to get. But other times, supports are hard to find or not there at all. This project is all about understanding the support you have now, and what support you wish you had.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>We also want to know why some support isn’t available.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>Some people with disability get support through the National Disability Insurance Scheme. This is also called the NDIS.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>But lots of people with disability don’t have NDIS plans. Governments are talking about giving more people support outside the NDIS. They are calling this Foundational Supports.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>We want people with disability, families and supporters to have a say about what these supports should be.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">How can you join in?</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>We want people with disability, their families and supporters to be part of this project. You will fill out a short online form. It has questions about you, what support you have now, and what support you wish you had.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>This won’t include any personal information like your name or address.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">What will we do with your answers?</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>We will put everyone’s answers together to see what is already supporting people and what is missing. We will seek advice and help from university researchers to analyse and write a report on what you tell us, after removing potential identifying information from your survey responses. Any information we share from this survey for research and advocacy will be completely anonymous.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>We will show you what we find at the Open Dialogues event in the next month or two. This is a free online event. When you fill in the form, you can let us know if you want us to email you about this event.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>We will also talk to governments and others about making sure everyone gets the support they need.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Ready to start?</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>To fill out the form, <a href=\"#project-strip\">click the button that says “Take our survey!”</a><br>You can ask someone to help you fill out the form if you would like.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>Thanks for your help – we are really glad you are joining us.</p>\n<!-- /wp:paragraph -->','Citizen Science Project','We’re calling on people with disability to help us understand the support they have or need to live a good life.','publish','closed','closed','','citizen-science-project','','','2024-06-06 08:19:17','2024-06-06 08:19:17','',0,'http://localhost/?post_type=projects&#038;p=2149',0,'projects','',0),(2150,1,'2024-05-15 00:18:17','2024-05-15 00:18:17','{\"0\":\"html-lang-direction\",\"1\":\"skiplinks\",\"2\":[\"control-titles\",\"1\"],\"3\":[\"input-titles\",\"1\"],\"timestamp\":1715732297}','/','','publish','closed','closed','','2150','','','2024-05-15 00:18:17','2024-05-15 00:18:17','',0,'http://localhost/wpa-stats/2150/',0,'wpa-stats','',0),(2151,1,'2024-05-15 00:18:46','2024-05-15 00:18:46','{\"0\":\"html-lang-direction\",\"1\":\"skiplinks\",\"2\":[\"control-titles\",\"3\"],\"3\":[\"input-titles\",\"1\"],\"timestamp\":1715732326}','/media-releases/citizen-science-project/','','publish','closed','closed','','media-releases-citizen-science-project','','','2024-05-15 00:18:46','2024-05-15 00:18:46','',0,'http://localhost/wpa-stats/media-releases-citizen-science-project/',0,'wpa-stats','',0),(2152,1,'2024-05-15 00:32:13','2024-05-15 00:32:13','','dd-header-bg','','inherit','open','closed','','dd-header-bg','','','2024-05-15 00:32:30','2024-05-15 00:32:30','',0,'http://localhost/wp-content/uploads/2024/05/dd-header-bg.jpg',0,'attachment','image/jpeg',0),(2153,1,'2024-05-15 00:34:26','2024-05-15 00:34:26','','dd-header-bg-2','','inherit','open','closed','','dd-header-bg-2','','','2024-05-15 00:34:34','2024-05-15 00:34:34','',6,'http://localhost/wp-content/uploads/2024/05/dd-header-bg-2.jpg',0,'attachment','image/jpeg',0),(2154,1,'2024-05-15 00:43:10','2024-05-15 00:43:10','<!-- wp:navigation-link {\"className\":\" menu-item menu-item-type-post_type menu-item-object-page\",\"description\":\"\",\"id\":\"19\",\"kind\":\"post-type\",\"label\":\"About\",\"opensInNewTab\":false,\"rel\":null,\"title\":\"\",\"type\":\"page\",\"url\":\"http://localhost/about/\"} /--><!-- wp:navigation-link {\"className\":\" menu-item menu-item-type-taxonomy menu-item-object-category\",\"description\":\"\",\"id\":\"1\",\"kind\":\"taxonomy\",\"label\":\"Media Releases\",\"opensInNewTab\":false,\"rel\":null,\"title\":\"\",\"type\":\"category\",\"url\":\"http://localhost/category/media-releases/\"} /-->','Footer menu','','publish','closed','closed','','footer-menu','','','2024-05-15 00:43:10','2024-05-15 00:43:10','',0,'http://localhost/footer-menu/',0,'wp_navigation','',0),(2156,1,'2024-05-15 00:46:33','2024-05-15 00:46:33','<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Everybody’s home is different, but we all want the same thing: a place to build a fulfilling life.</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Australia is a rich country, but despite our growing national wealth, for many people the Australian dream seems increasingly out of reach.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:list -->\n<ul><!-- wp:list-item -->\n<li>Renters are seeing huge price increases and insecure tenancy agreements.</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>First home buyers are struggling to scrape together a deposit.</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Low-income families are facing years on the waiting list for social housing.</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list -->\n\n<!-- wp:heading {\"level\":4} -->\n<h4 class=\"wp-block-heading\">Housing policies at the national, state, and local level are failing to provide reasonable pathways for people to find a place to call home.</h4>\n<!-- /wp:heading -->\n\n<!-- wp:video -->\n<figure class=\"wp-block-video\"><video controls src=\"/wp-content/uploads/2024/05/Disability-dialogue-Master.mp4\"></video></figure>\n<!-- /wp:video -->','Home','','inherit','closed','closed','','6-revision-v1','','','2024-05-15 00:46:33','2024-05-15 00:46:33','',6,'http://localhost/?p=2156',0,'revision','',0),(2157,1,'2024-05-15 01:05:50','2024-05-15 01:05:50','','Disability-dialogue-logo-rev','','inherit','open','closed','','disability-dialogue-logo-rev','','','2024-05-15 01:06:04','2024-05-15 01:06:04','',0,'http://localhost/wp-content/uploads/2024/05/Disability-dialogue-logo-rev.png',0,'attachment','image/png',0),(2158,1,'2024-05-15 01:07:56','2024-05-15 01:07:56','<!-- wp:paragraph -->\n<p>The Disability Dialogue is a place where people with disabilities, their families, organisations providing support, academics, and the wider community come together to work on things that matter to us.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>The Dialogue is a hub of knowledge and collaboration, separate from government, where we work together to come up. With new ideas on important topics. Our ideas can make a big difference in how services and systems are set up for people with disabilities.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:video -->\n<figure class=\"wp-block-video\"><video controls src=\"/wp-content/uploads/2024/05/Disability-dialogue-Master.mp4\"></video></figure>\n<!-- /wp:video -->','Home','','inherit','closed','closed','','6-revision-v1','','','2024-05-15 01:07:56','2024-05-15 01:07:56','',6,'http://localhost/?p=2158',0,'revision','',0),(2159,1,'2024-05-15 01:08:12','2024-05-15 01:08:12','<!-- wp:paragraph -->\n<p>The Disability Dialogue is a place where people with disabilities, their families, organisations providing support, academics, and the wider community come together to work on things that matter to us.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>The Dialogue is a hub of knowledge and collaboration, separate from government, where we work together to come up. With new ideas on important topics. Our ideas can make a big difference in how services and systems are set up for people with disabilities.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:video -->\n<figure class=\"wp-block-video\"><video controls src=\"/wp-content/uploads/2024/05/Disability-dialogue-Master.mp4\"></video></figure>\n<!-- /wp:video -->','Home','','inherit','closed','closed','','6-revision-v1','','','2024-05-15 01:08:12','2024-05-15 01:08:12','',6,'http://localhost/?p=2159',0,'revision','',0),(2160,1,'2024-05-15 02:01:56','2024-05-15 02:01:56','<!-- wp:video -->\n<figure class=\"wp-block-video\"><video controls src=\"/wp-content/uploads/2024/05/Disability-dialogue-Master.mp4\"></video></figure>\n<!-- /wp:video -->','Home','','inherit','closed','closed','','6-revision-v1','','','2024-05-15 02:01:56','2024-05-15 02:01:56','',6,'http://localhost/?p=2160',0,'revision','',0),(2161,1,'2024-05-15 02:14:46','2024-05-15 02:14:46','<!-- wp:video -->\n<figure class=\"wp-block-video\"><video controls src=\"/wp-content/uploads/2024/05/Disability-dialogue-Master.mp4\"></video></figure>\n<!-- /wp:video -->','Home','','inherit','closed','closed','','6-revision-v1','','','2024-05-15 02:14:46','2024-05-15 02:14:46','',6,'http://localhost/?p=2161',0,'revision','',0),(2163,1,'2024-05-15 02:16:48','2024-05-15 02:16:48','<!-- wp:video -->\n<figure class=\"wp-block-video\"><video controls src=\"/wp-content/uploads/2024/05/Disability-dialogue-Master.mp4\"></video></figure>\n<!-- /wp:video -->','Home','','inherit','closed','closed','','6-revision-v1','','','2024-05-15 02:16:48','2024-05-15 02:16:48','',6,'http://localhost/?p=2163',0,'revision','',0),(2164,1,'2024-05-15 02:17:30','2024-05-15 02:17:30','<!-- wp:video -->\n<figure class=\"wp-block-video\"><video controls src=\"/wp-content/uploads/2024/05/Disability-dialogue-Master.mp4\"></video></figure>\n<!-- /wp:video -->','Home','','inherit','closed','closed','','6-revision-v1','','','2024-05-15 02:17:30','2024-05-15 02:17:3