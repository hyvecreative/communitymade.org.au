ength\";s:0:\"\";s:11:\"placeholder\";s:0:\"\";s:7:\"prepend\";s:0:\"\";s:6:\"append\";s:0:\"\";}','Partner logo 2 url','partner_logo_2_url','publish','closed','closed','','field_640fbe7a51dce','','','2023-03-14 00:24:36','2023-03-14 00:24:36','',715,'http://localhost/?post_type=acf-field&#038;p=1717',6,'acf-field','',0),(1722,1,'2023-03-14 01:25:44','2023-03-14 01:25:44','<!-- wp:heading {\"level\":3} -->\n<h3>Everybody’s home is different, but we all want the same thing: a place to build a fulfilling life.</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Australia is a rich country, but despite our growing national wealth, for many people the Australian dream seems increasingly out of reach.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:list -->\n<ul><!-- wp:list-item -->\n<li>Renters are seeing huge price increases and insecure tenancy agreements.</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>First home buyers are struggling to scrape together a deposit.</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Low-income families are facing years on the waiting list for social housing.</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list -->\n\n<!-- wp:paragraph -->\n<p>Housing policies at the national, state, and local level are failing to provide reasonable pathways for people to find a place to call home.</p>\n<!-- /wp:paragraph -->','Home','','inherit','closed','closed','','6-revision-v1','','','2023-03-14 01:25:44','2023-03-14 01:25:44','',6,'http://localhost/?p=1722',0,'revision','',0),(1730,1,'2023-03-22 04:58:04','2023-03-22 04:58:04','a:17:{s:10:\"aria-label\";s:0:\"\";s:4:\"type\";s:5:\"image\";s:12:\"instructions\";s:0:\"\";s:8:\"required\";i:0;s:17:\"conditional_logic\";i:0;s:7:\"wrapper\";a:3:{s:5:\"width\";s:0:\"\";s:5:\"class\";s:0:\"\";s:2:\"id\";s:0:\"\";}s:13:\"return_format\";s:5:\"array\";s:7:\"library\";s:3:\"all\";s:9:\"min_width\";s:0:\"\";s:10:\"min_height\";s:0:\"\";s:8:\"min_size\";s:0:\"\";s:9:\"max_width\";s:0:\"\";s:10:\"ma