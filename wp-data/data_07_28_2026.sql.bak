b85f5'),(197727,2721,'signup_subhead','Queenslanders are coming together to protect our beautiful state and safeguard our way of life.'),(197728,2721,'_signup_subhead','field_64fd834dd90ab'),(197729,2721,'signup_form','[actionnetwork id=7]'),(197730,2721,'_signup_form','field_64fd8361d90ac'),(197731,2721,'signup_head','Join the campaign'),(197732,2721,'_signup_head','field_64fd83dc6b0b1'),(197733,2721,'boxes_section_title','Boxes'),(197734,2721,'_boxes_section_title','field_65262bbfd17fc'),(197735,2721,'intro_boxes_0_box_icon','1943'),(197736,2721,'_intro_boxes_0_box_icon','field_65262db5d36ee'),(197737,2721,'intro_boxes_0_box_title','Events'),(197738,2721,'_intro_boxes_0_box_title','field_65262d29ed8e3'),(197739,2721,'intro_boxes_0_box_dropdown','Our rigorous, conflict-free research and data analysis lifts the lid on fund performance, fees and insurance. Drawing on our policy expertise, we turn this analysis into action by using it to back reform and make super easier for people to understand. <a href=\"//localhost:4000:4000:4000:4000:4000:4000:/how/\">More</a>'),(197740,2721,'_intro_boxes_0_box_dropdown','field_65262dead0a0c'),(197741,2721,'intro_boxes_1_box_icon','1941'),(197742,2721,'_intro_boxes_1_box_icon','field_65262db5d36ee'),(197743,2721,'intro_boxes_1_box_title','Projects'),(197744,2721,'_intro_boxes_1_box_title','field_65262d29ed8e3'),(197745,2721,'intro_boxes_1_box_dropdown','Our rigorous, conflict-free research and data analysis lifts the lid on fund performance, fees and insurance. Drawing on our policy expertise, we turn this analysis into action by using it to back reform and make super easier for people to understand. <a href=\"//localhost:4000:4000:4000:4000:4000:4000:/how/\">More</a>'),(197746,2721,'_intro_boxes_1_box_dropdown','field_65262dead0a0c'),(197747,2721,'intro_boxes_2_box_icon','1937'),(197748,2721,'_intro_boxes_2_box_icon','field_65262db5d36ee'),(197749,2721,'intro_boxes_2_box_title','Ideas'),(197750,2721,'_intro_boxes_2_box_title','field_65262d29ed8e3'),(197751,2721,'intro_boxes_2_box_dropdown','Our rigorous, conflict-free research and data analysis lifts the lid on fund performance, fees and insurance. Drawing on our policy expertise, we turn this analysis into action by using it to back reform and make super easier for people to understand. <a href=\"//localhost:4000:4000:4000:4000:4000:4000:/how/\">More</a>'),(197752,2721,'_intro_boxes_2_box_dropdown','field_65262dead0a0c'),(197753,2721,'intro_boxes','3'),(197754,2721,'_intro_boxes','field_65262d14ed8e2'),(197755,2721,'get_help_section_title','Get Help'),(197756,2721,'_get_help_section_title','field_65262c35143de'),(197757,2721,'get_help_block_home',''),(197758,2721,'_get_help_block_home','field_65262c8a143e1'),(197759,2721,'gh_block_home_0_help_image','1956'),(197760,2721,'_gh_block_home_0_help_image','field_65262cd0143e2'),(197761,2721,'gh_block_home_0_help_title','How much do I need to retire? '),(197762,2721,'_gh_block_home_0_help_title','field_65262cec143e3'),(197763,2721,'gh_block_home_0_help_url','#'),(197764,2721,'_gh_block_home_0_help_url','field_65262cf4143e4'),(197765,2721,'gh_block_home_1_help_image','1962'),(197766,2721,'_gh_block_home_1_help_image','field_65262cd0143e2'),(197767,2721,'gh_block_home_1_help_title','I have a problem with  my super fund'),(197768,2721,'_gh_block_home_1_help_title','field_65262cec143e3'),(197769,2721,'gh_block_home_1_help_url','#'),(197770,2721,'_gh_block_home_1_help_url','field_65262cf4143e4'),(197771,2721,'gh_block_home_2_help_image','1961'),(197772,2721,'_gh_block_home_2_help_image','field_65262cd0143e2'),(197773,2721,'gh_block_home_2_help_title','How do I choose the right super? '),(197774,2721,'_gh_block_home_2_help_title','field_65262cec143e3'),(197775,2721,'gh_block_home_2_help_url','#'),(197776,2721,'_gh_block_home_2_help_url','field_65262cf4143e4'),(197777,2721,'gh_block_home','3'),(197778,2721,'_gh_block_home','field_65262c8a143e1'),(197779,2721,'turn_on_insights',''),(197780,2721,'_turn_on_insights','field_645c4a2e654a6'),(197781,2721,'report_questions','a:3:{i:0;s:2:\"59\";i:1;s:2:\"61\";i:2;s:4:\"2587\";}'),(197782,2721,'_report_questions','field_6109ed5e02e5a'),(197783,2721,'intro_text','The Disability Dialogue is a place where people with disabilities, their families, organisations providing support, academics, and the wider community come together to work on things that matter to us.\r\n\r\nThe Dialogue is a hub of knowledge and collaboration, separate from government, where we work together to come up. With new ideas on important topics. Our ideas can make a big difference in how services and systems are set up for people with disabilities.'),(197784,2721,'_intro_text','field_66441acfe963c'),(197785,2721,'word_link','#'),(197786,2721,'_word_link','field_6646c69723804'),(197787,2721,'pdf_link','#'),(197788,2721,'_pdf_link','field_6646c6da23805'),(197789,2721,'intro_boxes_0_box_image','2241'),(197790,2721,'_intro_boxes_0_box_image','field_65262db5d36ee'),(197791,2721,'intro_boxes_1_box_image','2179'),(197792,2721,'_intro_boxes_1_box_image','field_65262db5d36ee'),(197793,2721,'intro_boxes_2_box_image','2012'),(197794,2721,'_intro_boxes_2_box_image','field_65262db5d36ee'),(197795,2721,'intro_boxes_0_box_excerpt','Excerpt text here just a sentance or so and no more.'),(197796,2721,'_intro_boxes_0_box_excerpt','field_665975273e827'),(197797,2721,'intro_boxes_1_box_excerpt','Excerpt text here just a sentance or so and no more.'),(197798,2721,'_intro_boxes_1_box_excerpt','field_665975273e827'),(197799,2721,'intro_boxes_2_box_excerpt','Excerpt text here just a sentance or so and no more.'),(197800,2721,'_intro_boxes_2_box_excerpt','field_665975273e827'),(197801,2721,'intro_boxes_0_btn-text','Latest events'),(197802,2721,'_intro_boxes_0_btn-text','field_665abda8b8d4b'),(197803,2721,'intro_boxes_1_btn-text','Latest projects'),(197804,2721,'_intro_boxes_1_btn-text','field_665abda8b8d4b'),(197805,2721,'intro_boxes_2_btn-text','Latest ideas'),(197806,2721,'_intro_boxes_2_btn-text','field_665abda8b8d4b'),(197807,2721,'display-easy-read',''),(197808,2721,'_display-easy-read','field_666129bd2da00'),(197809,2721,'hm_hero_sum','Statement about the issue and lost life savings'),(197810,2721,'_hm_hero_sum','field_64ed37241effa'),(197811,2721,'hm_hero_sub','When housing is affordable, communities thrive – that’s what  community made means. Homes built and managed by not-for-profits with purpose, not profit.'),(197812,2721,'_hm_hero_sub','field_64ed37241effa'),(197813,2721,'intro_head','We’re here to help.'),(197814,2721,'_intro_head','field_64e828783ad9f'),(197815,2721,'intro_content','About 12,000 people invested their hard-earned super savings in two investment funds which have now collapsed, called Shield Master Fund and First Guardian Master Fund. Most people will be entitled to get some money back, but you need to take action soon. This website has information and tools to help you understand what happened, where to get help and how to take back your super.'),(197816,2721,'_intro_content','field_66441acfe963c'),(197817,2721,'deadline_heading','Important deadlines'),(197818,2721,'_deadline_heading','field_69365ff82e6f2'),(197819,2721,'deadline_content','You need to take action before the deadline to take your super back.'),(197820,2721,'_deadline_content','field_693660342e6f3'),(197821,2721,'deadline_button_text','Find out more'),(197822,2721,'_deadline_button_text','field_693660482e6f4'),(197823,2721,'deadline_button_url','/key-deadlines/'),(197824,2721,'_deadline_button_url','field_693660912e6f5'),(197825,2721,'what_head','Get involved'),(197826,2721,'_what_head','field_69366611096ac'),(197827,2721,'what_happened_0_happ_sub','Take action here...'),(197828,2721,'_what_happened_0_happ_sub','field_693d4a8b4197d'),(197829,2721,'what_happened_0_happ_content','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut laoreet dolore magna aliquam erat volutpat. Ut wisi enim ad minim ve