ervices/\">View all services</a>'),(39624,1528,'_support_left_button','field_5b67c60ae7f92'),(39625,1528,'support_ctr_title','Talk to us'),(39626,1528,'_support_ctr_title','field_5b67c62a58af3'),(39627,1528,'support_ctr_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut laoreet.'),(39628,1528,'_support_ctr_cont','field_5b67c63158af4'),(39629,1528,'support_ctr_button','<a class=\"btn btn-orange\" href=\"/supports/\">Find us</a>'),(39630,1528,'_support_ctr_button','field_5b67c63658af5'),(39631,1528,'support_right_title','NDIS Registered provider'),(39632,1528,'_support_right_title','field_5b67c6a38c064'),(39633,1528,'support_right_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut.'),(39634,1528,'_support_right_cont','field_5b67c6c98c065'),(39635,1528,'support_right_button','<a class=\"btn btn-blue\" href=\"#\">Read more</a>'),(39636,1528,'_support_right_button','field_5b67c6dd8c066'),(39637,1528,'first_image_title','Lifestart is about supporting young children'),(39638,1528,'_first_image_title','field_5b67ca606afc4'),(39639,1528,'first_image_cont','from 0-24 years living with disabilities and their familes'),(39640,1528,'_first_image_cont','field_5b67caff6afc5'),(39641,1528,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(39642,1528,'_first_image_button','field_5b67cb0d6afc6'),(39643,1528,'second _image_title','Lifestart is about supporting young children'),(39644,1528,'_second _image_title','field_5b67cb20ddf9a'),(39645,1528,'second_image_cont','from 0-24 years living with disabilities and their familes'),(39646,1528,'_second_image_cont','field_5b67cb24ddf9b'),(39647,1528,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(39648,1528,'_second_image_button','field_5b67cb29ddf9c'),(39649,1528,'second_image_title','Lifestart is about supporting young children'),(39650,1528,'_second_image_title','field_5b67cb20ddf9a'),(39651,1528,'page_col_image','412'),(39652,1528,'_page_col_image','field_5de6546e7c63a'),(39653,1528,'page_col_image_3','437'),(39654,1528,'_page_col_image_3','field_5de6e3998e07e'),(39655,1528,'sec_2_title','Community'),(39656,1528,'_sec_2_title','field_5de6e3ef2798f'),(39657,1528,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(39658,1528,'_sec_2_text','field_5de78dc89e613'),(39659,1528,'sec_3_title','The Project'),(39660,1528,'_sec_3_title','field_5de6e3d37d8da'),(39661,1528,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(39662,1528,'_sec_3_text','field_5de6e4044e5e8'),(39663,1528,'page_col_image_2','436'),(39664,1528,'_page_col_image_2','field_5de6546e7c63a'),(39665,1528,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(39666,1528,'_sec_2_button','field_5de6e58c86706'),(39667,1528,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(39668,1528,'_sec_3_button','field_5de6e5a243c03'),(39669,1528,'page_col_image_4','455'),(39670,1528,'_page_col_image_4','field_5de70801090ce'),(39671,1528,'sec_4_title','Location'),(39672,1528,'_sec_4_title','field_5de7082a12a81'),(39673,1528,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(39674,1528,'_sec_4_text','field_5de7084812a82'),(39675,1528,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(39676,1528,'_sec_4_button','field_5de7085e12a83'),(39677,1528,'news_title','Project updates'),(39678,1528,'_news_title','field_5de78da3aabb9'),(39679,1528,'sec_2_text_copy',''),(39680,1528,'_sec_2_text_copy','field_5de78dc89e613'),(39681,1528,'timeline-title','Timeline'),(39682,1528,'_timeline-title','field_5de78df29e615'),(39683,1528,'timeline_title','Timeline'),(39684,1528,'_timeline_title','field_5de78df29e615'),(39685,1528,'contact_title','Contact us'),(39686,1528,'_contact_title','field_5de7981e06057'),(39687,1528,'contact_intro','Contact text...'),(39688,1528,'_contact_intro','field_5de7983506058'),(39689,1528,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(39690,1528,'_news_button','field_5de8329896e02'),(39691,1528,'timeline_intro','Introduction of timeline detail...'),(39692,1528,'_timeline_intro','field_5de98f5fb1781'),(39693,1528,'timeline_pic','477'),(39694,1528,'_timeline_pic','field_5de98f72b1782'),(39695,1528,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(39696,1528,'_timeline_button','field_5de99363677f8'),(39697,1528,'banner_image_position','center'),(39698,1528,'_banner_image_position','field_5f3bc4757dd02'),(39699,1528,'services_title','Our services'),(39700,1528,'_services_title','field_5f20f3cd80eb2'),(39701,1528,'services_items_0_services_item_image','1061'),(39702,1528,'_services_items_0_services_item_image','field_5f2121355be14'),(39703,1528,'services_items_0_sservices_item_title','1300 Telephone counselling line'),(39704,1528,'_services_items_0_sservices_item_title','field_605089efca82e'),(39705,1528,'services_items_0_services_item_text',''),(39706,1528,'_services_items_0_services_item_text','field_5f21