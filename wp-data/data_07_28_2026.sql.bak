),(69818,1857,'problem_icons_3_prob_issue_text',''),(69819,1857,'_problem_icons_3_prob_issue_text','field_640fa11a81d97'),(69820,1857,'problem_icons_0_prob_concerned_text','House prices have doubled in a decade'),(69821,1857,'_problem_icons_0_prob_concerned_text','field_640fa10181d96'),(69822,1857,'problem_icons_1_prob_concerned_text','The gap between rich and poor is growing'),(69823,1857,'_problem_icons_1_prob_concerned_text','field_640fa10181d96'),(69824,1857,'problem_icons_2_prob_concerned_text','Construction of social housing is down'),(69825,1857,'_problem_icons_2_prob_concerned_text','field_640fa10181d96'),(69826,1857,'problem_icons_3_prob_concerned_text','Banks are making more than ever from housing'),(69827,1857,'_problem_icons_3_prob_concerned_text','field_640fa10181d96'),(69828,1857,'monitor_content','The Australian Housing Monitor is a large, nationally-representative survey covering public experiences and attitudes toward housing related issues. Questions range from how well the respondent is keeping up with their mortgage/rent, to what they think about social housing construction.\r\n\r\nA broad range of demographic criteria are included, such as gender, location, age, income, voting preference, educational level, tenure type, and employment status. These variables allow CEH researchers to understand the trends and diversity of opinion around the country.\r\n\r\nIt also incorporates questions from previous surveys to track trends over time.\r\nThe inaugural poll was conducted by Essential in December 2022, and was completed by 4,735 people.'),(69829,1857,'_monitor_content','field_640fcc4014404'),(69830,1857,'problem_head','Housing in Australia is not working, and Australians are concerned.'),(69831,1857,'_problem_head','field_641935436aded'),(69832,1857,'problem_signoff','Explore the research showing how concerned Australians are our about the housing situation.'),(69833,1857,'_problem_signoff','field_641935626adee'),(69834,1857,'sections','a:2:{i:0;s: