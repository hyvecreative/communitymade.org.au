INSERT INTO `wp_postmeta` VALUES (120267,2159,'solutions_content','The housing system is complex, and no one solution will solve the complex problems we now face but there are some critical first steps to be taken now.\r\n<ul>\r\n 	<li>Set out an ambitious national housing agreement between commonwealth and state governments with targets and funding for the construction of affordable homes.</li>\r\n 	<li>Phase out tax breaks for property investors and using the increase in revenue to build more public housing.</li>\r\n 	<li>Establish laws which limit rental increases beyond what is fair.</li>\r\n 	<li>Rebalance tenancy laws to provide renters with more security and control, such as eliminating no grounds evictions.</li>\r\n 	<li>Phase out stamp duty and replace it with a broad-based land tax.</li>\r\n</ul>\r\n<h4>While there are many opinions on what policy changes will fix the housing market, doing nothing is not an option.</h4>'),(120268,2159,'_solutions_content','field_640e8b307a958'),(120269,2159,'problem_icons_0_prob_icon','1699'),(120270,2159,'_problem_icons_0_prob_icon','field_640fa0291d519'),(120271,2159,'problem_icons_0_prob_concerned_stat','70% highly concerned'),(120272,2159,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(120273,2159,'problem_icons_0_prob_concerded_text','are highly concerned'),(120274,2159,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(120275,2159,'problem_icons_0_prob_issue_text',''),(120276,2159,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(120277,2159,'problem_icons','4'),(120278,2159,'_problem_icons','field_640fa0191d518'),(120279,2159,'ceh_content_left',''),(120280,2159,'_ceh_content_left','field_640e97e8f1c8c'),(120281,2159,'ceh_content_right',''),(120282,2159,'_ceh_content_right','field_640e97fdf1c8d'),(120283,2159,'pc_content_left',''),(120284,2159,'_pc_content_left','field_640e983bf1c8f'),(120285,2159,'pc_content_right',''),(120286,2159,'_pc_content_right','field_640e984df1c90'),(120287,2159,'problem_icons_1_prob_icon','1699'),(120288,2159,'_problem_icons_1_prob_icon','field_640fa0291d519'),(120289,2159,'problem_icons_1_prob_concerned_stat','69% highly concerned'),(120290,2159,'_problem_icons_1_prob_concerned_stat','field_640fa0dd81d95'),(120291,2159,'problem_icons_1_prob_concerded_text','are highly concerned'),(120292,2159,'_problem_icons_1_prob_concerded_text','field_640fa10181d96'),(120293,2159,'problem_icons_1_prob_issue_text',''),(120294,2159,'_problem_icons_1_prob_issue_text','field_640fa11a81d97'),(120295,2159,'problem_icons_2_prob_icon','1699'),(120296,2159,'_problem_icons_2_prob_icon','field_640fa0291d519'),(120297,2159,'problem_icons_2_prob_concerned_stat','64% highly concerned'),(120298,2159,'_problem_icons_2_prob_concerned_stat','field_640fa0dd81d95'),(120299,2159,'problem_icons_2_prob_concerded_text','are highly concerned'),(120300,2159,'_problem_icons_2_prob_concerded_text','field_640fa10181d96'),(120301,2159,'problem_icons_2_prob_issue_text',''),(120302,2159,'_problem_icons_2_prob_issue_text','field_640fa11a81d97'),(120303,2159,'problem_icons_3_prob_icon','1699'),(120304,2159,'_problem_icons_3_prob_icon','field_640fa0291d519'),(120305,2159,'problem_icons_3_prob_concerned_stat','64% highly concerned'),(120306,2159,'_problem_icons_3_prob_concerned_stat','field_640fa0dd81d95'),(120307,2159,'problem_icons_3_prob_concerded_text','are highly concerned'),(120308,2159,'_problem_icons_3_prob_concerded_text','field_640fa10181d96'),(120309,2159,'problem_icons_3_prob_issue_text',''),(120310,2159,'_problem_icons_3_prob_issue_text','field_640fa11a81d97'),(120311,2159,'problem_icons_0_prob_concerned_text','House prices have doubled in a decade'),(120312,2159,'_problem_icons_0_prob_concerned_text','field_640fa10181d96'),(120313,2159,'problem_icons_1_prob_concerned_text','The gap between rich and poor is growing'),(120314,2159,'_problem_icons_1_prob_concerned_text','field_640fa10181d96'),(120315,2159,'problem_icons_2_prob_concerned_text','Construction of social housing is down'),(120316,2159,'_problem_icons_2_prob_concerned_text','field_640fa10181d96'),(120317,2159,'problem_icons_3_prob_concerned_text','Banks are making more than ever from housing'),(120318,2159,'_problem_icons_3_prob_concerned_text','field_640fa10181d96'),(120319,2159,'monitor_content','The Australian Housing Monitor is a large, nationally-representative survey covering public experiences and attitudes toward housing related issues. Questions range from how well the respondent is keeping up with their mortgage/rent, to what they think about social housing construction.\r\n\r\nA broad range of demographic criteria are included, such as gender, location, age, income, voting preference, educational level, tenure type, and employment status. These variables allow CEH researchers to understand the trends and diversity of opinion around the country.\r\n\r\nIt also incorporates questions from previous surveys to track trends over time.\r\nThe inaugural poll was conducted by Essential in December 2022, and was completed by 4,735 people.'),(120320,2159,'_monitor_content','field_640fcc4014404'),(120321,2159,'problem_head','Housing in Australia is not working, and Australians are concerned.'),(120322,2159,'_problem_head','field_641935436aded'),(120323,2159,'problem_signoff','Explore the research showing how concerned Australians are our about the housing situation.'),(120324,2159,'_problem_signoff','field_641935626adee'),(120325,2159,'sections','a:2:{i:0;s:4:\"hero\";i:1;s:9:\"news_grid\";}'),(120326,2159,'_sections','field_5dafb40b8143a'),(120327,2159,'sections_0_is_full_height','1'),(120328,2159,'_sections_0_is_full_height','field_61d6f6fd5a37e'),(120329,2159,'sections_0_image','1648'),(120330,2159,'_sections_0_image','field_61d6f6d45a37d'),(120331,2159,'sections_0_heading','Heading'),(120332,2159,'_sections_0_heading','field_61d6f69e5a379'),(120333,2159,'sections_0_subtitle','Ya ya '),(120334,2159,'_sections_0_subtitle','field_61d6f6ac5a37a'),(120335,2159,'sections_0_link_one',''),(120336,2159,'_sections_0_link_one','field_61d6f6b55a37b'),(120337,2159,'sections_0_link_two',''),(120338,2159,'_sections_0_link_two','field_61d6f6c35a37c'),(120339,2159,'sections_1_select_categories','a:1:{i:0;s:2:\"27\";}'),(120340,2159,'_sections_1_select_categories','field_637f04483b63b'),(120341,2159,'intro_head_major','Super Consumers Australia is <span>fighting</span> to ensure that the superannuation industry is <span>held accountable</span> for the outcomes they deliver to Australian consumers.'),(120342,2159,'_intro_head_major','field_64e828783ad9f'),(120343,2159,'intro_head_minor','We want super to work for everyone—not just super fund companies. With our research, journalism and campaigns we are creating the trustworthy and transparent superannuation system we all deserve.'),(120344,2159,'_intro_head_minor','field_64e8288c3ada0'),(120345,2159,'intro_icons_0_int_icon','1922'),(120346,2159,'_intro_icons_0_int_icon','field_64e828b33ada2'),(120347,2159,'intro_icons_0_int_icon_text','At 1,727,000 square kilometres, we’re 2.5 times the size of Texas. <span>Yeeha!</span>'),(120348,2159,'_intro_icons_0_int_icon_text','field_64e828e33ada3'),(120349,2159,'intro_icons_1_int_icon','1920'),(120350,2159,'_intro_icons_1_int_icon','field_64e828b33ada2'),(120351,2159,'intro_icons_1_int_icon_text','We have twice as many species of native plant and animal as any other Australian state or territory.'),(120352,2159,'_intro_icons_1_int_icon_text','field_64e828e33ada3'),(120353,2159,'intro_icons_2_int_icon','1921'),(120354,2159,'_intro_icons_2_int_icon','field_64e828b33ada2'),(120355,2159,'intro_icons_2_int_icon_text','We have less land classified as ‘protected’ than any other state or territory.'),(120356,2159,'_intro_icons_2_int_icon_text','field_64e828e33ada3'),(120357,2159,'intro_icons','3'),(120358,2159,'_intro_icons','field_64e828963ada1'),(120359,2159,'threat_head_major','What we stand to lose if we don’t act soon to protect beautiful Qu