UNLOCK TABLES;

--
-- Table structure for table `wp_posts`
--

DROP TABLE IF EXISTS `wp_posts`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!50503 SET character_set_client = utf8mb4 */;
CREATE TABLE `wp_posts` (
  `ID` bigint unsigned NOT NULL AUTO_INCREMENT,
  `post_author` bigint unsigned NOT NULL DEFAULT '0',
  `post_date` datetime NOT NULL DEFAULT '0000-00-00 00:00:00',
  `post_date_gmt` datetime NOT NULL DEFAULT '0000-00-00 00:00:00',
  `post_content` longtext CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_520_ci NOT NULL,
  `post_title` text CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_520_ci NOT NULL,
  `post_excerpt` text CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_520_ci NOT NULL,
  `post_status` varchar(20) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_520_ci NOT NULL DEFAULT 'publish',
  `comment_status` varchar(20) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_520_ci NOT NULL DEFAULT 'open',
  `ping_status` varchar(20) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_520_ci NOT NULL DEFAULT 'open',
  `post_password` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_520_ci NOT NULL DEFAULT '',
  `post_name` varchar(200) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_520_ci NOT NULL DEFAULT '',
  `to_ping` text CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_520_ci NOT NULL,
  `pinged` text CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_520_ci NOT NULL,
  `post_modified` datetime NOT NULL DEFAULT '0000-00-00 00:00:00',
  `post_modified_gmt` datetime NOT NULL DEFAULT '0000-00-00 00:00:00',
  `post_content_filtered` longtext CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_520_ci NOT NULL,
  `post_parent` bigint unsigned NOT NULL DEFAULT '0',
  `guid` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_520_ci NOT NULL DEFAULT '',
  `menu_order` int NOT NULL DEFAULT '0',
  `post_type` varchar(20) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_520_ci NOT NULL DEFAULT 'post',
  `post_mime_type` varchar(100) CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_520_ci NOT NULL DEFAULT '',
  `comment_count` bigint NOT NULL DEFAULT '0',
  PRIMARY KEY (`ID`),
  KEY `post_name` (`post_name`(191)),
  KEY `type_status_date` (`post_type`,`post_status`,`post_date`,`ID`),
  KEY `post_parent` (`post_parent`),
  KEY `post_author` (`post_author`),
  KEY `type_status_author` (`post_type`,`post_status`,`post_author`)
) ENGINE=InnoDB AUTO_INCREMENT=2789 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_520_ci;
/*!40101 SET character_set_client = @saved_cs_client */;

--
-- Dumping data for table `wp_posts`
--

LOCK TABLES `wp_posts` WRITE;
/*!40000 ALTER TABLE `wp_posts` DISABLE KEYS */;
INSERT INTO `wp_posts` VALUES (1,1,'2018-07-25 08:56:42','2018-07-25 08:56:42','Welcome to WordPress. This is your first post. Edit or delete it, then start writing!','Hello world!','','publish','open','open','','hello-world','','','2024-06-02 06:14:35','2024-06-02 06:14:35','',0,'http://localhost/?p=1',0,'post','',1),(6,1,'2017-04-05 09:15:05','2017-04-05 09:15:05','','Home-dev','','publish','closed','closed','','home','','','2024-06-02 23:59:40','2024-06-02 23:59:40','',0,'http://localhost/?page_id=6',0,'page','',0),(19,1,'2017-04-05 21:00:14','2017-04-05 21:00:14','<!-- wp:heading -->\n<h2 class=\"wp-block-heading\">The Campaign</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Community Made is a campaign celebrating the people who live in community housing<strong>.</strong>&nbsp; residents, providers and experts across NSW to call for urgent action.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>Right now, housing affordability is the issue keeping people across NSW up at night. Rents and cost-of-living pressures keep climbing, social housing waitlists are at record highs, and home ownership is out of reach for a growing number of households.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p><strong>The pressure is real, and it’s growing. But a clear solution is already here – and it’s working.</strong></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>Across NSW, not-for-profit community housing providers are building and managing social and affordable rental homes that are here for the long term. The model works. What’s missing is the scale of investment to match the need.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>With the State election ahead, there’s a clear window of opportunity to change that. This is the moment to put community housing at the heart of the election.</p>\n<!-- /wp:paragraph -->','About us','','publish','closed','closed','','about-us','','','2026-07-22 07:16:24','2026-07-22 07:16:24','',0,'http://localhost/?page_id=19',0,'page','',0),(42,1,'2017-04-25 09:09:55','2017-04-25 09:09:55','','Event item one','','publish','open','open','','event','','','2017-04-25 09:09:55','2017-04-25 09:09:55','',0,'http://localhost/?p=42',0,'post','',0),(44,1,'2017-04-25 09:12:27','2017-04-25 09:12:27','<!-- wp:paragraph -->\n<p>Content...</p>\n<!-- /wp:paragraph -->','Event item two','','publish','open','open','','event-2','','','2025-12-16 00:19:20','2025-12-16 00:19:20','',0,'http://localhost/?p=44',0,'post','',0),(57,1,'2017-05-08 01:56:48','2017-05-08 01:56:48','Content','News item one','News item one excerpt','publish','open','open','','news-item-one','','','2017-05-08 01:56:48','2017-05-08 01:56:48','',0,'http://localhost/?p=57',0,'post','',0),(59,1,'2017-05-08 01:57:28','2017-05-08 01:57:28','News item two longer link title over two lines','News item two longer link title over two lines','Excerpt here','publish','open','open','','news-item-two-longer-link-title-over-two-lines','','','2017-05-08 01:57:28','2017-05-08 01:57:28','',0,'http://localhost/?p=59',0,'post','',0),(61,1,'2017-05-08 01:58:15','2017-05-08 01:58:15','Content','News item three','Excerpt news item three','publish','open','open','','news-item-three','','','2019-12-15 09:57:51','2019-12-15 09:57:51','',0,'http://localhost/?p=61',0,'post','',0),(65,1,'2017-05-08 02:00:04','2017-05-08 02:00:04','Content...','Event item three longer link title over two lines','Event item three excerpt about two sentences to show decent length','publish','open','open','','event-item-three-longer-link-title-over-two-lines','','','2019-12-15 04:24:34','2019-12-15 04:24:34','',0,'http://localhost/?p=65',0,'post','',0),(85,1,'2018-07-25 09:05:28','2018-07-25 09:05:28',' ','','','publish','closed','closed','','85','','','2018-07-25 09:05:28','2018-07-25 09:05:28','',0,'http://localhost/2018/07/25/',1,'nav_menu_item','',0),(86,1,'2015-07-07 05:32:38','2015-07-07 05:32:38','Welcome to WordPress. This is your first post. Edit or delete it, then start blogging!','Holding post research or publication','','publish','open','open','','holding-post','','','2015-07-07 05:32:38','2015-07-07 05:32:38','',0,'http://localhost/?p=1',0,'post','',1),(135,1,'2017-05-17 11:49:11','2017-05-17 11:49:11','The Occupational Therapy Department at Australian Catholic University (ACU) North Sydney Campus are looking for individuals with a neurological condition to participate in teaching sessions with our 3rd Year students.  This experience is part of a subject they are completing this semester, called \"<em>Interventions for Neurological Conditions</em>\".  The sessions will run in two 1-hour blocks on <strong>Thursday 10<sup>th</sup> September 2015 (Time to be confirmed) </strong>and will be held at the North Sydney campus of ACU.\n\nParticipants will be asked to engage with small groups of students in a practice interview, where students will have a chance to ask you carefully prepared questions about your everyday life  and the changes you have experienced in your life since your stroke.  The information students collect will be used as a basis for an assignment to develop a therapy plan from an initial interview.  Your name will not be used in the assignment to maintain confidentiality. It would be good to hear whether anyone would be willing to lend their time for this activity.\n\nTaxi vouchers for transport will be provided or we can assist with organising parking on campus. We are aware of the positive and influential impact past patients can have on students and feel this experience will be invaluable for them as they prepare to be qualified occupational therapists. I would be happy to provide any other information needed and can be contacted at <a href=\"mailto:Ruth.Swanton@acu.edu.au\">Ruth.Swanton@acu.edu.au</a>','Australian Catholic University North Sydney Campus','','publish','closed','closed','','australian-catholic-university-north-sydney-campus','','','2017-05-17 11:49:11','2017-05-17 11:49:11','',0,'http://localhost/?post_type=stroke_research&amp;p=135',0,'stroke_research','',0),(136,1,'2017-05-17 11:50:54','2017-05-17 11:50:54','Content','Publications test','','publish','closed','closed','','publications-test','','','2017-05-17 11:50:54','2017-05-17 11:50:54','',0,'http://localhost/?post_type=stroke_publications&amp;p=136',0,'stroke_publications','',0),(164,1,'2017-09-18 23:53:15','2017-09-18 23:53:15','lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.','Quote 1','','publish','closed','closed','','quote-1','','','2017-09-18 23:53:15','2017-09-18 23:53:15','',0,'http://localhost/?post_type=slide&amp;p=164',0,'slide','',0),(165,1,'2017-09-18 23:54:51','2017-09-18 23:54:51','Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.','Quote 2','','publish','closed','closed','','quote-2','','','2017-09-18 23:54:51','2017-09-18 23:54:51','',0,'http://localhost/?post_type=slide&amp;p=165',0,'slide','',0),(166,1,'2017-09-19 00:01:31','2017-09-19 00:01:31','Lrrem ipsum. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.','Quote 3','','publish','closed','closed','','quote-3','','','2017-09-19 00:01:31','2017-09-19 00:01:31','',0,'http://localhost/?post_type=slide&amp;p=166',0,'slide','',0),(167,1,'2017-09-19 00:02:20','2017-09-19 00:02:20','Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.','Quote 4','','publish','closed','closed','','quote-4','','','2017-09-19 00:02:20','2017-09-19 00:02:20','',0,'http://localhost/?post_type=slide&amp;p=167',0,'slide','',0),(206,1,'2018-07-25 10:52:51','2018-07-25 10:52:51',' ','','','publish','closed','closed','','206','','','2018-07-25 10:52:51','2018-07-25 10:52:51','',0,'http://localhost/2018/07/25/',1,'nav_menu_item','',0),(230,1,'2018-07-31 02:58:35','2018-07-31 02:58:35','','Home','','inherit','closed','closed','','6-revision-v1','','','2018-07-31 02:58:35','2018-07-31 02:58:35','',6,'http://localhost/2018/07/31/6-revision-v1/',0,'revision','',0),(233,1,'2018-08-01 11:31:45','2018-08-01 11:31:45','','5ac7d493908ed.image','','inherit','open','closed','','5ac7d493908ed-image','','','2018-08-01 11:31:45','2018-08-01 11:31:45','',0,'http://localhost/wp-content/uploads/2018/08/5ac7d493908ed.image_.jpg',0,'attachment','image/jpeg',0),(234,1,'2018-08-01 11:31:46','2018-08-01 11:31:46','','494158036','','inherit','open','closed','','494158036','','','2018-08-01 11:31:46','2018-08-01 11:31:46','',0,'http://localhost/wp-content/uploads/2018/08/494158036.jpg',0,'attachment','image/jpeg',0),(235,1,'2018-08-01 11:31:46','2018-08-01 11:31:46','','535297293','','inherit','open','closed','','535297293','','','2018-08-01 11:31:46','2018-08-01 11:31:46','',0,'http://localhost/wp-content/uploads/2018/08/535297293.jpg',0,'attachment','image/jpeg',0),(236,1,'2018-08-01 11:31:47','2018-08-01 11:31:47','','535350695','','inherit','open','closed','','535350695','','','2018-08-01 11:31:47','2018-08-01 11:31:47','',0,'http://localhost/wp-content/uploads/2018/08/535350695.jpg',0,'attachment','image/jpeg',0),(237,1,'2018-08-01 11:31:48','2018-08-01 11:31:48','','607460526','','inherit','open','closed','','607460526','','','2018-08-01 11:31:48','2018-08-01 11:31:48','',0,'http://localhost/wp-content/uploads/2018/08/607460526.jpg',0,'attachment','image/jpeg',0),(238,1,'2018-08-01 11:31:48','2018-08-01 11:31:48','','626791330','','inherit','open','closed','','626791330','','','2018-08-01 11:31:48','2018-08-01 11:31:48','',0,'http://localhost/wp-content/uploads/2018/08/626791330.jpg',0,'attachment','image/jpeg',0),(239,1,'2018-08-01 11:31:49','2018-08-01 11:31:49','','629667130','','inherit','open','closed','','629667130','','','2018-08-01 11:31:49','2018-08-01 11:31:49','',0,'http://localhost/wp-content/uploads/2018/08/629667130.jpg',0,'attachment','image/jpeg',0),(240,1,'2018-08-01 11:31:50','2018-08-01 11:31:50','','629765166','','inherit','open','closed','','629765166','','','2018-08-01 11:31:50','2018-08-01 11:31:50','',0,'http://localhost/wp-content/uploads/2018/08/629765166.jpg',0,'attachment','image/jpeg',0),(241,1,'2018-08-01 11:34:23','2018-08-01 11:34:23','','Event item three longer link title over two lines','Event item three excerpt about two sentences to show decent length','inherit','closed','closed','','65-revision-v1','','','2018-08-01 11:34:23','2018-08-01 11:34:23','',65,'http://localhost/2018/08/01/65-revision-v1/',0,'revision','',0),(276,1,'2018-08-06 04:03:42','2018-08-06 04:03:42','','Home','','inherit','closed','closed','','6-revision-v1','','','2018-08-06 04:03:42','2018-08-06 04:03:42','',6,'http://localhost/2018/08/06/6-revision-v1/',0,'revision','',0),(277,1,'2018-08-06 04:09:13','2018-08-06 04:09:13','','Home','','inherit','closed','closed','','6-revision-v1','','','2018-08-06 04:09:13','2018-08-06 04:09:13','',6,'http://localhost/2018/08/06/6-revision-v1/',0,'revision','',0),(287,1,'2018-08-06 04:22:48','2018-08-06 04:22:48','','Home','','inherit','closed','closed','','6-revision-v1','','','2018-08-06 04:22:48','2018-08-06 04:22:48','',6,'http://localhost/2018/08/06/6-revision-v1/',0,'revision','',0),(288,1,'2018-08-06 04:27:14','2018-08-06 04:27:14','','Home','','inherit','closed','closed','','6-revision-v1','','','2018-08-06 04:27:14','2018-08-06 04:27:14','',6,'http://localhost/2018/08/06/6-revision-v1/',0,'revision','',0),(289,1,'2018-08-06 05:26:22','2018-08-06 05:26:22','','About','','inherit','closed','closed','','19-revision-v1','','','2018-08-06 05:26:22','2018-08-06 05:26:22','',19,'http://localhost/2018/08/06/19-revision-v1/',0,'revision','',0),(290,1,'2018-08-06 05:30:37','2018-08-06 05:30:37','','About','','inherit','closed','closed','','19-revision-v1','','','2018-08-06 05:30:37','2018-08-06 05:30:37','',19,'http://localhost/2018/08/06/19-revision-v1/',0,'revision','',0),(291,1,'2018-08-06 05:32:48','2018-08-06 05:32:48','','About','','inherit','closed','closed','','19-revision-v1','','','2018-08-06 05:32:48','2018-08-06 05:32:48','',19,'http://localhost/2018/08/06/19-revision-v1/',0,'revision','',0),(292,1,'2018-08-06 05:34:11','2018-08-06 05:34:11','','About','','inherit','closed','closed','','19-revision-v1','','','2018-08-06 05:34:11','2018-08-06 05:34:11','',19,'http://localhost/2018/08/06/19-revision-v1/',0,'revision','',0),(296,1,'2018-08-06 05:50:36','2018-08-06 05:50:36','','About','','inherit','closed','closed','','19-revision-v1','','','2018-08-06 05:50:36','2018-08-06 05:50:36','',19,'http://localhost/2018/08/06/19-revision-v1/',0,'revision','',0),(321,1,'2018-08-06 06:26:27','2018-08-06 06:26:27','','About','','inherit','closed','closed','','19-revision-v1','','','2018-08-06 06:26:27','2018-08-06 06:26:27','',19,'http://localhost/2018/08/06/19-revision-v1/',0,'revision','',0),(334,1,'2018-08-10 01:28:24','2018-08-10 01:28:24','What do we offer?\r\nWe support children and young people living with disability to develop the skills to be part of everyday life in their community.\r\nWe provide flexible, person-centred therapy supports for children and young people aged 0-24 years. Our multidisciplinary teams consist of specialist professionals who are experienced in working with children and young people living with disability. They include:\r\n• speech pathologists\r\n• occupational therapists\r\n• physiotherapists\r\n• behaviour specialists\r\n• social workers and psychologists\r\n• educators.\r\nWe work in partnership with families and carers to provide individualised supports that are responsive to the unique abilities, interests and aspirations of children and young people. We will support you, your child or young person in a place of your choosing which could be in your home, preschool, school, or other places that you spend time.\r\n\r\nLifestart may also use a key worker approach depending on the type of support you require. A key worker is the person you and your family and carers will see and talk to most and may be any one of our specialist professionals depending on your needs and goals.\r\nDo we provide services in your area?\r\nWe provide therapy supports in the Sydney metropolitan area including - Western Sydney, Northern Sydney, Northern Beaches and parts of South Western Sydney, the Inner West and South Eastern Sydney.\r\nWhat is the cost?\r\nCosts vary depending on the service provided. You can use your NDIS funding package (we offer services under the NDIS support areas of Improved Daily Living and Improved Relationships) or pay privately.\r\n\r\nContact us\r\nTo find out more call our Client Engagement Team on 1800 953 390.','Therapy supports','We support children and young people living with disability to develop the skills to be part of everyday life in their community.','publish','closed','closed','','therapy-supports','','','2018-08-10 02:08:46','2018-08-10 02:08:46','',0,'http://localhost/?post_type=lifestart_services&#038;p=334',0,'lifestart_services','',0),(335,1,'2018-08-10 01:55:54','2018-08-10 01:55:54','What do we offer?\r\nOur speech pathologists can work with you, your child or young person to develop communication skills.  Speech Pathologists also have specific skills to support people who have difficulty with eating, drinking or swallowing their food.  \r\nDo you, your child or young person require help to:\r\n•	join in conversations with all the people in your life like family, friends and teachers?\r\n•	understand what people say and learn the words you need to express ideas and feelings?\r\n•	use pictures, signs or technology like Augmentative and Alternate Communication (AAC) devices to communicate?\r\n\r\nA speech pathologist can help you, your child or young person to:\r\n•	develop communication skills in the daily interactions, routines and activities you enjoy\r\n•	learn speech sounds, words and sentences to express ideas\r\n•	understand what words mean and how to follow instructions\r\n•	learn social skills \r\n•	understand and use gestures, signs and pictures to support communication\r\n•	identify technology that can assist with communication and to use the technology e.g. Augmentative and Alternative Communication (AAC) Systems \r\n•	identify specific difficulties with eating and drinking and assist with feeling safe when swallowing.\r\n\r\nDo we provide services in your area?\r\nWe provide supports in the Sydney metropolitan area including - Western Sydney, Northern Sydney, Northern Beaches and parts of South Western Sydney, the Inner West and South Eastern Sydney. \r\nWhat is the cost?\r\nCosts vary depending on the service provided.  You can use your NDIS funding package (we offer services under the NDIS support areas of Improved Daily Living and Improved Relationships) or pay privately.\r\n\r\nContact us\r\nTo find out more call our Client Engagement Team on 1800 953 390.\r\n','Speech therapy','Our speech pathologists can work with you, your child or young person to develop communication skills. ','publish','closed','closed','','speech-therapy','','','2018-08-10 02:09:53','2018-08-10 02:09:53','',0,'http://localhost/?post_type=lifestart_services&#038;p=335',0,'lifestart_services','',0),(336,1,'2018-08-10 02:06:56','2018-08-10 02:06:56','What do we offer?\r\nOur occupational therapists can work with you, your child or young person to develop independent living skills, to support participation in the activities of everyday life.\r\n\r\nDo you, your child or young person require help to:\r\n<ul>\r\n 	<li>be independent in everyday activities like getting dressed and going to school?</li>\r\n 	<li>develop your fine motor skills, so you can do things like play, type and write?</li>\r\n 	<li>access the right equipment, so you can do everyday things?</li>\r\n 	<li>understand your sensory needs and help you navigate these needs every day?</li>\r\n</ul>\r\nAn occupational therapist can help you, your child or young person to:\r\n<ul>\r\n 	<li>be more independent in personal care and daily routines</li>\r\n 	<li>build self-care skills to support increased participation in daily activities like mealtimes or playtime</li>\r\n 	<li>develop fine motor and handwriting skills</li>\r\n 	<li>understand and manage sensory needs like responding to movement or touch</li>\r\n 	<li>have suitable equipment such as a wheelchair to use when going on a weekend activity with the family.</li>\r\n</ul>\r\nDo we provide services in your area?\r\nWe provide supports in the Sydney metropolitan area including - Western Sydney, Northern Sydney, Northern Beaches and parts of South Western Sydney, the Inner West and South Eastern Sydney.\r\nWhat is the cost?\r\nCosts vary depending on the service provided. You can use your NDIS funding package (we offer services under the NDIS support areas of Improved Daily Living and Improved Relationships) or pay privately.\r\n\r\nContact us\r\nTo find out more call our Client Engagement Team on 1800 953 390.','Occupational Therapy','Our occupational therapists can work with you, your child or young person to develop independent living skills, to support participation in the activities of everyday life.','publish','closed','closed','','occupational-therapy','','','2018-08-10 02:09:06','2018-08-10 02:09:06','',0,'http://localhost/?post_type=lifestart_services&#038;p=336',0,'lifestart_services','',0),(337,1,'2018-08-10 02:07:57','2018-08-10 02:07:57','What do we offer?\nOur occupational therapists can work with you, your child or young person to develop independent living skills, to support participation in the activities of everyday life.\n\nDo you, your child or young person require help to:\n<ul>\n 	<li>be independent in everyday activities like getting dressed and going to school?</li>\n 	<li>develop your fine motor skills, so you can do things like play, type and write?</li>\n 	<li>access the right equipment, so you can do everyday things?</li>\n 	<li>understand your sensory needs and help you navigate these needs every day?</li>\n</ul>\nAn occupational therapist can help you, your child or young person to:\n<ul>\n 	<li>be more independent in personal care and daily routines</li>\n 	<li>\n• build self-care skills to support increased participation in daily activities like mealtimes or playtime</li>\n 	<li>\n• develop fine motor and handwriting skills</li>\n 	<li>\n• understand and manage sensory needs like responding to movement or touch</li>\n 	<li>\n• have suitable equipment such as a wheelchair to use when going on a weekend activity with the family.</li>\n</ul>\nDo we provide services in your area?\nWe provide supports in the Sydney metropolitan area including - Western Sydney, Northern Sydney, Northern Beaches and parts of South Western Sydney, the Inner West and South Eastern Sydney.\nWhat is the cost?\nCosts vary depending on the service provided. You can use your NDIS funding package (we offer services under the NDIS support areas of Improved Daily Living and Improved Relationships) or pay privately.\n\nContact us\nTo find out more call our Client Engagement Team on 1800 953 390.','Occupational Therapy','Our occupational therapists can work with you, your child or young person to develop independent living skills, to support participation in the activities of everyday life.','inherit','closed','closed','','336-autosave-v1','','','2018-08-10 02:07:57','2018-08-10 02:07:57','',336,'http://localhost/2018/08/10/336-autosave-v1/',0,'revision','',0),(338,1,'2018-08-10 02:13:11','2018-08-10 02:13:11','What do we offer?\r\nOur physiotherapists can work with you, your child or young person to improve movement and mobility, to support participation in activities at home, school and in the community.  \r\n\r\nDo you, your child or young person require help to:\r\n•	learn new skills that will help you move independently?\r\n•	improve your gross motor skills, so you can crawl, walk, run, jump and have fun?\r\n•	improve balance and coordination, so you can join in sporting teams and social activities?\r\n•	access the right equipment, so you can participate in activities with my friends and family?\r\n\r\nA physiotherapist can help you, your child or young person to:\r\n•	develop skills to be more mobile and independent in daily activities\r\n•	learn to move independently, for example to sit up from the floor, crawl and walk\r\n•	improve balance and coordination\r\n•	access specialised equipment \r\n•	participate in sport, exercise and other activities in the community.\r\nWe provide supports in the Sydney metropolitan area including - Western Sydney, Northern Sydney, Northern Beaches and parts of South Western Sydney, the Inner West and South Eastern Sydney. \r\nCosts vary depending on the service provided.  You can use your NDIS funding package (we offer services under the NDIS support areas of Improved Daily Living and Improved Relationships) or pay privately.\r\n\r\nTo find out more call our Client Engagement Team on 1800 953 390.\r\n','Physiotherapy','Our physiotherapists can work with you, your child or young person to improve movement and mobility.','publish','closed','closed','','physiotherapy','','','2018-08-10 02:14:04','2018-08-10 02:14:04','',0,'http://localhost/?post_type=lifestart_services&#038;p=338',0,'lifestart_services','',0),(342,1,'2018-08-10 05:54:15','2018-08-10 05:54:15','What we offer?\r\nSocial Workers and Psychologists are qualified professionals who work with you, your child or young person to improve their psychological, social and emotional wellbeing. They provide positive behaviour support, support to manage anxiety and improve emotional regulation and develop social and other skills to support learning.\r\n\r\nDo you, your child or young person require help to:\r\n<ul>\r\n 	<li>develop positive relationships with the important people in your life?</li>\r\n 	<li>understand your emotions and to develop strategies to manage those emotions?</li>\r\n 	<li>understand the changes you will experience as you grow and develop through puberty?</li>\r\n 	<li>develop skills to manage stressful situations in your life?</li>\r\n</ul>\r\nA social worker or psychologist can help you, your child or young person to:\r\n<ul>\r\n 	<li>improve relationships</li>\r\n 	<li>build confidence and develop social skills</li>\r\n 	<li>increase independent living skills to support important transitions including to school, high school and employment</li>\r\n 	<li>understand triggers of behaviour and how to manage them</li>\r\n 	<li>develop emotional self-regulation to manage feelings such as anxiety and anger</li>\r\n 	<li>improve learning and memory skills</li>\r\n 	<li>develop strategies for supporting informed choices regarding relationships and sexuality</li>\r\n 	<li>build the capacity of the family to maintain their caring role.</li>\r\n</ul>\r\nDo we provide services in your area?\r\nWe provide supports in the Sydney metropolitan area including - Western Sydney, Northern Sydney, Northern Beaches and parts of South Western Sydney, the Inner West and South Eastern Sydney.\r\nWhat is the cost?\r\nCosts vary depending on the service provided. You can use your NDIS funding package (we offer services under the NDIS support areas of Improved Daily Living and Improved Relationships) or pay privately.\r\n\r\nContact us\r\nTo find out more call our Client Engagement Team on 1800 953 390.','Social Work and Psychology','Social Workers and Psychologists are qualified professionals who work with you, your child or young person to improve their psychological, social and emotional wellbeing','publish','closed','closed','','social-work-and-psychology','','','2018-08-10 05:59:54','2018-08-10 05:59:54','',0,'http://localhost/?post_type=lifestart_services&#038;p=342',0,'lifestart_services','',0),(349,1,'2018-08-12 22:53:56','2018-08-12 22:53:56','What do we offer?\r\nOur occupational therapists can work with you, your child or young person to develop independent living skills, to support participation in the activities of everyday life.\r\n\r\nDo you, your child or young person require help to:\r\n<ul>\r\n 	<li>be independent in everyday activities like getting dressed and going to school?</li>\r\n 	<li>develop your fine motor skills, so you can do things like play, type and write?</li>\r\n 	<li>access the right equipment, so you can do everyday things?</li>\r\n 	<li>understand your sensory needs and help you navigate these needs every day?</li>\r\n</ul>\r\nAn occupational therapist can help you, your child or young person to:\r\n<ul>\r\n 	<li>be more independent in personal care and daily routines</li>\r\n 	<li>build self-care skills to support increased participation in daily activities like mealtimes or playtime</li>\r\n 	<li>develop fine motor and handwriting skills</li>\r\n 	<li>understand and manage sensory needs like responding to movement or touch</li>\r\n 	<li>have suitable equipment such as a wheelchair to use when going on a weekend activity with the family.</li>\r\n</ul>\r\nDo we provide services in your area?\r\nWe provide supports in the Sydney metropolitan area including - Western Sydney, Northern Sydney, Northern Beaches and parts of South Western Sydney, the Inner West and South Eastern Sydney.\r\nWhat is the cost?\r\nCosts vary depending on the service provided. You can use your NDIS funding package (we offer services under the NDIS support areas of Improved Daily Living and Improved Relationships) or pay privately.\r\n\r\nContact us\r\nTo find out more call our Client Engagement Team on 1800 953 390.','Occupational Therapy','','publish','closed','closed','','occupational-therapy','','','2023-10-16 03:15:10','2023-10-16 03:15:10','',0,'http://localhost/?post_type=services&#038;p=349',0,'services','',0),(350,1,'2018-08-12 23:05:46','2018-08-12 23:05:46','What do we offer?\r\nOur physiotherapists can work with you, your child or young person to improve movement and mobility, to support participation in activities at home, school and in the community.\r\n\r\nDo you, your child or young person require help to:\r\n<ul>\r\n 	<li>learn new skills that will help you move independently?</li>\r\n 	<li>improve your gross motor skills, so you can crawl, walk, run, jump and have fun?</li>\r\n 	<li>improve balance and coordination, so you can join in sporting teams and social activities?</li>\r\n 	<li>access the right equipment, so you can participate in activities with my friends and family?</li>\r\n</ul>\r\nA physiotherapist can help you, your child or young person to:\r\n<ul>\r\n 	<li>develop skills to be more mobile and independent in daily activities</li>\r\n 	<li>learn to move independently, for example to sit up from the floor, crawl and walk</li>\r\n 	<li>improve balance and coordination</li>\r\n 	<li>access specialised equipment</li>\r\n 	<li>participate in sport, exercise and other activities in the community.</li>\r\n</ul>\r\nWe provide supports in the Sydney metropolitan area including - Western Sydney, Northern Sydney, Northern Beaches and parts of South Western Sydney, the Inner West and South Eastern Sydney.\r\nCosts vary depending on the service provided. You can use your NDIS funding package (we offer services under the NDIS support areas of Improved Daily Living and Improved Relationships) or pay privately.\r\n\r\nTo find out more call our Client Engagement Team on <strong>1800 953 390.</strong>','Physiotherapy','','publish','closed','closed','','physiotherapy','','','2018-08-12 23:05:46','2018-08-12 23:05:46','',0,'http://localhost/?post_type=services&#038;p=350',0,'services','',0),(351,1,'2018-08-12 23:07:07','2018-08-12 23:07:07','What we offer?\r\nSocial Workers and Psychologists are qualified professionals who work with you, your child or young person to improve their psychological, social and emotional wellbeing. They provide positive behaviour support, support to manage anxiety and improve emotional regulation and develop social and other skills to support learning.\r\n\r\nDo you, your child or young person require help to:\r\n<ul>\r\n 	<li>develop positive relationships with the important people in your life?</li>\r\n 	<li>understand your emotions and to develop strategies to manage those emotions?</li>\r\n 	<li>understand the changes you will experience as you grow and develop through puberty?</li>\r\n 	<li>develop skills to manage stressful situations in your life?</li>\r\n</ul>\r\nA social worker or psychologist can help you, your child or young person to:\r\n<ul>\r\n 	<li>improve relationships</li>\r\n 	<li>build confidence and develop social skills</li>\r\n 	<li>increase independent living skills to support important transitions including to school, high school and employment</li>\r\n 	<li>understand triggers of behaviour and how to manage them</li>\r\n 	<li>develop emotional self-regulation to manage feelings such as anxiety and anger</li>\r\n 	<li>improve learning and memory skills</li>\r\n 	<li>develop strategies for supporting informed choices regarding relationships and sexuality</li>\r\n 	<li>build the capacity of the family to maintain their caring role.</li>\r\n</ul>\r\nDo we provide services in your area?\r\nWe provide supports in the Sydney metropolitan area including - Western Sydney, Northern Sydney, Northern Beaches and parts of South Western Sydney, the Inner West and South Eastern Sydney.\r\nWhat is the cost?\r\nCosts vary depending on the service provided. You can use your NDIS funding package (we offer services under the NDIS support areas of Improved Daily Living and Improved Relationships) or pay privately.\r\n\r\nContact us\r\nTo find out more call our Client Engagement Team on 1800 953 390.','Social Work and Psychology','','publish','closed','closed','','social-work-and-psychology','','','2018-08-12 23:07:07','2018-08-12 23:07:07','',0,'http://localhost/?post_type=services&#038;p=351',0,'services','',0),(352,1,'2018-08-12 23:09:24','2018-08-12 23:09:24','<strong>What do we offer?</strong>\r\n\r\nOur speech pathologists can work with you, your child or young person to develop communication skills. Speech Pathologists also have specific skills to support people who have difficulty with eating, drinking or swallowing their food.\r\nDo you, your child or young person require help to:\r\n<ul>\r\n 	<li>join in conversations with all the people in your life like family, friends and teachers?</li>\r\n 	<li>understand what people say and learn the words you need to express ideas and feelings?</li>\r\n 	<li>use pictures, signs or technology like Augmentative and Alternate Communication (AAC) devices to communicate?</li>\r\n</ul>\r\nA speech pathologist can help you, your child or young person to:\r\n<ul>\r\n 	<li>develop communication skills in the daily interactions, routines and activities you enjoy</li>\r\n 	<li>learn speech sounds, words and sentences to express ideas</li>\r\n 	<li>understand what words mean and how to follow instructions\r\nlearn social skills</li>\r\n 	<li>understand and use gestures, signs and pictures to support communication</li>\r\n 	<li>identify technology that can assist with communication and to use the technology e.g. Augmentative and Alternative Communication (AAC) Systems</li>\r\n 	<li>identify specific difficulties with eating and drinking and assist with feeling safe when swallowing.</li>\r\n</ul>\r\n<h4>Do we provide services in your area?</h4>\r\nWe provide supports in the Sydney metropolitan area including - Western Sydney, Northern Sydney, Northern Beaches and parts of South Western Sydney, the Inner West and South Eastern Sydney.\r\n<h4>What is the cost?</h4>\r\nCosts vary depending on the service provided. You can use your NDIS funding package (we offer services under the NDIS support areas of Improved Daily Living and Improved Relationships) or pay privately.\r\n<h4>Contact us</h4>\r\nTo find out more call our Client Engagement Team on<strong> 1800 953 390.</strong>','Speech therapy','','publish','closed','closed','','speech-therapy','','','2018-08-12 23:11:48','2018-08-12 23:11:48','',0,'http://localhost/?post_type=services&#038;p=352',0,'services','',0),(353,1,'2018-08-12 23:15:21','2018-08-12 23:15:21','<h4>What do we offer?</h4>\r\nWe support children and young people living with disability to develop the skills to be part of everyday life in their community.\r\nWe provide flexible, person-centred therapy supports for children and young people aged 0-24 years. Our multidisciplinary teams consist of specialist professionals who are experienced in working with children and young people living with disability.\r\n\r\nThey include:\r\n<ul>\r\n 	<li>speech pathologists</li>\r\n 	<li>occupational therapists</li>\r\n 	<li>physiotherapists</li>\r\n 	<li>behaviour specialists</li>\r\n 	<li>social workers and psychologists</li>\r\n 	<li>educators.</li>\r\n</ul>\r\nWe work in partnership with families and carers to provide individualised supports that are responsive to the unique abilities, interests and aspirations of children and young people. We will support you, your child or young person in a place of your choosing which could be in your home, preschool, school, or other places that you spend time.\r\n\r\nLifestart may also use a key worker approach depending on the type of support you require. A key worker is the person you and your family and carers will see and talk to most and may be any one of our specialist professionals depending on your needs and goals.\r\n<h4>Do we provide services in your area?</h4>\r\nWe provide therapy supports in the Sydney metropolitan area including - Western Sydney, Northern Sydney, Northern Beaches and parts of South Western Sydney, the Inner West and South Eastern Sydney.\r\n<h4>\r\nWhat is the cost?</h4>\r\nCosts vary depending on the service provided. You can use your NDIS funding package (we offer services under the NDIS support areas of Improved Daily Living and Improved Relationships) or pay privately.\r\n<h4>Contact us</h4>\r\nTo find out more call our Client Engagement Team on 1800 953 390.','Therapy supports','','publish','closed','closed','','therapy-supports','','','2018-08-12 23:15:21','2018-08-12 23:15:21','',0,'http://localhost/?post_type=services&#038;p=353',0,'services','',0),(364,1,'2018-08-16 12:44:53','2018-08-16 12:44:53','','About','','inherit','closed','closed','','19-revision-v1','','','2018-08-16 12:44:53','2018-08-16 12:44:53','',19,'http://localhost/2018/08/16/19-revision-v1/',0,'revision','',0),(365,1,'2018-08-16 12:48:20','2018-08-16 12:48:20','','About','','inherit','closed','closed','','19-revision-v1','','','2018-08-16 12:48:20','2018-08-16 12:48:20','',19,'http://localhost/2018/08/16/19-revision-v1/',0,'revision','',0),(367,1,'2018-08-16 12:54:15','2018-08-16 12:54:15','','avatar_temp','','inherit','open','closed','','avatar_temp','','','2018-08-16 12:54:15','2018-08-16 12:54:15','',19,'http://localhost/wp-content/uploads/2018/08/avatar_temp.png',0,'attachment','image/png',0),(368,1,'2018-08-16 12:59:27','2018-08-16 12:59:27','','About','','inherit','closed','closed','','19-revision-v1','','','2018-08-16 12:59:27','2018-08-16 12:59:27','',19,'http://localhost/2018/08/16/19-revision-v1/',0,'revision','',0),(369,1,'2018-08-16 13:17:39','2018-08-16 13:17:39','','About','','inherit','closed','closed','','19-revision-v1','','','2018-08-16 13:17:39','2018-08-16 13:17:39','',19,'http://localhost/2018/08/16/19-revision-v1/',0,'revision','',0),(371,1,'2018-08-20 02:22:50','2018-08-20 02:22:50','','About','','inherit','closed','closed','','19-revision-v1','','','2018-08-20 02:22:50','2018-08-20 02:22:50','',19,'http://localhost/2018/08/20/19-revision-v1/',0,'revision','',0),(376,1,'2018-08-23 07:27:00','2018-08-23 07:27:00','Content here','Regional manager test','Location Sydney <br />\r\nLocation Sydney <br />','publish','closed','closed','','regional-manager-test','','','2018-08-23 07:29:57','2018-08-23 07:29:57','',0,'http://localhost/?post_type=positions&#038;p=376',0,'positions','',0),(389,1,'2019-12-03 03:02:14','2019-12-03 03:02:14','','vow_hero_4U1A4527','','inherit','open','closed','','vow_hero_4u1a4527','','','2019-12-03 03:02:14','2019-12-03 03:02:14','',6,'http://localhost/wp-content/uploads/2019/12/vow_hero_4U1A4527.jpg',0,'attachment','image/jpeg',0),(390,1,'2019-12-03 03:08:35','2019-12-03 03:08:35','','vow_hero_4U1A4519','','inherit','open','closed','','vow_hero_4u1a4519','','','2019-12-03 03:08:35','2019-12-03 03:08:35','',6,'http://localhost/wp-content/uploads/2019/12/vow_hero_4U1A4519.jpg',0,'attachment','image/jpeg',0),(393,1,'2019-12-03 03:24:44','2019-12-03 03:24:44','','vow_hero_DJI_0157','','inherit','open','closed','','vow_hero_dji_0157','','','2019-12-03 03:24:44','2019-12-03 03:24:44','',6,'http://localhost/wp-content/uploads/2019/12/vow_hero_DJI_0157.jpg',0,'attachment','image/jpeg',0),(394,1,'2019-12-03 03:24:45','2019-12-03 03:24:45','','vow_hero_DJI_0193','','inherit','open','closed','','vow_hero_dji_0193','','','2019-12-03 03:24:45','2019-12-03 03:24:45','',6,'http://localhost/wp-content/uploads/2019/12/vow_hero_DJI_0193.jpg',0,'attachment','image/jpeg',0),(395,1,'2019-12-03 05:02:46','2019-12-03 05:02:46','','Home','','inherit','closed','closed','','6-revision-v1','','','2019-12-03 05:02:46','2019-12-03 05:02:46','',6,'http://localhost/2019/12/03/6-revision-v1/',0,'revision','',0),(396,1,'2019-12-03 05:10:15','2019-12-03 05:10:15','','Home','','inherit','closed','closed','','6-revision-v1','','','2019-12-03 05:10:15','2019-12-03 05:10:15','',6,'http://localhost/2019/12/03/6-revision-v1/',0,'revision','',0),(397,1,'2019-12-03 05:13:55','2019-12-03 05:13:55','','Home','','inherit','closed','clo