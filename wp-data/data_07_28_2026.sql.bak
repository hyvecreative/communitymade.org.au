69,2709,'report_link_url','#'),(188570,2709,'_report_link_url','field_62f30ef4b57e3'),(188571,2709,'report_link_text','Download'),(188572,2709,'_report_link_text','field_62f30f01b57e4'),(188573,2709,'solutions_content','The housing system is complex, and no one solution will solve the complex problems we now face but there are some critical first steps to be taken now.\r\n<ul>\r\n 	<li>Set out an ambitious national housing agreement between commonwealth and state governments with targets and funding for the construction of affordable homes.</li>\r\n 	<li>Phase out tax breaks for property investors and using the increase in revenue to build more public housing.</li>\r\n 	<li>Establish laws which limit rental increases beyond what is fair.</li>\r\n 	<li>Rebalance tenancy laws to provide renters with more security and control, such as eliminating no grounds evictions.</li>\r\n 	<li>Phase out stamp duty and replace it with a broad-based land tax.</li>\r\n</ul>\r\n<h4>While there are many opinions on what policy changes will fix the housing market, doing nothing is not an option.</h4>'),(188574,2709,'_solutions_content','field_640e8b307a958'),(188575,2709,'problem_icons_0_prob_icon','1699'),(188576,2709,'_problem_icons_0_prob_icon','field_640fa0291d519'),(188577,2709,'problem_icons_0_prob_concerned_stat','70% highly concerned'),(188578,2709,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(188579,2709,'problem_icons_0_prob_concerded_text','are highly concerned'),(188580,2709,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(188581,2709,'problem_icons_0_prob_issue_text',''),(188582,2709,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(188583,2709,'problem_icons','4'),(188584,2709,'_problem_icons','field_640fa0191d518'),(188585,2709,'ceh_content_left',''),(188586,2709,'_ceh_content_left','field_640e97e8f1c8c'),(188587,2709,'ceh_content_right',''),(188588,2709,'_ceh_content_right','field_640e97fdf1c8d'),(188589,2709,'pc_content_left',''),