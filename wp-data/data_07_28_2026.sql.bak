67cb0d6afc6'),(79073,1893,'second _image_title','Lifestart is about supporting young children'),(79074,1893,'_second _image_title','field_5b67cb20ddf9a'),(79075,1893,'second_image_cont','from 0-24 years living with disabilities and their familes'),(79076,1893,'_second_image_cont','field_5b67cb24ddf9b'),(79077,1893,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(79078,1893,'_second_image_button','field_5b67cb29ddf9c'),(79079,1893,'second_image_title','Lifestart is about supporting young children'),(79080,1893,'_second_image_title','field_5b67cb20ddf9a'),(79081,1893,'page_col_image','412'),(79082,1893,'_page_col_image','field_5de6546e7c63a'),(79083,1893,'page_col_image_3','437'),(79084,1893,'_page_col_image_3','field_5de6e3998e07e'),(79085,1893,'sec_2_title','Community'),(79086,1893,'_sec_2_title','field_5de6e3ef2798f'),(79087,1893,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(79088,1893,'_sec_2_text','field_5de78dc89e613'),(79089,1893,'sec_3_title','The Project'),(79090,1893,'_sec_3_title','field_5de6e3d37d8da'),(79091,1893,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(79092,1893,'_sec_3_text','field_5de6e4044e5e8'),(79093,1893,'page_col_image_2','436'),(79094,1893,'_page_col_image_2','field_5de6546e7c63a'),(79095,1893,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(79096,1893,'_sec_2_button','field_5de6e58c86706'),(79097,1893,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(79098,1893,'_sec_3_button','field_5de6e5a243c03'),(79099,1893,'page_col_image_4','455'),(79100,1893,'_page_col_image_4','field_5de70801090ce'),(79101,1893,'sec_4_title','Location'),(79102,1893,'_sec_4_title','field_5de7082a12a81'),(79103,1893,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(79104,1893,'_sec_4_text','field_5de7084812a82'),(79105,1893,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(79106,1893,'_sec_4_button','field_5de7085e12a83'),(79107,1893,'news_title','Project updates'),(79108,1893,'_news_title','field_5de78da3aabb9'),(79109,1893,'sec_2_text_copy',''),(79110,1893,'_sec_2_text_copy','field_5de78dc89e613'),(79111,1893,'timeline-title','Timeline'),(79112,1893,'_timeline-title','field_5de78df29e615'),(79113,1893,'timeline_title','Timeline'),(79114,1893,'_timeline_title','field_5de78df29e615'),(79115,1893,'contact_title','Contact us'),(79116,1893,'_contact_title','field_5de7981e06057'),(79117,1893,'contact_intro','Contact text...'),(79118,1893,'_contact_intro','field_5de7983506058'),(79119,1893,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(79120,1893,'_news_button','field_5de8329896e02'),(79121,1893,'timeline_intro','Introduction of timeline detail...'),(79122,1893,'_timeline_intro','field_5de98f5fb1781'),(79123,1893,'timeline_pic','477'),(79124,1893,'_timeline_pic','field_5de98f72b1782'),(79125,1893,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(79126,1893,'_timeline_button','field_5de99363677f8'),(79127,1893,'banner_image_positio