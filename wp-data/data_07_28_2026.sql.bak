6_survey_url','#'),(126749,2202,'_survey_index_6_survey_url','field_6294564e42239'),(126750,2202,'survey_index_6_survey_url_text','View Results'),(126751,2202,'_survey_index_6_survey_url_text','field_629456584223a'),(126752,2202,'survey_index_7_survey_icon','1493'),(126753,2202,'_survey_index_7_survey_icon','field_6294562942237'),(126754,2202,'survey_index_7_survey_title','Going Off-grid'),(126755,2202,'_survey_index_7_survey_title','field_6294564042238'),(126756,2202,'survey_index_7_survey_url','#'),(126757,2202,'_survey_index_7_survey_url','field_6294564e42239'),(126758,2202,'survey_index_7_survey_url_text','View Results'),(126759,2202,'_survey_index_7_survey_url_text','field_629456584223a'),(126760,2202,'survey_index','8'),(126761,2202,'_survey_index','field_6294561242236'),(126762,2202,'report_title','Download the report'),(126763,2202,'_report_title','field_62f30edfb57e1'),(126764,2202,'report_intro','Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus massa erat, consectetur at semper at, feugiat vel orci. '),(126765,2202,'_report_intro','field_62f30eedb57e2'),(126766,2202,'report_link_url','#'),(126767,2202,'_report_link_url','field_62f30ef4b57e3'),(126768,2202,'report_link_text','Download'),(126769,2202,'_report_link_text','field_62f30f01b57e4'),(126770,2202,'solutions_content','The housing system is complex, and no one solution will solve the complex problems we now face but there are some critical first steps to be taken now.\r\n<ul>\r\n 	<li>Set out an ambitious national housing agreement between commonwealth and state governments with targets and funding for the construction of affordable homes.</li>\r\n 	<li>Phase out tax breaks for property investors and using the increase in revenue to build more public housing.</li>\r\n 	<li>Establish laws which limit rental increases beyond what is fair.</li>\r\n 	<li>Rebalance tenancy laws to provide renters with more security and control, such as eliminating no grounds evictions.</li>\r\n 	<li>Phase out stamp duty and replace it with a broad-based land tax.</li>\r\n</ul>\r\n<h4>While there are many opinions on what policy changes will fix the housing market, doing nothing is not an option.</h4>'),(126771,2202,'_solutions_content','field_640e8b307a958'),(126772,2202,'problem_icons_0_prob_icon','1699'),(126773,2202,'_problem_icons_0_prob_icon','field_640fa0291d519'),(126774,2202,'problem_icons_0_prob_concerned_stat','70% highly concerned'),(126775,2202,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(126776,2202,'problem_icons_0_prob_concerded_text','are highly concerned'),(126777,2202,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(126778,2202,'problem_icons_0_prob_issue_text',''),(126779,2202,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(126780,2202,'problem_icons','4'),(126781,2202,'_problem_icons','field_640fa0191d518'),(126782,2202,'ceh_content_left',''),(126783,2202,'_ceh_content_left','field_640e97e8f1c8c'),(126784,2202,'ceh_content_right',''),(126785,2202,'_ceh_content_right','field_640e97fdf1c8d'),(126786,2202,'pc_content_left',''),(126787,2202,'_pc_content_left','field_640e983bf1c8f'),(126788,2202,'pc_content_right',''),(126789,2202,'_pc_content_right','field_640e984df1c90'),(126790,2202,'problem_icons_1_prob_icon','1699'),(126791,2202,'_problem_icons_1_prob_icon','field_640fa0291d519'),(126792,2202,'problem_icons_1_prob_concerned_stat','69% highly concerned'),(126793,2202,'_problem_icons_1_prob_concerned_stat','field_640fa0dd81d95'),(126794,2202,'problem_icons_1_prob_concerded_text','are highly concerned'),(126795,2202,'_problem_icons_1_prob_concerded_text','field_640fa10181d96'),(126796,2202,'problem_icons_1_prob_issue_text',''),(126797,2202,'_problem_icons_1_prob_issue_text','field_640fa11a81d97'),(126798,2202,'problem_icons_2_prob_icon','1699'),(126799,2202,'_problem_icons_2_prob_icon','field_640fa0291d519'),(126800,2202,'problem_icons_2_prob_concerned_stat','64% highly concerned'),(126801,2202,'_problem_icons_2_prob_concerned_stat','field_640fa0dd81d95'),(126802,2202,'problem_icons_2_prob_concerded_text','are highly concerned'),(126803,2202,'_problem_icons_2_prob_concerded_text','field_640fa10181d96'),(126804,2202,'problem_icons_2_prob_issue_text',''),(126805,2202,'_problem_icons_2_prob_issue_text','field_640fa11a81d97'),(126806,2202,'problem_icons_3_prob_icon','1699'),(126807,2202,'_problem_icons_3_prob_icon','field_640fa0291d519'),(126808,2202,'problem_icons_3_prob_concerned_stat','64% highly concerned'),(126809,2202,'_problem_icons_3_prob_concerned_stat','field_640fa0dd81d95'),(126810,2202,'problem_icons_3_prob_concerded_text','are highly concerned'),(126811,2202,'_problem_icons_3_prob_concerded_text','field_640fa10181d96'),(126812,2202,'problem_icons_3_prob_issue_text',''),(126813,2202,'_problem_icons_3_prob_issue_text','field_640fa11a81d97'),(126814,2202,'problem_icons_0_prob_concerned_text','House prices have doubled in a decade'),(126815,2202,'_problem_icons_0_prob_concerned_text','field_640fa10181d96'),(126816,2202,'problem_icons_1_prob_concerned_text','The gap between rich and poor is growing'),(126817,2202,'_problem_icons_1_prob_concerned_text','field_640fa10181d96'),(126818,2202,'problem_icons_2_prob_concerned_text','Construction of social housing is down'),(126819,2202,'_problem_icons_2_prob_concerned_text','field_640fa10181d96'),(126820,2202,'problem_icons_3_prob_concerned_text','Banks are making more than ever from housing'),(126821,2202,'_problem_icons_3_prob_concerned_text','field_640fa10181d96'),(126822,2202,'monitor_content','The Australian Housing Monitor is a large, nationally-representative survey covering public experiences and attitudes toward housing related issues. Questions range from how well the respondent is keeping up with their mortgage/rent, to what they think about social housing construction.\r\n\r\nA broad range of demographic criteria are included, such as gender, location, age, income, voting preference, educational level, tenure type, and employment status. These variables allow CEH researchers to understand the trends and diversity of opinion around the country.\r\n\r\nIt also incorporates questions from previous surveys to track trends over time.\r\nThe inaugural poll was conducted by Essential in December 2022, and was completed by 4,735 people.'),(126823,2202,'_monitor_content','field_640fcc4014404'),(126824,2202,'problem_head','Housing in Australia is not working, and Australians are concerned.'),(126825,2202,'_problem_head','field_641935436aded'),(126826,2202,'problem_signoff','Explore the research showing how concerned Australians are our about the housing situation.'),(126827,2202,'_problem_signoff','field_641935626adee'),(126828,2202,'sections','a:2:{i:0;s:4:\"hero\";i:1;s:9:\"news_grid\";}'),(126829,2202,'_sections','field_5dafb40b8143a'),(126830,2202,'sections_0_is_full_height','1'),(126831,2202,'_sections_0_is_full_height','field_61d6f6fd5a37e'),(126832,2202,'sections_0_image','1648'),(126833,2202,'_sections_0_image','field_61d6f6d45a37d'),(126834,2202,'sections_0_heading','Heading'),(126835,2202,'_sections_0_heading','field_61d6f69e5a379'),(126836,2202,'sections_0_subtitle','Ya ya '),(126837,2202,'_sections_0_subtitle','field_61d6f6ac5a37a'),(126838,2202,'sections_0_link_one',''),(126839,2202,'_sections_0_link_one','field_61d6f6b55a37b'),(126840,2202,'sections_0_link_two',''),(126841,2202,'_sections_0_link_two','field_61d6f6c35a37c'),(126842,2202,'sections_1_select_categories','a:1:{i:0;s:2:\"27\";}'),(126843,2202,'_sections_1_select_categories','field_637f04483b63b'),(126844,2202,'intro_head_major','Welcome to the Disability Dialogue'),(126845,2202,'_intro_head_major','field_64e828783ad9f'),(126846,2202,'intro_head_minor',''),(126847,2202,'_intro_head_minor','field_64e8288c3ada0'),(126848,2202,'intro_icons_0_int_icon','1922'),(126849,2202,'_intro_icons_0_int_icon','field_64e828b33ada2'),(126850,2202,'intro_icons_0_int_icon_text','At 1,727,000 square kilometres, we’re 2.5 times