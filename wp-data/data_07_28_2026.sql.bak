),(19514,1075,'second _image_title','Lifestart is about supporting young children'),(19515,1075,'_second _image_title','field_5b67cb20ddf9a'),(19516,1075,'second_image_cont','from 0-24 years living with disabilities and their familes'),(19517,1075,'_second_image_cont','field_5b67cb24ddf9b'),(19518,1075,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(19519,1075,'_second_image_button','field_5b67cb29ddf9c'),(19520,1075,'second_image_title','Lifestart is about supporting young children'),(19521,1075,'_second_image_title','field_5b67cb20ddf9a'),(19522,1075,'page_col_image','412'),(19523,1075,'_page_col_image','field_5de6546e7c63a'),(19524,1075,'page_col_image_3','437'),(19525,1075,'_page_col_image_3','field_5de6e3998e07e'),(19526,1075,'sec_2_title','Community'),(19527,1075,'_sec_2_title','field_5de6e3ef2798f'),(19528,1075,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(19529,1075,'_sec_2_text','field_5de78dc89e613'),(19530,1075,'sec_3_title','The Project'),(19531,1075,'_sec_3_title','field_5de6e3d37d8da'),(19532,1075,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(19533,1075,'_sec_3_text','field_5de6e4044e5e8'),(19534,1075,'page_col_image_2','436'),(19535,1075,'_page_col_image_2','field_5de6546e7c63a'),(19536,1075,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(19537,1075,'_sec_2_button','field_5de6e58c86706'),(19538,1075,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(19539,1075,'_sec_3_button','field_5de6e5a243c03'),(19540,1075,'page_col_image_4','455'),(19541,1075,'_page_col_image_4','field_5de70801090ce'),(19542,1075,'sec_4_title','Location'),(19543,1075,'_sec_4_title','field_5de7082a12a81'),(19544,1075,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(19545,1075,'_sec_4_text','field_5de7084812a82'),(19546,1075,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(19547,1075,'_sec_4_button','field_5de7085e12a83'),(19548,1075,'news_title','Project updates'),(19549,1075,'_news_title','field_5de78da3aabb9'),(19550,1075,'sec_2_text_copy',''),(19551,1075,'_sec_2_text_copy','field_5de78dc89e613'),(19552,1075,'timeline-title','Timeline'),(19553,1075,'_timeline-title','field_5de78df29e615'),(19554,1075,'timeline_title','Timeline'),(19555,1075,'_timeline_title','field_5de78df29e615'),(19556,1075,'contact_title','Contact us'),(19557,1075,'_contact_title','field_5de7981e06057'),(19558,1075,'contact_intro','Contact text...'),(19559,1075,'_contact_intro','field_5de7983506058'),(19560,1075,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(19561,1075,'_news_button','field_5de8329896e02'),(19562,1075,'timeline_intro','Introduction of timeline detail...'),(19563,1075,'_timeline_intro','field_5de98f5fb1781'),(19564,1075,'timeline_pic','477'),(19565,1075,'_timeline_pic','field_5de98f72b1782'),(19566,1075,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(19567,1075,'_timeline_button','field_5de99363677f8'),(19568,1075,'banner_image_position','center')