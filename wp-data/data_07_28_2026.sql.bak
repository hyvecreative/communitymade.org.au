first_image_cont','field_5b67caff6afc5'),(184921,2698,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(184922,2698,'_first_image_button','field_5b67cb0d6afc6'),(184923,2698,'second _image_title','Lifestart is about supporting young children'),(184924,2698,'_second _image_title','field_5b67cb20ddf9a'),(184925,2698,'second_image_cont','from 0-24 years living with disabilities and their familes'),(184926,2698,'_second_image_cont','field_5b67cb24ddf9b'),(184927,2698,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(184928,2698,'_second_image_button','field_5b67cb29ddf9c'),(184929,2698,'second_image_title','Lifestart is about supporting young children'),(184930,2698,'_second_image_title','field_5b67cb20ddf9a'),(184931,2698,'page_col_image','412'),(184932,2698,'_page_col_image','field_5de6546e7c63a'),(184933,2698,'page_col_image_3','437'),(184934,2698,'_page_col_image_3','field_5de6e3998e07e'),(184935,2698,'sec_2_title','Community'),(184936,2698,'_sec_2_title','field_5de6e3ef2798f'),(184937,2698,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(184938,2698,'_sec_2_text','field_5de78dc89e613'),(184939,2698,'sec_3_title','The Project'),(184940,2698,'_sec_3_title','field_5de6e3d37d8da'),(184941,2698,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(184942,2698,'_sec_3_text','field_5de6e4044e5e8'),(184943,2698,'page_col_image_2','436'),(184944,2698,'_page_col_image_2','field_5de6546e7c63a'),(184945,2698,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(184946,2698,'_sec_2_button','field_5de6e58c86706'),(184947,2698,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(184948,2698,'_sec_3_button','field_5de6e5a243c03'),(184949,2698,'page_col_image_4','455'),(184950,2698,'_page_col_image_4','field_5de70801090ce'),(184951,2698,'sec_4_title','Location'),(184952,2698,'_sec_4_title','field_5de7082a12a81'),(184953,2698,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(184954,2698,'_sec_4_text','field_5de7084812a82'),(184955,2698,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(184956,2698,'_sec_4_button','field_5de7085e12a83'),(184957,2698,'news_title','Project updates'),(184958,2698,'_news_title','field_5de78da3aabb9'),(184959,2698,'sec_2_text_copy',''),(184960,2698,'_sec_2_text_copy','field_5de78dc89e613'),(184961,2698,'timeline-title','Timeline'),(184962,2698,'_timeline-title','field_5de78df29e615'),(184963,2698,'timeline_title','Timeline'),(184964,2698,'_timeline_title','field_5de78df29e615'),(184965,2698,'contact_title','Contact us'),(184966,2698,'_contact_title','field_5de7981e06057'),(184967,2698,'contact_intro','Contact text...'),(184968,2698,'_contact_intro','field_5de7983506058'),(184969,2698,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(184970,2698,'_news_button','field_5de8329896e02'),(184971,2698,'timeline_intro','Introduction of timeline detail...'),(184972,2698,'_timeline_intro','field_5de98f5fb1781'),(184973,2698,'timeline_pic','477'),(184974,2698,'_timeline_pic',