s_3_prob_icon','field_640fa0291d519'),(182256,2672,'problem_icons_3_prob_concerned_stat','64% highly concerned'),(182257,2672,'_problem_icons_3_prob_concerned_stat','field_640fa0dd81d95'),(182258,2672,'problem_icons_3_prob_concerded_text','are highly concerned'),(182259,2672,'_problem_icons_3_prob_concerded_text','field_640fa10181d96'),(182260,2672,'problem_icons_3_prob_issue_text',''),(182261,2672,'_problem_icons_3_prob_issue_text','field_640fa11a81d97'),(182262,2672,'problem_icons_0_prob_concerned_text','House prices have doubled in a decade'),(182263,2672,'_problem_icons_0_prob_concerned_text','field_640fa10181d96'),(182264,2672,'problem_icons_1_prob_concerned_text','The gap between rich and poor is growing'),(182265,2672,'_problem_icons_1_prob_concerned_text','field_640fa10181d96'),(182266,2672,'problem_icons_2_prob_concerned_text','Construction of social housing is down'),(182267,2672,'_problem_icons_2_prob_concerned_text','field_640fa10181d96'),(182268,2672,'problem_icons_3_prob_concerned_text','Banks are making more than ever from housing'),(182269,2672,'_problem_icons_3_prob_concerned_text','field_640fa10181d96'),(182270,2672,'monitor_content','The Australian Housing Monitor is a large, nationally-representative survey covering public experiences and attitudes toward housing related issues. Questions range from how well the respondent is keeping up with their mortgage/rent, to what they think about social housing construction.\r\n\r\nA broad range of demographic criteria are included, such as gender, location, age, income, voting preference, educational level, tenure type, and employment status. These variables allow CEH researchers to understand the trends and diversity of opinion around the country.\r\n\r\nIt also incorporates questions from previous surveys to track trends over time.\r\nThe inaugural poll was conducted by Essential in December 2022, and was completed by 4,735 people.'),(182271,2672,'_monitor_content','field_640fcc4014404'),(182272,2672,'problem_head','Housing in Australia is not working, and Australians are concerned.'),(182273,2672,'_problem_head','field_641935436aded'),(182274,2672,'problem_signoff','Explore the research showing how concerned Australians are our about the housing situation.'),(182275,2672,'_problem_signoff','field_641935626adee'),(182276,2672,'sections','a:2:{i:0;s:4:\"hero\";i:1;s:9:\"news_grid\";}'),(182277,2672,'_sections','field_5dafb40b8143a'),(182278,2672,'sections_0_is_full_height','1'),(182279,2672,'_sections_0_is_full_height','field_61d6f6fd5a37e'),(182280,2672,'sections_0_image','1648'),(182281,2672,'_sections_0_image','field_61d6f6d45a37d'),(182282,2672,'sections_0_heading','Heading'),(182283,2672,'_sections_0_heading','field_61d6f69e5a379'),(182284,2672,'sections_0_subtitle','Ya ya '),(182285,2672,'_sections_0_subtitle','field_61d6f6ac5a37a'),(182286,2672,'sections_0_link_one',''),(182287,2672,'_sections_0_link_one','field_61d6f6b55a37b'),(182288,2672,'sections_0_link_two',''),(182289,2672,'_sections_0_link_two','field_61d6f6c35a37c'),(182290,2672,'sections_1_select_categories','a:1:{i:0;s:2:\"27\";}'),(182291,2672,'_sections_1_select_categories','field_637f04483b63b'),(182292,2672,'intro_head_major','Welcome to the Disability Dialogue'),(182293,2672,'_intro_head_major','field_64e828783ad9f'),(182294,2672,'intro_head_minor',''),(182295,2672,'_intro_head_minor','field_64e8288c3ada0'),(182296,2672,'intro_icons_0_int_icon','1922'),(182297,2672,'_intro_icons_0_int_icon','field_64e828b33ada2'),(182298,2672,'intro_icons_0_int_icon_text','At 1,727,000 square kilometres, we’re 2.5 times the size of Texas. <span>Yeeha!</span>'),(182299,2672,'_intro_icons_0_int_icon_text','field_64e828e33ada3'),(182300,2672,'intro_icons_1_int_icon','1920'),(182301,2672,'_intro_icons_1_int_icon','field_64e828b33ada2'),(182302,2672,'intro_icons_1_int_icon_text','We have twice as many species of native plant and animal as any other Australian state or territory.'),(182303,2672,'_intro_icons_1_int_i