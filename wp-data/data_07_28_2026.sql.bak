eld_6294564042238'),(125198,2177,'survey_index_5_survey_url','#'),(125199,2177,'_survey_index_5_survey_url','field_6294564e42239'),(125200,2177,'survey_index_5_survey_url_text','View Results'),(125201,2177,'_survey_index_5_survey_url_text','field_629456584223a'),(125202,2177,'survey_index_6_survey_icon','1492'),(125203,2177,'_survey_index_6_survey_icon','field_6294562942237'),(125204,2177,'survey_index_6_survey_title','Energy Management'),(125205,2177,'_survey_index_6_survey_title','field_6294564042238'),(125206,2177,'survey_index_6_survey_url','#'),(125207,2177,'_survey_index_6_survey_url','field_6294564e42239'),(125208,2177,'survey_index_6_survey_url_text','View Results'),(125209,2177,'_survey_index_6_survey_url_text','field_629456584223a'),(125210,2177,'survey_index_7_survey_icon','1493'),(125211,2177,'_survey_index_7_survey_icon','field_6294562942237'),(125212,2177,'survey_index_7_survey_title','Going Off-grid'),(125213,2177,'_survey_index_7_survey_title','field_6294564042238'),(125214,2177,'survey_index_7_survey_url','#'),(125215,2177,'_survey_index_7_survey_url','field_6294564e42239'),(125216,2177,'survey_index_7_survey_url_text','View Results'),(125217,2177,'_survey_index_7_survey_url_text','field_629456584223a'),(125218,2177,'survey_index','8'),(125219,2177,'_survey_index','field_6294561242236'),(125220,2177,'report_title','Download the report'),(125221,2177,'_report_title','field_62f30edfb57e1'),(125222,2177,'report_intro','Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus massa erat, consectetur at semper at, feugiat vel orci. '),(125223,2177,'_report_intro','field_62f30eedb57e2'),(125224,2177,'report_link_url','#'),(125225,2177,'_report_link_url','field_62f30ef4b57e3'),(125226,2177,'report_link_text','Download'),(125227,2177,'_report_link_text','field_62f30f01b57e4'),(125228,2177,'solutions_content','The housing system is complex, and no one solution will solve the complex problems we now face but there are some critical first steps to be taken now.\r\n<ul>\r\n 	<li>Set out an ambitious national housing agreement between commonwealth and state governments with targets and funding for the construction of affordable homes.</li>\r\n 	<li>Phase out tax breaks for property investors and using the increase in revenue to build more public housing.</li>\r\n 	<li>Establish laws which limit rental increases beyond what is fair.</li>\r\n 	<li>Rebalance tenancy laws to provide renters with more security and control, such as eliminating no grounds evictions.</li>\r\n 	<li>Phase out stamp duty and replace it with a broad-based land tax.</li>\r\n</ul>\r\n<h4>While there are many opinions on what policy changes will fix the housing market, doing nothing is not an option.</h4>'),(125229,2177,'_solutions_content','field_640e8b307a958'),(125230,2177,'problem_icons_0_prob_icon','1699'),(125231,2177,'_problem_icons_0_prob_icon','field_640fa0291d519'),(125232,2177,'problem_icons_0_prob_concerned_stat','70% highly concerned'),(125233,2177,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(125234,2177,'problem_icons_0_prob_concerded_text','are highly concerned'),(125235,2177,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(125236,2177,'problem_icons_0_prob_issue_text',''),(125237,2177,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(125238,2177,'problem_icons','4'),(125239,2177,'_problem_icons','field_640fa0191d518'),(125240,2177,'ceh_content_left',''),(125241,2177,'_ceh_content_left','field_640e97e8f1c8c'),(125242,2177,'ceh_content_right',''),(125243,2177,'_ceh_content_right','field_640e97fdf1c8d'),(125244,2177,'pc_content_left',''),(125245,2177,'_pc_content_left','field_640e983bf1c8f'),(125246,2177,'pc_content_right',''),(125247,2177,'_pc_content_right','field_640e984df1c90'),(125248,2177,'problem_icons_1_prob_icon','1699'),(125249,2177,'_problem_icons_1_prob_icon','field_640fa0291d519'),(125250,2177,'problem_icons_1_prob_concerned_stat','69% highly concerned'),(125251,2177,'_problem_i