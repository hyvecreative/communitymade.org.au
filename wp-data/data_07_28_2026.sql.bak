survey_title','field_6294564042238'),(82838,1916,'survey_index_6_survey_url','#'),(82839,1916,'_survey_index_6_survey_url','field_6294564e42239'),(82840,1916,'survey_index_6_survey_url_text','View Results'),(82841,1916,'_survey_index_6_survey_url_text','field_629456584223a'),(82842,1916,'survey_index_7_survey_icon','1493'),(82843,1916,'_survey_index_7_survey_icon','field_6294562942237'),(82844,1916,'survey_index_7_survey_title','Going Off-grid'),(82845,1916,'_survey_index_7_survey_title','field_6294564042238'),(82846,1916,'survey_index_7_survey_url','#'),(82847,1916,'_survey_index_7_survey_url','field_6294564e42239'),(82848,1916,'survey_index_7_survey_url_text','View Results'),(82849,1916,'_survey_index_7_survey_url_text','field_629456584223a'),(82850,1916,'survey_index','8'),(82851,1916,'_survey_index','field_6294561242236'),(82852,1916,'report_title','Download the report'),(82853,1916,'_report_title','field_62f30edfb57e1'),(82854,1916,'report_intro','Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus massa erat, consectetur at semper at, feugiat vel orci. '),(82855,1916,'_report_intro','field_62f30eedb57e2'),(82856,1916,'report_link_url','#'),(82857,1916,'_report_link_url','field_62f30ef4b57e3'),(82858,1916,'report_link_text','Download'),(82859,1916,'_report_link_text','field_62f30f01b57e4'),(82860,1916,'solutions_content','The housing system is complex, and no one solution will solve the complex problems we now face but there are some critical first steps to be taken now.\r\n<ul>\r\n 	<li>Set out an ambitious national housing agreement between commonwealth and state governments with targets and funding for the construction of affordable homes.</li>\r\n 	<li>Phase out tax breaks for property investors and using the increase in revenue to build more public housing.</li>\r\n 	<li>Establish laws which limit rental increases beyond what is fair.</li>\r\n 	<li>Rebalance tenancy laws to provide renters with more security and control, such as eliminating no grounds evictions.</li>\r\n 	<li>Phase out stamp duty and replace it with a broad-based land tax.</li>\r\n</ul>\r\n<h4>While there are many opinions on what policy changes will fix the housing market, doing nothing is not an option.</h4>'),(82861,1916,'_solutions_content','field_640e8b307a958'),(82862,1916,'problem_icons_0_prob_icon','1699'),(82863,1916,'_problem_icons_0_prob_icon','field_640fa0291d519'),(82864,1916,'problem_icons_0_prob_concerned_stat','70% highly concerned'),(82865,1916,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(82866,1916,'problem_icons_0_prob_concerded_text','are highly concerned'),(82867,1916,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(82868,1916,'problem_icons_0_prob_issue_text',''),(82869,1916,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(82870,1916,'problem_icons','4'),(82871,1916,'_problem_icons','field_640fa0191d518'),(82872,1916,'ceh_content_left',''),(82873,1916,'_ceh_content_left','field_640e97e8f1c8c'),(82874,1916,'ceh_content_right',''),(82875,1916,'_ceh_content_right','field_640e97fdf1c8d'),(82876,1916,'pc_content_left',''),(82877,1916,'_pc_content_left','field_640e983bf1c8f'),(82878,1916,'pc_content_right',''),(82879,1916,'_pc_content_right','field_640e984df1c90'),(82880,1916,'problem_icons_1_prob_icon','1699'),(82881,1916,'_problem_icons_1_prob_icon','field_640fa0291d519'),(82882,1916,'problem_icons_1_prob_concerned_stat','69% highly concerned'),(82883,1916,'_problem_icons_1_prob_concerned_stat','field_640fa0dd81d95'),(82884,1916,'problem_icons_1_prob_concerded_text','are highly concerned'),(82885,1916,'_problem_icons_1_prob_concerded_text','field_640fa10181d96'),(82886,1916,'problem_icons_1_prob_issue_text',''),(82887,1916,'_problem_icons_1_prob_issue_text','field_640fa11a81d97'),(82888,1916,'problem_icons_2_prob_icon','1699'),(82889,1916,'_problem_icons_2_prob_icon','field_640fa0291d519'),(82890,1916,'problem_icons_2_prob_concerned_stat','64% highly concerned'),(82891,1916,'_problem_icons_2_prob_concerned_stat','field_640fa0dd81d95'),(82892,1916,'problem_icons_2_prob_concerded_text','are highly concerned'),(82893,1916,'_problem_icons_2_prob_concerded_text','field_640fa10181d96'),(82894,1916,'problem_icons_2_prob_issue_text',''),(82895,1916,'_problem_icons_2_prob_issue_text','field_640fa11a81d97'),(82896,1916,'problem_icons_3_prob_icon','1699'),(82897,1916,'_problem_icons_3_prob_icon','field_640fa0291d519'),(82898,1916,'problem_icons_3_prob_concerned_stat','64% highly concerned'),(82899,1916,'_problem_icons_3_prob_concerned_stat','field_640fa0dd81d95'),(82900,1916,'problem_icons_3_prob_concerded_text','are highly concerned'),(82901,1916,'_problem_icons_3_prob_concerded_text','field_640fa10181d96'),(82902,1916,'problem_icons_3_prob_issue_text',''),(82903,1916,'_problem_icons_3_prob_issue_text','field_640fa11a81d97'),(82904,1916,'problem_icons_0_prob_concerned_text','House prices have doubled in a decade'),(82905,1916,'_problem_icons_0_prob_concerned_text','field_640fa10181d96'),(82906,1916,'problem_icons_1_prob_concerned_text','The gap between rich and poor is growing'),(82907,1916,'_problem_icons_1_prob_concerned_text','field_640fa10181d96'),(82908,1916,'problem_icons_2_prob_concerned_text','Construction of social housing is down'),(82909,1916,'_problem_icons_2_prob_concerned_text','field_640fa10181d96'),(82910,1916,'problem_icons_3_prob_concerned_text','Banks are making more than ever from housing'),(82911,1916,'_problem_icons_3_prob_concerned_text','field_640fa10181d96'),(82912,1916,'monitor_content','The Australian Housing Monitor is a large, nationally-representative survey covering public experiences and attitudes toward housing related issues. Questions range from how well the respondent is keeping up with their mortgage/rent, to what they think about social housing construction.\r\n\r\nA broad range of demographic criteria are included, such as gender, location, age, income, voting preference, educational level, tenure type, and employment status. These variables allow CEH researchers to understand the trends and diversity of opinion around the country.\r\n\r\nIt also incorporates questions from previous surveys to track trends over time.\r\nThe inaugural poll was conducted by Essential in December 2022, and was completed by 4,735 people.'),(82913,1916,'_monitor_content','field_640fcc4014404'),(82914,1916,'problem_head','Housing in Australia is not working, and Australians are concerned.'),(82915,1916,'_problem_head','field_641935436aded'),(82916,1916,'problem_signoff','Explore the research showing how concerned Australians are our about the housing situation.'),(82917,1916,'_problem_signoff','field_641935626adee'),(82918,1916,'sections','a:2:{i:0;s:4:\"hero\";i:1;s:9:\"news_grid\";}'),(82919,1916,'_sections','field_5dafb40b8143a'),(82920,1916,'sections_0_is_full_height','1'),(82921,1916,'_sections_0_is_full_height','field_61d6f6fd5a37e'),(82922,1916,'sections_0_image','1648'),(82923,1916,'_sections_0_image','field_61d6f6d45a37d'),(82924,1916,'sections_0_heading','Heading'),(82925,1916,'_sections_0_heading','field_61d6f69e5a379'),(82926,1916,'sections_0_subtitle','Ya ya '),(82927,1916,'_sections_0_subtitle','field_61d6f6ac5a37a'),(82928,1916,'sections_0_link_one',''),(82929,1916,'_sections_0_link_one','field_61d6f6b55a37b'),(82930,1916,'sections_0_link_two',''),(82931,1916,'_sections_0_link_two','field_61d6f6c35a37c'),(82932,1916,'sections_1_select_categories','a:1:{i:0;s:2:\"27\";}'),(82933,1916,'_sections_1_select_categories','field_637f04483b63b'),(82934,1916,'intro_head_major','Queenslanders are known for both our love of the great outdoors and our state pride…'),(82935,1916,'_intro_head_major','field_64e828783ad9f'),(82936,1916,'intro_head_minor','But there’s a few things you might not know about our beautiful state.'),(82937,1916,'_intro_head_minor','field_64e8288c3ada0'),(82938,1916,'intro_icons_0_int_icon',''),(82939,1916,'_intro_icons_0_int_icon','field_64e828b33ada2'),(82940,1916,'intro_icons_0_int_icon_text','At 1,727,000 square kilometres, we’re 2.5 times the size of Texas. <span>Yeeha!</span>'),(82941,1916,'_intro_icons_0_int_icon_text','field_64e828e33ada3'),(82942,1916,'intro_icons_1_int_icon',''),(82943,1916,'_intro_icons_1_int_icon','field_64e828b33ada2'),(82944,1916,'intro_icons_1_int_icon_text','We have twice as many species of native plant and animal as any other Australian state or territory.'),(82945,1916,'_intro_icons_1_int_icon_text','field_64e828e33ada3'),(82946,1916,'intro_icons_2_int_icon',''),(82947,1916,'_intro_icons_2_int_icon','field_64e828b33ada2'),(82948,1916,'intro_icons_2_int_icon_text','We have less land classified as ‘protected’ than any other state or territory.'),(82949,1916,'_intro_icons_2_int_icon_text','field_64e828e33ada3'),(82950,1916,'intro_icons','3'),(82951,1916,'_intro_icons','field_64e828963ada1'),(82952,1916,'threat_head_major','What we stand to lose if we don’t act soon to protect beautiful Queensland:'),(82953,1916,'_threat_head_major','field_64ec258d9dbd1'),(82954,1916,'threats_icons','3'),(82955,1916,'_threats_icons','field_64ec2551a93f9'),(82956,1916,'threats_icons_0_thr_icon','1819'),(82957,1916,'_threats_icons_0_thr_icon','field_64ec2551a93fa'),(82958,1916,'threats_icons_0_thr_icon_text','The rich cultural heritage of our First Nations people and their continuous ties to country, dating back more than 50,000 years.'),(82959,1916,'_threats_icons_0_thr_icon_text','field_64ec2551a93fb'),(82960,1916,'threats_icons_1_thr_icon','1819'),(82961,1916,'_threats_icons_1_thr_icon','field_64ec2551a93fa'),(82962,1916,'threats_icons_1_thr_icon_text','Thousands of species of plant and animal which are now classified as threatened or endangered in Queensland.'),(82963,1916,'_threats_icons_1_thr_icon_text','field_64ec2551a93fb'),(82964,1916,'threats_icons_2_thr_icon','1819'),(82965,1916,'_threats_icons_2_thr_icon','field_64ec2551a93fa'),(82966,1916,'threats_icons_2_thr_icon_text','The access to nature that is cent