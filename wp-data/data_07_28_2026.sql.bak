der_6_','field_64fd7321b85f5'),(190353,2711,'signup_subhead','Queenslanders are coming together to protect our beautiful state and safeguard our way of life.'),(190354,2711,'_signup_subhead','field_64fd834dd90ab'),(190355,2711,'signup_form','[actionnetwork id=7]'),(190356,2711,'_signup_form','field_64fd8361d90ac'),(190357,2711,'signup_head','Join the campaign'),(190358,2711,'_signup_head','field_64fd83dc6b0b1'),(190359,2711,'boxes_section_title','Boxes'),(190360,2711,'_boxes_section_title','field_65262bbfd17fc'),(190361,2711,'intro_boxes_0_box_icon','1943'),(190362,2711,'_intro_boxes_0_box_icon','field_65262db5d36ee'),(190363,2711,'intro_boxes_0_box_title','Events'),(190364,2711,'_intro_boxes_0_box_title','field_65262d29ed8e3'),(190365,2711,'intro_boxes_0_box_dropdown','Our rigorous, conflict-free research and data analysis lifts the lid on fund performance, fees and insurance. Drawing on our policy expertise, we turn this analysis into action by using it to back reform and make super easier for people to understand. <a href=\"//localhost:4000:4000:4000:4000:4000:4000:/how/\">More</a>'),(190366,2711,'_intro_boxes_0_box_dropdown','field_65262dead0a0c'),(190367,2711,'intro_boxes_1_box_icon','1941'),(190368,2711,'_intro_boxes_1_box_icon','field_65262db5d36ee'),(190369,2711,'intro_boxes_1_box_title','Projects'),(190370,2711,'_intro_boxes_1_box_title','field_65262d29ed8e3'),(190371,2711,'intro_boxes_1_box_dropdown','Our rigorous, conflict-free research and data analysis lifts the lid on fund performance, fees and insurance. Drawing on our policy expertise, we turn this analysis into action by using it to back reform and make super easier for people to understand. <a href=\"//localhost:4000:4000:4000:4000:4000:4000:/how/\">More</a>'),(190372,2711,'_intro_boxes_1_box_dropdown','field_65262dead0a0c'),(190373,2711,'intro_boxes_2_box_icon','1937'),(190374,2711,'_intro_boxes_2_box_icon','field_65262db5d36ee'),(190375,2711,'intro_boxes_2_box_title','Ideas'),(190376,2711,'_intro_boxes_2_box_title','field_65262d29ed8e3'),(190377,2711,'intro_boxes_2_box_dropdown','Our rigorous, conflict-free research and data analysis lifts the lid on fund performance, fees and insurance. Drawing on our policy expertise, we turn this analysis into action by using it to back reform and make super easier for people to understand. <a href=\"//localhost:4000:4000:4000:4000:4000:4000:/how/\">More</a>'),(190378,2711,'_intro_boxes_2_box_dropdown','field_65262dead0a0c'),(190379,2711,'intro_boxes','3'),(190380,2711,'_intro_boxes','field_65262d14ed8e2'),(190381,2711,'get_help_section_title','Get Help'),(190382,2711,'_get_help_section_title','field_65262c35143de'),(190383,2711,'get_help_block_home',''),(190384,2711,'_get_help_block_home','field_65262c8a143e1'),(190385,2711,'gh_block_home_0_help_image','1956'),(190386,2711,'_gh_block_home_0_help_image','field_65262cd0143e2'),(190387,2711,'gh_block_home_0_help_title','How much do I need to retire? '),(190388,2711,'_gh_block_home_0_help_title','field_65262cec143e3'),(190389,2711,'gh_block_home_0_help_url','#'),(190390,2711,'_gh_block_home_0_help_url','field_65262cf4143e4'),(190391,2711,'gh_block_home_1_help_image','1962'),(190392,2711,'_gh_block_home_1_help_image','field_65262cd0143e2'),(190393,2711,'gh_block_home_1_help_title','I have a problem with  my super fund'),(190394,2711,'_gh_block_home_1_help_title','field_65262cec143e3'),(190395,2711,'gh_block_home_1_help_url','#'),(190396,2711,'_gh_block_home_1_help_url','field_65262cf4143e4'),(190397,2711,'gh_block_home_2_help_image','1961'),(190398,2711,'_gh_block_home_2_help_image','field_65262cd0143e2'),(190399,2711,'gh_block_home_2_help_title','How do I choose the right super? '),(190400,2711,'_gh_block_home_2_help_title','field_65262cec143e3'),(190401,2711,'gh_block_home_2_help_url','#'),(190402,2711,'_gh_block_home_2_help_url','field_65262cf4143e4'),(190403,2711,'gh_block_home','3'),(190404,2711,'_gh_block_home','field_65262c8a143e1'),(190405,2711,'turn_on_insights',''),(190406,2711,'_turn_on_insights','field_645c4a2e654a6'),(190407,2711,'report_questions','a:3:{i:0;s:2:\"59\";i:1;s:2:\"61\";i:2;s:4:\"2587\";}'),(190408,2711,'_report_questions','field_6109ed5e02e5a'),(190409,2711,'intro_text','The Disability Dialogue is a place where people with disabilities, their families, organisations providing support, academics, and the wider community come together to work on things that matter to us.\r\n\r\nThe Dialogue is a hub of knowledge and collaboration, separate from government, where we work together to come up. With new ideas on important topics. Our ideas can make a big difference in how services and systems are set up for people with disabilities.'),(190410,2711,'_intro_text','field_66441acfe963c'),(190411,2711,'word_link','#'),(190412,2711,'_word_link','field_6646c69723804'),(190413,2711,'pdf_link','#'),(190414,2711,'_pdf_link','field_6646c6da23805'),(190415,2711,'intro_boxes_0_box_image','2241'),(190416,2711,'_intro_boxes_0_box_image','field_65262db5d36ee'),(190417,2711,'intro_boxes_1_box_image','2179'),(190418,2711,'_intro_boxes_1_box_image','field_65262db5d36ee'),(190419,2711,'intro_boxes_2_box_image','2012'),(190420,2711,'_intro_boxes_2_box_image','field_65262db5d36ee'),(190421,2711,'intro_boxes_0_box_excerpt','Excerpt text here just a sentance or so and no more.'),(190422,2711,'_intro_boxes_0_box_excerpt','field_665975273e827'),(190423,2711,'intro_boxes_1_box_excerpt','Excerpt text here just a sentance or so and no more.'),(190424,2711,'_intro_boxes_1_box_excerpt','field_665975273e827'),(190425,2711,'intro_boxes_2_box_excerpt','Excerpt text here just a sentance or so and no more.'),(190426,2711,'_intro_boxes_2_box_excerpt','field_665975273e827'),(190427,2711,'intro_boxes_0_btn-text','Latest events'),(190428,2711,'_intro_boxes_0_btn-text','field_665abda8b8d4b'),(190429,2711,'intro_boxes_1_btn-text','Latest projects'),(190430,2711,'_intro_boxes_1_btn-text','field_665abda8b8d4b'),(190431,2711,'intro_boxes_2_btn-text','Latest ideas'),(190432,2711,'_intro_boxes_2_btn-text','field_665abda8b8d4b'),(190433,2711,'display-easy-read',''),(190434,2711,'_display-easy-read','field_666129bd2da00'),(190435,2711,'hm_hero_sum','Statement about the issue and lost life savings'),(190436,2711,'_hm_hero_sum','field_64ed37241effa'),(190437,2711,'hm_hero_sub','When housing is affordable, communities thrive – that’s what  community made means. Homes built and managed by not-for-profits with purpose, not profit.'),(190438,2711,'_hm_hero_sub','field_64ed37241effa'),(190439,2711,'intro_head','We’re here to help.'),(190440,2711,'_intro_head','field_64e828783ad9f'),(190441,2711,'intro_content','About 12,000 people invested their hard-earned super savings in two investment funds which have now collapsed, called Shield Master Fund and First Guardian Master Fund. Most people will be entitled to get some money back, but you need to take action soon. This website has information and tools to help you understand what happened, where to get help and how to take back your super.'),(190442,2711,'_intro_content','field_66441acfe963c'),(190443,2711,'deadline_heading','Important deadlines'),(190444,2711,'_deadline_heading','field_69365ff82e6f2'),(190445,2711,'deadline_content','You need to take action before the deadline to take your super back.'),(190446,2711,'_deadline_content','field_693660342e6f3'),(190447,2711,'deadline_button_text','Find out more'),(190448,2711,'_deadline_button_text','field_693660482e6f4'),(190449,2711,'deadline_button_url','/key-deadlines/'),(190450,2711,'_deadline_button_url','field_693660912e6f5'),(190451,2711,'what_head','What happened?'),(190452,2711,'_what_head','field_69366611096ac'),(190453,2711,'what_happened_0_happ_sub','What are Shield and First Guardian?'),(190454,2711,'_what_happened_0_happ_sub','field_693d4a8b4197d'),(190455,2711,'what_happened_0_happ_content','About 12,000 people invested their hard-earned super savings in two investment funds called Shield Master Fund and First Guardian Master Fund. Those funds have collapsed, and a large part of the $1.2 billion people invested is gone.\r\n\r\nMost people invested through financial advisers who contacted them after they clicked on a social media ad offering a free super comparison or review.'),(190456,2711,'_what_happened_0_happ_content','field_693d4aa84197e'),(190457,2711,'what_happened_0_happ_url','/what-happened/'),(190458,2711,'_what_happened_0_happ_url','field_693d4aba4197f'),(190459,2711,'what_happened_0_happ_link_text','More'),(190460,2711,'_what_happened_0_happ_link_text','field_693d4ad641980'),(190461,2711,'what_happened_1_happ_sub','What is being done about this?'),(190462,2711,'_what_happened_1_happ_sub','field_693d4a8b4197d'),(190463,2711,'what_happened_1_happ_content','There is a lot of work being done to try to get money back for people who invested.\r\n\r\nThe regulator is also investigating what happened and has started enforcement action against a number of different people and companies for their involvement in the collapses of Shield and First Guardian Master Funds. Learn about the progress of this work'),(190464,2711,'_what_happened_1_happ_content','field_693d4aa84197e'),(190465,2711,'what_happened_1_happ_url','/what-happened/'),(190466,2711,'_what_happened_1_happ_url','field_693d4aba4197f'),(190467,2711,'what_happened_1_happ_link_text','More'),(190468,2711,'_what_happened_1_happ_link_text','field_693d4ad641980'),(190469,2711,'what_happened','2'),(190470,2711,'_what_happened','field_693d4a6f4197c'),(190471,2711,'what_happened_0_happ_icon','2605'),(190472,2711,'_what_happened_0_happ_icon','field_693d4c9b3ec4d'),(190473,2711,'what_happened_1_happ_icon','2604'),(190474,2711,'_what_happened_1_happ_icon','field_693d4c9b3ec4d'),(190475,2711,'display_news_section',''),(190476,2711,'_display_news_section','field_69434cc6d5f7d'),(190477,2711,'issues_head',''),(190478,2711,'_issues_head','field_6a3b076406aef'),(190479,2711,'issues_items_0_issue_icon','2705'),(190480,2711,'_issues_items_0_issue_icon','field_6a3b07b506af1'),(190481,2711,'issues_items_0_issues_item_hd','The problem'),(190482,2711,'_issues_items_0_issues_item_hd','field_6a3b07d706af2'),(190483,2711,'issues_items_0_issues_item_txt','Rents are rising, waitlists are growing and more people are experiencing housing stress for the first time.'),(190484,2711,'_issues_items_0_issues_item_txt','field_6a3b07fc06af3'),(190485,2711,'issues_items_0_issues_link_text','Find out more'),(190486,2711,'_issues_items_0_issues_link_text','field_6a3b080f06af4'),(190487,2711,'issues_items_0_issues_target_url','#'),(190488,2711,'_issues_items_0_issues_target_url','field_6a3b082b06af5'),(190489,2711,'issues_items','3'),(190490,2711,'_issues_items','field_6a3b078206af0'),(190491,2711,'issues_items_1_issue_icon','2708'),(190492,2711,'_issues_items_1_issue_icon','field_6a3b07b506af1'),(190493,2711,'issues_items_1_issues_item_hd','Scaling the solution'),(190494,2711,'_issues_items_1_issues_item_hd','field_6a3b07d706af2'),(190495,2711,'issues_items_1_issues_item_txt','Governments, communities and not-for-profit community housing providers are working together to make rental housing more affordable for everyone who calls NSW home.'),(190496,2711,'_issues_items_1_issues_item_txt','field_6a3b07fc06af3'),(190497,2711,'issues_items_1_issues_link_text',''),(190498,2711,'_issues_items_1_issues_link_text','field_6a3b080f06af4'),(190499,2711,'issues_items_1_issues_target_url',''),(190500,2711,'_issues_items_1_issues_target_url','field_6a3b082b06af5'),(190501,2711,'issues_items_0_issues_sub_head','The housing crisis is spiralling. '),(190502,2711,'_issues_items_0_issues_sub_head','field_6a3b0aa79365e'),(190503,2711,'issues_items_1_issues_sub_head','Community housing is social infrastructure.'),(190504,2711,'_issues_items_1_issues_sub_head','field_6a3b0aa79365e'),(190505,2711,'issues_items_2_issue_icon','2703'),(190506,2711,'_issues_items_2_issue_icon','field_6a3b07b506af1'),(190507,2711,'issues_items_2_issues_item_hd','Why community made:'),(190508,2711,'_issues_items_2_issues_item_hd','field_6a3b07d706af2'),(190509,2711,'issues_items_2_issues_sub_head',''),(190510,2711,'_issues_items_2_issues_sub_head','field_6a3b0aa79365e'),(190511,2711,'issues_items_2_issues_item_txt','Community housing is local. Every dollar invested is given back to community through homes, services and jobs. It’s built to thrive, like our communities.  Community housing is an investment in our state’s future. By investing in people today, we boost our local economies, communities and productivity – ensuring that NSW leads the nation.'),(190512,2711,'_issues_items_2_issues_item_txt','field_6a3b07fc06af3'),(190513,2711,'issues_items_2_issues_link_text',''),(190514,2711,'_issues_items_2_issues_link_text','field_6a3b080f06af4'),(190515,2711,'issues_items_2_issues_target_url',''),(190516,2711,'_issues_items_2_issues_target_url','field_6a3b082b06af5'),(190519,2712,'footnotes',''),(190521,2712,'banner_head',''),(190522,2712,'_banner_head','field_5b568121a8ffe'),(190523,2712,'banner_sub',''),(190524,2712,'_banner_sub','field_5b568139fd366'),(190525,2712,'banner_button','<a class=\"btn btn-home\" style=\"width: 200px;\" href=\"#project\">Sign the petition</a>'),(190526,2712,'_banner_button','field_5b568147fd367'),(190527,2712,'support_section_title','How can Lifestart support you?'),(190528,2712,'_support_section_title','field_5b67c7d060398'),(190529,2712,'support_left_title','Services'),(190530,2712,'_support_left_title','field_5b67c298e7f8f'),(190531,2712,'support_left_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy.'),(190532,2712,'_support_left_cont','field_5b67c5f6e7f91'),(190533,2712,'support_left_button','<a class=\"btn btn-green\" href=\"/services/\">View all services</a>'),(190534,2712,'_support_left_button','field_5b67c60ae7f92'),(190535,2712,'support_ctr_title','Talk to us'),(190536,2712,'_support_ctr_title','field_5b67c62a58af3'),(190537,2712,'support_ctr_cont','Lorem ipsum