earn more</a>'),(198799,2728,'_first_image_button','field_5b67cb0d6afc6'),(198800,2728,'second _image_title','Lifestart is about supporting young children'),(198801,2728,'_second _image_title','field_5b67cb20ddf9a'),(198802,2728,'second_image_cont','from 0-24 years living with disabilities and their familes'),(198803,2728,'_second_image_cont','field_5b67cb24ddf9b'),(198804,2728,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(198805,2728,'_second_image_button','field_5b67cb29ddf9c'),(198806,2728,'second_image_title','Lifestart is about supporting young children'),(198807,2728,'_second_image_title','field_5b67cb20ddf9a'),(198808,2728,'page_col_image','412'),(198809,2728,'_page_col_image','field_5de6546e7c63a'),(198810,2728,'page_col_image_3','437'),(198811,2728,'_page_col_image_3','field_5de6e3998e07e'),(198812,2728,'sec_2_title','Community'),(198813,2728,'_sec_2_title','field_5de6e3ef2798f'),(198814,2728,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(198815,2728,'_sec_2_text','field_5de78dc89e613'),(198816,2728,'sec_3_title','The Project'),(198817,2728,'_sec_3_title','field_5de6e3d37d8da'),(198818,2728,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(198819,2728,'_sec_3_text','field_5de6e4044e5e8'),(198820,2728,'page_col_image_2','436'),(198821,2728,'_page_col_image_2','field_5de6546e7c63a'),(198822,2728,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(198823,2728,'_sec_2_button','field_5de6e58c86706'),(198824,2728,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(198825,2728,'_sec_3_button','field_5de6e5a243c03'),(198826,2728,'page_col_image_4','455'),(198827,2728,'_page_col_image_4','field_5de70801090ce'),(198828,2728,'sec_4_title','Location'),(198829,2728,'_sec_4_title','field_5de7082a12a81'),(198830,2728,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(198831,2728,'_sec_4_text','field_5de7084812a82'),(198832,2728,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(198833,2728,'_sec_4_button','field_5de7085e12a83'),(198834,2728,'news_title','Project updates'),(198835,2728,'_news_title','field_5de78da3aabb9'),(198836,2728,'sec_2_text_copy',''),(198837,2728,'_sec_2_text_copy','field_5de78dc89e613'),(198838,2728,'timeline-title','Timeline'),(198839,2728,'_timeline-title','field_5de78df29e615'),(198840,2728,'timeline_title','Timeline'),(198841,2728,'_timeline_title','field_5de78df29e615'),(198842,2728,'contact_title','Contact us'),(198843,2728,'_contact_title','field_5de7981e06057'),(198844,2728,'contact_intro','Contact text...'),(198845,2728,'_contact_intro','field_5de7983506058'),(198846,2728,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(198847,2728,'_news_button','field_5de8329896e02'),(198848,2728,'timeline_intro','Introduction of timeline detail...'),(198849,2728,'_timeline_intro','field_5de98f5fb1781'),(198850,2728,'timeline_pic','477'),(198851,2728,'_timeline_pic','field_5de98f72b1782'),(198852,2728,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\