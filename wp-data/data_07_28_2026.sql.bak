ort_right_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut.'),(193780,2717,'_support_right_cont','field_5b67c6c98c065'),(193781,2717,'support_right_button','<a class=\"btn btn-blue\" href=\"#\">Read more</a>'),(193782,2717,'_support_right_button','field_5b67c6dd8c066'),(193783,2717,'first_image_title','Lifestart is about supporting young children'),(193784,2717,'_first_image_title','field_5b67ca606afc4'),(193785,2717,'first_image_cont','from 0-24 years living with disabilities and their familes'),(193786,2717,'_first_image_cont','field_5b67caff6afc5'),(193787,2717,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(193788,2717,'_first_image_button','field_5b67cb0d6afc6'),(193789,2717,'second _image_title','Lifestart is about supporting young children'),(193790,2717,'_second _image_title','field_5b67cb20ddf9a'),(193791,2717,'second_image_cont','from 0-24 years living with disabilities and their familes'),(193792,2717,'_second_image_cont','field_5b67cb24ddf9b'),(193793,2717,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(193794,2717,'_second_image_button','field_5b67cb29ddf9c'),(193795,2717,'second_image_title','Lifestart is about supporting young children'),(193796,2717,'_second_image_title','field_5b67cb20ddf9a'),(193797,2717,'page_col_image','412'),(193798,2717,'_page_col_image','field_5de6546e7c63a'),(193799,2717,'page_col_image_3','437'),(193800,2717,'_page_col_image_3','field_5de6e3998e07e'),(193801,2717,'sec_2_title','Community'),(193802,2717,'_sec_2_title','field_5de6e3ef2798f'),(193803,2717,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(193804,2717,'_sec_2_text','field_5de78dc89e613'),(193805,2717,'sec_3_title','The Project'),(193806,2717,'_sec_3_title','field_5de6e3d37d8da'),(193807,2717,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(193808,2717,'_sec_3_text','field_5de6e4044e5e8'),(193809,2717,'page_col_image_2','436'),(193810,2717,'_page_col_image_2','field_5de6546e7c63a'),(193811,2717,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(193812,2717,'_sec_2_button','field_5de6e58c86706'),(193813,2717,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(193814,2717,'_sec_3_button','field_5de6e5a243c03'),(193815,2717,'page_col_image_4','455'),(193816,2717,'_page_col_image_4','field_5de70801090ce'),(193817,2717,'sec_4_title','Location'),(193818,2717,'_sec_4_title','field_5de7082a12a81'),(193819,2717,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(193820,2717,'_sec_4_text','field_5de7084812a82'),(193821,2717,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(193822,2717,'_sec_4_button','field_5de7085e12a83'),(193823,2717,'news_title','Project updates'),(193824,2717,'_news_title','field_5de78da3aabb9'),(193825,2717,'sec_2_text_copy',''),(193826,2717,'_sec_2_text_copy','field_5de78dc89e613'),(193827,2717,'timeline-title','Timeline'),(193828,2717,'_timeline-title','field_5de78df29e615'),(193829,2717,'timeline_title','Timeline'),(193830,2717,'_t