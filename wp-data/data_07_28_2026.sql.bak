_image_cont','from 0-24 years living with disabilities and their familes'),(68705,1853,'_first_image_cont','field_5b67caff6afc5'),(68706,1853,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(68707,1853,'_first_image_button','field_5b67cb0d6afc6'),(68708,1853,'second _image_title','Lifestart is about supporting young children'),(68709,1853,'_second _image_title','field_5b67cb20ddf9a'),(68710,1853,'second_image_cont','from 0-24 years living with disabilities and their familes'),(68711,1853,'_second_image_cont','field_5b67cb24ddf9b'),(68712,1853,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(68713,1853,'_second_image_button','field_5b67cb29ddf9c'),(68714,1853,'second_image_title','Lifestart is about supporting young children'),(68715,1853,'_second_image_title','field_5b67cb20ddf9a'),(68716,1853,'page_col_image','412'),(68717,1853,'_page_col_image','field_5de6546e7c63a'),(68718,1853,'page_col_image_3','437'),(68719,1853,'_page_col_image_3','field_5de6e3998e07e'),(68720,1853,'sec_2_title','Community'),(68721,1853,'_sec_2_title','field_5de6e3ef2798f'),(68722,1853,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(68723,1853,'_sec_2_text','field_5de78dc89e613'),(68724,1853,'sec_3_title','The Project'),(68725,1853,'_sec_3_title','field_5de6e3d37d8da'),(68726,1853,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(68727,1853,'_sec_3_text','field_5de6e4044e5e8'),(68728,1853,'page_col_image_2','436'),(68729,1853,'_page_col_image_2','field_5de6546e7c63a'),(68730,1853,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(68731,1853,'_sec_2_button','field_5de6e58c86706'),(68732,1853,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(68733,1853,'_sec_3_button','field_5de6e5a243c03'),(68734,1853,'page_col_image_4','455'),(68735,1853,'_page_col_image_4','field_5de70801090ce'),(68736,1853,'sec_4_title','Location'),(68737,1853,'_sec_4_title','field_5de7082a12a81'),(68738,1853,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(68739,1853,'_sec_4_text','field_5de7084812a82'),(68740,1853,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(68741,1853,'_sec_4_button','field_5de7085e12a83'),(68742,1853,'news_title','Project updates'),(68743,1853,'_news_title','field_5de78da3aabb9'),(68744,1853,'sec_2_text_copy',''),(68745,1853,'_sec_2_text_copy','field_5de78dc89e613'),(68746,1853,'timeline-title','Timeline'),(68747,1853,'_timeline-title','field_5de78df29e615'),(68748,1853,'timeline_title','Timeline'),(68749,1853,'_timeline_title','field_5de78df29e615'),(68750,1853,'contact_title','Contact us'),(68751,1853,'_contact_title','field_5de7981e06057'),(68752,1853,'contact_intro','Contact text...'),(68753,1853,'_contact_intro','field_5de7983506058'),(68754,1853,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(68755,1853,'_news_button','field_5de8329896e02'),(68756,1853,'timeline_intro','Introduction of timeline detail...'),(68757,1853,'_timeline_intro','field_5de98f5fb1781'),(68758,1853,'timeline_pic',