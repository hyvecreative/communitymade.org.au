3'),(124699,2174,'_intro_boxes_0_box_icon','field_65262db5d36ee'),(124700,2174,'intro_boxes_0_box_title','Campaigning and policy'),(124701,2174,'_intro_boxes_0_box_title','field_65262d29ed8e3'),(124702,2174,'intro_boxes_0_box_dropdown','Our rigorous, conflict-free research and data analysis lifts the lid on fund performance, fees and insurance. Drawing on our policy expertise, we turn this analysis into action by using it to back reform and make super easier for people to understand. <a href=\"//localhost:4000:4000:4000:4000:4000/how/\">More</a> '),(124703,2174,'_intro_boxes_0_box_dropdown','field_65262dead0a0c'),(124704,2174,'intro_boxes_1_box_icon','1941'),(124705,2174,'_intro_boxes_1_box_icon','field_65262db5d36ee'),(124706,2174,'intro_boxes_1_box_title','Investigative journalism'),(124707,2174,'_intro_boxes_1_box_title','field_65262d29ed8e3'),(124708,2174,'intro_boxes_1_box_dropdown','Dropdown text'),(124709,2174,'_intro_boxes_1_box_dropdown','field_65262dead0a0c'),(124710,2174,'intro_boxes_2_box_icon','1937'),(124711,2174,'_intro_boxes_2_box_icon','field_65262db5d36ee'),(124712,2174,'intro_boxes_2_box_title','Research'),(124713,2174,'_intro_boxes_2_box_title','field_65262d29ed8e3'),(124714,2174,'intro_boxes_2_box_dropdown','Dropdown text'),(124715,2174,'_intro_boxes_2_box_dropdown','field_65262dead0a0c'),(124716,2174,'intro_boxes','3'),(124717,2174,'_intro_boxes','field_65262d14ed8e2'),(124718,2174,'get_help_section_title','Get Help'),(124719,2174,'_get_help_section_title','field_65262c35143de'),(124720,2174,'get_help_block_home',''),(124721,2174,'_get_help_block_home','field_65262c8a143e1'),(124722,2174,'gh_block_home_0_help_image','1956'),(124723,2174,'_gh_block_home_0_help_image','field_65262cd0143e2'),(124724,2174,'gh_block_home_0_help_title','How much do I need to retire? '),(124725,2174,'_gh_block_home_0_help_title','field_65262cec143e3'),(124726,2174,'gh_block_home_0_help_url','#'),(124727,2174,'_gh_block_home_0_help_url','field_65262cf4143e4'),(124728,2174,'gh_block_home_1_help_image','1962'),(124729,2174,'_gh_block_home_1_help_image','field_65262cd0143e2'),(124730,2174,'gh_block_home_1_help_title','I have a problem with  my super fund'),(124731,2174,'_gh_block_home_1_help_title','field_65262cec143e3'),(124732,2174,'gh_block_home_1_help_url','#'),(124733,2174,'_gh_block_home_1_help_url','field_65262cf4143e4'),(124734,2174,'gh_block_home_2_help_image','1961'),(124735,2174,'_gh_block_home_2_help_image','field_65262cd0143e2'),(124736,2174,'gh_block_home_2_help_title','How do I choose the right super? '),(124737,2174,'_gh_block_home_2_help_title','field_65262cec143e3'),(124738,2174,'gh_block_home_2_help_url','#'),(124739,2174,'_gh_block_home_2_help_url','field_65262cf4143e4'),(124740,2174,'gh_block_home','3'),(124741,2174,'_gh_block_home','field_65262c8a143e1'),(124742,2174,'turn_on_insights',''),(124743,2174,'_turn_on_insights','field_645c4a2e654a6'),(124744,2174,'report_questions','a:3:{i:0;s:4:\"1997\";i:1;s:4:\"2067\";i:2;s:4:\"2089\";}'),(124745,2174,'_report_questions','field_6109ed5e02e5a'),(124746,2174,'intro_text','The Disability Dialogue is a place where people with disabilities, their families, organisations providing support, academics, and the wider community come together to work on things that matter to us.\r\n\r\nThe Dialogue is a hub of knowledge and collaboration, separate from government, where we work together to come up. With new ideas on important topics. Our ideas can make a big difference in how services and systems are set up for people with disabilities.'),(124747,2174,'_intro_text','field_66441acfe963c'),(124750,2177,'footnotes',''),(124752,2177,'banner_head',''),(124753,2177,'_banner_head','field_5b568121a8ffe'),(124754,2177,'banner_sub',''),(124755,2177,'_banner_sub','field_5b568139fd366'),(124756,2177,'banner_button','<a class=\"btn btn-home\" style=\"width: 200px;\" href=\"#project\">Sign the petition</a>'),(124757,2177,'_banner_button','field_5b568147fd367'),(124758,2177,'support_section_title','How can Lifestart support you?'),(124759,2177,'_support_section_title','field_5b67c7d060398'),(124760,2177,'support_left_title','Services'),(124761,2177,'_support_left_title','field_5b67c298e7f8f'),(124762,2177,'support_left_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy.'),(124763,2177,'_support_left_cont','field_5b67c5f6e7f91'),(124764,2177,'support_left_button','<a class=\"btn btn-green\" href=\"/services/\">View all services</a>'),(124765,2177,'_support_left_button','field_5b67c60ae7f92'),(124766,2177,'support_ctr_title','Talk to us'),(124767,2177,'_support_ctr_title','field_5b67c62a58af3'),(124768,2177,'support_ctr_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut laoreet.'),(124769,2177,'_support_ctr_cont','field_5b67c63158af4'),(124770,2177,'support_ctr_button','<a class=\"btn btn-orange\" href=\"/supports/\">Find us</a>'),(124771,2177,'_support_ctr_button','field_5b67c63658af5'),(124772,2177,'support_right_title','NDIS Registered provider'),(124773,2177,'_support_right_title','field_5b67c6a38c064'),(124774,2177,'support_right_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut.'),(124775,2177,'_support_right_cont','field_5b67c6c98c065'),(124776,2177,'support_right_button','<a class=\"btn btn-blue\" href=\"#\">Read more</a>'),(124777,2177,'_support_right_button','field_5b67c6dd8c066'),(124778,2177,'first_image_title','Lifestart is about supporting young children'),(124779,2177,'_first_image_title','field_5b67ca606afc4'),(124780,2177,'first_image_cont','from 0-24 years living with disabilities and their familes'),(124781,2177,'_first_image_cont','field_5b67caff6afc5'),(124782,2177,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(124783,2177,'_first_image_button','field_5b67cb0d6afc6'),(124784,2177,'second _image_title','Lifestart is about supporting young children'),(124785,2177,'_second _image_title','field_5b67cb20ddf9a'),(124786,2177,'second_image_cont','from 0-24 years living with disabilities and their familes'),(124787,2177,'_second_image_cont','field_5b67cb24ddf9b'),(124788,2177,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(124789,2177,'_second_image_button','field_5b67cb29ddf9c'),(124790,2177,'second_image_title','Lifestart is about supporting young children'),(124791,2177,'_second_image_title','field_5b67cb20ddf9a'),(124792,2177,'page_col_image','412'),(124793,2177,'_page_col_image','field_5de6546e7c63a'),(124794,2177,'page_col_image_3','437'),(124795,2177,'_page_col_image_3','field_5de6e3998e07e'),(124796,2177,'sec_2_title','Community'),(124797,2177,'_sec_2_title','field_5de6e3ef2798f'),(124798,2177,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(124799,2177,'_sec_2_text','field_5de78dc89e613'),(124800,2177,'sec_3_title','The Project'),(124801,2177,'_sec_3_title','field_5de6e3d37d8da'),(124802,2177,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(124803,2177,'_sec_3_text','field_5de6e4044e5e8'),(124804,2177,'page_col_image_2','436'),(124805,2177,'_page_col_image_2','field_5de6546e7c63a'),(124806,2177,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(124807,2177,'_sec_2_button','field_5de6e58c86706'),(124808,2177,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(124809,2177,'_sec_3_button','field_5de6e5a243c03'),(124810,2177,'page_col_image_4','455'),(124811,2177,'_page_col_image_4','field_5de70801090ce'),(124812,2177,'sec_4_title','Location'),(124813,2177,'_sec_4_title','field_5de7082a12a81'),(124814,2177,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(124815,2177,'_sec_4_text','field_5de7084812a82'),(124816,2177,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(124817,2177,'_sec_4_button','field_5de7085e12a83'),(124818,2177,'news_title','Project updates'),(124819,2177,'_news_title','field_5de78da3aabb9'),(124820,2177,'sec_2_text_copy',''),(124821,2177,'_sec_2_text_copy','field_5de78dc89e613'),(124822,2177,'timeline-title','Timeline'),(124823,2177,'_timeline-title','field_5de78df29e615'),(124824,2177,'timeline_title','Timeline'),(124825,2177,'_timeline_title','field_5de78df29e615'),(124826,2177,'contact_title','Contact us'),(124827,2177,'_contact_title','field_5de7981e06057'),(124828,2177,'contact_intro','Contact text...'),(124829,2177,'_contact_intro','field_5de7983506058'),(124830,2177,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(124831,2177,'_news_button','field_5de8329896e02'),(124832,2177,'timeline_intro','Introduction of timeline detail...'),(124833,2177,'_timeline_intro','field_5de98f5fb1781'),(124834,2177,'timeline_pic','477'),(124835,2177,'_timeline_pic','field_5de98f72b1782'),(124836,2177,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(124837,2177,'_timeline_button','field_5de99363677f8'),(124838,2177,'banner_image_position','center'),(124839,2177,'_banner_image_position','field_5f3