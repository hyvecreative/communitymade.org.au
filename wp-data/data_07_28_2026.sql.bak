upport_ctr_cont','field_5b67c63158af4'),(92520,1944,'support_ctr_button','<a class=\"btn btn-orange\" href=\"/supports/\">Find us</a>'),(92521,1944,'_support_ctr_button','field_5b67c63658af5'),(92522,1944,'support_right_title','NDIS Registered provider'),(92523,1944,'_support_right_title','field_5b67c6a38c064'),(92524,1944,'support_right_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut.'),(92525,1944,'_support_right_cont','field_5b67c6c98c065'),(92526,1944,'support_right_button','<a class=\"btn btn-blue\" href=\"#\">Read more</a>'),(92527,1944,'_support_right_button','field_5b67c6dd8c066'),(92528,1944,'first_image_title','Lifestart is about supporting young children'),(92529,1944,'_first_image_title','field_5b67ca606afc4'),(92530,1944,'first_image_cont','from 0-24 years living with disabilities and their familes'),(92531,1944,'_first_image_cont','field_5b67caff6afc5'),(92532,1944,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(92533,1944,'_first_image_button','field_5b67cb0d6afc6'),(92534,1944,'second _image_title','Lifestart is about supporting young children'),(92535,1944,'_second _image_title','field_5b67cb20ddf9a'),(92536,1944,'second_image_cont','from 0-24 years living with disabilities and their familes'),(92537,1944,'_second_image_cont','field_5b67cb24ddf9b'),(92538,1944,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(92539,1944,'_second_image_button','field_5b67cb29ddf9c'),(92540,1944,'second_image_title','Lifestart is about supporting young children'),(92541,1944,'_second_image_title','field_5b67cb20ddf9a'),(92542,1944,'page_col_image','412'),(92543,1944,'_page_col_image','field_5de6546e7c63a'),(92544,1944,'page_col_image_3','437'),(92545,1944,'_page_col_image_3','field_5de6e3998e07e'),(92546,1944,'sec_2_title','Community'),(92547,1944,'_sec_2_title','field_5de6e3ef2798f'),(92548,1944,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(92549,1944,'_sec_2_text','field_5de78dc89e613'),(92550,1944,'sec_3_title','The Project'),(92551,1944,'_sec_3_title','field_5de6e3d37d8da'),(92552,1944,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(92553,1944,'_sec_3_text','field_5de6e4044e5e8'),(92554,1944,'page_col_image_2','436'),(92555,1944,'_page_col_image_2','field_5de6546e7c63a'),(92556,1944,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(92557,1944,'_sec_2_button','field_5de6e58c86706'),(92558,1944,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(92559,1944,'_sec_3_button','field_5de6e5a243c03'),(92560,1944,'page_col_image_4','455'),(92561,1944,'_page_col_image_4','field_5de70801090ce'),(92562,1944,'sec_4_title','Location'),(92563,1944,'_sec_4_title','field_5de7082a12a81'),(92564,1944,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(92565,1944,'_sec_4_text','field_5de7084812a82'),(92566,1944,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(92567,1944,'_sec_4_button','field_5de7085e12a83'),(92568,1944,'news_title','Project updates'),(92569,1