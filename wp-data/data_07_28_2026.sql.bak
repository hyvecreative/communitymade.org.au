n btn-blue\" href=\"#\">Read more</a>'),(212415,2788,'_support_right_button','field_5b67c6dd8c066'),(212416,2788,'first_image_title','Lifestart is about supporting young children'),(212417,2788,'_first_image_title','field_5b67ca606afc4'),(212418,2788,'first_image_cont','from 0-24 years living with disabilities and their familes'),(212419,2788,'_first_image_cont','field_5b67caff6afc5'),(212420,2788,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(212421,2788,'_first_image_button','field_5b67cb0d6afc6'),(212422,2788,'second _image_title','Lifestart is about supporting young children'),(212423,2788,'_second _image_title','field_5b67cb20ddf9a'),(212424,2788,'second_image_cont','from 0-24 years living with disabilities and their familes'),(212425,2788,'_second_image_cont','field_5b67cb24ddf9b'),(212426,2788,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(212427,2788,'_second_image_button','field_5b67cb29ddf9c'),(212428,2788,'second_image_title','Lifestart is about supporting young children'),(212429,2788,'_second_image_title','field_5b67cb20ddf9a'),(212430,2788,'page_col_image','412'),(212431,2788,'_page_col_image','field_5de6546e7c63a'),(212432,2788,'page_col_image_3','437'),(212433,2788,'_page_col_image_3','field_5de6e3998e07e'),(212434,2788,'sec_2_title','Community'),(212435,2788,'_sec_2_title','field_5de6e3ef2798f'),(212436,2788,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(212437,2788,'_sec_2_text','field_5de78dc89e613'),(212438,2788,'sec_3_title','The Project'),(212439,2788,'_sec_3_title','field_5de6e3d37d8da'),(212440,2788,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(212441,2788,'_sec_3_text','field_5de6e4044e5e8'),(212442,2788,'page_col_image_2','436'),(212443,2788,'_page_col_image_2','field_5de6546e7c63a'),(212444,2788,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(212445,2788,'_sec_2_button','field_5de6e58c86706'),(212446,2788,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(212447,2788,'_sec_3_button','field_5de6e5a243c03'),(212448,2788,'page_col_image_4','455'),(212449,2788,'_page_col_image_4','field_5de70801090ce'),(212450,2788,'sec_4_title','Location'),(212451,2788,'_sec_4_title','field_5de7082a12a81'),(212452,2788,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(212453,2788,'_sec_4_text','field_5de7084812a82'),(212454,2788,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(212455,2788,'_sec_4_button','field_5de7085e12a83'),(212456,2788,'news_title','Project updates'),(212457,2788,'_news_title','field_5de78da3aabb9'),(212458,2788,'sec_2_text_copy',''),(212459,2788,'_sec_2_text_copy','field_5de78dc89e613'),(212460,2788,'timeline-title','Timeline'),(212461,2788,'_timeline-title','field_5de78df29e615'),(212462,2788,'timeline_title','Timeline'),(212463,2788,'_timeline_title','field_5de78df29e615'),(212464,2788,'contact_title','Contact us'),(212465,2788,'_contact_title','field_5de7981e06057'),(212466,2788,'contact_intro','Contact text...'),(212467,2788,'_contact_intro','field_5de7983506