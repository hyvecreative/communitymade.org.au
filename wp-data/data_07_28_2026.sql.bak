66'),(173379,2589,'first_image_title','Lifestart is about supporting young children'),(173380,2589,'_first_image_title','field_5b67ca606afc4'),(173381,2589,'first_image_cont','from 0-24 years living with disabilities and their familes'),(173382,2589,'_first_image_cont','field_5b67caff6afc5'),(173383,2589,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(173384,2589,'_first_image_button','field_5b67cb0d6afc6'),(173385,2589,'second _image_title','Lifestart is about supporting young children'),(173386,2589,'_second _image_title','field_5b67cb20ddf9a'),(173387,2589,'second_image_cont','from 0-24 years living with disabilities and their familes'),(173388,2589,'_second_image_cont','field_5b67cb24ddf9b'),(173389,2589,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(173390,2589,'_second_image_button','field_5b67cb29ddf9c'),(173391,2589,'second_image_title','Lifestart is about supporting young children'),(173392,2589,'_second_image_title','field_5b67cb20ddf9a'),(173393,2589,'page_col_image','412'),(173394,2589,'_page_col_image','field_5de6546e7c63a'),(173395,2589,'page_col_image_3','437'),(173396,2589,'_page_col_image_3','field_5de6e3998e07e'),(173397,2589,'sec_2_title','Community'),(173398,2589,'_sec_2_title','field_5de6e3ef2798f'),(173399,2589,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(173400,2589,'_sec_2_text','field_5de78dc89e613'),(173401,2589,'sec_3_title','The Project'),(173402,2589,'_sec_3_title','field_5de6e3d37d8da'),(173403,2589,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(173404,2589,'_sec_3_text','field_5de6e4044e5e8'),(173405,2589,'page_col_image_2','436'),(173406,2589,'_page_col_image_2','field_5de6546e7c63a'),(173407,2589,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(173408,2589,'_sec_2_button','field_5de6e58c86706'),(173409,2589,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(173410,2589,'_sec_3_button','field_5de6e5a243c03'),(173411,2589,'page_col_image_4','455'),(173412,2589,'_page_col_image_4','field_5de70801090ce'),(173413,2589,'sec_4_title','Location'),(173414,2589,'_sec_4_title','field_5de7082a12a81'),(173415,2589,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(173416,2589,'_sec_4_text','field_5de7084812a82'),(173417,2589,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(173418,2589,'_sec_4_button','field_5de7085e12a83'),(173419,2589,'news_title','Project updates'),(173420,2589,'_news_title','field_5de78da3aabb9'),(173421,2589,'sec_2_text_copy',''),(173422,2589,'_sec_2_text_copy','field_5de78dc89e613'),(173423,2589,'timeline-title','Timeline'),(173424,2589,'_timeline-title','field_5de78df29e615'),(173425,2589,'timeline_title','Timeline'),(173426,2589,'_timeline_title','field_5de78df29e615'),(173427,2589,'contact_title','Contact us'),(173428,2589,'_contact_title','field_5de7981e06057'),(173429,2589,'contact_intro','Contact text...'),(173430,2589,'_contact_intro','field_5de7983506058'),(173431,2589,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all