867,'_survey_index_5_survey_title','field_6294564042238'),(73604,1867,'survey_index_5_survey_url','#'),(73605,1867,'_survey_index_5_survey_url','field_6294564e42239'),(73606,1867,'survey_index_5_survey_url_text','View Results'),(73607,1867,'_survey_index_5_survey_url_text','field_629456584223a'),(73608,1867,'survey_index_6_survey_icon','1492'),(73609,1867,'_survey_index_6_survey_icon','field_6294562942237'),(73610,1867,'survey_index_6_survey_title','Energy Management'),(73611,1867,'_survey_index_6_survey_title','field_6294564042238'),(73612,1867,'survey_index_6_survey_url','#'),(73613,1867,'_survey_index_6_survey_url','field_6294564e42239'),(73614,1867,'survey_index_6_survey_url_text','View Results'),(73615,1867,'_survey_index_6_survey_url_text','field_629456584223a'),(73616,1867,'survey_index_7_survey_icon','1493'),(73617,1867,'_survey_index_7_survey_icon','field_6294562942237'),(73618,1867,'survey_index_7_survey_title','Going Off-grid'),(73619,1867,'_survey_index_7_survey_title','field_6294564042238'),(73620,1867,'survey_index_7_survey_url','#'),(73621,1867,'_survey_index_7_survey_url','field_6294564e42239'),(73622,1867,'survey_index_7_survey_url_text','View Results'),(73623,1867,'_survey_index_7_survey_url_text','field_629456584223a'),(73624,1867,'survey_index','8'),(73625,1867,'_survey_index','field_6294561242236'),(73626,1867,'report_title','Download the report'),(73627,1867,'_report_title','field_62f30edfb57e1'),(73628,1867,'report_intro','Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus massa erat, consectetur at semper at, feugiat vel orci. '),(73629,1867,'_report_intro','field_62f30eedb57e2'),(73630,1867,'report_link_url','#'),(73631,1867,'_report_link_url','field_62f30ef4b57e3'),(73632,1867,'report_link_text','Download'),(73633,1867,'_report_link_text','field_62f30f01b57e4'),(73634,1867,'solutions_content','The housing system is complex, and no one solution will solve the complex problems we now face but there are some critical first steps to be taken now.\r\n<ul>\r\n 	<li>Set out an ambitious national housing agreement between commonwealth and state governments with targets and funding for the construction of affordable homes.</li>\r\n 	<li>Phase out tax breaks for property investors and using the increase in revenue to build more public housing.</li>\r\n 	<li>Establish laws which limit rental increases beyond what is fair.</li>\r\n 	<li>Rebalance tenancy laws to provide renters with more security and control, such as eliminating no grounds evictions.</li>\r\n 	<li>Phase out stamp duty and replace it with a broad-based land tax.</li>\r\n</ul>\r\n<h4>While there are many opinions on what policy changes will fix the housing market, doing nothing is not an option.</h4>'),(73635,1867,'_solutions_content','field_640e8b307a958'),(73636,1867,'problem_icons_0_prob_icon','1699'),(73637,1867,'_problem_icons_0_prob_icon','field_640fa0291d519'),(73638,1867,'problem_icons_0_prob_concerned_stat','70% highly concerned'),(73639,1867,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(73640,1867,'problem_icons_0_prob_concerded_text','are highly concerned'),(73641,1867,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(73642,1867,'problem_icons_0_prob_issue_text',''),(73643,1867,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(73644,1867,'problem_icons','4'),(73645,1867,'_problem_icons','field_640fa0191d518'),(73646,1867,'ceh_content_left',''),(73647,1867,'_ceh_content_left','field_640e97e8f1c8c'),(73648,1867,'ceh_content_right',''),(73649,1867,'_ceh_content_right','field_640e97fdf1c8d'),(73650,1867,'pc_content_left',''),(73651,1867,'_pc_content_left','field_640e983bf1c8f'),(73652,1867,'pc_content_right',''),(73653,1867,'_pc_content_right','field_640e984df1c90'),(73654,1867,'problem_icons_1_prob_icon','1699'),(73655,1867,'_problem_icons_1_prob_icon','field_640fa0291d519'),(73656,1867,'problem_icons_1_prob_concerned_stat','69% highly concerned'),(73657,1867,'_problem_icons_1_prob_conc