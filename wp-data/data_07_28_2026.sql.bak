pport_right_button','<a class=\"btn btn-blue\" href=\"#\">Read more</a>'),(69961,1858,'_support_right_button','field_5b67c6dd8c066'),(69962,1858,'first_image_title','Lifestart is about supporting young children'),(69963,1858,'_first_image_title','field_5b67ca606afc4'),(69964,1858,'first_image_cont','from 0-24 years living with disabilities and their familes'),(69965,1858,'_first_image_cont','field_5b67caff6afc5'),(69966,1858,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(69967,1858,'_first_image_button','field_5b67cb0d6afc6'),(69968,1858,'second _image_title','Lifestart is about supporting young children'),(69969,1858,'_second _image_title','field_5b67cb20ddf9a'),(69970,1858,'second_image_cont','from 0-24 years living with disabilities and their familes'),(69971,1858,'_second_image_cont','field_5b67cb24ddf9b'),(69972,1858,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(69973,1858,'_second_image_button','field_5b67cb29ddf9c'),(69974,1858,'second_image_title','Lifestart is about supporting young children'),(69975,1858,'_second_image_title','field_5b67cb20ddf9a'),(69976,1858,'page_col_image','412'),(69977,1858,'_page_col_image','field_5de6546e7c63a'),(69978,1858,'page_col_image_3','437'),(69979,1858,'_page_col_image_3','field_5de6e3998e07e'),(69980,1858,'sec_2_title','Community'),(69981,1858,'_sec_2_title','field_5de6e3ef2798f'),(69982,1858,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(69983,1858,'_sec_2_text','field_5de78dc89e613'),(69984,1858,'sec_3_title','The Project'),(69985,1858,'_sec_3_title','field_5de6e3d37d8da'),(69986,1858,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(69987,1858,'_sec_3_text','field_5de6e4044e5e8'),(69988,1858,'page_col_image_2','436'),(69989,1858,'_page_col_image_2','field_5de6546e7c63a'),(69990,1858,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(69991,1858,'_sec_2_button','field_5de6e58c86706'),(69992,1858,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(69993,1858,'_sec_3_button','field_5de6e5a243c03'),(69994,1858,'page_col_image_4','455'),(69995,1858,'_page_col_image_4','field_5de70801090ce'),(69996,1858,'sec_4_title','Location'),(69997,1858,'_sec_4_title','field_5de7082a12a81'),(69998,1858,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(69999,1858,'_sec_4_text','field_5de7084812a82'),(70000,1858,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(70001,1858,'_sec_4_button','field_5de7085e12a83'),(70002,1858,'news_title','Project updates'),(70003,1858,'_news_title','field_5de78da3aabb9'),(70004,1858,'sec_2_text_copy',''),(70005,1858,'_sec_2_text_copy','field_5de78dc89e613'),(70006,1858,'timeline-title','Timeline'),(70007,1858,'_timeline-title','field_5de78df29e615'),(70008,1858,'timeline_title','Timeline'),(70009,1858,'_timeline_title','field_5de78df29e615'),(70010,1858,'contact_title','Contact us'),(70011,1858,'_contact_title','field_5de7981e06057'),(70012,1858,'contact_intro','Contact text...'),(70013,1858,'_contact_intro','field_5de7983506058'),(70014,1858,'