nk_url','#'),(190186,2711,'_report_link_url','field_62f30ef4b57e3'),(190187,2711,'report_link_text','Download'),(190188,2711,'_report_link_text','field_62f30f01b57e4'),(190189,2711,'solutions_content','The housing system is complex, and no one solution will solve the complex problems we now face but there are some critical first steps to be taken now.\r\n<ul>\r\n 	<li>Set out an ambitious national housing agreement between commonwealth and state governments with targets and funding for the construction of affordable homes.</li>\r\n 	<li>Phase out tax breaks for property investors and using the increase in revenue to build more public housing.</li>\r\n 	<li>Establish laws which limit rental increases beyond what is fair.</li>\r\n 	<li>Rebalance tenancy laws to provide renters with more security and control, such as eliminating no grounds evictions.</li>\r\n 	<li>Phase out stamp duty and replace it with a broad-based land tax.</li>\r\n</ul>\r\n<h4>While there are many opinions on what policy changes will fix the housing market, doing nothing is not an option.</h4>'),(190190,2711,'_solutions_content','field_640e8b307a958'),(190191,2711,'problem_icons_0_prob_icon','1699'),(190192,2711,'_problem_icons_0_prob_icon','field_640fa0291d519'),(190193,2711,'problem_icons_0_prob_concerned_stat','70% highly concerned'),(190194,2711,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(190195,2711,'problem_icons_0_prob_concerded_text','are highly concerned'),(190196,2711,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(190197,2711,'problem_icons_0_prob_issue_text',''),(190198,2711,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(190199,2711,'problem_icons','4'),(190200,2711,'_problem_icons','field_640fa0191d518'),(190201,2711,'ceh_content_left',''),(190202,2711,'_ceh_content_left','field_640e97e8f1c8c'),(190203,2711,'ceh_content_right',''),(190204,2711,'_ceh_content_right','field_640e97fdf1c8d'),(190205,2711,'pc_content_left',''),(190206,2711,'_pc_