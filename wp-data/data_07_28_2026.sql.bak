6294562942237'),(126048,2201,'survey_index_7_survey_title','Going Off-grid'),(126049,2201,'_survey_index_7_survey_title','field_6294564042238'),(126050,2201,'survey_index_7_survey_url','#'),(126051,2201,'_survey_index_7_survey_url','field_6294564e42239'),(126052,2201,'survey_index_7_survey_url_text','View Results'),(126053,2201,'_survey_index_7_survey_url_text','field_629456584223a'),(126054,2201,'survey_index','8'),(126055,2201,'_survey_index','field_6294561242236'),(126056,2201,'report_title','Download the report'),(126057,2201,'_report_title','field_62f30edfb57e1'),(126058,2201,'report_intro','Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus massa erat, consectetur at semper at, feugiat vel orci. '),(126059,2201,'_report_intro','field_62f30eedb57e2'),(126060,2201,'report_link_url','#'),(126061,2201,'_report_link_url','field_62f30ef4b57e3'),(126062,2201,'report_link_text','Download'),(126063,2201,'_report_link_text','field_62f30f01b57e4'),(126064,2201,'solutions_content','The housing system is complex, and no one solution will solve the complex problems we now face but there are some critical first steps to be taken now.\r\n<ul>\r\n 	<li>Set out an ambitious national housing agreement between commonwealth and state governments with targets and funding for the construction of affordable homes.</li>\r\n 	<li>Phase out tax breaks for property investors and using the increase in revenue to build more public housing.</li>\r\n 	<li>Establish laws which limit rental increases beyond what is fair.</li>\r\n 	<li>Rebalance tenancy laws to provide renters with more security and control, such as eliminating no grounds evictions.</li>\r\n 	<li>Phase out stamp duty and replace it with a broad-based land tax.</li>\r\n</ul>\r\n<h4>While there are many opinions on what policy changes will fix the housing market, doing nothing is not an option.</h4>'),(126065,2201,'_solutions_content','field_640e8b307a958'),(126066,2201,'problem_icons_0_prob_icon','1699'),(126067,2201,'_problem_icons_0_prob_icon','field_640fa0291d519'),(126068,2201,'problem_icons_0_prob_concerned_stat','70% highly concerned'),(126069,2201,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(126070,2201,'problem_icons_0_prob_concerded_text','are highly concerned'),(126071,2201,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(126072,2201,'problem_icons_0_prob_issue_text',''),(126073,2201,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(126074,2201,'problem_icons','4'),(126075,2201,'_problem_icons','field_640fa0191d518'),(126076,2201,'ceh_content_left',''),(126077,2201,'_ceh_content_left','field_640e97e8f1c8c'),(126078,2201,'ceh_content_right',''),(126079,2201,'_ceh_content_right','field_640e97fdf1c8d'),(126080,2201,'pc_content_left',''),(126081,2201,'_pc_content_left','field_640e983bf1c8f'),(126082,2201,'pc_content_right',''),(126083,2201,'_pc_content_right','field_640e984df1c90'),(126084,2201,'problem_icons_1_prob_icon','1699'),(126085,2201,'_problem_icons_1_prob_icon','field_640fa0291d519'),(126086,2201,'problem_icons_1_prob_concerned_stat','69% highly concerned'),(126087,2201,'_problem_icons_1_prob_concerned_stat','field_640fa0dd81d95'),(126088,2201,'problem_icons_1_prob_concerded_text','are highly concerned'),(126089,2201,'_problem_icons_1_prob_concerded_text','field_640fa10181d96'),(126090,2201,'problem_icons_1_prob_issue_text',''),(126091,2201,'_problem_icons_1_prob_issue_text','field_640fa11a81d97'),(126092,2201,'problem_icons_2_prob_icon','1699'),(126093,2201,'_problem_icons_2_prob_icon','field_640fa0291d519'),(126094,2201,'problem_icons_2_prob_concerned_stat','64% highly concerned'),(126095,2201,'_problem_icons_2_prob_concerned_stat','field_640fa0dd81d95'),(126096,2201,'problem_icons_2_prob_concerded_text','are highly concerned'),(126097,2201,'_problem_icons_2_prob_concerded_text','field_640fa10181d96'),(126098,2201,'problem_icons_2_prob_issue_text',''),(126099,2201,'_problem_icons_2_prob_issue_text','field_640fa11a81d97'),(126100,2201,'problem_icons_3_prob_icon','1699'),(126101,2201,'_problem_icons_3_prob_icon','field_640fa0291d519'),(126102,2201,'problem_icons_3_prob_concerned_stat','64% highly concerned'),(126103,2201,'_problem_icons_3_prob_concerned_stat','field_640fa0dd81d95'),(126104,2201,'problem_icons_3_prob_concerded_text','are highly concerned'),(126105,2201,'_problem_icons_3_prob_concerded_text','field_640fa10181d96'),(126106,2201,'problem_icons_3_prob_issue_text',''),(126107,2201,'_problem_icons_3_prob_issue_text','field_640fa11a81d97'),(126108,2201,'problem_icons_0_prob_concerned_text','House prices have doubled in a decade'),(126109,2201,'_problem_icons_0_prob_concerned_text','field_640fa10181d96'),(126110,2201,'problem_icons_1_prob_concerned_text','The gap between rich and poor is growing'),(126111,2201,'_problem_icons_1_prob_concerned_text','field_640fa10181d96'),(126112,2201,'problem_icons_2_prob_concerned_text','Construction of social housing is down'),(126113,2201,'_problem_icons_2_prob_concerned_text','field_640fa10181d96'),(126114,2201,'problem_icons_3_prob_concerned_text','Banks are making more than ever from housing'),(126115,2201,'_problem_icons_3_prob_concerned_text','field_640fa10181d96'),(126116,2201,'monitor_content','The Australian Housing Monitor is a large, nationally-representative survey covering public experiences and attitudes toward housing related issues. Questions range from how well the respondent is keeping up with their mortgage/rent, to what they think about social housing construction.\r\n\r\nA broad range of demographic criteria are included, such as gender, location, age, income, voting preference, educational level, tenure type, and employment status. These variables allow CEH researchers to understand the trends and diversity of opinion around the country.\r\n\r\nIt also incorporates questions from previous surveys to track trends over time.\r\nThe inaugural poll was conducted by Essential in December 2022, and was completed by 4,735 people.'),(126117,2201,'_monitor_content','field_640fcc4014404'),(126118,2201,'problem_head','Housing in Australia is not working, and Australians are concerned.'),(126119,2201,'_problem_head','field_641935436aded'),(126120,2201,'problem_signoff','Explore the research showing how concerned Australians are our about the housing situation.'),(126121,2201,'_problem_signoff','field_641935626adee'),(126122,2201,'sections','a:2:{i:0;s:4:\"hero\";i:1;s:9:\"news_grid\";}'),(126123,2201,'_sections','field_5dafb40b8143a'),(126124,2201,'sections_0_is_full_height','1'),(126125,2201,'_sections_0_is_full_height','field_61d6f6fd5a37e'),(126126,2201,'sections_0_image','1648'),(126127,2201,'_sections_0_image','field_61d6f6d45a37d'),(126128,2201,'sections_0_heading','Heading'),(126129,2201,'_sections_0_heading','field_61d6f69e5a379'),(126130,2201,'sections_0_subtitle','Ya ya '),(126131,2201,'_sections_0_subtitle','field_61d6f6ac5a37a'),(126132,2201,'sections_0_link_one',''),(126133,2201,'_sections_0_link_one','field_61d6f6b55a37b'),(126134,2201,'sections_0_link_two',''),(126135,2201,'_sections_0_link_two','field_61d6f6c35a37c'),(126136,2201,'sections_1_select_categories','a:1:{i:0;s:2:\"27\";}'),(126137,2201,'_sections_1_select_categories','field_637f04483b63b'),(126138,2201,'intro_head_major','Welcome to the Disability Dialogue'),(126139,2201,'_intro_head_major','field_64e828783ad9f'),(126140,2201,'intro_head_minor',''),(126141,2201,'_intro_head_minor','field_64e8288c3ada0'),(126142,2201,'intro_icons_0_int_icon','1922'),(126143,2201,'_intro_icons_0_int_icon','field_64e828b33ada2'),(126144,2201,'intro_icons_0_int_icon_text','At 1,727,000 square kilometres, we’re 2.5 times the size of Texas. <span>Yeeha!</span>'),(126145,2201,'_intro_icons_0_int_icon_text','field_64e828e33ada3'),(126146,2201,'intro_icons_1_int_icon','1920'),(126147,2201,'_intro_icons_1_int_icon','field_64e828b33ada2'),(126148,2201,'intro_icons_1_int_icon_text','We have twice as many species of native plant and anima