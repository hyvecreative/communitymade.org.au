re</a> '),(135221,2264,'_intro_boxes_1_box_dropdown','field_65262dead0a0c'),(135222,2264,'intro_boxes_2_box_icon','1937'),(135223,2264,'_intro_boxes_2_box_icon','field_65262db5d36ee'),(135224,2264,'intro_boxes_2_box_title','Ideas'),(135225,2264,'_intro_boxes_2_box_title','field_65262d29ed8e3'),(135226,2264,'intro_boxes_2_box_dropdown','Our rigorous, conflict-free research and data analysis lifts the lid on fund performance, fees and insurance. Drawing on our policy expertise, we turn this analysis into action by using it to back reform and make super easier for people to understand. <a href=\"//localhost:4000:4000:4000:4000:/how/\">More</a> '),(135227,2264,'_intro_boxes_2_box_dropdown','field_65262dead0a0c'),(135228,2264,'intro_boxes','3'),(135229,2264,'_intro_boxes','field_65262d14ed8e2'),(135230,2264,'get_help_section_title','Get Help'),(135231,2264,'_get_help_section_title','field_65262c35143de'),(135232,2264,'get_help_block_home',''),(135233,2264,'_get_help_block_home','field_65262c8a143e1'),(135234,2264,'gh_block_home_0_help_image','1956'),(135235,2264,'_gh_block_home_0_help_image','field_65262cd0143e2'),(135236,2264,'gh_block_home_0_help_title','How much do I need to retire? '),(135237,2264,'_gh_block_home_0_help_title','field_65262cec143e3'),(135238,2264,'gh_block_home_0_help_url','#'),(135239,2264,'_gh_block_home_0_help_url','field_65262cf4143e4'),(135240,2264,'gh_block_home_1_help_image','1962'),(135241,2264,'_gh_block_home_1_help_image','field_65262cd0143e2'),(135242,2264,'gh_block_home_1_help_title','I have a problem with  my super fund'),(135243,2264,'_gh_block_home_1_help_title','field_65262cec143e3'),(135244,2264,'gh_block_home_1_help_url','#'),(135245,2264,'_gh_block_home_1_help_url','field_65262cf4143e4'),(135246,2264,'gh_block_home_2_help_image','1961'),(135247,2264,'_gh_block_home_2_help_image','field_65262cd0143e2'),(135248,2264,'gh_block_home_2_help_title','How do I choose the right super? '),(135249,2264,'_gh_block_home_2_help_title','field_6526