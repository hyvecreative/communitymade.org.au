tr_title','Talk to us'),(75757,1871,'_support_ctr_title','field_5b67c62a58af3'),(75758,1871,'support_ctr_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut laoreet.'),(75759,1871,'_support_ctr_cont','field_5b67c63158af4'),(75760,1871,'support_ctr_button','<a class=\"btn btn-orange\" href=\"/supports/\">Find us</a>'),(75761,1871,'_support_ctr_button','field_5b67c63658af5'),(75762,1871,'support_right_title','NDIS Registered provider'),(75763,1871,'_support_right_title','field_5b67c6a38c064'),(75764,1871,'support_right_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut.'),(75765,1871,'_support_right_cont','field_5b67c6c98c065'),(75766,1871,'support_right_button','<a class=\"btn btn-blue\" href=\"#\">Read more</a>'),(75767,1871,'_support_right_button','field_5b67c6dd8c066'),(75768,1871,'first_image_title','Lifestart is about supporting young children'),(75769,1871,'_first_image_title','field_5b67ca606afc4'),(75770,1871,'first_image_cont','from 0-24 years living with disabilities and their familes'),(75771,1871,'_first_image_cont','field_5b67caff6afc5'),(75772,1871,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(75773,1871,'_first_image_button','field_5b67cb0d6afc6'),(75774,1871,'second _image_title','Lifestart is about supporting young children'),(75775,1871,'_second _image_title','field_5b67cb20ddf9a'),(75776,1871,'second_image_cont','from 0-24 years living with disabilities and their familes'),(75777,1871,'_second_image_cont','field_5b67cb24ddf9b'),(75778,1871,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(75779,1871,'_second_image_button','field_5b67cb29ddf9c'),(75780,1871,'second_image_title','Lifestart is about supporting young children'),(75781,1871,'_second_image_title','field_5b67cb20ddf9a'),(75782,1871,'page_col_image','412'),(75783,1871,'_page_col_image','field_5de6546e7c63a'),(75784,1871,'page_col_image_3','437'),(75785,1871,'_page_col_image_3','field_5de6e3998e07e'),(75786,1871,'sec_2_title','Community'),(75787,1871,'_sec_2_title','field_5de6e3ef2798f'),(75788,1871,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(75789,1871,'_sec_2_text','field_5de78dc89e613'),(75790,1871,'sec_3_title','The Project'),(75791,1871,'_sec_3_title','field_5de6e3d37d8da'),(75792,1871,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(75793,1871,'_sec_3_text','field_5de6e4044e5e8'),(75794,1871,'page_col_image_2','436'),(75795,1871,'_page_col_image_2','field_5de6546e7c63a'),(75796,1871,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(75797,1871,'_sec_2_button','field_5de6e58c86706'),(75798,1871,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(75799,1871,'_sec_3_button','field_5de6e5a243c03'),(75800,1871,'page_col_image_4','455'),(75801,1871,'_page_col_image_4','field_5de70801090ce'),(75802,1871,'sec_4_title','Location'),(75803,1871,'_sec_4_title','field_5de7082a12a81'),(75804,1871,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(75805,1871,'_sec_4_text','fie