s_0_issues_target_url',''),(211475,2783,'_issues_items_0_issues_target_url','field_6a3b082b06af5'),(211476,2783,'issues_items','2'),(211477,2783,'_issues_items','field_6a3b078206af0'),(211478,2783,'issues_items_1_issue_icon','2708'),(211479,2783,'_issues_items_1_issue_icon','field_6a3b07b506af1'),(211480,2783,'issues_items_1_issues_item_hd','The solutions we need '),(211481,2783,'_issues_items_1_issues_item_hd','field_6a3b07d706af2'),(211482,2783,'issues_items_1_issues_item_txt','Community housing works. We’re calling on the next NSW Government for three actions: long-term investment for new community housing, more funding to future-proof existing homes, and support to help people stayed housed.'),(211483,2783,'_issues_items_1_issues_item_txt','field_6a3b07fc06af3'),(211484,2783,'issues_items_1_issues_link_text',''),(211485,2783,'_issues_items_1_issues_link_text','field_6a3b080f06af4'),(211486,2783,'issues_items_1_issues_target_url',''),(211487,2783,'_issues_items_1_issues_target_url','field_6a3b082b06af5'),(211488,2783,'issues_items_0_issues_sub_head',''),(211489,2783,'_issues_items_0_issues_sub_head','field_6a3b0aa79365e'),(211490,2783,'issues_items_1_issues_sub_head',''),(211491,2783,'_issues_items_1_issues_sub_head','field_6a3b0aa79365e'),(211492,2783,'video_head','The people next door'),(211493,2783,'_video_head','field_6a5ff269ef234'),(211494,2783,'video_intro','Nurses. Childcare workers. Single parents. Older Australians who want to stay near the people they love. Community housing is the solution.'),(211495,2783,'_video_intro','field_6a606161b34b6'),(211496,2783,'hm_hero_title_sm','because we all deserve a safe, secure and affordable home'),(211497,2783,'_hm_hero_title_sm','field_6a607121b523f'),(211498,2783,'solutions_head',''),(211499,2783,'_solutions_head','field_6a61a1aaac606'),(211500,2783,'solutions_items',''),(211501,2783,'_solutions_items','field_6a61a1aeac607'),(211506,2785,'footnotes',''),(211508,2782,'solutions_items_0_issue_icon','2703'),(211509,