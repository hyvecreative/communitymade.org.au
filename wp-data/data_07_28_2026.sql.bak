36,2709,'_logo_slider_6_','field_64fd7321b85f5'),(188737,2709,'signup_subhead','Queenslanders are coming together to protect our beautiful state and safeguard our way of life.'),(188738,2709,'_signup_subhead','field_64fd834dd90ab'),(188739,2709,'signup_form','[actionnetwork id=7]'),(188740,2709,'_signup_form','field_64fd8361d90ac'),(188741,2709,'signup_head','Join the campaign'),(188742,2709,'_signup_head','field_64fd83dc6b0b1'),(188743,2709,'boxes_section_title','Boxes'),(188744,2709,'_boxes_section_title','field_65262bbfd17fc'),(188745,2709,'intro_boxes_0_box_icon','1943'),(188746,2709,'_intro_boxes_0_box_icon','field_65262db5d36ee'),(188747,2709,'intro_boxes_0_box_title','Events'),(188748,2709,'_intro_boxes_0_box_title','field_65262d29ed8e3'),(188749,2709,'intro_boxes_0_box_dropdown','Our rigorous, conflict-free research and data analysis lifts the lid on fund performance, fees and insurance. Drawing on our policy expertise, we turn this analysis into action by using it to back reform and make super easier for people to understand. <a href=\"//localhost:4000:4000:4000:4000:4000:4000:/how/\">More</a>'),(188750,2709,'_intro_boxes_0_box_dropdown','field_65262dead0a0c'),(188751,2709,'intro_boxes_1_box_icon','1941'),(188752,2709,'_intro_boxes_1_box_icon','field_65262db5d36ee'),(188753,2709,'intro_boxes_1_box_title','Projects'),(188754,2709,'_intro_boxes_1_box_title','field_65262d29ed8e3'),(188755,2709,'intro_boxes_1_box_dropdown','Our rigorous, conflict-free research and data analysis lifts the lid on fund performance, fees and insurance. Drawing on our policy expertise, we turn this analysis into action by using it to back reform and make super easier for people to understand. <a href=\"//localhost:4000:4000:4000:4000:4000:4000:/how/\">More</a>'),(188756,2709,'_intro_boxes_1_box_dropdown','field_65262dead0a0c'),(188757,2709,'intro_boxes_2_box_icon','1937'),(188758,2709,'_intro_boxes_2_box_icon','field_65262db5d36ee'),(188759,2709,'intro_boxes_2_box_title','Ideas'),(188760,2709,'_intro_boxes_2_box_title','field_65262d29ed8e3'),(188761,2709,'intro_boxes_2_box_dropdown','Our rigorous, conflict-free research and data analysis lifts the lid on fund performance, fees and insurance. Drawing on our policy expertise, we turn this analysis into action by using it to back reform and make super easier for people to understand. <a href=\"//localhost:4000:4000:4000:4000:4000:4000:/how/\">More</a>'),(188762,2709,'_intro_boxes_2_box_dropdown','field_65262dead0a0c'),(188763,2709,'intro_boxes','3'),(188764,2709,'_intro_boxes','field_65262d14ed8e2'),(188765,2709,'get_help_section_title','Get Help'),(188766,2709,'_get_help_section_title','field_65262c35143de'),(188767,2709,'get_help_block_home',''),(188768,2709,'_get_help_block_home','field_65262c8a143e1'),(188769,2709,'gh_block_home_0_help_image','1956'),(188770,2709,'_gh_block_home_0_help_image','field_65262cd0143e2'),(188771,2709,'gh_block_home_0_help_title','How much do I need to retire? '),(188772,2709,'_gh_block_home_0_help_title','field_65262cec143e3'),(188773,2709,'gh_block_home_0_help_url','#'),(188774,2709,'_gh_block_home_0_help_url','field_65262cf4143e4'),(188775,2709,'gh_block_home_1_help_image','1962'),(188776,2709,'_gh_block_home_1_help_image','field_65262cd0143e2'),(188777,2709,'gh_block_home_1_help_title','I have a problem with  my super fund'),(188778,2709,'_gh_block_home_1_help_title','field_65262cec143e3'),(188779,2709,'gh_block_home_1_help_url','#'),(188780,2709,'_gh_block_home_1_help_url','field_65262cf4143e4'),(188781,2709,'gh_block_home_2_help_image','1961'),(188782,2709,'_gh_block_home_2_help_image','field_65262cd0143e2'),(188783,2709,'gh_block_home_2_help_title','How do I choose the right super? '),(188784,2709,'_gh_block_home_2_help_title','field_65262cec143e3'),(188785,2709,'gh_block_home_2_help_url','#'),(188786,2709,'_gh_block_home_2_help_url','field_65262cf4143e4'),(188787,2709,'gh_block_home','3'),(188788,2709,'_gh_block_home','field_65262c8a143e1'),(188789,2709,'turn_on_insights',''),(188790,2709,'_turn_on_insights','field_645c4a2e654a6'),(188791,2709,'report_questions','a:3:{i:0;s:2:\"59\";i:1;s:2:\"61\";i:2;s:4:\"2587\";}'),(188792,2709,'_report_questions','field_6109ed5e02e5a'),(188793,2709,'intro_text','The Disability Dialogue is a place where people with disabilities, their families, organisations providing support, academics, and the wider community come together to work on things that matter to us.\r\n\r\nThe Dialogue is a hub of knowledge and collaboration, separate from government, where we work together to come up. With new ideas on important topics. Our ideas can make a big difference in how services and systems are set up for people with disabilities.'),(188794,2709,'_intro_text','field_66441acfe963c'),(188795,2709,'word_link','#'),(188796,2709,'_word_link','field_6646c69723804'),(188797,2709,'pdf_link','#'),(188798,2709,'_pdf_link','field_6646c6da23805'),(188799,2709,'intro_boxes_0_box_image','2241'),(188800,2709,'_intro_boxes_0_box_image','field_65262db5d36ee'),(188801,2709,'intro_boxes_1_box_image','2179'),(188802,2709,'_intro_boxes_1_box_image','field_65262db5d36ee'),(188803,2709,'intro_boxes_2_box_image','2012'),(188804,2709,'_intro_boxes_2_box_image','field_65262db5d36ee'),(188805,2709,'intro_boxes_0_box_excerpt','Excerpt text here just a sentance or so and no more.'),(188806,2709,'_intro_boxes_0_box_excerpt','field_665975273e827'),(188807,2709,'intro_boxes_1_box_excerpt','Excerpt text here just a sentance or so and no more.'),(188808,2709,'_intro_boxes_1_box_excerpt','field_665975273e827'),(188809,2709,'intro_boxes_2_box_excerpt','Excerpt text here just a sentance or so and no more.'),(188810,2709,'_intro_boxes_2_box_excerpt','field_665975273e827'),(188811,2709,'intro_boxes_0_btn-text','Latest events'),(188812,2709,'_intro_boxes_0_btn-text','field_665abda8b8d4b'),(188813,2709,'intro_boxes_1_btn-text','Latest projects'),(188814,2709,'_intro_boxes_1_btn-text','field_665abda8b8d4b'),(188815,2709,'intro_boxes_2_btn-text','Latest ideas'),(188816,2709,'_intro_boxes_2_btn-text','field_665abda8b8d4b'),(188817,2709,'display-easy-read',''),(188818,2709,'_display-easy-read','field_666129bd2da00'),(188819,2709,'hm_hero_sum','Statement about the issue and lost life savings'),(188820,2709,'_hm_hero_sum','field_64ed37241effa'),(188821,2709,'hm_hero_sub','When housing is affordable, communities thrive – that’s what  community made means. Homes built and managed by not-for-profits with purpose, not profit.'),(188822,2709,'_hm_hero_sub','field_64ed37241effa'),(188823,2709,'intro_head','We’re here to help.'),(188824,2709,'_intro_head','field_64e828783ad9f'),(188825,2709,'intro_content','About 12,000 people invested their hard-earned super savings in two investment funds which have now collapsed, called Shield Master Fund and First Guardian Master Fund. Most people will be entitled to get some money back, but you need to take action soon. This website has information and tools to help you understand what happened, where to get help and how to take back your super.'),(188826,2709,'_intro_content','field_66441acfe963c'),(188827,2709,'deadline_heading','Important deadlines'),(188828,2709,'_deadline_heading','field_69365ff82e6f2'),(188829,2709,'deadline_content','You need to take action before the deadline to take your super back.'),(188830,2709,'_deadline_content','field_693660342e6f3'),(188831,2709,'deadline_button_text','Find out more'),(188832,2709,'_deadline_button_text','field_693660482e6f4'),(188833,2709,'deadline_button_url','/key-deadlines/'),(188834,2709,'_deadline_button_url','field_693660912e6f5'),(188835,2709,'what_head','What happened?'),(188836,2709,'_what_head','field_69366611096ac'),(188837,2709,'what_happened_0_happ_sub','What are Shield and First Guardian?'),(188838,2709,'_what_happened_0_happ_sub','field_693d4a8b4197d'),(188839,2709,'what_happened_0_happ_content','About 12,000 people invested their hard-earned super savings in two investment funds called Shield Master Fund and First Guardian Master Fund. Those funds have collapsed, and a large part of the $1.2 billion people invested is gone.\r\n\r\nMost people invested through financial advisers who contacted them after they clicked on a social media ad offering a free super comparison or review.'),(188840,2709,'_what_happened_0_happ_content','field_693d4aa84197e'),(188841,2709,'what_happened_0_happ_url','/what-happened/'),(188842,2709,'_what_happened_0_happ_url','field_693d4aba4197f'),(188843,2709,'what_happened_0_happ_link_text','More'),(188844,2709,'_what_happened_0_happ_link_text','field_693d4ad641980'),(188845,2709,'what_happened_1_happ_sub','What is being done about this?'),(188846,2709,'_what_happened_1_happ_sub','field_693d4a8b4197d'),(188847,2709,'what_happened_1_happ_content','There is a lot of work being done to try to get money back for people who invested.\r\n\r\nThe regulator is also investigating what happened and has started enforcement action against a number of different people and companies for their involvement in the collapses of Shield and First Guardian Master Funds. Learn about the progress of this work'),(188848,2709,'_what_happened_1_happ_content','field_693d4aa84197e'),(188849,2709,'what_happened_1_happ_url','/what-happened/'),(188850,2709,'_what_happened_1_happ_url','field_693d4aba4197f'),(188851,2709,'what_happened_1_happ_link_text','More'),(188852,2709,'_what_happened_1_happ_link_text','field_693d4ad641980'),(188853,2709,'what_happened','2'),(188854,2709,'_what_happened','field_693d4a6f4197c'),(188855,2709,'what_happened_0_happ_icon','2605'),(188856,2709,'_what_happened_0_happ_icon','field_693d4c9b3ec4d'),(188857,2709,'what_happened_1_happ_icon','2604'),(188858,2709,'_what_happened_1_happ_icon','field_693d4c9b3ec4d'),(188859,2709,'display_news_section',''),(188860,2709,'_display_news_section','field_69434cc6d5f7d'),(188861,2709,'issues_head','The Issues'),(188862,2709,'_issues_head','field_6a3b076406aef'),(188863,2709,'issues_items_0_issue_icon','2705'),(188864,2709,'_issues_items_0_issue_icon','field_6a3b07b506af1'),(188865,2709,'issues_items_0_issues_item_hd','The problem'),(188866,2709,'_issues_items_0_issues_item_hd','field_6a3b07d706af2'),(188867,2709,'issues_items_0_issues_item_txt','Rents are rising, waitlists are growing and more people are experiencing housing stress for the first time.'),(188868,2709,'_issues_items_0_issues_item_txt','field_6a3b07fc06af3'),(188869,2709,'issues_items_0_issues_link_text','Find out more'),(188870,2709,'_issues_items_0_issues_link_text','field_6a3b080f06af4'),(188871,2709,'issues_items_0_issues_target_url','#'),(188872,2709,'_issues_items_0_issues_target_url','field_6a3b082b06af5'),(188873,2709,'issues_items','3'),(188874,2709,'_issues_items','field_6a3b078206af0'),(188875,2709,'issues_items_1_issue_icon','2708'),(188876,2709,'_issues_items_1_issue_icon','field_6a3b07b506af1'),(188877,2709,'issues_items_1_issues_item_hd','Scaling the solution'),(188878,2709,'_issues_items_1_issues_item_hd','field_6a3b07d706af2'),(188879,2709,'issues_items_1_issues_item_txt','Governments, communities and not-for-profit community housing providers are working together to make rental housing more affordable for everyone who calls NSW home.'),(188880,2709,'_issues_items_1_issues_item_txt','field_6a3b07fc06af3'),(188881,2709,'issues_items_1_issues_link_text','Find out more'),(188882,2709,'_issues_items_1_issues_link_text','field_6a3b080f06af4'),(188883,2709,'issues_items_1_issues_target_url','#'),(188884,2709,'_issues_items_1_issues_target_url','field_6a3b082b06af5'),(188885,2709,'issues_items_0_issues_sub_head','The housing crisis is spiralling. '),(188886,2709,'_issues_items_0_issues_sub_head','field_6a3b0aa79365e'),(188887,2709,'issues_items_1_issues_sub_head','Community housing is social infrastructure.'),(188888,2709,'_issues_items_1_issues_sub_head','field_6a3b0aa79365e'),(188889,2709,'issues_items_2_issue_icon','2703'),(188890,2709,'_issues_items_2_issue_icon','field_6a3b07b506af1'),(188891,2709,'issues_items_2_issues_item_hd','Why community made:'),(188892,2709,'_issues_items_2_issues_item_hd','field_6a3b07d706af2'),(188893,2709,'issues_items_2_issues_sub_head',''),(188894,2709,'_issues_items_2_issues_sub_head','field_6a3b0aa79365e'),(188895,2709,'issues_items_2_issues_item_txt','Community housing is local. Every dollar invested is given back to community through homes, services and jobs. It’s built to thrive, like our communities.  Community housing is an investment in our state’s future. By investing in people today, we boost our local economies, communities and productivity – ensuring that NSW leads the nation.'),(188896,2709,'_issues_items_2_issues_item_txt','field_6a3b07fc06af3'),(188897,2709,'issues_items_2_issues_link_text','Find out more'),(188898,2709,'_issues_items_2_issues_link_text','field_6a3b080f06af4'),(188899,2709,'issues_items_2_issues_target_url','#'),(188900,2709,'_issues_items_2_issues_target_url','field_6a3b082b06af5'),(188903,2710,'footnotes',''),(188905,2710,'banner_head',''),(188906,2710,'_banner_head','field_5b568121a8ffe'),(188907,2710,'banner_sub',''),(188908,2710,'_banner_sub','field_5b568139fd366'),(188909,2710,'banner_button','<a class=\"btn btn-home\" style=\"width: 200px;\" href=\"#project\">Sign the petition</a>'),(188910,2710,'_banner_button','field_5b568147fd367'),(188911,2710,'support_section_title','How can Lifestart support you?'),(188912,2710,'_support_section_title','field_5b67c7d060398'),(188913,2710,'support_left_title','Services'),(188914,2710,'_support_left_title','field_5b67c298e7f8f'),(188915,2710,'support_left_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy.'),(188916,2710,'_support_left_cont','field_5b67c5f6e7f91'),(188917,2710,'support_left_button','<a class=\"btn btn-green\" href=\"/services/\">View all services</a>'),(188918,2710,'_support_left_button','field_5b67c60ae7f92'),(188919,2710,'support_ctr_title','Talk to us'),(188920,2710,'_support_ctr_title','field_5b67c62a58af3'),(188921,2710,'support_ctr_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut laoreet.'),(188922,2710,'_support_ctr_cont','field_5b67c63158af4'),(188923,2710,'support_ctr_button','<a class=\"btn btn-orange\" href=\"/supports/\">Find us</a>'),(188924,2710,'_support_ctr_button','field_5b67c63658af5'),(188925,2710,'support_right_title','NDIS Registered provider'),(188926,2710,'_support_right_title','field_5b67c6a38c064'),(188927,2710,'support_right_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut.'),(188928,2710,'_support_right_cont','field_5b67c6c98c065'),(188929,2710,'support_right_button','<a class=\"btn btn-blue\" href=\"#\">Read more</a>'),(188930,2710,'_support_right_button','field_5b67c6dd8c066'),(188931,2710,'first_image_title','Lifestart is about supporting young children'),(188932,2710,'_first_image_title','field_5b67ca606afc4'),(188933,2710,'first_image_cont','from 0-24 years living with disabilities and their familes'),(188934,2710,'_first_image_cont','field_5b67caff6afc5'),(188935,2710,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(188936,2710,'_first_image_button','field_5b67cb0d6afc6'),(188937,2710,'second _image_title','Lifestart is about supporting young children'),(188938,2710,'_second _image_title','field_5b67cb20ddf9a'),(188939,2710,'second_image_cont','from 0-24 years living with disabilities and their familes'),(188940,2710,'_second_image_cont','field_5b67cb24ddf9b'),(188941,2710,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(188942,2710,'_second_image_button','field_5b67cb29ddf9c'),(188943,2710,'second_image_title','Lifestart is about supporting young children'),(188944,2710,'_second_image_title','field_5b67cb20ddf9a'),(188945,2710,'page_col_image','412'),(188946,2710,'_page_col_image','field_5de6546e7c63a'),(188947,2710,'page_col_image_3','437'),(188948,2710,'_page_col_image_3','field_5de6e3998e07e'),(188949,2710,'sec_2_title','Community'),(188950,2710,'_sec_2_title','field_5de6e3ef2798f'),(188951,2710,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(188952,2710,'_sec_2_text','field_5de78dc89e613'),(188953,2710,'sec_3_title','The Project'),(188954,2710,'_sec_3_title','field_5de6e3d37d8da'),(188955,2710,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(188956,2710,'_sec_3_text','field_5de6e4044e5e8'),(188957,2710,'page_col_image_2','436'),(188958,2710,'_page_col_image_2','field_5de6546e7c63a'),(188959,2710,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(188960,2710,'_sec_2_button','field_5de6e58c86706'),(188961,2710,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(188962,2710,'_sec_3_button','field_5de6e5a243c03'),(188963,2710,'page_col_image_4','455'),(188964,2710,'_page_col_image_4','field_5de70801090ce'),(188965,2710,'sec_4_title','Location'),(188966,2710,'_sec_4_title','field_5de7082a12a81'),(188967,2710,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(188968,2710,'_sec_4_text','field_5de7084812a82'),(