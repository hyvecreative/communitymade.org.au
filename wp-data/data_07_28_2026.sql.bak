3e'),(163252,2521,'team_members_2_member_image','367'),(163253,2521,'_team_members_2_member_image','field_5b7572a89973e'),(163254,2521,'team_members_3_member_image','367'),(163255,2521,'_team_members_3_member_image','field_5b7572a89973e'),(163256,2521,'banner_button',''),(163257,2521,'_banner_button','field_5b568147fd367'),(163258,2521,'intro_col_1','The Take Control Campaign is a new movement of people who want to make Australia safer when it comes to drugs.'),(163259,2521,'_intro_col_1','field_5df5c6cef3ddb'),(163260,2521,'intro_col_2','The campaign has been launched by the Ted Noffs Foundation, Australia\'s largest provider of drug and alcohol treatment services for young people. The Foundation strives to help disadvantaged young people become advantaged and supports them on their journey to take back control of their lives.'),(163261,2521,'_intro_col_2','field_5df5c6deee1ca'),(163262,2521,'intro_col_3','With community support, the Take Control Campaign aims to change the conversation surrounding drugs and drug use in Australia. Through our common sense plan, we are demanding governments take control of the issue and fix our broken drug laws.'),(163263,2521,'_intro_col_3','field_5df5c6e99b7a8'),(163264,2521,'intro_logo','610'),(163265,2521,'_intro_logo','field_5df5c6f18c801'),(163266,2521,'intro_title','Decades of failed drug policy have resulted in unnecessary suffering. We have a secret and chaotic black market run by criminals and gangs. We have no control.'),(163267,2521,'_intro_title','field_5df5c6799cfec'),(163268,2521,'intro_bullets','Despite the best efforts of our police forces, for every drug dealer we catch, more simply start and operate with impunity.\r\n\r\nAny teenager can get drugs easily. People who use drugs can’t be sure what they are taking. Innocent young people who are just experimenting can buy themselves a death sentence.\r\n\r\nWorst of all, it’s often hard for people with problems to access help because they\'re treated like criminals.\r\n\r\nThis is because our governments refuse to take control of drugs.\r\n\r\nParents need greater tools and strategies to help their kids cope with the challenges of modern life.\r\n\r\nIt’s not good enough to put our heads in the sand and tell our kids to “just say no”. It doesn\'t work.\r\n\r\nIt\'s time to end the fear tactics. It\'s time to end the marketing gimmicks. People need real resources to reduce the harms associated with drug use.\r\n\r\nOur state and federal governments need to work together to get drug use under control by putting health and safety first.'),(163269,2521,'_intro_bullets','field_5df5c6799d05a'),(163270,2521,'intro_text',''),(163271,2521,'_intro_text','field_5df5c6799d0c6'),(163272,2521,'plan_title',''),(163273,2521,'_plan_title','field_5df5c6799d197'),(163274,2521,'plan_icons_row','5'),(163275,2521,'_plan_icons_row','field_5df5c6799d211'),(163276,2521,'plan_icons_row_0_plan_icon','516'),(163277,2521,'_plan_icons_row_0_plan_icon','field_5df5c679a8044'),(163278,2521,'plan_icons_row_0_plan_icon_text',' Roll out pill testing services nationally to reduce harm at music festivals and parties'),(163279,2521,'_plan_icons_row_0_plan_icon_text','field_5df5c679a80ae'),(163280,2521,'plan_icons_row_1_plan_icon','515'),(163281,2521,'_plan_icons_row_1_plan_icon','field_5df5c679a8044'),(163282,2521,'plan_icons_row_1_plan_icon_text','Expand treatment services for people suffering from drug problems'),(163283,2521,'_plan_icons_row_1_plan_icon_text','field_5df5c679a80ae'),(163284,2521,'plan_icons_row_2_plan_icon','514'),(163285,2521,'_plan_icons_row_2_plan_icon','field_5df5c679a8044'),(163286,2521,'plan_icons_row_2_plan_icon_text','Establish more drug monitoring rooms to save lives and improve communities'),(163287,2521,'_plan_icons_row_2_plan_icon_text','field_5df5c679a80ae'),(163288,2521,'plan_icons_row_3_plan_icon','513'),(163289,2521,'_plan_icons_row_3_plan_icon','field_5df5c679a8044'),(163290,2521,'plan_icons_row_3_plan_icon_text','Enhance engagement services for disadvantaged young people'),(163291,2521,'_plan_icons_row_3_plan_icon_text','field_5df5c679a80ae'),(163292,2521,'plan_icons_row_4_plan_icon','512'),(163293,2521,'_plan_icons_row_4_plan_icon','field_5df5c679a8044'),(163294,2521,'plan_icons_row_4_plan_icon_text','End criminal charges that make getting help harder and ruin young lives for minor possession of illicit drugs'),(163295,2521,'_plan_icons_row_4_plan_icon_text','field_5df5c679a80ae'),(163296,2521,'banner_image_position','center'),(163297,2521,'_banner_image_position','field_5f3bc4757dd02'),(163298,2521,'page_image','861'),(163299,2521,'_page_image','field_5f868320f904a'),(163300,2521,'echo_title','0'),(163301,2521,'_echo_title','field_5f868f339dd59'),(163302,2521,'problem_panel_title',''),(163303,2521,'_problem_panel_title','field_5f20f3cd80eb2'),(163304,2521,'problem_panel_items',''),(163305,2521,'_problem_panel_items','field_5f20f3dbe5a77'),(163306,2521,'problem_subhead',''),(163307,2521,'_problem_subhead','field_5f2121dff763d'),(163308,2521,'solution_title',''),(163309,2521,'_solution_title','field_5f21219394b8b'),(163310,2521,'solution_panel_items',''),(163311,2521,'_solution_panel_items','field_5f2121a594b8c'),(163312,2521,'mship_title',''),(163313,2521,'_mship_title','field_5f8fb9dc29b4c'),(163314,2521,'mship_intro',''),(163315,2521,'_mship_intro','field_5f8fb9f129b4d'),(163316,2521,'mship_benefit_items',''),(163317,2521,'_mship_benefit_items','field_5f8fba0629b4e'),(163318,2521,'mship_more_button_text',''),(163319,2521,'_mship_more_button_text','field_5f8fbac3a6ace'),(163320,2521,'mship_more_url',''),(163321,2521,'_mship_more_url','field_5f8fbaeaa6acf'),(163322,2521,'mship_apprl_button_text',''),(163323,2521,'_mship_apprl_button_text','field_5f8fbb25feba0'),(163324,2521,'mship_apply_url',''),(163325,2521,'_mship_apply_url','field_5f8fbb3afeba1'),(163326,2521,'petition_intro_head',''),(163327,2521,'_petition_intro_head','field_5deed527179d8'),(163328,2521,'petition_intro_text',''),(163329