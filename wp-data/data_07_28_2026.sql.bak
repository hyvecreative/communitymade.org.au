458,'_survey_index_5_survey_title','field_6294564042238'),(154200,2458,'survey_index_5_survey_url','#'),(154201,2458,'_survey_index_5_survey_url','field_6294564e42239'),(154202,2458,'survey_index_5_survey_url_text','View Results'),(154203,2458,'_survey_index_5_survey_url_text','field_629456584223a'),(154204,2458,'survey_index_6_survey_icon','1492'),(154205,2458,'_survey_index_6_survey_icon','field_6294562942237'),(154206,2458,'survey_index_6_survey_title','Energy Management'),(154207,2458,'_survey_index_6_survey_title','field_6294564042238'),(154208,2458,'survey_index_6_survey_url','#'),(154209,2458,'_survey_index_6_survey_url','field_6294564e42239'),(154210,2458,'survey_index_6_survey_url_text','View Results'),(154211,2458,'_survey_index_6_survey_url_text','field_629456584223a'),(154212,2458,'survey_index_7_survey_icon','1493'),(154213,2458,'_survey_index_7_survey_icon','field_6294562942237'),(154214,2458,'survey_index_7_survey_title','Going Off-grid'),(154215,2458,'_survey_index_7_survey_title','field_6294564042238'),(154216,2458,'survey_index_7_survey_url','#'),(154217,2458,'_survey_index_7_survey_url','field_6294564e42239'),(154218,2458,'survey_index_7_survey_url_text','View Results'),(154219,2458,'_survey_index_7_survey_url_text','field_629456584223a'),(154220,2458,'survey_index','8'),(154221,2458,'_survey_index','field_6294561242236'),(154222,2458,'report_title','Download the report'),(154223,2458,'_report_title','field_62f30edfb57e1'),(154224,2458,'report_intro','Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus massa erat, consectetur at semper at, feugiat vel orci. '),(154225,2458,'_report_intro','field_62f30eedb57e2'),(154226,2458,'report_link_url','#'),(154227,2458,'_report_link_url','field_62f30ef4b57e3'),(154228,2458,'report_link_text','Download'),(154229,2458,'_report_link_text','field_62f30f01b57e4'),(154230,2458,'solutions_content','The housing system is complex, and no one solution will solve the complex problems we now face but there are some critical first steps to be taken now.\r\n<ul>\r\n 	<li>Set out an ambitious national housing agreement between commonwealth and state governments with targets and funding for the construction of affordable homes.</li>\r\n 	<li>Phase out tax breaks for property investors and using the increase in revenue to build more public housing.</li>\r\n 	<li>Establish laws which limit rental increases beyond what is fair.</li>\r\n 	<li>Rebalance tenancy laws to provide renters with more security and control, such as eliminating no grounds evictions.</li>\r\n 	<li>Phase out stamp duty and replace it with a broad-based land tax.</li>\r\n</ul>\r\n<h4>While there are many opinions on what policy changes will fix the housing market, doing nothing is not an option.</h4>'),(154231,2458,'_solutions_content','field_640e8b307a958'),(154232,2458,'problem_icons_0_prob_icon','1699'),(154233,2458,'_problem_icons_0_prob_icon','field_640fa0291d519'),(154234,2458,'problem_icons_0_prob_concerned_stat','70% highly concerned'),(154235,2458,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(154236,2458,'problem_icons_0_prob_concerded_text','are highly concerned'),(154237,2458,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(154238,2458,'problem_icons_0_prob_issue_text',''),(154239,2458,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(154240,2458,'problem_icons','4'),(154241,2458,'_problem_icons','field_640fa0191d518'),(154242,2458,'ceh_content_left',''),(154243,2458,'_ceh_content_left','field_640e97e8f1c8c'),(154244,2458,'ceh_content_right',''),(154245,2458,'_ceh_content_right','field_640e97fdf1c8d'),(154246,2458,'pc_content_left',''),(154247,2458,'_pc_content_left','field_640e983bf1c8f'),(154248,2458,'pc_content_right',''),(154249,2458,'_pc_content_right','field_640e984df1c90'),(154250,2458,'problem_icons_1_prob_icon','1699'),(154251,2458,'_problem_icons_1_prob_icon','field_640fa0291d519'),(154252,2458,'problem_icons_1_prob_concerned_stat','69% highly concerned'),(154253,2458,'_problem_icons_1_prob_concerned_stat','field_640fa0dd81d95'),(154254,2458,'problem_icons_1_prob_concerded_text','are highly concerned'),(154255,2458,'_problem_icons_1_prob_concerded_text','field_640fa10181d96'),(154256,2458,'problem_icons_1_prob_issue_text',''),(154257,2458,'_problem_icons_1_prob_issue_text','field_640fa11a81d97'),(154258,2458,'problem_icons_2_prob_icon','1699'),(154259,2458,'_problem_icons_2_prob_icon','field_640fa0291d519'),(154260,2458,'problem_icons_2_prob_concerned_stat','64% highly concerned'),(154261,2458,'_problem_icons_2_prob_concerned_stat','field_640fa0dd81d95'),(154262,2458,'problem_icons_2_prob_concerded_text','are highly concerned'),(154263,2458,'_problem_icons_2_prob_concerded_text','field_640fa10181d96'),(154264,2458,'problem_icons_2_prob_issue_text',''),(154265,2458,'_problem_icons_2_prob_issue_text','field_640fa11a81d97'),(154266,2458,'problem_icons_3_prob_icon','1699'),(154267,2458,'_problem_icons_3_prob_icon','field_640fa0291d519'),(154268,2458,'problem_icons_3_prob_concerned_stat','64% highly concerned'),(154269,2458,'_problem_icons_3_prob_concerned_stat','field_640fa0dd81d95'),(154270,2458,'problem_icons_3_prob_concerded_text','are highly concerned'),(154271,2458,'_problem_icons_3_prob_concerded_text','field_640fa10181d96'),(154272,2458,'problem_icons_3_prob_issue_text',''),(154273,2458,'_problem_icons_3_prob_issue_text','field_640fa11a81d97'),(154274,2458,'problem_icons_0_prob_concerned_text','House prices have doubled in a decade'),(154275,2458,'_problem_icons_0_prob_concerned_text','field_640fa10181d96'),(154276,2458,'problem_icons_1_prob_concerned_text','The gap between rich and poor is growing'),(154277,2458,'_problem_icons_1_prob_concerned_text','field_640fa10181d96'),(154278,2458,'problem_icons_2_prob_concerned_text','Construction of social housing is down'),(154279,2458,'_problem_icons_2_prob_concerned_text','field_640fa10181d96'),(154280,2458,'problem_icons_3_prob_concerned_text','Banks are making more than ever from housing'),(154281,2458,'_problem_icons_3_prob_concerned_text','field_640fa10181d96'),(154282,2458,'monitor_content','The Australian Housing Monitor is a large, nationally-representative survey covering public experiences and attitudes toward housing related issues. Questions range from how well the respondent is keeping up with their mortgage/rent, to what they think about social housing construction.\r\n\r\nA broad range of demographic criteria are included, such as gender, location, age, income, voting preference, educational level, tenure type, and employment status. These variables allow CEH researchers to understand the trends and diversity of opinion around the country.\r\n\r\nIt also incorporates questions from previous surveys to track trends over time.\r\nThe inaugural poll was conducted by Essential in December 2022, and was completed by 4,735 people.'),(154283,2458,'_monitor_content','field_640fcc4014404'),(154284,2458,'problem_head','Housing in Australia is not working, and Australians are concerned.'),(154285,2458,'_problem_head','field_641935436aded'),(154286,2458,'problem_signoff','Explore the research showing how concerned Australians are our about the housing situation.'),(154287,2458,'_problem_signoff','field_641935626adee'),(154288,2458,'sections','a:2:{i:0;s:4:\"hero\";i:1;s:9:\"news_grid\";}'),(154289,2458,'_sections','field_5dafb40b8143a'),(154290,2458,'sections_0_is_full_height','1'),(154291,2458,'_sections_0_is_full_height','field_61d6f6fd5a37e'),(154292,2458,'sections_0_image','1648'),(154293,2458,'_sections_0_image','field_61d6f6d45a37d'),(154294,2458,'sections_0_heading','Heading'),(154295,2458,'_sections_0_heading','field_61d6f69e5a379'),(154296,2458,'sections_0_subtitle','Ya ya '),(154297,2458,'_sections_0_subtitle','field_61d6f6ac5a37a'),(154298,2458,'sections_0_link_one',''),(154299,2458,'_sections_0_link_one','field_61d6f6b55a37b'),(154300,2458,'sections_0_link_two',''),(154301,2458,'_sections_0_link_two','f