itle','field_5b67cb20ddf9a'),(68096,1852,'second_image_cont','from 0-24 years living with disabilities and their familes'),(68097,1852,'_second_image_cont','field_5b67cb24ddf9b'),(68098,1852,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(68099,1852,'_second_image_button','field_5b67cb29ddf9c'),(68100,1852,'second_image_title','Lifestart is about supporting young children'),(68101,1852,'_second_image_title','field_5b67cb20ddf9a'),(68102,1852,'page_col_image','412'),(68103,1852,'_page_col_image','field_5de6546e7c63a'),(68104,1852,'page_col_image_3','437'),(68105,1852,'_page_col_image_3','field_5de6e3998e07e'),(68106,1852,'sec_2_title','Community'),(68107,1852,'_sec_2_title','field_5de6e3ef2798f'),(68108,1852,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(68109,1852,'_sec_2_text','field_5de78dc89e613'),(68110,1852,'sec_3_title','The Project'),(68111,1852,'_sec_3_title','field_5de6e3d37d8da'),(68112,1852,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(68113,1852,'_sec_3_text','field_5de6e4044e5e8'),(68114,1852,'page_col_image_2','436'),(68115,1852,'_page_col_image_2','field_5de6546e7c63a'),(68116,1852,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(68117,1852,'_sec_2_button','field_5de6e58c86706'),(68118,1852,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(68119,1852,'_sec_3_button','field_5de6e5a243c03'),(68120,1852,'page_col_image_4','455'),(68121,1852,'_page_col_image_4','field_5de70801090ce'),(68122,1852,'sec_4_title','Location'),(68123,1852,'_sec_4_title','field_5de7082a12a81'),(68124,1852,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(68125,1852,'_sec_4_text','field_5de7084812a82'),(68126,1852,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(68127,1852,'_sec_4_button','field_5de7085e12a83'),(68128,1852,'news_title','Project updates'),(68129,1852,'_news_title','field_5de78da3aabb9'),(68130,1852,'sec_2_text_copy',''),(68131,1852,'_sec_2_text_copy','field_5de78dc89e613'),(68132,1852,'timeline-title','Timeline'),(68133,1852,'_timeline-title','field_5de78df29e615'),(68134,1852,'timeline_title','Timeline'),(68135,1852,'_timeline_title','field_5de78df29e615'),(68136,1852,'contact_title','Contact us'),(68137,1852,'_contact_title','field_5de7981e06057'),(68138,1852,'contact_intro','Contact text...'),(68139,1852,'_contact_intro','field_5de7983506058'),(68140,1852,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(68141,1852,'_news_button','field_5de8329896e02'),(68142,1852,'timeline_intro','Introduction of timeline detail...'),(68143,1852,'_timeline_intro','field_5de98f5fb1781'),(68144,1852,'timeline_pic','477'),(68145,1852,'_timeline_pic','field_5de98f72b1782'),(68146,1852,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(68147,1852,'_timeline_button','field_5de99363677f8'),(68148,1852,'banner_image_position','center'),(68149,1852,'_banner_image_position','field_5f3bc4757dd02'),(68150,1852,'services_title','Our services'),(68151,