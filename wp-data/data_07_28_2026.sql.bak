onnetwork id=7]'),(201844,2734,'_signup_form','field_64fd8361d90ac'),(201845,2734,'signup_head','Join the campaign'),(201846,2734,'_signup_head','field_64fd83dc6b0b1'),(201847,2734,'boxes_section_title','Boxes'),(201848,2734,'_boxes_section_title','field_65262bbfd17fc'),(201849,2734,'intro_boxes_0_box_icon','1943'),(201850,2734,'_intro_boxes_0_box_icon','field_65262db5d36ee'),(201851,2734,'intro_boxes_0_box_title','Events'),(201852,2734,'_intro_boxes_0_box_title','field_65262d29ed8e3'),(201853,2734,'intro_boxes_0_box_dropdown','Our rigorous, conflict-free research and data analysis lifts the lid on fund performance, fees and insurance. Drawing on our policy expertise, we turn this analysis into action by using it to back reform and make super easier for people to understand. <a href=\"//localhost:4000:4000:4000:4000:4000:4000:/how/\">More</a>'),(201854,2734,'_intro_boxes_0_box_dropdown','field_65262dead0a0c'),(201855,2734,'intro_boxes_1_box_icon','1941'),(201856,2734,'_intro_boxes_1_box_icon','field_65262db5d36ee'),(201857,2734,'intro_boxes_1_box_title','Projects'),(201858,2734,'_intro_boxes_1_box_title','field_65262d29ed8e3'),(201859,2734,'intro_boxes_1_box_dropdown','Our rigorous, conflict-free research and data analysis lifts the lid on fund performance, fees and insurance. Drawing on our policy expertise, we turn this analysis into action by using it to back reform and make super easier for people to understand. <a href=\"//localhost:4000:4000:4000:4000:4000:4000:/how/\">More</a>'),(201860,2734,'_intro_boxes_1_box_dropdown','field_65262dead0a0c'),(201861,2734,'intro_boxes_2_box_icon','1937'),(201862,2734,'_intro_boxes_2_box_icon','field_65262db5d36ee'),(201863,2734,'intro_boxes_2_box_title','Ideas'),(201864,2734,'_intro_boxes_2_box_title','field_65262d29ed8e3'),(201865,2734,'intro_boxes_2_box_dropdown','Our rigorous, conflict-free research and data analysis lifts the lid on fund performance, fees and insurance. Drawing on our policy expertise, we turn this analysis into action by using it to back reform and make super easier for people to understand. <a href=\"//localhost:4000:4000:4000:4000:4000:4000:/how/\">More</a>'),(201866,2734,'_intro_boxes_2_box_dropdown','field_65262dead0a0c'),(201867,2734,'intro_boxes','3'),(201868,2734,'_intro_boxes','field_65262d14ed8e2'),(201869,2734,'get_help_section_title','Get Help'),(201870,2734,'_get_help_section_title','field_65262c35143de'),(201871,2734,'get_help_block_home',''),(201872,2734,'_get_help_block_home','field_65262c8a143e1'),(201873,2734,'gh_block_home_0_help_image','1956'),(201874,2734,'_gh_block_home_0_help_image','field_65262cd0143e2'),(201875,2734,'gh_block_home_0_help_title','How much do I need to retire? '),(201876,2734,'_gh_block_home_0_help_title','field_65262cec143e3'),(201877,2734,'gh_block_home_0_help_url','#'),(201878,2734,'_gh_block_home_0_help_url','field_65262cf4143e4'),(201879,2734,'gh_block_home_1_help_image','1962'),(201880,2734,'_gh_block_home_1_help_image','field_65262cd0143e2'),(201881,2734,'gh_block_home_1_help_title','I have a problem with  my super fund'),(201882,2734,'_gh_block_home_1_help_title','field_65262cec143e3'),(201883,2734,'gh_block_home_1_help_url','#'),(201884,2734,'_gh_block_home_1_help_url','field_65262cf4143e4'),(201885,2734,'gh_block_home_2_help_image','1961'),(201886,2734,'_gh_block_home_2_help_image','field_65262cd0143e2'),(201887,2734,'gh_block_home_2_help_title','How do I choose the right super? '),(201888,2734,'_gh_block_home_2_help_title','field_65262cec143e3'),(201889,2734,'gh_block_home_2_help_url','#'),(201890,2734,'_gh_block_home_2_help_url','field_65262cf4143e4'),(201891,2734,'gh_block_home','3'),(201892,2734,'_gh_block_home','field_65262c8a143e1'),(201893,2734,'turn_on_insights',''),(201894,2734,'_turn_on_insights','field_645c4a2e654a6'),(201895,2734,'report_questions','a:3:{i:0;s:2:\"59\";i:1;s:2:\"61\";i:2;s:4:\"2587\";}'),(201896,2734,'_report_questions','field_6109ed5e02e5a'),(201897,2734,'intro_text','The Disability Dialogue is a place where people with disabilities, their families, organisations providing support, academics, and the wider community come together to work on things that matter to us.\r\n\r\nThe Dialogue is a hub of knowledge and collaboration, separate from government, where we work together to come up. With new ideas on important topics. Our ideas can make a big difference in how services and systems are set up for people with disabilities.'),(201898,2734,'_intro_text','field_66441acfe963c'),(201899,2734,'word_link','#'),(201900,2734,'_word_link','field_6646c69723804'),(201901,2734,'pdf_link','#'),(201902,2734,'_pdf_link','field_6646c6da23805'),(201903,2734,'intro_boxes_0_box_image','2241'),(201904,2734,'_intro_boxes_0_box_image','field_65262db5d36ee'),(201905,2734,'intro_boxes_1_box_image','2179'),(201906,2734,'_intro_boxes_1_box_image','field_65262db5d36ee'),(201907,2734,'intro_boxes_2_box_image','2012'),(201908,2734,'_intro_boxes_2_box_image','field_65262db5d36ee'),(201909,2734,'intro_boxes_0_box_excerpt','Excerpt text here just a sentance or so and no more.'),(201910,2734,'_intro_boxes_0_box_excerpt','field_665975273e827'),(201911,2734,'intro_boxes_1_box_excerpt','Excerpt text here just a sentance or so and no more.'),(201912,2734,'_intro_boxes_1_box_excerpt','field_665975273e827'),(201913,2734,'intro_boxes_2_box_excerpt','Excerpt text here just a sentance or so and no more.'),(201914,2734,'_intro_boxes_2_box_excerpt','field_665975273e827'),(201915,2734,'intro_boxes_0_btn-text','Latest events'),(201916,2734,'_intro_boxes_0_btn-text','field_665abda8b8d4b'),(201917,2734,'intro_boxes_1_btn-text','Latest projects'),(201918,2734,'_intro_boxes_1_btn-text','field_665abda8b8d4b'),(201919,2734,'intro_boxes_2_btn-text','Latest ideas'),(201920,2734,'_intro_boxes_2_btn-text','field_665abda8b8d4b'),(201921,2734,'display-easy-read',''),(201922,2734,'_display-easy-read','field_666129bd2da00'),(201923,2734,'hm_hero_sum','Statement about the issue and lost life savings'),(201924,2734,'_hm_hero_sum','field_64ed37241effa'),(201925,2734,'hm_hero_sub','Real homes, run by not-for-profit providers, for everyday people and families. Join our NSW election campaign and ask your local candidates to commit to more community housing.'),(201926,2734,'_hm_hero_sub','field_64ed37241effa'),(201927,2734,'intro_head','We’re here to help.'),(201928,2734,'_intro_head','field_64e828783ad9f'),(201929,2734,'intro_content','About 12,000 people invested their hard-earned super savings in two investment funds which have now collapsed, called Shield Master Fund and First Guardian Master Fund. Most people will be entitled to get some money back, but you need to take action soon. This website has information and tools to help you understand what happened, where to get help and how to take back your super.'),(201930,2734,'_intro_content','field_66441acfe963c'),(201931,2734,'deadline_heading','Important deadlines'),(201932,2734,'_deadline_heading','field_69365ff82e6f2'),(201933,2734,'deadline_content','You need to take action before the deadline to take your super back.'),(201934,2734,'_deadline_content','field_693660342e6f3'),(201935,2734,'deadline_button_text','Find out more'),(201936,2734,'_deadline_button_text','field_693660482e6f4'),(201937,2734,'deadline_button_url','/key-deadlines/'),(201938,2734,'_deadline_button_url','field_693660912e6f5'),(201939,2734,'what_head','Get involved'),(201940,2734,'_what_head','field_69366611096ac'),(201941,2734,'what_happened_0_happ_sub','Take action here...'),(201942,2734,'_what_happened_0_happ_sub','field_693d4a8b4197d'),(201943,2734,'what_happened_0_happ_content','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut laoreet dolore magna aliquam erat volutpat. Ut wisi enim ad minim veniam, quis nostrud exerci tation ullamcorper suscipit lobortis nisl ut aliquip ex ea commodo consequat.\r\n\r\nDuis autem vel eum iriure dolor in hendrerit in vulputate velit esse molestie consequat, 