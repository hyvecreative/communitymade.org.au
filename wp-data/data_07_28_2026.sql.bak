ield_5b67c63658af5'),(36888,1522,'support_right_title','NDIS Registered provider'),(36889,1522,'_support_right_title','field_5b67c6a38c064'),(36890,1522,'support_right_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut.'),(36891,1522,'_support_right_cont','field_5b67c6c98c065'),(36892,1522,'support_right_button','<a class=\"btn btn-blue\" href=\"#\">Read more</a>'),(36893,1522,'_support_right_button','field_5b67c6dd8c066'),(36894,1522,'first_image_title','Lifestart is about supporting young children'),(36895,1522,'_first_image_title','field_5b67ca606afc4'),(36896,1522,'first_image_cont','from 0-24 years living with disabilities and their familes'),(36897,1522,'_first_image_cont','field_5b67caff6afc5'),(36898,1522,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(36899,1522,'_first_image_button','field_5b67cb0d6afc6'),(36900,1522,'second _image_title','Lifestart is about supporting young children'),(36901,1522,'_second _image_title','field_5b67cb20ddf9a'),(36902,1522,'second_image_cont','from 0-24 years living with disabilities and their familes'),(36903,1522,'_second_image_cont','field_5b67cb24ddf9b'),(36904,1522,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(36905,1522,'_second_image_button','field_5b67cb29ddf9c'),(36906,1522,'second_image_title','Lifestart is about supporting young children'),(36907,1522,'_second_image_title','field_5b67cb20ddf9a'),(36908,1522,'page_col_image','412'),(36909,1522,'_page_col_image','field_5de6546e7c63a'),(36910,1522,'page_col_image_3','437'),(36911,1522,'_page_col_image_3','field_5de6e3998e07e'),(36912,1522,'sec_2_title','Community'),(36913,1522,'_sec_2_title','field_5de6e3ef2798f'),(36914,1522,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(36915,1522,'_sec_2_text','field_5de78dc89e613'),(36916,1522,'sec_3_title','The Project'),(36917,1522,'_sec_3_title','field_5de6e3d37d8da'),(36918,1522,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(36919,1522,'_sec_3_text','field_5de6e4044e5e8'),(36920,1522,'page_col_image_2','436'),(36921,1522,'_page_col_image_2','field_5de6546e7c63a'),(36922,1522,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(36923,1522,'_sec_2_button','field_5de6e58c86706'),(36924,1522,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(36925,1522,'_sec_3_button','field_5de6e5a243c03'),(36926,1522,'page_col_image_4','455'),(36927,1522,'_page_col_image_4','field_5de70801090ce'),(36928,1522,'sec_4_title','Location'),(36929,1522,'_sec_4_title','field_5de7082a12a81'),(36930,1522,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(36931,1522,'_sec_4_text','field_5de7084812a82'),(36932,1522,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(36933,1522,'_sec_4_button','field_5de7085e12a83'),(36934,1522,'news_title','Project updates'),(36935,1522,'_news_title','field_5de78da3aabb9'),(36936,1522,'sec_2_text_copy',''),(36937,1522,'_sec_2_text_copy','field_5de78dc89e613'),(36938,1522,'timeline-title','Timeline'),(3