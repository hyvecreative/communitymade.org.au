ro_boxes_2_box_icon','1937'),(155145,2459,'_intro_boxes_2_box_icon','field_65262db5d36ee'),(155146,2459,'intro_boxes_2_box_title','Ideas'),(155147,2459,'_intro_boxes_2_box_title','field_65262d29ed8e3'),(155148,2459,'intro_boxes_2_box_dropdown','Our rigorous, conflict-free research and data analysis lifts the lid on fund performance, fees and insurance. Drawing on our policy expertise, we turn this analysis into action by using it to back reform and make super easier for people to understand. <a href=\"//localhost:4000:4000:4000:4000:4000:4000:/how/\">More</a>'),(155149,2459,'_intro_boxes_2_box_dropdown','field_65262dead0a0c'),(155150,2459,'intro_boxes','3'),(155151,2459,'_intro_boxes','field_65262d14ed8e2'),(155152,2459,'get_help_section_title','Get Help'),(155153,2459,'_get_help_section_title','field_65262c35143de'),(155154,2459,'get_help_block_home',''),(155155,2459,'_get_help_block_home','field_65262c8a143e1'),(155156,2459,'gh_block_home_0_help_image','1956'),(155157,2459,'_gh_block_home_0_help_image','field_65262cd0143e2'),(155158,2459,'gh_block_home_0_help_title','How much do I need to retire? '),(155159,2459,'_gh_block_home_0_help_title','field_65262cec143e3'),(155160,2459,'gh_block_home_0_help_url','#'),(155161,2459,'_gh_block_home_0_help_url','field_65262cf4143e4'),(155162,2459,'gh_block_home_1_help_image','1962'),(155163,2459,'_gh_block_home_1_help_image','field_65262cd0143e2'),(155164,2459,'gh_block_home_1_help_title','I have a problem with  my super fund'),(155165,2459,'_gh_block_home_1_help_title','field_65262cec143e3'),(155166,2459,'gh_block_home_1_help_url','#'),(155167,2459,'_gh_block_home_1_help_url','field_65262cf4143e4'),(155168,2459,'gh_block_home_2_help_image','1961'),(155169,2459,'_gh_block_home_2_help_image','field_65262cd0143e2'),(155170,2459,'gh_block_home_2_help_title','How do I choose the right super? '),(155171,2459,'_gh_block_home_2_help_title','field_65262cec143e3'),(155172,2459,'gh_block_home_2_help_url','#'),(155173,2459,'_gh_block_home_2_help_url','field_65262cf4143e4'),(155174,2459,'gh_block_home','3'),(155175,2459,'_gh_block_home','field_65262c8a143e1'),(155176,2459,'turn_on_insights',''),(155177,2459,'_turn_on_insights','field_645c4a2e654a6'),(155178,2459,'report_questions','a:3:{i:0;s:4:\"1997\";i:1;s:4:\"2067\";i:2;s:4:\"2089\";}'),(155179,2459,'_report_questions','field_6109ed5e02e5a'),(155180,2459,'intro_text','The Disability Dialogue is a place where people with disabilities, their families, organisations providing support, academics, and the wider community come together to work on things that matter to us.\r\n\r\nThe Dialogue is a hub of knowledge and collaboration, separate from government, where we work together to come up. With new ideas on important topics. Our ideas can make a big difference in how services and systems are set up for people with disabilities.'),(155181,2459,'_intro_text','field_66441acfe963c'),(155182,2459,'word_link','#'),(155183,2459,'_word_link','field_6646c69723804'),(155184,2459,'pdf_link','#'),(155185,2459,'_pdf_link','field_6646c6da23805'),(155186,2459,'intro_boxes_0_box_image','2241'),(155187,2459,'_intro_boxes_0_box_image','field_65262db5d36ee'),(155188,2459,'intro_boxes_1_box_image','2179'),(155189,2459,'_intro_boxes_1_box_image','field_65262db5d36ee'),(155190,2459,'intro_boxes_2_box_image','2012'),(155191,2459,'_intro_boxes_2_box_image','field_65262db5d36ee'),(155192,2459,'intro_boxes_0_box_excerpt','Excerpt text here just a sentance or so and no more.'),(155193,2459,'_intro_boxes_0_box_excerpt','field_665975273e827'),(155194,2459,'intro_boxes_1_box_excerpt','Excerpt text here just a sentance or so and no more.'),(155195,2459,'_intro_boxes_1_box_excerpt','field_665975273e827'),(155196,2459,'intro_boxes_2_box_excerpt','Excerpt text here just a sentance or so and no more.'),(155197,2459,'_intro_boxes_2_box_excerpt','field_665975273e827'),(155198,2459,'intro_boxes_0_btn-text','Latest events'),(155199,2459,'_intro_boxes_0_btn-text','field_665abda8b8d4b'),(1