  PRIMARY KEY (`meta_id`),
  KEY `post_id` (`post_id`),
  KEY `meta_key` (`meta_key`(191))
) ENGINE=InnoDB AUTO_INCREMENT=213230 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_520_ci;
