rtant;\n}\n.kt-accordion-panel-inner {\n  padding: 0px;\n}\n\n.wp-block-kadence-iconlist ul.kt-svg-icon-list .kt-svg-icon-list-item-wrap {\n  align-items: flex-start;\n}\n\n/* Look up tool */\n#advisor-lookup input {margin-bottom: 1rem;}\n#results .record {margin-bottom: 1rem;}\n\n\n/* intro para */\n.intro-para {margin-top: 1.5rem; font-weight: 600;}\n\n/* advisor lookup */\n.advisor-lookup {margin-top: 1.5rem;}\n.advisor-form {display: flex;}\n.advisor-lookup input {flex: 0 0 75%;\n    max-width: 75%; padding: 6px; border-radius: .25rem; border: 1px solid #999; margin-top: 1px; height: 48px; }\n.advisor-lookup button {flex: 0 0 23%;\n    max-width: 23%; padding: 6px; border-radius: .25rem; height: 48px; margin-top: 1px; }\n\n#results {padding: 1rem; border: 1px transparent solid; border-radius: .5rem; }\n\n.record {padding-bottom: .5rem; margin-bottom: .5rem; border-bottom: 1px dashed #ccc;}\n\n@media (min-width: 768px) {\n.deadline-wrapper p {font-size: 1.25rem;}\n}','superback','','inherit','closed','closed','','2358-revision-v1','','','2025-12-16 04:03:01','2025-12-16 04:03:01','',2358,'http://localhost/?p=2656',0,'revision','',0),(2657,1,'2025-12-16 23:04:07','2025-12-16 23:04:07','','Home temp','','inherit','closed','closed','','2263-revision-v1','','','2025-12-16 23:04:07','2025-12-16 23:04:07','',2263,'http://localhost/?p=2657',0,'revision','',0),(2658,0,'2025-12-16 23:08:44','2025-12-16 23:08:44','{\"0\":\"skiplinks\",\"1\":[\"control-titles\",\"1\"],\"timestamp\":1765926524}',':4000/find-out-if-youre-affected/','','publish','closed','closed','','4000-find-out-if-youre-affected','','','2025-12-16 23:08:44','2025-12-16 23:08:44','',0,'http://localhost/wpa-stats/4000-find-out-if-youre-affected/',0,'wpa-stats','',0),(2659,1,'2025-12-16 23:17:18','2025-12-16 23:17:18','a:12:{s:10:\"aria-label\";s:0:\"\";s:4:\"type\";s:7:\"wysiwyg\";s:12:\"instructions\";s:0:\"\";s:8:\"required\";i:0;s:17:\"conditional_logic\";i:0;s:7:\"wrapper\";a:3:{s:5:\"width\";s:0:\"\";s:5