tered provider'),(80389,1913,'_support_right_title','field_5b67c6a38c064'),(80390,1913,'support_right_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut.'),(80391,1913,'_support_right_cont','field_5b67c6c98c065'),(80392,1913,'support_right_button','<a class=\"btn btn-blue\" href=\"#\">Read more</a>'),(80393,1913,'_support_right_button','field_5b67c6dd8c066'),(80394,1913,'first_image_title','Lifestart is about supporting young children'),(80395,1913,'_first_image_title','field_5b67ca606afc4'),(80396,1913,'first_image_cont','from 0-24 years living with disabilities and their familes'),(80397,1913,'_first_image_cont','field_5b67caff6afc5'),(80398,1913,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(80399,1913,'_first_image_button','field_5b67cb0d6afc6'),(80400,1913,'second _image_title','Lifestart is about supporting young children'),(80401,1913,'_second _image_title','field_5b67cb20ddf9a'),(80402,1913,'second_image_cont','from 0-24 years living with disabilities and their familes'),(80403,1913,'_second_image_cont','field_5b67cb24ddf9b'),(80404,1913,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(80405,1913,'_second_image_button','field_5b67cb29ddf9c'),(80406,1913,'second_image_title','Lifestart is about supporting young children'),(80407,1913,'_second_image_title','field_5b67cb20ddf9a'),(80408,1913,'page_col_image','412'),(80409,1913,'_page_col_image','field_5de6546e7c63a'),(80410,1913,'page_col_image_3','437'),(80411,1913,'_page_col_image_3','field_5de6e3998e07e'),(80412,1913,'sec_2_title','Community'),(80413,1913,'_sec_2_title','field_5de6e3ef2798f'),(80414,1913,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(80415,1913,'_sec_2_text','field_5de78dc89e613'),(80416,1913,'sec_3_title','The Project'),(80417,1913,'_sec_3_title','field_5de6e3d37d8da'),(80418,1913,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(80419,1913,'_sec_3_text','field_5de6e4044e5e8'),(80420,1913,'page_col_image_2','436'),(80421,1913,'_page_col_image_2','field_5de6546e7c63a'),(80422,1913,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(80423,1913,'_sec_2_button','field_5de6e58c86706'),(80424,1913,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(80425,1913,'_sec_3_button','field_5de6e5a243c03'),(80426,1913,'page_col_image_4','455'),(80427,1913,'_page_col_image_4','field_5de70801090ce'),(80428,1913,'sec_4_title','Location'),(80429,1913,'_sec_4_title','field_5de7082a12a81'),(80430,1913,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(80431,1913,'_sec_4_text','field_5de7084812a82'),(80432,1913,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(80433,1913,'_sec_4_button','field_5de7085e12a83'),(80434,1913,'news_title','Project updates'),(80435,1913,'_news_title','field_5de78da3aabb9'),(80436,1913,'sec_2_text_copy',''),(80437,1913,'_sec_2_text_copy','field_5de78dc89e613'),(80438,1913,'timeline-title','Timeline'),(80439,1913,'_timeline-title','field_5de78df29e615'),(80440,1913,'ti