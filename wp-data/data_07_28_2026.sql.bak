utton','field_5b67cb29ddf9c'),(23589,1120,'second_image_title','Lifestart is about supporting young children'),(23590,1120,'_second_image_title','field_5b67cb20ddf9a'),(23591,1120,'page_col_image','412'),(23592,1120,'_page_col_image','field_5de6546e7c63a'),(23593,1120,'page_col_image_3','437'),(23594,1120,'_page_col_image_3','field_5de6e3998e07e'),(23595,1120,'sec_2_title','Community'),(23596,1120,'_sec_2_title','field_5de6e3ef2798f'),(23597,1120,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(23598,1120,'_sec_2_text','field_5de78dc89e613'),(23599,1120,'sec_3_title','The Project'),(23600,1120,'_sec_3_title','field_5de6e3d37d8da'),(23601,1120,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(23602,1120,'_sec_3_text','field_5de6e4044e5e8'),(23603,1120,'page_col_image_2','436'),(23604,1120,'_page_col_image_2','field_5de6546e7c63a'),(23605,1120,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(23606,1120,'_sec_2_button','field_5de6e58c86706'),(23607,1120,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(23608,1120,'_sec_3_button','field_5de6e5a243c03'),(23609,1120,'page_col_image_4','455'),(23610,1120,'_page_col_image_4','field_5de70801090ce'),(23611,1120,'sec_4_title','Location'),(23612,1120,'_sec_4_title','field_5de7082a12a81'),(23613,1120,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(23614,1120,'_sec_4_text','field_5de7084812a82'),(23615,1120,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(23616,1120,'_sec_4_button','field_5de7085e12a83'),(23617,1120,'news_title','Project updates'),(23618,1120,'_news_title','field_5de78da3aabb9'),(23619,1120,'sec_2_text_copy',''),(23620,1120,'_sec_2_text_copy','field_5de78dc89e613'),(23621,1120,'timeline-title','Timeline'),(23622,1120,'_timeline-title','field_5de78df29e615'),(23623,1120,'timeline_title','Timeline'),(23624,1120,'_timeline_title','field_5de78df29e615'),(23625,1120,'contact_title','Contact us'),(23626,1120,'_contact_title','field_5de7981e06057'),(23627,1120,'contact_intro','Contact text...'),(23628,1120,'_contact_intro','field_5de7983506058'),(23629,1120,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(23630,1120,'_news_button','field_5de8329896e02'),(23631,1120,'timeline_intro','Introduction of timeline detail...'),(23632,1120,'_timeline_intro','field_5de98f5fb1781'),(23633,1120,'timeline_pic','477'),(23634,1120,'_timeline_pic','field_5de98f72b1782'),(23635,1120,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(23636,1120,'_timeline_button','field_5de99363677f8'),(23637,1120,'banner_image_position','center'),(23638,1120,'_banner_image_position','field_5f3bc4757dd02'),(23639,1120,'services_title','Our services'),(23640,1120,'_services_title','field_5f20f3cd80eb2'),(23641,1120,'services_items_0_services_item_image','1061'),(23642,1120,'_services_items_0_services_item_image','field_5f2121355be14'),(23643,1120,'services_items_0_sservices_item_title','1300 Telephone counselling line'),(23644,1120,'_services_items_0_sser