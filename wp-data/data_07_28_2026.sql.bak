(62413,1823,'_report_link_url','field_62f30ef4b57e3'),(62414,1823,'report_link_text','Download'),(62415,1823,'_report_link_text','field_62f30f01b57e4'),(62416,1823,'solutions_content','The housing system is complex, and no one solution will solve the complex problems we now face but there are some critical first steps to be taken now.\r\n<ul>\r\n 	<li>Set out an ambitious national housing agreement between commonwealth and state governments with targets and funding for the construction of affordable homes.</li>\r\n 	<li>Phase out tax breaks for property investors and using the increase in revenue to build more public housing.</li>\r\n 	<li>Establish laws which limit rental increases beyond what is fair.</li>\r\n 	<li>Rebalance tenancy laws to provide renters with more security and control, such as eliminating no grounds evictions.</li>\r\n 	<li>Phase out stamp duty and replace it with a broad-based land tax.</li>\r\n</ul>\r\n<h4>While there are many opinions on what policy changes will fix the housing market, doing nothing is not an option.</h4>'),(62417,1823,'_solutions_content','field_640e8b307a958'),(62418,1823,'problem_icons_0_prob_icon','1699'),(62419,1823,'_problem_icons_0_prob_icon','field_640fa0291d519'),(62420,1823,'problem_icons_0_prob_concerned_stat','70% highly concerned'),(62421,1823,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(62422,1823,'problem_icons_0_prob_concerded_text','are highly concerned'),(62423,1823,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(62424,1823,'problem_icons_0_prob_issue_text',''),(62425,1823,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(62426,1823,'problem_icons','4'),(62427,1823,'_problem_icons','field_640fa0191d518'),(62428,1823,'ceh_content_left',''),(62429,1823,'_ceh_content_left','field_640e97e8f1c8c'),(62430,1823,'ceh_content_right',''),(62431,1823,'_ceh_content_right','field_640e97fdf1c8d'),(62432,1823,'pc_content_left',''),(62433,1823,'_pc_content_left','field_640e983bf1c8f'),(62434,1823,'pc_content_right',''),(62435,1823,'_pc_content_right','field_640e984df1c90'),(62436,1823,'problem_icons_1_prob_icon','1699'),(62437,1823,'_problem_icons_1_prob_icon','field_640fa0291d519'),(62438,1823,'problem_icons_1_prob_concerned_stat','69% highly concerned'),(62439,1823,'_problem_icons_1_prob_concerned_stat','field_640fa0dd81d95'),(62440,1823,'problem_icons_1_prob_concerded_text','are highly concerned'),(62441,1823,'_problem_icons_1_prob_concerded_text','field_640fa10181d96'),(62442,1823,'problem_icons_1_prob_issue_text',''),(62443,1823,'_problem_icons_1_prob_issue_text','field_640fa11a81d97'),(62444,1823,'problem_icons_2_prob_icon','1699'),(62445,1823,'_problem_icons_2_prob_icon','field_640fa0291d519'),(62446,1823,'problem_icons_2_prob_concerned_stat','64% highly concerned'),(62447,1823,'_problem_icons_2_prob_concerned_stat','field_640fa0dd81d95'),(62448,1823,'problem_icons_2_prob_concerded_text','are highly concerned'),(62449,1823,'_problem_icons_2_prob_concerded_text','field_640fa10181d96'),(62450,1823,'problem_icons_2_prob_issue_text',''),(62451,1823,'_problem_icons_2_prob_issue_text','field_640fa11a81d97'),(62452,1823,'problem_icons_3_prob_icon','1699'),(62453,1823,'_problem_icons_3_prob_icon','field_640fa0291d519'),(62454,1823,'problem_icons_3_prob_concerned_stat','64% highly concerned'),(62455,1823,'_problem_icons_3_prob_concerned_stat','field_640fa0dd81d95'),(62456,1823,'problem_icons_3_prob_concerded_text','are highly concerned'),(62457,1823,'_problem_icons_3_prob_concerded_text','field_640fa10181d96'),(62458,1823,'problem_icons_3_prob_issue_text',''),(62459,1823,'_problem_icons_3_prob_issue_text','field_640fa11a81d97'),(62460,1823,'problem_icons_0_prob_concerned_text','House prices have doubled in a decade'),(62461,1823,'_problem_icons_0_prob_concerned_text','field_640fa10181d96'),(62462,1823,'problem_icons_1_prob_concerned_text','The gap between rich and poor is growing'),(62463,1823,'_problem_icons_1_prob_concerned_text','field_640fa10181d96'),(62464,1823,'problem_icons_2_prob_concerned_text','Construction of social housing is down'),(62465,1823,'_problem_icons_2_prob_concerned_text','field_640fa10181d96'),(62466,1823,'problem_icons_3_prob_concerned_text','Banks are making more than ever from housing'),(62467,1823,'_problem_icons_3_prob_concerned_text','field_640fa10181d96'),(62468,1823,'monitor_content','The Australian Housing Monitor is a large, nationally-representative survey covering public experiences and attitudes toward housing related issues. Questions range from how well the respondent is keeping up with their mortgage/rent, to what they think about social housing construction.\r\n\r\nA broad range of demographic criteria are included, such as gender, location, age, income, voting preference, educational level, tenure type, and employment status. These variables allow CEH researchers to understand the trends and diversity of opinion around the country.\r\n\r\nIt also incorporates questions from previous surveys to track trends over time.\r\nThe inaugural poll was conducted by Essential in December 2022, and was completed by 4,735 people.'),(62469,1823,'_monitor_content','field_640fcc4014404'),(62470,1823,'problem_head','Housing in Australia is not working, and Australians are concerned.'),(62471,1823,'_problem_head','field_641935436aded'),(62472,1823,'problem_signoff','Explore the research showing how concerned Australians are our about the housing situation.'),(62473,1823,'_problem_signoff','field_641935626adee'),(62474,1823,'sections','a:2:{i:0;s:4:\"hero\";i:1;s:9:\"news_grid\";}'),(62475,1823,'_sections','field_5dafb40b8143a'),(62476,1823,'sections_0_is_full_height','1'),(62477,1823,'_sections_0_is_full_height','field_61d6f6fd5a37e'),(62478,1823,'sections_0_image','1648'),(62479,1823,'_sections_0_image','field_61d6f6d45a37d'),(62480,1823,'sections_0_heading','Heading'),(62481,1823,'_sections_0_heading','field_61d6f69e5a379'),(62482,1823,'sections_0_subtitle','Ya ya '),(62483,1823,'_sections_0_subtitle','field_61d6f6ac5a37a'),(62484,1823,'sections_0_link_one',''),(62485,1823,'_sections_0_link_one','field_61d6f6b55a37b'),(62486,1823,'sections_0_link_two',''),(62487,1823,'_sections_0_link_two','field_61d6f6c35a37c'),(62488,1823,'sections_1_select_categories','a:1:{i:0;s:2:\"27\";}'),(62489,1823,'_sections_1_select_categories','field_637f04483b63b'),(62490,1823,'intro_head_major','Queenslanders are known for both our love of the great outdoors and our state pride…'),(62491,1823,'_intro_head_major','field_64e828783ad9f'),(62492,1823,'intro_head_minor','But there’s a few things you might not know about our beautiful state.'),(62493,1823,'_intro_head_minor','field_64e8288c3ada0'),(62494,1823,'intro_icons_0_int_icon','1806'),(62495,1823,'_intro_icons_0_int_icon','field_64e828b33ada2'),(62496,1823,'intro_icons_0_int_icon_text','At 1,727,000 square kilometres, we’re 2.5 times the size of Texas. <span>Yeeha!</span>'),(62497,1823,'_intro_icons_0_int_icon_text','field_64e828e33ada3'),(62498,1823,'intro_icons_1_int_icon','1806'),(62499,1823,'_intro_icons_1_int_icon','field_64e828b33ada2'),(62500,1823,'intro_icons_1_int_icon_text','We have twice as many species of native plant and animal as any other Australian state or territory.'),(62501,1823,'_intro_icons_1_int_icon_text','field_64e828e33ada3'),(62502,1823,'intro_icons_2_int_icon','1806'),(62503,1823,'_intro_icons_2_int_icon','field_64e828b33ada2'),(62504,1823,'intro_icons_2_int_icon_text','We have less land classified as ‘protected’ than any other state or territory.'),(62505,1823,'_intro_icons_2_int_icon_text','field_64e828e33ada3'),(62506,1823,'intro_icons','3'),(62507,1823,'_intro_icons','field_64e828963ada1'),(62508,1823,'threat_head_major','What we stand to lose if we don’t act soon to protect beautiful Queensland:'),(62509,1823,'_threat_head_major','field_64ec258d9dbd1'),(62510,1823,'threats_icons','3'),(62511,1823,'_threats_icons','field_64ec2551a93f9'),(62512,1823,'threats_icons_0_thr_icon','1819'),(62513,1823,'_threats_icons_0_thr_icon','field_64ec2551a93fa'),(62514,1823,'threats_icons_0_thr_icon_text','The rich cultural heritage of our First Nations people and their continuous ties to country, dating back more than 50,000 years.'),(62515,1823,'_threats_icons_0_thr_icon_text','field_64ec2551a93fb'),(62516,1823,'threats_icons_1_thr_icon','1819'),(62517,1823,'_threats_icons_1_thr_icon','field_64ec2551a93fa'),(62518,1823,'threats_icons_1_thr_icon_text','Thousands of species of plant and animal which are now classified as threatened or endangered in Queensland.'),(62519,1823,'_threats_icons_1_thr_icon_text','field_64ec2551a93fb'),(62520,1823,'threats_icons_2_thr_icon','1819'),(62521,1823,'_threats_icons_2_thr_icon','field_64ec2551a93fa'),(62522,1823,'threats_icons_2_thr_icon_text','The access to nature that is central to the Queensland way of life.'),(62523,1823,'_threats_icons_2_thr_icon_text','field_64ec2551a93fb'),(62524,1823,'threat_icons_0_thr_icon','1819'),(62525,1823,'_threat_icons_0_thr_icon','field_64ec2551a93fa'),(62526,1823,'threat_icons_0_thr_icon_text','The rich cultural heritage of our First Nations people and their continuous ties to country, dating back more than 50,000 years.'),(62527,1823,'_threat_icons_0_thr_icon_text','field_64ec2551a93fb'),(62528,1823,'threat_icons_1_thr_icon','1819'),(62529,1823,'_threat_icons_1_thr_icon','field_64ec2551a93fa'),(62530,1823,'threat_icons_1_thr_icon_text','Thousands of species of plant and animal which are now classified as threatened or endangered in Queensland.'),(62531,1823,'_threat_icons_1_thr_icon_text','field_64ec2551a93fb'),(62532,1823,'threat_icons_2_thr_icon','1819'),(62533,1823,'_threat_icons_2_thr_icon','field_64ec2551a93fa'),(62534,1823,'threat_icons_2_thr_icon_text','The access to nature that is central to the Queensland way of life.'),(62535,1823,'_threat_icons_2_thr_icon_text','field_64ec2551a93fb'),(62536,1823,'threat_icons','3'),(62537,1823,'_threat_icons','field_64ec2551a93f9'),(62540,182