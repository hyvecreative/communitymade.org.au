appened_1_happ_icon','field_693d4c9b3ec4d'),(197849,2721,'display_news_section',''),(197850,2721,'_display_news_section','field_69434cc6d5f7d'),(197851,2721,'issues_head','These are the issues'),(197852,2721,'_issues_head','field_6a3b076406aef'),(197853,2721,'issues_items_0_issue_icon','2705'),(197854,2721,'_issues_items_0_issue_icon','field_6a3b07b506af1'),(197855,2721,'issues_items_0_issues_item_hd','The problem'),(197856,2721,'_issues_items_0_issues_item_hd','field_6a3b07d706af2'),(197857,2721,'issues_items_0_issues_item_txt','Rents are rising, waitlists are growing and more people are experiencing housing stress for the first time.'),(197858,2721,'_issues_items_0_issues_item_txt','field_6a3b07fc06af3'),(197859,2721,'issues_items_0_issues_link_text','Find out more'),(197860,2721,'_issues_items_0_issues_link_text','field_6a3b080f06af4'),(197861,2721,'issues_items_0_issues_target_url','#'),(197862,2721,'_issues_items_0_issues_target_url','field_6a3b082b06af5'),(197863,2721,'issues_items','5'),(197864,2721,'_issues_items','field_6a3b078206af0'),(197865,2721,'issues_items_1_issue_icon','2708'),(197866,2721,'_issues_items_1_issue_icon','field_6a3b07b506af1'),(197867,2721,'issues_items_1_issues_item_hd','Scaling the solution'),(197868,2721,'_issues_items_1_issues_item_hd','field_6a3b07d706af2'),(197869,2721,'issues_items_1_issues_item_txt','Governments, communities and not-for-profit community housing providers are working together to make rental housing more affordable for everyone who calls NSW home.'),(197870,2721,'_issues_items_1_issues_item_txt','field_6a3b07fc06af3'),(197871,2721,'issues_items_1_issues_link_text','Find out more'),(197872,2721,'_issues_items_1_issues_link_text','field_6a3b080f06af4'),(197873,2721,'issues_items_1_issues_target_url','#'),(197874,2721,'_issues_items_1_issues_target_url','field_6a3b082b06af5'),(197875,2721,'issues_items_0_issues_sub_head','The housing crisis is spiralling. '),(197876,2721,'_issues_items_0_issues_sub_head','field_6a3b0aa79365e'),(197877,2721,'issues_items_1_issues_sub_head','Community housing is social infrastructure.'),(197878,2721,'_issues_items_1_issues_sub_head','field_6a3b0aa79365e'),(197879,2721,'issues_items_2_issue_icon','2703'),(197880,2721,'_issues_items_2_issue_icon','field_6a3b07b506af1'),(197881,2721,'issues_items_2_issues_item_hd','Why community made:'),(197882,2721,'_issues_items_2_issues_item_hd','field_6a3b07d706af2'),(197883,2721,'issues_items_2_issues_sub_head',''),(197884,2721,'_issues_items_2_issues_sub_head','field_6a3b0aa79365e'),(197885,2721,'issues_items_2_issues_item_txt','Community housing is local. Every dollar invested is given back to community through homes, services and jobs. It’s built to thrive, like our communities.  Community housing is an investment in our state’s future. By investing in people today, we boost our local economies, communities and productivity – ensuring that NSW leads the nation.'),(197886,2721,'_issues_items_2_issues_item_txt','field_6a3b07fc06af3'),(197887,2721,'issues_items_2_issues_link_text',''),(197888,2721,'_issues_items_2_issues_link_text','field_6a3b080f06af4'),(197889,2721,'issues_items_2_issues_target_url',''),(197890,2721,'_issues_items_2_issues_target_url','field_6a3b082b06af5'),(197891,2721,'issues_items_3_issue_icon',''),(197892,2721,'_issues_items_3_issue_icon','field_6a3b07b506af1'),(197893,2721,'issues_items_3_issues_item_hd',''),(197894,2721,'_issues_items_3_issues_item_hd','field_6a3b07d706af2'),(197895,2721,'issues_items_3_issues_sub_head',''),(197896,2721,'_issues_items_3_issues_sub_head','field_6a3b0aa79365e'),(197897,2721,'issues_items_3_issues_item_txt',''),(197898,2721,'_issues_items_3_issues_item_txt','field_6a3b07fc06af3'),(197899,2721,'issues_items_3_issues_link_text',''),(197900,2721,'_issues_items_3_issues_link_text','field_6a3b080f06af4'),(197901,2721,'issues_items_3_issues_target_url',''),(197902,2721,'_issues_items_3_issues_target_url','field_6a3b082b06af5'),(197903,2721,'issues_items_4_issue_