103405,1991,'logo_slider_6_',''),(103406,1991,'_logo_slider_6_','field_64fd7321b85f5'),(103407,1991,'signup_subhead','Queenslanders are coming together to protect our beautiful state and safeguard our way of life.'),(103408,1991,'_signup_subhead','field_64fd834dd90ab'),(103409,1991,'signup_form','[actionnetwork id=2]'),(103410,1991,'_signup_form','field_64fd8361d90ac'),(103411,1991,'signup_head','Join the campaign'),(103412,1991,'_signup_head','field_64fd83dc6b0b1'),(103413,1991,'boxes_section_title','Boxes'),(103414,1991,'_boxes_section_title','field_65262bbfd17fc'),(103415,1991,'intro_boxes_0_box_icon','1943'),(103416,1991,'_intro_boxes_0_box_icon','field_65262db5d36ee'),(103417,1991,'intro_boxes_0_box_title','Campaigning and policy'),(103418,1991,'_intro_boxes_0_box_title','field_65262d29ed8e3'),(103419,1991,'intro_boxes_0_box_dropdown','Our rigorous, conflict-free research and data analysis lifts the lid on fund performance, fees and insurance. Drawing on our policy expertise, we turn this analysis into action by using it to back reform and make super easier for people to understand. <a href=\"//localhost:4000:4000:4000:4000/how/\">More</a> '),(103420,1991,'_intro_boxes_0_box_dropdown','field_65262dead0a0c'),(103421,1991,'intro_boxes_1_box_icon','1941'),(103422,1991,'_intro_boxes_1_box_icon','field_65262db5d36ee'),(103423,1991,'intro_boxes_1_box_title','Investigative journalism'),(103424,1991,'_intro_boxes_1_box_title','field_65262d29ed8e3'),(103425,1991,'intro_boxes_1_box_dropdown','Dropdown text'),(103426,1991,'_intro_boxes_1_box_dropdown','field_65262dead0a0c'),(103427,1991,'intro_boxes_2_box_icon','1937'),(103428,1991,'_intro_boxes_2_box_icon','field_65262db5d36ee'),(103429,1991,'intro_boxes_2_box_title','Research'),(103430,1991,'_intro_boxes_2_box_title','field_65262d29ed8e3'),(103431,1991,'intro_boxes_2_box_dropdown','Dropdown text'),(103432,1991,'_intro_boxes_2_box_dropdown','field_65262dead0a0c'),(103433,1991,'intro_boxes','3'),(103434,1991,'_intro_boxes