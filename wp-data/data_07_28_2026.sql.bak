96733,1957,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(96734,1957,'_sec_3_text','field_5de6e4044e5e8'),(96735,1957,'page_col_image_2','436'),(96736,1957,'_page_col_image_2','field_5de6546e7c63a'),(96737,1957,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(96738,1957,'_sec_2_button','field_5de6e58c86706'),(96739,1957,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(96740,1957,'_sec_3_button','field_5de6e5a243c03'),(96741,1957,'page_col_image_4','455'),(96742,1957,'_page_col_image_4','field_5de70801090ce'),(96743,1957,'sec_4_title','Location'),(96744,1957,'_sec_4_title','field_5de7082a12a81'),(96745,1957,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(96746,1957,'_sec_4_text','field_5de7084812a82'),(96747,1957,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(96748,1957,'_sec_4_button','field_5de7085e12a83'),(96749,1957,'news_title','Project updates'),(96750,1957,'_news_title','field_5de78da3aabb9'),(96751,1957,'sec_2_text_copy',''),(96752,1957,'_sec_2_text_copy','field_5de78dc89e613'),(96753,1957,'timeline-title','Timeline'),(96754,1957,'_timeline-title','field_5de78df29e615'),(96755,1957,'timeline_title','Timeline'),(96756,1957,'_timeline_title','field_5de78df29e615'),(9