5b67c63158af4'),(176516,2607,'support_ctr_button','<a class=\"btn btn-orange\" href=\"/supports/\">Find us</a>'),(176517,2607,'_support_ctr_button','field_5b67c63658af5'),(176518,2607,'support_right_title','NDIS Registered provider'),(176519,2607,'_support_right_title','field_5b67c6a38c064'),(176520,2607,'support_right_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut.'),(176521,2607,'_support_right_cont','field_5b67c6c98c065'),(176522,2607,'support_right_button','<a class=\"btn btn-blue\" href=\"#\">Read more</a>'),(176523,2607,'_support_right_button','field_5b67c6dd8c066'),(176524,2607,'first_image_title','Lifestart is about supporting young children'),(176525,2607,'_first_image_title','field_5b67ca606afc4'),(176526,2607,'first_image_cont','from 0-24 years living with disabilities and their familes'),(176527,2607,'_first_image_cont','field_5b67caff6afc5'),(176528,2607,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(176529,2607,'_first_image_button','field_5b67cb0d6afc6'),(176530,2607,'second _image_title','Lifestart is about supporting young children'),(176531,2607,'_second _image_title','field_5b67cb20ddf9a'),(176532,2607,'second_image_cont','from 0-24 years living with disabilities and their familes'),(176533,2607,'_second_image_cont','field_5b67cb24ddf9b'),(176534,2607,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(176535,2607,'_second_image_button','field_5b67cb29ddf9c'),(176536,2607,'second_image_title','Lifestart is about supporting young children'),(176537,2607,'_second_image_title','field_5b67cb20ddf9a'),(176538,2607,'page_col_image','412'),(176539,2607,'_page_col_image','field_5de6546e7c63a'),(176540,2607,'page_col_image_3','437'),(176541,2607,'_page_col_image_3','field_5de6e3998e07e'),(176542,2607,'sec_2_title','Community'),(176543,2607,'_sec_2_title','field_5de6e3ef2798f'),(176544,2607,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(176545,2607,'_sec_2_text','field_5de78dc89e613'),(176546,2607,'sec_3_title','The Project'),(176547,2607,'_sec_3_title','field_5de6e3d37d8da'),(176548,2607,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(176549,2607,'_sec_3_text','field_5de6e4044e5e8'),(176550,2607,'page_col_image_2','436'),(176551,2607,'_page_col_image_2','field_5de6546e7c63a'),(176552,2607,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(176553,2607,'_sec_2_button','field_5de6e58c86706'),(176554,2607,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(176555,2607,'_sec_3_button','field_5de6e5a243c03'),(176556,2607,'page_col_image_4','455'),(176557,2607,'_page_col_image_4','field_5de70801090ce'),(176558,2607,'sec_4_title','Location'),(176559,2607,'_sec_4_title','field_5de7082a12a81'),(176560,2607,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(176561,2607,'_sec_4_text','field_5de7084812a82'),(176562,2607,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(176563,2607,'_sec_4_button','field_5de7085e12a83'),(176564,2607,'news_title','Project updates'),(176565,2607,'_news_title','field_5de78da3aabb9'),(176566,2607,'sec_2_text_copy',''),(176567,2607,'_sec_2_text_copy','field_5de78dc89e613'),(176568,2607,'timeline-title','Timeline'),(176569,2607,'_timeline-title','field_5de78df29e615'),(176570,2607,'timeline_title','Timeline'),(176571,2607,'_timeline_title','field_5de78df29e615'),(176572,2607,'contact_title','Contact us'),(176573,2607,'_contact_title','field_5de7981e06057'),(176574,2607,'contact_intro','Contact text...'),(176575,2607,'_contact_intro','field_5de7983506058'),(176576,2607,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(176577,2607,'_news_button','field_5de8329896e02'),(176578,2607,'timeline_intro','Introduction of timeline detail...'),(176579,2607,'_timeline_intro','field_5de98f5fb1781'),(176580,2607,'timeline_pic','477'),(176581,2607,'_timeline_pic','field_5de98f72b1782'),(176582,2607,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(176583,2607,'_timeline_button','field_5de99363677f8'),(176584,2607,'banner_image_position','center'),(176585,2607,'_banner_image_position','field_5f3bc4757dd02'),(176586,2607,'services_title','Our services'),(176587,2607,'_services_title','field_5f20f3cd80eb2'),(176588,2607,'services_items_0_services_item_image','1061'),(176589,2607,'_services_items_0_services_item_image','field_5f2121355be14'),(176590,2607,'services_items_0_sservices_item_title','1300 Telephone counselling line'),(176591,2607,'_services_items_0_sservices_item_title','field_605089efca82e'),(176592,2607,'services_items_0_services_item_text',''),(176593,2607,'_services_items_0_services_item_text','field_5f2121535be15'),(176594,2607,'services_items_0_services_link_url','#'),(176595,2607,'_services_items_0_services_link_url','field_6050866041225'),(176596,2607,'services_items_0_services_link_text','Find out more'),(176597,2607,'_services_items_0_services_link_text','field_6050866d41226'),(176598,2607,'se