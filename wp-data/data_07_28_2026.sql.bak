,(54122,1704,'support_right_button','<a class=\"btn btn-blue\" href=\"#\">Read more</a>'),(54123,1704,'_support_right_button','field_5b67c6dd8c066'),(54124,1704,'first_image_title','Lifestart is about supporting young children'),(54125,1704,'_first_image_title','field_5b67ca606afc4'),(54126,1704,'first_image_cont','from 0-24 years living with disabilities and their familes'),(54127,1704,'_first_image_cont','field_5b67caff6afc5'),(54128,1704,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(54129,1704,'_first_image_button','field_5b67cb0d6afc6'),(54130,1704,'second _image_title','Lifestart is about supporting young children'),(54131,1704,'_second _image_title','field_5b67cb20ddf9a'),(54132,1704,'second_image_cont','from 0-24 years living with disabilities and their familes'),(54133,1704,'_second_image_cont','field_5b67cb24ddf9b'),(54134,1704,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(54135,1704,'_second_image_button','field_5b67cb29ddf9c'),(54136,1704,'second_image_title','Lifestart is about supporting young children'),(54137,1704,'_second_image_title','field_5b67cb20ddf9a'),(54138,1704,'page_col_image','412'),(54139,1704,'_page_col_image','field_5de6546e7c63a'),(54140,1704,'page_col_image_3','437'),(54141,1704,'_page_col_image_3','field_5de6e3998e07e'),(54142,1704,'sec_2_title','Community'),(54143,1704,'_sec_2_title','field_5de6e3ef2798f'),(54144,1704,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(54145,1704,'_sec_2_text','field_5de78dc89e613'),(54146,1704,'sec_3_title','The Project'),(54147,1704,'_sec_3_title','field_5de6e3d37d8da'),(54148,1704,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(54149,1704,'_sec_3_text','field_5de6e4044e5e8'),(54150,1704,'page_col_image_2','436'),(54151,1704,'_page_col_image_2','field_5de6546e7c63a'),(54152,1704,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(54153,1704,'_sec_2_button','field_5de6e58c86706'),(54154,1704,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(54155,1704,'_sec_3_button','field_5de6e5a243c03'),(54156,1704,'page_col_image_4','455'),(54157,1704,'_page_col_image_4','field_5de70801090ce'),(54158,1704,'sec_4_title','Location'),(54159,1704,'_sec_4_title','field_5de7082a12a81'),(54160,1704,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(54161,1704,'_sec_4_text','field_5de7084812a82'),(54162,1704,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(54163,1704,'_sec_4_button','field_5de7085e12a83'),(54164,1704,'news_title','Project updates'),(54165,1704,'_news_title','field_5de78da3aabb9'),(54166,1704,'sec_2_text_copy',''),(54167,1704,'_sec_2_text_copy','field_5de78dc89e613'),(54168,1704,'timeline-title','Timeline'),(54169,1704,'_timeline-title','field_5de78df29e615'),(54170,1704,'timeline_title','Timeline'),(54171,1704,'_timeline_title','field_5de78df29e615'),(54172,1704,'contact_title','Contact us'),(54173,1704,'_contact_title','field_5de7981e06057'),(54174,1704,'contact_intro','Contact text...'),(54175,1704,'_contact_intro','field_5de7983506058