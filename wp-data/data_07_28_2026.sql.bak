4fd8361d90ac'),(179656,2654,'signup_head','Join the campaign'),(179657,2654,'_signup_head','field_64fd83dc6b0b1'),(179658,2654,'boxes_section_title','Boxes'),(179659,2654,'_boxes_section_title','field_65262bbfd17fc'),(179660,2654,'intro_boxes_0_box_icon','1943'),(179661,2654,'_intro_boxes_0_box_icon','field_65262db5d36ee'),(179662,2654,'intro_boxes_0_box_title','Events'),(179663,2654,'_intro_boxes_0_box_title','field_65262d29ed8e3'),(179664,2654,'intro_boxes_0_box_dropdown','Our rigorous, conflict-free research and data analysis lifts the lid on fund performance, fees and insurance. Drawing on our policy expertise, we turn this analysis into action by using it to back reform and make super easier for people to understand. <a href=\"//localhost:4000:4000:4000:4000:4000:4000:/how/\">More</a>'),(179665,2654,'_intro_boxes_0_box_dropdown','field_65262dead0a0c'),(179666,2654,'intro_boxes_1_box_icon','1941'),(179667,2654,'_intro_boxes_1_box_icon','field_65262db5d36ee'),(179668,2654,'intro_boxes_1_box_title','Projects'),(179669,2654,'_intro_boxes_1_box_title','field_65262d29ed8e3'),(179670,2654,'intro_boxes_1_box_dropdown','Our rigorous, conflict-free research and data analysis lifts the lid on fund performance, fees and insurance. Drawing on our policy expertise, we turn this analysis into action by using it to back reform and make super easier for people to understand. <a href=\"//localhost:4000:4000:4000:4000:4000:4000:/how/\">More</a>'),(179671,2654,'_intro_boxes_1_box_dropdown','field_65262dead0a0c'),(179672,2654,'intro_boxes_2_box_icon','1937'),(179673,2654,'_intro_boxes_2_box_icon','field_65262db5d36ee'),(179674,2654,'intro_boxes_2_box_title','Ideas'),(179675,2654,'_intro_boxes_2_box_title','field_65262d29ed8e3'),(179676,2654,'intro_boxes_2_box_dropdown','Our rigorous, conflict-free research and data analysis lifts the lid on fund performance, fees and insurance. Drawing on our policy expertise, we turn this analysis into action by using it to back reform and make super easier for people to understand. <a href=\"//localhost:4000:4000:4000:4000:4000:4000:/how/\">More</a>'),(179677,2654,'_intro_boxes_2_box_dropdown','field_65262dead0a0c'),(179678,2654,'intro_boxes','3'),(179679,2654,'_intro_boxes','field_65262d14ed8e2'),(179680,2654,'get_help_section_title','Get Help'),(179681,2654,'_get_help_section_title','field_65262c35143de'),(179682,2654,'get_help_block_home',''),(179683,2654,'_get_help_block_home','field_65262c8a143e1'),(179684,2654,'gh_block_home_0_help_image','1956'),(179685,2654,'_gh_block_home_0_help_image','field_65262cd0143e2'),(179686,2654,'gh_block_home_0_help_title','How much do I need to retire? '),(179687,2654,'_gh_block_home_0_help_title','field_65262cec143e3'),(179688,2654,'gh_block_home_0_help_url','#'),(179689,2654,'_gh_block_home_0_help_url','field_65262cf4143e4'),(179690,2654,'gh_block_home_1_help_image','1962'),(179691,2654,'_gh_block_home_1_help_image','field_65262cd0143e2'),(179692,2654,'gh_block_home_1_help_title','I have a problem with  my super fund'),(179693,2654,'_gh_block_home_1_help_title','field_65262cec143e3'),(179694,2654,'gh_block_home_1_help_url','#'),(179695,2654,'_gh_block_home_1_help_url','field_65262cf4143e4'),(179696,2654,'gh_block_home_2_help_image','1961'),(179697,2654,'_gh_block_home_2_help_image','field_65262cd0143e2'),(179698,2654,'gh_block_home_2_help_title','How do I choose the right super? '),(179699,2654,'_gh_block_home_2_help_title','field_65262cec143e3'),(179700,2654,'gh_block_home_2_help_url','#'),(179701,2654,'_gh_block_home_2_help_url','field_65262cf4143e4'),(179702,2654,'gh_block_home','3'),(179703,2654,'_gh_block_home','field_65262c8a143e1'),(179704,2654,'turn_on_insights',''),(179705,2654,'_turn_on_insights','field_645c4a2e654a6'),(179706,2654,'report_questions','a:3:{i:0;s:2:\"59\";i:1;s:2:\"61\";i:2;s:4:\"2587\";}'),(179707,2654,'_report_questions','field_6109ed5e02e5a'),(179708,2654,'intro_text','The Disability Dialogue is a place where people with disabilities, their families, organisations providing support, academics, and the wider community come together to work on things that matter to us.\r\n\r\nThe Dialogue is a hub of knowledge and collaboration, separate from government, where we work together to come up. With new ideas on important topics. Our ideas can make a big difference in how services and systems are set up for people with disabilities.'),(179709,2654,'_intro_text','field_66441acfe963c'),(179710,2654,'word_link','#'),(179711,2654,'_word_link','field_6646c69723804'),(179712,2654,'pdf_link','#'),(179713,2654,'_pdf_link','field_6646c6da23805'),(179714,2654,'intro_boxes_0_box_image','2241'),(179715,2654,'_intro_boxes_0_box_image','field_65262db5d36ee'),(179716,2654,'intro_boxes_1_box_image','2179'),(179717,2654,'_intro_boxes_1_box_image','field_65262db5d36ee'),(179718,2654,'intro_boxes_2_box_image','2012'),(179719,2654,'_intro_boxes_2_box_image','field_65262db5d36ee'),(179720,2654,'intro_boxes_0_box_excerpt','Excerpt text here just a sentance or so and no more.'),(179721,2654,'_intro_boxes_0_box_excerpt','field_665975273e827'),(179722,2654,'intro_boxes_1_box_excerpt','Excerpt text here just a sentance or so and no more.'),(179723,2654,'_intro_boxes_1_box_excerpt','field_665975273e827'),(179724,2654,'intro_boxes_2_box_excerpt','Excerpt text here just a sentance or so and no more.'),(179725,2654,'_intro_boxes_2_box_excerpt','field_665975273e827'),(179726,2654,'intro_boxes_0_btn-text','Latest events'),(179727,2654,'_intro_boxes_0_btn-text','field_665abda8b8d4b'),(179728,2654,'intro_boxes_1_btn-text','Latest projects'),(179729,2654,'_intro_boxes_1_btn-text','field_665abda8b8d4b'),(179730,2654,'intro_boxes_2_btn-text','Latest ideas'),(179731,2654,'_intro_boxes_2_btn-text','field_665abda8b8d4b'),(179732,2654,'display-easy-read',''),(179733,2654,'_display-easy-read','field_666129bd2da00'),(179734,2654,'hm_hero_sum','Statement about the issue and lost life savings'),(179735,2654,'_hm_hero_sum','field_64ed37241effa'),(179736,2654,'hm_hero_sub',''),(179737,2654,'_hm_hero_sub','field_64ed37241effa'),(179738,2654,'intro_head','We’re here to help.'),(179739,2654,'_intro_head','field_64e828783ad9f'),(179740,2654,'intro_content','About 12,000 people invested their hard-earned super savings in two investment funds which have now collapsed, called Shield Master Fund and First Guardian Master Fund. Most people will be entitled to get some money back, but you need to take action soon. This website has information and tools to help you understand what happened, where to get help and how to take back your super.'),(179741,2654,'_intro_content','field_66441acfe963c'),(179742,2654,'deadline_heading','Important deadlines'),(179743,2654,'_deadline_heading','field_69365ff82e6f2'),(179744,2654,'deadline_content','You need to take action before the deadline to take your super back.'),(179745,2654,'_deadline_content','field_693660342e6f3'),(179746,2654,'deadline_button_text','Find out more'),(179747,2654,'_deadline_button_text','field_693660482e6f4'),(179748,2654,'deadline_button_url','/key-deadlines/'),(179749,2654,'_deadline_button_url','field_693660912e6f5'),(179750,2654,'what_head','What happened?'),(179751,2654,'_what_head','field_69366611096ac'),(179752,2654,'what_happened_0_happ_sub','What are Shield and First Guardian?'),(179753,2654,'_what_happened_0_happ_sub','field_693d4a8b4197d'),(179754,2654,'what_happened_0_happ_content','About 12,000 people invested their hard-earned super savings in two investment funds called Shield Master Fund and First Guardian Master Fund. Those funds have collapsed, and a large part of the $1.2 billion people invested is gone.\r\n\r\nMost people invested through financial advisers who contacted them after they clicked on a social media ad offering a free super comparison or review.'),(179755,2654,'_what_happened_0_happ_content','field_693d4aa84197e'),(179756,2654,'what_happened_0_happ_url','/what-happened/'),(179757,2654,'_what_happened_0_happ_url','field_693d4aba4197f'),(179758,2654,'what_happened_0_happ_link_text','More'),(179759,2654,'_what_happened_0_happ_link_text','field_693d4ad641980'),(179760,2654,'what_happened_1_happ_sub','What is being done about this?'),(179761,2654,'_what_happened_1_happ_sub','field_693d4a8b4197d'),(179762,2654,'what_happened_1_happ_content','There is a lot of work being done to try to get money back for people who invested.\r\n\r\nThe regulator is also investigating what happened and has started enforcement action against a number of different people and companies for their involvement in the collapses of Shield and First Guardian Master Funds. Learn about the progress of this work'),(179763,2654,'_what_happened_1_happ_content','field_693d4aa84197e'),(179764,2654,'what_happened_1_happ_url','/what-happened/'),(179765,2654,'_what_happened_1_happ_url','field_693d4aba4197f'),(179766,2654,'what_happened_1_happ_link_text','More'),(179767,2654,'_what_happened_1_happ_link_text','field_693d4ad641980'),(179768,2654,'what_happened','2'),(179769,2654,'_what_happened','field_693d4a6f4197c'),(179770,2654,'what_happened_0_happ_icon','2605'),(179771,2654,'_what_happened_0_happ_icon','field_693d4c9b3ec4d'),(179772,2654,'what_happened_1_happ_icon','2604'),(179773,2654,'_what_happened_1_happ_icon','field_693d4c9b3ec4d'),(179774,2150,'_wpa_old_event','a:2:{i:0;O:8:\"stdClass\":3:{s:1:\"0\";s:9:\"skiplinks\";s:1:\"1\";a:2:{i:0;s:14:\"control-titles\";i:1;s:1:\"1\";}s:9:\"timestamp\";s:0:\"\";}i:1;O:8:\"stdClass\":5:{s:1:\"0\";s:9:\"skiplinks\";s:1:\"1\";a:2:{i:0;s:14:\"control-titles\";i:1;s:1:\"1\";}s:1:\"2\";a:2:{i:0;s:12:\"link-targets\";i:1;s:1:\"8\";}s:1:\"3\";a:2:{i:0;s:16:\"control-tabindex\";i:1;s:1:\"3\";}s:9:\"timestamp\";s:0:\"\";}}'),(179775,2150,'_wpa_event','{\"0\":\"skiplinks\",\"1\":[\"control-titles\",\"1\"],\"timestamp\":1765850127}'),(179776,2146,'_wpa_old_event','a:2:{i:0;O:8:\"stdClass\":5:{s:1:\"0\";s:9:\"skiplinks\";s:1:\"1\";a:2:{i:0;s:14:\"control-titles\";i:1;s:1:\"1\";}s:1:\"2\";a:2:{i:0;s:12: