ome','field_65262c8a143e1'),(132321,2246,'turn_on_insights',''),(132322,2246,'_turn_on_insights','field_645c4a2e654a6'),(132323,2246,'report_questions','a:3:{i:0;s:4:\"1997\";i:1;s:4:\"2067\";i:2;s:4:\"2089\";}'),(132324,2246,'_report_questions','field_6109ed5e02e5a'),(132325,2246,'intro_text','The Disability Dialogue is a place where people with disabilities, their families, organisations providing support, academics, and the wider community come together to work on things that matter to us.\r\n\r\nThe Dialogue is a hub of knowledge and collaboration, separate from government, where we work together to come up. With new ideas on important topics. Our ideas can make a big difference in how services and systems are set up for people with disabilities.'),(132326,2246,'_intro_text','field_66441acfe963c'),(132327,2246,'word_link','#'),(132328,2246,'_word_link','field_6646c69723804'),(132329,2246,'pdf_link','#'),(132330,2246,'_pdf_link','field_6646c6da23805'),(132331,2246,'intro_boxes_0_box_image','2241'),(132332,2246,'_intro_boxes_0_box_image','field_65262db5d36ee'),(132333,2246,'intro_boxes_1_box_image','2179'),(132334,2246,'_intro_boxes_1_box_image','field_65262db5d36ee'),(132335,2246,'intro_boxes_2_box_image','2012'),(132336,2246,'_intro_boxes_2_box_image','field_65262db5d36ee'),(132337,2246,'intro_boxes_0_box_excerpt','Excerpt text here just a sentamve or so and no more.'),(132338,2246,'_intro_boxes_0_box_excerpt','field_665975273e827'),(132339,2246,'intro_boxes_1_box_excerpt',''),(132340,2246,'_intro_boxes_1_box_excerpt','field_665975273e827'),(132341,2246,'intro_boxes_2_box_excerpt',''),(132342,2246,'_intro_boxes_2_box_excerpt','field_665975273e827'),(132343,2247,'_wpa_browser','{\"name\":\"Firefox\",\"version\":\"126.0\",\"platform\":\"Macintosh\",\"update_url\":\"https://www.mozilla.org/firefox/\",\"img_src\":\"http://s.w.org/images/browsers/firefox.png?1\",\"img_src_ssl\":\"https://s.w.org/images/browsers/firefox.png?1\",\"current_version\":\"56\",\"upgrade\":f