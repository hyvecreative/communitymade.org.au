_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut.'),(30427,1308,'_support_right_cont','field_5b67c6c98c065'),(30428,1308,'support_right_button','<a class=\"btn btn-blue\" href=\"#\">Read more</a>'),(30429,1308,'_support_right_button','field_5b67c6dd8c066'),(30430,1308,'first_image_title','Lifestart is about supporting young children'),(30431,1308,'_first_image_title','field_5b67ca606afc4'),(30432,1308,'first_image_cont','from 0-24 years living with disabilities and their familes'),(30433,1308,'_first_image_cont','field_5b67caff6afc5'),(30434,1308,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(30435,1308,'_first_image_button','field_5b67cb0d6afc6'),(30436,1308,'second _image_title','Lifestart is about supporting young children'),(30437,1308,'_second _image_title','field_5b67cb20ddf9a'),(30438,1308,'second_image_cont','from 0-24 years living with disabilities and their familes'),(30439,1308,'_second_image_cont','field_5b67cb24ddf9b'),(30440,1308,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(30441,1308,'_second_image_button','field_5b67cb29ddf9c'),(30442,1308,'second_image_title','Lifestart is about supporting young children'),(30443,1308,'_second_image_title','field_5b67cb20ddf9a'),(30444,1308,'page_col_image','412'),(30445,1308,'_page_col_image','field_5de6546e7c63a'),(30446,1308,'page_col_image_3','437'),(30447,1308,'_page_col_image_3','field_5de6e3998e07e'),(30448,1308,'sec_2_title','Community'),(30449,1308,'_sec_2_title','field_5de6e3ef2798f'),(30450,1308,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(30451,1308,'_sec_2_text','field_5de78dc89e613'),(30452,1308,'sec_3_title','The Project'),(30453,1308,'_sec_3_title','field_5de6e3d37d8da'),(30454,1308,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(30455,1308,'_sec_3_text','field_5de6e4044e5e8'),(30456,1308,'page_col_image_2','436'),(30457,1308,'_page_col_image_2','field_5de6546e7c63a'),(30458,1308,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(30459,1308,'_sec_2_button','field_5de6e58c86706'),(30460,1308,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(30461,1308,'_sec_3_button','field_5de6e5a243c03'),(30462,1308,'page_col_image_4','455'),(30463,1308,'_page_col_image_4','field_5de70801090ce'),(30464,1308,'sec_4_title','Location'),(30465,1308,'_sec_4_title','field_5de7082a12a81'),(30466,1308,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(30467,1308,'_sec_4_text','field_5de7084812a82'),(30468,1308,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(30469,1308,'_sec_4_button','field_5de7085e12a83'),(30470,1308,'news_title','Project updates'),(30471,1308,'_news_title','field_5de78da3aabb9'),(30472,1308,'sec_2_text_copy',''),(30473,1308,'_sec_2_text_copy','field_5de78dc89e613'),(30474,1308,'timeline-title','Timeline'),(30475,1308,'_timeline-title','field_5de78df29e615'),(30476,1308,'timeline_title','Timeline'),(30477,1308,'_timeline_title','field_5de78df29e615'),(30478,1308,'contact_t