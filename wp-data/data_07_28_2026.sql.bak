ont','field_5b67cb24ddf9b'),(37306,1523,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(37307,1523,'_second_image_button','field_5b67cb29ddf9c'),(37308,1523,'second_image_title','Lifestart is about supporting young children'),(37309,1523,'_second_image_title','field_5b67cb20ddf9a'),(37310,1523,'page_col_image','412'),(37311,1523,'_page_col_image','field_5de6546e7c63a'),(37312,1523,'page_col_image_3','437'),(37313,1523,'_page_col_image_3','field_5de6e3998e07e'),(37314,1523,'sec_2_title','Community'),(37315,1523,'_sec_2_title','field_5de6e3ef2798f'),(37316,1523,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(37317,1523,'_sec_2_text','field_5de78dc89e613'),(37318,1523,'sec_3_title','The Project'),(37319,1523,'_sec_3_title','field_5de6e3d37d8da'),(37320,1523,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(37321,1523,'_sec_3_text','field_5de6e4044e5e8'),(37322,1523,'page_col_image_2','436'),(37323,1523,'_page_col_image_2','field_5de6546e7c63a'),(37324,1523,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(37325,1523,'_sec_2_button','field_5de6e58c86706'),(37326,1523,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(37327,1523,'_sec_3_button','field_5de6e5a243c03'),(37328,1523,'page_col_image_4','455'),(37329,1523,'_page_col_image_4','field_5de70801090ce'),(37330,1523,'sec_4_title','Location'),(37331,1523,'_sec_4_title','field_5de7082a12a81'),(37332,1523,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(37333,1523,'_sec_4_text','field_5de7084812a82'),(37334,1523,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(37335,1523,'_sec_4_button','field_5de7085e12a83'),(37336,1523,'news_title','Project updates'),(37337,1523,'_news_title','field_5de78da3aabb9'),(37338,1523,'sec_2_text_copy',''),(37339,1523,'_sec_2_text_copy','field_5de78dc89e613'),(37340,1523,'timeline-title','Timeline'),(37341,1523,'_timeline-title','field_5de78df29e615'),(37342,1523,'timeline_title','Timeline'),(37343,1523,'_timeline_title','field_5de78df29e615'),(37344,1523,'contact_title','Contact us'),(37345,1523,'_contact_title','field_5de7981e06057'),(37346,1523,'contact_intro','Contact text...'),(37347,1523,'_contact_intro','field_5de7983506058'),(37348,1523,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(37349,1523,'_news_button','field_5de8329896e02'),(37350,1523,'timeline_intro','Introduction of timeline detail...'),(37351,1523,'_timeline_intro','field_5de98f5fb1781'),(37352,1523,'timeline_pic','477'),(37353,1523,'_timeline_pic','field_5de98f72b1782'),(37354,1523,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(37355,1523,'_timeline_button','field_5de99363677f8'),(37356,1523,'banner_image_position','center'),(37357,1523,'_banner_image_position','field_5f3bc4757dd02'),(37358,1523,'services_title','Our services'),(37359,1523,'_services_title','field_5f20f3cd80eb2'),(37360,1523,'services_items_0_services_item_image','1061'),(37361,1523,'_services_items_0_services_item_i