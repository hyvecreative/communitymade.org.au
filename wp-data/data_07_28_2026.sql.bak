5b67cb24ddf9b'),(182556,2677,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(182557,2677,'_second_image_button','field_5b67cb29ddf9c'),(182558,2677,'second_image_title','Lifestart is about supporting young children'),(182559,2677,'_second_image_title','field_5b67cb20ddf9a'),(182560,2677,'page_col_image','412'),(182561,2677,'_page_col_image','field_5de6546e7c63a'),(182562,2677,'page_col_image_3','437'),(182563,2677,'_page_col_image_3','field_5de6e3998e07e'),(182564,2677,'sec_2_title','Community'),(182565,2677,'_sec_2_title','field_5de6e3ef2798f'),(182566,2677,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(182567,2677,'_sec_2_text','field_5de78dc89e613'),(182568,2677,'sec_3_title','The Project'),(182569,2677,'_sec_3_title','field_5de6e3d37d8da'),(182570,2677,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(182571,2677,'_sec_3_text','field_5de6e4044e5e8'),(182572,2677,'page_col_image_2','436'),(182573,2677,'_page_col_image_2','field_5de6546e7c63a'),(182574,2677,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(182575,2677,'_sec_2_button','field_5de6e58c86706'),(182576,2677,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(182577,2677,'_sec_3_button','field_5de6e5a243c03'),(182578,2677,'page_col_image_4','455'),(182579,2677,'_page_col_image_4','field_5de70801090ce'),(182580,2677,'sec_4_title','Location'),(182581,2677,'_sec_4_title','field_5de7082a12a81'),(182582,2677,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(182583,2677,'_sec_4_text','field_5de7084812a82'),(182584,2677,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(182585,2677,'_sec_4_button','field_5de7085e12a83'),(182586,2677,'news_title','Project updates'),(182587,2677,'_news_title','field_5de78da3aabb9'),(182588,2677,'sec_2_text_copy',''),(182589,2677,'_sec_2_text_copy','field_5de78dc89e613'),(182590,2677,'timeline-title','Timeline'),(182591,2677,'_timeline-title','field_5de78df29e615'),(182592,2677,'timeline_title','Timeline'),(182593,2677,'_timeline_title','field_5de78df29e615'),(182594,2677,'contact_title','Contact us'),(182595,2677,'_contact_title','field_5de7981e06057'),(182596,2677,'contact_intro','Contact text...'),(182597,2677,'_contact_intro','field_5de7983506058'),(182598,2677,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(182599,2677,'_news_button','field_5de8329896e02'),(182600,2677,'timeline_intro','Introduction of timeline detail...'),(182601,2677,'_timeline_intro','field_5de98f5fb1781'),(182602,2677,'timeline_pic','477'),(182603,2677,'_timeline_pic','field_5de98f72b1782'),(182604,2677,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(182605,2677,'_timeline_button','field_5de99363677f8'),(182606,2677,'banner_image_position','center'),(182607,2677,'_banner_image_position','field_5f3bc4757dd02'),(182608,2677,'services_title','Our services'),(182609,2677,'_services_title','field_5f20f3cd80eb2'),(182610,2677,'services_items_0_services_item_image','1061'),(18