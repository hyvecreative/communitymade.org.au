64'),(53064,1702,'support_right_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut.'),(53065,1702,'_support_right_cont','field_5b67c6c98c065'),(53066,1702,'support_right_button','<a class=\"btn btn-blue\" href=\"#\">Read more</a>'),(53067,1702,'_support_right_button','field_5b67c6dd8c066'),(53068,1702,'first_image_title','Lifestart is about supporting young children'),(53069,1702,'_first_image_title','field_5b67ca606afc4'),(53070,1702,'first_image_cont','from 0-24 years living with disabilities and their familes'),(53071,1702,'_first_image_cont','field_5b67caff6afc5'),(53072,1702,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(53073,1702,'_first_image_button','field_5b67cb0d6afc6'),(53074,1702,'second _image_title','Lifestart is about supporting young children'),(53075,1702,'_second _image_title','field_5b67cb20ddf9a'),(53076,1702,'second_image_cont','from 0-24 years living with disabilities and their familes'),(53077,1702,'_second_image_cont','field_5b67cb24ddf9b'),(53078,1702,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(53079,1702,'_second_image_button','field_5b67cb29ddf9c'),(53080,1702,'second_image_title','Lifestart is about supporting young children'),(53081,1702,'_second_image_title','field_5b67cb20ddf9a'),(53082,1702,'page_col_image','412'),(53083,1702,'_page_col_image','field_5de6546e7c63a'),(53084,1702,'page_col_image_3','437'),(53085,1702,'_page_col_image_3','field_5de6e3998e07e'),(53086,1702,'sec_2_title','Community'),(53087,1702,'_sec_2_title','field_5de6e3ef2798f'),(53088,1702,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(53089,1702,'_sec_2_text','field_5de78dc89e613'),(53090,1702,'sec_3_title','The Project'),(53091,1702,'_sec_3_title','field_5de6e3d37d8da'),(53092,1702,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(53093,1702,'_sec_3_text','field_5de6e4044e5e8'),(53094,1702,'page_col_image_2','436'),(53095,1702,'_page_col_image_2','field_5de6546e7c63a'),(53096,1702,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(53097,1702,'_sec_2_button','field_5de6e58c86706'),(53098,1702,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(53099,1702,'_sec_3_button','field_5de6e5a243c03'),(53100,1702,'page_col_image_4','455'),(53101,1702,'_page_col_image_4','field_5de70801090ce'),(53102,1702,'sec_4_title','Location'),(53103,1702,'_sec_4_title','field_5de7082a12a81'),(53104,1702,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(53105,1702,'_sec_4_text','field_5de7084812a82'),(53106,1702,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(53107,1702,'_sec_4_button','field_5de7085e12a83'),(53108,1702,'news_title','Project updates'),(53109,1702,'_news_title','field_5de78da3aabb9'),(53110,1702,'sec_2_text_copy',''),(53111,1702,'_sec_2_text_copy','field_5de78dc89e613'),(53112,1702,'timeline-title','Timeline'),(53113,1702,'_timeline-title','field_5de78df29e615'),(53114,1702,'timeline_title','Timeline'),(53115,1702,'_timeline_title','field_5de78df