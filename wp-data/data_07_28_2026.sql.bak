ox_title','Events'),(156629,2469,'_intro_boxes_0_box_title','field_65262d29ed8e3'),(156630,2469,'intro_boxes_0_box_dropdown','Our rigorous, conflict-free research and data analysis lifts the lid on fund performance, fees and insurance. Drawing on our policy expertise, we turn this analysis into action by using it to back reform and make super easier for people to understand. <a href=\"//localhost:4000:4000:4000:4000:4000:4000:/how/\">More</a>'),(156631,2469,'_intro_boxes_0_box_dropdown','field_65262dead0a0c'),(156632,2469,'intro_boxes_1_box_icon','1941'),(156633,2469,'_intro_boxes_1_box_icon','field_65262db5d36ee'),(156634,2469,'intro_boxes_1_box_title','Projects'),(156635,2469,'_intro_boxes_1_box_title','field_65262d29ed8e3'),(156636,2469,'intro_boxes_1_box_dropdown','Our rigorous, conflict-free research and data analysis lifts the lid on fund performance, fees and insurance. Drawing on our policy expertise, we turn this analysis into action by using it to back reform and make super easier for people to understand. <a href=\"//localhost:4000:4000:4000:4000:4000:4000:/how/\">More</a>'),(156637,2469,'_intro_boxes_1_box_dropdown','field_65262dead0a0c'),(156638,2469,'intro_boxes_2_box_icon','1937'),(156639,2469,'_intro_boxes_2_box_icon','field_65262db5d36ee'),(156640,2469,'intro_boxes_2_box_title','Ideas'),(156641,2469,'_intro_boxes_2_box_title','field_65262d29ed8e3'),(156642,2469,'intro_boxes_2_box_dropdown','Our rigorous, conflict-free research and data analysis lifts the lid on fund performance, fees and insurance. Drawing on our policy expertise, we turn this analysis into action by using it to back reform and make super easier for people to understand. <a href=\"//localhost:4000:4000:4000:4000:4000:4000:/how/\">More</a>'),(156643,2469,'_intro_boxes_2_box_dropdown','field_65262dead0a0c'),(156644,2469,'intro_boxes','3'),(156645,2469,'_intro_boxes','field_65262d14ed8e2'),(156646,2469,'get_help_section_title','Get Help'),(156647,2469,'_get_help_section_title','field_6