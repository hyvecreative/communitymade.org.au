449,1647,'_support_right_cont','field_5b67c6c98c065'),(50450,1647,'support_right_button','<a class=\"btn btn-blue\" href=\"#\">Read more</a>'),(50451,1647,'_support_right_button','field_5b67c6dd8c066'),(50452,1647,'first_image_title','Lifestart is about supporting young children'),(50453,1647,'_first_image_title','field_5b67ca606afc4'),(50454,1647,'first_image_cont','from 0-24 years living with disabilities and their familes'),(50455,1647,'_first_image_cont','field_5b67caff6afc5'),(50456,1647,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(50457,1647,'_first_image_button','field_5b67cb0d6afc6'),(50458,1647,'second _image_title','Lifestart is about supporting young children'),(50459,1647,'_second _image_title','field_5b67cb20ddf9a'),(50460,1647,'second_image_cont','from 0-24 years living with disabilities and their familes'),(50461,1647,'_second_image_cont','field_5b67cb24ddf9b'),(50462,1647,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(50463,1647,'_second_image_button','field_5b67cb29ddf9c'),(50464,1647,'second_image_title','Lifestart is about supporting young children'),(50465,1647,'_second_image_title','field_5b67cb20ddf9a'),(50466,1647,'page_col_image','412'),(50467,1647,'_page_col_image','field_5de6546e7c63a'),(50468,1647,'page_col_image_3','437'),(50469,1647,'_page_col_image_3','field_5de6e3998e07e'),(50470,1647,'sec_2_title','Community'),(50471,1647,'_sec_2_title','field_5de6e3ef2798f'),(50472,1647,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(50473,1647,'_sec_2_text','field_5de78dc89e613'),(50474,1647,'sec_3_title','The Project'),(50475,1647,'_sec_3_title','field_5de6e3d37d8da'),(50476,1647,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(50477,1647,'_sec_3_text','field_5de6e4044e5e8'),(50478,1647,'page_col_image_2','436'),(50479,1647,'_page_col_image_2','field_5de6546e7c63a'),(50480,1647,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(50481,1647,'_sec_2_button','field_5de6e58c86706'),(50482,1647,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(50483,1647,'_sec_3_button','field_5de6e5a243c03'),(50484,1647,'page_col_image_4','455'),(50485,1647,'_page_col_image_4','field_5de70801090ce'),(50486,1647,'sec_4_title','Location'),(50487,1647,'_sec_4_title','field_5de7082a12a81'),(50488,1647,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(50489,1647,'_sec_4_text','field_5de7084812a82'),(50490,1647,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(50491,1647,'_sec_4_button','field_5de7085e12a83'),(50492,1647,'news_title','Project updates'),(50493,1647,'_news_title','field_5de78da3aabb9'),(50494,1647,'sec_2_text_copy',''),(50495,1647,'_sec_2_text_copy','field_5de78dc89e613'),(50496,1647,'timeline-title','Timeline'),(50497,1647,'_timeline-title','field_5de78df29e615'),(50498,1647,'timeline_title','Timeline'),(50499,1647,'_timeline_title','field_5de78df29e615'),(50500,1647,'contact_title','Contact us'),(50501,1647,'_contact_title','field_5de7981e06057'),(50502,1647,'contact_intro','Contact text..