ld_5b67cb0d6afc6'),(207491,2762,'second _image_title','Lifestart is about supporting young children'),(207492,2762,'_second _image_title','field_5b67cb20ddf9a'),(207493,2762,'second_image_cont','from 0-24 years living with disabilities and their familes'),(207494,2762,'_second_image_cont','field_5b67cb24ddf9b'),(207495,2762,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(207496,2762,'_second_image_button','field_5b67cb29ddf9c'),(207497,2762,'second_image_title','Lifestart is about supporting young children'),(207498,2762,'_second_image_title','field_5b67cb20ddf9a'),(207499,2762,'page_col_image','412'),(207500,2762,'_page_col_image','field_5de6546e7c63a'),(207501,2762,'page_col_image_3','437'),(207502,2762,'_page_col_image_3','field_5de6e3998e07e'),(207503,2762,'sec_2_title','Community'),(207504,2762,'_sec_2_title','field_5de6e3ef2798f'),(207505,2762,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(207506,2762,'_sec_2_text','field_5de78dc89e613'),(207507,2762,'sec_3_title','The Project'),(207508,2762,'_sec_3_title','field_5de6e3d37d8da'),(207509,2762,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(207510,2762,'_sec_3_text','field_5de6e4044e5e8'),(207511,2762,'page_col_image_2','436'),(207512,2762,'_page_col_image_2','field_5de6546e7c63a'),(207513,2762,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(207514,2762,'_sec_2_button','field_5de6e58c86706'),(207515,2762,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(207516,2762,'_sec_3_button','field_5de6e5a243c03'),(207517,2762,'page_col_image_4','455'),(207518,2762,'_page_col_image_4','field_5de70801090ce'),(207519,2762,'sec_4_title','Location'),(207520,2762,'_sec_4_title','field_5de7082a12a81'),(207521,2762,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(207522,2762,'_sec_4_text','field_5de7084812a82'),(207523,2762,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(207524,2762,'_sec_4_button','field_5de7085e12a83'),(207525,2762,'news_title','Project updates'),(207526,2762,'_news_title','field_5de78da3aabb9'),(207527,2762,'sec_2_text_copy',''),(207528,2762,'_sec_2_text_copy','field_5de78dc89e613'),(207529,2762,'timeline-title','Timeline'),(207530,2762,'_timeline-title','field_5de78df29e615'),(207531,2762,'timeline_title','Timeline'),(207532,2762,'_timeline_title','field_5de78df29e615'),(207533,2762,'contact_title','Contact us'),(207534,2762,'_contact_title','field_5de7981e06057'),(207535,2762,'contact_intro','Contact text...'),(207536,2762,'_contact_intro','field_5de7983506058'),(207537,2762,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(207538,2762,'_news_button','field_5de8329896e02'),(207539,2762,'timeline_intro','Introduction of timeline detail...'),(207540,2762,'_timeline_intro','field_5de98f5fb1781'),(207541,2762,'timeline_pic','477'),(207542,2762,'_timeline_pic','field_5de98f72b1782'),(207543,2762,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(207544,2762,'_timeline_butto