7c6dd8c066'),(105851,2008,'first_image_title','Lifestart is about supporting young children'),(105852,2008,'_first_image_title','field_5b67ca606afc4'),(105853,2008,'first_image_cont','from 0-24 years living with disabilities and their familes'),(105854,2008,'_first_image_cont','field_5b67caff6afc5'),(105855,2008,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(105856,2008,'_first_image_button','field_5b67cb0d6afc6'),(105857,2008,'second _image_title','Lifestart is about supporting young children'),(105858,2008,'_second _image_title','field_5b67cb20ddf9a'),(105859,2008,'second_image_cont','from 0-24 years living with disabilities and their familes'),(105860,2008,'_second_image_cont','field_5b67cb24ddf9b'),(105861,2008,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(105862,2008,'_second_image_button','field_5b67cb29ddf9c'),(105863,2008,'second_image_title','Lifestart is about supporting young children'),(105864,2008,'_second_image_title','field_5b67cb20ddf9a'),(105865,2008,'page_col_image','412'),(105866,2008,'_page_col_image','field_5de6546e7c63a'),(105867,2008,'page_col_image_3','437'),(105868,2008,'_page_col_image_3','field_5de6e3998e07e'),(105869,2008,'sec_2_title','Community'),(105870,2008,'_sec_2_title','field_5de6e3ef2798f'),(105871,2008,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(105872,2008,'_sec_2_text','field_5de78dc89e613'),(105873,2008,'sec_3_title','The Project'),(105874,2008,'_sec_3_title','field_5de6e3d37d8da'),(105875,2008,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(105876,2008,'_sec_3_text','field_5de6e4044e5e8'),(105877,2008,'page_col_image_2','436'),(105878,2008,'_page_col_image_2','field_5de6546e7c63a'),(105879,2008,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(105880,2008,'_sec_2_button','field_5de6e58c86706'),(105881,2008,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(105882,2008,'_sec_3_button','field_5de6e5a243c03'),(105883,2008,'page_col_image_4','455'),(105884,2008,'_page_col_image_4','field_5de70801090ce'),(105885,2008,'sec_4_title','Location'),(105886,2008,'_sec_4_title','field_5de7082a12a81'),(105887,2008,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(105888,2008,'_sec_4_text','field_5de7084812a82'),(105889,2008,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(105890,2008,'_sec_4_button','field_5de7085e12a83'),(105891,2008,'news_title','Project updates'),(105892,2008,'_news_title','field_5de78da3aabb9'),(105893,2008,'sec_2_text_copy',''),(105894,2008,'_sec_2_text_copy','field_5de78dc89e613'),(105895,2008,'timeline-title','Timeline'),(105896,2008,'_timeline-title','field_5de78df29e615'),(105897,2008,'timeline_title','Timeline'),(105898,2008,'_timeline_title','field_5de78df29e615'),(105899,2008,'contact_title','Contact us'),(105900,2008,'_contact_title','field_5de7981e06057'),(105901,2008,'contact_intro','Contact text...'),(105902,2008,'_contact_intro','field_5de7983506058'),(105903,2008,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\"