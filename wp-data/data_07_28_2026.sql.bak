de6546e7c63a'),(20269,1090,'page_col_image_3','437'),(20270,1090,'_page_col_image_3','field_5de6e3998e07e'),(20271,1090,'sec_2_title','Community'),(20272,1090,'_sec_2_title','field_5de6e3ef2798f'),(20273,1090,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(20274,1090,'_sec_2_text','field_5de78dc89e613'),(20275,1090,'sec_3_title','The Project'),(20276,1090,'_sec_3_title','field_5de6e3d37d8da'),(20277,1090,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(20278,1090,'_sec_3_text','field_5de6e4044e5e8'),(20279,1090,'page_col_image_2','436'),(20280,1090,'_page_col_image_2','field_5de6546e7c63a'),(20281,1090,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(20282,1090,'_sec_2_button','field_5de6e58c86706'),(20283,1090,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(20284,1090,'_sec_3_button','field_5de6e5a243c03'),(20285,1090,'page_col_image_4','455'),(20286,1090,'_page_col_image_4','field_5de70801090ce'),(20287,1090,'sec_4_title','Location'),(20288,1090,'_sec_4_title','field_5de7082a12a81'),(20289,1090,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(20290,1090,'_sec_4_text','field_5de7084812a82'),(20291,1090,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(20292,1090,'_sec_4_button','field_5de7085e12a83'),(20293,1090,'news_title','Project updates'),(20294,1090,'_news_title','field_5de78da3aabb9'),(20295,1090,'sec_2_text_copy',''),(20296,1090,'_sec_2_text_copy','field_5de78dc89e613'),(20297,1090,'timeline-title','Timeline'),(20298,1090,'_timeline-title','field_5de78df29e615'),(20299,1090,'timeline_title','Timeline'),(20300,1090,'_timeline_title','field_5de78df29e615'),(20301,1090,'contact_title','Contact us'),(20302,1090,'_contact_title','field_5de7981e06057'),(20303,1090,'contact_intro','Contact text...'),(20304,1090,'_contact_intro','field_5de7983506058'),(20305,1090,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(20306,1090,'_news_button','field_5de8329896e02'),(20307,1090,'timeline_intro','Introduction of timeline detail...'),(20308,1090,'_timeline_intro','field_5de98f5fb1781'),(20309,1090,'timeline_pic','477'),(20310,1090,'_timeline_pic','field_5de98f72b1782'),(20311,1090,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(20312,1090,'_timeline_button','field_5de99363677f8'),(20313,1090,'banner_image_position','center'),(20314,1090,'_banner_image_position','field_5f3bc4757dd02'),(20315,1090,'services_title','Our services'),(20316,1090,'_services_title','field_5f20f3cd80eb2'),(20317,1090,'services_items_0_services_item_image','1061'),(20318,1090,'_services_items_0_services_item_image','field_5f2121355be14'),(20319,1090,'services_items_0_sservices_item_title','1300 Telephone counselling line'),(20320,1090,'_services_items_0_sservices_item_title','field_605089efca82e'),(20321,1090,'services_items_0_services_item_text',''),(20322,1090,'_services_items_0_services_item_text','field_5f2121535be15'),(20323,1090,'services_items_0_services_link_url','#'),(20324,1090,'_servi