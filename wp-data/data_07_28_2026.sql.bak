'field_5b67c6c98c065'),(197956,2726,'support_right_button','<a class=\"btn btn-blue\" href=\"#\">Read more</a>'),(197957,2726,'_support_right_button','field_5b67c6dd8c066'),(197958,2726,'first_image_title','Lifestart is about supporting young children'),(197959,2726,'_first_image_title','field_5b67ca606afc4'),(197960,2726,'first_image_cont','from 0-24 years living with disabilities and their familes'),(197961,2726,'_first_image_cont','field_5b67caff6afc5'),(197962,2726,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(197963,2726,'_first_image_button','field_5b67cb0d6afc6'),(197964,2726,'second _image_title','Lifestart is about supporting young children'),(197965,2726,'_second _image_title','field_5b67cb20ddf9a'),(197966,2726,'second_image_cont','from 0-24 years living with disabilities and their familes'),(197967,2726,'_second_image_cont','field_5b67cb24ddf9b'),(197968,2726,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(197969,2726,'_second_image_button','field_5b67cb29ddf9c'),(197970,2726,'second_image_title','Lifestart is about supporting young children'),(197971,2726,'_second_image_title','field_5b67cb20ddf9a'),(197972,2726,'page_col_image','412'),(197973,2726,'_page_col_image','field_5de6546e7c63a'),(197974,2726,'page_col_image_3','437'),(197975,2726,'_page_col_image_3','field_5de6e3998e07e'),(197976,2726,'sec_2_title','Community'),(197977,2726,'_sec_2_title','field_5de6e3ef2798f'),(197978,2726,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(197979,2726,'_sec_2_text','field_5de78dc89e613'),(197980,2726,'sec_3_title','The Project'),(197981,2726,'_sec_3_title','field_5de6e3d37d8da'),(197982,2726,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(197983,2726,'_sec_3_text','field_5de6e4044e5e8'),(197984,2726,'page_col_image_2','436'),(197985,2726,'_page_col_image_2','field_5de6546e7c63a'),(197986,2726,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(197987,2726,'_sec_2_button','field_5de6e58c86706'),(197988,2726,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(197989,2726,'_sec_3_button','field_5de6e5a243c03'),(197990,2726,'page_col_image_4','455'),(197991,2726,'_page_col_image_4','field_5de70801090ce'),(197992,2726,'sec_4_title','Location'),(197993,2726,'_sec_4_title','field_5de7082a12a81'),(197994,2726,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(197995,2726,'_sec_4_text','field_5de7084812a82'),(197996,2726,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(197997,2726,'_sec_4_button','field_5de7085e12a83'),(197998,2726,'news_title','Project updates'),(197999,2726,'_news_title','field_5de78da3aabb9'),(198000,2726,'sec_2_text_copy',''),(198001,2726,'_sec_2_text_copy','field_5de78dc89e613'),(198002,2726,'timeline-title','Timeline'),(198003,2726,'_timeline-title','field_5de78df29e615'),(198004,2726,'timeline_title','Timeline'),(198005,2726,'_timeline_title','field_5de78df29e615'),(198006,2726,'contact_title','Contact us'),(198007,2726,'_contact_title','field_5de7981e06057'),(198008,2726,'contact_