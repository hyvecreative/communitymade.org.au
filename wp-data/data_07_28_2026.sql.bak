493'),(181433,2671,'_survey_index_7_survey_icon','field_6294562942237'),(181434,2671,'survey_index_7_survey_title','Going Off-grid'),(181435,2671,'_survey_index_7_survey_title','field_6294564042238'),(181436,2671,'survey_index_7_survey_url','#'),(181437,2671,'_survey_index_7_survey_url','field_6294564e42239'),(181438,2671,'survey_index_7_survey_url_text','View Results'),(181439,2671,'_survey_index_7_survey_url_text','field_629456584223a'),(181440,2671,'survey_index','8'),(181441,2671,'_survey_index','field_6294561242236'),(181442,2671,'report_title','Download the report'),(181443,2671,'_report_title','field_62f30edfb57e1'),(181444,2671,'report_intro','Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus massa erat, consectetur at semper at, feugiat vel orci. '),(181445,2671,'_report_intro','field_62f30eedb57e2'),(181446,2671,'report_link_url','#'),(181447,2671,'_report_link_url','field_62f30ef4b57e3'),(181448,2671,'report_link_text','Download'),(181449,2671,'_report_link_text','field_62f30f01b57e4'),(181450,2671,'solutions_content','The housing system is complex, and no one solution will solve the complex problems we now face but there are some critical first steps to be taken now.\r\n<ul>\r\n 	<li>Set out an ambitious national housing agreement between commonwealth and state governments with targets and funding for the construction of affordable homes.</li>\r\n 	<li>Phase out tax breaks for property investors and using the increase in revenue to build more public housing.</li>\r\n 	<li>Establish laws which limit rental increases beyond what is fair.</li>\r\n 	<li>Rebalance tenancy laws to provide renters with more security and control, such as eliminating no grounds evictions.</li>\r\n 	<li>Phase out stamp duty and replace it with a broad-based land tax.</li>\r\n</ul>\r\n<h4>While there are many opinions on what policy changes will fix the housing market, doing nothing is not an option.</h4>'),(181451,2671,'_solutions_content','field_640e8b307a958'),(181452,2671,'problem_icons_0_prob_icon','1699'),(181453,2671,'_problem_icons_0_prob_icon','field_640fa0291d519'),(181454,2671,'problem_icons_0_prob_concerned_stat','70% highly concerned'),(181455,2671,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(181456,2671,'problem_icons_0_prob_concerded_text','are highly concerned'),(181457,2671,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(181458,2671,'problem_icons_0_prob_issue_text',''),(181459,2671,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(181460,2671,'problem_icons','4'),(181461,2671,'_problem_icons','field_640fa0191d518'),(181462,2671,'ceh_content_left',''),(181463,2671,'_ceh_content_left','field_640e97e8f1c8c'),(181464,2671,'ceh_content_right',''),(181465,2671,'_ceh_content_right','field_640e97fdf1c8d'),(181466,2671,'pc_content_left',''),(181467,2671,'_pc_content_left','field_640e983bf1c8f'),(181468,2671,'pc_content_right',''),(181469,2671,'_pc_content_right','field_640e984df1c90'),(181470,2671,'problem_icons_1_prob_icon','1699'),(181471,2671,'_problem_icons_1_prob_icon','field_640fa0291d519'),(181472,2671,'problem_icons_1_prob_concerned_stat','69% highly concerned'),(181473,2671,'_problem_icons_1_prob_concerned_stat','field_640fa0dd81d95'),(181474,2671,'problem_icons_1_prob_concerded_text','are highly concerned'),(181475,2671,'_problem_icons_1_prob_concerded_text','field_640fa10181d96'),(181476,2671,'problem_icons_1_prob_issue_text',''),(181477,2671,'_problem_icons_1_prob_issue_text','field_640fa11a81d97'),(181478,2671,'problem_icons_2_prob_icon','1699'),(181479,2671,'_problem_icons_2_prob_icon','field_640fa0291d519'),(181480,2671,'problem_icons_2_prob_concerned_stat','64% highly concerned'),(181481,2671,'_problem_icons_2_prob_concerned_stat','field_640fa0dd81d95'),(181482,2671,'problem_icons_2_prob_concerded_text','are highly concerned'),(181483,2671,'_problem_icons_2_prob_concerded_text','field_640fa10181d96'),(181484,2671,'problem_icons_2_prob_issue_text',''),(181485,2671,'_problem_icons_2_prob_issue_text','field_640fa11a81d97'),(181486,2671,'problem_icons_3_prob_icon','1699'),(181487,2671,'_problem_icons_3_prob_icon','field_640fa0291d519'),(181488,2671,'problem_icons_3_prob_concerned_stat','64% highly concerned'),(181489,2671,'_problem_icons_3_prob_concerned_stat','field_640fa0dd81d95'),(181490,2671,'problem_icons_3_prob_concerded_text','are highly concerned'),(181491,2671,'_problem_icons_3_prob_concerded_text','field_640fa10181d96'),(181492,2671,'problem_icons_3_prob_issue_text',''),(181493,2671,'_problem_icons_3_prob_issue_text','field_640fa11a81d97'),(181494,2671,'problem_icons_0_prob_concerned_text','House prices have doubled in a decade'),(181495,2671,'_problem_icons_0_prob_concerned_text','field_640fa10181d96'),(181496,2671,'problem_icons_1_prob_concerned_text','The gap between rich and poor is growing'),(181497,2671,'_problem_icons_1_prob_concerned_text','field_640fa10181d96'),(181498,2671,'problem_icons_2_prob_concerned_text','Construction of social housing is down'),(181499,2671,'_problem_icons_2_prob_concerned_text','field_640fa10181d96'),(181500,2671,'problem_icons_3_prob_concerned_text','Banks are making more than ever from housing'),(181501,2671,'_problem_icons_3_prob_concerned_text','field_640fa10181d96'),(181502,2671,'monitor_content','The Australian Housing Monitor is a large, nationally-representative survey covering public experiences and attitudes toward housing related issues. Questions range from how well the respondent is keeping up with their mortgage/rent, to what they think about social housing construction.\r\n\r\nA broad range of demographic criteria are included, such as gender, location, age, income, voting preference, educational level, tenure type, and employment status. These variables allow CEH researchers to understand the trends and diversity of opinion around the country.\r\n\r\nIt also incorporates questions from previous surveys to track trends over time.\r\nThe inaugural poll was conducted by Essential in December 2022, and was completed by 4,735 people.'),(181503,2671,'_monitor_content','field_640fcc4014404'),(181504,2671,'problem_head','Housing in Australia is not working, and Australians are concerned.'),(181505,2671,'_problem_head','field_641935436aded'),(181506,2671,'problem_signoff','Explore the research showing how concerned Australians are our about the housing situation.'),(181507,2671,'_problem_signoff','field_641935626adee'),(181508,2671,'sections','a:2:{i:0;s:4:\"hero\";i:1;s:9:\"news_grid\";}'),(181509,2671,'_sections','field_5dafb40b8143a'),(181510,2671,'sections_0_is_full_height','1'),(181511,2671,'_sections_0_is_full_height','field_61d6f6fd5a37e'),(181512,2671,'sections_0_image','1648'),(181513,2671,'_sections_0_image','field_61d6f6d45a37d'),(181514,2671,'sections_0_heading','Heading'),(181515,2671,'_sections_0_heading','field_61d6f69e5a379'),(181516,2671,'sections_0_subtitle','Ya ya '),(181517,2671,'_sections_0_subtitle','field_61d6f6ac5a37a'),(181518,2671,'sections_0_link_one',''),(181519,2671,'_sections_0_link_one','field_61d6f6b55a37b'),(181520,2671,'sections_0_link_two',''),(181521,2671,'_sections_0_link_two','field_61d6f6c35a37c'),(181522,2671,'sections_1_select_categories','a:1:{i:0;s:2:\"27\";}'),(181523,2671,'_sections_1_select_categories','field_637f04483b63b'),(181524,2671,'intro_head_major','Welcome to the Disability Dialogue'),(181525,2671,'_intro_head_major','field_64e828783ad9f'),(181526,2671,'intro_head_minor',''),(181527,2671,'_intro_head_minor','field_64e8288c3ada0'),(181528,2671,'intro_icons_0_int_icon','1922'),(181529,2671,'_intro_icons_0_int_icon','field_64e828b33ada2'),(181530,2671,'intro_icons_0_int_icon_text','At 1,727,000 square kilometres, we’re 2.5 times the size of Texas. <span>Yeeha!</span>'),(181531,2671,'_intro_icons_0_int_icon_text','field_64e828e33ada3'),(181532,2671,'intro_icons_1_int_icon','1920'),(181533,2671,'_intro_icons_1_int_icon','field_64e828b33ada2'),(181534,2671,'intro_icons_1_int_icon_text',