irst_image_cont','field_5b67caff6afc5'),(77712,1875,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(77713,1875,'_first_image_button','field_5b67cb0d6afc6'),(77714,1875,'second _image_title','Lifestart is about supporting young children'),(77715,1875,'_second _image_title','field_5b67cb20ddf9a'),(77716,1875,'second_image_cont','from 0-24 years living with disabilities and their familes'),(77717,1875,'_second_image_cont','field_5b67cb24ddf9b'),(77718,1875,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(77719,1875,'_second_image_button','field_5b67cb29ddf9c'),(77720,1875,'second_image_title','Lifestart is about supporting young children'),(77721,1875,'_second_image_title','field_5b67cb20ddf9a'),(77722,1875,'page_col_image','412'),(77723,1875,'_page_col_image','field_5de6546e7c63a'),(77724,1875,'page_col_image_3','437'),(77725,1875,'_page_col_image_3','field_5de6e3998e07e'),(77726,1875,'sec_2_title','Community'),(77727,1875,'_sec_2_title','field_5de6e3ef2798f'),(77728,1875,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(77729,1875,'_sec_2_text','field_5de78dc89e613'),(77730,1875,'sec_3_title','The Project'),(77731,1875,'_sec_3_title','field_5de6e3d37d8da'),(77732,1875,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(77733,1875,'_sec_3_text','field_5de6e4044e5e8'),(77734,1875,'page_col_image_2','436'),(77735,1875,'_page_col_image_2','field_5de6546e7c63a'),(77736,1875,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(77737,1875,'_sec_2_button','field_5de6e58c86706'),(77738,1875,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(77739,1875,'_sec_3_button','field_5de6e5a243c03'),(77740,1875,'page_col_image_4','455'),(77741,1875,'_page_col_image_4','field_5de70801090ce'),(77742,1875,'sec_4_title','Location'),(77743,1875,'_sec_4_title','field_5de7082a12a81'),(77744,1875,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(77745,1875,'_sec_4_text','field_5de7084812a82'),(77746,1875,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(77747,1875,'_sec_4_button','field_5de7085e12a83'),(77748,1875,'news_title','Project updates'),(77749,1875,'_news_title','field_5de78da3aabb9'),(77750,1875,'sec_2_text_copy',''),(77751,1875,'_sec_2_text_copy','field_5de78dc89e613'),(77752,1875,'timeline-title','Timeline'),(77753,1875,'_timeline-title','field_5de78df29e615'),(77754,1875,'timeline_title','Timeline'),(77755,1875,'_timeline_title','field_5de78df29e615'),(77756,1875,'contact_title','Contact us'),(77757,1875,'_contact_title','field_5de7981e06057'),(77758,1875,'contact_intro','Contact text...'),(77759,1875,'_contact_intro','field_5de7983506058'),(77760,1875,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(77761,1875,'_news_button','field_5de8329896e02'),(77762,1875,'timeline_intro','Introduction of timeline detail...'),(77763,1875,'_timeline_intro','field_5de98f5fb1781'),(77764,1875,'timeline_pic','477'),(77765,1875,'_timeline_pic','field_5de98f72b1782'),(77766,1875,'timeline_button','<