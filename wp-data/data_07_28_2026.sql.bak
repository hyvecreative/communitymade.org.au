ld_5b568147fd367'),(41502,1535,'support_section_title','How can Lifestart support you?'),(41503,1535,'_support_section_title','field_5b67c7d060398'),(41504,1535,'support_left_title','Services'),(41505,1535,'_support_left_title','field_5b67c298e7f8f'),(41506,1535,'support_left_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy.'),(41507,1535,'_support_left_cont','field_5b67c5f6e7f91'),(41508,1535,'support_left_button','<a class=\"btn btn-green\" href=\"/services/\">View all services</a>'),(41509,1535,'_support_left_button','field_5b67c60ae7f92'),(41510,1535,'support_ctr_title','Talk to us'),(41511,1535,'_support_ctr_title','field_5b67c62a58af3'),(41512,1535,'support_ctr_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut laoreet.'),(41513,1535,'_support_ctr_cont','field_5b67c63158af4'),(41514,1535,'support_ctr_button','<a class=\"btn btn-orange\" href=\"/supports/\">Find us</a>'),(41515,1535,'_support_ctr_button','field_5b67c63658af5'),(41516,1535,'support_right_title','NDIS Registered provider'),(41517,1535,'_support_right_title','field_5b67c6a38c064'),(41518,1535,'support_right_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut.'),(41519,1535,'_support_right_cont','field_5b67c6c98c065'),(41520,1535,'support_right_button','<a class=\"btn btn-blue\" href=\"#\">Read more</a>'),(41521,1535,'_support_right_button','field_5b67c6dd8c066'),(41522,1535,'first_image_title','Lifestart is about supporting young children'),(41523,1535,'_first_image_title','field_5b67ca606afc4'),(41524,1535,'first_image_cont','from 0-24 years living with disabilities and their familes'),(41525,1535,'_first_image_cont','field_5b67caff6afc5'),(41526,1535,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(41527,1535,'_first_image_button','field_5b67cb0d6afc6'),(41528,1535,'second _image_title','Lifestart is about supporting young children'),(41529,1535,'_second _image_title','field_5b67cb20ddf9a'),(41530,1535,'second_image_cont','from 0-24 years living with disabilities and their familes'),(41531,1535,'_second_image_cont','field_5b67cb24ddf9b'),(41532,1535,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(41533,1535,'_second_image_button','field_5b67cb29ddf9c'),(41534,1535,'second_image_title','Lifestart is about supporting young children'),(41535,1535,'_second_image_title','field_5b67cb20ddf9a'),(41536,1535,'page_col_image','412'),(41537,1535,'_page_col_image','field_5de6546e7c63a'),(41538,1535,'page_col_image_3','437'),(41539,1535,'_page_col_image_3','field_5de6e3998e07e'),(41540,1535,'sec_2_title','Community'),(41541,1535,'_sec_2_title','field_5de6e3ef2798f'),(41542,1535,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(41543,1535,'_sec_2_text','field_5de78dc89e613'),(41544,1535,'sec_3_title','The Project'),(41545,1535,'_sec_3_title','field_5de6e3d37d8da'),(41546,1535,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(41547,1535,'_sec_3_text','field_5de6e4044e5e8'),(41548,1535,'page_col_image_2','436'),(41549,1535,'_page_col_image_2','field_5de6546e7c63a'),(41550,1535,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(41551,1535,'_sec_2_button','field_5de6e58c86706'),(41552,1535,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(41553,1535,'_sec_3_button','field_5de6e5a243c03'),(41554,1535,'page_col_image_4','455'),(41555,1535,'_page_col_image_4','field_5de70801090ce'),(41556,1535,'sec_4_title','Location'),(41557,1535,'_sec_4_title','field_5de7082a12a81'),(41558,1535,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(41559,1535,'_sec_4_text','field_5de7084812a82'),(41560,1535,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(41561,1535,'_sec_4_button','field_5de7085e12a83'),(41562,1535,'news_title','Project updates'),(41563,1535,'_news_title','field_5de78da3aabb9'),(41564,1535,'sec_2_text_copy',''),(41565,1535,'_sec_2_text_copy','field_5de78dc89e613'),(41566,1535,'timeline-title','Timeline'),(41567,1535,'_timeline-title','field_5de78df29e615'),(41568,1535,'timeline_title','Timeline'),(41569,1535,'_timeline_title','field_5de78df29e615'),(41570,1535,'contact_title','Contact us'),(41571,1535,'_contact_title','field_5de7981e06057'),(41572,1535,'contact_intro','Contact text...'),(41573,1535,'_contact_intro','field_5de7983506058'),(41574,1535,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(41575,1535,'_news_button','field_5de8329896e02'),(41576,1535,'timeline_intro','Introduction of timeline detail...'),(41577,1535,'_timeline_intro','field_5de98f5fb1781'),(41578,1535,'timeline_pic','477'),(41579,1535,'_timeline_pic','field_5de98f72b1782'),(41580,1535,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(41581,1535,'_timeline_button','field_5de99363677f8'),(41582,1535,'banner_image_position','center'),(41583,1535,'_banner_image_position','field_5f3bc4757dd02'),(41584,1535,'services_