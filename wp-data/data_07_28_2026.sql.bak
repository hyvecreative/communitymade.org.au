social infrastructure.'),(192122,2714,'_issues_items_1_issues_sub_head','field_6a3b0aa79365e'),(192123,2714,'issues_items_2_issue_icon','2703'),(192124,2714,'_issues_items_2_issue_icon','field_6a3b07b506af1'),(192125,2714,'issues_items_2_issues_item_hd','Why community made:'),(192126,2714,'_issues_items_2_issues_item_hd','field_6a3b07d706af2'),(192127,2714,'issues_items_2_issues_sub_head',''),(192128,2714,'_issues_items_2_issues_sub_head','field_6a3b0aa79365e'),(192129,2714,'issues_items_2_issues_item_txt','Community housing is local. Every dollar invested is given back to community through homes, services and jobs. It’s built to thrive, like our communities.  Community housing is an investment in our state’s future. By investing in people today, we boost our local economies, communities and productivity – ensuring that NSW leads the nation.'),(192130,2714,'_issues_items_2_issues_item_txt','field_6a3b07fc06af3'),(192131,2714,'issues_items_2_issues_link_text',''),(192132,2714,'_issues_items_2_issues_link_text','field_6a3b080f06af4'),(192133,2714,'issues_items_2_issues_target_url',''),(192134,2714,'_issues_items_2_issues_target_url','field_6a3b082b06af5'),(192137,2715,'footnotes',''),(192139,2715,'banner_head',''),(192140,2715,'_banner_head','field_5b568121a8ffe'),(192141,2715,'banner_sub',''),(192142,2715,'_banner_sub','field_5b568139fd366'),(192143,2715,'banner_button','<a class=\"btn btn-home\" style=\"width: 200px;\" href=\"#project\">Sign the petition</a>'),(192144,2715,'_banner_button','field_5b568147fd367'),(192145,2715,'support_section_title','How can Lifestart support you?'),(192146,2715,'_support_section_title','field_5b67c7d060398'),(192147,2715,'support_left_title','Services'),(192148,2715,'_support_left_title','field_5b67c298e7f8f'),(192149,2715,'support_left_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy.'),(192150,2715,'_support_left_cont','field_5b67c5f6e7f91'),(192151,2715,'support_left_button','<a class=\"btn btn-green\" href=\"/services/\">View all services</a>'),(192152,2715,'_support_left_button','field_5b67c60ae7f92'),(192153,2715,'support_ctr_title','Talk to us'),(192154,2715,'_support_ctr_title','field_5b67c62a58af3'),(192155,2715,'support_ctr_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut laoreet.'),(192156,2715,'_support_ctr_cont','field_5b67c63158af4'),(192157,2715,'support_ctr_button','<a class=\"btn btn-orange\" href=\"/supports/\">Find us</a>'),(192158,2715,'_support_ctr_button','field_5b67c63658af5'),(192159,2715,'support_right_title','NDIS Registered provider'),(192160,2715,'_support_right_title','field_5b67c6a38c064'),(192161,2715,'support_right_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut.'),(192162,2715,'_support_right_cont','field_5b67c6c98c065'),(192163,2715,'support_right_button','<a class=\"btn btn-blue\" href=\"#\">Read more</a>'),(192164,2715,'_support_right_button','field_5b67c6dd8c066'),(192165,2715,'first_image_title','Lifestart is about supporting young children'),(192166,2715,'_first_image_title','field_5b67ca606afc4'),(192167,2715,'first_image_cont','from 0-24 years living with disabilities and their familes'),(192168,2715,'_first_image_cont','field_5b67caff6afc5'),(192169,2715,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(192170,2715,'_first_image_button','field_5b67cb0d6afc6'),(192171,2715,'second _image_title','Lifestart is about supporting young children'),(192172,2715,'_second _image_title','field_5b67cb20ddf9a'),(192173,2715,'second_image_cont','from 0-24 years living with disabilities and their familes'),(192174,2715,'_second_image_cont','field_5b67cb24ddf9b'),(192175,2715,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(192176,2715,'_second_image_button','field_5b67cb29ddf9c'),(192177,2715,'second_image_title','Lifestart is about supporting young children'),(192178,2715,'_second_image_title','field_5b67cb20ddf9a'),(192179,2715,'page_col_image','412'),(192180,2715,'_page_col_image','field_5de6546e7c63a'),(192181,2715,'page_col_image_3','437'),(192182,2715,'_page_col_image_3','field_5de6e3998e07e'),(192183,2715,'sec_2_title','Community'),(192184,2715,'_sec_2_title','field_5de6e3ef2798f'),(192185,2715,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(192186,2715,'_sec_2_text','field_5de78dc89e613'),(192187,2715,'sec_3_title','The Project'),(192188,2715,'_sec_3_title','field_5de6e3d37d8da'),(192189,2715,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(192190,2715,'_sec_3_text','field_5de6e4044e5e8'),(192191,2715,'page_col_image_2','436'),(192192,2715,'_page_col_image_2','field_5de6546e7c63a'),(192193,2715,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(192194,2715,'_sec_2_button','field_5de6e58c86706'),(192195,2715,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(192196,2715,'_sec_3_button','field_5de6e5a243c03'),(192197,2715,'page_col_image_4','455'),(192198,2715,'_page_col_image_4','field_5de70801090ce'),(192199,2715,'sec_4_title','Location'),(192200,2715,'_sec_4_title','field_5de7082a12a81'),(192201,2715,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(192202,2715,'_sec_4_text','field_5de7084812a82'),(192203,2715,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(192204,2715,'_sec_4_button','field_5de7085e12a83'),(192205,2715,'news_title','Project updates'),(192206,2715,'_news_title','field_5de78da3aabb9'),(192207,2715,'sec_2_text_copy',''),(192208,2715,'_sec_2_text_copy','field_5de78dc89e613'),(192209,2715,'timeline-title','Timeline'),(192210,2715,'_timeline-title','field_5de78df29e615'),(192211,2715,'timeline_title','Timeline'),(192212,2715,'_timeline_title','field_5de78df29e615'),(192213,2715,'contact_title','Contact us'),(192214,2715,'_contact_title','field_5de7981e06057'),(192215,2715,'contact_intro','Contact text...'),(192216,2715,'_contact_intro','field_5de7983506058'),(192217,2715,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(192218,2715,'_news_button','field_5de8329896e02'),(192219,2715,'timeline_intro','Introduction of timeline detail...'),(192220,2715,'_timeline_intro','field_5de98f5fb1781'),(192221,2715,'timeline_pic','477'),(192222,2715,'_timeline_pic','field_5de98f72b1782'),(192223,2715,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(192224,2715,'_timeline_button','field_5de99363677f8'),(192225,2715,'banner_image_position','center'),(192226,2715,'_banner_image_position','field_5f3bc4757dd02'),(192227,2715,'services_title','Our services'),(192228,2715,'_services_title','field_5f20f3cd80eb2'),(192229,2715,'services_items_0_services_item_image','1061'),(192230,2715,'_services_items_0_services_item_image','field_5f2121355be14'),(192231,2715,'services_items_0_sservices_item_title','1300 Telephone counselling line'),(192232,2715,'_services_items_0_sservices_item_title','field_605089efca82e'),(192233,2715,'servic