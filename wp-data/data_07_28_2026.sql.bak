ght_cont','field_5b67c6c98c065'),(135310,2265,'support_right_button','<a class=\"btn btn-blue\" href=\"#\">Read more</a>'),(135311,2265,'_support_right_button','field_5b67c6dd8c066'),(135312,2265,'first_image_title','Lifestart is about supporting young children'),(135313,2265,'_first_image_title','field_5b67ca606afc4'),(135314,2265,'first_image_cont','from 0-24 years living with disabilities and their familes'),(135315,2265,'_first_image_cont','field_5b67caff6afc5'),(135316,2265,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(135317,2265,'_first_image_button','field_5b67cb0d6afc6'),(135318,2265,'second _image_title','Lifestart is about supporting young children'),(135319,2265,'_second _image_title','field_5b67cb20ddf9a'),(135320,2265,'second_image_cont','from 0-24 years living with disabilities and their familes'),(135321,2265,'_second_image_cont','field_5b67cb24ddf9b'),(135322,2265,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(135323,2265,'_second_image_button','field_5b67cb29ddf9c'),(135324,2265,'second_image_title','Lifestart is about supporting young children'),(135325,2265,'_second_image_title','field_5b67cb20ddf9a'),(135326,2265,'page_col_image','412'),(135327,2265,'_page_col_image','field_5de6546e7c63a'),(135328,2265,'page_col_image_3','437'),(135329,2265,'_page_col_image_3','field_5de6e3998e07e'),(135330,2265,'sec_2_title','Community'),(135331,2265,'_sec_2_title','field_5de6e3ef2798f'),(135332,2265,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(135333,2265,'_sec_2_text','field_5de78dc89e613'),(135334,2265,'sec_3_title','The Project'),(135335,2265,'_sec_3_title','field_5de6e3d37d8da'),(135336,2265,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(135337,2265,'_sec_3_text','field_5de6e4044e5e8'),(135338,2265,'page_col_image_2','436'),(135339,2265,'_page_col_image_2','field_5de6546e7c63a'),(135340,2265,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(135341,2265,'_sec_2_button','field_5de6e58c86706'),(135342,2265,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(135343,2265,'_sec_3_button','field_5de6e5a243c03'),(135344,2265,'page_col_image_4','455'),(135345,2265,'_page_col_image_4','field_5de70801090ce'),(135346,2265,'sec_4_title','Location'),(135347,2265,'_sec_4_title','field_5de7082a12a81'),(135348,2265,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(135349,2265,'_sec_4_text','field_5de7084812a82'),(135350,2265,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(135351,2265,'_sec_4_button','field_5de7085e12a83'),(135352,2265,'news_title','Project updates'),(135353,2265,'_news_title','field_5de78da3aabb9'),(135354,2265,'sec_2_text_copy',''),(135355,2265,'_sec_2_text_copy','field_5de78dc89e613'),(135356,2265,'timeline-title','Timeline'),(135357,2265,'_timeline-title','field_5de78df29e615'),(135358,2265,'timeline_title','Timeline'),(135359,2265,'_timeline_title','field_5de78df29e615'),(135360,2265,'contact_title','Contact us'),(135361,2265,'_contact_title','field_5de7981e06057'),(135362,2265