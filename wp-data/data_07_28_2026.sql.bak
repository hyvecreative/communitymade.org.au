20ddf9a'),(22993,1118,'second_image_cont','from 0-24 years living with disabilities and their familes'),(22994,1118,'_second_image_cont','field_5b67cb24ddf9b'),(22995,1118,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(22996,1118,'_second_image_button','field_5b67cb29ddf9c'),(22997,1118,'second_image_title','Lifestart is about supporting young children'),(22998,1118,'_second_image_title','field_5b67cb20ddf9a'),(22999,1118,'page_col_image','412'),(23000,1118,'_page_col_image','field_5de6546e7c63a'),(23001,1118,'page_col_image_3','437'),(23002,1118,'_page_col_image_3','field_5de6e3998e07e'),(23003,1118,'sec_2_title','Community'),(23004,1118,'_sec_2_title','field_5de6e3ef2798f'),(23005,1118,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(23006,1118,'_sec_2_text','field_5de78dc89e613'),(23007,1118,'sec_3_title','The Project'),(23008,1118,'_sec_3_title','field_5de6e3d37d8da'),(23009,1118,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(23010,1118,'_sec_3_text','field_5de6e4044e5e8'),(23011,1118,'page_col_image_2','436'),(23012,1118,'_page_col_image_2','field_5de6546e7c63a'),(23013,1118,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(23014,1118,'_sec_2_button','field_5de6e58c86706'),(23015,1118,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(23016,1118,'_sec_3_button','field_5de6e5a243c03'),(23017,1118,'page_col_image_4','455'),(23018,1118,'_page_col_image_4','field_5de70801090ce'),(23019,1118,'sec_4_title','Location'),(23020,1118,'_sec_4_title','field_5de7082a12a81'),(23021,1118,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(23022,1118,'_sec_4_text','field_5de7084812a82'),(23023,1118,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(23024,1118,'_sec_4_button','field_5de7085e12a83'),(23025,1118,'news_title','Project updates'),(23026,1118,'_news_title','field_5de78da3aabb9'),(23027,1118,'sec_2_text_copy',''),(23028,1118,'_sec_2_text_copy','field_5de78dc89e613'),(23029,1118,'timeline-title','Timeline'),(23030,1118,'_timeline-title','field_5de78df29e615'),(23031,1118,'timeline_title','Timeline'),(23032,1118,'_timeline_title','field_5de78df29e615'),(23033,1118,'contact_title','Contact us'),(23034,1118,'_contact_title','field_5de7981e06057'),(23035,1118,'contact_intro','Contact text...'),(23036,1118,'_contact_intro','field_5de7983506058'),(23037,1118,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(23038,1118,'_news_button','field_5de8329896e02'),(23039,1118,'timeline_intro','Introduction of timeline detail...'),(23040,1118,'_timeline_intro','field_5de98f5fb1781'),(23041,1118,'timeline_pic','477'),(23042,1118,'_timeline_pic','field_5de98f72b1782'),(23043,1118,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(23044,1118,'_timeline_button','field_5de99363677f8'),(23045,1118,'banner_image_position','center'),(23046,1118,'_banner_image_position','field_5f3bc4757dd02'),(23047,1118,'services_title','Our services'),(23048,1118,'_services_tit