51,'page_col_image','412'),(94629,1951,'_page_col_image','field_5de6546e7c63a'),(94630,1951,'page_col_image_3','437'),(94631,1951,'_page_col_image_3','field_5de6e3998e07e'),(94632,1951,'sec_2_title','Community'),(94633,1951,'_sec_2_title','field_5de6e3ef2798f'),(94634,1951,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(94635,1951,'_sec_2_text','field_5de78dc89e613'),(94636,1951,'sec_3_title','The Project'),(94637,1951,'_sec_3_title','field_5de6e3d37d8da'),(94638,1951,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(94639,1951,'_sec_3_text','field_5de6e4044e5e8'),(94640,1951,'page_col_image_2','436'),(94641,1951,'_page_col_image_2','field_5de6546e7c63a'),(94642,1951,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(94643,1951,'_sec_2_button','field_5de6e58c86706'),(94644,1951,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(94645,1951,'_sec_3_button','field_5de6e5a243c03'),(94646,1951,'page_col_image_4','455'),(94647,1951,'_page_col_image_4','field_5de70801090ce'),(94648,1951,'sec_4_title','Location'),(94649,1951,'_sec_4_title','field_5de7082a12a81'),(94650,1951,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(94651,1951,'_sec_4_text','field_5de7084812a82'),(94652,1951,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(94653,1951,'_sec_4_button','field_5de7085e12a83'),(94654,1951,'news_title','Project updates'),(94655,1951,'_news_title','field_5de78da3aabb9'),(94656,1951,'sec_2_text_copy',''),(94657,1951,'_sec_2_text_copy','field_5de78dc89e613'),(94658,1951,'timeline-title','Timeline'),(94659,1951,'_timeline-title','field_5de78df29e615'),(94660,1951,'timeline_title','Timeline'),(94661,1951,'_timeline_title','field_5de78df29e615'),(94662,1951,'contact_title','Contact us'),(94663,1951,'_contact_title','field_5de7981e06057'),(94664,1951,'contact_intro','Contact text...'),(94665,1951,'_contact_intro','field_5de7983506058'),(94666,1951,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(94667,1951,'_news_button','field_5de8329896e02'),(94668,1951,'timeline_intro','Introduction of timeline detail...'),(94669,1951,'_timeline_intro','field_5de98f5fb1781'),(94670,1951,'timeline_pic','477'),(94671,1951,'_timeline_pic','field_5de98f72b1782'),(94672,1951,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(94673,1951,'_timeline_button','field_5de99363677f8'),(94674,1951,'banner_image_position','center'),(94675,1951,'_banner_image_position','field_5f3bc4757dd02'),(94676,1951,'services_title','Our services'),(94677,1951,'_services_title','field_5f20f3cd80eb2'),(94678,1951,'services_items_0_services_item_image','1061'),(94679,1951,'_services_items_0_services_item_image','field_5f2121355be14'),(94680,1951,'services_items_0_sservices_item_title','1300 Telephone counselling line'),(94681,1951,'_services_items_0_sservices_item_title','field_605089efca82e'),(94682,1951,'services_items_0_services_item_text',''),(94683,1951,'_services_items_0_services_item_text','field_5f2121535be15'),(94684,1