4'),(72540,1866,'first_image_cont','from 0-24 years living with disabilities and their familes'),(72541,1866,'_first_image_cont','field_5b67caff6afc5'),(72542,1866,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(72543,1866,'_first_image_button','field_5b67cb0d6afc6'),(72544,1866,'second _image_title','Lifestart is about supporting young children'),(72545,1866,'_second _image_title','field_5b67cb20ddf9a'),(72546,1866,'second_image_cont','from 0-24 years living with disabilities and their familes'),(72547,1866,'_second_image_cont','field_5b67cb24ddf9b'),(72548,1866,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(72549,1866,'_second_image_button','field_5b67cb29ddf9c'),(72550,1866,'second_image_title','Lifestart is about supporting young children'),(72551,1866,'_second_image_title','field_5b67cb20ddf9a'),(72552,1866,'page_col_image','412'),(72553,1866,'_page_col_image','field_5de6546e7c63a'),(72554,1866,'page_col_image_3','437'),(72555,1866,'_page_col_image_3','field_5de6e3998e07e'),(72556,1866,'sec_2_title','Community'),(72557,1866,'_sec_2_title','field_5de6e3ef2798f'),(72558,1866,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(72559,1866,'_sec_2_text','field_5de78dc89e613'),(72560,1866,'sec_3_title','The Project'),(72561,1866,'_sec_3_title','field_5de6e3d37d8da'),(72562,1866,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(72563,1866,'_sec_3_text','field_5de6e4044e5e8'),(72564,1866,'page_col_image_2','436'),(72565,1866,'_page_col_image_2','field_5de6546e7c63a'),(72566,1866,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(72567,1866,'_sec_2_button','field_5de6e58c86706'),(72568,1866,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(72569,1866,'_sec_3_button','field_5de6e5a243c03'),(72570,1866,'page_col_image_4','455'),(72571,1866,'_page_col_image_4','field_5de70801090ce'),(72572,1866,'sec_4_title','Location'),(72573,1866,'_sec_4_title','field_5de7082a12a81'),(72574,1866,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(72575,1866,'_sec_4_text','field_5de7084812a82'),(72576,1866,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(72577,1866,'_sec_4_button','field_5de7085e12a83'),(72578,1866,'news_title','Project updates'),(72579,1866,'_news_title','field_5de78da3aabb9'),(72580,1866,'sec_2_text_copy',''),(72581,1866,'_sec_2_text_copy','field_5de78dc89e613'),(72582,1866,'timeline-title','Timeline'),(72583,1866,'_timeline-title','field_5de78df29e615'),(72584,1866,'timeline_title','Timeline'),(72585,1866,'_timeline_title','field_5de78df29e615'),(72586,1866,'contact_title','Contact us'),(72587,1866,'_contact_title','field_5de7981e06057'),(72588,1866,'contact_intro','Contact text...'),(72589,1866,'_contact_intro','field_5de7983506058'),(72590,1866,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(72591,1866,'_news_button','field_5de8329896e02'),(72592,1866,'timeline_intro','Introduction of timeline detail...'),(72593,1866,'_timeline_intro','field_5de98f5fb1781'),(7259