1,2164,'page_col_image','412'),(122672,2164,'_page_col_image','field_5de6546e7c63a'),(122673,2164,'page_col_image_3','437'),(122674,2164,'_page_col_image_3','field_5de6e3998e07e'),(122675,2164,'sec_2_title','Community'),(122676,2164,'_sec_2_title','field_5de6e3ef2798f'),(122677,2164,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(122678,2164,'_sec_2_text','field_5de78dc89e613'),(122679,2164,'sec_3_title','The Project'),(122680,2164,'_sec_3_title','field_5de6e3d37d8da'),(122681,2164,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(122682,2164,'_sec_3_text','field_5de6e4044e5e8'),(122683,2164,'page_col_image_2','436'),(122684,2164,'_page_col_image_2','field_5de6546e7c63a'),(122685,2164,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(122686,2164,'_sec_2_button','field_5de6e58c86706'),(122687,2164,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(122688,2164,'_sec_3_button','field_5de6e5a243c03'),(122689,2164,'page_col_image_4','455'),(122690,2164,'_page_col_image_4','field_5de70801090ce'),(122691,2164,'sec_4_title','Location'),(122692,2164,'_sec_4_title','field_5de7082a12a81'),(122693,2164,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(122694,2164,'_sec_4_text','field_5de7084812a82'),(122695,2164,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(122696,2164,'_sec_4_button','field_5de7085e12a83'),(122697,2164,'news_title','Project updates'),(122698,2164,'_news_title','field_5de78da3aabb9'),(122699,2164,'sec_2_text_copy',''),(122700,2164,'_sec_2_text_copy','field_5de78dc89e613'),(122701,2164,'timeline-title','Timeline'),(122702,2164,'_timeline-title','field_5de78df29e615'),(122703,2164,'timeline_title','Timeline'),(122704,2164,'_timeline_title','field_5de78df29e615'),(122705,2164,'contact_title','Contact us'),(122706,2164,'_contact_title','field_5de7981e06057'),(122707,2164,'contact_intro','Contact text...'),(122708,2164,'_contact_intro','field_5de7983506058'),(122709,2164,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(122710,2164,'_news_button','field_5de8329896e02'),(122711,2164,'timeline_intro','Introduction of timeline detail...'),(122712,2164,'_timeline_intro','field_5de98f5fb1781'),(122713,2164,'timeline_pic','477'),(122714,2164,'_timeline_pic','field_5de98f72b1782'),(122715,2164,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(122716,2164,'_timeline_button','field_5de99363677f8'),(122717,2164,'banner_image_position','center'),(122718,2164,'_banner_image_position','field_5f3bc4757dd02'),(122719,2164,'services_title','Our services'),(122720,2164,'_services_title','field_5f20f3cd80eb2'),(122721,2164,'services_items_0_services_item_image','1061'),(122722,2164,'_services_items_0_services_item_image','field_5f2121355be14'),(122723,2164,'services_items_0_sservices_item_title','1300 Telephone counselling line'),(122724,2164,'_services_items_0_sservices_item_title','field_605089efca82e'),(122725,2164,'services_items_0_services_item_text',''),(122726,2164,'_services_