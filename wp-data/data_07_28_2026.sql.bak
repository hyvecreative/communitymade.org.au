y_index_7_survey_icon','1493'),(83515,1917,'_survey_index_7_survey_icon','field_6294562942237'),(83516,1917,'survey_index_7_survey_title','Going Off-grid'),(83517,1917,'_survey_index_7_survey_title','field_6294564042238'),(83518,1917,'survey_index_7_survey_url','#'),(83519,1917,'_survey_index_7_survey_url','field_6294564e42239'),(83520,1917,'survey_index_7_survey_url_text','View Results'),(83521,1917,'_survey_index_7_survey_url_text','field_629456584223a'),(83522,1917,'survey_index','8'),(83523,1917,'_survey_index','field_6294561242236'),(83524,1917,'report_title','Download the report'),(83525,1917,'_report_title','field_62f30edfb57e1'),(83526,1917,'report_intro','Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus massa erat, consectetur at semper at, feugiat vel orci. '),(83527,1917,'_report_intro','field_62f30eedb57e2'),(83528,1917,'report_link_url','#'),(83529,1917,'_report_link_url','field_62f30ef4b57e3'),(83530,1917,'report_link_text','Download'),(83531,1917,'_report_link_text','field_62f30f01b57e4'),(83532,1917,'solutions_content','The housing system is complex, and no one solution will solve the complex problems we now face but there are some critical first steps to be taken now.\r\n<ul>\r\n 	<li>Set out an ambitious national housing agreement between commonwealth and state governments with targets and funding for the construction of affordable homes.</li>\r\n 	<li>Phase out tax breaks for property investors and using the increase in revenue to build more public housing.</li>\r\n 	<li>Establish laws which limit rental increases beyond what is fair.</li>\r\n 	<li>Rebalance tenancy laws to provide renters with more security and control, such as eliminating no grounds evictions.</li>\r\n 	<li>Phase out stamp duty and replace it with a broad-based land tax.</li>\r\n</ul>\r\n<h4>While there are many opinions on what policy changes will fix the housing market, doing nothing is not an option.</h4>'),(83533,1917,'_solutions_content','field_640e8b307a958'),(83534,1917,'problem_icons_0_prob_icon','1699'),(83535,1917,'_problem_icons_0_prob_icon','field_640fa0291d519'),(83536,1917,'problem_icons_0_prob_concerned_stat','70% highly concerned'),(83537,1917,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(83538,1917,'problem_icons_0_prob_concerded_text','are highly concerned'),(83539,1917,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(83540,1917,'problem_icons_0_prob_issue_text',''),(83541,1917,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(83542,1917,'problem_icons','4'),(83543,1917,'_problem_icons','field_640fa0191d518'),(83544,1917,'ceh_content_left',''),(83545,1917,'_ceh_content_left','field_640e97e8f1c8c'),(83546,1917,'ceh_content_right',''),(83547,1917,'_ceh_content_right','field_640e97fdf1c8d'),(83548,1917,'pc_content_left',''),(83549,1917,'_pc_content_left','field_640e983bf1c8f'),(83550,1917,'pc_content_right',''),(83551,1917,'_pc_content_right','field_640e984df1c90'),(83552,1917,'problem_icons_1_prob_icon','1699'),(83553,1917,'_problem_icons_1_prob_icon','field_640fa0291d519'),(83554,1917,'problem_icons_1_prob_concerned_stat','69% highly concerned'),(83555,1917,'_problem_icons_1_prob_concerned_stat','field_640fa0dd81d95'),(83556,1917,'problem_icons_1_prob_concerded_text','are highly concerned'),(83557,1917,'_problem_icons_1_prob_concerded_text','field_640fa10181d96'),(83558,1917,'problem_icons_1_prob_issue_text',''),(83559,1917,'_problem_icons_1_prob_issue_text','field_640fa11a81d97'),(83560,1917,'problem_icons_2_prob_icon','1699'),(83561,1917,'_problem_icons_2_prob_icon','field_640fa0291d519'),(83562,1917,'problem_icons_2_prob_concerned_stat','64% highly concerned'),(83563,1917,'_problem_icons_2_prob_concerned_stat','field_640fa0dd81d95'),(83564,1917,'problem_icons_2_prob_concerded_text','are highly concerned'),(83565,1917,'_problem_icons_2_prob_concerded_text','field_640fa10181d96'),(83566,1917,'problem_icons_2_prob_issue_text',''),(83567,1917,'_problem_icons_2_prob_issue_text','field_640fa11a81d97'),(83568,1917,'problem_icons_3_prob_icon','1699'),(83569,1917,'_problem_icons_3_prob_icon','field_640fa0291d519'),(83570,1917,'problem_icons_3_prob_concerned_stat','64% highly concerned'),(83571,1917,'_problem_icons_3_prob_concerned_stat','field_640fa0dd81d95'),(83572,1917,'problem_icons_3_prob_concerded_text','are highly concerned'),(83573,1917,'_problem_icons_3_prob_concerded_text','field_640fa10181d96'),(83574,1917,'problem_icons_3_prob_issue_text',''),(83575,1917,'_problem_icons_3_prob_issue_text','field_640fa11a81d97'),(83576,1917,'problem_icons_0_prob_concerned_text','House prices have doubled in a decade'),(83577,1917,'_problem_icons_0_prob_concerned_text','field_640fa10181d96'),(83578,1917,'problem_icons_1_prob_concerned_text','The gap between rich and poor is growing'),(83579,1917,'_problem_icons_1_prob_concerned_text','field_640fa10181d96'),(83580,1917,'problem_icons_2_prob_concerned_text','Construction of social housing is down'),(83581,1917,'_problem_icons_2_prob_concerned_text','field_640fa10181d96'),(83582,1917,'problem_icons_3_prob_concerned_text','Banks are making more than ever from housing'),(83583,1917,'_problem_icons_3_prob_concerned_text','field_640fa10181d96'),(83584,1917,'monitor_content','The Australian Housing Monitor is a large, nationally-representative survey covering public experiences and attitudes toward housing related issues. Questions range from how well the respondent is keeping up with their mortgage/rent, to what they think about social housing construction.\r\n\r\nA broad range of demographic criteria are included, such as gender, location, age, income, voting preference, educational level, tenure type, and employment status. These variables allow CEH researchers to understand the trends and diversity of opinion around the country.\r\n\r\nIt also incorporates questions from previous surveys to track trends over time.\r\nThe inaugural poll was conducted by Essential in December 2022, and was completed by 4,735 people.'),(83585,1917,'_monitor_content','field_640fcc4014404'),(83586,1917,'problem_head','Housing in Australia is not working, and Australians are concerned.'),(83587,1917,'_problem_head','field_641935436aded'),(83588,1917,'problem_signoff','Explore the research showing how concerned Australians are our about the housing situation.'),(83589,1917,'_problem_signoff','field_641935626adee'),(83590,1917,'sections','a:2:{i:0;s:4:\"hero\";i:1;s:9:\"news_grid\";}'),(83591,1917,'_sections','field_5dafb40b8143a'),(83592,1917,'sections_0_is_full_height','1'),(83593,1917,'_sections_0_is_full_height','field_61d6f6fd5a37e'),(83594,1917,'sections_0_image','1648'),(83595,1917,'_sections_0_image','field_61d6f6d45a37d'),(83596,1917,'sections_0_heading','Heading'),(83597,1917,'_sections_0_heading','field_61d6f69e5a379'),(83598,1917,'sections_0_subtitle','Ya ya '),(83599,1917,'_sections_0_subtitle','field_61d6f6ac5a37a'),(83600,1917,'sections_0_link_one',''),(83601,1917,'_sections_0_link_one','field_61d6f6b55a37b'),(83602,1917,'sections_0_link_two',''),(83603,1917,'_sections_0_link_two','field_61d6f6c35a37c'),(83604,1917,'sections_1_select_categories','a:1:{i:0;s:2:\"27\";}'),(83605,1917,'_sections_1_select_categories','field_637f04483b63b'),(83606,1917,'intro_head_major','Super Consumers Australia is <span>fighting</span> to ensure that the superannuation industry is held accountable for the outcomes they deliver to Australian consumers.'),(83607,1917,'_intro_head_major','field_64e828783ad9f'),(83608,1917,'intro_head_minor','But there’s a few things you might not know about our beautiful state.'),(83609,1917,'_intro_head_minor','field_64e8288c3ada0'),(83610,1917,'intro_icons_0_int_icon',''),(83611,1917,'_intro_icons_0_int_icon','field_64e828b33ada2'),(83612,1917,'intro_icons_0_int_icon_text','At 1,727,000 square kilometres, we’re 2.5 times the size of Texas. <span>Yeeha!</span>'),(83613,1917,'_intro_icons_0_int_icon_text','field_64e828e33ada3'),(83614,1917,'intro_icons_1_int_icon',''),(83615,1917,'_intro_icons_1_int_icon','field_64e828b33ada2'),(83616,1917,'intro_icons_1_int_icon_text','We have twice as many species of native plant and animal as any other Australian state or territory.'),(83617,1917,'_intro_icons_1_int_icon_text','field_64e828e33ada3'),(83618,1917,'intro_icons_2_int_icon',''),(83619,1917,'_intro_icons_2_int_icon','field_64e828b33ada2'),(83620,1917,'intro_icons_2_int_icon_text','We have less land classified as ‘protected’ than any other state or territory.'),(83621,1917,'_intro_icons_2_int_icon_text','field_64e828e33ada3'),(83622,1917,'intro_icons','3'),(83623,1917,'_intro_icons','field_64e828963ada1'),(83624,1917,'threat_head_major','What we stand to lose if we don’t act soon to protect beautiful Queensland:'),(83625,1917,'_threat_head_major','field_64ec258d9dbd1'),(83626,1917,'threats_icons','3'),(83627,1917,'_threats_icons','field_64ec2551a93f9'),(83628,1917,'threats_icons_0_thr_icon','1819'),(83629,1917,'_threats_icons_0_thr_icon','field_64ec2551a93fa'),(83630,1917,'threats_icons_0_thr_icon_text','The rich cultural heritage of our First Nations people and their continuous ties to country, dating back more than 50,000 years.'),(83631,1917,'_threats_icons_0_thr_icon_text','field_64ec2551a93fb'),(83632,1917,'threats_icons_1_thr_icon','1819'),(83633,1917,'_threats_icons_1_thr_icon','field_64ec2551a93fa'),(83634,1917,'threats_icons_1_thr_icon_text','Thousands of species of plant and animal which are now classified as threatened or endangered in Queensland.'),(83635,1917,'_threats_icons_1_thr_icon_text','field_64ec2551a93fb'),(83636,1917,'threats_icons_2_thr_icon','1819'),(83637,1917,'_threats_icons_2_thr_icon','field_64ec2551a93fa'),(83638,1917,'threats_icons_2_thr_icon_text','The access to nature that is central to the Queensland way of life.'),(83639,1917,'_threats_icons_2_thr_icon_text','field_64ec2551a93fb'),(83640,1917,'threat_icons_0_thr_icon',''),(83641,1917,'_threat_icons_0_thr_icon','field_64ec2551a93fa'),(