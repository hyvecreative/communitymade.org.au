 us'),(177495,2652,'_support_ctr_title','field_5b67c62a58af3'),(177496,2652,'support_ctr_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut laoreet.'),(177497,2652,'_support_ctr_cont','field_5b67c63158af4'),(177498,2652,'support_ctr_button','<a class=\"btn btn-orange\" href=\"/supports/\">Find us</a>'),(177499,2652,'_support_ctr_button','field_5b67c63658af5'),(177500,2652,'support_right_title','NDIS Registered provider'),(177501,2652,'_support_right_title','field_5b67c6a38c064'),(177502,2652,'support_right_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut.'),(177503,2652,'_support_right_cont','field_5b67c6c98c065'),(177504,2652,'support_right_button','<a class=\"btn btn-blue\" href=\"#\">Read more</a>'),(177505,2652,'_support_right_button','field_5b67c6dd8c066'),(177506,2652,'first_image_title','Lifestart is about supporting young children'),(177507,2652,'_first_image_title','field_5b67ca606afc4'),(177508,2652,'first_image_cont','from 0-24 years living with disabilities and their familes'),(177509,2652,'_first_image_cont','field_5b67caff6afc5'),(177510,2652,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(177511,2652,'_first_image_button','field_5b67cb0d6afc6'),(177512,2652,'second _image_title','Lifestart is about supporting young children'),(177513,2652,'_second _image_title','field_5b67cb20ddf9a'),(177514,2652,'second_image_cont','from 0-24 years living with disabilities and their familes'),(177515,2652,'_second_image_cont','field_5b67cb24ddf9b'),(177516,2652,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(177517,2652,'_second_image_button','field_5b67cb29ddf9c'),(177518,2652,'second_image_title','Lifestart is about supporting young children'),(177519,2652,'_second_image_title','field_5b67cb20ddf9a'),(177520,2652,'page_col_image','412'),(177521,2652,'_page_col_image','field_5de6546e7c63a'),(177522,2652,'page_col_image_3','437'),(177523,2652,'_page_col_image_3','field_5de6e3998e07e'),(177524,2652,'sec_2_title','Community'),(177525,2652,'_sec_2_title','field_5de6e3ef2798f'),(177526,2652,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(177527,2652,'_sec_2_text','field_5de78dc89e613'),(177528,2652,'sec_3_title','The Project'),(177529,2652,'_sec_3_title','field_5de6e3d37d8da'),(177530,2652,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(177531,2652,'_sec_3_text','field_5de6e4044e5e8'),(177532,2652,'page_col_image_2','436'),(177533,2652,'_page_col_image_2','field_5de6546e7c63a'),(177534,2652,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(177535,2652,'_sec_2_button','field_5de6e58c86706'),(177536,2652,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(177537,2652,'_sec_3_button','field_5de6e5a243c03'),(177538,2652,'page_col_image_4','455'),(177539,2652,'_page_col_image_4','field_5de70801090ce'),(177540,2652,'sec_4_title','Location'),(177541,2652,'_sec_4_title','field_5de7082a12a81'),(177542,2652,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(177543,2652,'_sec_4_text','field_5de7084812a82'),(177544,2652,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(177545,2652,'_sec_4_button','field_5de7085e12a83'),(177546,2652,'news_title','Project updates'),(177547,2652,'_news_title','field_5de78da3aabb9'),(177548,2652,'sec_2_text_copy',''),(177549,2652,'_sec_2_text_copy','field_5de78dc89e613'),(177550,2652,'timeline-title','Timeline'),(177551,2652,'_timeline-title','field_5de78df29e615'),(177552,2652,'timeline_title','Timeline'),(177553,2652,'_timeline_title','field_5de78df29e615'),(177554,2652,'contact_title','Contact us'),(177555,2652,'_contact_title','field_5de7981e06057'),(177556,2652,'contact_intro','Contact text...'),(177557,2652,'_contact_intro','field_5de7983506058'),(177558,2652,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(177559,2652,'_news_button','field_5de8329896e02'),(177560,2652,'timeline_intro','Introduction of timeline detail...'),(177561,2652,'_timeline_intro','field_5de98f5fb1781'),(177562,2652,'timeline_pic','477'),(177563,2652,'_timeline_pic','field_5de98f72b1782'),(177564,2652,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(177565,2652,'_timeline_button','field_5de99363677f8'),(177566,2652,'banner_image_position','center'),(177567,2652,'_banner_image_position','field_5f3bc4757dd02'),(177568,2652,'services_title','Our services'),(177569,2652,'_services_title','field_5f20f3cd80eb2'),(177570,2652,'services_items_0_services_item_image','1061'),(177571,2652,'_services_items_0_services_item_image','field_5f2121355be14'),(177572,2652,'services_items_0_sservices_item_title','1300 Telephone counselling line'),(177573,2652,'_services_items_0_sservices_item_title','field_605089efca82e'),(177574,2652,'services_items_0_services_item_text',''),(177575,2652,'_services_items_0_services_item_text','field_5f2121535be15'),(177576,2652,'services_items_0_services_