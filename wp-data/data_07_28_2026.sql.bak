_6294564042238'),(123085,2164,'survey_index_6_survey_url','#'),(123086,2164,'_survey_index_6_survey_url','field_6294564e42239'),(123087,2164,'survey_index_6_survey_url_text','View Results'),(123088,2164,'_survey_index_6_survey_url_text','field_629456584223a'),(123089,2164,'survey_index_7_survey_icon','1493'),(123090,2164,'_survey_index_7_survey_icon','field_6294562942237'),(123091,2164,'survey_index_7_survey_title','Going Off-grid'),(123092,2164,'_survey_index_7_survey_title','field_6294564042238'),(123093,2164,'survey_index_7_survey_url','#'),(123094,2164,'_survey_index_7_survey_url','field_6294564e42239'),(123095,2164,'survey_index_7_survey_url_text','View Results'),(123096,2164,'_survey_index_7_survey_url_text','field_629456584223a'),(123097,2164,'survey_index','8'),(123098,2164,'_survey_index','field_6294561242236'),(123099,2164,'report_title','Download the report'),(123100,2164,'_report_title','field_62f30edfb57e1'),(123101,2164,'report_intro','Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus massa erat, consectetur at semper at, feugiat vel orci. '),(123102,2164,'_report_intro','field_62f30eedb57e2'),(123103,2164,'report_link_url','#'),(123104,2164,'_report_link_url','field_62f30ef4b57e3'),(123105,2164,'report_link_text','Download'),(123106,2164,'_report_link_text','field_62f30f01b57e4'),(123107,2164,'solutions_content','The housing system is complex, and no one solution will solve the complex problems we now face but there are some critical first steps to be taken now.\r\n<ul>\r\n 	<li>Set out an ambitious national housing agreement between commonwealth and state governments with targets and funding for the construction of affordable homes.</li>\r\n 	<li>Phase out tax breaks for property investors and using the increase in revenue to build more public housing.</li>\r\n 	<li>Establish laws which limit rental increases beyond what is fair.</li>\r\n 	<li>Rebalance tenancy laws to provide renters with more security and control, such as eliminating no grounds evictions.</li>\r\n 	<li>Phase out stamp duty and replace it with a broad-based land tax.</li>\r\n</ul>\r\n<h4>While there are many opinions on what policy changes will fix the housing market, doing nothing is not an option.</h4>'),(123108,2164,'_solutions_content','field_640e8b307a958'),(123109,2164,'problem_icons_0_prob_icon','1699'),(123110,2164,'_problem_icons_0_prob_icon','field_640fa0291d519'),(123111,2164,'problem_icons_0_prob_concerned_stat','70% highly concerned'),(123112,2164,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(123113,2164,'problem_icons_0_prob_concerded_text','are highly concerned'),(123114,2164,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(123115,2164,'problem_icons_0_prob_issue_text',''),(123116,2164,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(123117,2164,'problem_icons','4'),(123118,2164,'_problem_icons','field_640fa0191d518'),(123119,2164,'ceh_content_left',''),(123120,2164,'_ceh_content_left','field_640e97e8f1c8c'),(123121,2164,'ceh_content_right',''),(123122,2164,'_ceh_content_right','field_640e97fdf1c8d'),(123123,2164,'pc_content_left',''),(123124,2164,'_pc_content_left','field_640e983bf1c8f'),(123125,2164,'pc_content_right',''),(123126,2164,'_pc_content_right','field_640e984df1c90'),(123127,2164,'problem_icons_1_prob_icon','1699'),(123128,2164,'_problem_icons_1_prob_icon','field_640fa0291d519'),(123129,2164,'problem_icons_1_prob_concerned_stat','69% highly concerned'),(123130,2164,'_problem_icons_1_prob_concerned_stat','field_640fa0dd81d95'),(123131,2164,'problem_icons_1_prob_concerded_text','are highly concerned'),(123132,2164,'_problem_icons_1_prob_concerded_text','field_640fa10181d96'),(123133,2164,'problem_icons_1_prob_issue_text',''),(123134,2164,'_problem_icons_1_prob_issue_text','field_640fa11a81d97'),(123135,2164,'problem_icons_2_prob_icon','1699'),(123136,2164,'_problem_icons_2_prob_icon','field_640fa0291d519'),(123137,2164,'problem_icons_2_prob_concerned_stat','64% 