upport_left_title','field_5b67c298e7f8f'),(119801,2159,'support_left_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy.'),(119802,2159,'_support_left_cont','field_5b67c5f6e7f91'),(119803,2159,'support_left_button','<a class=\"btn btn-green\" href=\"/services/\">View all services</a>'),(119804,2159,'_support_left_button','field_5b67c60ae7f92'),(119805,2159,'support_ctr_title','Talk to us'),(119806,2159,'_support_ctr_title','field_5b67c62a58af3'),(119807,2159,'support_ctr_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut laoreet.'),(119808,2159,'_support_ctr_cont','field_5b67c63158af4'),(119809,2159,'support_ctr_button','<a class=\"btn btn-orange\" href=\"/supports/\">Find us</a>'),(119810,2159,'_support_ctr_button','field_5b67c63658af5'),(119811,2159,'support_right_title','NDIS Registered provider'),(119812,2159,'_support_right_title','field_5b67c6a38c064'),(119813,2159,'support_right_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut.'),(119814,2159,'_support_right_cont','field_5b67c6c98c065'),(119815,2159,'support_right_button','<a class=\"btn btn-blue\" href=\"#\">Read more</a>'),(119816,2159,'_support_right_button','field_5b67c6dd8c066'),(119817,2159,'first_image_title','Lifestart is about supporting young children'),(119818,2159,'_first_image_title','field_5b67ca606afc4'),(119819,2159,'first_image_cont','from 0-24 years living with disabilities and their familes'),(119820,2159,'_first_image_cont','field_5b67caff6afc5'),(119821,2159,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(119822,2159,'_first_image_button','field_5b67cb0d6afc6'),(119823,2159,'second _image_title','Lifestart is about supporting young children'),(119824,2159,'_second _image_title','field_5b67cb20ddf9a'),(119825,2159,'second_image_cont','from 0-24 years living with disabilities and their familes'),(119826,2159,'_second_image_cont','field_5b67cb24ddf9b'),(119827,2159,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(119828,2159,'_second_image_button','field_5b67cb29ddf9c'),(119829,2159,'second_image_title','Lifestart is about supporting young children'),(119830,2159,'_second_image_title','field_5b67cb20ddf9a'),(119831,2159,'page_col_image','412'),(119832,2159,'_page_col_image','field_5de6546e7c63a'),(119833,2159,'page_col_image_3','437'),(119834,2159,'_page_col_image_3','field_5de6e3998e07e'),(119835,2159,'sec_2_title','Community'),(119836,2159,'_sec_2_title','field_5de6e3ef2798f'),(119837,2159,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(119838,2159,'_sec_2_text','field_5de78dc89e613'),(119839,2159,'sec_3_title','The Project'),(119840,2159,'_sec_3_title','field_5de6e3d37d8da'),(119841,2159,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(119842,2159,'_sec_3_text','field_5de6e4044e5e8'),(119843,2159,'page_col_image_2','436'),(119844,2159,'_page_col_image_2','field_5de6546e7c63a'),(119845,2159,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(119846,2159,'_sec_2_button','field_5de6e58c86706'),(119847,2159,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(119848,2159,'_sec_3_button','field_5de6e5a243c03'),(119849,2159,'page_col_image_4','455'),(119850,2159,'_page_col_image_4','field_5de70801090ce'),(119851,2159,'sec_4_title','Location'),(119852,2159,'_sec_4_title','field_5de7082a12a81'),(119853,2159,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(119854,2159,'_sec_4_text','field_5de7084812a82'),(119855,2159,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(119856,2159,'_sec_4_button','field_5de7085e12a83'),(119857,2159,'news_title','Project updates'),(119858,2159,'_news_title','field_5de78da3aabb9'),(119859,2159,'sec_2_text_copy',''),(119860,2159,'_sec_2_text_copy','field_5de78dc89e613'),(119861,2159,'timeline-title','Timeline'),(119862,2159,'_timeline-title','field_5de78df29e615'),(119863,2159,'timeline_title','Timeline'),(119864,2159,'_timeline_title','field_5de78df29e615'),(119865,2159,'contact_title','Contact us'),(119866,2159,'_contact_title','field_5de7981e06057'),(119867,2159,'contact_intro','Contact text...'),(119868,2159,'_contact_intro','field_5de7983506058'),(119869,2159,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(119870,2159,'_news_button','field_5de8329896e02'),(119871,2159,'timeline_intro','Introduction of timeline detail...'),(119872,2159,'_timeline_intro','field_5de98f5fb1781'),(119873,2159,'timeline_pic','477'),(119874,2159,'_timeline_pic','field_5de98f72b1782'),(119875,2159,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(119876,2159,'_timeline_button','field_5de99363677f8'),(119877,2159,'banner_image_position','center'),(119878,2159,'_banner_image_position','field_5f3bc4757dd02'),(119879,2159,'services_title','Our services'),(119880,2159,'_services_title','field_5f20f3cd80eb2'),(119881,2159,'services_items_0_services_item_image','