21,'_report_link_url','field_62f30ef4b57e3'),(197561,2721,'report_link_text','Download'),(197562,2721,'_report_link_text','field_62f30f01b57e4'),(197563,2721,'solutions_content','The housing system is complex, and no one solution will solve the complex problems we now face but there are some critical first steps to be taken now.\r\n<ul>\r\n 	<li>Set out an ambitious national housing agreement between commonwealth and state governments with targets and funding for the construction of affordable homes.</li>\r\n 	<li>Phase out tax breaks for property investors and using the increase in revenue to build more public housing.</li>\r\n 	<li>Establish laws which limit rental increases beyond what is fair.</li>\r\n 	<li>Rebalance tenancy laws to provide renters with more security and control, such as eliminating no grounds evictions.</li>\r\n 	<li>Phase out stamp duty and replace it with a broad-based land tax.</li>\r\n</ul>\r\n<h4>While there are many opinions on what policy changes will fix the housing market, doing nothing is not an option.</h4>'),(197564,2721,'_solutions_content','field_640e8b307a958'),(197565,2721,'problem_icons_0_prob_icon','1699'),(197566,2721,'_problem_icons_0_prob_icon','field_640fa0291d519'),(197567,2721,'problem_icons_0_prob_concerned_stat','70% highly concerned'),(197568,2721,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(197569,2721,'problem_icons_0_prob_concerded_text','are highly concerned'),(197570,2721,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(197571,2721,'problem_icons_0_prob_issue_text',''),(197572,2721,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(197573,2721,'problem_icons','4'),(197574,2721,'_problem_icons','field_640fa0191d518'),(197575,2721,'ceh_content_left',''),(197576,2721,'_ceh_content_left','field_640e97e8f1c8c'),(197577,2721,'ceh_content_right',''),(197578,2721,'_ceh_content_right','field_640e97fdf1c8d'),(197579,2721,'pc_content_left',''),(197580,2721,'_pc_content_left','field_640e983bf1c8f'),(197581,2721,'pc_content_right',''),(197582,2721,'_pc_content_right','field_640e984df1c90'),(197583,2721,'problem_icons_1_prob_icon','1699'),(197584,2721,'_problem_icons_1_prob_icon','field_640fa0291d519'),(197585,2721,'problem_icons_1_prob_concerned_stat','69% highly concerned'),(197586,2721,'_problem_icons_1_prob_concerned_stat','field_640fa0dd81d95'),(197587,2721,'problem_icons_1_prob_concerded_text','are highly concerned'),(197588,2721,'_problem_icons_1_prob_concerded_text','field_640fa10181d96'),(197589,2721,'problem_icons_1_prob_issue_text',''),(197590,2721,'_problem_icons_1_prob_issue_text','field_640fa11a81d97'),(197591,2721,'problem_icons_2_prob_icon','1699'),(197592,2721,'_problem_icons_2_prob_icon','field_640fa0291d519'),(197593,2721,'problem_icons_2_prob_concerned_stat','64% highly concerned'),(197594,2721,'_problem_icons_2_prob_concerned_stat','field_640fa0dd81d95'),(197595,2721,'problem_icons_2_prob_concerded_text','are highly concerned'),(197596,2721,'_problem_icons_2_prob_concerded_text','field_640fa10181d96'),(197597,2721,'problem_icons_2_prob_issue_text',''),(197598,2721,'_problem_icons_2_prob_issue_text','field_640fa11a81d97'),(197599,2721,'problem_icons_3_prob_icon','1699'),(197600,2721,'_problem_icons_3_prob_icon','field_640fa0291d519'),(197601,2721,'problem_icons_3_prob_concerned_stat','64% highly concerned'),(197602,2721,'_problem_icons_3_prob_concerned_stat','field_640fa0dd81d95'),(197603,2721,'problem_icons_3_prob_concerded_text','are highly concerned'),(197604,2721,'_problem_icons_3_prob_concerded_text','field_640fa10181d96'),(197605,2721,'problem_icons_3_prob_issue_text',''),(197606,2721,'_problem_icons_3_prob_issue_text','field_640fa11a81d97'),(197607,2721,'problem_icons_0_prob_concerned_text','House prices have doubled in a decade'),(197608,2721,'_problem_icons_0_prob_concerned_text','field_640fa10181d96'),(197609,2721,'problem_icons_1_prob_concerned_text','The gap between rich and poor is growing'),(197610,2721,'_problem_icons_1_prob_concerned_text','field_640fa10181d96'),(197611,2721,'problem_icons_2_prob_concerned_text','Construction of social housing is down'),(197612,2721,'_problem_icons_2_prob_concerned_text','field_640fa10181d96'),(197613,2721,'problem_icons_3_prob_concerned_text','Banks are making more than ever from housing'),(197614,2721,'_problem_icons_3_prob_concerned_text','field_640fa10181d96'),(197615,2721,'monitor_content','The Australian Housing Monitor is a large, nationally-representative survey covering public experiences and attitudes toward housing related issues. Questions range from how well the respondent is keeping up with their mortgage/rent, to what they think about social housing construction.\r\n\r\nA broad range of demographic criteria are included, such as gender, location, age, income, voting preference, educational level, tenure type, and employment status. These variables allow CEH researchers to understand the trends and diversity of opinion around the country.\r\n\r\nIt also incorporates questions from previous surveys to track trends over time.\r\nThe inaugural poll was conducted by Essential in December 2022, and was completed by 4,735 people.'),(197616,2721,'_monitor_content','field_640fcc4014404'),(197617,2721,'problem_head','Housing in Australia is not working, and Australians are concerned.'),(197618,2721,'_problem_head','field_641935436aded'),(197619,2721,'problem_signoff','Explore the research showing how concerned Australians are our about the housing situation.'),(197620,2721,'_problem_signoff','field_641935626adee'),(197621,2721,'sections','a:2:{i:0;s:4:\"hero\";i:1;s:9:\"news_grid\";}'),(197622,2721,'_sections','field_5dafb40b8143a'),(197623,2721,'sections_0_is_full_height','1'),(197624,2721,'_sections_0_is_full_height','field_61d6f6fd5a37e'),(197625,2721,'sections_0_image','1648'),(197626,2721,'_sections_0_image','field_61d6f6d45a37d'),(197627,2721,'sections_0_heading','Heading'),(197628,2721,'_sections_0_heading','field_61d6f69e5a379'