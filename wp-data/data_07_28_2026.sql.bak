4573,1704,'_report_link_text','field_62f30f01b57e4'),(54574,1704,'solutions_content','The housing system is complex, and no one solution will solve the complex problems we now face but there are some critical first steps to be taken now.\r\n<ul>\r\n 	<li>Set out an ambitious national housing agreement between commonwealth and state governments with targets and funding for the construction of affordable homes.</li>\r\n 	<li>Phase out tax breaks for property investors and using the increase in revenue to build more public housing.</li>\r\n 	<li>Establish laws which limit rental increases beyond what is fair.</li>\r\n 	<li>Rebalance tenancy laws to provide renters with more security and control, such as eliminating no grounds evictions.</li>\r\n 	<li>Phase out stamp duty and replace it with a broad-based land tax.</li>\r\n</ul>\r\n<h4>While there are many opinions on what policy changes will fix the housing market, doing nothing is not an option.</h4>'),(54575,1704,'_solutions_content','field_640e8b307a958'),(54576,1704,'problem_icons_0_prob_icon','1699'),(54577,1704,'_problem_icons_0_prob_icon','field_640fa0291d519'),(54578,1704,'problem_icons_0_prob_concerned_stat','70%'),(54579,1704,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(54580,1704,'problem_icons_0_prob_concerded_text','are highly concerned'),(54581,1704,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(54582,1704,'problem_icons_0_prob_issue_text','House prices have doubled in a decade'),(54583,1704,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(54584,1704,'problem_icons','4'),(54585,1704,'_problem_icons','field_640fa0191d518'),(54586,1704,'ceh_content_left',''),(54587,1704,'_ceh_content_left','field_640e97e8f1c8c'),(54588,1704,'ceh_content_right',''),(54589,1704,'_ceh_content_right','field_640e97fdf1c8d'),(54590,1704,'pc_content_left',''),(54591,1704,'_pc_content_left','field_640e983bf1c8f'),(54592,1704,'pc_content_right',''),(54593,1704,'_pc_content_right','field_640e984df1c90'),(54594,1704,'problem_icons_1_prob_icon','1699'),(54595,1704,'_problem_icons_1_prob_icon','field_640fa0291d519'),(54596,1704,'problem_icons_1_prob_concerned_stat','69%'),(54597,1704,'_problem_icons_1_prob_concerned_stat','field_640fa0dd81d95'),(54598,1704,'problem_icons_1_prob_concerded_text','are highly concerned'),(54599,1704,'_problem_icons_1_prob_concerded_text','field_640fa10181d96'),(54600,1704,'problem_icons_1_prob_issue_text','The gap between rich and poor is growing'),(54601,1704,'_problem_icons_1_prob_issue_text','field_640fa11a81d97'),(54602,1704,'problem_icons_2_prob_icon','1699'),(54603,1704,'_problem_icons_2_prob_icon','field_640fa0291d519'),(54604,1704,'problem_icons_2_prob_concerned_stat','64%'),(54605,1704,'_problem_icons_2_prob_concerned_stat','field_640fa0dd81d95'),(54606,1704,'problem_icons_2_prob_concerded_text','are highly concerned'),(54607,1704,'_problem_icons_2_prob_concerded_text','field_640fa10181d96'),(54608,1704,'problem_icons_2_prob_issue_text','Public and social housing construction is down'),(54609,1704,'_problem_icons_2_prob_issue_text','field_640fa11a81d97'),(54610,1704,'problem_icons_3_prob_icon','1699'),(54611,1704,'_problem_icons_3_prob_icon','field_640fa0291d519'),(54612,1704,'problem_icons_3_prob_concerned_stat','64%'),(54613,1704,'_problem_icons_3_prob_concerned_stat','field_640fa0dd81d95'),(54614,1704,'problem_icons_3_prob_concerded_text','are highly concerned'),(54615,1704,'_problem_icons_3_prob_concerded_text','field_640fa10181d96'),(54616,1704,'problem_icons_3_prob_issue_text','Banks are making more from housing than ever'),(54617,1704,'_problem_icons_3_prob_issue_text','field_640fa11a81d97'),(54618,1704,'problem_icons_0_prob_concerned_text','are highly concerned'),(54619,1704,'_problem_icons_0_prob_concerned_text','field_640fa10181d96'),(54620,1704,'problem_icons_1_prob_concerned_text','are highly concerned'),(54621,1704,'_problem_icons_1_prob_concerned_text','field_640fa10181d96'),(54622,1704,'problem_icons_2_prob_concerned_text','are highly concerned'),(54623,1704,'_problem_icons_2_prob_concerned_text','field_640fa10181d96'),(54624,1704,'problem_icons_3_prob_concerned_text','are highly concerned'),(54625,1704,'_problem_icons_3_prob_concerned_text','field_640fa10181d96'),(54638,6,'monitor_content','The Australian Housing Monitor is a large, nationally-representative survey covering public experiences and attitudes toward housing related issues. Questions range from how well the respondent is keeping up with their mortgage/rent, to what they think about social housing construction.\r\n\r\nA broad range of demographic criteria are included, such as gender, location, age, income, voting preference, educational level, tenure type, and employment status. These variables allow CEH researchers to understand the trends and diversity of opinion around the country.\r\n\r\nIt also incorporates questions from previous surveys to track trends over time.\r\nThe inaugural poll was conducted by Essential in December 2022, and was completed by 4,735 people.'),(54639,6,'_monitor_content','field_640fcc4014404'),(54640,1722,'banner_head',''),(54641,1722,'_banner_head','field_5b568121a8ffe'),(54642,1722,'banner_sub',''),(54643,1722,'_banner_sub','field_5b568139fd366'),(54644,1722,'banner_button','<a class=\"btn btn-home\" style=\"width: 200px;\" href=\"#project\">Sign the petition</a>'),(54645,1722,'_banner_button','field_5b568147fd367'),(54646,1722,'support_section_title','How can Lifestart support you?'),(54647,1722,'_support_section_title','field_5b67c7d060398'),(54648,1722,'support_left_title','Services'),(54649,1722,'_support_left_title','field_5b67c298e7f8f'),(54650,1722,'support_left_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy.'),(54651,1722,'_support_left_cont','field_5b67c5f6e7f91'),(54652,1722,'support_left_button','<a class=\"btn btn-green\" href=\"/services/\">View all services</a>'),(54653,1722,'_support_left_button','field_5b67c60ae7f92'),(54654,1722,'support_ctr_title','Talk to us'),(54655,1722,'_support_ctr_title','field_5b67c62a58af3'),(54656,1722,'support_ctr_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut laoreet.'),(54657,1722,'_support_ctr_cont','field_5b67c63158af4'),(54658,1722,'support_ctr_button','<a class=\"btn btn-orange\" href=\"/supports/\">Find us</a>'),(54659,1722,'_support_ctr_button','field_5b67c63658af5'),(54660,1722,'support_right_title','NDIS Registered provider'),(54661,1722,'_support_right_title','field_5b67c6a38c064'),(54662,1722,'support_right_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut.'),(54663,1722,'_support_right_cont','field_5b67c6c98c065'),(54664,1722,'support_right_button','<a class=\"btn btn-blue\" href=\"#\">Read more</a>'),(54665,1722,'_support_right_button','field_5b67c6dd8c066'),(54666,1722,'first_image_title','Lifestart is about supporting young children'),(54667,1722,'_first_image_title','field_5b67ca606afc4'),(54668,1722,'first_image_cont','from 0-24 years living with disabilities and their familes'),(54669,1722,'_first_image_cont','field_5b67caff6afc5'),(54670,1722,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(54671,1722,'_first_image_button','field_5b67cb0d6afc6'),(54672,1722,'second _image_title','Lifestart is about supporting young children'),(54673,1722,'_second _image_title','field_5b67cb20ddf9a'),(54674,1722,'second_image_cont','from 0-24 years living with disabilities and their familes'),(54675,1722,'_second_image_cont','field_5b67cb24ddf9b'),(54676,1722,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(54677,1722,'_second_image_button','field_5b67cb29ddf9c'),(54678,1722,'second_image_title','Lifestart is about supporting young children'),(54679,1722,'_second_image_title','field_5b67cb20ddf9a'),(54680,1722,'page_col_image','412'),(54681,1722,'_page_col_image','field_5de6546e7c63a'),(54682,1722,'page_col_image_3','437'),(54683,1722,'_page_col_image_3','field_5de6e3998e07e'),(54684,1722,'sec_2_title','Community'),(54685,1722,'_sec_2_title','field_5de6e3ef2798f'),(54686,1722,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(54687,1722,'_sec_2_text','field_5de78dc89e613'),(54688,1722,'sec_3_title','The Project'),(54689,1722,'_sec_3_title','field_5de6e3d37d8da'),(54690,1722,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(54691,1722,'_sec_3_text','field_5de6e4044e5e8'),(54692,1722,'page_col_image_2','436'),(54693,1722,'_page_col_image_2','field_5de6546e7c63a'),(54694,1722,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(54695,1722,'_sec_2_button','field_5de6e58c86706'),(54696,1722,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(54697,1722,'_sec_3_button','field_5de6e5a243c03'),(54698,1722,'page_col_image_4','455'),(54699,1722,'_page_col_image_4','field_5de70801090ce'),(54700,1722,'sec_4_title','Location'),(54701,1722,'_sec_4_title','field_5de7082a12a81'),(54702,1722,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(54703,1722,'_sec_4_text','field_5de7084812a82'),(54704,1722,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(54705,1722,'_sec_4_button','field_5de7085e12a83'),(54706,1722,'news_title','Project updates'),(54707,1722,'_news_title','field_5de78da3aabb9'),(54708,1722,'sec_2_text_copy',''),(54709,1722,'_sec_2_text_copy','field_5de78dc89e613'),(54710,1722,'timeline-title','Timeline'),(54711,1722,'_timeline-title','field_5de78df29e615'),(54712,1722,'timeline_title','Timeline'),(54713,1722,'_timeline_title','field_5de78df29e615'),(54714,1722,'contact_title','Contact us'),(54715,1722,'_contact_title','field_5de7981e06057'),(54716,1722,'contact_intro','Contact text...'),(54717,1722,'_contact_intro','field_5de7983506058'),(54718,1722,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(54719,1722,'_news_button','field_5de8329896e02'),(54720,1722,'timeline_intro','Introduction of timeline detail...'),(54721,1722,'_timeline_intro','field_5de98f5fb1781'),(54722,1722,'timeline_pic','477'),(54723,1722,'_timeline_pic','field_5de98f72b1782'),(54724,1722,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(54725,1722,'_timeline_button','field_5de99363677f8'),(54726,1722,'banner_image_position','center'),(54727,1722,'_banner_image_position','field_5f3bc4757dd02'),(54728,1722,'services_title','Our services'),(54729,1722,'_services_title','field_5f20f3cd80eb2'),(54730,1722,'services_items_0_services_item_image','1061'),(54731,1722,'_services_items_0_services_item_image','field_5f2121355be14'),(54732,1722,'services_items_0_sservices_item_title','1300 Telephone counselling line'),(54733,1722,'_services_items_0_sservices_item_title','field_605089efca82e'),(54734,1722,'services_items_0_services_item_text',''),(54735,1722,'_services_items_0_services_item_text','field_5f2121535be15'),(54736,1722,'services_items_0_services_link_url','#'),(54737,1722,'_services_ite