ey_index_7_survey_title','field_6294564042238'),(59074,1808,'survey_index_7_survey_url','#'),(59075,1808,'_survey_index_7_survey_url','field_6294564e42239'),(59076,1808,'survey_index_7_survey_url_text','View Results'),(59077,1808,'_survey_index_7_survey_url_text','field_629456584223a'),(59078,1808,'survey_index','8'),(59079,1808,'_survey_index','field_6294561242236'),(59080,1808,'report_title','Download the report'),(59081,1808,'_report_title','field_62f30edfb57e1'),(59082,1808,'report_intro','Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus massa erat, consectetur at semper at, feugiat vel orci. '),(59083,1808,'_report_intro','field_62f30eedb57e2'),(59084,1808,'report_link_url','#'),(59085,1808,'_report_link_url','field_62f30ef4b57e3'),(59086,1808,'report_link_text','Download'),(59087,1808,'_report_link_text','field_62f30f01b57e4'),(59088,1808,'solutions_content','The housing system is complex, and no one solution will solve the complex problems we now face but there are some critical first steps to be taken now.\r\n<ul>\r\n 	<li>Set out an ambitious national housing agreement between commonwealth and state governments with targets and funding for the construction of affordable homes.</li>\r\n 	<li>Phase out tax breaks for property investors and using the increase in revenue to build more public housing.</li>\r\n 	<li>Establish laws which limit rental increases beyond what is fair.</li>\r\n 	<li>Rebalance tenancy laws to provide renters with more security and control, such as eliminating no grounds evictions.</li>\r\n 	<li>Phase out stamp duty and replace it with a broad-based land tax.</li>\r\n</ul>\r\n<h4>While there are many opinions on what policy changes will fix the housing market, doing nothing is not an option.</h4>'),(59089,1808,'_solutions_content','field_640e8b307a958'),(59090,1808,'problem_icons_0_prob_icon','1699'),(59091,1808,'_problem_icons_0_prob_icon','field_640fa0291d519'),(59092,1808,'problem_icons_0_prob_concerned_stat','70% highly concerned'),(59093,1808,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(59094,1808,'problem_icons_0_prob_concerded_text','are highly concerned'),(59095,1808,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(59096,1808,'problem_icons_0_prob_issue_text',''),(59097,1808,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(59098,1808,'problem_icons','4'),(59099,1808,'_problem_icons','field_640fa0191d518'),(59100,1808,'ceh_content_left',''),(59101,1808,'_ceh_content_left','field_640e97e8f1c8c'),(59102,1808,'ceh_content_right',''),(59103,1808,'_ceh_content_right','field_640e97fdf1c8d'),(59104,1808,'pc_content_left',''),(59105,1808,'_pc_content_left','field_640e983bf1c8f'),(59106,1808,'pc_content_right',''),(59107,1808,'_pc_content_right','field_640e984df1c90'),(59108,1808,'problem_icons_1_prob_icon','1699'),(59109,1808,'_problem_icons_1_prob_icon','field_640fa0291d519'),(59110,1808,'problem_icons_1_prob_concerned_stat','69% highly concerned'),(59111,1808,'_problem_icons_1_prob_concerned_stat','field_640fa0dd81d95'),(59112,1808,'problem_icons_1_prob_concerded_text','are highly concerned'),(59113,1808,'_problem_icons_1_prob_concerded_text','field_640fa10181d96'),(59114,1808,'problem_icons_1_prob_issue_text',''),(59115,1808,'_problem_icons_1_prob_issue_text','field_640fa11a81d97'),(59116,1808,'problem_icons_2_prob_icon','1699'),(59117,1808,'_problem_icons_2_prob_icon','field_640fa0291d519'),(59118,1808,'problem_icons_2_prob_concerned_stat','64% highly concerned'),(59119,1808,'_problem_icons_2_prob_concerned_stat','field_640fa0dd81d95'),(59120,1808,'problem_icons_2_prob_concerded_text','are highly concerned'),(59121,1808,'_problem_icons_2_prob_concerded_text','field_640fa10181d96'),(59122,1808,'problem_icons_2_prob_issue_text',''),(59123,1808,'_problem_icons_2_prob_issue_text','field_640fa11a81d97'),(59124,1808,'problem_icons_3_prob_icon','1699'),(59125,1808,'_problem_icons_3_prob_icon','field_640fa0291d519'),(59126,1808,'problem_icons_3_prob_concerned_stat','64% highly concerned'),(59127,1808,'_problem_icons_3_prob_concerned_stat','field_640fa0dd81d95'),(59128,1808,'problem_icons_3_prob_concerded_text','are highly concerned'),(59129,1808,'_problem_icons_3_prob_concerded_text','field_640fa10181d96'),(59130,1808,'problem_icons_3_prob_issue_text',''),(59131,1808,'_problem_icons_3_prob_issue_text','field_640fa11a81d97'),(59132,1808,'problem_icons_0_prob_concerned_text','House prices have doubled in a decade'),(59133,1808,'_problem_icons_0_prob_concerned_text','field_640fa10181d96'),(59134,1808,'problem_icons_1_prob_concerned_text','The gap between rich and poor is growing'),(59135,1808,'_problem_icons_1_prob_concerned_text','field_640fa10181d96'),(59136,1808,'problem_icons_2_prob_concerned_text','Construction of social housing is down'),(59137,1808,'_problem_icons_2_prob_concerned_text','field_640fa10181d96'),(59138,1808,'problem_icons_3_prob_concerned_text','Banks are making more than ever from housing'),(59139,1808,'_problem_icons_3_prob_concerned_text','field_640fa10181d96'),(59140,1808,'monitor_content','The Australian Housing Monitor is a large, nationally-representative survey covering public experiences and attitudes toward housing related issues. Questions range from how well the respondent is keeping up with their mortgage/rent, to what they think about social housing construction.\r\n\r\nA broad range of demographic criteria are included, such as gender, location, age, income, voting preference, educational level, tenure type, and employment status. These variables allow CEH researchers to understand the trends and diversity of opinion around the country.\r\n\r\nIt also incorporates questions from previous surveys to track trends over time.\r\nThe inaugural poll was conducted by Essential in December 2022, and was completed by 4,735 people.'),(59141,1808,'_monitor_content','field_640fcc4014404'),(59142,1808,'problem_head','Housing in Australia is not working, and Australians are concerned.'),(59143,1808,'_problem_head','field_641935436aded'),(59144,1808,'problem_signoff','Explore the research showing how concerned Australians are our about the housing situation.'),(59145,1808,'_problem_signoff','field_641935626adee'),(59146,1808,'sections','a:2:{i:0;s:4:\"hero\";i:1;s:9:\"news_grid\";}'),(59147,1808,'_sections','field_5dafb40b8143a'),(59148,1808,'sections_0_is_full_height','1'),(59149,1808,'_sections_0_is_full_height','field_61d6f6fd5a37e'),(59150,1808,'sections_0_image','1648'),(59151,1808,'_sections_0_image','field_61d6f6d45a37d'),(59152,1808,'sections_0_heading','Heading'),(59153,1808,'_sections_0_heading','field_61d6f69e5a379'),(59154,1808,'sections_0_subtitle','Ya ya '),(59155,1808,'_sections_0_subtitle','field_61d6f6ac5a37a'),(59156,1808,'sections_0_link_one',''),(59157,1808,'_sections_0_link_one','field_61d6f6b55a37b'),(59158,1808,'sections_0_link_two',''),(59159,1808,'_sections_0_link_two','field_61d6f6c35a37c'),(59160,1808,'sections_1_select_categories','a:1:{i:0;s:2:\"27\";}'),(59161,1808,'_sections_1_select_categories','field_637f04483b63b'),(59162,1808,'intro_head_major','Queenslanders are known for both our love of the great outdoors and our state pride…'),(59163,1808,'_intro_head_major','field_64e828783ad9f'),(59164,1808,'intro_head_minor','But there’s a few things you might not know about our beautiful state.'),(59165,1808,'_intro_head_minor','field_64e8288c3ada0'),(59166,1808,'intro_icons_0_int_icon','1806'),(59167,1808,'_intro_icons_0_int_icon','field_64e828b33ada2'),(59168,1808,'intro_icons_0_int_icon_text','At 1,727,000 square kilometres, we’re 2.5 times the size of Texas. Yeeha!'),(59169,1808,'_intro_icons_0_int_icon_text','field_64e828e33ada3'),(59170,1808,'intro_icons_1_int_icon','1806'),(59171,1808,'_intro_icons_1_int_icon','field_64e828b33ada2'),(59172,1808,'intro_icons_1_int_icon_text','We have twice as many species of native plant and animal as any other Australian state or territory.'),(59173,1808,'_intro_icons_1_int_icon_text','field_64e828e33ada3'),(59174,1808,'intro_icons_2_int_icon','1806'),(59175,1808,'_intro_icons_2_int_icon','field_64e828b33ada2'),(59176,1808,'intro_icons_2_int_icon_text','We have less land classified as ‘protected’ than any other state or territory.'),(59177,1808,'_intro_icons_2_int_icon_text','field_64e828e33ada3'),(59178,1808,'intro_icons','3'),(59179,1808,'_intro_icons','field_64e828963ada1'),(59184,1811,'_wp_attached_file','2023/08/Scenic-Rim-Trail-Hero.jpg'),(59185,1811,'_wp_attachment_metadata','a:6:{s:5:\"width\";i:1964;s:6:\"height\";i:829;s:4:\"file\";s:33:\"2023/08/Scenic-Rim-Trail-Hero.jpg\";s:8:\"filesize\";i:1259949;s:5:\"sizes\";a:6:{s:6:\"medium\";a:5:{s:4:\"file\";s:33:\"Scenic-Rim-Trail-Hero-700x295.jpg\";s:5:\"width\";i:700;s:6:\"height\";i:295;s:9:\"mime-type\";s:10:\"image/jpeg\";s:8:\"filesize\";i:79533;}s:5:\"large\";a:5:{s:4:\"file\";s:34:\"Scenic-Rim-Trail-Hero-1024x432.jpg\";s:5:\"width\";i:1024;s:6:\"height\";i:432;s:9:\"mime-type\";s:10:\"image/jpeg\";s:8:\"filesize\";i:173942;}s:9:\"thumbnail\";a:5:{s:4:\"file\";s:33:\"Scenic-Rim-Trail-Hero-450x450.jpg\";s:5:\"width\";i:450;s:6:\"height\";i:450;s:9:\"mime-type\";s:10:\"image/jpeg\";s:8:\"filesize\";i:89567;}s:12:\"medium_large\";a:5:{s:4:\"file\";s:33:\"Scenic-Rim-Trail-Hero-768x324.jpg\";s:5:\"width\";i:768;s:6:\"height\";i:324;s:9:\"mime-type\";s:10:\"image/jpeg\";s:8:\"filesize\";i:96394;}s:9:\"1536x1536\";a:5:{s:4:\"file\";s:34:\"Scenic-Rim-Trail-Hero-1536x648.jpg\";s:5:\"width\";i:1536;s:6:\"height\";i:648;s:9:\"mime-type\";s:10:\"image/jpeg\";s:8:\"filesize\";i:397677;}s:4:\"news\";a:5:{s:4:\"file\";s:33:\"Scenic-Rim-Trail-Hero-565x367.jpg\";s:5:\"width\";i:565;s:6:\"height\";i:367;s:9:\"mime-type\";s:10:\"image/jpeg\";s:8:\"filesize\";i:88080;}}s:10:\"image_meta\";a:12:{s:8:\"aperture\";s:1:\"0\";s:6:\"credit\";s:0:\"\";s:6:\"camera\";s:0:\"\";s:7:\"caption\";s:0:\"\";s:17:\"created_timestamp\";s:1:\"0\";s:9:\"copyright\";s:0:\"\";s:12:\"focal_length\";s:1:\"0\";s:3:\"iso\";s:1