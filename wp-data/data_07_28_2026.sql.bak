66,2734,'_issues_head','field_6a3b076406aef'),(201967,2734,'issues_items_0_issue_icon','2705'),(201968,2734,'_issues_items_0_issue_icon','field_6a3b07b506af1'),(201969,2734,'issues_items_0_issues_item_hd','A secure home is slipping out of reach'),(201970,2734,'_issues_items_0_issues_item_hd','field_6a3b07d706af2'),(201971,2734,'issues_items_0_issues_item_txt','•	A shortage of 132,000 social and affordable rental homes\r\n•	70,000+ households waiting for social housing\r\n•	Record-high private market rents\r\n•	Home ownership increasingly out of reach for generations'),(201972,2734,'_issues_items_0_issues_item_txt','field_6a3b07fc06af3'),(201973,2734,'issues_items_0_issues_link_text',''),(201974,2734,'_issues_items_0_issues_link_text','field_6a3b080f06af4'),(201975,2734,'issues_items_0_issues_target_url',''),(201976,2734,'_issues_items_0_issues_target_url','field_6a3b082b06af5'),(201977,2734,'issues_items','3'),(201978,2734,'_issues_items','field_6a3b078206af0'),(201979,2734,'issues_items_1_issue_icon','2708'),(201980,2734,'_issues_items_1_issue_icon','field_6a3b07b506af1'),(201981,2734,'issues_items_1_issues_item_hd','The solutions we need '),(201982,2734,'_issues_items_1_issues_item_hd','field_6a3b07d706af2'),(201983,2734,'issues_items_1_issues_item_txt','Community housing works. We’re calling on the next NSW Government for three actions: long-term investment for new community housing, more funding to future-proof existing homes, and support to help people stayed housed.'),(201984,2734,'_issues_items_1_issues_item_txt','field_6a3b07fc06af3'),(201985,2734,'issues_items_1_issues_link_text',''),(201986,2734,'_issues_items_1_issues_link_text','field_6a3b080f06af4'),(201987,2734,'issues_items_1_issues_target_url',''),(201988,2734,'_issues_items_1_issues_target_url','field_6a3b082b06af5'),(201989,2734,'issues_items_0_issues_sub_head',''),(201990,2734,'_issues_items_0_issues_sub_head','field_6a3b0aa79365e'),(201991,2734,'issues_items_1_issues_sub_head',''),(201992,2734,'_issues_items_1_issues_sub_head','field_6a3b0aa79365e'),(201993,2734,'issues_items_2_issue_icon','2703'),(201994,2734,'_issues_items_2_issue_icon','field_6a3b07b506af1'),(201995,2734,'issues_items_2_issues_item_hd','The people next door'),(201996,2734,'_issues_items_2_issues_item_hd','field_6a3b07d706af2'),(201997,2734,'issues_items_2_issues_sub_head',''),(201998,2734,'_issues_items_2_issues_sub_head','field_6a3b0aa79365e'),(201999,2734,'issues_items_2_issues_item_txt','Nurses. Childcare workers. Single parents. Older Australians who want to stay near the people they love. Community housing is the solution.'),(202000,2734,'_issues_items_2_issues_item_txt','field_6a3b07fc06af3'),(202001,2734,'issues_items_2_issues_link_text',''),(202002,2734,'_issues_items_2_issues_link_text','field_6a3b080f06af4'),(202003,2734,'issues_items_2_issues_target_url',''),(202004,2734,'_issues_items_2_issues_target_url','field_6a3b082b06af5'),(202005,2734,'video_head','The people next door'),(202006,2734,'_video_head','field_6a5ff269ef234'),(202007,2735,'footnotes',''),(202008,2735,'banner_head',''),(202009,2735,'_banner_head','field_5b568121a8ffe'),(202010,2735,'banner_sub',''),(202011,2735,'_banner_sub','field_5b568139fd366'),(202012,2735,'banner_button','<a class=\"btn btn-home\" style=\"width: 200px;\" href=\"#project\">Sign the petition</a>'),(202013,2735,'_banner_button','field_5b568147fd367'),(202014,2735,'support_section_title','How can Lifestart support you?'),(202015,2735,'_support_section_title','field_5b67c7d060398'),(202016,2735,'support_left_title','Services'),(202017,2735,'_support_left_title','field_5b67c298e7f8f'),(202018,2735,'support_left_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy.'),(202019,2735,'_support_left_cont','field_5b67c5f6e7f91'),(202020,2735,'support_left_button','<a class=\"btn btn-green\" href=\"/services/\">View all services</a>'),(202021,2735,'_support_left_button','field_5b67c60ae7f92'),(202022,2735,'support_ctr_title','Talk to us'),(202023,2735,'_support_ctr_title','field_5b67c62a58af3'),(202024,2735,'support_ctr_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut laoreet.'),(202025,2735,'_support_ctr_cont','field_5b67c63158af4'),(202026,2735,'support_ctr_button','<a class=\"btn btn-orange\" href=\"/supports/\">Find us</a>'),(202027,2735,'_support_ctr_button','field_5b67c63658af5'),(202028,2735,'support_right_title','NDIS Registered provider'),(202029,2735,'_support_right_title','field_5b67c6a38c064'),(202030,2735,'support_right_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut.'),(202031,2735,'_support_right_cont','field_5b67c6c98c065'),(202032,2735,'support_right_button','<a class=\"btn btn-blue\" href=\"#\">Read more</a>'),(202033,2735,'_support_right_button','field_5b67c6dd8c066'),(202034,2735,'first_image_title','Lifestart is about supporting young children'),(202035,2735,'_first_image_title','field_5b67ca606afc4'),(202036,2735,'first_image_cont','from 0-24 years living with disabilities and their familes'),(202037,2735,'_first_image_cont','field_5b67caff6afc5'),(202038,2735,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(202039,2735,'_first_image_button','field_5b67cb0d6afc6'),(202040,2735,'second _image_title','Lifestart is about supporting young children'),(202041,2735,'_second _image_title','field_5b67cb20ddf9a'),(202042,2735,'second_image_cont','from 0-24 years living with disabilities and their familes'),(202043,2735,'_second_image_cont','field_5b67cb24ddf9b'),(202044,2735,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(202045,2735,'_second_image_button','field_5b67cb29ddf9c'),(202046,2735,'second_image_title','Lifestart is about supporting young children'),(202047,2735,'_second_image_title','field_5b67cb20ddf9a'),(202048,2735,'page_col_image','412'),(202049,2735,'_page_col_image','field_5de6546e7c63a'),(202050,2735,'page_col_image_3','437'),(202051,2735,'_page_col_image_3','field_5de6e3998e07e'),(202052,2735,'sec_2_title','Community'),(202053,2735,'_sec_2_title','field_5de6e3ef2798f'),(202054,2735,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(202055,2735,'_sec_2_text','field_5de78dc89e613'),(202056,2735,'sec_3_title','The Project'),(202057,2735,'_sec_3_title','field_5de6e3d37d8da'),(202058,2735,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(202059,2735,'_sec_3_text','field_5de6e4044e5e8'),(202060,2735,'page_col_image_2','436'),(202061,2735,'_page_col_image_2','field_5de6546e7c63a'),(202062,2735,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(202063,2735,'_sec_2_button','field_5de6e58c86706'),(202064,2735,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(202065,2735,'_sec_3_button','field_5de6e5a243c03'),(202066,2735,'page_col_image_4','455'),(202067,2735,'_page_col_image_4','field_5de70801090ce'),(202068,2735,'sec_4_title','Location'),(202069,2735,'_sec_4_title','field_5de7082a12a81'),(202070,2735,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(202071,2735,'_sec_4_text','field_5de7084812a82'),(202072,2735,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(202073,2735,'_sec_4_button','field_5de7085e12a83'),(202074,2735,'news_title','Project updates'),(202075,2735,'_news_title','field_5de78da3aabb9'),(202076,2735,'sec_2_text_copy',''),(202077,2735,'_sec_2_text_copy','field_5de78dc89e613'),(202078,2735,'timeline-title','Timeline'),(202079,2735,'_timeline-title','field_5de78df29e615'),(202080,2735,'timeline_title','Timeline'),(202081,2735,'_timeline_title','field_5de78df29e615'),(202082,2735,'contact_title','Contact us'),(202083,2735,'_contact_title','field_5de7981e06057'),(202084,2735,'contact_intro','Contact text...'),(202085,2735,'_contact_intro','field_5de7983506058'),(202086,2735,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(202087,2735,'_news_button','field_5de8329896e02'),(202088,2735,'timeline_intro','Introduction of timeline detail...'),(202089,2735,'_timeline_intro','field_5de98f5fb1781'),(202090,2735,'timeline_pic','477'),(202091,2735,'_timeline_pic','field_5de98f72b1782'),(202092,2735,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(202093,2735,'_timeline_button','field_5de99363677f8'),(202094,2735,'banner_image_position','center'),(202095,2735,'_banner_image_position','field_5f3bc4757dd02'),(202096,2735,'services_title','Our services'),(202097,2735,'_services_title','field_5f20f3cd80eb2'),(202098,2735,'services_items_0_services_item_image','1061'),(202099,2735,'_services_items_0_services_item_image','field_5f2121355be14'),(202100,2735,'services_items_0_sservices_item_title','1300 Telephone counselling line'),(202101,2735,'_services_items_0_sservices_item_title','field_605089efca82e'),(202102,2735,'services_items_0_services_item_text',''),(202103,2735,'_services_items_0_services_item_text','field_5f2121535be15'),(202104,2735,'services_items_0