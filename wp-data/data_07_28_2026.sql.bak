,'pdf_link','#'),(178181,2652,'_pdf_link','field_6646c6da23805'),(178182,2652,'intro_boxes_0_box_image','2241'),(178183,2652,'_intro_boxes_0_box_image','field_65262db5d36ee'),(178184,2652,'intro_boxes_1_box_image','2179'),(178185,2652,'_intro_boxes_1_box_image','field_65262db5d36ee'),(178186,2652,'intro_boxes_2_box_image','2012'),(178187,2652,'_intro_boxes_2_box_image','field_65262db5d36ee'),(178188,2652,'intro_boxes_0_box_excerpt','Excerpt text here just a sentance or so and no more.'),(178189,2652,'_intro_boxes_0_box_excerpt','field_665975273e827'),(178190,2652,'intro_boxes_1_box_excerpt','Excerpt text here just a sentance or so and no more.'),(178191,2652,'_intro_boxes_1_box_excerpt','field_665975273e827'),(178192,2652,'intro_boxes_2_box_excerpt','Excerpt text here just a sentance or so and no more.'),(178193,2652,'_intro_boxes_2_box_excerpt','field_665975273e827'),(178194,2652,'intro_boxes_0_btn-text','Latest events'),(178195,2652,'_intro_boxes_0_btn-text','field_665abda8b8d4b'),(178196,2652,'intro_boxes_1_btn-text','Latest projects'),(178197,2652,'_intro_boxes_1_btn-text','field_665abda8b8d4b'),(178198,2652,'intro_boxes_2_btn-text','Latest ideas'),(178199,2652,'_intro_boxes_2_btn-text','field_665abda8b8d4b'),(178200,2652,'display-easy-read',''),(178201,2652,'_display-easy-read','field_666129bd2da00'),(178202,2652,'hm_hero_sum','Statement about the issue and lost life savings'),(178203,2652,'_hm_hero_sum','field_64ed37241effa'),(178204,2652,'hm_hero_sub',''),(178205,2652,'_hm_hero_sub','field_64ed37241effa'),(178206,2652,'intro_head','We’re here to help.'),(178207,2652,'_intro_head','field_64e828783ad9f'),(178208,2652,'intro_content','About 12,000 people invested their hard-earned super savings in two investment funds which have now collapsed, called Shield Master Fund and First Guardian Master Fund. Most people will be entitled to get some money back, but you need to take action soon. This website has information and tools to help you understand what happened, where to get help and how to take back your super.'),(178209,2652,'_intro_content','field_66441acfe963c'),(178210,2652,'deadline_heading','Important deadlines'),(178211,2652,'_deadline_heading','field_69365ff82e6f2'),(178212,2652,'deadline_content','You need to take action before the deadline to take your super back.'),(178213,2652,'_deadline_content','field_693660342e6f3'),(178214,2652,'deadline_button_text','Find out more'),(178215,2652,'_deadline_button_text','field_693660482e6f4'),(178216,2652,'deadline_button_url','/key-deadlines/'),(178217,2652,'_deadline_button_url','field_693660912e6f5'),(178218,2652,'what_head','What happened?'),(178219,2652,'_what_head','field_69366611096ac'),(178220,2652,'what_happened_0_happ_sub','What are Shield and First Guardian?'),(178221,2652,'_what_happened_0_happ_sub','field_693d4a8b4197d'),(178222,2652,'what_happened_0_happ_content','Lorem ipsum dolor sit amet, cons ectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut laoreet dolore magna aliquam erat volutpat.'),(178223,2652,'_what_happened_0_happ_content','field_693d4aa84197e'),(178224,2652,'what_happened_0_happ_url','#'),(178225,2652,'_what_happened_0_happ_url','field_693d4aba4197f'),(178226,2652,'what_happened_0_happ_link_text','Get help'),(178227,2652,'_what_happened_0_happ_link_text','field_693d4ad641980'),(178228,2652,'what_happened_1_happ_sub','What is being done about this?'),(178229,2652,'_what_happened_1_happ_sub','field_693d4a8b4197d'),(178230,2652,'what_happened_1_happ_content','Lorem ipsum dolor sit amet, cons ectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut laoreet dolore magna aliquam erat volutpat.'),(178231,2652,'_what_happened_1_happ_content','field_693d4aa84197e'),(178232,2652,'what_happened_1_happ_url','#'),(178233,2652,'_what_happened_1_happ_url','field_693d4aba4197f'),(178234,2652,'what_happened_1_happ_link_text','Send letter'),(178235,2652,'_what_happened_1_happ_link_text','field_693d4ad641980'),(178236,2652,'what_happen