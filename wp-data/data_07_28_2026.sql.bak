3799,2170,'_survey_index_6_survey_url_text','field_629456584223a'),(123800,2170,'survey_index_7_survey_icon','1493'),(123801,2170,'_survey_index_7_survey_icon','field_6294562942237'),(123802,2170,'survey_index_7_survey_title','Going Off-grid'),(123803,2170,'_survey_index_7_survey_title','field_6294564042238'),(123804,2170,'survey_index_7_survey_url','#'),(123805,2170,'_survey_index_7_survey_url','field_6294564e42239'),(123806,2170,'survey_index_7_survey_url_text','View Results'),(123807,2170,'_survey_index_7_survey_url_text','field_629456584223a'),(123808,2170,'survey_index','8'),(123809,2170,'_survey_index','field_6294561242236'),(123810,2170,'report_title','Download the report'),(123811,2170,'_report_title','field_62f30edfb57e1'),(123812,2170,'report_intro','Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus massa erat, consectetur at semper at, feugiat vel orci. '),(123813,2170,'_report_intro','field_62f30eedb57e2'),(123814,2170,'report_link_url','#'),(123815,2170,'_report_link_url','field_62f30ef4b57e3'),(123816,2170,'report_link_text','Download'),(123817,2170,'_report_link_text','field_62f30f01b57e4'),(123818,2170,'solutions_content','The housing system is complex, and no one solution will solve the complex problems we now face but there are some critical first steps to be taken now.\r\n<ul>\r\n 	<li>Set out an ambitious national housing agreement between commonwealth and state governments with targets and funding for the construction of affordable homes.</li>\r\n 	<li>Phase out tax breaks for property investors and using the increase in revenue to build more public housing.</li>\r\n 	<li>Establish laws which limit rental increases beyond what is fair.</li>\r\n 	<li>Rebalance tenancy laws to provide renters with more security and control, such as eliminating no grounds evictions.</li>\r\n 	<li>Phase out stamp duty and replace it with a broad-based land tax.</li>\r\n</ul>\r\n<h4>While there are many opinions on what policy changes will fix the housing market, doing nothing is not an option.</h4>'),(123819,2170,'_solutions_content','field_640e8b307a958'),(123820,2170,'problem_icons_0_prob_icon','1699'),(123821,2170,'_problem_icons_0_prob_icon','field_640fa0291d519'),(123822,2170,'problem_icons_0_prob_concerned_stat','70% highly concerned'),(123823,2170,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(123824,2170,'problem_icons_0_prob_concerded_text','are highly concerned'),(123825,2170,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(123826,2170,'problem_icons_0_prob_issue_text',''),(123827,2170,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(123828,2170,'problem_icons','4'),(123829,2170,'_problem_icons','field_640fa0191d518'),(123830,2170,'ceh_content_left',''),(123831,2170,'_ceh_content_left','field_640e97e8f1c8c'),(123832,2170,'ceh_content_right',''),(123833,2170,'_ceh_content_right','field_640e97fdf1c8d'),(123834,2170,'pc_content_left',''),(123835,2170,'_pc_content_left','field_640e983bf1c8f'),(123836,2170,'pc_content_right',''),(123837,2170,'_pc_content_right','field_640e984df1c90'),(123838,2170,'problem_icons_1_prob_icon','1699'),(123839,2170,'_problem_icons_1_prob_icon','field_640fa0291d519'),(123840,2170,'problem_icons_1_prob_concerned_stat','69% highly concerned'),(123841,2170,'_problem_icons_1_prob_concerned_stat','field_640fa0dd81d95'),(123842,2170,'problem_icons_1_prob_concerded_text','are highly concerned'),(123843,2170,'_problem_icons_1_prob_concerded_text','field_640fa10181d96'),(123844,2170,'problem_icons_1_prob_issue_text',''),(123845,2170,'_problem_icons_1_prob_issue_text','field_640fa11a81d97'),(123846,2170,'problem_icons_2_prob_icon','1699'),(123847,2170,'_problem_icons_2_prob_icon','field_640fa0291d519'),(123848,2170,'problem_icons_2_prob_concerned_stat','64% highly concerned'),(123849,2170,'_problem_icons_2_prob_concerned_stat','field_640fa0dd81d95'),(123850,2170,'problem_icons_2_prob_concerded_text','are highly concerned'),(123851,2170,'_problem_icons_2_prob_concerded_text','field_640fa10181d96'),(123852,2170,'problem_icons_2_prob_issue_text',''),(123853,2170,'_problem_icons_2_prob_issue_text','field_640fa11a81d97'),(123854,2170,'problem_icons_3_prob_icon','1699'),(123855,2170,'_problem_icons_3_prob_icon','field_640fa0291d519'),(123856,2170,'problem_icons_3_prob_concerned_stat','64% highly concerned'),(123857,2170,'_problem_icons_3_prob_concerned_stat','field_640fa0dd81d95'),(123858,2170,'problem_icons_3_prob_concerded_text','are highly concerned'),(123859,2170,'_problem_icons_3_prob_concerded_text','field_640fa10181d96'),(123860,2170,'problem_icons_3_prob_issue_text',''),(123861,2170,'_problem_icons_3_prob_issue_text','field_640fa11a81d97'),(123862,2170,'problem_icons_0_prob_concerned_text','House prices have doubled in a decade'),(123863,2170,'_problem_icons_0_prob_concerned_text','field_640fa10181d96'),(123864,2170,'problem_icons_1_prob_concerned_text','The gap between rich and poor is growing'),(123865,2170,'_problem_icons_1_prob_concerned_text','field_640fa10181d96'),(123866,2170,'problem_icons_2_prob_concerned_text','Construction of social housing is down'),(123867,2170,'_problem_icons_2_prob_concerned_text','field_640fa10181d96'),(123868,2170,'problem_icons_3_prob_concerned_text','Banks are making more than ever from housing'),(123869,2170,'_problem_icons_3_prob_concerned_text','field_640fa10181d96'),(123870,2170,'monitor_content','The Australian Housing Monitor is a large, nationally-representative survey covering public experiences and attitudes toward housing related issues. Questions range from how well the respondent is keeping up with their mortgage/rent, to what they think about social housing construction.\r\n\r\nA broad range of demographic criteria are included, such as gender, location, age, income, voting preference, educational level, tenure type, and employment status. These variables allow CEH researchers to understand the trends and diversity of opinion around the country.\r\n\r\nIt also incorporates questions from previous surveys to track trends over time.\r\nThe inaugural poll was conducted by Essential in December 2022, and was completed by 4,735 people.'),(123871,2170,'_monitor_content','field_640fcc4014404'),(123872,2170,'problem_head','Housing in Australia is not working, and Australians are concerned.'),(123873,2170,'_problem_head','field_641935436aded'),(123874,2170,'problem_signoff','Explore the research showing how concerned Australians are our about the housing situation.'),(123875,2170,'_problem_signoff','field_641935626adee'),(123876,2170,'sections','a:2:{i:0;s:4:\"hero\";i:1;s:9:\"news_grid\";}'),(123877,2170,'_sections','field_5dafb40b8143a'),(123878,2170,'sections_0_is_full_height','1'),(123879,2170,'_sections_0_is_full_height','field_61d6f6fd5a37e'),(123880,2170,'sections_0_image','1648'),(123881,2170,'_sections_0_image','field_61d6f6d45a37d'),(123882,2170,'sections_0_heading','Heading'),(123883,2170,'_sections_0_heading','field_61d6f69e5a379'),(123884,2170,'sections_0_subtitle','Ya ya '),(123885,2170,'_sections_0_subtitle','field_61d6f6ac5a37a'),(123886,2170,'sections_0_link_one',''),(123887,2170,'_sections_0_link_one','field_61d6f6b55a37b'),(123888,2170,'sections_0_link_two',''),(123889,2170,'_sections_0_link_two','field_61d6f6c35a37c'),(123890,2170,'sections_1_select_categories','a:1:{i:0;s:2:\"27\";}'),(123891,2170,'_sections_1_select_categories','field_637f04483b63b'),(123892,2170,'intro_head_major','Welcome to the Disability Dialogue'),(123893,2170,'_intro_head_major','field_64e828783ad9f'),(123894,2170,'intro_head_minor',''),(123895,2170,'_intro_head_minor','field_64e8288c3ada0'),(123896,2170,'intro_icons_0_int_icon','1922'),(123897,2170,'_intro_icons_0_int_icon','field_64e828b33ada2'),(123898,2170,'intro_icons_0_int_icon_text','At 1,727,000 square kilometres, we’re 2.5 times the size of Texas. <span>Yeeha!</span>'),(123899,2170,'_intro_icons_0_int_icon_text','field_64e828e33ada3'),(123900,2170,'intro_icons_1_int_icon','1920'),(123901,2170,'_intro_icons_1_int_icon','field_64e828b33ada2'),(123902,2170,'intro_icons_1_int_icon_text','We have twice as many species of native plant and animal as any other Australian state or territory.'),(123903,2170,'_intro_icons_1_int_icon_text','field_64e828e33ada3'),(123904,2170,'intro_icons_2_int_icon','1921'),(123905,2170,'_intro_icons_2_int_icon','field_64e828b33ada2'),(123906,2170,'intro_icons_2_int_icon_text','We have less land classified as ‘protected’ than any other state or territory.'),(123907,2170,'_intro_icons_2_int_icon_text','field_64e828e33ada3'),(123908,2170,'intro_icons','3'),(123909,2170,'_intro_icons','field_64e828963ada1'),(123910,2170,'threat_head_major','What we stand to lose if we don’t act soon to protect beautiful Queensland:'),(123911,2170,'_threat_head_major','field_64ec258d9dbd1'),(123912,2170,'threats_icons','3'),(123913,2170,'_threats_icons','field_64ec2551a93f9'),(123914,2170,'threats_icons_0_thr_icon','1819'),(123915,2170,'_threats_icons_0_thr_icon','field_64ec2551a93fa'),(123916,2170,'threats_icons_0_thr_icon_text','The rich cultural heritage of our First Nations people and their continuous ties to country, dating back more than 50,000 years.'),(123917,2170,'_threats_icons_0_thr_icon_text','field_64ec2551a93fb'),(123918,2170,'threats_icons_1_thr_icon','1819'),(123919,2170,'_threats_icons_1_thr_icon','field_64ec2551a93fa'),(123920,2170,'threats_icons_1_thr_icon_text','Thousands of species of plant and animal which are now classified as threatened or endangered in Queensland.'),(123921,2170,'_threats_icons_1_thr_icon_text','field_64ec2551a93fb'),(123922,2170,'threats_icons_2_thr_icon','1819'),(123923,2170,'_threats_icons_2_thr_icon','field_64ec2551a93fa'),(123924,2170,'threats_icons_2_thr_icon_text','The access to nature that is central to the Queensland way of life.'),(123925,2170,'_threats_icons_2_thr_icon_text','field_64ec2551a93fb'),(123926,2170,'threat_icons_0_thr_icon',''),(123927,2170,'_threat_icons_0_thr_icon','fi