(66010,1835,'_survey_index_6_survey_title','field_6294564042238'),(66011,1835,'survey_index_6_survey_url','#'),(66012,1835,'_survey_index_6_survey_url','field_6294564e42239'),(66013,1835,'survey_index_6_survey_url_text','View Results'),(66014,1835,'_survey_index_6_survey_url_text','field_629456584223a'),(66015,1835,'survey_index_7_survey_icon','1493'),(66016,1835,'_survey_index_7_survey_icon','field_6294562942237'),(66017,1835,'survey_index_7_survey_title','Going Off-grid'),(66018,1835,'_survey_index_7_survey_title','field_6294564042238'),(66019,1835,'survey_index_7_survey_url','#'),(66020,1835,'_survey_index_7_survey_url','field_6294564e42239'),(66021,1835,'survey_index_7_survey_url_text','View Results'),(66022,1835,'_survey_index_7_survey_url_text','field_629456584223a'),(66023,1835,'survey_index','8'),(66024,1835,'_survey_index','field_6294561242236'),(66025,1835,'report_title','Download the report'),(66026,1835,'_report_title','field_62f30edfb57e1'),(66027,1835,'report_intro','Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus massa erat, consectetur at semper at, feugiat vel orci. '),(66028,1835,'_report_intro','field_62f30eedb57e2'),(66029,1835,'report_link_url','#'),(66030,1835,'_report_link_url','field_62f30ef4b57e3'),(66031,1835,'report_link_text','Download'),(66032,1835,'_report_link_text','field_62f30f01b57e4'),(66033,1835,'solutions_content','The housing system is complex, and no one solution will solve the complex problems we now face but there are some critical first steps to be taken now.\r\n<ul>\r\n 	<li>Set out an ambitious national housing agreement between commonwealth and state governments with targets and funding for the construction of affordable homes.</li>\r\n 	<li>Phase out tax breaks for property investors and using the increase in revenue to build more public housing.</li>\r\n 	<li>Establish laws which limit rental increases beyond what is fair.</li>\r\n 	<li>Rebalance tenancy laws to provide renters with more security and control, such as eliminating no grounds evictions.</li>\r\n 	<li>Phase out stamp duty and replace it with a broad-based land tax.</li>\r\n</ul>\r\n<h4>While there are many opinions on what policy changes will fix the housing market, doing nothing is not an option.</h4>'),(66034,1835,'_solutions_content','field_640e8b307a958'),(66035,1835,'problem_icons_0_prob_icon','1699'),(66036,1835,'_problem_icons_0_prob_icon','field_640fa0291d519'),(66037,1835,'problem_icons_0_prob_concerned_stat','70% highly concerned'),(66038,1835,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(66039,1835,'problem_icons_0_prob_concerded_text','are highly concerned'),(66040,1835,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(66041,1835,'problem_icons_0_prob_issue_text',''),(66042,1835,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(66043,1835,'problem_icons','4'),(66044,1835,'_problem_icons','field_640fa0191d518'),(66045,1835,'ceh_content_left',''),(66046,1835,'_ceh_content_left','field_640e97e8f1c8c'),(66047,1835,'ceh_content_right',''),(66048,1835,'_ceh_content_right','field_640e97fdf1c8d'),(66049,1835,'pc_content_left',''),(66050,1835,'_pc_content_left','field_640e983bf1c8f'),(66051,1835,'pc_content_right',''),(66052,1835,'_pc_content_right','field_640e984df1c90'),(66053,1835,'problem_icons_1_prob_icon','1699'),(66054,1835,'_problem_icons_1_prob_icon','field_640fa0291d519'),(66055,1835,'problem_icons_1_prob_concerned_stat','69% highly concerned'),(66056,1835,'_problem_icons_1_prob_concerned_stat','field_640fa0dd81d95'),(66057,1835,'problem_icons_1_prob_concerded_text','are highly concerned'),(66058,1835,'_problem_icons_1_prob_concerded_text','field_640fa10181d96'),(66059,1835,'problem_icons_1_prob_issue_text',''),(66060,1835,'_problem_icons_1_prob_issue_text','field_640fa11a81d97'),(66061,1835,'problem_icons_2_prob_icon','1699'),(66062,1835,'_problem_icons_2_prob_icon','field_640fa0291d519'),(66063,1835,'problem_icons_2_prob_concerned_stat','64% highly concerned'),(66064,1835,'_problem_icons_2_prob_concerned_stat','field_640fa0dd81d95'),(66065,1835,'problem_icons_2_prob_concerded_text','are highly concerned'),(66066,1835,'_problem_icons_2_prob_concerded_text','field_640fa10181d96'),(66067,1835,'problem_icons_2_prob_issue_text',''),(66068,1835,'_problem_icons_2_prob_issue_text','field_640fa11a81d97'),(66069,1835,'problem_icons_3_prob_icon','1699'),(66070,1835,'_problem_icons_3_prob_icon','field_640fa0291d519'),(66071,1835,'problem_icons_3_prob_concerned_stat','64% highly concerned'),(66072,1835,'_problem_icons_3_prob_concerned_stat','field_640fa0dd81d95'),(66073,1835,'problem_icons_3_prob_concerded_text','are highly concerned'),(66074,1835,'_problem_icons_3_prob_concerded_text','field_640fa10181d96'),(66075,1835,'problem_icons_3_prob_issue_text',''),(66076,1835,'_problem_icons_3_prob_issue_text','field_640fa11a81d97'),(66077,1835,'problem_icons_0_prob_concerned_text','House prices have doubled in a decade'),(66078,1835,'_problem_icons_0_prob_concerned_text','field_640fa10181d96'),(66079,1835,'problem_icons_1_prob_concerned_text','The gap between rich and poor is growing'),(66080,1835,'_problem_icons_1_prob_concerned_text','field_640fa10181d96'),(66081,1835,'problem_icons_2_prob_concerned_text','Construction of social housing is down'),(66082,1835,'_problem_icons_2_prob_concerned_text','field_640fa10181d96'),(66083,1835,'problem_icons_3_prob_concerned_text','Banks are making more than ever from housing'),(66084,1835,'_problem_icons_3_prob_concerned_text','field_640fa10181d96'),(66085,1835,'monitor_content','The Australian Housing Monitor is a large, nationally-representative survey covering public experiences and attitudes toward housing related issues. Questions range from how well the respondent is keeping up with their mortgage/rent, to what they think about social housing construction.\r\n\r\nA broad range of demographic criteria are included, such as gender, location, age, income, voting preference, educational level, tenure type, and employment status. These variables allow CEH researchers to understand the trends and diversity of opinion around the country.\r\n\r\nIt also incorporates questions from previous surveys to track trends over time.\r\nThe inaugural poll was conducted by Essential in December 2022, and was completed by 4,735 people.'),(66086,1835,'_monitor_content','field_640fcc4014404'),(66087,1835,'problem_head','Housing in Australia is not working, and Australians are concerned.'),(66088,1835,'_problem_head','field_641935436aded'),(66089,1835,'problem_signoff','Explore the research showing how concerned Australians are our about the housing situation.'),(66090,1835,'_problem_signoff','field_641935626adee'),(66091,1835,'sections','a:2:{i:0;s:4:\"hero\";i:1;s:9:\"news_grid\";}'),(66092,1835,'_sections','field_5dafb40b8143a'),(66093,1835,'sections_0_is_full_height','1'),(66094,1835,'_sections_0_is_full_height','field_61d6f6fd5a37e'),(66095,1835,'sections_0_image','1648'),(66096,1835,'_sections_0_image','field_61d6f6d45a37d'),(66097,1835,'sections_0_heading','Heading'),(66098,1835,'_sections_0_heading','field_61d6f69e5a379'),(66099,1835,'sections_0_subtitle','Ya ya '),(66100,1835,'_sections_0_subtitle','field_61d6f6ac5a37a'),(66101,1835,'sections_0_link_one',''),(66102,1835,'_sections_0_link_one','field_61d6f6b55a37b'),(66103,1835,'sections_0_link_two',''),(66104,1835,'_sections_0_link_two','field_61d6f6c35a37c'),(66105,1835,'sections_1_select_categories','a:1:{i:0;s:2:\"27\";}'),(66106,1835,'_sections_1_select_categories','field_637f04483b63b'),(66107,1835,'intro_head_major','Queenslanders are known for both our love of the great outdoors and our state pride…'),(66108,1835,'_intro_head_major','field_64e828783ad9f'),(66109,1835,'intro_head_minor','But there’s a few things you might not know about our beautiful state.'),(66110,1835,'_intro_head_minor','field_64e8288c3ada0'),(66111,1835,'intro_icons_0_int_icon','1806'),(66112,1835,'_intro_icons_0_int_icon','field_64e828b33ada2'),(66113,1835,'intro_icons_0_int_icon_text','At 1,727,000 square kilometres, we’re 2.5 times the size of Texas. <span>Yeeha!</span>'),(66114,1835,'_intro_icons_0_int_icon_text','field_64e828e33ada3'),(66115,1835,'intro_icons_1_int_icon','1806'),(66116,1835,'_intro_icons_1_int_icon','field_64e828b33ada2'),(66117,1835,'intro_icons_1_int_icon_text','We have twice as many species of native plant and animal as any other Australian state or territory.'),(66118,1835,'_intro_icons_1_int_icon_text','field_64e828e33ada3'),(66119,1835,'intro_icons_2_int_icon','1806'),(66120,1835,'_intro_icons_2_int_icon','field_64e828b33ada2'),(66121,1835,'intro_icons_2_int_icon_text','We have less land classified as ‘protected’ than any other state or territory.'),(66122,1835,'_intro_icons_2_int_icon_text','field_64e828e33ada3'),(66123,1835,'intro_icons','3'),(66124,1835,'_intro_icons','field_64e828963ada1'),(66125,1835,'threat_head_major','What we stand to lose if we don’t act soon to protect beautiful Queensland:'),(66126,1835,'_threat_head_major','field_64ec258d9dbd1'),(66127,1835,'threats_icons','3'),(66128,1835,'_threats_icons','field_64ec2551a93f9'),(66129,1835,'threats_icons_0_thr_icon','1819'),(66130,1835,'_threats_icons_0_thr_icon','field_64ec2551a93fa'),(66131,1835,'threats_icons_0_thr_icon_text','The rich cultural heritage of our First Nations people and their continuous ties to country, dating back more than 50,000 years.'),(66132,1835,'_threats_icons_0_thr_icon_text','field_64ec2551a93fb'),(66133,1835,'threats_icons_1_thr_icon','1819'),(66134,1835,'_threats_icons_1_thr_icon','field_64ec2551a93fa'),(66135,1835,'threats_icons_1_thr_icon_text','Thousands of species of plant and animal which are now classified as threatened or endangered in Queensland.'),(66136,1835,'_threats_icons_1_thr_icon_text','field_64ec2551a93fb'),(66137,1835,'threats_icons_2_thr_icon','1819'),(66138,1835,'_threats_icons_2_thr_icon','field_64ec2551a93fa'),(66139,1835,'threats_icons_2_thr_icon