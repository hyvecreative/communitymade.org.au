nflict-free research and data analysis lifts the lid on fund performance, fees and insurance. Drawing on our policy expertise, we turn this analysis into action by using it to back reform and make super easier for people to understand. <a href=\"//localhost:4000:4000:4000:4000:4000:4000:/how/\">More</a>'),(208920,2763,'_intro_boxes_1_box_dropdown','field_65262dead0a0c'),(208921,2763,'intro_boxes_2_box_icon','1937'),(208922,2763,'_intro_boxes_2_box_icon','field_65262db5d36ee'),(208923,2763,'intro_boxes_2_box_title','Ideas'),(208924,2763,'_intro_boxes_2_box_title','field_65262d29ed8e3'),(208925,2763,'intro_boxes_2_box_dropdown','Our rigorous, conflict-free research and data analysis lifts the lid on fund performance, fees and insurance. Drawing on our policy expertise, we turn this analysis into action by using it to back reform and make super easier for people to understand. <a href=\"//localhost:4000:4000:4000:4000:4000:4000:/how/\">More</a>'),(208926,2763,'_intro_boxes_2_box_dropdown','field_65262dead0a0c'),(208927,2763,'intro_boxes','3'),(208928,2763,'_intro_boxes','field_65262d14ed8e2'),(208929,2763,'get_help_section_title','Get Help'),(208930,2763,'_get_help_section_title','field_65262c35143de'),(208931,2763,'get_help_block_home',''),(208932,2763,'_get_help_block_home','field_65262c8a143e1'),(208933,2763,'gh_block_home_0_help_image','1956'),(208934,2763,'_gh_block_home_0_help_image','field_65262cd0143e2'),(208935,2763,'gh_block_home_0_help_title','How much do I need to retire? '),(208936,2763,'_gh_block_home_0_help_title','field_65262cec143e3'),(208937,2763,'gh_block_home_0_help_url','#'),(208938,2763,'_gh_block_home_0_help_url','field_65262cf4143e4'),(208939,2763,'gh_block_home_1_help_image','1962'),(208940,2763,'_gh_block_home_1_help_image','field_65262cd0143e2'),(208941,2763,'gh_block_home_1_help_title','I have a problem with  my super fund'),(208942,2763,'_gh_block_home_1_help_title','field_65262cec143e3'),(208943,2763,'gh_block_home_1_help_url','#'),(208944,2763,'_gh_block_home_1_help_url','field_65262cf4143e4'),(208945,2763,'gh_block_home_2_help_image','1961'),(208946,2763,'_gh_block_home_2_help_image','field_65262cd0143e2'),(208947,2763,'gh_block_home_2_help_title','How do I choose the right super? '),(208948,2763,'_gh_block_home_2_help_title','field_65262cec143e3'),(208949,2763,'gh_block_home_2_help_url','#'),(208950,2763,'_gh_block_home_2_help_url','field_65262cf4143e4'),(208951,2763,'gh_block_home','3'),(208952,2763,'_gh_block_home','field_65262c8a143e1'),(208953,2763,'turn_on_insights',''),(208954,2763,'_turn_on_insights','field_645c4a2e654a6'),(208955,2763,'report_questions','a:3:{i:0;s:2:\"59\";i:1;s:2:\"61\";i:2;s:4:\"2587\";}'),(208956,2763,'_report_questions','field_6109ed5e02e5a'),(208957,2763,'intro_text','The Disability Dialogue is a place where people with disabilities, their families, organisations providing support, academics, and the wider community come together to work on things that matter to us.\r\n\r\nThe Dialogue is a hub of knowledge and collaboration, separate from government, where we work together to come up. With new ideas on important topics. Our ideas can make a big difference in how services and systems are set up for people with disabilities.'),(208958,2763,'_intro_text','field_66441acfe963c'),(208959,2763,'word_link','#'),(208960,2763,'_word_link','field_6646c69723804'),(208961,2763,'pdf_link','#'),(208962,2763,'_pdf_link','field_6646c6da23805'),(208963,2763,'intro_boxes_0_box_image','2241'),(208964,2763,'_intro_boxes_0_box_image','field_65262db5d36ee'),(208965,2763,'intro_boxes_1_box_image','2179'),(208966,2763,'_intro_boxes_1_box_image','field_65262db5d36ee'),(208967,2763,'intro_boxes_2_box_image','2012'),(208968,2763,'_intro_boxes_2_box_image','field_65262db5d36ee'),(208969,2763,'intro_boxes_0_box_excerpt','Excerpt text here just a sentance or so and no more.'),(208970,2763,'_intro_boxes_0_box_excerpt','field_665975273e827'),(208971,2763,'intro_boxes_1_box_excerpt','Excerpt text here just a sentance or so and no more.'),(208972,2763,'_intro_boxes_1_box_excerpt','field_665975273e827'),(208973,2763,'intro_boxes_2_box_excerpt','Excerpt text here just a sentance or so and no more.'),(208974,2763,'_intro_boxes_2_box_excerpt','field_665975273e827'),(208975,2763,'intro_boxes_0_btn-text','Latest events'),(208976,2763,'_intro_boxes_0_btn-text','field_665abda8b8d4b'),(208977,2763,'intro_boxes_1_btn-text','Latest projects'),(208978,2763,'_intro_boxes_1_btn-text','field_665abda8b8d4b'),(208979,2763,'intro_boxes_2_btn-text','Latest ideas'),(208980,2763,'_intro_boxes_2_btn-text','field_665abda8b8d4b'),(208981,2763,'display-easy-read',''),(208982,2763,'_display-easy-read','field_666129bd2da00'),(208983,2763,'hm_hero_sum','Statement about the issue and lost life savings'),(208984,2763,'_hm_hero_sum','field_64ed37241effa'),(208985,2763,'hm_hero_sub','Real homes, run by not-for-profit providers, for everyday people and families. Join our NSW election campaign and ask your local candidates to commit to more community housing.'),(208986,2763,'_hm_hero_sub','field_64ed37241effa'),(208987,2763,'intro_head','We’re here to help.'),(208988,2763,'_intro_head','field_64e828783ad9f'),(208989,2763,'intro_content','About 12,000 people invested their hard-earned super savings in two investment funds which have now collapsed, called Shield Master Fund and First Guardian Master Fund. Most people will be entitled to get some money back, but you need to take action soon. This website has information and tools to help you understand what happened, where to get help and how to take back your super.'),(208990,2763,'_intro_content','field_66441acfe963c'),(208991,2763,'deadline_heading','Important deadlines'),(208992,2763,'_deadline_heading','field_69365ff82e6f2'),(208993,2763,'deadline_content','You need to take action before the deadline to take your super back.'),(208994,2763,'_deadline_content','field_693660342e6f3'),(208995,2763,'deadline_button_text','Find out more'),(208996,2763,'_deadline_button_text','field_693660482e6f4'),(208997,2763,'deadline_button_url','/key-deadlines/'),(208998,2763,'_deadline_button_url','field_693660912e6f5'),(208999,2763,'what_head','Get involved'),(209000,2763,'_what_head','field_69366611096ac'),(209001,2763,'what_happened_0_happ_sub','Take action here...'),(209002,2763,'_what_happened_0_happ_sub','field_693d4a8b4197d'),(209003,2763,'what_happened_0_happ_content','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut laoreet dolore magna aliquam erat volutpat. Ut wisi enim ad minim veniam, quis nostrud exerci tation ullamcorper suscipit lobortis nisl ut aliquip ex ea commodo consequat.\r\n\r\nDuis autem vel eum iriure dolor in hendrerit in vulputate velit esse molestie consequat, vel illum dolore eu feugiat nulla facilisis at vero eros et accumsan et iusto odio dignissim qui blandit praesent luptatum zzril delenit augue duis dolore te feugait nulla facilisi.'),(209004,2763,'_what_happened_0_happ_content','field_693d4aa84197e'),(209005,2763,'what_happened_0_happ_url','#'),(209006,2763,'_what_happened_0_happ_url','field_693d4aba4197f'),(209007,2763,'what_happened_0_happ_link_text','Find out More'),(209008,2763,'_what_happened_0_happ_link_text','field_693d4ad641980'),(209009,2763,'what_happened_1_happ_sub','Take action here...'),(209010,2763,'_what_happened_1_happ_sub','field_693d4a8b4197d'),(209011,2763,'what_happened_1_happ_content','Duis autem vel eum iriure dolor in hendrerit in vulputate velit esse molestie consequat, vel illum dolore eu feugiat nulla facilisis at vero eros et accumsan et iusto odio dignissim qui blandit praesent luptatum zzril delenit augue duis dolore te feugait nulla facilisi.\r\n\r\nLorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut laoreet dolore magna aliquam erat volutpat. Ut wisi enim ad minim veniam, quis nostrud exerci tation ullamcorper suscipit lobortis nisl ut aliquip ex ea commodo consequat.'),(209012,2763,'_what_happened_1_happ_content','field_693d4aa84197e'),(209013,2763,'what_happened_1_happ_url','#'),(209014,2763,'_what_happened_1_happ_url','field_693d4aba4197f'),(209015,2763,'what_happened_1_happ_link_text','Find out More'),(209016,2763,'_what_happened_1_happ_link_text','field_693d4ad641980'),(209017,2763,'what_happened','2'),(209018,2763,'_what_happened','field_693d4a6f4197c'),(209019,2763,'what_happened_0_happ_icon','2703'),(209020,2763,'_what_happened_0_happ_icon','field_693d4c9b3ec4d'),(209021,2763,'what_happened_1_happ_icon','2703'),(209022,2763,'_what_happened_1_happ_icon','field_693d4c9b3ec4d'),(209023,2763,'display_news_section',''),(209024,2763,'_display_news_section','field_69434cc6d5f7d'),(209025,2763,'issues_head','These are the issues'),(209026,2763,'_issues_head','field_6a3b076406aef'),(209027,2763,'issues_items_0_issue_icon','2705'),(209028,2763,'_issues_items_0_issue_icon','field_6a3b07b506af1'),(209029,2763,'issues_items_0_issues_item_hd','A secure home is slipping out of reach'),(209030,2763,'_issues_items_0_issues_item_hd','field_6a3b07d706af2'),(209031,2763,'issues_items_0_issues_item_txt','•	A shortage of 132,000 social and affordable rental homes\r\n•	70,000+ households waiting for social housing\r\n•	Record-high private market rents\r\n•	Home ownership increasingly out of reach for generations'),(209032,2763,'_issues_items_0_issues_item_txt','field_6a3b07fc06af3'),(209033,2763,'issues_items_0_issues_link_text',''),(209034,2763,'_issues_items_0_issues_link_text','field_6a3b080f06af4'),(209035,2763,'issues_items_0_issues_target_url',''),(209036,2763,'_issues_items_0_issues_target_url','field_6a3b082b06af5'),(209037,2763,'issues_items','2'),(209038,2763,'_issues_items','field_6a3b078206af0'),(209039,2763,'issues_items_1_issue_icon','2708'),(209040,2763,'_issues_items_1_issue_icon','field_6a3b07b506af1'),(209041,2763,'issues_items_1_issues_item_hd','The solutions we need '),(209042,2763,'_issues_items_1_issues_item_hd','field_6a3b07d706af2'),(209043,2763,'issues_items_1_issues_item_txt','Community housing works. We’re calling on the next NSW Government for three actions: long-term investment for new community housing, more funding to future-proof existing homes, and support to help people stayed housed.'),(209044,2763,'_issues_items_1_issues_item_txt','field_6a3b07fc06af3'),(209045,2763,'issues_items_1_issues_link_text',''),(209046,2763,'_issues_items_1_issues_link_text','field_6a3b080f06af4'),(209047,2763,'issues_items_1_issues_target_url',''),(209048,2763,'_issues_items_1_issues_target_url','field_6a3b082b06af5'),(209049,2763,'issues_items_0_issues_sub_head',''),(209050,2763,'_issues_items_0_issues_sub_head','field_6a3b0aa79365e'),(209051,2763,'issues_items_1_issues_sub_head',''),(209052,2763,'_issues_items_1_issues_sub_head','field_6a3b0aa79365e'),(209053,2763,'video_head','The people next door'),(209054,2763,'_video_head','field_6a5ff269ef234'),(209055,2763,'video_intro','Nurses. Childcare workers. Single parents. Older Australians who want to stay near the people they love. Community housing is the solution.'),(209056,2763,'_video_intro','field_6a606161b34b6'),(209057,2763,'hm_hero_title_sm','because we all deserve a safe, secure and affordable home'),(209058,2763,'_hm_hero_title_sm','field_6a607121b523f'),(209061,2765,'_menu_item_type','post_type'),(209062,2765,'_menu_item_menu_item_parent','0'),(209063,2765,'_menu_item_object_id','2749'),(209064,2765,'_menu_item_object','page'),(209065,2765,'_menu_item_target',''),(209066,2765,'_menu_item_classes','a:1:{i:0;s:0:\"\";}'),(209067,2765,'_menu_item_xfn',''),(209068,2765,'_menu_item_url',''),(209069,2765,'_menu_item_orphaned','1784706548'),(209070,2766,'_wpa_browser','{\"name\":\"Safari\",\"version\":\"26.0\",\"platform\":\"iPhone\",\"update_url\":\"\",\"img_src\":\"\",\"img_src_ssl\":\"\",\"current_version\":\"\",\"upgrade\":false,\"insecure\":false,\"mobile\":true}'),(209071,2766,'_wpa_post_id','2009'),(209072,2009,'_yoast_