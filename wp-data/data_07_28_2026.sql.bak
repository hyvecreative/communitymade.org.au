125279,2177,'_problem_icons_3_prob_concerned_text','field_640fa10181d96'),(125280,2177,'monitor_content','The Australian Housing Monitor is a large, nationally-representative survey covering public experiences and attitudes toward housing related issues. Questions range from how well the respondent is keeping up with their mortgage/rent, to what they think about social housing construction.\r\n\r\nA broad range of demographic criteria are included, such as gender, location, age, income, voting preference, educational level, tenure type, and employment status. These variables allow CEH researchers to understand the trends and diversity of opinion around the country.\r\n\r\nIt also incorporates questions from previous surveys to track trends over time.\r\nThe inaugural poll was conducted by Essential in December 2022, and was completed by 4,735 people.'),(125281,2177,'_monitor_content','field_640fcc4014404'),(125282,2177,'problem_head','Housing in Australia is not working, and Australians are concerned.'),(125283,2177,'_problem_head','field_641935436aded'),(125284,2177,'problem_signoff','Explore the research showing how concerned Australians are our about the housing situation.'),(125285,2177,'_problem_signoff','field_641935626adee'),(125286,2177,'sections','a:2:{i:0;s:4:\"hero\";i:1;s:9:\"news_grid\";}'),(125287,2177,'_sections','field_5dafb40b8143a'),(125288,2177,'sections_0_is_full_height','1'),(125289,2177,'_sections_0_is_full_height','field_61d6f6fd5a37e'),(125290,2177,'sections_0_image','1648'),(125291,2177,'_sections_0_image','field_61d6f6d45a37d'),(125292,2177,'sections_0_heading','Heading'),(125293,2177,'_sections_0_heading','field_61d6f69e5a379'),(125294,2177,'sections_0_subtitle','Ya ya '),(125295,2177,'_sections_0_subtitle','field_61d6f6ac5a37a'),(125296,2177,'sections_0_link_one',''),(125297,2177,'_sections_0_link_one','field_61d6f6b55a37b'),(125298,2177,'sections_0_link_two',''),(125299,2177,'_sections_0_link_two','field_61d6f6c35a37c'),(125300,2177,'sections_1_select_categories','a:1:{i:0;s:2:\"27\";}'),(125301,2177,'_sections_1_select_categories','field_637f04483b63b'),(125302,2177,'intro_head_major','Welcome to the Disability Dialogue'),(125303,2177,'_intro_head_major','field_64e828783ad9f'),(125304,2177,'intro_head_minor',''),(125305,2177,'_intro_head_minor','field_64e8288c3ada0'),(125306,2177,'intro_icons_0_int_icon','1922'),(125307,2177,'_intro_icons_0_int_icon','field_64e828b33ada2'),(125308,2177,'intro_icons_0_int_icon_text','At 1,727,000 square kilometres, we’re 2.5 times the size of Texas. <span>Yeeha!</span>'),(125309,2177,'_intro_icons_0_int_icon_text','field_64e828e33ada3'),(125310,2177,'intro_icons_1_int_icon','1920'),(125311,2177,'_intro_icons_1_int_icon','field_64e828b33ada2'),(125312,2177,'intro_icons_1_int_icon_text','We have twice as many species of native plant and animal as any other Australian state or territory.'),(125313,2177,'_intro_icons_1_int_icon_text','field_64e828e33ada3'),(125314,2177,'intro_icons_2_int_icon','1921'),(125315,2177,'_intro_icons_2_int_icon','field_64e828b33ada2'),(125316,2177,'intro_icons_2_int_icon_text','We have less land classified as ‘protected’ than any other state or territory.'),(125317,2177,'_intro_icons_2_int_icon_text','field_64e828e33ada3'),(125318,2177,'intro_icons','3'),(125319,2177,'_intro_icons','field_64e828963ada1'),(125320,2177,'threat_head_major','What we stand to lose if we don’t act soon to protect beautiful Queensland:'),(125321,2177,'_threat_head_major','field_64ec258d9dbd1'),(125322,2177,'threats_icons','3'),(125323,2177,'_threats_icons','field_64ec2551a93f9'),(125324,2177,'threats_icons_0_thr_icon','1819'),(125325,2177,'_threats_icons_0_thr_icon','field_64ec2551a93fa'),(125326,2177,'threats_icons_0_thr_icon_text','The rich cultural heritage of our First Nations people and their continuous ties to country, dating back more than 50,000 years.'),(125327,2177,'_threats_icons_0_thr_icon_text','field_64ec2551a93fb'),(125328,2177,'threats_icons_1_thr_icon','1819'),(125329,2177,'_threats_icons_1_thr_icon','field_64ec2551a93fa'),(125330,2177,'threats_icons_1_thr_icon_text','Thousands of species of plant and animal which are now classified as threatened or endangered in Queensland.'),(125331,2177,'_threats_icons_1_thr_icon_text','field_64ec2551a93fb'),(125332,2177,'threats_icons_2_thr_icon','1819'),(125333,2177,'_threats_icons_2_thr_icon','field_64ec2551a93fa'),(125334,2177,'threats_icons_2_thr_icon_text','The access to nature that is central to the Queensland way of life.'),(125335,2177,'_threats_icons_2_thr_icon_text','field_64ec2551a93fb'),(125336,2177,'threat_icons_0_thr_icon',''),(125337,2177,'_threat_icons_0_thr_icon','field_64ec2551a93fa'),(125338,2177,'threat_icons_0_thr_icon_text','The <span>rich cultural heritage</span> of our First Nations people and their continuous ties to country, dating back more than 50,000 years.'),(125339,2177,'_threat_icons_0_thr_icon_text','field_64ec2551a93fb'),(125340,2177,'threat_icons_1_thr_icon',''),(125341,2177,'_threat_icons_1_thr_icon','field_64ec2551a93fa'),(125342,2177,'threat_icons_1_thr_icon_text','Thousands of species of plant and animal which are now classified as threatened or endangered in Queensland.'),(125343,2177,'_threat_icons_1_thr_icon_text','field_64ec2551a93fb'),(125344,2177,'threat_icons_2_thr_icon',''),(125345,2177,'_threat_icons_2_thr_icon','field_64ec2551a93fa'),(125346,2177,'threat_icons_2_thr_icon_text','The access to nature that is central to the Queensland way of life.'),(125347,2177,'_threat_icons_2_thr_icon_text','field_64ec2551a93fb'),(125348,2177,'threat_icons','3'),(125349,2177,'_threat_icons','field_64ec2551a93f9'),(125350,2177,'hm_hero_title',''),(125351,2177,'_hm_hero_title','field_64ed36e15d521'),(125352,2177,'hm_sub_title',''),(125353,2177,'_hm_sub_title','field_64ed37241effa'),(125354,2177,'home_form',''),(125355,2177,'_home_form','field_64ed373e1effb'),(125356,2177,'logo_head','Supporters'),(125357,2177,'_logo_head','field_64fd400db1641'),(125358,2177,'intro_test','Test subhead'),(125359,2177,'_intro_test','field_64fd420beaa1c'),(125360,2177,'test_heading','Test Heading'),(125361,2177,'_test_heading','field_64fd45dae34cf'),(125362,2177,'logo_slider_0_logo_image',''),(125363,2177,'_logo_slider_0_logo_image','field_64fd7315b85f4'),(125364,2177,'logo_slider_0_',''),(125365,2177,'_logo_slider_0_','field_64fd7321b85f5'),(125366,2177,'logo_slider_1_logo_image',''),(125367,2177,'_logo_slider_1_logo_image','field_64fd7315b85f4'),(125368,2177,'logo_slider_1_',''),(125369,2177,'_logo_slider_1_','field_64fd7321b85f5'),(125370,2177,'logo_slider_2_logo_image',''),(125371,2177,'_logo_slider_2_logo_image','field_64fd7315b85f4'),(125372,2177,'logo_slider_2_',''),(125373,2177,'_logo_slider_2_','field_64fd7321b85f5'),(125374,2177,'logo_slider','7'),(125375,2177,'_logo_slider','field_64fd72ffb85f3'),(125376,2177,'logo_slider_3_logo_image',''),(125377,2177,'_logo_slider_3_logo_image','field_64fd7315b85f4'),(125378,2177,'logo_slider_3_',''),(125379,2177,'_logo_slider_3_','field_64fd7321b85f5'),(125380,2177,'logo_slider_4_logo_image',''),(125381,2177,'_logo_slider_4_logo_image','field_64fd7315b85f4'),(125382,2177,'logo_slider_4_',''),(125383,2177,'_logo_slider_4_','field_64fd7321b85f5'),(125384,2177,'logo_slider_5_logo_image',''),(125385,2177,'_logo_slider_5_logo_image','field_64fd7315b85f4'),(125386,2177,'logo_slider_5_',''),(125387,2177,'_logo_slider_5_','field_64fd7321b85f5'),(125388,2177,'logo_slider_6_logo_image',''),(125389,2177,'_logo_slider_6_logo_image','field_64fd7315b85f4'),(125390,2177,'logo_slider_6_',''),(125391,2177,'_logo_slider_6_','field_64fd7321b85f5'),(125392,2177,'signup_subhead','Queenslanders are coming together to protect our beautiful state and safeguard our way of life.'),(125393,2177,'_signup_subhead','field_64fd834dd90ab'),(125394,2177,'signup_form',''),(125395,2177,'_signup_form','field_64fd8361d90ac'),(125396,2177,'signup_head','Join the campaign'),(125397,2177,'_signup_head','field_64fd83dc6b0b1'),(125398,2177,'boxes_section_title','Boxes'),(125399,2177,'_boxes_section_title','field_65262bbfd17fc'),(125400,2177,'intro_boxes_0_box_icon','1943'),(125401,2177,'_intro_boxes_0_box_icon','field_65262db5d36ee'),(125402,2177,'intro_boxes_0_box_title','Campaigning and policy'),(125403,2177,'_intro_boxes_0_box_title','field_65262d29ed8e3'),(125404,2177,'intro_boxes_0_box_dropdown','Our rigorous, conflict-free research and data analysis lifts the lid on fund performance, fees and insurance. Drawing on our policy expertise, we turn this analysis into action by using it to back reform and make super easier for people to understand. <a href=\"//localhost:4000:4000:4000:4000:4000/how/\">More</a> '),(125405,2177,'_intro_boxes_0_box_dropdown','field_65262dead0a0c'),(125406,2177,'intro_boxes_1_box_icon','1941'),(125407,2177,'_intro_boxes_1_box_icon','field_65262db5d36ee'),(125408,2177,'intro_boxes_1_box_title','Investigative journalism'),(125409,2177,'_intro_boxes_1_box_title','field_65262d29ed8e3'),(125410,2177,'intro_boxes_1_box_dropdown','Dropdown text'),(125411,2177,'_intro_boxes_1_box_dropdown','field_65262dead0a0c'),(125412,2177,'intro_boxes_2_box_icon','1937'),(125413,2177,'_intro_boxes_2_box_icon','field_65262db5d36ee'),(125414,2177,'intro_boxes_2_box_title','Research'),(125415,2177,'_intro_boxes_2_box_title','field_65262d29ed8e3'),(125416,2177,'intro_boxes_2_box_dropdown','Dropdown text'),(125417,2177,'_intro_boxes_2_box_dropdown','field_65262dead0a0c'),(125418,2177,'intro_boxes','3'),(125419,2177,'_intro_boxes','field_65262d14ed8e2'),(125420,2177,'get_help_section_title','Get Help'),(125421,2177,'_get_help_section_title','field_65262c35143de'),(125422,2177,'get_help_block_home',''),(125423,2177,'_get_help_block_home','field_65262c8a143e1'),(125424,2177,'gh_block_home_0_help_image','1956'),(125425,2177,'_gh_block_home_0_help_image','field_65262cd0143e2'),(125426,2177,'gh_block_home_0_help_title','How much do I need to retire? '),(125427,2177,'_gh_block_home_0_help_title','field_65262cec143e3'),(125428,2177,'gh_block_home_0_help_url','#'),(125429,2177,'_gh_block_home_0_help_url','field_65262cf4143e4'),(125430,2177,'gh_block_home_1_help_image','1962'),(125431,2177,'_gh_block_home_1_help_image','field_65262cd0143e2'),(125432,2177,'gh_block_home_1_help_title','I have a problem with  my super fund'),(125433,2177,'_gh_block_home_1_help_title','field_65262cec143e3'),(125434,2177,'gh_block_home_1_help_url','#'),(125435,2177,'_gh_block_home_1_help_url','field_65262cf4143e4'),(125436,2177,'gh_block_home_2_help_image','1961'),(125437,2177,'_gh_block_home_2_help_image','field_65262cd0143e2'),(125438,2177,'gh_block_home_2_help_title','How do I choose the right super? '),(125439,2177,'_gh_block_home_2_help_title','field_65262cec143e3'),(125440,2177,'gh_block_home_2_help_url','#'),(125441,2177,'_gh_block_home_2_help_url','field_65262cf4143e4'),(125442,2177,'gh_block_home','3'),(125443,2177,'_gh_block_home','field_65262c8a143e1'),(125444,2177,'turn_on_insights',''),(125445,2177,'_turn_on_insights','field_645c4a2e654a6'),(125446,2177,'report_questions','a:3:{i:0;s:4:\"1997\";i:1;s:4:\"2067\";i:2;s:4:\"2089\";}'),(125447,2177,'_report_questions','field_6109ed5e02e5a'),(125448,2177,'intro_text','The Disability Dialogue is a place where people with disabilities, their families, organisations providing support, academics, and the wider community come together to work on things that matter to us.\r\n\r\nThe Dialogue is a hub of knowledge and collaboration, separate from government, where we work together to come up. With new ideas on important topics. Our ideas can make a big difference in how services and systems are set up for people with disabilities.'),(125449,2177,'_intro_text','field_66441acfe963c'),(125453,2179,'_wp_attached_file','2024/05/project-hero-wide.jpg'),(125454,2179,'_wp_attachment_metadata','a:6:{s:5:\"width\";i:660;s:6:\"height\";i:371;s:4:\"file\";s:29:\"2024/05/project-hero-wide.jpg\";s:8:\"filesize\";i:51166;s:5:\"size