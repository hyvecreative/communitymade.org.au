'_second _image_title','field_5b67cb20ddf9a'),(99489,1963,'second_image_cont','from 0-24 years living with disabilities and their familes'),(99490,1963,'_second_image_cont','field_5b67cb24ddf9b'),(99491,1963,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(99492,1963,'_second_image_button','field_5b67cb29ddf9c'),(99493,1963,'second_image_title','Lifestart is about supporting young children'),(99494,1963,'_second_image_title','field_5b67cb20ddf9a'),(99495,1963,'page_col_image','412'),(99496,1963,'_page_col_image','field_5de6546e7c63a'),(99497,1963,'page_col_image_3','437'),(99498,1963,'_page_col_image_3','field_5de6e3998e07e'),(99499,1963,'sec_2_title','Community'),(99500,1963,'_sec_2_title','field_5de6e3ef2798f'),(99501,1963,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(99502,1963,'_sec_2_text','field_5de78dc89e613'),(99503,1963,'sec_3_title','The Project'),(99504,1963,'_sec_3_title','field_5de6e3d37d8da'),(99505,1963,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(99506,1963,'_sec_3_text','field_5de6e4044e5e8'),(99507,1963,'page_col_image_2','436'),(99508,1963,'_page_col_image_2','field_5de6546e7c63a'),(99509,1963,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(99510,1963,'_sec_2_button','field_5de6e58c86706'),(99511,1963,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(99512,1963,'_sec_3_button','field_5de6e5a243c03'),(99513,1963,'page_col_image_4','455'),(99514,1963,'_page_col_image_4','field_5de70801090ce'),(99515,1963,'sec_4_title','Location'),(99516,1963,'_sec_4_title','field_5de7082a12a81'),(99517,1963,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(99518,1963,'_sec_4_text','field_5de7084812a82'),(99519,1963,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(99520,1963,'_sec_4_button','field_5de7085e12a83'),(99521,1963,'news_title','Project updates'),(99522,1963,'_news_title','field_5de78da3aabb9'),(99523,1963,'sec_2_text_copy',''),(99524,1963,'_sec_2_text_copy','field_5de78dc89e613'),(99525,1963,'timeline-title','Timeline'),(99526,1963,'_timeline-title','field_5de78df29e615'),(99527,1963,'timeline_title','Timeline'),(99528,1963,'_timeline_title','field_5de78df29e615'),(99529,1963,'contact_title','Contact us'),(99530,1963,'_contact_title','field_5de7981e06057'),(99531,1963,'contact_intro','Contact text...'),(99532,1963,'_contact_intro','field_5de7983506058'),(99533,1963,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(99534,1963,'_news_button','field_5de8329896e02'),(99535,1963,'timeline_intro','Introduction of timeline detail...'),(99536,1963,'_timeline_intro','field_5de98f5fb1781'),(99537,1963,'timeline_pic','477'),(99538,1963,'_timeline_pic','field_5de98f72b1782'),(99539,1963,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(99540,1963,'_timeline_button','field_5de99363677f8'),(99541,1963,'banner_image_position','center'),(99542,1963,'_banner_image_position','field_5f3bc4757dd02'),(99543,1963,'services_title','Our s