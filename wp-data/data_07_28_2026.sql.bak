289,1100,'second _image_title','Lifestart is about supporting young children'),(21290,1100,'_second _image_title','field_5b67cb20ddf9a'),(21291,1100,'second_image_cont','from 0-24 years living with disabilities and their familes'),(21292,1100,'_second_image_cont','field_5b67cb24ddf9b'),(21293,1100,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(21294,1100,'_second_image_button','field_5b67cb29ddf9c'),(21295,1100,'second_image_title','Lifestart is about supporting young children'),(21296,1100,'_second_image_title','field_5b67cb20ddf9a'),(21297,1100,'page_col_image','412'),(21298,1100,'_page_col_image','field_5de6546e7c63a'),(21299,1100,'page_col_image_3','437'),(21300,1100,'_page_col_image_3','field_5de6e3998e07e'),(21301,1100,'sec_2_title','Community'),(21302,1100,'_sec_2_title','field_5de6e3ef2798f'),(21303,1100,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(21304,1100,'_sec_2_text','field_5de78dc89e613'),(21305,1100,'sec_3_title','The Project'),(21306,1100,'_sec_3_title','field_5de6e3d37d8da'),(21307,1100,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(21308,1100,'_sec_3_text','field_5de6e4044e5e8'),(21309,1100,'page_col_image_2','436'),(21310,1100,'_page_col_image_2','field_5de6546e7c63a'),(21311,1100,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(21312,1100,'_sec_2_button','field_5de6e58c86706'),(21313,1100,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(21314,1100,'_sec_3_button','field_5de6e5a243c03'),(21315,1100,'page_col_image_4','455'),(21316,1100,'_page_col_image_4','field_5de70801090ce'),(21317,1100,'sec_4_title','Location'),(21318,1100,'_sec_4_title','field_5de7082a12a81'),(21319,1100,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(21320,1100,'_sec_4_text','field_5de7084812a82'),(21321,1100,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(21322,1100,'_sec_4_button','field_5de7085e12a83'),(21323,1100,'news_title','Project updates'),(21324,1100,'_news_title','field_5de78da3aabb9'),(21325,1100,'sec_2_text_copy',''),(21326,1100,'_sec_2_text_copy','field_5de78dc89e613'),(21327,1100,'timeline-title','Timeline'),(21328,1100,'_timeline-title','field_5de78df29e615'),(21329,1100,'timeline_title','Timeline'),(21330,1100,'_timeline_title','field_5de78df29e615'),(21331,1100,'contact_title','Contact us'),(21332,1100,'_contact_title','field_5de7981e06057'),(21333,1100,'contact_intro','Contact text...'),(21334,1100,'_contact_intro','field_5de7983506058'),(21335,1100,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(21336,1100,'_news_button','field_5de8329896e02'),(21337,1100,'timeline_intro','Introduction of timeline detail...'),(21338,1100,'_timeline_intro','field_5de98f5fb1781'),(21339,1100,'timeline_pic','477'),(21340,1100,'_timeline_pic','field_5de98f72b1782'),(21341,1100,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(21342,1100,'_timeline_button','field_5de99363677f8'),(21343,1100,'banner_image_position','center'),(213