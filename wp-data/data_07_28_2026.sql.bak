arn more</a>'),(60197,1820,'_second_image_button','field_5b67cb29ddf9c'),(60198,1820,'second_image_title','Lifestart is about supporting young children'),(60199,1820,'_second_image_title','field_5b67cb20ddf9a'),(60200,1820,'page_col_image','412'),(60201,1820,'_page_col_image','field_5de6546e7c63a'),(60202,1820,'page_col_image_3','437'),(60203,1820,'_page_col_image_3','field_5de6e3998e07e'),(60204,1820,'sec_2_title','Community'),(60205,1820,'_sec_2_title','field_5de6e3ef2798f'),(60206,1820,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(60207,1820,'_sec_2_text','field_5de78dc89e613'),(60208,1820,'sec_3_title','The Project'),(60209,1820,'_sec_3_title','field_5de6e3d37d8da'),(60210,1820,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(60211,1820,'_sec_3_text','field_5de6e4044e5e8'),(60212,1820,'page_col_image_2','436'),(60213,1820,'_page_col_image_2','field_5de6546e7c63a'),(60214,1820,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(60215,1820,'_sec_2_button','field_5de6e58c86706'),(60216,1820,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(60217,1820,'_sec_3_button','field_5de6e5a243c03'),(60218,1820,'page_col_image_4','455'),(60219,1820,'_page_col_image_4','field_5de70801090ce'),(60220,1820,'sec_4_title','Location'),(60221,1820,'_sec_4_title','field_5de7082a12a81'),(60222,1820,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(60223,1820,'_sec_4_text','field_5de7084812a82'),(60224,1820,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(60225,1820,'_sec_4_button','field_5de7085e12a83'),(60226,1820,'news_title','Project updates'),(60227,1820,'_news_title','field_5de78da3aabb9'),(60228,1820,'sec_2_text_copy',''),(60229,1820,'_sec_2_text_copy','field_5de78dc89e613'),(60230,1820,'timeline-title','Timeline'),(60231,1820,'_timeline-title','field_5de78df29e615'),(60232,1820,'timeline_title','Timeline'),(60233,1820,'_timeline_title','field_5de78df29e615'),(60234,1820,'contact_title','Contact us'),(60235,1820,'_contact_title','field_5de7981e06057'),(60236,1820,'contact_intro','Contact text...'),(60237,1820,'_contact_intro','field_5de7983506058'),(60238,1820,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(60239,1820,'_news_button','field_5de8329896e02'),(60240,1820,'timeline_intro','Introduction of timeline detail...'),(60241,1820,'_timeline_intro','field_5de98f5fb1781'),(60242,1820,'timeline_pic','477'),(60243,1820,'_timeline_pic','field_5de98f72b1782'),(60244,1820,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(60245,1820,'_timeline_button','field_5de99363677f8'),(60246,1820,'banner_image_position','center'),(60247,1820,'_banner_image_position','field_5f3bc4757dd02'),(60248,1820,'services_title','Our services'),(60249,1820,'_services_title','field_5f20f3cd80eb2'),(60250,1820,'services_items_0_services_item_image','1061'),(60251,1820,'_services_items_0_services_item_image','field_5f2121355be14'),(60252,1820,'services_items_0_sservices_item_title','1300 Telephone counselling