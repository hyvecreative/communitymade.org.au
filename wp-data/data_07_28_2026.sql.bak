ow/\">More</a>'),(213049,2788,'_intro_boxes_1_box_dropdown','field_65262dead0a0c'),(213050,2788,'intro_boxes_2_box_icon','1937'),(213051,2788,'_intro_boxes_2_box_icon','field_65262db5d36ee'),(213052,2788,'intro_boxes_2_box_title','Ideas'),(213053,2788,'_intro_boxes_2_box_title','field_65262d29ed8e3'),(213054,2788,'intro_boxes_2_box_dropdown','Our rigorous, conflict-free research and data analysis lifts the lid on fund performance, fees and insurance. Drawing on our policy expertise, we turn this analysis into action by using it to back reform and make super easier for people to understand. <a href=\"//localhost:4000:4000:4000:4000:4000:4000:/how/\">More</a>'),(213055,2788,'_intro_boxes_2_box_dropdown','field_65262dead0a0c'),(213056,2788,'intro_boxes','3'),(213057,2788,'_intro_boxes','field_65262d14ed8e2'),(213058,2788,'get_help_section_title','Get Help'),(213059,2788,'_get_help_section_title','field_65262c35143de'),(213060,2788,'get_help_block_home',''),(213061,2788,'_get_help_block_home','field_65262c8a143e1'),(213062,2788,'gh_block_home_0_help_image','1956'),(213063,2788,'_gh_block_home_0_help_image','field_65262cd0143e2'),(213064,2788,'gh_block_home_0_help_title','How much do I need to retire? '),(213065,2788,'_gh_block_home_0_help_title','field_65262cec143e3'),(213066,2788,'gh_block_home_0_help_url','#'),(213067,2788,'_gh_block_home_0_help_url','field_65262cf4143e4'),(213068,2788,'gh_block_home_1_help_image','1962'),(213069,2788,'_gh_block_home_1_help_image','field_65262cd0143e2'),(213070,2788,'gh_block_home_1_help_title','I have a problem with  my super fund'),(213071,2788,'_gh_block_home_1_help_title','field_65262cec143e3'),(213072,2788,'gh_block_home_1_help_url','#'),(213073,2788,'_gh_block_home_1_help_url','field_65262cf4143e4'),(213074,2788,'gh_block_home_2_help_image','1961'),(213075,2788,'_gh_block_home_2_help_image','field_65262cd0143e2'),(213076,2788,'gh_block_home_2_help_title','How do I choose the right super? '),(213077,2788,'_gh_block_home_2_help_title','field_65262cec143e3'),(213078,2788,'gh_block_home_2_help_url','#'),(213079,2788,'_gh_block_home_2_help_url','field_65262cf4143e4'),(213080,2788,'gh_block_home','3'),(213081,2788,'_gh_block_home','field_65262c8a143e1'),(213082,2788,'turn_on_insights',''),(213083,2788,'_turn_on_insights','field_645c4a2e654a6'),(213084,2788,'report_questions','a:3:{i:0;s:2:\"59\";i:1;s:2:\"61\";i:2;s:4:\"2587\";}'),(213085,2788,'_report_questions','field_6109ed5e02e5a'),(213086,2788,'intro_text','The Disability Dialogue is a place where people with disabilities, their families, organisations providing support, academics, and the wider community come together to work on things that matter to us.\r\n\r\nThe Dialogue is a hub of knowledge and collaboration, separate from government, where we work together to come up. With new ideas on important topics. Our ideas can make a big difference in how services and systems are set up for people with disabilities.'),(213087,2788,'_intro_text','field_66441acfe963c'),(213088,2788,'word_link','#'),(213089,2788,'_word_link','field_6646c69723804'),(213090,2788,'pdf_link','#'),(213091,2788,'_pdf_link','field_6646c6da23805'),(213092,2788,'intro_boxes_0_box_image','2241'),(213093,2788,'_intro_boxes_0_box_image','field_65262db5d36ee'),(213094,2788,'intro_boxes_1_box_image','2179'),(213095,2788,'_intro_boxes_1_box_image','field_65262db5d36ee'),(213096,2788,'intro_boxes_2_box_image','2012'),(213097,2788,'_intro_boxes_2_box_image','field_65262db5d36ee'),(213098,2788,'intro_boxes_0_box_excerpt','Excerpt text here just a sentance or so and no more.'),(213099,2788,'_intro_boxes_0_box_excerpt','field_665975273e827'),(213100,2788,'intro_boxes_1_box_excerpt','Excerpt text here just a sentance or so and no more.'),(213101,2788,'_intro_boxes_1_box_excerpt','field_665975273e827'),(213102,2788,'intro_boxes_2_box_excerpt','Excerpt text here just a sentance or so and no more.'),(213103,2788,'_intro_boxes_2_box_excerpt','field_665975273e827'),(213104,2788,'intro_boxes_0_btn-text','Latest events'),(213105,2788,'_intro_boxes_0_btn-text','field_665abda8b8d4b'),(213106,2788,'intro_boxes_1_btn-text','Latest projects'),(213107,2788,'_intro_boxes_1_btn-text','field_665abda8b8d4b'),(213108,2788,'intro_boxes_2_btn-text','Latest ideas'),(213109,2788,'_intro_boxes_2_btn-text','field_665abda8b8d4b'),(213110,2788,'display-easy-read',''),(213111,2788,'_display-easy-read','field_666129bd2da00'),(213112,2788,'hm_hero_sum','Statement about the issue and lost life savings'),(213113,2788,'_hm_hero_sum','field_64ed37241effa'),(213114,2788,'hm_hero_sub','Real homes, run by not-for-profit providers, for everyday people and families. Join our NSW election campaign and ask your local candidates to commit to more community housing.'),(213115,2788,'_hm_hero_sub','field_64ed37241effa'),(213116,2788,'intro_head','We’re here to help.'),(213117,2788,'_intro_head','field_64e828783ad9f'),(213118,2788,'intro_content','About 12,000 people invested their hard-earned super savings in two investment funds which have now collapsed, called Shield Master Fund and First Guardian Master Fund. Most people will be entitled to get some money back, but you need to take action soon. This website has information and tools to help you understand what happened, where to get help and how to take back your super.'),(213119,2788,'_intro_content','field_66441acfe963c'),(213120,2788,'deadline_heading','Important deadlines'),(213121,2788,'_deadline_heading','field_69365ff82e6f2'),(213122,2788,'deadline_content','You need to take action before the deadline to take your super back.'),(213123,2788,'_deadline_content','field_693660342e6f3'),(213124,2788,'deadline_button_text','Find out more'),(213125,2788,'_deadline_button_text','field_693660482e6f4'),(213126,2788,'deadline_button_url','/key-deadlines/'),(213127,2788,'_deadline_button_url','field_693660912e6f5'),(213128,2788,'what_head','Get involved'),(213129,2788,'_what_head','field_69366611096ac'),(213130,2788,'what_happened_0_happ_