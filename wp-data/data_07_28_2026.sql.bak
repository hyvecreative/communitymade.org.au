campaign'),(202653,2735,'_signup_head','field_64fd83dc6b0b1'),(202654,2735,'boxes_section_title','Boxes'),(202655,2735,'_boxes_section_title','field_65262bbfd17fc'),(202656,2735,'intro_boxes_0_box_icon','1943'),(202657,2735,'_intro_boxes_0_box_icon','field_65262db5d36ee'),(202658,2735,'intro_boxes_0_box_title','Events'),(202659,2735,'_intro_boxes_0_box_title','field_65262d29ed8e3'),(202660,2735,'intro_boxes_0_box_dropdown','Our rigorous, conflict-free research and data analysis lifts the lid on fund performance, fees and insurance. Drawing on our policy expertise, we turn this analysis into action by using it to back reform and make super easier for people to understand. <a href=\"//localhost:4000:4000:4000:4000:4000:4000:/how/\">More</a>'),(202661,2735,'_intro_boxes_0_box_dropdown','field_65262dead0a0c'),(202662,2735,'intro_boxes_1_box_icon','1941'),(202663,2735,'_intro_boxes_1_box_icon','field_65262db5d36ee'),(202664,2735,'intro_boxes_1_box_title','Projects'),(202665,2735,'_intro_boxes_1_box_title','field_65262d29ed8e3'),(202666,2735,'intro_boxes_1_box_dropdown','Our rigorous, conflict-free research and data analysis lifts the lid on fund performance, fees and insurance. Drawing on our policy expertise, we turn this analysis into action by using it to back reform and make super easier for people to understand. <a href=\"//localhost:4000:4000:4000:4000:4000:4000:/how/\">More</a>'),(202667,2735,'_intro_boxes_1_box_dropdown','field_65262dead0a0c'),(202668,2735,'intro_boxes_2_box_icon','1937'),(202669,2735,'_intro_boxes_2_box_icon','field_65262db5d36ee'),(202670,2735,'intro_boxes_2_box_title','Ideas'),(202671,2735,'_intro_boxes_2_box_title','field_65262d29ed8e3'),(202672,2735,'intro_boxes_2_box_dropdown','Our rigorous, conflict-free research and data analysis lifts the lid on fund performance, fees and insurance. Drawing on our policy expertise, we turn this analysis into action by using it to back reform and make super easier for people to understand. <a href=\"//localhost:4000:4000:4000:4000:4000:4000:/how/\">More</a>'),(202673,2735,'_intro_boxes_2_box_dropdown','field_65262dead0a0c'),(202674,2735,'intro_boxes','3'),(202675,2735,'_intro_boxes','field_65262d14ed8e2'),(202676,2735,'get_help_section_title','Get Help'),(202677,2735,'_get_help_section_title','field_65262c35143de'),(202678,2735,'get_help_block_home',''),(202679,2735,'_get_help_block_home','field_65262c8a143e1'),(202680,2735,'gh_block_home_0_help_image','1956'),(202681,2735,'_gh_block_home_0_help_image','field_65262cd0143e2'),(202682,2735,'gh_block_home_0_help_title','How much do I need to retire? '),(202683,2735,'_gh_block_home_0_help_title','field_65262cec143e3'),(202684,2735,'gh_block_home_0_help_url','#'),(202685,2735,'_gh_block_home_0_help_url','field_65262cf4143e4'),(202686,2735,'gh_block_home_1_help_image','1962'),(202687,2735,'_gh_block_home_1_help_image','field_65262cd0143e2'),(202688,2735,'gh_block_home_1_help_title','I have a problem with  my super fund'),(202689,2735,'_gh_block_home_1_help_title','field_65262cec143e3'),(202690,2735,'gh_block_home_1_help_url','#'),(202691,2735,'_gh_block_home_1_help_url','field_65262cf4143e4'),(202692,2735,'gh_block_home_2_help_image','1961'),(202693,2735,'_gh_block_home_2_help_image','field_65262cd0143e2'),(202694,2735,'gh_block_home_2_help_title','How do I choose the right super? '),(202695,2735,'_gh_block_home_2_help_title','field_65262cec143e3'),(202696,2735,'gh_block_home_2_help_url','#'),(202697,2735,'_gh_block_home_2_help_url','field_65262cf4143e4'),(202698,2735,'gh_block_home','3'),(202699,2735,'_gh_block_home','field_65262c8a143e1'),(202700,2735,'turn_on_insights',''),(202701,2735,'_turn_on_insights','field_645c4a2e654a6'),(202702,2735,'report_questions','a:3:{i:0;s:2:\"59\";i:1;s:2:\"61\";i:2;s:4:\"2587\";}'),(202703,2735,'_report_questions','field_6109ed5e02e5a'),(202704,2735,'intro_text','The Disability Dialogue is a place where people with disabilities, their families, organisations providing support, academics, and the wider community come together to work on things that matter to us.\r\n\r\nThe Dialogue is a hub of knowledge and collaboration, separate from government, where we work together to come up. With new ideas on important topics. Our ideas can make a big difference in how services and systems are set up for people with disabilities.'),(202705,2735,'_intro_text','field_66441acfe963c'),(202706,2735,'word_link','#'),(202707,2735,'_word_link','field_6646c69723804'),(202708,2735,'pdf_link','#'),(202709,2735,'_pdf_link','field_6646c6da23805'),(202710,2735,'intro_boxes_0_box_image','2241'),(202711,2735,'_intro_boxes_0_box_image','field_65262db5d36ee'),(202712,2735,'intro_boxes_1_box_image','2179'),(202713,2735,'_intro_boxes_1_box_image','field_65262db5d36ee'),(202714,2735,'intro_boxes_2_box_image','2012'),(202715,2735,'_intro_boxes_2_box_image','field_65262db5d36ee'),(202716,2735,'intro_boxes_0_box_excerpt','Excerpt text here just a sentance or so and no more.'),(202717,2735,'_intro_boxes_0_box_excerpt','field_665975273e827'),(202718,2735,'intro_boxes_1_box_excerpt','Excerpt text here just a sentance or so and no more.'),(202719,2735,'_intro_boxes_1_box_excerpt','field_665975273e827'),(202720,2735,'intro_boxes_2_box_excerpt','Excerpt text here just a sentance or so and no more.'),(202721,2735,'_intro_boxes_2_box_excerpt','field_665975273e827'),(202722,2735,'intro_boxes_0_btn-text','Latest events'),(202723,2735,'_intro_boxes_0_btn-text','field_665abda8b8d4b'),(202724,2735,'intro_boxes_1_btn-text','Latest projects'),(202725,2735,'_intro_boxes_1_btn-text','field_665abda8b8d4b'),(202726,2735,'intro_boxes_2_btn-text','Latest ideas'),(202727,2735,'_intro_boxes_2_btn-text','field_665abda8b8d4b'),(202728,2735,'display-easy-read',''),(202729,2735,'_display-easy-read','field_666129bd2da00'),(202730,2735,'hm_hero_sum','Statement about the issue and lost life savings'),(202731,2735,'_hm_hero_sum','field_64ed37241effa'),(202732,2735,'hm_hero_sub','Real homes, run by not-for-profit providers, for everyday people and families. Join our NSW election campaign and ask your local candidates to commit to more community housing.'),(202733,2735,'_hm_hero_sub','field_64ed37241effa'),(202734,2735,'intro_head','We’re here to help.'),(202735,2735,'_intro_head','field_64e828783ad9f'),(202736,2735,'intro_content','About 12,000 people invested their hard-earned super savings in two investment funds which have now collapsed, called Shield Master Fund and First Guardian Master Fund. Most people will be entitled to get some money back, but you need to take action soon. This website has information and tools to help you understand what happened, where to get help and how to take back your super.'),(202737,2735,'_intro_content','field_66441acfe963c'),(202738,2735,'deadline_heading','Important deadlines'),(202739,2735,'_deadline_heading','field_69365ff82e6f2'),(202740,2735,'deadline_content','You need to take action before the deadline to take your super back.'),(202741,2735,'_deadline_content','field_693660342e6f3'),(202742,2735,'deadline_button_text','Find out more'),(202743,2735,'_deadline_button_text','field_693660482e6f4'),(202744,2735,'deadline_button_url','/key-deadlines/'),(202745,2735,'_deadline_button_url','field_693660912e6f5'),(202746,2735,'what_head','Get involved'),(202747,2735,'_what_head','field_69366611096ac'),(202748,2735,'what_happened_0_happ_sub','Take action here...'),(202749,2735,'_what_happened_0_happ_sub','field_693d4a8b4197d'),(202750,2735,'what_happened_0_happ_content','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut laoreet dolore magna aliquam erat volutpat. Ut wisi enim ad minim veniam, quis nostrud exerci tation ullamcorper suscipit lobortis nisl ut aliquip ex ea commodo consequat.\r\n\r\nDuis autem vel eum iriure dolor in hendrerit in vulputate velit esse molestie consequat, vel illum dolore eu feugiat nulla facilisis at vero eros et accumsan et iusto odio dignissim qui blandit praesent luptatum zzril delenit augue duis dolore te feugait nulla facilisi.'),(202751,2735,'_what_happened_0_happ_content','field_693d4aa84197e'),(202752,2735,'what_happened_0_happ_url','#'),(202753,2735,'_what_happened_0_happ_url','field_693d4aba4197f'),(202754,2735,'what_happened_0_happ_link_text','Find out More'),(202755,2735,'_what_happened_0_happ_link_text','field_693d4ad641980'),(202756,2735,'what_happened_1_happ_sub','Take action here...'),(202757,2735,'_what_happened_1_happ_sub','field_693d4a8b4197d'),(202758,2735,'what_happened_1_happ_content','Duis autem vel eum iriure dolor in hendrerit in vulputate velit esse molestie consequat, vel illum dolore eu feugiat nulla facilisis at vero eros et accumsan et iusto odio dignissim qui blandit praesent luptatum zzril delenit augue duis dolore te feugait nulla facilisi.\r\n\r\nLorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut laoreet dolore magna aliquam erat volutpat. Ut wisi enim ad minim veniam, quis nostrud exerci tation ullamcorper suscipit lobortis nisl ut aliquip ex ea commodo consequat.'),(202759,2735,'_what_happened_1_happ_content','field_693d4aa84197e'),(202760,2735,'what_happened_1_happ_url','#'),(202761,2735,'_what_happened_1_happ_url','field_693d4aba4197f'),(202762,2735,'what_happened_1_happ_link_text','Find out More'),(202763,2735,'_what_happened_1_happ_link_text','field_693d4ad641980'),(202764,2735,'what_happened','2'),(202765,2735,'_what_happened','field_693d4a6f4197c'),(202766,2735,'what_happened_0_happ_icon','2703'),(202767,2735,'_what_happened_0_happ_icon','field_693d4c9b3ec4d'),(202768,2735,'what_happened_1_happ_icon','2703'),(202769,2735,'_what_happened_1_happ_icon','field_693d4c9b3ec4d'),(202770,2735,'display_news_section',''),(202771,2735,'_display_news_section','field_69434cc6d5f7d'),(202772,2735,'issues_head','These are the issues'),(202773,2735,'_issues_head','field_6a3b076406aef'),(202774,2735,'issues_items_0_issue_icon','2705'),(202775,2735,'_issues_items_0_issue_icon','field_6a3b07b506af1'),(202776,2735,'issues_items_0_issues_item_hd','A secure home is slipping out of reach'),(202777,2735,'_issues_items_0_issues_item_hd','field_6a3b07d706af2'),(202778,2735,'issues_items_0_issues_item_txt','•	A shortage of 132,000 social and affordable rental homes\r\n•	70,000+ households waiting for social housing\r\n•	Record-high private market rents\r\n•	Home ownership increasingly out of reach for generations'),(202779,2735,'_issues_items_0_issues_item_txt','field_6a3b07fc06af3'),(202780,2735,'issues_items_0_issues_link_text',''),(202781,2735,'_issues_items_0_issues_link_text','field_6a3b080f06af4'),(202782,2735,'issues_items_0_issues_target_url',''),(202783,2735,'_issues_items_0_issues_target_url','field_6a3b082b06af5'),(202784,2735,'issues_items','3'),(202785,2735,'_issues_items','field_6a3b078206af0'),(202786,2735,'issues_items_1_issue_icon','2708'),(202787,2735,'_issues_items_1_issue_icon','field_6a3b07b506af1'),(202788,2735,'issues_items_1_issues_item_hd','The solutions we need '),(202789,2735,'_issues_items_1_issues_item_hd','field_6a3b07d706af2'),(202790,2735,'issues_items_1_issues_item_txt','Community housing works. We’re calling on the next NSW Government for three actions: long-term investment for new community housing, more funding to future-proof existing homes, and support to help people stayed housed.'),(202791,2735,'_issues_items_1_issues_item_txt','field_6a3b07fc06af3'),(202792,2735,'issues_items_1_issues_link_text',''),(202793,2735,'_issues_items_1_issues_link_text','field_6a3b080f06af4'),(202794,2735,'issues_items_1_issues_target_url',''),(202795,2735,'_issues_items_1_issues_target_url','field_6a3b082b06af5'),(202796,2735,'issues_items_0_issues_sub_head',''),(202797,2735,'_issues_items_0_issues_sub_head','field_6a3b0aa79365e'),(202798,2735,'issues_items_1_issues_sub_head',''),(202799,2735,'_issues_items_1_issues_sub_head','field_6a3b0aa79365e'),(202800,2735,'issues_items_2_issue_icon','2703'),(2