44444\",\"backgroundHover\":\"#eeeeee\",\"borderHover\":[\"\",\"\",\"\",\"\"],\"colorActive\":\"#ffffff\",\"backgroundActive\":\"#444444\",\"borderActive\":[\"\",\"\",\"\",\"\"],\"textTransform\":\"\"}],\"titleBorder\":[{\"top\":[\"#f2f2f2\",\"\",1],\"right\":[\"#f2f2f2\",\"\",1],\"bottom\":[\"#f2f2f2\",\"\",1],\"left\":[\"#f2f2f2\",\"\",1],\"unit\":\"px\"}],\"titleBorderHover\":[{\"top\":[\"#878787\",\"\",1],\"right\":[\"#878787\",\"\",1],\"bottom\":[\"#878787\",\"\",1],\"left\":[\"#878787\",\"\",1],\"unit\":\"px\"}],\"titleBorderActive\":[{\"top\":[\"#444444\",\"\",1],\"right\":[\"#444444\",\"\",1],\"bottom\":[\"#444444\",\"\",1],\"left\":[\"#444444\",\"\",1],\"unit\":\"px\"}],\"titleBorderRadius\":[8,8,8,8],\"iconStyle\":\"arrow\",\"faqSchema\":true} -->\n<div class=\"wp-block-kadence-accordion alignnone\"><div class=\"kt-accordion-wrap kt-accordion-id19_003ead-b3 kt-accordion-has-4-panes kt-active-pane-0 kt-accordion-block kt-pane-header-alignment-left kt-accodion-icon-style-arrow kt-accodion-icon-side-right\" style=\"max-width:none\"><div class=\"kt-accordion-inner-wrap\" data-allow-multiple-open=\"false\" data-start-open=\"none\"><!-- wp:kadence/pane {\"titleTag\":\"h2\",\"uniqueID\":\"19_6eda65-04\"} -->\n<div class=\"wp-block-kadence-pane kt-accordion-pane kt-accordion-pane-1 kt-pane19_6eda65-04\"><h2 class=\"kt-accordion-header-wrap\"><button class=\"kt-blocks-accordion-header kt-acccordion-button-label-show\" type=\"button\"><span class=\"kt-blocks-accordion-title-wrap\"><span class=\"kt-blocks-accordion-title\">Step 5</span></span><span class=\"kt-blocks-accordion-icon-trigger\"></span></button></h2><div class=\"kt-accordion-panel\"><div class=\"kt-accordion-panel-inner\"><!-- wp:paragraph -->\n<p>text</p>\n<!-- /wp:paragraph --></div></div></div>\n<!-- /wp:kadence/pane -->\n\n<!-- wp:kadence/pane {\"id\":2,\"titleTag\":\"h2\",\"uniqueID\":\"19_317b1b-1f\"} -->\n<div class=\"wp-block-kadence-pane kt-accordion-pane kt-accordion-pane-2 kt-pane19_317b1b-1f\"><h2 class=\"kt-accordion-header-wrap\"><button class=\"kt-blocks-accordion-header kt-acccordion-button-label-show\" type=\"button\"><span class=\"kt-blocks-accordion-title-wrap\"><span class=\"kt-blocks-accordion-title\">Step 6</span></span><span class=\"kt-blocks-accordion-icon-trigger\"></span></button></h2><div class=\"kt-accordion-panel\"><div class=\"kt-accordion-panel-inner\"><!-- wp:paragraph -->\n<p>text</p>\n<!-- /wp:paragraph --></div></div></div>\n<!-- /wp:kadence/pane --></div></div></div>\n<!-- /wp:kadence/accordion -->\n\n<!-- wp:paragraph -->\n<p></p>\n<!-- /wp:paragraph -->','About us','','inherit','closed','closed','','19-revision-v1','','','2025-12-09 02:39:05','2025-12-09 02:39:05','',19,'http://localhost/?p=2493',0,'revision','',0),(2494,1,'2025-12-09 02:58:35','2025-12-09 02:58:35','<!-- wp:paragraph -->\n<p>You’ve been impacted by the collapse of Shield or First Guardian Master Fund and you want to get your money back - what do you need to do? This page provides information on how to ask for compensation from different financial businesses that may have been involved in your investment journey.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:acf/anchor-nav {\"name\":\"acf/anchor-nav\",\"data\":{\"anchor_links_0_label\":\"The AFCA complaint process\",\"_anchor_links_0_label\":\"field_69376909bd16f\",\"anchor_links_0_anchor_id\":\"AFCA_Complaint\",\"_anchor_links_0_anchor_id\":\"field_69376918bd170\",\"anchor_links_1_label\":\"Step 1 | Make a complaint to the financial business\",\"_anchor_links_1_label\":\"field_69376909bd16f\",\"anchor_links_1_anchor_id\":\"Step1\",\"_anchor_links_1_anchor_id\":\"field_69376918bd170\",\"anchor_links_2_label\":\"Step 2 | Step two title\",\"_anchor_links_2_label\":\"field_69376909bd16f\",\"anchor_links_2_anchor_id\":\"Step2\",\"_anchor_links_2_anchor_id\":\"field_69376918bd170\",\"anchor_links_3_label\":\"Step 3 | Get a determination from AFCA\",\"_anchor_links_3_label\":\"field_69376909bd16f\",\"anchor_links_3_anchor_id\":\"Step3\",\"_anchor_links_3_anchor_id\":\"field_69376918bd170\",\"anchor_links_4_label\":\"Step 4 | Seek payment from business or compensation scheme\",\"_anchor_links_4_label\":\"field_69376909bd16f\",\"anchor_links_4_anchor_id\":\"Step4\",\"_anchor_links_4_anchor_id\":\"field_69376918bd170\",\"anchor_links_5_label\":\"Making a report to ASIC\",\"_anchor_links_5_label\":\"field_69376909bd16f\",\"anchor_links_5_anchor_id\":\"MakeReport\",\"_anchor_links_5_anchor_id\":\"field_69376918bd170\",\"anchor_links\":6,\"_anchor_links\":\"field_693768d3bd16e\"},\"mode\":\"preview\"} /-->\n\n<!-- wp:spacer {\"height\":\"16px\"} -->\n<div style=\"height:16px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n<!-- /wp:spacer -->\n\n<!-- wp:acf/breakout {\"name\":\"acf/breakout\",\"data\":{\"break_heading\":\"Alert\",\"_break_heading\":\"field_693788cb34aeb\",\"break_content\":\"Take action now!\",\"_break_content\":\"field_6937895c563a9\"},\"mode\":\"edit\"} /-->\n\n<!-- wp:heading -->\n<h2 class=\"wp-block-heading\" id=\"AFCA_Complaint\">The AFCA complaint process</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>If you have lost money as a result of the collapse of Shield or First Guardian, you may be able to get compensation. To get compensation, you must make a complaint. You have a right to complain to the Australian Financial Complaints Authority (AFCA) about a financial business you have concerns with as long as they are an AFCA member. This page explains the process of making an AFCA complaint as well as important information about deadlines.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:spacer {\"height\":\"16px\"} -->\n<div style=\"height:16px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n<!-- /wp:spacer -->\n\n<!-- wp:kadence/accordion {\"uniqueID\":\"2494_3dbd26-1b\",\"paneCount\":4,\"openPane\":1,\"startCollapsed\":true,\"contentBorderStyle\":[{\"top\":[\"\",\"\",0],\"right\":[\"\",\"\",0],\"bottom\":[\"\",\"\",0],\"left\":[\"\",\"\",0],\"unit\":\"px\"}],\"titleStyles\":[{\"size\":[null,\"\",\"\"],\"sizeType\":\"px\",\"lineHeight\":[1.4,\"\",1.1],\"lineType\":\"\",\"letterSpacing\":\"\",\"family\":\"-apple-system,BlinkMacSystemFont,u0022Segoe UIu0022,Roboto,Oxygen-Sans,Ubuntu,Cantarell,u0022Helvetica Neueu0022,sans-serif, u0022Apple Color Emojiu0022, u0022Segoe UI Emojiu0022, u0022Segoe UI Symbolu0022\",\"google\":false,\"style\":\"normal\",\"weight\":\"inherit\",\"variant\":\"\",\"subset\":\"\",\"loadGoogle\":true,\"padding\":[16,13,16,13],\"marginTop\":20,\"color\":\"#000000\",\"background\":\"#def0f9\",\"border\":[\"\",\"\",\"\",\"\"],\"borderRadius\":[\"\",\"\",\"\",\"\"],\"borderWidth\":[\"\",\"\",\"\",\"\"],\"colorHover\":\"#02283b\",\"backgroundHover\":\"#eeeeee\",\"borderHover\":[\"\",\"\",\"\",\"\"],\"colorActive\":\"#ffffff\",\"backgroundActive\":\"#0375aa\",\"borderActive\":[\"\",\"\",\"\",\"\"],\"textTransform\":\"\"}],\"titleBorder\":[{\"top\":[\"#f2f2f2\",\"\",1],\"right\":[\"#f2f2f2\",\"\",1],\"bottom\":[\"#f2f2f2\",\"\",1],\"left\":[\"#f2f2f2\",\"\",1],\"unit\":\"px\"}],\"titleBorderHover\":[{\"top\":[\"#878787\",\"\",1],\"right\":[\"#878787\",\"\",1],\"bottom\":[\"#878787\",\"\",1],\"left\":[\"#878787\",\"\",1],\"unit\":\"px\"}],\"titleBorderActive\":[{\"top\":[\"#444444\",\"\",1],\"right\":[\"#444444\",\"\",1],\"bottom\":[\"#444444\",\"\",1],\"left\":[\"#444444\",\"\",1],\"unit\":\"px\"}],\"titleBorderRadius\":[8,8,8,8],\"iconStyle\":\"arrow\",\"faqSchema\":true} -->\n<div class=\"wp-block-kadence-accordion alignnone\"><div class=\"kt-accordion-wrap kt-accordion-id2494_3dbd26-1b kt-accordion-has-4-panes kt-active-pane-1 kt-accordion-block kt-pane-header-alignment-left kt-accodion-icon-style-arrow kt-accodion-icon-side-right\" style=\"max-width:none\"><div class=\"kt-accordion-inner-wrap\" data-allow-multiple-open=\"false\" data-start-open=\"none\"><!-- wp:kadence/pane {\"id\":2,\"titleTag\":\"h2\",\"uniqueID\":\"2494_2eea18-10\"} -->\n<div class=\"wp-block-kadence-pane kt-accordion-pane kt-accordion-pane-2 kt-pane2494_2eea18-10\" id=\"Step1\"><h2 class=\"kt-accordion-header-wrap\"><button class=\"kt-blocks-accordion-header kt-acccordion-button-label-show\" type=\"button\"><span class=\"kt-blocks-accordion-title-wrap\"><span class=\"kt-blocks-accordion-title\"><strong>Step 1</strong> | Make a complaint to the financial business</span></span><span class=\"kt-blocks-accordion-icon-trigger\"></span></button></h2><div class=\"kt-accordion-panel\"><div class=\"kt-accordion-panel-inner\"><!-- wp:paragraph -->\n<p>Generally, you should complain to the financial business first before complaining to AFCA. This gives the business the chance to fix any problems without you having to make an AFCA complaint. Information about how to complain to a financial business can be found on their website.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>If you don’t feel comfortable complaining to the business first, or they have closed or you don’t know how to contact them, you can skip this step. If the deadline to make a complaint with AFCA is close, you should skip this step. AFCA may still ask the business to respond to your complaint before they process it.&nbsp;</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>If you complain to a financial business, they are required to provide a response to you within 45 days. If you are not satisfied with that response, or they do not respond, you can make a complaint to AFCA.</p>\n<!-- /wp:paragraph --></div></div></div>\n<!-- /wp:kadence/pane -->\n\n<!-- wp:kadence/pane {\"titleTag\":\"h2\",\"uniqueID\":\"2494_5f8962-0b\"} -->\n<div class=\"wp-block-kadence-pane kt-accordion-pane kt-accordion-pane-1 kt-pane2494_5f8962-0b\" id=\"Step2\"><h2 class=\"kt-accordion-header-wrap\"><button class=\"kt-blocks-accordion-header kt-acccordion-button-label-show\" type=\"button\"><span class=\"kt-blocks-accordion-title-wrap\"><span class=\"kt-blocks-accordion-title\"><strong>Step 2</strong> | Make a complaint to AFCA</span></span><span class=\"kt-blocks-accordion-icon-trigger\"></span></button></h2><div class=\"kt-accordion-panel\"><div class=\"kt-accordion-panel-inner\"><!-- wp:paragraph -->\n<p>If you have concerns with the people who have been involved in your investment journey, you may be able to <a href=\"https://www.afca.org.au/make-a-complaint\">make a complaint to the Australian Financial Complaints Authority</a> (AFCA) and ask for compensation. <strong>It is free to make a complaint to AFCA.</strong> It is also confidential - AFCA won’t publish your name or tell anyone other than the business you complain about.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Who can I make a complaint about?</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p><strong>Types of financial businesses you can complain about</strong></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:kadence/iconlist {\"uniqueID\":\"2494_b9e2d6-a5\"} -->\n<div class=\"wp-block-kadence-iconlist kt-svg-icon-list-items kt-svg-icon-list-items2494_b9e2d6-a5 kt-svg-icon-list-columns-1 alignnone\"><ul class=\"kt-svg-icon-list\"><!-- wp:kadence/listitem {\"uniqueID\":\"2494_941735-fd\",\"icon\":\"fe_checkCircle\",\"size\":24,\"markColor\":\"#ff6900\"} -->\n<li class=\"wp-block-kadence-listitem kt-svg-icon-list-item-wrap kt-svg-icon-list-item-2494_941735-fd\"><span data-name=\"fe_checkCircle\" data-stroke=\"USE_PARENT_DEFAULT_WIDTH\" data-class=\"kt-svg-icon-list-single\" class=\"kadence-dynamic-icon\"></span><span class=\"kt-svg-icon-list-text\">You can make a complaint about a <strong>financial adviser</strong> if you believe the financial advice you received was not in your best interests or broke the law. For example, you can complain if the advice you received was inappropriate, information you were given was untrue or misleading or the adviser didn’t follow your instructions or acted without asking for your consent. See below for more information about complaints against financial advisers.</span></li>\n<!-- /wp:kadence/listitem -->\n\n<!-- wp:kadence/listitem {\"uniqueID\":\"2494_0c41dd-8b\",\"icon\":\"fe_checkCircle\",\"size\":24,\"markColor\":\"#ff6900\"} -->\n<li class=\"wp-block-kadence-listitem kt-svg-icon-list-item-wrap kt-svg-icon-list-item-2494_0c41dd-8b\"><span data-name=\"fe_checkCircle\" data-stroke=\"USE_PARENT_DEFAULT_WIDTH\" data-class=\"kt-svg-icon-list-single\" class=\"kadence-dynamic-icon\"></span><span class=\"kt-svg-icon-list-text\">You can make a complaint about your <strong>super fund</strong> if you believe that the fund has made a decision about you that you think is unfair or unreasonable.</span></li>\n<!-- /wp:kadence/listitem --></ul></div>\n<!-- /wp:kadence/iconlist -->\n\n<!-- wp:kadence/iconlist {\"uniqueID\":\"2494_bc0719-28\"} -->\n<div class=\"wp-block-kadence-iconlist kt-svg-icon-list-items kt-svg-icon-list-items2494_bc0719-28 kt-svg-icon-list-columns-1 alignnone\"><ul class=\"kt-svg-icon-list\"><!-- wp:kadence/listitem {\"uniqueID\":\"2494_a9749c-56\",\"icon\":\"fe_xCircle\",\"size\":24,\"level\":1} -->\n<li class=\"wp-block-kadence-listitem kt-svg-icon-list-item-wrap kt-svg-icon-list-item-2494_a9749c-56 kt-svg-icon-list-level-1\"><span data-name=\"fe_xCircle\" data-stroke=\"USE_PARENT_DEFAULT_WIDTH\" data-class=\"kt-svg-icon-list-single\" class=\"kadence-dynamic-icon\"></span><span class=\"kt-svg-icon-list-text\">AFCA may not be able to deal with complaints about the general management of a super fund, including a fund’s decision to make an investment available for its members to invest in, or the performance of that investment.</span></li>\n<!-- /wp:kadence/listitem -->\n\n<!-- wp:kadence/listitem {\"uniqueID\":\"2494_862865-10\",\"icon\":\"fe_checkCircle\",\"size\":24,\"level\":1,\"markColor\":\"#ff6900\"} -->\n<li class=\"wp-block-kadence-listitem kt-svg-icon-list-item-wrap kt-svg-icon-list-item-2494_862865-10 kt-svg-icon-list-level-1\"><span data-name=\"fe_checkCircle\" data-stroke=\"USE_PARENT_DEFAULT_WIDTH\" data-class=\"kt-svg-icon-list-single\" class=\"kadence-dynamic-icon\"></span><span class=\"kt-svg-icon-list-text\">AFCA can deal with complaints about a super fund giving you misleading or incorrect information, acting in a misleading way when dealing with you or&nbsp; making an error when dealing with your account.</span></li>\n<!-- /wp:kadence/listitem --></ul></div>\n<!-- /wp:kadence/iconlist -->\n\n<!-- wp:kadence/iconlist {\"uniqueID\":\"2494_92b39d-06\"} -->\n<div class=\"wp-block-kadence-iconlist kt-svg-icon-list-items kt-svg-icon-list-items2494_92b39d-06 kt-svg-icon-list-columns-1 alignnone\"><ul class=\"kt-svg-icon-list\"><!-- wp:kadence/listitem {\"uniqueID\":\"2494_f712f4-94\",\"icon\":\"fe_alertCircle\",\"size\":24,\"iconTitle\":\"Yes\"} -->\n<li class=\"wp-block-kadence-listitem kt-svg-icon-list-item-wrap kt-svg-icon-list-item-2494_f712f4-94\"><span data-name=\"fe_alertCircle\" data-stroke=\"USE_PARENT_DEFAULT_WIDTH\" data-title=\"Yes\" data-class=\"kt-svg-icon-list-single\" class=\"kadence-dynamic-icon\"></span><span class=\"kt-svg-icon-list-text\">If you have a self-managed super fund (SMSF), you can make a complaint about the <strong>responsible entities</strong> of Shield (Keystone Asset Management) or First Guardian (Falcon Capital) as long as the complaint isn’t about the general management of the fund, including the investments. But, because both of those companies are in administration, there isn’t likely to be any money to pay you even if AFCA awards you money.</span></li>\n<!-- /wp:kadence/listitem --></ul></div>\n<!-- /wp:kadence/iconlist -->\n\n<!-- wp:kadence/iconlist {\"uniqueID\":\"2494_4d791a-6e\"} -->\n<div class=\"wp-block-kadence-iconlist kt-svg-icon-list-items kt-svg-icon-list-items2494_4d791a-6e kt-svg-icon-list-columns-1 alignnone\"><ul class=\"kt-svg-icon-list\"><!-- wp:kadence/listitem {\"uniqueID\":\"2494_ab4531-d1\",\"icon\":\"fe_xCircle\",\"size\":24} -->\n<li class=\"wp-block-kadence-listitem kt-svg-icon-list-item-wrap kt-svg-icon-list-item-2494_ab4531-d1\"><span data-name=\"fe_xCircle\" data-stroke=\"USE_PARENT_DEFAULT_WIDTH\" data-class=\"kt-svg-icon-list-single\" class=\"kadence-dynamic-icon\"></span><span class=\"kt-svg-icon-list-text\">You cannot make a complaint against an <strong>SMSF</strong>. This is because members run their own SMSFs and you would be making a complaint against yourself in most cases.</span></li>\n<!-- /wp:kadence/listitem -->\n\n<!-- wp:kadence/listitem {\"uniqueID\":\"2494_5d2ca0-9f\",\"icon\":\"fe_xCircle\",\"size\":24} -->\n<li class=\"wp-block-kadence-listitem kt-svg-icon-list-item-wrap kt-svg-icon-list-item-2494_5d2ca0-9f\"><span data-name=\"fe_xCircle\" data-stroke=\"USE_PARENT_DEFAULT_WIDTH\" data-class=\"kt-svg-icon-list-single\" class=\"kadence-dynamic-icon\"></span><span class=\"kt-svg-icon-list-text\">AFCA cannot deal with complaints about <strong>auditors</strong> or <strong>research houses</strong> (also called ratings agencies).</span></li>\n<!-- /wp:kadence/listitem --></ul></div>\n<!-- /wp:kadence/iconlist -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">More information about complaints against financial advisers</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p><strong>You need to name the right business in your complaint</strong></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>You can only make a complaint about a business that is an AFCA member. Individual financial advisers are not AFCA members, but they do have to be authorised by a financial advice business that is an AFCA member. The financial adviser is often called the ‘authorised representative’ of the financial advice business, which is called a ‘financial advice licensee.’ If you want to make a complaint, you need to make the complaint against the financial advice licensee. AFCA will reject your complaint if you make it against the wrong company, so it’s important to get it right.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:acf/breakout {\"name\":\"acf/breakout\",\"data\":{\"break_heading\":\"Tip\",\"_break_heading\":\"field_693788cb34aeb\",\"break_content\":\"You can check your \\u003ca href=\\u0022https://www.afca.org.au/news/shield-and-first-guardian-collapse-how-afca-can-help/information-pack-for-complainants\\u0022\\u003eadvice documents\\u003c/a\\u003e for the name of the financial advice licensee. Their name should be listed on any advice documents that were given to you when you received financial advice.\\r\\n\\r\\nIf you know the name of a financial adviser, you can also \\u003ca href=\\u0022/look-up-tool/\\u0022\\u003euse this tool\\u003c/a\\u003e to look up the name of the licensee to complain about.\",\"_break_content\":\"field_6937895c563a9\"},\"mode\":\"preview\"} /-->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\"><strong>You need to make your complaint before the deadline</strong></h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>AFCA can only deal with complaints about AFCA members. When a financial advice business shuts down, its AFCA membership will eventually expire, generally after one or two years. If you make a complaint after the business’ AFCA membership expires, AFCA cannot deal with your complaint and you won’t be eligible for compensation.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>It’s important you don’t miss the deadline. Complaint deadlines for each financial advice licensee are listed in the table below. You can use <a href=\"https://my.afca.org.au/ff-search/\">AFCA’s member search tool</a> to confirm the business is still an AFCA member.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:kadence/table {\"uniqueID\":\"2494_f38e4f-ee\",\"columns\":3,\"dataTypography\":[{\"size\":[\"\",\"\",\"\"],\"sizeType\":\"px\",\"lineHeight\":[1.3,\"\",\"\"],\"lineType\":\"\",\"letterSpacing\":\"\",\"family\":\"\",\"google\":\"\",\"style\":\"\",\"weight\":\"\",\"variant\":\"\",\"subset\":\"\",\"loadGoogle\":true,\"padding\":[\"xxs\",\"xs\",\"xxs\",\"xs\"],\"marginTop\":8,\"color\":\"\",\"background\":\"\",\"border\":[\"\",\"\",\"\",\"\"],\"borderRadius\":[\"\",\"\",\"\",\"\"],\"borderWidth\":[\"\",\"\",\"\",\"\"],\"colorHover\":\"\",\"backgroundHover\":\"\",\"borderHover\":[\"\",\"\",\"\",\"\"],\"colorActive\":\"\",\"backgroundActive\":\"\",\"borderActive\":[\"\",\"\",\"\",\"\"],\"textTransform\":\"\",\"paddingTablet\":[\"\",\"\",\"\",\"\"],\"paddingMobile\":[\"\",\"\",\"\",\"\"],\"paddingType\":\"px\"}],\"headerTypography\":[{\"size\":[\"\",\"\",\"\"],\"sizeType\":\"px\",\"lineHeight\":[1.1,\"\",\"\"],\"lineType\":\"\",\"letterSpacing\":\"\",\"family\":\"\",\"google\":\"\",\"style\":\"\",\"weight\":\"\",\"variant\":\"\",\"subset\":\"\",\"loadGoogle\":true,\"padding\":[\"xxs\",\"xs\",\"xxs\",\"xs\"],\"marginTop\":8,\"color\":\"#ffffff\",\"background\":\"\",\"border\":[\"\",\"\",\"\",\"\"],\"borderRadius\":[\"\",\"\",\"\",\"\"],\"borderWidth\":[\"\",\"\",\"\",\"\"],\"colorHover\":\"\",\"backgroundHover\":\"\",\"borderHover\":[\"\",\"\",\"\",\"\"],\"colorActive\":\"\",\"backgroundActive\":\"\",\"borderActive\":[\"\",\"\",\"\",\"\"],\"textTransform\":\"\",\"paddingTablet\":[\"\",\"\",\"\",\"\"],\"paddingMobile\":[\"\",\"\",\"\",\"\"],\"paddingType\":\"px\"}],\"evenOddBackground\":true,\"backgroundColorEven\":\"#def0f9\",\"backgroundColorOdd\":\"#ebf6fb\",\"borderStyle\":[{\"top\":[\"#ffffff\",\"\",2],\"right\":[\"#ffffff\",\"\",2],\"bottom\":[\"#ffffff\",\"\",2],\"left\":[\"#ffffff\",\"\",2],\"unit\":\"px\"}],\"maxWidth\":[null,\"\",\"\"],\"headerAlign\":\"left\",\"isFirstRowHeader\":true,\"columnSettings\":[{\"useAuto\":false,\"width\":40,\"unit\":\"%\",\"widthMobile\":150,\"unitMobile\":\"px\"},{\"useAuto\":false,\"width\":40,\"unit\":\"%\",\"unitMobile\":\"px\",\"widthMobile\":250},{\"useAuto\":false,\"width\":20,\"unit\":\"%\",\"unitMobile\":\"px\"}],\"overflowXScroll\":true} -->\n<!-- wp:kadence/table-row {\"uniqueID\":\"2494_9df9de-83\",\"row\":0,\"backgroundColor\":\"#0693e3\"} -->\n<!-- wp:kadence/table-data {\"uniqueID\":\"2494_996320-3c\",\"column\":-1} -->\n<!-- wp:paragraph {\"align\":\"left\"} -->\n<p class=\"has-text-align-left\"><strong>Financial advice licensee</strong></p>\n<!-- /wp:paragraph -->\n<!-- /wp:kadence/table-data -->\n\n<!-- wp:kadence/table-data {\"uniqueID\":\"2494_6a5f00-c6\",\"column\":-1} -->\n<!-- wp:paragraph {\"align\":\"left\"} -->\n<p class=\"has-text-align-left\"><strong>Financial advice businesses (authorised representatives)</strong></p>\n<!-- /wp:paragraph -->\n<!-- /wp:kadence/table-data -->\n\n<!-- wp:kadence/table-data {\"uniqueID\":\"2494_74e671-b7\",\"column\":-1} -->\n<!-- wp:paragraph {\"align\":\"left\"} -->\n<p class=\"has-text-align-left\"><strong>Deadline to complain to AFCA</strong></p>\n<!-- /wp:paragraph -->\n<!-- /wp:kadence/table-data -->\n<!-- /wp:kadence/table-row -->\n\n<!-- wp:kadence/table-row {\"uniqueID\":\"2494_7f0203-6f\",\"row\":1} -->\n<!-- wp:kadence/table-data {\"uniqueID\":\"2494_1969a7-98\",\"column\":-1} -->\n<!-- wp:paragraph -->\n<p>Financial Services Group Australia Pty Ltd<br>AFCA Member No: 10327</p>\n<!-- /wp:paragraph -->\n<!-- /wp:kadence/table-data -->\n\n<!-- wp:kadence/table-data {\"uniqueID\":\"2494_84aaad-1d\",\"column\":-1} -->\n<!-- wp:paragraph -->\n<p>5 Point Australia Pty LtdAS Financial Planning Pty LtdBriix Groups Australia Pty LtdRebellis Financial Services Pty LtdSTC Financial Pty Ltd</p>\n<!-- /wp:paragraph -->\n<!-- /wp:kadence/table-data -->\n\n<!-- wp:kadence/table-data {\"uniqueID\":\"2494_3af746-1a\",\"column\":-1} -->\n<!-- wp:paragraph -->\n<p>4 June 2026</p>\n<!-- /wp:paragraph -->\n<!-- /wp:kadence/table-data -->\n<!-- /wp:kadence/table-row -->\n\n<!-- wp:kadence/table-row {\"uniqueID\":\"2494_402c4d-97\",\"row\":2} -->\n<!-- wp:kadence/table-data {\"uniqueID\":\"2494_ca3ed7-a5\",\"column\":-1} -->\n<!-- wp:paragraph -->\n<p><a href=\"https://interprac.com.au/dispute-resolution-service\">Interprac Financial Planning Pty Ltd</a><br>AFCA Member No: 10416</p>\n<!-- /wp:paragraph -->\n<!-- /wp:kadence/table-data -->\n\n<!-- wp:kadence/table-data {\"uniqueID\":\"2494_15ed0e-0e\",\"column\":-1} -->\n<!-- wp:paragraph -->\n<p>Miller Wealth GroupRhys Reilly Pty LtdUnited Financial Advice Pty Ltd (Venture Egg)<br>See <a href=\"https://service.asic.gov.au/search/\">ASIC Professional Registers Search</a> for a complete list.</p>\n<!-- /wp:paragraph -->\n<!-- /wp:kadence/table-data -->\n\n<!-- wp:kadence/table-data {\"uniqueID\":\"2494_e50f3c-f4\",\"column\":-1} -->\n<!-- wp:paragraph -->\n<p>None</p>\n<!-- /wp:paragraph -->\n<!-- /wp:kadence/table-data -->\n<!-- /wp:kadence/table-row -->\n\n<!-- wp:kadence/table-row {\"uniqueID\":\"2494_235605-14\",\"row\":3} -->\n<!-- wp:kadence/table-data {\"uniqueID\":\"2494_fc06fe-c5\",\"column\":-1} -->\n<!-- wp:paragraph -->\n<p>MWL Financial Services Pty Ltd.<br>AFCA Member No: 11054</p>\n<!-- /wp:paragraph -->\n<!-- /wp:kadence/table-data -->\n\n<!-- wp:kadence/table-data {\"uniqueID\":\"2494_31c98f-11\",\"column\":-1} -->\n<!-- wp:paragraph -->\n<p>National Eqty Partners Pty LtdStartek Australia Pty Ltd</p>\n<!-- /wp:paragraph -->\n<!-- /wp:kadence/table-data -->\n\n<!-- wp:kadence/table-data {\"uniqueID\":\"2494_89c9b5-2c\",\"column\":-1} -->\n<!-- wp:paragraph -->\n<p>25 August 2026</p>\n<!-- /wp:paragraph -->\n<!-- /wp:kadence/table-data -->\n<!-- /wp:kadence/table-row -->\n\n<!-- wp:kadence/table-row {\"uniqueID\":\"2494_363a3a-34\",\"row\":4} -->\n<!-- wp:kadence/table-data {\"uniqueID\":\"2494_4836dc-ca\",\"column\":-1} -->\n<!-- wp:paragraph -->\n<p>Next Generation Advice Pty Ltd.<br>AFCA Member No: 12450</p>\n<!-- /wp:paragraph -->\n<!-- /wp:kadence/table-data -->\n\n<!-- wp:kadence/table-data {\"uniqueID\":\"2494_819444-df\",\"column\":-1} -->\n<!-- wp:paragraph -->\n<p>Integral Advisory Solutions Pty LtdIntegral Wealth Group Pty LtdWealth Rite Advisory GroupWealth Rite Pty Ltd</p>\n<!-- /wp:paragraph -->\n<!-- /wp:kadence/table-data -->\n\n<!-- wp:kadence/table-data {\"uniqueID\":\"2494_f109b4-08\",\"column\":-1} -->\n<!-- wp:paragraph -->\n<p>18 April 2026</p>\n<!-- /wp:paragraph -->\n<!-- /wp:kadence/table-data -->\n<!-- /wp:kadence/table-row -->\n\n<!-- wp:kadence/table-row {\"uniqueID\":\"2494_9096c5-51\",\"row\":5} -->\n<!-- wp:kadence/table-data {\"uniqueID\":\"2494_cfde02-56\",\"column\":-1} -->\n<!-- wp:paragraph -->\n<p>United Global Capital Pty Ltd<br>AFCA Member No: 40334</p>\n<!-- /wp:paragraph -->\n<!-- /wp:kadence/table-data -->\n\n<!-- wp:kadence/table-data {\"uniqueID\":\"2494_cbd005-05\",\"column\":-1} -->\n<!-- wp:paragraph -->\n<p>Australian Funds Management Group Pty LtdCangro Wealth Group Pty LtdEmpire Wealth Group Australia Pty LtdFunds United Pty LtdGlobal Capital Property Fund LimitedIComplySMSF Pty LtdIPro Wealth Pty LtdKinetic Investments Australian Pty LtdUGC Asset Management Pty LtdUGC Funds Managements Pty LtdUGC Global Alpha Fund Limited</p>\n<!-- /wp:paragraph -->\n<!-- /wp:kadence/table-data -->\n\n<!-- wp:kadence/table-data {\"uniqueID\":\"2494_ebdeff-a7\",\"column\":-1} -->\n<!-- wp:paragraph -->\n<p>31 May 2026</p>\n<!-- /wp:paragraph -->\n<!-- /wp:kadence/table-data -->\n<!-- /wp:kadence/table-row -->\n<!-- /wp:kadence/table -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">What can I ask for?</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>If you make a complaint against a <strong>financial adviser</strong> in relation to Shield or First Guardian, you can ask for:</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:list -->\n<ul class=\"wp-block-list\"><!-- wp:list-item -->\n<li>Compensation for direct financial losses (money you lost directly because of the financial advice you got) up to $631,500 such as:<!-- wp:list -->\n<ul class=\"wp-block-list\"><!-- wp:list-item -->\n<li>money you lost on the investment,</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>money you would have made in your old super fund if you hadn’t switched,</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>any fees you paid for the advice;</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list --></li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Compensation for indirect financial losses (money you lost as a result of the investment collapse) up to $6,300, such as:<!-- wp:list -->\n<ul class=\"wp-block-list\"><!-- wp:list-item -->\n<li>interest on loans you took out to cover expenses when you couldn’t access your super,</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>penalties you paid when you couldn’t access your super to buy a home;</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list --></li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>Compensation for non-financial losses up to $6,300, such as:<!-- wp:list -->\n<ul class=\"wp-block-list\"><!-- wp:list-item -->\n<li>emotional distress about losing your savings.</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list --></li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list -->\n\n<!-- wp:paragraph -->\n<p>The maximum total amount of money that AFCA can award you for a financial advice complaint is $1,263,000.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>If you make a complaint against a <strong>super fund </strong>in relation to Shield and First Guardian, you can ask for:</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:list -->\n<ul class=\"wp-block-list\"><!-- wp:list-item -->\n<li>compensation for the money you lost in the investment;</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>reimbursement of any fees you paid the fund while your investments were frozen.</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list -->\n\n<!-- wp:paragraph -->\n<p>There is no limit to the amount that AFCA can award you for a super fund complaint. Any money paid to you will be paid to your super account.</p>\n<!-- /wp:paragraph --></div></div></div>\n<!-- /wp:kadence/pane -->\n\n<!-- wp:kadence/pane {\"id\":3,\"titleTag\":\"h2\",\"uniqueID\":\"2494_cac9d8-6c\"} -->\n<div class=\"wp-block-kadence-pane kt-accordion-pane kt-accordion-pane-3 kt-pane2494_cac9d8-6c\" id=\"Step3\"><h2 class=\"kt-accordion-header-wrap\"><button class=\"kt-blocks-accordion-header kt-acccordion-button-label-show\" type=\"button\"><span class=\"kt-blocks-accordion-title-wrap\"><span class=\"kt-blocks-accordion-title\"><strong>Step 3</strong> | Get a determination from AFCA</span></span><span class=\"kt-blocks-accordion-icon-trigger\"></span></button></h2><div class=\"kt-accordion-panel\"><div class=\"kt-accordion-panel-inner\"><!-- wp:paragraph -->\n<p>Once you have made a complaint to AFCA, your complaint will be handled according to AFCA’s usual process, which has three stages:</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:list -->\n<ul class=\"wp-block-list\"><!-- wp:list-item -->\n<li><strong>Registration and referral</strong>: AFCA will review your complaint, ask for any more information it needs and notify the business you have complained about. In most cases, AFCA will ask the business for a response to your complaint and encourage the business to try to resolve the issues.<!-- wp:list -->\n<ul class=\"wp-block-list\"><!-- wp:list-item -->\n<li>If the business you complained about has shut down, AFCA may not try to contact them.</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>If there is a problem with your complaint (e.g. you have named the wrong business), AFCA will let you know.</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list --></li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li><strong>Case management</strong>: If the complaint has not been resolved in the first stage, AFCA will assign a case manager to your complaint. The case manager will decide if AFCA needs any more information or documents. They will also decide whether the complaint can be resolved in a discussion with you, the case manager and the business, and may provide an early decision about the complaint. AFCA may skip this step where the complaint is:<!-- wp:list -->\n<ul class=\"wp-block-list\"><!-- wp:list-item -->\n<li>urgent (e.g. you are in financial distress) or</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>low value.</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list --></li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li><strong>Decision</strong>: If the complaint can’t be resolved and either you or the business disagrees with the early decision from the case manager, your complaint will go to an ‘adjudicator’ or an ‘ombudsman’ to be decided. These are independent people who will take a fresh look at the complaint file and make a decision. A decision made by an adjudicator or an ombudsman is binding on the business even if they don’t agree with it.</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list -->\n\n<!-- wp:paragraph -->\n<p>Find out more about <a href=\"https://www.afca.org.au/what-to-expect/the-process-we-follow\">AFCA’s process</a>.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">How long will it take to get a decision?</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>The short answer is, it depends. Some complaints are simpler than others. Some businesses are more cooperative than others. Some businesses are closed.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>At the moment, AFCA has said it’s getting a lot of complaints about Shield and First Guardian and it’s taking longer than usual to deal with them due to how many there are. While AFCA generally deals with complaints in the order it receives them, it does make exceptions in special circumstances. For example, where someone is experiencing financial hardship or has other reasons why they need the complaint dealt with urgently, AFCA will try to fast track that complaint. If you are facing special circumstances and need AFCA to process your complaint faster, make sure to include this information in your complaint.</p>\n<!-- /wp:paragraph --></div></div></div>\n<!-- /wp:kadence/pane -->\n\n<!-- wp:kadence/pane {\"id\":4,\"titleTag\":\"h2\",\"uniqueID\":\"2494_d3b90a-3e\"} -->\n<div class=\"wp-block-kadence-pane kt-accordion-pane kt-accordion-pane-4 kt-pane2494_d3b90a-3e\" id=\"Step4\"><h2 class=\"kt-accordion-header-wrap\"><button class=\"kt-blocks-accordion-header kt-acccordion-button-label-show\" type=\"button\"><span class=\"kt-blocks-accordion-title-wrap\"><span class=\"kt-blocks-accordion-title\"><strong>Step 4</strong> | Seek payment from business or compensation scheme</span></span><span class=\"kt-blocks-accordion-icon-trigger\"></span></button></h2><div class=\"kt-accordion-panel\"><div class=\"kt-accordion-panel-inner\"><!-- wp:paragraph -->\n<p>If AFCA agrees with your complaint and awards you money, the business has to pay you. If they don’t, you need to report this to AFCA as soon as possible.&nbsp;</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:list -->\n<ul class=\"wp-block-list\"><!-- wp:list-item -->\n<li>If the business is still running, AFCA will take steps to try to make them pay.&nbsp;</li>\n<!-- /wp:list-item -->\n\n<!-- wp:list-item -->\n<li>If the business is not running, AFCA will work with the administrator, receiver or liquidator responsible for winding down the business to see if there is money to pay you.&nbsp;</li>\n<!-- /wp:list-item --></ul>\n<!-- /wp:list -->\n\n<!-- wp:paragraph -->\n<p>All of the <strong>super funds</strong> involved with Shield and First Guardian continue to operate and are likely to pay any money AFCA awards. Only one of the <strong>financial advice businesses</strong> who sold Shield or First Guardian to investors is still operating at the time of writing (Interprac). Interprac was involved with about half of all the people who invested in the two funds. Successful AFCA complaints against the other advice businesses, which have shut down, will likely not get paid by those businesses.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>If the business does not pay you after AFCA has taken reasonable steps to make them pay, you can apply for compensation from the Compensation Scheme of Last Resort (CSLR). The CSLR provides compensation of up to $150,000 per person to eligible consumers who have an unpaid determination from AFCA relating to certain types of complaints, including personal financial advice provided to retail clients about superannuation.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>Find out more about <a href=\"https://cslr.org.au/how-to-make-a-claim/\">how to make a claim to the CSLR</a>.</p>\n<!-- /wp:paragraph --></div></div></div>\n<!-- /wp:kadence/pane --></div></div></div>\n<!-- /wp:kadence/accordion -->\n\n<!-- wp:spacer {\"height\":\"16px\"} -->\n<div style=\"height:16px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n<!-- /wp:spacer -->\n\n<!-- wp:separator -->\n<hr class=\"wp-block-separator has-alpha-channel-opacity\"/>\n<!-- /wp:separator -->\n\n<!-- wp:spacer {\"height\":\"8px\"} -->\n<div style=\"height:8px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n<!-- /wp:spacer -->\n\n<!-- wp:heading -->\n<h2 class=\"wp-block-heading\" id=\"MakeReport\">Making a report to ASIC</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>If you feel that any of the people or companies you’ve dealt with about your investment in Shield or First Guardian have broken the law, you can report them to ASIC. There are some financial businesses that you cannot complain to AFCA about, such as auditors or research houses. You can report them to ASIC instead.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>ASIC can investigate and take enforcement action against people and companies who have broken the financial services law. Taking action to stop high risk super switching schemes is an enforcement priority for ASIC and it has already banned a number of financial advisers and other people responsible for switching people into Shield. ASIC has also commenced enforcement action against a super fund, a financial advice business, a lead generator and a research house involved with Shield and First Guardian. Enforcement action holds people accountable for their actions and prevents them harming anyone in the future.&nbsp;</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>ASIC cannot get your money back for you, but in some cases, like its <a href=\"https://www.asic.gov.au/about-asic/news-centre/find-a-media-release/2025-releases/25-215mr-macquarie-admits-to-shield-contraventions-and-commits-to-pay-affected-members/\">agreement with Macquarie</a>, ASIC can get businesses to compensate people who were harmed as a result of their misconduct.&nbsp;<br>You can make a report to ASIC about misconduct by <a href=\"https://www.asic.gov.au/about-asic/contact-us/reporting-misconduct-to-asic/make-a-report-of-misconduct-to-asic\">completing this form</a>.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:acf/breakout {\"name\":\"acf/breakout\",\"data\":{\"break_heading\":\"Where can I get more information?\",\"_break_heading\":\"field_693788cb34aeb\",\"break_content\":\"See the links below for more information about each topic.\",\"_break_content\":\"field_6937895c563a9\"},\"mode\":\"edit\"} /-->\n\n<!-- wp:kadence/table {\"uniqueID\":\"2494_bd9882-54\",\"columns\":2,\"dataTypography\":[{\"size\":[\"\",\"\",\"\"],\"sizeType\":\"px\",\"lineHeight\":[1.3,\"\",\"\"],\"lineType\":\"\",\"letterSpacing\":\"\",\"family\":\"\",\"google\":\"\",\"style\":\"\",\"weight\":\"\",\"variant\":\"\",\"subset\":\"\",\"loadGoogle\":true,\"padding\":[\"xxs\",\"xs\",\"xxs\",\"xs\"],\"marginTop\":8,\"color\":\"\",\"background\":\"\",\"border\":[\"\",\"\",\"\",\"\"],\"borderRadius\":[\"\",\"\",\"\",\"\"],\"borderWidth\":[\"\",\"\",\"\",\"\"],\"colorHover\":\"\",\"backgroundHover\":\"\",\"borderHover\":[\"\",\"\",\"\",\"\"],\"colorActive\":\"\",\"backgroundActive\":\"\",\"borderActive\":[\"\",\"\",\"\",\"\"],\"textTransform\":\"\",\"paddingTablet\":[\"\",\"\",\"\",\"\"],\"paddingMobile\":[\"\",\"\",\"\",\"\"],\"paddingType\":\"px\"}],\"headerTypography\":[{\"size\":[\"\",\"\",\"\"],\"sizeType\":\"px\",\"lineHeight\":[1.1,\"\",\"\"],\"lineType\":\"\",\"letterSpacing\":\"\",\"family\":\"\",\"google\":\"\",\"style\":\"\",\"weight\":\"\",\"variant\":\"\",\"subset\":\"\",\"loadGoogle\":true,\"padding\":[\"xxs\",\"xs\",\"xxs\",\"xs\"],\"marginTop\":8,\"color\":\"#ffffff\",\"background\":\"\",\"border\":[\"\",\"\",\"\",\"\"],\"borderRadius\":[\"\",\"\",\"\",\"\"],\"borderWidth\":[\"\",\"\",\"\",\"\"],\"colorHover\":\"\",\"backgroundHover\":\"\",\"borderHover\":[\"\",\"\",\"\",\"\"],\"colorActive\":\"\",\"backgroundActive\":\"\",\"borderActive\":[\"\",\"\",\"\",\"\"],\"textTransform\":\"\",\"paddingTablet\":[\"\",\"\",\"\",\"\"],\"paddingMobile\":[\"\",\"\",\"\",\"\"],\"paddingType\":\"px\"}],\"evenOddBackground\":true,\"backgroundColorEven\":\"#def0f9\",\"backgroundColorOdd\":\"#ebf6fb\",\"borderStyle\":[{\"top\":[\"#ffffff\",\"\",2],\"right\":[\"#ffffff\",\"\",2],\"bottom\":[\"#ffffff\",\"\",2],\"left\":[\"#ffffff\",\"\",2],\"unit\":\"px\"}],\"maxWidth\":[null,\"\",\"\"],\"headerAlign\":\"left\",\"isFirstRowHeader\":true,\"columnSettings\":[{\"useAuto\":false,\"width\":40,\"unit\":\"%\",\"widthMobile\":150,\"unitMobile\":\"px\"},{\"useAuto\":false,\"width\":61,\"unit\":\"%\",\"unitMobile\":\"px\",\"widthMobile\":250},{\"useAuto\":false,\"width\":20,\"unit\":\"%\",\"unitMobile\":\"px\"}],\"overflowXScroll\":true} -->\n<!-- wp:kadence/table-row {\"uniqueID\":\"2494_a14dfe-fb\",\"row\":0} -->\n<!-- wp:kadence/table-data {\"uniqueID\":\"2494_354285-23\",\"column\":0} -->\n<!-- wp:paragraph -->\n<p><strong>Topic</strong></p>\n<!-- /wp:paragraph -->\n<!-- /wp:kadence/table-data -->\n\n<!-- wp:kadence/table-data {\"uniqueID\":\"2494_5c6ada-e1\",\"column\":1} -->\n<!-- wp:paragraph -->\n<p><strong>Links</strong></p>\n<!-- /wp:paragraph -->\n<!-- /wp:kadence/table-data -->\n<!-- /wp:kadence/table-row -->\n\n<!-- wp:kadence/table-row {\"uniqueID\":\"2494_ab2bea-e0\",\"row\":1} -->\n<!-- wp:kadence/table-data {\"uniqueID\":\"2494_f6daf7-c8\",\"column\":0} -->\n<!-- wp:paragraph -->\n<p>Making a complaint to AFCA</p>\n<!-- /wp:paragraph -->\n<!-- /wp:kadence/table-data -->\n\n<!-- wp:kadence/table-data {\"uniqueID\":\"2494_ee1e9b-59\",\"column\":1} -->\n<!-- wp:paragraph -->\n<p><a href=\"https://www.afca.org.au/make-a-complaint\">Making a complaint to AFCA</a></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p><a href=\"https://www.afca.org.au/news/shield-and-first-guardian-collapse-how-afca-can-help\">Shield and First Guardian collapse – how AFCA can help</a></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p><a href=\"https://www.afca.org.au/news/shield-and-first-guardian-collapse-how-afca-can-help/information-pack-for-complainants\">Information pack for complainants: examples of documents to provide with your complaint</a></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p><a href=\"https://www.afca.org.au/news/current-matters/first-guardian-master-fund\">AFCA complaints about First Guardian Master Fund</a></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p><a href=\"https://www.afca.org.au/news/current-matters/next-generation-advice-pty-ltd-in-liquidation\">AFCA complaints about Next Generation Advice Pty Ltd</a></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p><a href=\"https://www.afca.org.au/news/current-matters/shield-master-fund\">AFCA complaints about Shield Master Fund</a></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p><a href=\"https://www.afca.org.au/news/current-matters/ugc-current-matter-update-april-2025\">AFCA complaints about United Global Capital</a></p>\n<!-- /wp:paragraph -->\n<!-- /wp:kadence/table-data -->\n<!-- /wp:kadence/table-row -->\n\n<!-- wp:kadence/table-row {\"uniqueID\":\"2494_61a468-d8\",\"row\":2} -->\n<!-- wp:kadence/table-data {\"uniqueID\":\"2494_32ce58-ee\",\"column\":0} -->\n<!-- wp:paragraph -->\n<p></p>\n<!-- /wp:paragraph -->\n<!-- /wp:kadence/table-data -->\n\n<!-- wp:kadence/table-data {\"uniqueID\":\"2494_ac3147-3a\",\"column\":1} -->\n<!-- wp:paragraph -->\n<p></p>\n<!-- /wp:paragraph -->\n<!-- /wp:kadence/table-data -->\n<!-- /wp:kadence/table-row -->\n\n<!-- wp:kadence/table-row {\"uniqueID\":\"2494_4d7ecb-17\",\"row\":3} -->\n<!-- wp:kadence/table-data {\"uniqueID\":\"2494_639a42-8b\",\"column\":0} -->\n<!-- wp:paragraph -->\n<p>Information about financial advice businesses and advisers&nbsp;</p>\n<!-- /wp:paragraph -->\n<!-- /wp:kadence/table-data -->\n\n<!-- wp:kadence/table-data {\"uniqueID\":\"2494_2ac6b7-b9\",\"column\":1} -->\n<!-- wp:paragraph -->\n<p><a href=\"https://www.choice.com.au/money/financial-planning-and-investing/financial-planning/buying-guides/financial-planning\">How to find a good financial adviser</a></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p><a href=\"https://moneysmart.gov.au/financial-advice/financial-advisers-register\">ASIC’s Financial Adviser Register - individuals</a></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p><a href=\"https://service.asic.gov.au/search/\">ASIC’s Professional Registers Search - companies</a></p>\n<!-- /wp:paragraph -->\n<!-- /wp:kadence/table-data -->\n<!-- /wp:kadence/table-row -->\n\n<!-- wp:kadence/table-row {\"uniqueID\":\"2494_718136-71\",\"row\":4} -->\n<!-- wp:kadence/table-data {\"uniqueID\":\"2494_7d5913-91\",\"column\":0} -->\n<!-- wp:paragraph -->\n<p>Reporting misconduct to ASIC</p>\n<!-- /wp:paragraph -->\n<!-- /wp:kadence/table-data -->\n\n<!-- wp:kadence/table-data {\"uniqueID\":\"2494_d6d5e8-c9\",\"column\":1} -->\n<!-- wp:paragraph -->\n<p><a href=\"https://www.asic.gov.au/about-asic/contact-us/reporting-misconduct-to-asic/make-a-report-of-misconduct-to-asic\">Make a report of misconduct to ASIC</a></p>\n<!-- /wp:paragraph -->\n<!-- /wp:kadence/table-data -->\n<!-- /wp:kadence/table-row -->\n<!-- /wp:kadence/table -->\n\n<!-- wp:paragraph -->\n<p></p>\n<!-- /wp:paragraph -->','Make a Complaint','','publish','closed','closed','','make-a-complaint','','','2025-12-17 00:14:37','2025-12-17 00:14:37','',0,'http://localhost/?page_id=2494',0,'page','',0);
INSERT INTO `wp_posts` VALUES (2495,1,'2025-12-09 02:58:35','2025-12-09 02:58:35','<!-- wp:acf/anchor-nav {\"name\":\"acf/anchor-nav\",\"data\":{\"anchor_links_0_label\":\"Step 1 | Make a complaint to the financial business\",\"_anchor_links_0_label\":\"field_69376909bd16f\",\"anchor_links_0_anchor_id\":\"Step1\",\"_anchor_links_0_anchor_id\":\"field_69376918bd170\",\"anchor_links_1_label\":\"Step 2 | Step two title\",\"_anchor_links_1_label\":\"field_69376909bd16f\",\"anchor_links_1_anchor_id\":\"Step2\",\"_anchor_links_1_anchor_id\":\"field_69376918bd170\",\"anchor_links\":2,\"_anchor_links\":\"field_693768d3bd16e\"},\"mode\":\"preview\"} /-->\n\n<!-- wp:paragraph -->\n<p><a href=\"#Step1\">Step 1</a>  |  <a href=\"#Step2\">Step 2</a></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Heading h2</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut laoreet dolore magna aliquam erat volutpat. Ut wisi enim ad minim veniam, quis nostrud exerci tation ullamcorper suscipit lobortis nisl ut aliquip ex ea commodo consequat. Duis autem vel eum iriure dolor in hendrerit in vulputate velit esse molestie consequat, vel illum dolore eu feugiat nulla facilisis at vero eros et accumsan et iusto odio dignissim qui blandit prae</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:image {\"id\":1947,\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"http://localhost:4000:4000:4000:4000:4000:4000:4000:4000:4000:4000:4000:4000:4000:4000/wp-content/uploads/2023/10/sc_hero_1-1024x585.jpg\" alt=\"SC Hero\" class=\"wp-image-1947\"/><figcaption class=\"wp-element-caption\">Caption here....</figcaption></figure>\n<!-- /wp:image -->\n\n<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">Heading H3</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Duis autem vel eum iriure dolor in hendrerit in vulputate velit esse molestie consequat, vel illum dolore eu feugiat nulla facilisis at vero eros et accumsan et iusto odio dignissim qui blandit prae Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut laoreet dolore magna aliquam erat volutpat. Ut wisi enim ad minim veniam, quis nostrud exerci tation ullamcorper suscipit lobortis nisl ut aliquip ex ea commodo consequat. </p>\n<!-- /wp:paragraph -->\n\n<!-- wp:details {\"className\":\"step-effects\"} -->\n<details id=\"Step5\" class=\"wp-block-details step-effects\"><summary>Step 1 | Step 1 title</summary><!-- wp:paragraph {\"placeholder\":\"Type / to add a hidden block\"} -->\n<p>Content</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>Content</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:image {\"id\":2329,\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"http://localhost:4000:4000:4000:4000:4000:4000:4000:4000:4000/wp-content/uploads/2025/12/shutterstock_2498750441_neutral-1024x501.jpg\" alt=\"\" class=\"wp-image-2329\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:acf/steps-section {\"name\":\"acf/steps-section\",\"data\":{\"steps_heading\":\"breakout\",\"_steps_heading\":\"field_69324339e80aa\",\"steps_sub_heading\":\"\",\"_steps_sub_heading\":\"field_6932434ae80ab\"},\"mode\":\"preview\"} /-->\n\n<!-- wp:paragraph -->\n<p>col</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:columns -->\n<div class=\"wp-block-columns\"><!-- wp:column {\"backgroundColor\":\"pale-pink\"} -->\n<div class=\"wp-block-column has-pale-pink-background-color has-background\"></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"backgroundColor\":\"vivid-green-cyan\"} -->\n<div class=\"wp-block-column has-vivid-green-cyan-background-color has-background\"></div>\n<!-- /wp:column -->\n\n<!-- wp:column {\"backgroundColor\":\"vivid-red\"} -->\n<div class=\"wp-block-column has-vivid-red-background-color has-background\"></div>\n<!-- /wp:column 