age_title','Lifestart is about supporting young children'),(49277,1643,'_second_image_title','field_5b67cb20ddf9a'),(49278,1643,'page_col_image','412'),(49279,1643,'_page_col_image','field_5de6546e7c63a'),(49280,1643,'page_col_image_3','437'),(49281,1643,'_page_col_image_3','field_5de6e3998e07e'),(49282,1643,'sec_2_title','Community'),(49283,1643,'_sec_2_title','field_5de6e3ef2798f'),(49284,1643,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(49285,1643,'_sec_2_text','field_5de78dc89e613'),(49286,1643,'sec_3_title','The Project'),(49287,1643,'_sec_3_title','field_5de6e3d37d8da'),(49288,1643,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(49289,1643,'_sec_3_text','field_5de6e4044e5e8'),(49290,1643,'page_col_image_2','436'),(49291,1643,'_page_col_image_2','field_5de6546e7c63a'),(49292,1643,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(49293,1643,'_sec_2_button','field_5de6e58c86706'),(49294,1643,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(49295,1643,'_sec_3_button','field_5de6e5a243c03'),(49296,1643,'page_col_image_4','455'),(49297,1643,'_page_col_image_4','field_5de70801090ce'),(49298,1643,'sec_4_title','Location'),(49299,1643,'_sec_4_title','field_5de7082a12a81'),(49300,1643,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(49301,1643,'_sec_4_text','field_5de7084812a82'),(49302,1643,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(49303,1643,'_sec_4_button','field_5de7085e12a83'),(49304,1643,'news_title','Project updates'),(49305,1643,'_news_title','field_5de78da3aabb9'),(49306,1643,'sec_2_text_copy',''),(49307,1643,'_sec_2_text_copy','field_5de78dc89e613'),(49308,1643,'timeline-title','Timeline'),(49309,1643,'_timeline-title','field_5de78df29e615'),(49310,1643,'timeline_title','Timeline'),(49311,1643,'_timeline_title','field_5de78df29e615'),(49312,1643,'contact_title','Contact us'),(49313,1643,'_contact_title','field_5de7981e06057'),(49314,1643,'contact_intro','Contact text...'),(49315,1643,'_contact_intro','field_5de7983506058'),(49316,1643,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(49317,1643,'_news_button','field_5de8329896e02'),(49318,1643,'timeline_intro','Introduction of timeline detail...'),(49319,1643,'_timeline_intro','field_5de98f5fb1781'),(49320,1643,'timeline_pic','477'),(49321,1643,'_timeline_pic','field_5de98f72b1782'),(49322,1643,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(49323,1643,'_timeline_button','field_5de99363677f8'),(49324,1643,'banner_image_position','center'),(49325,1643,'_banner_image_position','field_5f3bc4757dd02'),(49326,1643,'services_title','Our services'),(49327,1643,'_services_title','field_5f20f3cd80eb2'),(49328,1643,'services_items_0_services_item_image','1061'),(49329,1643,'_services_items_0_services_item_image','field_5f2121355be14'),(49330,1643,'services_items_0_sservices_item_title','1300 Telephone counselling line'),(49331,1643,'_services_items_0_sservices_item_title','field_605089efca82e'),(49332,1643