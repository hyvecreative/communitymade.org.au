index_7_survey_title','field_6294564042238'),(76850,1872,'survey_index_7_survey_url','#'),(76851,1872,'_survey_index_7_survey_url','field_6294564e42239'),(76852,1872,'survey_index_7_survey_url_text','View Results'),(76853,1872,'_survey_index_7_survey_url_text','field_629456584223a'),(76854,1872,'survey_index','8'),(76855,1872,'_survey_index','field_6294561242236'),(76856,1872,'report_title','Download the report'),(76857,1872,'_report_title','field_62f30edfb57e1'),(76858,1872,'report_intro','Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus massa erat, consectetur at semper at, feugiat vel orci. '),(76859,1872,'_report_intro','field_62f30eedb57e2'),(76860,1872,'report_link_url','#'),(76861,1872,'_report_link_url','field_62f30ef4b57e3'),(76862,1872,'report_link_text','Download'),(76863,1872,'_report_link_text','field_62f30f01b57e4'),(76864,1872,'solutions_content','The housing system is complex, and no one solution will solve the complex problems we now face but there are some critical first steps to be taken now.\r\n<ul>\r\n 	<li>Set out an ambitious national housing agreement between commonwealth and state governments with targets and funding for the construction of affordable homes.</li>\r\n 	<li>Phase out tax breaks for property investors and using the increase in revenue to build more public housing.</li>\r\n 	<li>Establish laws which limit rental increases beyond what is fair.</li>\r\n 	<li>Rebalance tenancy laws to provide renters with more security and control, such as eliminating no grounds evictions.</li>\r\n 	<li>Phase out stamp duty and replace it with a broad-based land tax.</li>\r\n</ul>\r\n<h4>While there are many opinions on what policy changes will fix the housing market, doing nothing is not an option.</h4>'),(76865,1872,'_solutions_content','field_640e8b307a958'),(76866,1872,'problem_icons_0_prob_icon','1699'),(76867,1872,'_problem_icons_0_prob_icon','field_640fa0291d519'),(76868,1872,'problem_icons_0_prob_concerned_stat','70% highly concerned'),(76869,1872,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(76870,1872,'problem_icons_0_prob_concerded_text','are highly concerned'),(76871,1872,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(76872,1872,'problem_icons_0_prob_issue_text',''),(76873,1872,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(76874,1872,'problem_icons','4'),(76875,1872,'_problem_icons','field_640fa0191d518'),(76876,1872,'ceh_content_left',''),(76877,1872,'_ceh_content_left','field_640e97e8f1c8c'),(76878,1872,'ceh_content_right',''),(76879,1872,'_ceh_content_right','field_640e97fdf1c8d'),(76880,1872,'pc_content_left',''),(76881,1872,'_pc_content_left','field_640e983bf1c8f'),(76882,1872,'pc_content_right',''),(76883,1872,'_pc_content_right','field_640e984df1c90'),(76884,1872,'problem_icons_1_prob_icon','1699'),(76885,1872,'_problem_icons_1_prob_icon','field_640fa0291d519'),(76886,1872,'problem_icons_1_prob_concerned_stat','69% highly concerned'),(76887,1872,'_problem_icons_1_prob_concerned_stat','field_640fa0dd81d95'),(76888,1872,'problem_icons_1_prob_concerded_text','are highly concerned'),(76889,1872,'_problem_icons_1_prob_concerded_text','field_640fa10181d96'),(76890,1872,'problem_icons_1_prob_issue_text',''),(76891,1872,'_problem_icons_1_prob_issue_text','field_640fa11a81d97'),(76892,1872,'problem_icons_2_prob_icon','1699'),(76893,1872,'_problem_icons_2_prob_icon','field_640fa0291d519'),(76894,1872,'problem_icons_2_prob_concerned_stat','64% highly concerned'),(76895,1872,'_problem_icons_2_prob_concerned_stat','field_640fa0dd81d95'),(76896,1872,'problem_icons_2_prob_concerded_text','are highly concerned'),(76897,1872,'_problem_icons_2_prob_concerded_text','field_640fa10181d96'),(76898,1872,'problem_icons_2_prob_issue_text',''),(76899,1872,'_problem_icons_2_prob_issue_text','field_640fa11a81d97'),(76900,1872,'problem_icons_3_prob_icon','1699'),(76901,1872,'_problem_icons_3_prob_icon','field_640fa0291d519'),(76902,1872,'problem_icons_3_prob_concerned_stat','64% highly concerned'),(76903,1872,'_problem_icons_3_prob_concerned_stat','field_640fa0dd81d95'),(76904,1872,'problem_icons_3_prob_concerded_text','are highly concerned'),(76905,1872,'_problem_icons_3_prob_concerded_text','field_640fa10181d96'),(76906,1872,'problem_icons_3_prob_issue_text',''),(76907,1872,'_problem_icons_3_prob_issue_text','field_640fa11a81d97'),(76908,1872,'problem_icons_0_prob_concerned_text','House prices have doubled in a decade'),(76909,1872,'_problem_icons_0_prob_concerned_text','field_640fa10181d96'),(76910,1872,'problem_icons_1_prob_concerned_text','The gap between rich and poor is growing'),(76911,1872,'_problem_icons_1_prob_concerned_text','field_640fa10181d96'),(76912,1872,'problem_icons_2_prob_concerned_text','Construction of social housing is down'),(76913,1872,'_problem_icons_2_prob_concerned_text','field_640fa10181d96'),(76914,1872,'problem_icons_3_prob_concerned_text','Banks are making more than ever from housing'),(76915,1872,'_problem_icons_3_prob_concerned_text','field_640fa10181d96'),(76916,1872,'monitor_content','The Australian Housing Monitor is a large, nationally-representative survey covering public experiences and attitudes toward housing related issues. Questions range from how well the respondent is keeping up with their mortgage/rent, to what they think about social housing construction.\r\n\r\nA broad range of demographic criteria are included, such as gender, location, age, income, voting preference, educational level, tenure type, and employment status. These variables allow CEH researchers to understand the trends and diversity of opinion around the country.\r\n\r\nIt also incorporates questions from previous surveys to track trends over time.\r\nThe inaugural poll was conducted by Essential in December 2022, and was completed by 4,735 people.'),(76917,1872,'_monitor_content','field_640fcc4014404'),(76918,1872,'problem_head','Housing in Australia is not working, and Australians are concerned.'),(76919,1872,'_problem_head','field_641935436aded'),(76920,1872,'problem_signoff','Explore the research showing how concerned Australians are our about the housing situation.'),(76921,1872,'_problem_signoff','field_641935626adee'),(76922,1872,'sections','a:2:{i:0;s:4:\"hero\";i:1;s:9:\"news_grid\";}'),(76923,1872,'_sections','field_5dafb40b8143a'),(76924,1872,'sections_0_is_full_height','1'),(76925,1872,'_sections_0_is_full_height','field_61d6f6fd5a37e'),(76926,1872,'sections_0_image','1648'),(76927,1872,'_sections_0_image','field_61d6f6d45a37d'),(76928,1872,'sections_0_heading','Heading'),(76929,1872,'_sections_0_heading','field_61d6f69e5a379'),(76930,1872,'sections_0_subtitle','Ya ya '),(76931,1872,'_sections_0_subtitle','field_61d6f6ac5a37a'),(76932,1872,'sections_0_link_one',''),(76933,1872,'_sections_0_link_one','field_61d6f6b55a37b'),(76934,1872,'sections_0_link_two',''),(76935,1872,'_sections_0_link_two','field_61d6f6c35a37c'),(76936,1872,'sections_1_select_categories','a:1:{i:0;s:2:\"27\";}'),(76937,1872,'_sections_1_select_categories','field_637f04483b63b'),(76938,1872,'intro_head_major','Queenslanders are known for both our love of the great outdoors and our state pride…'),(76939,1872,'_intro_head_major','field_64e828783ad9f'),(76940,1872,'intro_head_minor','But there’s a few things you might not know about our beautiful state.'),(76941,1872,'_intro_head_minor','field_64e8288c3ada0'),(76942,1872,'intro_icons_0_int_icon','1806'),(76943,1872,'_intro_icons_0_int_icon','field_64e828b33ada2'),(76944,1872,'intro_icons_0_int_icon_text','At 1,727,000 square kilometres, we’re 2.5 times the size of Texas. <span>Yeeha!</span>'),(76945,1872,'_intro_icons_0_int_icon_text','field_64e828e33ada3'),(76946,1872,'intro_icons_1_int_icon','1806'),(76947,1872,'_intro_icons_1_int_icon','field_64e828b33ada2'),(76948,1872,'intro_icons_1_int_icon_text','We have twice as many species of native plant and animal as any other Australian state or territory.'),(76949,1872,'_intro_icons_1_in