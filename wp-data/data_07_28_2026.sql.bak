),(134529,2263,'_gh_block_home','field_65262c8a143e1'),(134530,2263,'turn_on_insights',''),(134531,2263,'_turn_on_insights','field_645c4a2e654a6'),(134532,2263,'report_questions','a:3:{i:0;s:2:\"59\";i:1;s:2:\"61\";i:2;s:4:\"2587\";}'),(134533,2263,'_report_questions','field_6109ed5e02e5a'),(134534,2263,'footnotes',''),(134535,2263,'_links_to',''),(134536,2263,'_links_to_target',''),(134537,2263,'intro_text','The Disability Dialogue is a place where people with disabilities, their families, organisations providing support, academics, and the wider community come together to work on things that matter to us.\r\n\r\nThe Dialogue is a hub of knowledge and collaboration, separate from government, where we work together to come up. With new ideas on important topics. Our ideas can make a big difference in how services and systems are set up for people with disabilities.'),(134538,2263,'_intro_text','field_66441acfe963c'),(134539,2263,'word_link','#'),(134540,2263,'_word_link','field_6646c69723804'),(134541,2263,'pdf_link','#'),(134542,2263,'_pdf_link','field_6646c6da23805'),(134543,2263,'intro_boxes_0_box_image','2241'),(134544,2263,'_intro_boxes_0_box_image','field_65262db5d36ee'),(134545,2263,'intro_boxes_1_box_image','2179'),(134546,2263,'_intro_boxes_1_box_image','field_65262db5d36ee'),(134547,2263,'intro_boxes_2_box_image','2012'),(134548,2263,'_intro_boxes_2_box_image','field_65262db5d36ee'),(134549,2263,'intro_boxes_0_box_excerpt','Excerpt text here just a sentance or so and no more.'),(134550,2263,'_intro_boxes_0_box_excerpt','field_665975273e827'),(134551,2263,'intro_boxes_1_box_excerpt','Excerpt text here just a sentance or so and no more.'),(134552,2263,'_intro_boxes_1_box_excerpt','field_665975273e827'),(134553,2263,'intro_boxes_2_box_excerpt','Excerpt text here just a sentance or so and no more.'),(134554,2263,'_intro_boxes_2_box_excerpt','field_665975273e827'),(134555,2263,'intro_boxes_0_btn-text','Latest events'),(134556,2263,'_intro_boxes_0_btn-text','fie