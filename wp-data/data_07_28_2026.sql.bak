f92'),(83742,1918,'support_ctr_title','Talk to us'),(83743,1918,'_support_ctr_title','field_5b67c62a58af3'),(83744,1918,'support_ctr_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut laoreet.'),(83745,1918,'_support_ctr_cont','field_5b67c63158af4'),(83746,1918,'support_ctr_button','<a class=\"btn btn-orange\" href=\"/supports/\">Find us</a>'),(83747,1918,'_support_ctr_button','field_5b67c63658af5'),(83748,1918,'support_right_title','NDIS Registered provider'),(83749,1918,'_support_right_title','field_5b67c6a38c064'),(83750,1918,'support_right_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut.'),(83751,1918,'_support_right_cont','field_5b67c6c98c065'),(83752,1918,'support_right_button','<a class=\"btn btn-blue\" href=\"#\">Read more</a>'),(83753,1918,'_support_right_button','field_5b67c6dd8c066'),(83754,1918,'first_image_title','Lifestart is about supporting young children'),(83755,1918,'_first_image_title','field_5b67ca606afc4'),(83756,1918,'first_image_cont','from 0-24 years living with disabilities and their familes'),(83757,1918,'_first_image_cont','field_5b67caff6afc5'),(83758,1918,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(83759,1918,'_first_image_button','field_5b67cb0d6afc6'),(83760,1918,'second _image_title','Lifestart is about supporting young children'),(83761,1918,'_second _image_title','field_5b67cb20ddf9a'),(83762,1918,'second_image_cont','from 0-24 years living with disabilities and their familes'),(83763,1918,'_second_image_cont','field_5b67cb24ddf9b'),(83764,1918,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(83765,1918,'_second_image_button','field_5b67cb29ddf9c'),(83766,1918,'second_image_title','Lifestart is about supporting young children'),(83767,1918,'_second_image_title','field_5b67cb20ddf9a'),(83768,1918,'page_col_image','412'),(83769,1918,'_page_col_image','field_5de6546e7c63a'),(83770,1918,'page_col_image_3','437'),(83771,1918,'_page_col_image_3','field_5de6e3998e07e'),(83772,1918,'sec_2_title','Community'),(83773,1918,'_sec_2_title','field_5de6e3ef2798f'),(83774,1918,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(83775,1918,'_sec_2_text','field_5de78dc89e613'),(83776,1918,'sec_3_title','The Project'),(83777,1918,'_sec_3_title','field_5de6e3d37d8da'),(83778,1918,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(83779,1918,'_sec_3_text','field_5de6e4044e5e8'),(83780,1918,'page_col_image_2','436'),(83781,1918,'_page_col_image_2','field_5de6546e7c63a'),(83782,1918,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(83783,1918,'_sec_2_button','field_5de6e58c86706'),(83784,1918,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(83785,1918,'_sec_3_button','field_5de6e5a243c03'),(83786,1918,'page_col_image_4','455'),(83787,1918,'_page_col_image_4','field_5de70801090ce'),(83788,1918,'sec_4_title','Location'),(83789,1918,'_sec_4_title','field_5de7082a12a81'),(83790,1918,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(8