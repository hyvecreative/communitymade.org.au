','field_5b67caff6afc5'),(97405,1958,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(97406,1958,'_first_image_button','field_5b67cb0d6afc6'),(97407,1958,'second _image_title','Lifestart is about supporting young children'),(97408,1958,'_second _image_title','field_5b67cb20ddf9a'),(97409,1958,'second_image_cont','from 0-24 years living with disabilities and their familes'),(97410,1958,'_second_image_cont','field_5b67cb24ddf9b'),(97411,1958,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(97412,1958,'_second_image_button','field_5b67cb29ddf9c'),(97413,1958,'second_image_title','Lifestart is about supporting young children'),(97414,1958,'_second_image_title','field_5b67cb20ddf9a'),(97415,1958,'page_col_image','412'),(97416,1958,'_page_col_image','field_5de6546e7c63a'),(97417,1958,'page_col_image_3','437'),(97418,1958,'_page_col_image_3','field_5de6e3998e07e'),(97419,1958,'sec_2_title','Community'),(97420,1958,'_sec_2_title','field_5de6e3ef2798f'),(97421,1958,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(97422,1958,'_sec_2_text','field_5de78dc89e613'),(97423,1958,'sec_3_title','The Project'),(97424,1958,'_sec_3_title','field_5de6e3d37d8da'),(97425,1958,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(97426,1958,'_sec_3_text','field_5de6e4044e5e8'),(97427,1958,'page_col_image_2','436'),(97428,1958,'_page_col_image_2','field_5de6546e7c63a'),(97429,1958,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(97430,1958,'_sec_2_button','field_5de6e58c86706'),(97431,1958,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(97432,1958,'_sec_3_button','field_5de6e5a243c03'),(97433,1958,'page_col_image_4','455'),(97434,1958,'_page_col_image_4','field_5de70801090ce'),(97435,1958,'sec_4_title','Location'),(97436,1958,'_sec_4_title','field_5de7082a12a81'),(97437,1958,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(97438,1958,'_sec_4_text','field_5de7084812a82'),(97439,1958,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(97440,1958,'_sec_4_button','field_5de7085e12a83'),(97441,1958,'news_title','Project updates'),(97442,1958,'_news_title','field_5de78da3aabb9'),(97443,1958,'sec_2_text_copy',''),(97444,1958,'_sec_2_text_copy','field_5de78dc89e613'),(97445,1958,'timeline-title','Timeline'),(97446,1958,'_timeline-title','field_5de78df29e615'),(97447,1958,'timeline_title','Timeline'),(97448,1958,'_timeline_title','field_5de78df29e615'),(97449,1958,'contact_title','Contact us'),(97450,1958,'_contact_title','field_5de7981e06057'),(97451,1958,'contact_intro','Contact text...'),(97452,1958,'_contact_intro','field_5de7983506058'),(97453,1958,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(97454,1958,'_news_button','field_5de8329896e02'),(97455,1958,'timeline_intro','Introduction of timeline detail...'),(97456,1958,'_timeline_intro','field_5de98f5fb1781'),(97457,1958,'timeline_pic','477'),(97458,1958,'_timeline_pic','field_5de98f72b1782'),(97459,1958,'timeline_button','<a class=\"btn b