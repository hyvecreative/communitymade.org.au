94,1917,'second_image_title','Lifestart is about supporting young children'),(83095,1917,'_second_image_title','field_5b67cb20ddf9a'),(83096,1917,'page_col_image','412'),(83097,1917,'_page_col_image','field_5de6546e7c63a'),(83098,1917,'page_col_image_3','437'),(83099,1917,'_page_col_image_3','field_5de6e3998e07e'),(83100,1917,'sec_2_title','Community'),(83101,1917,'_sec_2_title','field_5de6e3ef2798f'),(83102,1917,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(83103,1917,'_sec_2_text','field_5de78dc89e613'),(83104,1917,'sec_3_title','The Project'),(83105,1917,'_sec_3_title','field_5de6e3d37d8da'),(83106,1917,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(83107,1917,'_sec_3_text','field_5de6e4044e5e8'),(83108,1917,'page_col_image_2','436'),(83109,1917,'_page_col_image_2','field_5de6546e7c63a'),(83110,1917,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(83111,1917,'_sec_2_button','field_5de6e58c86706'),(83112,1917,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(83113,1917,'_sec_3_button','field_5de6e5a243c03'),(83114,1917,'page_col_image_4','455'),(83115,1917,'_page_col_image_4','field_5de70801090ce'),(83116,1917,'sec_4_title','Location'),(83117,1917,'_sec_4_title','field_5de7082a12a81'),(83118,1917,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(83119,1917,'_sec_4_text','field_5de7084812a82'),(83120,1917,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(83121,1917,'_sec_4_button','field_5de7085e12a83'),(83122,1917,'news_title','Project updates'),(83123,1917,'_news_title','field_5de78da3aabb9'),(83124,1917,'sec_2_text_copy',''),(83125,1917,'_sec_2_text_copy','field_5de78dc89e613'),(83126,1917,'timeline-title','Timeline'),(83127,1917,'_timeline-title','field_5de78df29e615'),(83128,1917,'timeline_title','Timeline'),(83129,1917,'_timeline_title','field_5de78df29e615'),(83130,1917,'contact_title','Contact us'),(83131,1917,'_contact_title','field_5de7981e06057'),(83132,1917,'contact_intro','Contact text...'),(83133,1917,'_contact_intro','field_5de7983506058'),(83134,1917,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(83135,1917,'_news_button','field_5de8329896e02'),(83136,1917,'timeline_intro','Introduction of timeline detail...'),(83137,1917,'_timeline_intro','field_5de98f5fb1781'),(83138,1917,'timeline_pic','477'),(83139,1917,'_timeline_pic','field_5de98f72b1782'),(83140,1917,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(83141,1917,'_timeline_button','field_5de99363677f8'),(83142,1917,'banner_image_position','center'),(83143,1917,'_banner_image_position','field_5f3bc4757dd02'),(83144,1917,'services_title','Our services'),(83145,1917,'_services_title','field_5f20f3cd80eb2'),(83146,1917,'services_items_0_services_item_image','1061'),(83147,1917,'_services_items_0_services_item_image','field_5f2121355be14'),(83148,1917,'services_items_0_sservices_item_title','1300 Telephone counselling line'),(83149,1917,'_services_items_0_sservices_item_title','field_605089efc