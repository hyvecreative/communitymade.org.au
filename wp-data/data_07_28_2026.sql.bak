_cont','field_5b67cb24ddf9b'),(172626,2586,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(172627,2586,'_second_image_button','field_5b67cb29ddf9c'),(172628,2586,'second_image_title','Lifestart is about supporting young children'),(172629,2586,'_second_image_title','field_5b67cb20ddf9a'),(172630,2586,'page_col_image','412'),(172631,2586,'_page_col_image','field_5de6546e7c63a'),(172632,2586,'page_col_image_3','437'),(172633,2586,'_page_col_image_3','field_5de6e3998e07e'),(172634,2586,'sec_2_title','Community'),(172635,2586,'_sec_2_title','field_5de6e3ef2798f'),(172636,2586,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(172637,2586,'_sec_2_text','field_5de78dc89e613'),(172638,2586,'sec_3_title','The Project'),(172639,2586,'_sec_3_title','field_5de6e3d37d8da'),(172640,2586,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(172641,2586,'_sec_3_text','field_5de6e4044e5e8'),(172642,2586,'page_col_image_2','436'),(172643,2586,'_page_col_image_2','field_5de6546e7c63a'),(172644,2586,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(172645,2586,'_sec_2_button','field_5de6e58c86706'),(172646,2586,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(172647,2586,'_sec_3_button','field_5de6e5a243c03'),(172648,2586,'page_col_image_4','455'),(172649,2586,'_page_col_image_4','field_5de70801090ce'),(172650,2586,'sec_4_title','Location'),(172651,2586,'_sec_4_title','field_5de7082a12a81'),(172652,2586,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(172653,2586,'_sec_4_text','field_5de7084812a82'),(172654,2586,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(172655,2586,'_sec_4_button','field_5de7085e12a83'),(172656,2586,'news_title','Project updates'),(172657,2586,'_news_title','field_5de78da3aabb9'),(172658,2586,'sec_2_text_copy',''),(172659,2586,'_sec_2_text_copy','field_5de78dc89e613'),(172660,2586,'timeline-title','Timeline'),(172661,2586,'_timeline-title','field_5de78df29e615'),(172662,2586,'timeline_title','Timeline'),(172663,2586,'_timeline_title','field_5de78df29e615'),(172664,2586,'contact_title','Contact us'),(172665,2586,'_contact_title','field_5de7981e06057'),(172666,2586,'contact_intro','Contact text...'),(172667,2586,'_contact_intro','field_5de7983506058'),(172668,2586,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(172669,2586,'_news_button','field_5de8329896e02'),(172670,2586,'timeline_intro','Introduction of timeline detail...'),(172671,2586,'_timeline_intro','field_5de98f5fb1781'),(172672,2586,'timeline_pic','477'),(172673,2586,'_timeline_pic','field_5de98f72b1782'),(172674,2586,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(172675,2586,'_timeline_button','field_5de99363677f8'),(172676,2586,'banner_image_position','center'),(172677,2586,'_banner_image_position','field_5f3bc4757dd02'),(172678,2586,'services_title','Our services'),(172679,2586,'_services_title','field_5f20f3cd80eb2'),(172680,2586,'services_items_0_services_item_imag