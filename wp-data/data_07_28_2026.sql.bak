raph -->\n\n<!-- wp:paragraph -->\n<p></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>text</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:kadence/accordion {\"uniqueID\":\"2494_ead54e-37\",\"paneCount\":4,\"startCollapsed\":true,\"contentBorderStyle\":[{\"top\":[\"\",\"\",0],\"right\":[\"\",\"\",0],\"bottom\":[\"\",\"\",0],\"left\":[\"\",\"\",0],\"unit\":\"px\"}],\"titleStyles\":[{\"size\":[null,\"\",\"\"],\"sizeType\":\"px\",\"lineHeight\":[1.4,\"\",1.1],\"lineType\":\"\",\"letterSpacing\":\"\",\"family\":\"-apple-system,BlinkMacSystemFont,u0022Segoe UIu0022,Roboto,Oxygen-Sans,Ubuntu,Cantarell,u0022Helvetica Neueu0022,sans-serif, u0022Apple Color Emojiu0022, u0022Segoe UI Emojiu0022, u0022Segoe UI Symbolu0022\",\"google\":false,\"style\":\"normal\",\"weight\":\"inherit\",\"variant\":\"\",\"subset\":\"\",\"loadGoogle\":true,\"padding\":[18,13,18,13],\"marginTop\":20,\"color\":\"#555555\",\"background\":\"#f2f2f2\",\"border\":[\"\",\"\",\"\",\"\"],\"borderRadius\":[\"\",\"\",\"\",\"\"],\"borderWidth\":[\"\",\"\",\"\",\"\"],\"colorHover\":\"#444444\",\"backgroundHover\":\"#eeeeee\",\"borderHover\":[\"\",\"\",\"\",\"\"],\"colorActive\":\"#ffffff\",\"backgroundActive\":\"#444444\",\"borderActive\":[\"\",\"\",\"\",\"\"],\"textTransform\":\"\"}],\"titleBorder\":[{\"top\":[\"#f2f2f2\",\"\",1],\"right\":[\"#f2f2f2\",\"\",1],\"bottom\":[\"#f2f2f2\",\"\",1],\"left\":[\"#f2f2f2\",\"\",1],\"unit\":\"px\"}],\"titleBorderHover\":[{\"top\":[\"#878787\",\"\",1],\"right\":[\"#878787\",\"\",1],\"bottom\":[\"#878787\",\"\",1],\"left\":[\"#878787\",\"\",1],\"unit\":\"px\"}],\"titleBorderActive\":[{\"top\":[\"#444444\",\"\",1],\"right\":[\"#444444\",\"\",1],\"bottom\":[\"#444444\",\"\",1],\"left\":[\"#444444\",\"\",1],\"unit\":\"px\"}],\"titleBorderRadius\":[8,8,8,8],\"iconStyle\":\"arrow\",\"faqSchema\":true} -->\n<div class=\"wp-block-kadence-accordion alignnone\"><div class=\"kt-accordion-wrap kt-accordion-id2494_ead54e-37 kt-accordion-has-4-panes kt-active-pane-0 kt-accordion-block kt-pane-header-alignment-left kt-accodion-icon-style-arrow kt-accodion-icon-side-right\" style=\"max-width:none\"><div class=\"kt-accordion-inner-wrap\" data-allow-multiple-open=\"false\" data-start-open=\"none\"><!-- wp:kadence/pane {\"titleTag\":\"h2\",\"uniqueID\":\"2494_56f4f9-87\"} -->\n<div class=\"wp-block-kadence-pane kt-accordion-pane kt-accordion-pane-1 kt-pane2494_56f4f9-87\"><h2 class=\"kt-accordion-header-wrap\"><button class=\"kt-blocks-accordion-header kt-acccordion-button-label-show\" type=\"button\"><span class=\"kt-blocks-accordion-title-wrap\"><span class=\"kt-blocks-accordion-title\">Step 5</span></span><span class=\"kt-blocks-accordion-icon-trigger\"></span></button></h2><div class=\"kt-accordion-panel\"><div class=\"kt-accordion-panel-inner\"><!-- wp:paragraph -->\n<p>text</p>\n<!-- /wp:paragraph --></div></div></div>\n<!-- /wp:kadence/pane -->\n\n<!-- wp:kadence/pane {\"id\":2,\"titleTag\":\"h2\",\"uniqueID\":\"2494_36de4f-14\"} -->\n<div class=\"wp-block-kadence-pane kt-accordion-pane kt-accordion-pane-2 kt-pane2494_36de4f-14\"><h2 class=\"kt-accordion-header-wrap\"><button class=\"kt-blocks-accordion-header kt-acccordion-button-label-show\" type=\"button\"><span class=\"kt-blocks-accordion-title-wrap\"><span class=\"kt-blocks-accordion-title\">Step 6</span></span><span class=\"kt-blocks-accordion-icon-trigger\"></span></button></h2><div class=\"kt-accordion-panel\"><div class=\"kt-accordion-panel-inner\"><!-- wp:paragraph -->\n<p>text</p>\n<!-- /wp:paragraph --></div></div></div>\n<!-- /wp:kadence/pane --></div></div></div>\n<!-- /wp:kadence/accordion -->\n\n<!-- wp:paragraph -->\n<p></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:acf/breakout {\"name\":\"acf/breakout\",\"data\":{\"break_heading\":\"Where can I get more information?\",\"_break_heading\":\"field_693788cb34aeb\",\"break_content\":\"See the links below for more information about each topic.\",\"_break_content\":\"field_6937895c563a9\"},\"mode\":\"edit\"} /-->\n\n<!-- wp:paragraph -->\n<p></p>\n<!-- /wp:paragraph -->','Make a Complaint','','inherit','closed','closed','','2494-revision-v1','','','2025-12-09 03:34:17','2025-12-09 03:34:17','',2494,'http://localhost/?p=2500',0,'revision','',0),(2502,1,'2025-12-09 03:35:45','2025-12-09 03:35:45','<!-- wp:acf/anchor-nav {\"name\":\"acf/anchor-nav\",\"data\":{\"anchor_links_0_label\":\"The AFCA complaint process\",\"_anchor_links_0_label\":\"field_69376909bd16f\",\"anchor_links_0_anchor_id\":\"AFCA_Complaint\",\"_anchor_links_0_anchor_id\":\"field_69376918bd170\",\"anchor_links_1_label\":\"Step 1 | Make a complaint to the financial business\",\"_anchor_links_1_label\":\"field_69376909bd16f\",\"anchor_links_1_anchor_id\":\"Step1\",\"_anchor_links_1_anchor_id\":\"field_69376918bd170\",\"anchor_links_2_label\":\"Step 2 | Step two title\",\"_anchor_links_2_label\":\"field_69376909bd16f\",\"anchor_links_2_anchor_id\":\"Step2\",\"_anchor_links_2_anchor_id\":\"field_69376918bd170\",\"anchor_links_3_label\":\"\",\"_anchor_links_3_label\":\"field_69376909bd16f\",\"anchor_links_3_anchor_id\":\"\",\"_anchor_links_3_anchor_id\":\"field_69376918bd170\",\"anchor_links\":4,\"_anchor_links\":\"field_693768d3bd16e\"},\"mode\":\"preview\"} /-->\n\n<!-- wp:heading -->\n<h2 class=\"wp-block-heading\">How to make a complaint</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>You’ve been impacted by the collapse of Shield or First Guardian Master Fund and you want to get your money back - what do you need to do? This page provides information on how to ask for compensation from different financial businesses that may have been involved in your investment journey.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading -->\n<h2 class=\"wp-block-heading\" id=\"AFCA_Complaint\">The AFCA complaint process</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>If you have lost money as a result of the collapse of Shield or First Guardian, you may be able to get compensation. To get compensation, you must make a complaint. You have a right to complain to the Australian Financial Complaints Authority (AFCA) about a financial business you have concerns with as long as they are an AFCA member. This page explains the process of making an AFCA complaint as well as important information about deadlines.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:spacer {\"height\":\"16px\"} -->\n<div style=\"height:16px\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n<!-- /wp:spacer -->\n\n<!-- wp:kadence/accordion {\"uniqueID\":\"2494_b892e1-5e\",\"paneCount\":4,\"startCollapsed\":true,\"contentBorderStyle\":[{\"top\":[\"\",\"\",0],\"right\":[\"\",\"\",0],\"bottom\":[\"\",\"\",0],\"left\":[\"\",\"\",0],\"unit\":\"px\"}],\"titleStyles\":[{\"size\":[null,\"\",\"\"],\"sizeType\":\"px\",\"lineHeight\":[1.4,\"\",1.1],\"lineType\":\"\",\"letterSpacing\":\"\",\"family\":\"-apple-system,BlinkMacSystemFont,u0022Segoe UIu0022,Roboto,Oxygen-Sans,Ubuntu,Cantarell,u0022Helvetica Neueu0022,sans-serif, u0022Apple Color Emojiu0022, u0022Segoe UI Emojiu0022, u0022Segoe UI Symbolu0022\",\"google\":false,\"style\":\"normal\",\"weight\":\"inherit\",\"variant\":\"\",\"subset\":\"\",\"loadGoogle\":true,\"padding\":[18,13,18,13],\"marginTop\":20,\"color\":\"#555555\",\"background\":\"#f2f2f2\",\"border\":[\"\",\"\",\"\",\"\"],\"borderRadius\":[\"\",\"\",\"\",\"\"],\"borderWidth\":[\"\",\"\",\"\",\"\"],\"colorHover\":\"#444444\",\"backgroundHover\":\"#eeeeee\",\"borderHover\":[\"\",\"\",\"\",\"\"],\"colorActive\":\"#ffffff\",\"backgroundActive\":\"#444444\",\"borderActive\":[\"\",\"\",\"\",\"\"],\"textTransform\":\"\"}],\"titleBorder\":[{\"top\":[\"#f2f2f2\",\"\",1],\"right\":[\"#f2f2f2\",\"\",1],\"bottom\":[\"#f2f2f2\",\"\",1],\"left\":[\"#f2f2f2\",\"\",1],\"unit\":\"px\"}],\"titleBorderHover\":[{\"top\":[\"#878787\",\"\",1],\"right\":[\"#878787\",\"\",1],\"bottom\":[\"#878787\",\"\",1],\"left\":[\"#878787\",\"\",1],\"unit\":\"px\"}],\"titleBorderActive\":[{\"top\":[\"#444444\",\"\",1],\"right\":[\"#444444\",\"\",1],\"bottom\":[\"#444444\",\"\",1],\"left\":[\"#444444\",\"\",1],\"unit\":\"px\"}],\"titleBorderRadius\":[8,8,8,8],\"iconStyle\":\"arrow\",\"faqSchema\":true} -->\n<div class=\"wp-block-kadence-accordion alignnone\"><div class=\"kt-accordion-wrap kt-accordion-id2494_b892e1-5e kt-accordion-has-4-panes kt-active-pane-0 kt-accordion-block kt-pane-header-alignment-left kt-accodion-icon-style-arrow kt-accodion-icon-side-right\" style=\"max-width:none\"><div class=\"kt-accordion-inner-wrap\" data-allow-multiple-open=\"false\" data-start-open=\"none\"><!-- wp:kadence/pane {\"id\":2,\"titleTag\":\"h2\",\"uniqueID\":\"2494_6fb136-90\"} -->\n<div class=\"wp-block-kadence-pane kt-accordion-pane kt-accordion-pane-2 kt-pane2494_6fb136-90\" id=\"Step1\"><h2 class=\"kt-accordion-header-wrap\"><button class=\"kt-blocks-accordion-header kt-acccordion-button-label-show\" type=\"button\"><span class=\"kt-blocks-accordion-title-wrap\"><span class=\"kt-blocks-accordion-title\">Step 1 | Make a complaint to the financial business</span></span><span class=\"kt-blocks-accordion-icon-trigger\"></span></button></h2><div class=\"kt-accordion-panel\"><div class=\"kt-accordion-panel-inner\"><!-- wp:paragraph -->\n<p>Generally, you should complain to the financial business first before complaining to AFCA. This gives the business the chance to fix any problems without you having to make an AFCA complaint. Information about how to complain to a financial business can be found on their website.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>If you don’t feel comfortable complaining to the business first, or they have closed or you don’t know how to contact them, you can skip this step. If the deadline to make a complaint with AFCA is close, you should skip this step. AFCA may still ask the business to respond to your complaint before they process it.&nbsp;</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>If you complain to a financial business, they are required to provide a response to you within 45 days. If you are not satisfied with that response, or they do not respond, you can make a complaint to AFCA.</p>\n<!-- /wp:paragraph --></div></div></div>\n<!-- /wp:kadence/pane -->\n\n<!-- wp:kadence/pane {\"titleTag\":\"h2\",\"uniqueID\":\"2494_1acb90-f6\"} -->\n<div class=\"wp-block-kadence-pane kt-accordion-pane kt-accordion-pane-1 kt-pane2494_1acb90-f6\" id=\"Step2\"><h2 class=\"kt-accordion-header-wrap\"><button class=\"kt-blocks-accordion-header kt-acccordion-button-label-show\" type=\"button\"><span class=\"kt-blocks-accordion-title-wrap\"><span class=\"kt-blocks-accordion-title\"><strong>Step 1 | Make a complaint to the financial business </strong></span></span><span class=\"kt-blocks-accordion-icon-trigger\"></span></button></h2><div class=\"kt-accordion-panel\"><div class=\"kt-accordion-panel-inner\"><!-- wp:paragraph -->\n<p>Para option 1</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:image {\"id\":2329,\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-large\"><img src=\"http://localhost:4000:4000:4000:4000:4000:4000:4000:4000:4000/wp-content/uploads/2025/12/shutterstock_2498750441_neutral-1024x501.jpg\" alt=\"\" class=\"wp-image-2329\"/></figure>\n<!-- /wp:image -->\n\n<!-- wp:paragraph -->\n<p>Content para</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>Content para with alert</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:kadence/iconlist {\"uniqueID\":\"2494_5ef29c-58\"} -->\n<div class=\"wp-block-kadence-iconlist kt-svg-icon-list-items kt-svg-icon-list-items2494_5ef29c-58 kt-svg-icon-list-columns-1 alignnone\"><ul class=\"kt-svg-icon-list\"><!-- wp:kadence/listitem {\"uniqueID\":\"2494_d3281d-a3\",\"icon\":\"fe_activity\",\"size\":41,\"markColor\":\"#ff6900\"} -->\n<li class=\"wp-block-kadence-listitem kt-svg-icon-list-item-wrap kt-svg-icon-list-item-2494_d3281d-a3\"><span data-name=\"fe_activity\" data-stroke=\"USE_PARENT_DEFAULT_WIDTH\" data-class=\"kt-svg-icon-list-single\" class=\"kadence-dynamic-icon\"></