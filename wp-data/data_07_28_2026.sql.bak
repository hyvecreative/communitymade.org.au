5708c26827'),(161113,2508,'team_members_3_member_title','Manager'),(161114,2508,'_team_members_3_member_title','field_5b7570b326828'),(161115,2508,'team_members_3_first_name','Josh'),(161116,2508,'_team_members_3_first_name','field_5b7570cf26829'),(161117,2508,'team_members_3_last_name','Maneeva'),(161118,2508,'_team_members_3_last_name','field_5b7570de2682a'),(161119,2508,'team_members_3_member_text','Aliquam erat volutpat Ut wisi enim ad minim veniam laoreet dolore magna.'),(161120,2508,'_team_members_3_member_text','field_5b7570f12682b'),(161121,2508,'team_members_0_member_image','367'),(161122,2508,'_team_members_0_member_image','field_5b7572a89973e'),(161123,2508,'team_members_1_member_image','367'),(161124,2508,'_team_members_1_member_image','field_5b7572a89973e'),(161125,2508,'team_members_2_member_image','367'),(161126,2508,'_team_members_2_member_image','field_5b7572a89973e'),(161127,2508,'team_members_3_member_image','367'),(161128,2508,'_team_members_3_member_image','field_5b7572a89973e'),(161129,2508,'banner_button',''),(161130,2508,'_banner_button','field_5b568147fd367'),(161131,2508,'intro_col_1','The Take Control Campaign is a new movement of people who want to make Australia safer when it comes to drugs.'),(161132,2508,'_intro_col_1','field_5df5c6cef3ddb'),(161133,2508,'intro_col_2','The campaign has been launched by the Ted Noffs Foundation, Australia\'s largest provider of drug and alcohol treatment services for young people. The Foundation strives to help disadvantaged young people become advantaged and supports them on their journey to take back control of their lives.'),(161134,2508,'_intro_col_2','field_5df5c6deee1ca'),(161135,2508,'intro_col_3','With community support, the Take Control Campaign aims to change the conversation surrounding drugs and drug use in Australia. Through our common sense plan, we are demanding governments take control of the issue and fix our broken drug laws.'),(161136,2508,'_intro_col_3','field_5df5c6e99b7a8'),(161137,2508,'intro_logo','610'),(161138,2508,'_intro_logo','field_5df5c6f18c801'),(161139,2508,'intro_title','Decades of failed drug policy have resulted in unnecessary suffering. We have a secret and chaotic black market run by criminals and gangs. We have no control.'),(161140,2508,'_intro_title','field_5df5c6799cfec'),(161141,2508,'intro_bullets','Despite the best efforts of our police forces, for every drug dealer we catch, more simply start and operate with impunity.\r\n\r\nAny teenager can get drugs easily. People who use drugs can’t be sure what they are taking. Innocent young people who are just experimenting can buy themselves a death sentence.\r\n\r\nWorst of all, it’s often hard for people with problems to access help because they\'re treated like criminals.\r\n\r\nThis is because our governments refuse to take control of drugs.\r\n\r\nParents need greater tools and strategies to help their kids cope with the challenges of modern life.\r\n\r\nIt’s not good enough to put our heads in the sand and tell our kids to “just say no”. It doesn\'t work.\r\n\r\nIt\'s time to end the fear tactics. It\'s time to end the marketing gimmicks. People need real resources to reduce the harms associated with drug use.\r\n\r\nOur state and federal governments need to work together to get drug use under control by putting health and safety first.'),(161142,2508,'_intro_bullets','field_5df5c6799d05a'),(161143,2508,'intro_text',''),(161144,2508,'_intro_text','field_5df5c6799d0c6'),(161145,2508,'plan_title',''),(161146,2508,'_plan_title','field_5df5c6799d197'),(161147,2508,'plan_icons_row','5'),(161148,2508,'_plan_icons_row','field_5df5c6799d211'),(161149,2508,'plan_icons_row_0_plan_icon','516'),(161150,2508,'_plan_icons_row_0_plan_icon','field_5df5c679a8044'),(161151,2508,'plan_icons_row_0_plan_icon_text',' Roll out pill testing services nationally to reduce harm at music festivals and parties'),(161152,2508,'_plan_icons_row_0_plan_icon_text','field_5df5c679a80ae'),(161153,2508,'plan_icons_row_1_plan_icon','515'),(161154,2508,'_plan_icons_row_1_plan_icon','field_5df5c679a8044'),(161155,2508,'plan_icons_row_1_plan_icon_text','Expand treatment services for people suffering from drug problems'),(161156,2508,'_plan_icons_row_1_plan_icon_text','field_5df5c679a80ae'),(161157,2508,'plan_icons_row_2_plan_icon','514'),(161158,2508,'_plan_icons_row_2_plan_icon','field_5df5c679a8044'),(161159,2508,'plan_icons_row_2_plan_icon_text','Establish more drug monitoring rooms to save lives and improve communities'),(161160,2508,'_plan_icons_row_2_plan_icon_text','field_5df5c679a80ae'),(161161,2508,'plan_icons_row_3_plan_icon','513'),(161162,2508,'_plan_icons_row_3_plan_icon','field_5df5c679a8044'),(161163,2508,'plan_icons_row_3_plan_icon_text','Enhance engagement services for disadvantaged young people'),(161164,2508,'_plan_icons_row_3_plan_icon_text','field_5df5c679a80ae'),(161165,2508,'plan_icons_row_4_plan_icon','512'),(161166,2508,'_plan_icons_row_4_plan_icon','field_5df5c679a8044'),(161167,2508,'plan_icons_row_4_plan_icon_text','End criminal charges that make getting help harder and ruin young lives for minor possession of illicit drugs'),(161168,2508,'_plan_icons_row_4_plan_icon_text','field_5df5c679a80ae'),(161169,2508,'banner_image_position','center'),(161170,2508,'_banner_image_position','field_5f3bc4757dd02'),(161171,2508,'page_image','861'),(161172,2508,'_page_image','field_5f868320f904a'),(161173,2508,'echo_title','0'),(161174,2508,'_echo_title','field_5f868f339dd59'),(161175,2508,'problem_panel_title',''),(161176,2508,'_problem_panel_title','field_5f20f3cd80eb2'),(161177,2508,'problem_panel_items',''),(161178,2508,'_problem_panel_items','field_5f20f3dbe5a77'),(161179,2508,'problem_subhead',''),(161180,2508,'_problem_subhead','field_5f2121dff763d'),(161181,2508,'solution_title',''),(161182,2508,'_solution_title','field_5f21219394b8b'),(161183,2508,'solution_panel_items',''),(161184,2508,'_solution_panel_items','field_5f2121a594b8c'),(161185,2508,'mshi