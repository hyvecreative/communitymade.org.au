932,'_sec_2_title','field_5de6e3ef2798f'),(88504,1932,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(88505,1932,'_sec_2_text','field_5de78dc89e613'),(88506,1932,'sec_3_title','The Project'),(88507,1932,'_sec_3_title','field_5de6e3d37d8da'),(88508,1932,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(88509,1932,'_sec_3_text','field_5de6e4044e5e8'),(88510,1932,'page_col_image_2','436'),(88511,1932,'_page_col_image_2','field_5de6546e7c63a'),(88512,1932,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(88513,1932,'_sec_2_button','field_5de6e58c86706'),(88514,1932,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(88515,1932,'_sec_3_button','field_5de6e5a243c03'),(88516,1932,'page_col_image_4','455'),(88517,1932,'_page_col_image_4','field_5de70801090ce'),(88518,1932,'sec_4_title','Location'),(88519,1932,'_sec_4_title','field_5de7082a12a81'),(88520,1932,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(88521,1932,'_sec_4_text','field_5de7084812a82'),(88522,1932,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location informa