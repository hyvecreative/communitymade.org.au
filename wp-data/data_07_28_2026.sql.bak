vey_index_7_survey_url','#'),(76205,1871,'_survey_index_7_survey_url','field_6294564e42239'),(76206,1871,'survey_index_7_survey_url_text','View Results'),(76207,1871,'_survey_index_7_survey_url_text','field_629456584223a'),(76208,1871,'survey_index','8'),(76209,1871,'_survey_index','field_6294561242236'),(76210,1871,'report_title','Download the report'),(76211,1871,'_report_title','field_62f30edfb57e1'),(76212,1871,'report_intro','Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus massa erat, consectetur at semper at, feugiat vel orci. '),(76213,1871,'_report_intro','field_62f30eedb57e2'),(76214,1871,'report_link_url','#'),(76215,1871,'_report_link_url','field_62f30ef4b57e3'),(76216,1871,'report_link_text','Download'),(76217,1871,'_report_link_text','field_62f30f01b57e4'),(76218,1871,'solutions_content','The housing system is complex, and no one solution will solve the complex problems we now face but there are some critical first steps to be taken now.\r\n<ul>\r\n 	<li>Set out an ambitious national housing agreement between commonwealth and state governments with targets and funding for the construction of affordable homes.</li>\r\n 	<li>Phase out tax breaks for property investors and using the increase in revenue to build more public housing.</li>\r\n 	<li>Establish laws which limit rental increases beyond what is fair.</li>\r\n 	<li>Rebalance tenancy laws to provide renters with more security and control, such as eliminating no grounds evictions.</li>\r\n 	<li>Phase out stamp duty and replace it with a broad-based land tax.</li>\r\n</ul>\r\n<h4>While there are many opinions on what policy changes will fix the housing market, doing nothing is not an option.</h4>'),(76219,1871,'_solutions_content','field_640e8b307a958'),(76220,1871,'problem_icons_0_prob_icon','1699'),(76221,1871,'_problem_icons_0_prob_icon','field_640fa0291d519'),(76222,1871,'problem_icons_0_prob_concerned_stat','70% highly concerned'),(76223,1871,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(76224,1871,'problem_icons_0_prob_concerded_text','are highly concerned'),(76225,1871,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(76226,1871,'problem_icons_0_prob_issue_text',''),(76227,1871,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(76228,1871,'problem_icons','4'),(76229,1871,'_problem_icons','field_640fa0191d518'),(76230,1871,'ceh_content_left',''),(76231,1871,'_ceh_content_left','field_640e97e8f1c8c'),(76232,1871,'ceh_content_right',''),(76233,1871,'_ceh_content_right','field_640e97fdf1c8d'),(76234,1871,'pc_content_left',''),(76235,1871,'_pc_content_left','field_640e983bf1c8f'),(76236,1871,'pc_content_right',''),(76237,1871,'_pc_content_right','field_640e984df1c90'),(76238,1871,'problem_icons_1_prob_icon','1699'),(76239,1871,'_problem_icons_1_prob_icon','field_640fa0291d519'),(76240,1871,'problem_icons_1_prob_concerned_stat','69% highly concerned'),(76241,1871,'_problem_icons_1_prob_concerned_stat','field_640fa0dd81d95'),(76242,1871,'problem_icons_1_prob_concerded_text','are highly concerned'),(76243,1871,'_problem_icons_1_prob_concerded_text','field_640fa10181d96'),(76244,1871,'problem_icons_1_prob_issue_text',''),(76245,1871,'_problem_icons_1_prob_issue_text','field_640fa11a81d97'),(76246,1871,'problem_icons_2_prob_icon','1699'),(76247,1871,'_problem_icons_2_prob_icon','field_640fa0291d519'),(76248,1871,'problem_icons_2_prob_concerned_stat','64% highly concerned'),(76249,1871,'_problem_icons_2_prob_concerned_stat','field_640fa0dd81d95'),(76250,1871,'problem_icons_2_prob_concerded_text','are highly concerned'),(76251,1871,'_problem_icons_2_prob_concerded_text','field_640fa10181d96'),(76252,1871,'problem_icons_2_prob_issue_text',''),(76253,1871,'_problem_icons_2_prob_issue_text','field_640fa11a81d97'),(76254,1871,'problem_icons_3_prob_icon','1699'),(76255,1871,'_problem_icons_3_prob_icon','field_640fa0291d519'),(76256,1871,'problem_icons_3_prob_concerned_stat','64% highly concerned'),(76257,1871,'_problem_icons_3_prob_concerned_stat','field_640fa0dd81d95'),(76258,1871,'problem_icons_3_prob_concerded_text','are highly concerned'),(76259,1871,'_problem_icons_3_prob_concerded_text','field_640fa10181d96'),(76260,1871,'problem_icons_3_prob_issue_text',''),(76261,1871,'_problem_icons_3_prob_issue_text','field_640fa11a81d97'),(76262,1871,'problem_icons_0_prob_concerned_text','House prices have doubled in a decade'),(76263,1871,'_problem_icons_0_prob_concerned_text','field_640fa10181d96'),(76264,1871,'problem_icons_1_prob_concerned_text','The gap between rich and poor is growing'),(76265,1871,'_problem_icons_1_prob_concerned_text','field_640fa10181d96'),(76266,1871,'problem_icons_2_prob_concerned_text','Construction of social housing is down'),(76267,1871,'_problem_icons_2_prob_concerned_text','field_640fa10181d96'),(76268,1871,'problem_icons_3_prob_concerned_text','Banks are making more than ever from housing'),(76269,1871,'_problem_icons_3_prob_concerned_text','field_640fa10181d96'),(76270,1871,'monitor_content','The Australian Housing Monitor is a large, nationally-representative survey covering public experiences and attitudes toward housing related issues. Questions range from how well the respondent is keeping up with their mortgage/rent, to what they think about social housing construction.\r\n\r\nA broad range of demographic criteria are included, such as gender, location, age, income, voting preference, educational level, tenure type, and employment status. These variables allow CEH researchers to understand the trends and diversity of opinion around the country.\r\n\r\nIt also incorporates questions from previous surveys to track trends over time.\r\nThe inaugural poll was conducted by Essential in December 2022, and was completed by 4,735 people.'),(76271,1871,'_monitor_content','field_640fcc4014404'),(76272,1871,'problem_head','Housing in Australia is not working, and Australians are concerned.'),(76273,1871,'_problem_head','field_641935436aded'),(76274,1871,'problem_signoff','Explore the research showing how concerned Australians are our about the housing situation.'),(76275,1871,'_problem_signoff','field_641935626adee'),(76276,1871,'sections','a:2:{i:0;s:4:\"hero\";i:1;s:9:\"news_grid\";}'),(76277,1871,'_sections','field_5dafb40b8143a'),(76278,1871,'sections_0_is_full_height','1'),(76279,1871,'_sections_0_is_full_height','field_61d6f6fd5a37e'),(76280,1871,'sections_0_image','1648'),(76281,1871,'_sections_0_image','field_61d6f6d45a37d'),(76282,1871,'sections_0_heading','Heading'),(76283,1871,'_sections_0_heading','field_61d6f69e5a379'),(76284,1871,'sections_0_subtitle','Ya ya '),(76285,1871,'_sections_0_subtitle','field_61d6f6ac5a37a'),(76286,1871,'sections_0_link_one',''),(76287,1871,'_sections_0_link_one','field_61d6f6b55a37b'),(76288,1871,'sections_0_link_two',''),(76289,1871,'_sections_0_link_two','field_61d6f6c35a37c'),(76290,1871,'sections_1_select_categories','a:1:{i:0;s:2:\"27\";}'),(76291,1871,'_sections_1_select_categories','field_637f04483b63b'),(76292,1871,'intro_head_major','Queenslanders are known for both our love of the great outdoors and our state pride…'),(76293,1871,'_intro_head_major','field_64e828783ad9f'),(76294,1871,'intro_head_minor','But there’s a few things you might not know about our beautiful state.'),(76295,1871,'_intro_head_minor','field_64e8288c3ada0'),(76296,1871,'intro_icons_0_int_icon','1806'),(76297,1871,'_intro_icons_0_int_icon','field_64e828b33ada2'),(76298,1871,'intro_icons_0_int_icon_text','At 1,727,000 square kilometres, we’re 2.5 times the size of Texas. <span>Yeeha!</span>'),(76299,1871,'_intro_icons_0_int_icon_text','field_64e828e33ada3'),(76300,1871,'intro_icons_1_int_icon','1806'),(76301,1871,'_intro_icons_1_int_icon','field_64e828b33ada2'),(76302,1871,'intro_icons_1_int_icon_text','We have twice as many species of native plant and animal as any other Australian state or territory.'),(76303,1871,'_intro_icons_1_int_icon_text','field_64e828e33ada3'),(76304,1871,'intro_icons_2_int_icon','1806'),(76305,1871,'_intro_icons_2_int_icon','field_64e828b33ada2'),(76306,1871,'intro_icons_2_int_icon_text','We have less land classified as ‘protected’ than any other state or territory.'),(76307,1871,'_intro_icons_2_int_icon_text','field_64e828e33ada3'),(76308,1871,'intro_icons','3'),(76309,1871,'_intro_icons','field_64e828963ada1'),(76310,1871,'threat_head_major','What we stand to lose if we don’t act soon to protect beautiful Queensland:'),(76311,1871,'_threat_head_major','field_64ec258d9dbd1'),(76312,1871,'threats_icons','3'),(76313,1871,'_threats_icons','field_64ec2551a93f9'),(76314,1871,'threats_icons_0_thr_icon','1819'),(76315,1871,'_threats_icons_0_thr_icon','field_64ec2551a93fa'),(76316,1871,'threats_icons_0_thr_icon_text','The rich cultural heritage of our First Nations people and their continuous ties to country, dating back more than 50,000 years.'),(76317,1871,'_threats_icons_0_thr_icon_text','field_64ec2551a93fb'),(76318,1871,'threats_icons_1_thr_icon','1819'),(76319,1871,'_threats_icons_1_thr_icon','field_64ec2551a93fa'),(76320,1871,'threats_icons_1_thr_icon_text','Thousands of species of plant and animal which are now classified as threatened or endangered in Queensland.'),(76321,1871,'_threats_icons_1_thr_icon_text','field_64ec2551a93fb'),(76322,1871,'threats_icons_2_thr_icon','1819'),(76323,1871,'_threats_icons_2_thr_icon','field_64ec2551a93fa'),(76324,1871,'threats_icons_2_thr_icon_text','The access to nature that is central to the Queensland way of life.'),(76325,1871,'_threats_icons_2_thr_icon_text','field_64ec2551a93fb'),(76326,1871,'threat_icons_0_thr_icon','1824'),(76327,1871,'_threat_icons_0_thr_icon','field_64ec2551a93fa'),(76328,1871,'threat_icons_0_thr_icon_text','The <span>rich cultural heritage</span> of our First Nations people and their continuous ties to country, dating back more than 50,000 years.'),(76329,1871,'_threat_icons_0_thr_icon_text','field_64ec2551a93fb'),(76330,1871,'threat_icons_1_thr_icon','1824'),(76331