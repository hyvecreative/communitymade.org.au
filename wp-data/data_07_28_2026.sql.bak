more'),(192912,2715,'_issues_items_0_issues_link_text','field_6a3b080f06af4'),(192913,2715,'issues_items_0_issues_target_url','#'),(192914,2715,'_issues_items_0_issues_target_url','field_6a3b082b06af5'),(192915,2715,'issues_items','3'),(192916,2715,'_issues_items','field_6a3b078206af0'),(192917,2715,'issues_items_1_issue_icon','2708'),(192918,2715,'_issues_items_1_issue_icon','field_6a3b07b506af1'),(192919,2715,'issues_items_1_issues_item_hd','Scaling the solution'),(192920,2715,'_issues_items_1_issues_item_hd','field_6a3b07d706af2'),(192921,2715,'issues_items_1_issues_item_txt','Governments, communities and not-for-profit community housing providers are working together to make rental housing more affordable for everyone who calls NSW home.'),(192922,2715,'_issues_items_1_issues_item_txt','field_6a3b07fc06af3'),(192923,2715,'issues_items_1_issues_link_text',''),(192924,2715,'_issues_items_1_issues_link_text','field_6a3b080f06af4'),(192925,2715,'issues_items_1_issues_target_url',''),(192926,2715,'_issues_items_1_issues_target_url','field_6a3b082b06af5'),(192927,2715,'issues_items_0_issues_sub_head','The housing crisis is spiralling. '),(192928,2715,'_issues_items_0_issues_sub_head','field_6a3b0aa79365e'),(192929,2715,'issues_items_1_issues_sub_head','Community housing is social infrastructure.'),(192930,2715,'_issues_items_1_issues_sub_head','field_6a3b0aa79365e'),(192931,2715,'issues_items_2_issue_icon','2703'),(192932,2715,'_issues_items_2_issue_icon','field_6a3b07b506af1'),(192933,2715,'issues_items_2_issues_item_hd','Why community made:'),(192934,2715,'_issues_items_2_issues_item_hd','field_6a3b07d706af2'),(192935,2715,'issues_items_2_issues_sub_head',''),(192936,2715,'_issues_items_2_issues_sub_head','field_6a3b0aa79365e'),(192937,2715,'issues_items_2_issues_item_txt','Community housing is local. Every dollar invested is given back to community through homes, services and jobs. It’s built to thrive, like our communities.  Community housing is an investment in our state’s future. By investing in people today, we boost our local economies, communities and productivity – ensuring that NSW leads the nation.'),(192938,2715,'_issues_items_2_issues_item_txt','field_6a3b07fc06af3'),(192939,2715,'issues_items_2_issues_link_text',''),(192940,2715,'_issues_items_2_issues_link_text','field_6a3b080f06af4'),(192941,2715,'issues_items_2_issues_target_url',''),(192942,2715,'_issues_items_2_issues_target_url','field_6a3b082b06af5'),(192945,2716,'footnotes',''),(192947,2716,'banner_head',''),(192948,2716,'_banner_head','field_5b568121a8ffe'),(192949,2716,'banner_sub',''),(192950,2716,'_banner_sub','field_5b568139fd366'),(192951,2716,'banner_button','<a class=\"btn btn-home\" style=\"width: 200px;\" href=\"#project\">Sign the petition</a>'),(192952,2716,'_banner_button','field_5b568147fd367'),(192953,2716,'support_section_title','How can Lifestart support you?'),(192954,2716,'_support_section_title','field_5b67c7d060398'),(192955,2716,'support_left_title','Services'),(192956,2716,'_support_left_title','field_5b67c298e7f8f'),(192957,2716,'support_left_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy.'),(192958,2716,'_support_left_cont','field_5b67c5f6e7f91'),(192959,2716,'support_left_button','<a class=\"btn btn-green\" href=\"/services/\">View all services</a>'),(192960,2716,'_support_left_button','field_5b67c60ae7f92'),(192961,2716,'support_ctr_title','Talk to us'),(192962,2716,'_support_ctr_title','field_5b67c62a58af3'),(192963,2716,'support_ctr_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut laoreet.'),(192964,2716,'_support_ctr_cont','field_5b67c63158af4'),(192965,2716,'support_ctr_button','<a class=\"btn btn-orange\" href=\"/supports/\">Find us</a>'),(192966,2716,'_support_ctr_button','field_5b67c63658af5'),(192967,2716,'support_right_title','NDIS Registered provider'),(192968,2716,'_support_right_title','field_5b67c6a38c064'),(192969,2716,'support_right_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut.'),(192970,2716,'_support_right_cont','field_5b67c6c98c065'),(192971,2716,'support_right_button','<a class=\"btn btn-blue\" href=\"#\">Read more</a>'),(192972,2716,'_support_right_button','field_5b67c6dd8c066'),(192973,2716,'first_image_title','Lifestart is about supporting young children'),(192974,2716,'_first_image_title','field_5b67ca606afc4'),(192975,2716,'first_image_cont','from 0-24 years living with disabilities and their familes'),(192976,2716,'_first_image_cont','field_5b67caff6afc5'),(192977,2716,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(192978,2716,'_first_image_button','field_5b67cb0d6afc6'),(192979,2716,'second _image_title','Lifestart is about supporting young children'),(192980,2716,'_second _image_title','field_5b67cb20ddf9a'),(192981,2716,'second_image_cont','from 0-24 years living with disabilities and their familes'),(192982,2716,'_second_image_cont','field_5b67cb24ddf9b'),(192983,2716,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(192984,2716,'_second_image_button','field_5b67cb29ddf9c'),(192985,2716,'second_image_title','Lifestart is about supporting young children'),(192986,2716,'_second_image_title','field_5b67cb20ddf9a'),(192987,2716,'page_col_image','412'),(192988,2716,'_page_col_image','field_5de6546e7c63a'),(192989,2716,'page_col_image_3','437'),(192990,2716,'_page_col_image_3','field_5de6e3998e07e'),(192991,2716,'sec_2_title','Community'),(192992,2716,'_sec_2_title','field_5de6e3ef2798f'),(192993,2716,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(192994,2716,'_sec_2_text','field_5de78dc89e613'),(192995,2716,'sec_3_title','The Project'),(192996,2716,'_sec_3_title','field_5de6e3d37d8da'),(192997,2716,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(192998,2716,'_sec_3_text','field_5de6e4044e5e8'),(192999,2716,'page_col_image_2','436'),(193000,2716,'_page_col_image_2','field_5de6546e7c63a'),(193001,2716,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(193002,2716,'_sec_2_button','field_5de6e58c86706'),(193003,2716,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(193004,2716,'_sec_3_button','field_5de6e5a243c03'),(193005,2716,'page_col_image_4','455'),(193006,2716,'_page_col_image_4','field_5de70801090ce'),(193007,2716,'sec_4_title','Location'),(193008,2716,'_sec_4_title','field_5de7082a12a81'),(193009,2716,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(193010,2716,'_sec_4_text','field_5de7084812a82'),(193011,2716,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(193012,2716,'_sec_4_button','field_5de7085e12a83'),(193013,2716,'news_title','Project updates'),(193014,2716,'_news_title','field_5de78da3aabb9'),(193015,2716,'sec_2_text_copy',''),(193016,2716,'_sec_2_text_copy','field_5de78dc89e613'),(193017,2716,'timeline-title','Timeline'),(193018,2716,'_timeline-title','field_5de78df29e615'),(193019,2716,'timeline_title','Timeline'),(193020,2716,'_