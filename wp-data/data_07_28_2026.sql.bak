24,'second_image_title','Lifestart is about supporting young children'),(116070,2124,'_second_image_title','field_5b67cb20ddf9a'),(116071,2124,'page_col_image','412'),(116072,2124,'_page_col_image','field_5de6546e7c63a'),(116073,2124,'page_col_image_3','437'),(116074,2124,'_page_col_image_3','field_5de6e3998e07e'),(116075,2124,'sec_2_title','Community'),(116076,2124,'_sec_2_title','field_5de6e3ef2798f'),(116077,2124,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(116078,2124,'_sec_2_text','field_5de78dc89e613'),(116079,2124,'sec_3_title','The Project'),(116080,2124,'_sec_3_title','field_5de6e3d37d8da'),(116081,2124,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(116082,2124,'_sec_3_text','field_5de6e4044e5e8'),(116083,2124,'page_col_image_2','436'),(116084,2124,'_page_col_image_2','field_5de6546e7c63a'),(116085,2124,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(116086,2124,'_sec_2_button','field_5de6e58c86706'),(116087,2124,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(116088,2124,'_sec_3_button','field_5de6e5a243c03'),(116089,2124,'page_col_image_4','455'),(116090,2124,'_page_col_image_4','field_5de70801090ce'),(116091,2124,'sec_4_title','Location'),(116092,2124,'_sec_4_title','field_5de7082a12a81'),(116093,2124,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(116094,2124,'_sec_4_text','field_5de7084812a82'),(116095,2124,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(116096,2124,'_sec_4_button','field_5de7085e12a83'),(116097,2124,'news_title','Project updates'),(116098,2124,'_news_title','field_5de78da3aabb9'),(116099,2124,'sec_2_text_copy',''),(116100,2124,'_sec_2_text_copy','field_5de78dc89e613'),(116101,2124,'timeline-title','Timeline'),(116102,2124,'_timeline-title','field_5de78df29e615'),(116103,2124,'timeline_title','Timeline'),(116104,2124,'_timeline_title','field_5de78df29e615'),(116105,2124,'contact_title','Contact us'),(116106,2124,'_contact_title','field_5de7981e06057'),(116107,2124,'contact_intro','Contact text...'),(116108,2124,'_contact_intro','field_5de7983506058'),(116109,2124,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(116110,2124,'_news_button','field_5de8329896e02'),(116111,2124,'timeline_intro','Introduction of timeline detail...'),(116112,2124,'_timeline_intro','field_5de98f5fb1781'),(116113,2124,'timeline_pic','477'),(116114,2124,'_timeline_pic','field_5de98f72b1782'),(116115,2124,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(116116,2124,'_timeline_button','field_5de99363677f8'),(116117,2124,'banner_image_position','center'),(116118,2124,'_banner_image_position','field_5f3bc4757dd02'),(116119,2124,'services_title','Our services'),(116120,2124,'_services_title','field_5f20f3cd80eb2'),(116121,2124,'services_items_0_services_item_image','1061'),(116122,2124,'_services_items_0_services_item_image','field_5f2121355be14'),(116123,2124,'services_items_0_sservices_item_title','1300 Telephone counselling line'),(116124,2124,'_servi