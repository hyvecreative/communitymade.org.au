_second_image_cont','field_5b67cb24ddf9b'),(60780,1821,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(60781,1821,'_second_image_button','field_5b67cb29ddf9c'),(60782,1821,'second_image_title','Lifestart is about supporting young children'),(60783,1821,'_second_image_title','field_5b67cb20ddf9a'),(60784,1821,'page_col_image','412'),(60785,1821,'_page_col_image','field_5de6546e7c63a'),(60786,1821,'page_col_image_3','437'),(60787,1821,'_page_col_image_3','field_5de6e3998e07e'),(60788,1821,'sec_2_title','Community'),(60789,1821,'_sec_2_title','field_5de6e3ef2798f'),(60790,1821,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(60791,1821,'_sec_2_text','field_5de78dc89e613'),(60792,1821,'sec_3_title','The Project'),(60793,1821,'_sec_3_title','field_5de6e3d37d8da'),(60794,1821,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(60795,1821,'_sec_3_text','field_5de6e4044e5e8'),(60796,1821,'page_col_image_2','436'),(60797,1821,'_page_col_image_2','field_5de6546e7c63a'),(60798,1821,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(60799,1821,'_sec_2_button','field_5de6e58c86706'),(60800,1821,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(60801,1821,'_sec_3_button','field_5de6e5a243c03'),(60802,1821,'page_col_image_4','455'),(60803,1821,'_page_col_image_4','field_5de70801090ce'),(60804,1821,'sec_4_title','Location'),(60805,1821,'_sec_4_title','field_5de7082a12a81'),(60806,1821,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(60807,1821,'_sec_4_text','field_5de7084812a82'),(60808,1821,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(60809,1821,'_sec_4_button','field_5de7085e12a83'),(60810,1821,'news_title','Project updates'),(60811,1821,'_news_title','field_5de78da3aabb9'),(60812,1821,'sec_2_text_copy',''),(60813,1821,'_sec_2_text_copy','field_5de78dc89e613'),(60814,1821,'timeline-title','Timeline'),(60815,1821,'_timeline-title','field_5de78df29e615'),(60816,1821,'timeline_title','Timeline'),(60817,1821,'_timeline_title','field_5de78df29e615'),(60818,1821,'contact_title','Contact us'),(60819,1821,'_contact_title','field_5de7981e06057'),(60820,1821,'contact_intro','Contact text...'),(60821,1821,'_contact_intro','field_5de7983506058'),(60822,1821,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(60823,1821,'_news_button','field_5de8329896e02'),(60824,1821,'timeline_intro','Introduction of timeline detail...'),(60825,1821,'_timeline_intro','field_5de98f5fb1781'),(60826,1821,'timeline_pic','477'),(60827,1821,'_timeline_pic','field_5de98f72b1782'),(60828,1821,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(60829,1821,'_timeline_button','field_5de99363677f8'),(60830,1821,'banner_image_position','center'),(60831,1821,'_banner_image_position','field_5f3bc4757dd02'),(60832,1821,'services_title','Our services'),(60833,1821,'_services_title','field_5f20f3cd80eb2'),(60834,1821,'services_items_0_services_item_image','1061'),(60835,1821,'_services_items_0_