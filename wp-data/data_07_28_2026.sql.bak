dex_5_survey_url_text','View Results'),(97824,1958,'_survey_index_5_survey_url_text','field_629456584223a'),(97825,1958,'survey_index_6_survey_icon','1492'),(97826,1958,'_survey_index_6_survey_icon','field_6294562942237'),(97827,1958,'survey_index_6_survey_title','Energy Management'),(97828,1958,'_survey_index_6_survey_title','field_6294564042238'),(97829,1958,'survey_index_6_survey_url','#'),(97830,1958,'_survey_index_6_survey_url','field_6294564e42239'),(97831,1958,'survey_index_6_survey_url_text','View Results'),(97832,1958,'_survey_index_6_survey_url_text','field_629456584223a'),(97833,1958,'survey_index_7_survey_icon','1493'),(97834,1958,'_survey_index_7_survey_icon','field_6294562942237'),(97835,1958,'survey_index_7_survey_title','Going Off-grid'),(97836,1958,'_survey_index_7_survey_title','field_6294564042238'),(97837,1958,'survey_index_7_survey_url','#'),(97838,1958,'_survey_index_7_survey_url','field_6294564e42239'),(97839,1958,'survey_index_7_survey_url_text','View Results'),(97840,1958,'_survey_index_7_survey_url_text','field_629456584223a'),(97841,1958,'survey_index','8'),(97842,1958,'_survey_index','field_6294561242236'),(97843,1958,'report_title','Download the report'),(97844,1958,'_report_title','field_62f30edfb57e1'),(97845,1958,'report_intro','Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus massa erat, consectetur at semper at, feugiat vel orci. '),(97846,1958,'_report_intro','field_62f30eedb57e2'),(97847,1958,'report_link_url','#'),(97848,1958,'_report_link_url','field_62f30ef4b57e3'),(97849,1958,'report_link_text','Download'),(97850,1958,'_report_link_text','field_62f30f01b57e4'),(97851,1958,'solutions_content','The housing system is complex, and no one solution will solve the complex problems we now face but there are some critical first steps to be taken now.\r\n<ul>\r\n 	<li>Set out an ambitious national housing agreement between commonwealth and state governments with targets and funding for the construction of affordable homes.</li>\r\n 	<li>Phase out tax breaks for property investors and using the increase in revenue to build more public housing.</li>\r\n 	<li>Establish laws which limit rental increases beyond what is fair.</li>\r\n 	<li>Rebalance tenancy laws to provide renters with more security and control, such as eliminating no grounds evictions.</li>\r\n 	<li>Phase out stamp duty and replace it with a broad-based land tax.</li>\r\n</ul>\r\n<h4>While there are many opinions on what policy changes will fix the housing market, doing nothing is not an option.</h4>'),(97852,1958,'_solutions_content','field_640e8b307a958'),(97853,1958,'problem_icons_0_prob_icon','1699'),(97854,1958,'_problem_icons_0_prob_icon','field_640fa0291d519'),(97855,1958,'problem_icons_0_prob_concerned_stat','70% highly concerned'),(97856,1958,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(97857,1958,'problem_icons_0_prob_concerded_text','are highly concerned'),(97858,1958,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(97859,1958,'problem_icons_0_prob_issue_text',''),(97860,1958,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(97861,1958,'problem_icons','4'),(97862,1958,'_problem_icons','field_640fa0191d518'),(97863,1958,'ceh_content_left',''),(97864,1958,'_ceh_content_left','field_640e97e8f1c8c'),(97865,1958,'ceh_content_right',''),(97866,1958,'_ceh_content_right','field_640e97fdf1c8d'),(97867,1958,'pc_content_left',''),(97868,1958,'_pc_content_left','field_640e983bf1c8f'),(97869,1958,'pc_content_right',''),(97870,1958,'_pc_content_right','field_640e984df1c90'),(97871,1958,'problem_icons_1_prob_icon','1699'),(97872,1958,'_problem_icons_1_prob_icon','field_640fa0291d519'),(97873,1958,'problem_icons_1_prob_concerned_stat','69% highly concerned'),(97874,1958,'_problem_icons_1_prob_concerned_stat','field_640fa0dd81d95'),(97875,1958,'problem_icons_1_prob_concerded_text','are highly concerned'),(97876,1958,'_problem_icons_1_prob_concerded_text','field_640fa10181d96'),(97877,1958,'problem_icons_1_prob_issue_text',''),(97878,1958,'_problem_icons_1_prob_issue_text','field_640fa11a81d97'),(97879,1958,'problem_icons_2_prob_icon','1699'),(97880,1958,'_problem_icons_2_prob_icon','field_640fa0291d519'),(97881,1958,'problem_icons_2_prob_concerned_stat','64% highly concerned'),(97882,1958,'_problem_icons_2_prob_concerned_stat','field_640fa0dd81d95'),(97883,1958,'problem_icons_2_prob_concerded_text','are highly concerned'),(97884,1958,'_problem_icons_2_prob_concerded_text','field_640fa10181d96'),(97885,1958,'problem_icons_2_prob_issue_text',''),(97886,1958,'_problem_icons_2_prob_issue_text','field_640fa11a81d97'),(97887,1958,'problem_icons_3_prob_icon','1699'),(97888,1958,'_problem_icons_3_prob_icon','field_640fa0291d519'),(97889,1958,'problem_icons_3_prob_concerned_stat','64% highly concerned'),(97890,1958,'_problem_icons_3_prob_concerned_stat','field_640fa0dd81d95'),(97891,1958,'problem_icons_3_prob_concerded_text','are highly concerned'),(97892,1958,'_problem_icons_3_prob_concerded_text','field_640fa10181d96'),(97893,1958,'problem_icons_3_prob_issue_text',''),(97894,1958,'_problem_icons_3_prob_issue_text','field_640fa11a81d97'),(97895,1958,'problem_icons_0_prob_concerned_text','House prices have doubled in a decade'),(97896,1958,'_problem_icons_0_prob_concerned_text','field_640fa10181d96'),(97897,1958,'problem_icons_1_prob_concerned_text','The gap between rich and poor is growing'),(97898,1958,'_problem_icons_1_prob_concerned_text','field_640fa10181d96'),(97899,1958,'problem_icons_2_prob_concerned_text','Construction of social housing is down'),(97900,1958,'_problem_icons_2_prob_concerned_text','field_640fa10181d96'),(97901,1958,'problem_icons_3_prob_concerned_text','Banks are making more than ever from housing'),(97902,1958,'_problem_icons_3_prob_concerned_text','field_640fa10181d96'),(97903,1958,'monitor_content','The Australian Housing Monitor is a large, nationally-representative survey covering public experiences and attitudes toward housing related issues. Questions range from how well the respondent is keeping up with their mortgage/rent, to what they think about social housing construction.\r\n\r\nA broad range of demographic criteria are included, such as gender, location, age, income, voting preference, educational level, tenure type, and employment status. These variables allow CEH researchers to understand the trends and diversity of opinion around the country.\r\n\r\nIt also incorporates questions from previous surveys to track trends over time.\r\nThe inaugural poll was conducted by Essential in December 2022, and was completed by 4,735 people.'),(97904,1958,'_monitor_content','field_640fcc4014404'),(97905,1958,'problem_head','Housing in Australia is not working, and Australians are concerned.'),(97906,1958,'_problem_head','field_641935436aded'),(97907,1958,'problem_signoff','Explore the research showing how concerned Australians are our about the housing situation.'),(97908,1958,'_problem_signoff','field_641935626adee'),(97909,1958,'sections','a:2:{i:0;s:4:\"hero\";i:1;s:9:\"news_grid\";}'),(97910,1958,'_sections','field_5dafb40b8143a'),(97911,1958,'sections_0_is_full_height','1'),(97912,1958,'_sections_0_is_full_height','field_61d6f6fd5a37e'),(97913,1958,'sections_0_image','1648'),(97914,1958,'_sections_0_image','field_61d6f6d45a37d'),(97915,1958,'sections_0_heading','Heading'),(97916,1958,'_sections_0_heading','field_61d6f69e5a379'),(97917,1958,'sections_0_subtitle','Ya ya '),(97918,1958,'_sections_0_subtitle','field_61d6f6ac5a37a'),(97919,1958,'sections_0_link_one',''),(97920,1958,'_sections_0_link_one','field_61d6f6b55a37b'),(97921,1958,'sections_0_link_two',''),(97922,1958,'_sections_0_link_two','field_61d6f6c35a37c'),(97923,1958,'sections_1_select_categories','a:1:{i:0;s:2:\"27\";}'),(97924,1958,'_sections_1_select_categories','field_637f04483b63b'),(97925,1958,'intro_head_major','Super Consumers Australia is <span>fighting</span> to ensure that the superannuation industry is <span>held accountable</span> for the outcomes they deliver to Australian consumers.'),(97926,1958,'_intro_head_major','field_64e828783ad9f'),(97927,1958,'intro_head_minor','We want super to work for everyone—not just super fund companies. With our research, journalism and campaigns we are creating the trustworthy and transparent superannuation system we all deserve.'),(97928,1958,'_intro_head_minor','field_64e8288c3ada0'),(97929,1958,'intro_icons_0_int_icon','1922'),(97930,1958,'_intro_icons_0_int_icon','field_64e828b33ada2'),(97931,1958,'intro_icons_0_int_icon_text','At 1,727,000 square kilometres, we’re 2.5 times the size of Texas. <span>Yeeha!</span>'),(97932,1958,'_intro_icons_0_int_icon_text','field_64e828e33ada3'),(97933,1958,'intro_icons_1_int_icon','1920'),(97934,1958,'_intro_icons_1_int_icon','field_64e828b33ada2'),(97935,1958,'intro_icons_1_int_icon_text','We have twice as many species of native plant and animal as any other Australian state or territory.'),(97936,1958,'_intro_icons_1_int_icon_text','field_64e828e33ada3'),(97937,1958,'intro_icons_2_int_icon','1921'),(97938,1958,'_intro_icons_2_int_icon','field_64e828b33ada2'),(97939,1958,'intro_icons_2_int_icon_text','We have less land classified as ‘protected’ than any other state or territory.'),(97940,1958,'_intro_icons_2_int_icon_text','field_64e828e33ada3'),(97941,1958,'intro_icons','3'),(97942,1958,'_intro_icons','field_64e828963ada1'),(97943,1958,'threat_head_major','What we stand to lose if we don’t act soon to protect beautiful Queensland:'),(97944,1958,'_threat_head_major','field_64ec258d9dbd1'),(97945,1958,'threats_icons','3'),(97946,1958,'_threats_icons','field_64ec2551a93f9'),(97947,1958,'threats_icons_0_thr_icon','1819'),(97948,1958,'_threats_icons_0_thr_icon','field_64ec2551a93fa'),(97949,1958,'threats_icons_0_thr_icon_text','The rich cultural heritage of our First Nations people and their continuous ties to country, dating back more than 50,000 years.'),(97950,1958,'_threats_icons_0_thr_icon_tex