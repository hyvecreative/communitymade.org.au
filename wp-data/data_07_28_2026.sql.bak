31,2728,'_display_news_section','field_69434cc6d5f7d'),(199532,2728,'issues_head','These are the issues'),(199533,2728,'_issues_head','field_6a3b076406aef'),(199534,2728,'issues_items_0_issue_icon','2705'),(199535,2728,'_issues_items_0_issue_icon','field_6a3b07b506af1'),(199536,2728,'issues_items_0_issues_item_hd','A secure home is slipping out of reach'),(199537,2728,'_issues_items_0_issues_item_hd','field_6a3b07d706af2'),(199538,2728,'issues_items_0_issues_item_txt','•	A shortage of 132,000 social and affordable rental homes\r\n•	70,000+ households waiting for social housing\r\n•	Record-high private market rents\r\n•	Home ownership increasingly out of reach for generations'),(199539,2728,'_issues_items_0_issues_item_txt','field_6a3b07fc06af3'),(199540,2728,'issues_items_0_issues_link_text','Find out more'),(199541,2728,'_issues_items_0_issues_link_text','field_6a3b080f06af4'),(199542,2728,'issues_items_0_issues_target_url','#'),(199543,2728,'_issues_items_0_issues_target_url','field_6a3b082b06af5'),(199544,2728,'issues_items','3'),(199545,2728,'_issues_items','field_6a3b078206af0'),(199546,2728,'issues_items_1_issue_icon','2708'),(199547,2728,'_issues_items_1_issue_icon','field_6a3b07b506af1'),(199548,2728,'issues_items_1_issues_item_hd','The solutions we need '),(199549,2728,'_issues_items_1_issues_item_hd','field_6a3b07d706af2'),(199550,2728,'issues_items_1_issues_item_txt','Community housing works. We’re calling on the next NSW Government for three actions: long-term investment for new community housing, more funding to future-proof existing homes, and support to help people stayed housed.'),(199551,2728,'_issues_items_1_issues_item_txt','field_6a3b07fc06af3'),(199552,2728,'issues_items_1_issues_link_text','Find out more'),(199553,2728,'_issues_items_1_issues_link_text','field_6a3b080f06af4'),(199554,2728,'issues_items_1_issues_target_url','#'),(199555,2728,'_issues_items_1_issues_target_url','field_6a3b082b06af5'),(199556,2728,'issues_items_0_issues_sub_head',''),(199557,2728,'_issues_items_0_issues_sub_head','field_6a3b0aa79365e'),(199558,2728,'issues_items_1_issues_sub_head',''),(199559,2728,'_issues_items_1_issues_sub_head','field_6a3b0aa79365e'),(199560,2728,'issues_items_2_issue_icon','2703'),(199561,2728,'_issues_items_2_issue_icon','field_6a3b07b506af1'),(199562,2728,'issues_items_2_issues_item_hd','The people next door'),(199563,2728,'_issues_items_2_issues_item_hd','field_6a3b07d706af2'),(199564,2728,'issues_items_2_issues_sub_head',''),(199565,2728,'_issues_items_2_issues_sub_head','field_6a3b0aa79365e'),(199566,2728,'issues_items_2_issues_item_txt','Nurses. Childcare workers. Single parents. Older Australians who want to stay near the people they love. Community housing is the solution.'),(199567,2728,'_issues_items_2_issues_item_txt','field_6a3b07fc06af3'),(199568,2728,'issues_items_2_issues_link_text',''),(199569,2728,'_issues_items_2_issues_link_text','field_6a3b080f06af4'),(199570,2728,'issues_items_2_issues_target_url',''),(199571,2728,'_issues_items_2_issues_target_url','field_6a3b082b06af5'),(199572,2578,'_wpa_old_event','a:2:{i:0;O:8:\"stdClass\":5:{s:1:\"0\";s:9:\"skiplinks\";s:1:\"1\";a:2:{i:0;s:14:\"control-titles\";i:1;s:1:\"2\";}s:1:\"2\";a:2:{i:0;s:12:\"link-targets\";i:1;s:1:\"9\";}s:1:\"3\";a:2:{i:0;s:16:\"control-tabindex\";i:1;s:1:\"5\";}s:9:\"timestamp\";s:0:\"\";}i:1;O:8:\"stdClass\":4:{s:1:\"0\";s:9:\"skiplinks\";s:1:\"1\";a:2:{i:0;s:14:\"control-titles\";i:1;s:1:\"2\";}s:1:\"2\";a:2:{i:0;s:16:\"control-tabindex\";i:1;s:1:\"1\";}s:9:\"timestamp\";s:0:\"\";}}'),(199573,2578,'_wpa_event','{\"0\":\"skiplinks\",\"1\":[\"control-titles\",\"2\"],\"2\":[\"link-targets\",\"9\"],\"3\":[\"control-tabindex\",\"5\"],\"timestamp\":1784523492}'),(199574,2496,'_wpa_old_event','a:2:{i:0;O:8:\"stdClass\":5:{s:1:\"0\";s:9:\"skiplinks\";s:1:\"1\";a:2:{i:0;s:14:\"control-titles\";i:1;s:1:\"2\";}s:1:\"2\";a:2:{i:0;s:12:\"link-targets\";i:1;s:1:\"9\";}s:1:\"3\";a:2:{i:0;s:16:\"control-tabindex\";i:1;s:1:\"5\";}