b_issue_text',''),(212063,2785,'_problem_icons_3_prob_issue_text','field_640fa11a81d97'),(212064,2785,'problem_icons_0_prob_concerned_text','House prices have doubled in a decade'),(212065,2785,'_problem_icons_0_prob_concerned_text','field_640fa10181d96'),(212066,2785,'problem_icons_1_prob_concerned_text','The gap between rich and poor is growing'),(212067,2785,'_problem_icons_1_prob_concerned_text','field_640fa10181d96'),(212068,2785,'problem_icons_2_prob_concerned_text','Construction of social housing is down'),(212069,2785,'_problem_icons_2_prob_concerned_text','field_640fa10181d96'),(212070,2785,'problem_icons_3_prob_concerned_text','Banks are making more than ever from housing'),(212071,2785,'_problem_icons_3_prob_concerned_text','field_640fa10181d96'),(212072,2785,'monitor_content','The Australian Housing Monitor is a large, nationally-representative survey covering public experiences and attitudes toward housing related issues. Questions range from how well the respondent is keeping up with their mortgage/rent, to what they think about social housing construction.\r\n\r\nA broad range of demographic criteria are included, such as gender, location, age, income, voting preference, educational level, tenure type, and employment status. These variables allow CEH researchers to understand the trends and diversity of opinion around the country.\r\n\r\nIt also incorporates questions from previous surveys to track trends over time.\r\nThe inaugural poll was conducted by Essential in December 2022, and was completed by 4,735 people.'),(212073,2785,'_monitor_content','field_640fcc4014404'),(212074,2785,'problem_head','Housing in Australia is not working, and Australians are concerned.'),(212075,2785,'_problem_head','field_641935436aded'),(212076,2785,'problem_signoff','Explore the research showing how concerned Australians are our about the housing situation.'),(212077,2785,'_problem_signoff','field_641935626adee'),(212078,2785,'sections','a:2:{i:0;s:4:\"hero\";i:1;s:9:\"news_grid\";}'),(212079,2785,'_sections','field_5dafb40b8143a'),(212080,2785,'sections_0_is_full_height','1'),(212081,2785,'_sections_0_is_full_height','field_61d6f6fd5a37e'),(212082,2785,'sections_0_image','1648'),(212083,2785,'_sections_0_image','field_61d6f6d45a37d'),(212084,2785,'sections_0_heading','Heading'),(212085,2785,'_sections_0_heading','field_61d6f69e5a379'),(212086,2785,'sections_0_subtitle','Ya ya '),(212087,2785,'_sections_0_subtitle','field_61d6f6ac5a37a'),(212088,2785,'sections_0_link_one',''),(212089,2785,'_sections_0_link_one','field_61d6f6b55a37b'),(212090,2785,'sections_0_link_two',''),(212091,2785,'_sections_0_link_two','field_61d6f6c35a37c'),(212092,2785,'sections_1_select_categories','a:1:{i:0;s:2:\"27\";}'),(212093,2785,'_sections_1_select_categories','field_637f04483b63b'),(212094,2785,'intro_head_major','Welcome to the Disability Dialogue'),(212095,2785,'_intro_head_major','field_64e828783ad9f'),(212096,2785,'intro_head_minor',''),(212097,2785,'_intro_head_minor','field_64e8288c3ada0'),(212098,2785,'intro_icons_0_int_icon','1922'),(212099,2785,'_intro_icons_0_int_icon','field_64e828b33ada2'),(212100,2785,'intro_icons_0_int_icon_text','At 1,727,000 square kilometres, we’re 2.5 times the size of Texas. <span>Yeeha!</span>'),(212101,2785,'_intro_icons_0_int_icon_text','field_64e828e33ada3'),(212102,2785,'intro_icons_1_int_icon','1920'),(212103,2785,'_intro_icons_1_int_icon','field_64e828b33ada2'),(212104,2785,'intro_icons_1_int_icon_text','We have twice as many species of native plant and animal as any other Australian state or territory.'),(212105,2785,'_intro_icons_1_int_icon_text','field_64e828e33ada3'),(212106,2785,'intro_icons_2_int_icon','1921'),(212107,2785,'_intro_icons_2_int_icon','field_64e828b33ada2'),(212108,2785,'intro_icons_2_int_icon_text','We have less land classified as ‘protected’ than any other state or territory.'),(212109,2785,'_intro_icons_2_int_icon_text','field_64e828e33ada3'),(212110,2785,'intro_icons','3'),(21211