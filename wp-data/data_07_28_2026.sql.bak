027,'_team_members_3_first_name','field_5b7570cf26829'),(106668,2027,'team_members_3_last_name','Maneeva'),(106669,2027,'_team_members_3_last_name','field_5b7570de2682a'),(106670,2027,'team_members_3_member_text','Aliquam erat volutpat Ut wisi enim ad minim veniam laoreet dolore magna.'),(106671,2027,'_team_members_3_member_text','field_5b7570f12682b'),(106672,2027,'team_members_0_member_image','367'),(106673,2027,'_team_members_0_member_image','field_5b7572a89973e'),(106674,2027,'team_members_1_member_image','367'),(106675,2027,'_team_members_1_member_image','field_5b7572a89973e'),(106676,2027,'team_members_2_member_image','367'),(106677,2027,'_team_members_2_member_image','field_5b7572a89973e'),(106678,2027,'team_members_3_member_image','367'),(106679,2027,'_team_members_3_member_image','field_5b7572a89973e'),(106680,2027,'banner_button',''),(106681,2027,'_banner_button','field_5b568147fd367'),(106682,2027,'intro_col_1','The Take Control Campaign is a new movement of people who want to make Australia safer when it comes to drugs.'),(106683,2027,'_intro_col_1','field_5df5c6cef3ddb'),(106684,2027,'intro_col_2','The campaign has been launched by the Ted Noffs Foundation, Australia\'s largest provider of drug and alcohol treatment services for young people. The Foundation strives to help disadvantaged young people become advantaged and supports them on their journey to take back control of their lives.'),(106685,2027,'_intro_col_2','field_5df5c6deee1ca'),(106686,2027,'intro_col_3','With community support, the Take Control Campaign aims to change the conversation surrounding drugs and drug use in Australia. Through our common sense plan, we are demanding governments take control of the issue and fix our broken drug laws.'),(106687,2027,'_intro_col_3','field_5df5c6e99b7a8'),(106688,2027,'intro_logo','610'),(106689,2027,'_intro_logo','field_5df5c6f18c801'),(106690,2027,'intro_title','Decades of failed drug policy have resulted in unnecessary suffering. We have a secret and chaotic black market run by criminals and gangs. We have no control.'),(106691,2027,'_intro_title','field_5df5c6799cfec'),(106692,2027,'intro_bullets','Despite the best efforts of our police forces, for every drug dealer we catch, more simply start and operate with impunity.\r\n\r\nAny teenager can get drugs easily. People who use drugs can’t be sure what they are taking. Innocent young people who are just experimenting can buy themselves a death sentence.\r\n\r\nWorst of all, it’s often hard for people with problems to access help because they\'re treated like criminals.\r\n\r\nThis is because our governments refuse to take control of drugs.\r\n\r\nParents need greater tools and strategies to help their kids cope with the challenges of modern life.\r\n\r\nIt’s not good enough to put our heads in the sand and tell our kids to “just say no”. It doesn\'t work.\r\n\r\nIt\'s time to end the fear tactics. It\'s time to end the marketing gimmicks. People need real resources to reduce the harms associated with drug use.\r\n\r\nOur state and federal governments need to work together to get drug use under control by putting health and safety first.'),(106693,2027,'_intro_bullets','field_5df5c6799d05a'),(106694,2027,'intro_text',''),(106695,2027,'_intro_text','field_5df5c6799d0c6'),(106696,2027,'plan_title',''),(106697,2027,'_plan_title','field_5df5c6799d197'),(106698,2027,'plan_icons_row','5'),(106699,2027,'_plan_icons_row','field_5df5c6799d211'),(106700,2027,'plan_icons_row_0_plan_icon','516'),(106701,2027,'_plan_icons_row_0_plan_icon','field_5df5c679a8044'),(106702,2027,'plan_icons_row_0_plan_icon_text',' Roll out pill testing services nationally to reduce harm at music festivals and parties'),(106703,2027,'_plan_icons_row_0_plan_icon_text','field_5df5c679a80ae'),(106704,2027,'plan_icons_row_1_plan_icon','515'),(106705,2027,'_plan_icons_row_1_plan_icon','field_5df5c679a8044'),(106706,2027,'plan_icons_row_1_plan_icon_text','Expand treatment services for people suffering from drug problems'),(106707,2027,'_plan_icons_row_1_plan_icon_text','field_5df5c679a80ae'),(106708,2027,'plan_icons_row_2_plan_icon','514'),(106709,2027,'_plan_icons_row_2_plan_icon','field_5df5c679a8044'),(106710,2027,'plan_icons_row_2_plan_icon_text','Establish more drug monitoring rooms to save lives and improve communities'),(106711,2027,'_plan_icons_row_2_plan_icon_text','field_5df5c679a80ae'),(106712,2027,'plan_icons_row_3_plan_icon','513'),(106713,2027,'_plan_icons_row_3_plan_icon','field_5df5c679a8044'),(106714,2027,'plan_icons_row_3_plan_icon_text','Enhance engagement services for disadvantaged young people'),(106715,2027,'_plan_icons_row_3_plan_icon_text','field_5df5c679a80ae'),(106716,2027,'plan_icons_row_4_plan_icon','512'),(106717,2027,'_plan_icons_row_4_plan_icon','field_5df5c679a8044'),(106718,2027,'plan_icons_row_4_plan_icon_text','End criminal charges that make getting help harder and ruin young lives for minor possession of illicit drugs'),(106719,2027,'_plan_icons_row_4_plan_icon_text','field_5df5c679a80ae'),(106720,2027,'banner_image_position','center'),(106721,2027,'_banner_image_position','field_5f3bc4757dd02'),(106722,2027,'page_image','861'),(106723,2027,'_page_image','field_5f868320f904a'),(106724,2027,'echo_title','0'),(106725,2027,'_echo_title','field_5f868f339dd59'),(106726,2027,'problem_panel_title',''),(106727,2027,'_problem_panel_title','field_5f20f3cd80eb2'),(106728,2027,'problem_panel_items',''),(106729,2027,'_problem_panel_items','field_5f20f3dbe5a77'),(106730,2027,'problem_subhead',''),(106731,2027,'_problem_subhead','field_5f2121dff763d'),(106732,2027,'solution_title',''),(106733,2027,'_solution_title','field_5f21219394b8b'),(106734,2027,'solution_panel_items',''),(106735,2027,'_solution_panel_items','field_5f2121a594b8c'),(106736,2027,'mship_title',''),(106737,2027,'_mship_title','field_5f8fb9dc29b4c'),(106738,2027,'mship_intro',''),(106739,2027,'_mship_intro','field_5f8fb9f129b4d'),(106740,2027,'mship_benefit_items',''),(106741