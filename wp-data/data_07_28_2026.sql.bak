1,'_support_ctr_button','field_5b67c63658af5'),(87800,1931,'support_right_title','NDIS Registered provider'),(87801,1931,'_support_right_title','field_5b67c6a38c064'),(87802,1931,'support_right_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut.'),(87803,1931,'_support_right_cont','field_5b67c6c98c065'),(87804,1931,'support_right_button','<a class=\"btn btn-blue\" href=\"#\">Read more</a>'),(87805,1931,'_support_right_button','field_5b67c6dd8c066'),(87806,1931,'first_image_title','Lifestart is about supporting young children'),(87807,1931,'_first_image_title','field_5b67ca606afc4'),(87808,1931,'first_image_cont','from 0-24 years living with disabilities and their familes'),(87809,1931,'_first_image_cont','field_5b67caff6afc5'),(87810,1931,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(87811,1931,'_first_image_button','field_5b67cb0d6afc6'),(87812,1931,'second _image_title','Lifestart is about supporting young children'),(87813,1931,'_second _image_title','field_5b67cb20ddf9a'),(87814,1931,'second_image_cont','from 0-24 years living with disabilities and their familes'),(87815,1931,'_second_image_cont','field_5b67cb24ddf9b'),(87816,1931,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(87817,1931,'_second_image_button','field_5b67cb29ddf9c'),(87818,1931,'second_image_title','Lifestart is about supporting young children'),(87819,1931,'_second_image_title','field_5b67cb20ddf9a'),(87820,1931,'page_col_image','412'),(87821,1931,'_page_col_image','field_5de6546e7c63a'),(87822,1931,'page_col_image_3','437'),(87823,1931,'_page_col_image_3','field_5de6e3998e07e'),(87824,1931,'sec_2_title','Community'),(87825,1931,'_sec_2_title','field_5de6e3ef2798f'),(87826,1931,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(87827,1931,'_sec_2_text','field_5de78dc89e613'),(87828,1931,'sec_3_title','The Project'),(87829,1931,'_sec_3_title','field_5de6e3d37d8da'),(87830,1931,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(87831,1931,'_sec_3_text','field_5de6e4044e5e8'),(87832,1931,'page_col_image_2','436'),(87833,1931,'_page_col_image_2','field_5de6546e7c63a'),(87834,1931,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(87835,1931,'_sec_2_button','field_5de6e58c86706'),(87836,1931,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(87837,1931,'_sec_3_button','field_5de6e5a243c03'),(87838,1931,'page_col_image_4','455'),(87839,1931,'_page_col_image_4','field_5de70801090ce'),(87840,1931,'sec_4_title','Location'),(87841,1931,'_sec_4_title','field_5de7082a12a81'),(87842,1931,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(87843,1931,'_sec_4_text','field_5de7084812a82'),(87844,1931,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(87845,1931,'_sec_4_button','field_5de7085e12a83'),(87846,1931,'news_title','Project updates'),(87847,1931,'_news_title','field_5de78da3aabb9'),(87848,1931,'sec_2_text_copy',''),(87849,1931,'_sec_2_text_copy','field_5de78dc89e613'),(87850,1931,'time