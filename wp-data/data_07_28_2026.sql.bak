a>'),(89157,1934,'_support_right_button','field_5b67c6dd8c066'),(89158,1934,'first_image_title','Lifestart is about supporting young children'),(89159,1934,'_first_image_title','field_5b67ca606afc4'),(89160,1934,'first_image_cont','from 0-24 years living with disabilities and their familes'),(89161,1934,'_first_image_cont','field_5b67caff6afc5'),(89162,1934,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(89163,1934,'_first_image_button','field_5b67cb0d6afc6'),(89164,1934,'second _image_title','Lifestart is about supporting young children'),(89165,1934,'_second _image_title','field_5b67cb20ddf9a'),(89166,1934,'second_image_cont','from 0-24 years living with disabilities and their familes'),(89167,1934,'_second_image_cont','field_5b67cb24ddf9b'),(89168,1934,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(89169,1934,'_second_image_button','field_5b67cb29ddf9c'),(89170,1934,'second_image_title','Lifestart is about supporting young children'),(89171,1934,'_second_image_title','field_5b67cb20ddf9a'),(89172,1934,'page_col_image','412'),(89173,1934,'_page_col_image','field_5de6546e7c63a'),(89174,1934,'page_col_image_3','437'),(89175,1934,'_page_col_image_3','field_5de6e3998e07e'),(89176,1934,'sec_2_title','Community'),(89177,1934,'_sec_2_title','field_5de6e3ef2798f'),(89178,1934,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(89179,1934,'_sec_2_text','field_5de78dc89e613'),(89180,1934,'sec_3_title','The Project'),(89181,1934,'_sec_3_title','field_5de6e3d37d8da'),(89182,1934,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(89183,1934,'_sec_3_text','field_5de6e4044e5e8'),(89184,1934,'page_col_image_2','436'),(89185,1934,'_page_col_image_2','field_5de6546e7c63a'),(89186,1934,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(89187,1934,'_sec_2_button','field_5de6e58c86706'),(89188,1934,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(89189,1934,'_sec_3_button','field_5de6e5a243c03'),(89190,1934,'page_col_image_4','455'),(89191,1934,'_page_col_image_4','field_5de70801090ce'),(89192,1934,'sec_4_title','Location'),(89193,1934,'_sec_4_title','field_5de7082a12a81'),(89194,1934,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(89195,1934,'_sec_4_text','field_5de7084812a82'),(89196,1934,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(89197,1934,'_sec_4_button','field_5de7085e12a83'),(89198,1934,'news_title','Project updates'),(89199,1934,'_news_title','field_5de78da3aabb9'),(89200,1934,'sec_2_text_copy',''),(89201,1934,'_sec_2_text_copy','field_5de78dc89e613'),(89202,1934,'timeline-title','Timeline'),(89203,1934,'_timeline-title','field_5de78df29e615'),(89204,1934,'timeline_title','Timeline'),(89205,1934,'_timeline_title','field_5de78df29e615'),(89206,1934,'contact_title','Contact us'),(89207,1934,'_contact_title','field_5de7981e06057'),(89208,1934,'contact_intro','Contact text...'),(89209,1934,'_contact_intro','field_5de7983506058'),(89210,1934,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">S