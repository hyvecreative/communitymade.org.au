y_title','Energy Management'),(99908,1963,'_survey_index_6_survey_title','field_6294564042238'),(99909,1963,'survey_index_6_survey_url','#'),(99910,1963,'_survey_index_6_survey_url','field_6294564e42239'),(99911,1963,'survey_index_6_survey_url_text','View Results'),(99912,1963,'_survey_index_6_survey_url_text','field_629456584223a'),(99913,1963,'survey_index_7_survey_icon','1493'),(99914,1963,'_survey_index_7_survey_icon','field_6294562942237'),(99915,1963,'survey_index_7_survey_title','Going Off-grid'),(99916,1963,'_survey_index_7_survey_title','field_6294564042238'),(99917,1963,'survey_index_7_survey_url','#'),(99918,1963,'_survey_index_7_survey_url','field_6294564e42239'),(99919,1963,'survey_index_7_survey_url_text','View Results'),(99920,1963,'_survey_index_7_survey_url_text','field_629456584223a'),(99921,1963,'survey_index','8'),(99922,1963,'_survey_index','field_6294561242236'),(99923,1963,'report_title','Download the report'),(99924,1963,'_report_title','field_62f30edfb57e1'),(99925,1963,'report_intro','Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus massa erat, consectetur at semper at, feugiat vel orci. '),(99926,1963,'_report_intro','field_62f30eedb57e2'),(99927,1963,'report_link_url','#'),(99928,1963,'_report_link_url','field_62f30ef4b57e3'),(99929,1963,'report_link_text','Download'),(99930,1963,'_report_link_text','field_62f30f01b57e4'),(99931,1963,'solutions_content','The housing system is complex, and no one solution will solve the complex problems we now face but there are some critical first steps to be taken now.\r\n<ul>\r\n 	<li>Set out an ambitious national housing agreement between commonwealth and state governments with targets and funding for the construction of affordable homes.</li>\r\n 	<li>Phase out tax breaks for property investors and using the increase in revenue to build more public housing.</li>\r\n 	<li>Establish laws which limit rental increases beyond what is fair.</li>\r\n 	<li>Rebalance tenancy laws to provide renters with more security and control, such as eliminating no grounds evictions.</li>\r\n 	<li>Phase out stamp duty and replace it with a broad-based land tax.</li>\r\n</ul>\r\n<h4>While there are many opinions on what policy changes will fix the housing market, doing nothing is not an option.</h4>'),(99932,1963,'_solutions_content','field_640e8b307a958'),(99933,1963,'problem_icons_0_prob_icon','1699'),(99934,1963,'_problem_icons_0_prob_icon','field_640fa0291d519'),(99935,1963,'problem_icons_0_prob_concerned_stat','70% highly concerned'),(99936,1963,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(99937,1963,'problem_icons_0_prob_concerded_text','are highly concerned'),(99938,1963,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(99939,1963,'problem_icons_0_prob_issue_text',''),(99940,1963,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(99941,1963,'problem_icons','4'),(99942,1963,'_problem_icons','field_640fa0191d518'),(99943,1963,'ceh_content_left',''),(99944,1963,'_ceh_content_left','field_640e97e8f1c8c'),(99945,1963,'ceh_content_right',''),(99946,1963,'_ceh_content_right','field_640e97fdf1c8d'),(99947,1963,'pc_content_left',''),(99948,1963,'_pc_content_left','field_640e983bf1c8f'),(99949,1963,'pc_content_right',''),(99950,1963,'_pc_content_right','field_640e984df1c90'),(99951,1963,'problem_icons_1_prob_icon','1699'),(99952,1963,'_problem_icons_1_prob_icon','field_640fa0291d519'),(99953,1963,'problem_icons_1_prob_concerned_stat','69% highly concerned'),(99954,1963,'_problem_icons_1_prob_concerned_stat','field_640fa0dd81d95'),(99955,1963,'problem_icons_1_prob_concerded_text','are highly concerned'),(99956,1963,'_problem_icons_1_prob_concerded_text','field_640fa10181d96'),(99957,1963,'problem_icons_1_prob_issue_text',''),(99958,1963,'_problem_icons_1_prob_issue_text','field_640fa11a81d97'),(99959,1963,'problem_icons_2_prob_icon','1699'),(99960,1963,'_problem_icons_2_prob_icon','field_640fa0291d519'),(99961,1963,'problem_icons_2_prob_concerned_stat','64% highly concerned'),(99962,1963,'_problem_icons_2_prob_concerned_stat','field_640fa0dd81d95'),(99963,1963,'problem_icons_2_prob_concerded_text','are highly concerned'),(99964,1963,'_problem_icons_2_prob_concerded_text','field_640fa10181d96'),(99965,1963,'problem_icons_2_prob_issue_text',''),(99966,1963,'_problem_icons_2_prob_issue_text','field_640fa11a81d97'),(99967,1963,'problem_icons_3_prob_icon','1699'),(99968,1963,'_problem_icons_3_prob_icon','field_640fa0291d519'),(99969,1963,'problem_icons_3_prob_concerned_stat','64% highly concerned'),(99970,1963,'_problem_icons_3_prob_concerned_stat','field_640fa0dd81d95'),(99971,1963,'problem_icons_3_prob_concerded_text','are highly concerned'),(99972,1963,'_problem_icons_3_prob_concerded_text','field_640fa10181d96'),(99973,1963,'problem_icons_3_prob_issue_text',''),(99974,1963,'_problem_icons_3_prob_issue_text','field_640fa11a81d97'),(99975,1963,'problem_icons_0_prob_concerned_text','House prices have doubled in a decade'),(99976,1963,'_problem_icons_0_prob_concerned_text','field_640fa10181d96'),(99977,1963,'problem_icons_1_prob_concerned_text','The gap between rich and poor is growing'),(99978,1963,'_problem_icons_1_prob_concerned_text','field_640fa10181d96'),(99979,1963,'problem_icons_2_prob_concerned_text','Construction of social housing is down'),(99980,1963,'_problem_icons_2_prob_concerned_text','field_640fa10181d96'),(99981,1963,'problem_icons_3_prob_concerned_text','Banks are making more than ever from housing'),(99982,1963,'_problem_icons_3_prob_concerned_text','field_640fa10181d96'),(99983,1963,'monitor_content','The Australian Housing Monitor is a large, nationally-representative survey covering public experiences and attitudes toward housing related issues. Questions range from how well the respondent is keeping up with their mortgage/rent, to what they think about social housing construction.\r\n\r\nA broad range of demographic criteria are included, such as gender, location, age, income, voting preference, educational level, tenure type, and employment status. These variables allow CEH researchers to understand the trends and diversity of opinion around the country.\r\n\r\nIt also incorporates questions from previous surveys to track trends over time.\r\nThe inaugural poll was conducted by Essential in December 2022, and was completed by 4,735 people.'),(99984,1963,'_monitor_content','field_640fcc4014404'),(99985,1963,'problem_head','Housing in Australia is not working, and Australians are concerned.'),(99986,1963,'_problem_head','field_641935436aded'),(99987,1963,'problem_signoff','Explore the research showing how concerned Australians are our about the housing situation.'),(99988,1963,'_problem_signoff','field_641935626adee'),(99989,1963,'sections','a:2:{i:0;s:4:\"hero\";i:1;s:9:\"news_grid\";}'),(99990,1963,'_sections','field_5dafb40b8143a'),(99991,1963,'sections_0_is_full_height','1'),(99992,1963,'_sections_0_is_full_height','field_61d6f6fd5a37e'),(99993,1963,'sections_0_image','1648'),(99994,1963,'_sections_0_image','field_61d6f6d45a37d'),(99995,1963,'sections_0_heading','Heading'),(99996,1963,'_sections_0_heading','field_61d6f69e5a379'),(99997,1963,'sections_0_subtitle','Ya ya '),(99998,1963,'_sections_0_subtitle','field_61d6f6ac5a37a'),(99999,1963,'sections_0_link_one',''),(100000,1963,'_sections_0_link_one','field_61d6f6b55a37b'),(100001,1963,'sections_0_link_two',''),(100002,1963,'_sections_0_link_two','field_61d6f6c35a37c'),(100003,1963,'sections_1_select_categories','a:1:{i:0;s:2:\"27\";}'),(100004,1963,'_sections_1_select_categories','field_637f04483b63b'),(100005,1963,'intro_head_major','Super Consumers Australia is <span>fighting</span> to ensure that the superannuation industry is <span>held accountable</span> for the outcomes they deliver to Australian consumers.'),(100006,1963,'_intro_head_major','field_64e828783ad9f'),(100007,1963,'intro_head_minor','We want super to work for everyone—not just super fund companies. With our research, journalism and campaigns we are creating the trustworthy and transparent superannuation system we all deserve.'),(100008,1963,'_intro_head_minor','field_64e8288c3ada0'),(100009,1963,'intro_icons_0_int_icon','1922'),(100010,1963,'_intro_icons_0_int_icon','field_64e828b33ada2'),(100011,1963,'intro_icons_0_int_icon_text','At 1,727,000 square kilometres, we’re 2.5 times the size of Texas. <span>Yeeha!</span>'),(100012,1963,'_intro_icons_0_int_icon_text','field_64e828e33ada3'),(100013,1963,'intro_icons_1_int_icon','1920'),(100014,1963,'_intro_icons_1_int_icon','field_64e828b33ada2'),(100015,1963,'intro_icons_1_int_icon_text','We have twice as many species of native plant and animal as any other Australian state or territory.'),(100016,1963,'_intro_icons_1_int_icon_text','field_64e828e33ada3'),(100017,1963,'intro_icons_2_int_icon','1921'),(100018,1963,'_intro_icons_2_int_icon','field_64e828b33ada2'),(100019,1963,'intro_icons_2_int_icon_text','We have less land classified as ‘protected’ than any other state or territory.'),(100020,1963,'_intro_icons_2_int_icon_text','field_64e828e33ada3'),(100021,1963,'intro_icons','3'),(100022,1963,'_intro_icons','field_64e828963ada1'),(100023,1963,'threat_head_major','What we stand to lose if we don’t act soon to protect beautiful Queensland:'),(100024,1963,'_threat_head_major','field_64ec258d9dbd1'),(100025,1963,'threats_icons','3'),(100026,1963,'_threats_icons','field_64ec2551a93f9'),(100027,1963,'threats_icons_0_thr_icon','1819'),(100028,1963,'_threats_icons_0_thr_icon','field_64ec2551a93fa'),(100029,1963,'threats_icons_0_thr_icon_text','The rich cultural heritage of our First Nations people and their continuous ties to country, dating back more than 50,000 years.'),(100030,1963,'_threats_icons_0_thr_icon_text','field_64ec2551a93fb'),(100031,1963,'threats_icons_1_thr_icon','1819'),(100032,1963,'_threats_icons_1_thr_icon','field_64ec2551a93fa'),(100033,1963,'threats_icons_1_thr_icon_text','Thousands of species of plant and animal