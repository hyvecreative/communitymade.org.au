utton','field_5b67cb29ddf9c'),(102805,1991,'second_image_title','Lifestart is about supporting young children'),(102806,1991,'_second_image_title','field_5b67cb20ddf9a'),(102807,1991,'page_col_image','412'),(102808,1991,'_page_col_image','field_5de6546e7c63a'),(102809,1991,'page_col_image_3','437'),(102810,1991,'_page_col_image_3','field_5de6e3998e07e'),(102811,1991,'sec_2_title','Community'),(102812,1991,'_sec_2_title','field_5de6e3ef2798f'),(102813,1991,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(102814,1991,'_sec_2_text','field_5de78dc89e613'),(102815,1991,'sec_3_title','The Project'),(102816,1991,'_sec_3_title','field_5de6e3d37d8da'),(102817,1991,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(102818,1991,'_sec_3_text','field_5de6e4044e5e8'),(102819,1991,'page_col_image_2','436'),(102820,1991,'_page_col_image_2','field_5de6546e7c63a'),(102821,1991,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(102822,1991,'_sec_2_button','field_5de6e58c86706'),(102823,1991,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(102824,1991,'_sec_3_button','field_5de6e5a243c03'),(102825,1991,'page_col_image_4','455'),(102826,1991,'_page_col_image_4','field_5de70801090ce'),(102827,1991,'sec_4_title','Location'),(102828,1991,'_sec_4_title','field_5de7082a12a81'),(102829,1991,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(102830,1991,'_sec_4_text','field_5de7084812a82'),(102831,1991,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(102832,1991,'_sec_4_button','field_5de7085e12a83'),(102833,1991,'news_title','Project updates'),(102834,1991,'_news_title','field_5de78da3aabb9'),(102835,1991,'sec_2_text_copy',''),(102836,1991,'_sec_2_text_copy','field_5de78dc89e613'),(102837,1991,'timeline-title','Timeline'),(102838,1991,'_timeline-title','field_5de78df29e615'),(102839,1991,'timeline_title','Timeline'),(102840,1991,'_timeline_title','field_5de78df29e615'),(102841,1991,'contact_title','Contact us'),(102842,1991,'_contact_title','field_5de7981e06057'),(102843,1991,'contact_intro','Contact text...'),(102844,1991,'_contact_intro','field_5de7983506058'),(102845,1991,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(102846,1991,'_news_button','field_5de8329896e02'),(102847,1991,'timeline_intro','Introduction of timeline detail...'),(102848,1991,'_timeline_intro','field_5de98f5fb1781'),(102849,1991,'timeline_pic','477'),(102850,1991,'_timeline_pic','field_5de98f72b1782'),(102851,1991,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(102852,1991,'_timeline_button','field_5de99363677f8'),(102853,1991,'banner_image_position','center'),(102854,1991,'_banner_image_position','field_5f3bc4757dd02'),(102855,1991,'services_title','Our services'),(102856,1991,'_services_title','field_5f20f3cd80eb2'),(102857,1991,'services_items_0_services_item_image','1061'),(102858,1991,'_services_items_0_services_item_image','field_5f2121355be14'),(102859,1991,'services_items_0_sservices_item_title','1300 Telephone