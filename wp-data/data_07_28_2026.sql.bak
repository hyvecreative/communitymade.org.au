tton','<a class=\"btn btn-blue\" href=\"#\">Read more</a>'),(134587,2264,'_support_right_button','field_5b67c6dd8c066'),(134588,2264,'first_image_title','Lifestart is about supporting young children'),(134589,2264,'_first_image_title','field_5b67ca606afc4'),(134590,2264,'first_image_cont','from 0-24 years living with disabilities and their familes'),(134591,2264,'_first_image_cont','field_5b67caff6afc5'),(134592,2264,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(134593,2264,'_first_image_button','field_5b67cb0d6afc6'),(134594,2264,'second _image_title','Lifestart is about supporting young children'),(134595,2264,'_second _image_title','field_5b67cb20ddf9a'),(134596,2264,'second_image_cont','from 0-24 years living with disabilities and their familes'),(134597,2264,'_second_image_cont','field_5b67cb24ddf9b'),(134598,2264,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(134599,2264,'_second_image_button','field_5b67cb29ddf9c'),(134600,2264,'second_image_title','Lifestart is about supporting young children'),(134601,2264,'_second_image_title','field_5b67cb20ddf9a'),(134602,2264,'page_col_image','412'),(134603,2264,'_page_col_image','field_5de6546e7c63a'),(134604,2264,'page_col_image_3','437'),(134605,2264,'_page_col_image_3','field_5de6e3998e07e'),(134606,2264,'sec_2_title','Community'),(134607,2264,'_sec_2_title','field_5de6e3ef2798f'),(134608,2264,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(134609,2264,'_sec_2_text','field_5de78dc89e613'),(134610,2264,'sec_3_title','The Project'),(134611,2264,'_sec_3_title','field_5de6e3d37d8da'),(134612,2264,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(134613,2264,'_sec_3_text','field_5de6e4044e5e8'),(134614,2264,'page_col_image_2','436'),(134615,2264,'_page_col_image_2','field_5de6546e7c63a'),(134616,2264,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(134617,2264,'_sec_2_button','field_5de6e58c86706'),(134618,2264,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(134619,2264,'_sec_3_button','field_5de6e5a243c03'),(134620,2264,'page_col_image_4','455'),(134621,2264,'_page_col_image_4','field_5de70801090ce'),(134622,2264,'sec_4_title','Location'),(134623,2264,'_sec_4_title','field_5de7082a12a81'),(134624,2264,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(134625,2264,'_sec_4_text','field_5de7084812a82'),(134626,2264,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(134627,2264,'_sec_4_button','field_5de7085e12a83'),(134628,2264,'news_title','Project updates'),(134629,2264,'_news_title','field_5de78da3aabb9'),(134630,2264,'sec_2_text_copy',''),(134631,2264,'_sec_2_text_copy','field_5de78dc89e613'),(134632,2264,'timeline-title','Timeline'),(134633,2264,'_timeline-title','field_5de78df29e615'),(134634,2264,'timeline_title','Timeline'),(134635,2264,'_timeline_title','field_5de78df29e615'),(134636,2264,'contact_title','Contact us'),(134637,2264,'_contact_title','field_5de7981e06057'),(134638,2264,'contact_intro','Contact text...'),(134639,2264,'_contact_intr