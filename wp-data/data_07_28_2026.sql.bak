pport_ctr_title','field_5b67c62a58af3'),(130215,2243,'support_ctr_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut laoreet.'),(130216,2243,'_support_ctr_cont','field_5b67c63158af4'),(130217,2243,'support_ctr_button','<a class=\"btn btn-orange\" href=\"/supports/\">Find us</a>'),(130218,2243,'_support_ctr_button','field_5b67c63658af5'),(130219,2243,'support_right_title','NDIS Registered provider'),(130220,2243,'_support_right_title','field_5b67c6a38c064'),(130221,2243,'support_right_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut.'),(130222,2243,'_support_right_cont','field_5b67c6c98c065'),(130223,2243,'support_right_button','<a class=\"btn btn-blue\" href=\"#\">Read more</a>'),(130224,2243,'_support_right_button','field_5b67c6dd8c066'),(130225,2243,'first_image_title','Lifestart is about supporting young children'),(130226,2243,'_first_image_title','field_5b67ca606afc4'),(130227,2243,'first_image_cont','from 0-24 years living with disabilities and their familes'),(130228,2243,'_first_image_cont','field_5b67caff6afc5'),(130229,2243,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(130230,2243,'_first_image_button','field_5b67cb0d6afc6'),(130231,2243,'second _image_title','Lifestart is about supporting young children'),(130232,2243,'_second _image_title','field_5b67cb20ddf9a'),(130233,2243,'second_image_cont','from 0-24 years living with disabilities and their familes'),(130234,2243,'_second_image_cont','field_5b67cb24ddf9b'),(130235,2243,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(130236,2243,'_second_image_button','field_5b67cb29ddf9c'),(130237,2243,'second_image_title','Lifestart is about supporting young children'),(130238,2243,'_second_image_title','field_5b67cb20ddf9a'),(130239,2243,'page_col_image','412'),(130240,2243,'_page_col_image','field_5de6546e7c63a'),(130241,2243,'page_col_image_3','437'),(130242,2243,'_page_col_image_3','field_5de6e3998e07e'),(130243,2243,'sec_2_title','Community'),(130244,2243,'_sec_2_title','field_5de6e3ef2798f'),(130245,2243,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(130246,2243,'_sec_2_text','field_5de78dc89e613'),(130247,2243,'sec_3_title','The Project'),(130248,2243,'_sec_3_title','field_5de6e3d37d8da'),(130249,2243,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(130250,2243,'_sec_3_text','field_5de6e4044e5e8'),(130251,2243,'page_col_image_2','436'),(130252,2243,'_page_col_image_2','field_5de6546e7c63a'),(130253,2243,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(130254,2243,'_sec_2_button','field_5de6e58c86706'),(130255,2243,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(130256,2243,'_sec_3_button','field_5de6e5a243c03'),(130257,2243,'page_col_image_4','455'),(130258,2243,'_page_col_image_4','field_5de70801090ce'),(130259,2243,'sec_4_title','Location'),(130260,2243,'_sec_4_title','field_5de7082a12a81'),(130261,2243,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(130262,2243,'_sec_4_text','field_5de7084812a82'),(130263,2243,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(130264,2243,'_sec_4_button','field_5de7085e12a83'),(130265,2243,'news_title','Project updates'),(130266,2243,'_news_title','field_5de78da3aabb9'),(130267,2243,'sec_2_text_copy',''),(130268,2243,'_sec_2_text_copy','field_5de78dc89e613'),(130269,2243,'timeline-title','Timeline'),(130270,2243,'_timeline-title','field_5de78df29e615'),(130271,2243,'timeline_title','Timeline'),(130272,2243,'_timeline_title','field_5de78df29e615'),(130273,2243,'contact_title','Contact us'),(130274,2243,'_contact_title','field_5de7981e06057'),(130275,2243,'contact_intro','Contact text...'),(130276,2243,'_contact_intro','field_5de7983506058'),(130277,2243,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(130278,2243,'_news_button','field_5de8329896e02'),(130279,2243,'timeline_intro','Introduction of timeline detail...'),(130280,2243,'_timeline_intro','field_5de98f5fb1781'),(130281,2243,'timeline_pic','477'),(130282,2243,'_timeline_pic','field_5de98f72b1782'),(130283,2243,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(130284,2243,'_timeline_button','field_5de99363677f8'),(130285,2243,'banner_image_position','center'),(130286,2243,'_banner_image_position','field_5f3bc4757dd02'),(130287,2243,'services_title','Our services'),(130288,2243,'_services_title','field_5f20f3cd80eb2'),(130289,2243,'services_items_0_services_item_image','1061'),(130290,2243,'_services_items_0_services_item_image','field_5f2121355be14'),(130291,2243,'services_items_0_sservices_item_title','1300 Telephone counselling line'),(130292,2243,'_services_items_0_sservices_item_title','field_605089efca82e'),(130293,2243,'services_items_0_services_item_text',''),(130294,2243,'_services_items_0_services_item_text','field_5f2121535be15'),(130295,2243,'services_items_0_services_link_url','#'),(130296,