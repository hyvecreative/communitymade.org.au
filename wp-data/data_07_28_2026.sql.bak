,1852,'_survey_index_6_survey_icon','field_6294562942237'),(68516,1852,'survey_index_6_survey_title','Energy Management'),(68517,1852,'_survey_index_6_survey_title','field_6294564042238'),(68518,1852,'survey_index_6_survey_url','#'),(68519,1852,'_survey_index_6_survey_url','field_6294564e42239'),(68520,1852,'survey_index_6_survey_url_text','View Results'),(68521,1852,'_survey_index_6_survey_url_text','field_629456584223a'),(68522,1852,'survey_index_7_survey_icon','1493'),(68523,1852,'_survey_index_7_survey_icon','field_6294562942237'),(68524,1852,'survey_index_7_survey_title','Going Off-grid'),(68525,1852,'_survey_index_7_survey_title','field_6294564042238'),(68526,1852,'survey_index_7_survey_url','#'),(68527,1852,'_survey_index_7_survey_url','field_6294564e42239'),(68528,1852,'survey_index_7_survey_url_text','View Results'),(68529,1852,'_survey_index_7_survey_url_text','field_629456584223a'),(68530,1852,'survey_index','8'),(68531,1852,'_survey_index','field_6294561242236'),(68532,1852,'report_title','Download the report'),(68533,1852,'_report_title','field_62f30edfb57e1'),(68534,1852,'report_intro','Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus massa erat, consectetur at semper at, feugiat vel orci. '),(68535,1852,'_report_intro','field_62f30eedb57e2'),(68536,1852,'report_link_url','#'),(68537,1852,'_report_link_url','field_62f30ef4b57e3'),(68538,1852,'report_link_text','Download'),(68539,1852,'_report_link_text','field_62f30f01b57e4'),(68540,1852,'solutions_content','The housing system is complex, and no one solution will solve the complex problems we now face but there are some critical first steps to be taken now.\r\n<ul>\r\n 	<li>Set out an ambitious national housing agreement between commonwealth and state governments with targets and funding for the construction of affordable homes.</li>\r\n 	<li>Phase out tax breaks for property investors and using the increase in revenue to build more public housing.</li>\r\n 	<li>Establish laws which limit rental increases beyond what is fair.</li>\r\n 	<li>Rebalance tenancy laws to provide renters with more security and control, such as eliminating no grounds evictions.</li>\r\n 	<li>Phase out stamp duty and replace it with a broad-based land tax.</li>\r\n</ul>\r\n<h4>While there are many opinions on what policy changes will fix the housing market, doing nothing is not an option.</h4>'),(68541,1852,'_solutions_content','field_640e8b307a958'),(68542,1852,'problem_icons_0_prob_icon','1699'),(68543,1852,'_problem_icons_0_prob_icon','field_640fa0291d519'),(68544,1852,'problem_icons_0_prob_concerned_stat','70% highly concerned'),(68545,1852,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(68546,1852,'problem_icons_0_prob_concerded_text','are highly concerned'),(68547,1852,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(68548,1852,'problem_icons_0_prob_issue_text',''),(68549,1852,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(68550,1852,'problem_icons','4'),(68551,1852,'_problem_icons','field_640fa0191d518'),(68552,1852,'ceh_content_left',''),(68553,1852,'_ceh_content_left','field_640e97e8f1c8c'),(68554,1852,'ceh_content_right',''),(68555,1852,'_ceh_content_right','field_640e97fdf1c8d'),(68556,1852,'pc_content_left',''),(68557,1852,'_pc_content_left','field_640e983bf1c8f'),(68558,1852,'pc_content_right',''),(68559,1852,'_pc_content_right','field_640e984df1c90'),(68560,1852,'problem_icons_1_prob_icon','1699'),(68561,1852,'_problem_icons_1_prob_icon','field_640fa0291d519'),(68562,1852,'problem_icons_1_prob_concerned_stat','69% highly concerned'),(68563,1852,'_problem_icons_1_prob_concerned_stat','field_640fa0dd81d95'),(68564,1852,'problem_icons_1_prob_concerded_text','are highly concerned'),(68565,1852,'_problem_icons_1_prob_concerded_text','field_640fa10181d96'),(68566,1852,'problem_icons_1_prob_issue_text',''),(68567,1852,'_problem_icons_1_prob_issue_text','field_640fa11a81d97'),(68568,1852,'problem_icons_2_prob_icon','1699'),(68569,1852,'_problem_icons_2_prob_icon','field_640fa0291d519'),(68570,1852,'problem_icons_2_prob_concerned_stat','64% highly concerned'),(68571,1852,'_problem_icons_2_prob_concerned_stat','field_640fa0dd81d95'),(68572,1852,'problem_icons_2_prob_concerded_text','are highly concerned'),(68573,1852,'_problem_icons_2_prob_concerded_text','field_640fa10181d96'),(68574,1852,'problem_icons_2_prob_issue_text',''),(68575,1852,'_problem_icons_2_prob_issue_text','field_640fa11a81d97'),(68576,1852,'problem_icons_3_prob_icon','1699'),(68577,1852,'_problem_icons_3_prob_icon','field_640fa0291d519'),(68578,1852,'problem_icons_3_prob_concerned_stat','64% highly concerned'),(68579,1852,'_problem_icons_3_prob_concerned_stat','field_640fa0dd81d95'),(68580,1852,'problem_icons_3_prob_concerded_text','are highly concerned'),(68581,1852,'_problem_icons_3_prob_concerded_text','field_640fa10181d96'),(68582,1852,'problem_icons_3_prob_issue_text',''),(68583,1852,'_problem_icons_3_prob_issue_text','field_640fa11a81d97'),(68584,1852,'problem_icons_0_prob_concerned_text','House prices have doubled in a decade'),(68585,1852,'_problem_icons_0_prob_concerned_text','field_640fa10181d96'),(68586,1852,'problem_icons_1_prob_concerned_text','The gap between rich and poor is growing'),(68587,1852,'_problem_icons_1_prob_concerned_text','field_640fa10181d96'),(68588,1852,'problem_icons_2_prob_concerned_text','Construction of social housing is down'),(68589,1852,'_problem_icons_2_prob_concerned_text','field_640fa10181d96'),(68590,1852,'problem_icons_3_prob_concerned_text','Banks are making more than ever from housing'),(68591,1852,'_problem_icons_3_prob_concerned_text','field_640fa10181d96'),(68592,1852,'monitor_content','The Australian Housing Monitor is a large, nationally-representative survey covering public experiences and attitudes toward housing related issues. Questions range from how well the respondent is keeping up with their mortgage/rent, to what they think about social housing construction.\r\n\r\nA broad range of demographic criteria are included, such as gender, location, age, income, voting preference, educational level, tenure type, and employment status. These variables allow CEH researchers to understand the trends and diversity of opinion around the country.\r\n\r\nIt also incorporates questions from previous surveys to track trends over time.\r\nThe inaugural poll was conducted by Essential in December 2022, and was completed by 4,735 people.'),(68593,1852,'_monitor_content','field_640fcc4014404'),(68594,1852,'problem_head','Housing in Australia is not working, and Australians are concerned.'),(68595,1852,'_problem_head','field_641935436aded'),(68596,1852,'problem_signoff','Explore the research showing how concerned Australians are our about the housing situation.'),(68597,1852,'_problem_signoff','field_641935626adee'),(68598,1852,'sections','a:2:{i:0;s:4:\"hero\";i:1;s:9:\"news_grid\";}'),(68599,1852,'_sections','field_5dafb40b8143a'),(68601,1852,'sections_0_is_full_height','1'),(68602,1852,'_sections_0_is_full_height','field_61d6f6fd5a37e'),(68603,1852,'sections_0_image','1648'),(68604,1852,'_sections_0_image','field_61d6f6d45a37d'),(68605,1852,'sections_0_heading','Heading'),(68606,1852,'_sections_0_heading','field_61d6f69e5a379'),(68607,1852,'sections_0_subtitle','Ya ya '),(68608,1852,'_sections_0_subtitle','field_61d6f6ac5a37a'),(68609,1852,'sections_0_link_one',''),(68610,1852,'_sections_0_link_one','field_61d6f6b55a37b'),(68611,1852,'sections_0_link_two',''),(68612,1852,'_sections_0_link_two','field_61d6f6c35a37c'),(68613,1852,'sections_1_select_categories','a:1:{i:0;s:2:\"27\";}'),(68614,1852,'_sections_1_select_categories','field_637f04483b63b'),(68615,1852,'_thumbnail_id','1798'),(68616,1852,'intro_head_major','Queenslanders are known for both our love of the great outdoors and our state pride…'),(68617,1852,'_intro_head_major','field_64e828783ad9f'),(68618,1852,'intro_head_minor','But there’s a few things you might not know about our beautiful state.'),(68619,1852,'_intro_head_minor','field_64e8288c3ada0'),(68620,1852,'intro_icons_0_int_icon','1806'),(68621,1852,'_intro_icons_0_int_icon','field_64e828b33ada2'),(68622,1852,'intro_icons_0_int_icon_text','At 1,727,000 square kilometres, we’re 2.5 times the size of Texas. <span>Yeeha!</span>'),(68623,1852,'_intro_icons_0_int_icon_text','field_64e828e33ada3'),(68624,1852,'intro_icons_1_int_icon','1806'),(68625,1852,'_intro_icons_1_int_icon','field_64e828b33ada2'),(68626,1852,'intro_icons_1_int_icon_text','We have twice as many species of native plant and animal as any other Australian state or territory.'),(68627,1852,'_intro_icons_1_int_icon_text','field_64e828e33ada3'),(68628,1852,'intro_icons_2_int_icon','1806'),(68629,1852,'_intro_icons_2_int_icon','field_64e828b33ada2'),(68630,1852,'intro_icons_2_int_icon_text','We have less land classified as ‘protected’ than any other state or territory.'),(68631,1852,'_intro_icons_2_int_icon_text','field_64e828e33ada3'),(68632,1852,'intro_icons','3'),(68633,1852,'_intro_icons','field_64e828963ada1'),(68634,1852,'threat_head_major','What we stand to lose if we don’t act soon to protect beautiful Queensland:'),(68635,1852,'_threat_head_major','field_64ec258d9dbd1'),(68636,1852,'threats_icons','3'),(68637,1852,'_threats_icons','field_64ec2551a93f9'),(68638,1852,'threats_icons_0_thr_icon','1819'),(68639,1852,'_threats_icons_0_thr_icon','field_64ec2551a93fa'),(68640,1852,'threats_icons_0_thr_icon_text','The rich cultural heritage of our First Nations people and their continuous ties to country, dating back more than 50,000 years.'),(68641,1852,'_threats_icons_0_thr_icon_text','field_64ec2551a93fb'),(68642,1852,'threats_icons_1_thr_icon','1819'),(68643,1852,'_threats_icons_1_thr_icon','field_64ec2551a93fa'),(68644,1852,'threats_icons_1_thr_icon_text','Thousands of species of plant and animal which are now classified as threatened or endangered in Queensland.'),(68645,1852,'_threats_icons_1_thr_icon_text','field_64ec2