k to us'),(66854,1848,'_support_ctr_title','field_5b67c62a58af3'),(66855,1848,'support_ctr_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut laoreet.'),(66856,1848,'_support_ctr_cont','field_5b67c63158af4'),(66857,1848,'support_ctr_button','<a class=\"btn btn-orange\" href=\"/supports/\">Find us</a>'),(66858,1848,'_support_ctr_button','field_5b67c63658af5'),(66859,1848,'support_right_title','NDIS Registered provider'),(66860,1848,'_support_right_title','field_5b67c6a38c064'),(66861,1848,'support_right_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut.'),(66862,1848,'_support_right_cont','field_5b67c6c98c065'),(66863,1848,'support_right_button','<a class=\"btn btn-blue\" href=\"#\">Read more</a>'),(66864,1848,'_support_right_button','field_5b67c6dd8c066'),(66865,1848,'first_image_title','Lifestart is about supporting young children'),(66866,1848,'_first_image_title','field_5b67ca606afc4'),(66867,1848,'first_image_cont','from 0-24 years living with disabilities and their familes'),(66868,1848,'_first_image_cont','field_5b67caff6afc5'),(66869,1848,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(66870,1848,'_first_image_button','field_5b67cb0d6afc6'),(66871,1848,'second _image_title','Lifestart is about supporting young children'),(66872,1848,'_second _image_title','field_5b67cb20ddf9a'),(66873,1848,'second_image_cont','from 0-24 years living with disabilities and their familes'),(66874,1848,'_second_image_cont','field_5b67cb24ddf9b'),(66875,1848,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(66876,1848,'_second_image_button','field_5b67cb29ddf9c'),(66877,1848,'second_image_title','Lifestart is about supporting young children'),(66878,1848,'_second_image_title','field_5b67cb20ddf9a'),(66879,1848,'page_col_image','412'),(66880,1848,'_page_col_image','field_5de6546e7c63a'),(66881,1848,'page_col_image_3','437'),(66882,1848,'_page_col_image_3','field_5de6e3998e07e'),(66883,1848,'sec_2_title','Community'),(66884,1848,'_sec_2_title','field_5de6e3ef2798f'),(66885,1848,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(66886,1848,'_sec_2_text','field_5de78dc89e613'),(66887,1848,'sec_3_title','The Project'),(66888,1848,'_sec_3_title','field_5de6e3d37d8da'),(66889,1848,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(66890,1848,'_sec_3_text','field_5de6e4044e5e8'),(66891,1848,'page_col_image_2','436'),(66892,1848,'_page_col_image_2','field_5de6546e7c63a'),(66893,1848,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(66894,1848,'_sec_2_button','field_5de6e58c86706'),(66895,1848,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(66896,1848,'_sec_3_button','field_5de6e5a243c03'),(66897,1848,'page_col_image_4','455'),(66898,1848,'_page_col_image_4','field_5de70801090ce'),(66899,1848,'sec_4_title','Location'),(66900,1848,'_sec_4_title','field_5de7082a12a81'),(66901,1848,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(66902,1848,'_sec_4_text','field_5de7084812a82'),(66903,1848,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(66904,1848,'_sec_4_button','field_5de7085e12a83'),(66905,1848,'news_title','Project updates'),(66906,1848,'_news_title','field_5de78da3aabb9'),(66907,1848,'sec_2_text_copy',''),(66908,1848,'_sec_2_text_copy','field_5de78dc89e613'),(66909,1848,'timeline-title','Timeline'),(66910,1848,'_timeline-title','field_5de78df29e615'),(66911,1848,'timeline_title','Timeline'),(66912,1848,'_timeline_title','field_5de78df29e615'),(66913,1848,'contact_title','Contact us'),(66914,1848,'_contact_title','field_5de7981e06057'),(66915,1848,'contact_intro','Contact text...'),(66916,1848,'_contact_intro','field_5de7983506058'),(66917,1848,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(66918,1848,'_news_button','field_5de8329896e02'),(66919,1848,'timeline_intro','Introduction of timeline detail...'),(66920,1848,'_timeline_intro','field_5de98f5fb1781'),(66921,1848,'timeline_pic','477'),(66922,1848,'_timeline_pic','field_5de98f72b1782'),(66923,1848,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(66924,1848,'_timeline_button','field_5de99363677f8'),(66925,1848,'banner_image_position','center'),(66926,1848,'_banner_image_position','field_5f3bc4757dd02'),(66927,1848,'services_title','Our services'),(66928,1848,'_services_title','field_5f20f3cd80eb2'),(66929,1848,'services_items_0_services_item_image','1061'),(66930,1848,'_services_items_0_services_item_image','field_5f2121355be14'),(66931,1848,'services_items_0_sservices_item_title','1300 Telephone counselling line'),(66932,1848,'_services_items_0_sservices_item_title','field_605089efca82e'),(66933,1848,'services_items_0_services_item_text',''),(66934,1848,'_services_items_0_services_item_text','field_5f2121535be15'),(66935,1848,'services_items_0_services_link_url','#'),(66936,1848,'_services_items_0_services_link_url','field_605086