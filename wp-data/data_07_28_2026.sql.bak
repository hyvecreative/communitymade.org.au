429,2469,'_survey_index_6_survey_icon','field_6294562942237'),(156430,2469,'survey_index_6_survey_title','Energy Management'),(156431,2469,'_survey_index_6_survey_title','field_6294564042238'),(156432,2469,'survey_index_6_survey_url','#'),(156433,2469,'_survey_index_6_survey_url','field_6294564e42239'),(156434,2469,'survey_index_6_survey_url_text','View Results'),(156435,2469,'_survey_index_6_survey_url_text','field_629456584223a'),(156436,2469,'survey_index_7_survey_icon','1493'),(156437,2469,'_survey_index_7_survey_icon','field_6294562942237'),(156438,2469,'survey_index_7_survey_title','Going Off-grid'),(156439,2469,'_survey_index_7_survey_title','field_6294564042238'),(156440,2469,'survey_index_7_survey_url','#'),(156441,2469,'_survey_index_7_survey_url','field_6294564e42239'),(156442,2469,'survey_index_7_survey_url_text','View Results'),(156443,2469,'_survey_index_7_survey_url_text','field_629456584223a'),(156444,2469,'survey_index','8'),(156445,2469,'_survey_index','field_6294561242236'),(156446,2469,'report_title','Download the report'),(156447,2469,'_report_title','field_62f30edfb57e1'),(156448,2469,'report_intro','Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus massa erat, consectetur at semper at, feugiat vel orci. '),(156449,2469,'_report_intro','field_62f30eedb57e2'),(156450,2469,'report_link_url','#'),(156451,2469,'_report_link_url','field_62f30ef4b57e3'),(156452,2469,'report_link_text','Download'),(156453,2469,'_report_link_text','field_62f30f01b57e4'),(156454,2469,'solutions_content','The housing system is complex, and no one solution will solve the complex problems we now face but there are some critical first steps to be taken now.\r\n<ul>\r\n 	<li>Set out an ambitious national housing agreement between commonwealth and state governments with targets and funding for the construction of affordable homes.</li>\r\n 	<li>Phase out tax breaks for property investors and using the increase in revenue to build more public housing.</li>\r\n 	<li>Establish laws which limit rental increases beyond what is fair.</li>\r\n 	<li>Rebalance tenancy laws to provide renters with more security and control, such as eliminating no grounds evictions.</li>\r\n 	<li>Phase out stamp duty and replace it with a broad-based land tax.</li>\r\n</ul>\r\n<h4>While there are many opinions on what policy changes will fix the housing market, doing nothing is not an option.</h4>'),(156455,2469,'_solutions_content','field_640e8b307a958'),(156456,2469,'problem_icons_0_prob_icon','1699'),(156457,2469,'_problem_icons_0_prob_icon','field_640fa0291d519'),(156458,2469,'problem_icons_0_prob_concerned_stat','70% highly concerned'),(156459,2469,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(156460,2469,'problem_icons_0_prob_concerded_text','are highly concerned'),(156461,2469,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(156462,2469,'problem_icons_0_prob_issue_text',''),(156463,2469,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(156464,2469,'problem_icons','4'),(156465,2469,'_problem_icons','field_640fa0191d518'),(156466,2469,'ceh_content_left',''),(156467,2469,'_ceh_content_left','field_640e97e8f1c8c'),(156468,2469,'ceh_content_right',''),(156469,2469,'_ceh_content_right','field_640e97fdf1c8d'),(156470,2469,'pc_content_left',''),(156471,2469,'_pc_content_left','field_640e983bf1c8f'),(156472,2469,'pc_content_right',''),(156473,2469,'_pc_content_right','field_640e984df1c90'),(156474,2469,'problem_icons_1_prob_icon','1699'),(156475,2469,'_problem_icons_1_prob_icon','field_640fa0291d519'),(156476,2469,'problem_icons_1_prob_concerned_stat','69% highly concerned'),(156477,2469,'_problem_icons_1_prob_concerned_stat','field_640fa0dd81d95'),(156478,2469,'problem_icons_1_prob_concerded_text','are highly concerned'),(156479,2469,'_problem_icons_1_prob_concerded_text','field_640fa10181d96'),(156480,2469,'problem_icons_1_prob_issue_text',''),(156481,2469,'_problem_icons_1_prob_issue_text','field_640fa11a81d97'),(156482,2469,'problem_icons_2_prob_icon','1699'),(156483,2469,'_problem_icons_2_prob_icon','field_640fa0291d519'),(156484,2469,'problem_icons_2_prob_concerned_stat','64% highly concerned'),(156485,2469,'_problem_icons_2_prob_concerned_stat','field_640fa0dd81d95'),(156486,2469,'problem_icons_2_prob_concerded_text','are highly concerned'),(156487,2469,'_problem_icons_2_prob_concerded_text','field_640fa10181d96'),(156488,2469,'problem_icons_2_prob_issue_text',''),(156489,2469,'_problem_icons_2_prob_issue_text','field_640fa11a81d97'),(156490,2469,'problem_icons_3_prob_icon','1699'),(156491,2469,'_problem_icons_3_prob_icon','field_640fa0291d519'),(156492,2469,'problem_icons_3_prob_concerned_stat','64% highly concerned'),(156493,2469,'_problem_icons_3_prob_concerned_stat','field_640fa0dd81d95'),(156494,2469,'problem_icons_3_prob_concerded_text','are highly concerned'),(156495,2469,'_problem_icons_3_prob_concerded_text','field_640fa10181d96'),(156496,2469,'problem_icons_3_prob_issue_text',''),(156497,2469,'_problem_icons_3_prob_issue_text','field_640fa11a81d97'),(156498,2469,'problem_icons_0_prob_concerned_text','House prices have doubled in a decade'),(156499,2469,'_problem_icons_0_prob_concerned_text','field_640fa10181d96'),(156500,2469,'problem_icons_1_prob_concerned_text','The gap between rich and poor is growing'),(156501,2469,'_problem_icons_1_prob_concerned_text','field_640fa10181d96'),(156502,2469,'problem_icons_2_prob_concerned_text','Construction of social housing is down'),(156503,2469,'_problem_icons_2_prob_concerned_text','field_640fa10181d96'),(156504,2469,'problem_icons_3_prob_concerned_text','Banks are making more than ever from housing'),(156505,2469,'_problem_icons_3_prob_concerned_text','field_640fa10181d96'),(156506,2469,'monitor_content','The Australian Housing Monitor is a large, nationally-representative survey covering public experiences and attitudes toward housing related issues. Questions range from how well the respondent is keeping up with their mortgage/rent, to what they think about social housing construction.\r\n\r\nA broad range of demographic criteria are included, such as gender, location, age, income, voting preference, educational level, tenure type, and employment status. These variables allow CEH researchers to understand the trends and diversity of opinion around the country.\r\n\r\nIt also incorporates questions from previous surveys to track trends over time.\r\nThe inaugural poll was conducted by Essential in December 2022, and was completed by 4,735 people.'),(156507,2469,'_monitor_content','field_640fcc4014404'),(156508,2469,'problem_head','Housing in Australia is not working, and Australians are concerned.'),(156509,2469,'_problem_head','field_641935436aded'),(156510,2469,'problem_signoff','Explore the research showing how concerned Australians are our about the housing situation.'),(156511,2469,'_problem_signoff','field_641935626adee'),(156512,2469,'sections','a:2:{i:0;s:4:\"hero\";i:1;s:9:\"news_grid\";}'),(156513,2469,'_sections','field_5dafb40b8143a'),(156514,2469,'sections_0_is_full_height','1'),(156515,2469,'_sections_0_is_full_height','field_61d6f6fd5a37e'),(156516,2469,'sections_0_image','1648'),(156517,2469,'_sections_0_image','field_61d6f6d45a37d'),(156518,2469,'sections_0_heading','Heading'),(156519,2469,'_sections_0_heading','field_61d6f69e5a379'),(156520,2469,'sections_0_subtitle','Ya ya '),(156521,2469,'_sections_0_subtitle','field_61d6f6ac5a37a'),(156522,2469,'sections_0_link_one',''),(156523,2469,'_sections_0_link_one','field_61d6f6b55a37b'),(156524,2469,'sections_0_link_two',''),(156525,2469,'_sections_0_link_two','field_61d6f6c35a37c'),(156526,2469,'sections_1_select_categories','a:1:{i:0;s:2:\"27\";}'),(156527,2469,'_sections_1_select_categories','field_637f04483b63b'),(156528,2469,'intro_head_major','Welcome to the Disability Dialogue'),(156529,2469,'_intro_head_major','field_64e828783ad9f'),(156530,2469,'intro_head_minor',''),(156531,2469,'_intro_head_minor','f