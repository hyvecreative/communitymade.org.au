06,2201,'support_ctr_button','<a class=\"btn btn-orange\" href=\"/supports/\">Find us</a>'),(125607,2201,'_support_ctr_button','field_5b67c63658af5'),(125608,2201,'support_right_title','NDIS Registered provider'),(125609,2201,'_support_right_title','field_5b67c6a38c064'),(125610,2201,'support_right_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut.'),(125611,2201,'_support_right_cont','field_5b67c6c98c065'),(125612,2201,'support_right_button','<a class=\"btn btn-blue\" href=\"#\">Read more</a>'),(125613,2201,'_support_right_button','field_5b67c6dd8c066'),(125614,2201,'first_image_title','Lifestart is about supporting young children'),(125615,2201,'_first_image_title','field_5b67ca606afc4'),(125616,2201,'first_image_cont','from 0-24 years living with disabilities and their familes'),(125617,2201,'_first_image_cont','field_5b67caff6afc5'),(125618,2201,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(125619,2201,'_first_image_button','field_5b67cb0d6afc6'),(125620,2201,'second _image_title','Lifestart is about supporting young children'),(125621,2201,'_second _image_title','field_5b67cb20ddf9a'),(125622,2201,'second_image_cont','from 0-24 years living with disabilities and their familes'),(125623,2201,'_second_image_cont','field_5b67cb24ddf9b'),(125624,2201,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(125625,2201,'_second_image_button','field_5b67cb29ddf9c'),(125626,2201,'second_image_title','Lifestart is about supporting young children'),(125627,2201,'_second_image_title','field_5b67cb20ddf9a'),(125628,2201,'page_col_image','412'),(125629,2201,'_page_col_image','field_5de6546e7c63a'),(125630,2201,'page_col_image_3','437'),(125631,2201,'_page_col_image_3','field_5de6e3998e07e'),(125632,2201,'sec_2_title','Community'),(125633,2201,'_sec_2_title','field_5de6e3ef2798f'),(125634,2201,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(125635,2201,'_sec_2_text','field_5de78dc89e613'),(125636,2201,'sec_3_title','The Project'),(125637,2201,'_sec_3_title','field_5de6e3d37d8da'),(125638,2201,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(125639,2201,'_sec_3_text','field_5de6e4044e5e8'),(125640,2201,'page_col_image_2','436'),(125641,2201,'_page_col_image_2','field_5de6546e7c63a'),(125642,2201,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(125643,2201,'_sec_2_button','field_5de6e58c86706'),(125644,2201,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(125645,2201,'_sec_3_button','field_5de6e5a243c03'),(125646,2201,'page_col_image_4','455'),(125647,2201,'_page_col_image_4','field_5de70801090ce'),(125648,2201,'sec_4_title','Location'),(125649,2201,'_sec_4_title','field_5de7082a12a81'),(125650,2201,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(125651,2201,'_sec_4_text','field_5de7084812a82'),(125652,2201,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(125653,2201,'_sec_4_button','field_5de7085e12a83'),(125654,2201,'news_title','Project updates'),(125