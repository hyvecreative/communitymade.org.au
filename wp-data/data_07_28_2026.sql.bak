'second_image_title','Lifestart is about supporting young children'),(187320,2704,'_second_image_title','field_5b67cb20ddf9a'),(187321,2704,'page_col_image','412'),(187322,2704,'_page_col_image','field_5de6546e7c63a'),(187323,2704,'page_col_image_3','437'),(187324,2704,'_page_col_image_3','field_5de6e3998e07e'),(187325,2704,'sec_2_title','Community'),(187326,2704,'_sec_2_title','field_5de6e3ef2798f'),(187327,2704,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(187328,2704,'_sec_2_text','field_5de78dc89e613'),(187329,2704,'sec_3_title','The Project'),(187330,2704,'_sec_3_title','field_5de6e3d37d8da'),(187331,2704,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(187332,2704,'_sec_3_text','field_5de6e4044e5e8'),(187333,2704,'page_col_image_2','436'),(187334,2704,'_page_col_image_2','field_5de6546e7c63a'),(187335,2704,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(187336,2704,'_sec_2_button','field_5de6e58c86706'),(187337,2704,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(187338,2704,'_sec_3_button','field_5de6e5a243c03'),(187339,2704,'page_col_image_4','455'),(187340,2704,'_page_col_image_4','field_5de70801090ce'),(187341,2704,'sec_4_title','Location'),(187342,2704,'_sec_4_title','field_5de7082a12a81'),(187343,2704,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(187344,2704,'_sec_4_text','field_5de7084812a82'),(187345,2704,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(187346,2704,'_sec_4_button','field_5de7085e12a83'),(187347,2704,'news_title','Project updates'),(187348,2704,'_news_title','field_5de78da3aabb9'),(187349,2704,'sec_2_text_copy',''),(187350,2704,'_sec_2_text_copy','field_5de78dc89e613'),(187351,2704,'timeline-title','Timeline'),(187352,2704,'_timeline-title','field_5de78df29e615'),(187353,2704,'timeline_title','Timeline'),(187354,2704,'_timeline_title','field_5de78df29e615'),(187355,2704,'contact_title','Contact us'),(187356,2704,'_contact_title','field_5de7981e06057'),(187357,2704,'contact_intro','Contact text...'),(187358,2704,'_contact_intro','field_5de7983506058'),(187359,2704,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(187360,2704,'_news_button','field_5de8329896e02'),(187361,2704,'timeline_intro','Introduction of timeline detail...'),(187362,2704,'_timeline_intro','field_5de98f5fb1781'),(187363,2704,'timeline_pic','477'),(187364,2704,'_timeline_pic','field_5de98f72b1782'),(187365,2704,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(187366,2704,'_timeline_button','field_5de99363677f8'),(187367,2704,'banner_image_position','center'),(187368,2704,'_banner_image_position','field_5f3bc4757dd02'),(187369,2704,'services_title','Our services'),(187370,2704,'_services_title','field_5f20f3cd80eb2'),(187371,2704,'services_items_0_services_item_image','1061'),(187372,2704,'_services_items_0_services_item_image','field_5f2121355be14'),(187373,2704,'services_items_0_sservices_item_title','1300 Telephone counselling line'),(187374,2704,'_services