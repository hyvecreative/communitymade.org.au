con','1493'),(102012,1970,'_survey_index_7_survey_icon','field_6294562942237'),(102013,1970,'survey_index_7_survey_title','Going Off-grid'),(102014,1970,'_survey_index_7_survey_title','field_6294564042238'),(102015,1970,'survey_index_7_survey_url','#'),(102016,1970,'_survey_index_7_survey_url','field_6294564e42239'),(102017,1970,'survey_index_7_survey_url_text','View Results'),(102018,1970,'_survey_index_7_survey_url_text','field_629456584223a'),(102019,1970,'survey_index','8'),(102020,1970,'_survey_index','field_6294561242236'),(102021,1970,'report_title','Download the report'),(102022,1970,'_report_title','field_62f30edfb57e1'),(102023,1970,'report_intro','Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus massa erat, consectetur at semper at, feugiat vel orci. '),(102024,1970,'_report_intro','field_62f30eedb57e2'),(102025,1970,'report_link_url','#'),(102026,1970,'_report_link_url','field_62f30ef4b57e3'),(102027,1970,'report_link_text','Download'),(102028,1970,'_report_link_text','field_62f30f01b57e4'),(102029,1970,'solutions_content','The housing system is complex, and no one solution will solve the complex problems we now face but there are some critical first steps to be taken now.\r\n<ul>\r\n 	<li>Set out an ambitious national housing agreement between commonwealth and state governments with targets and funding for the construction of affordable homes.</li>\r\n 	<li>Phase out tax breaks for property investors and using the increase in revenue to build more public housing.</li>\r\n 	<li>Establish laws which limit rental increases beyond what is fair.</li>\r\n 	<li>Rebalance tenancy laws to provide renters with more security and control, such as eliminating no grounds evictions.</li>\r\n 	<li>Phase out stamp duty and replace it with a broad-based land tax.</li>\r\n</ul>\r\n<h4>While there are many opinions on what policy changes will fix the housing market, doing nothing is not an option.</h4>'),(102030,1970,'_solutions_content','field_640e8b307a958'),(102031,1970,'problem_icons_0_prob_icon','1699'),(102032,1970,'_problem_icons_0_prob_icon','field_640fa0291d519'),(102033,1970,'problem_icons_0_prob_concerned_stat','70% highly concerned'),(102034,1970,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(102035,1970,'problem_icons_0_prob_concerded_text','are highly concerned'),(102036,1970,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(102037,1970,'problem_icons_0_prob_issue_text',''),(102038,1970,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(102039,1970,'problem_icons','4'),(102040,1970,'_problem_icons','field_640fa0191d518'),(102041,1970,'ceh_content_left',''),(102042,1970,'_ceh_content_left','field_640e97e8f1c8c'),(102043,1970,'ceh_content_right',''),(102044,1970,'_ceh_content_right','field_640e97fdf1c8d'),(102045,1970,'pc_content_left',''),(102046,1970,'_pc_content_left','field_640e983bf1c8f'),(102047,1970,'pc_content_right',''),(102048,1970,'_pc_content_right','field_640e984df1c90'),(102049,1970,'problem_icons_1_prob_icon','1699'),(102050,1970,'_problem_icons_1_prob_icon','field_640fa0291d519'),(102051,1970,'problem_icons_1_prob_concerned_stat','69% highly concerned'),(102052,1970,'_problem_icons_1_prob_concerned_stat','field_640fa0dd81d95'),(102053,1970,'problem_icons_1_prob_concerded_text','are highly concerned'),(102054,1970,'_problem_icons_1_prob_concerded_text','field_640fa10181d96'),(102055,1970,'problem_icons_1_prob_issue_text',''),(102056,1970,'_problem_icons_1_prob_issue_text','field_640fa11a81d97'),(102057,1970,'problem_icons_2_prob_icon','1699'),(102058,1970,'_problem_icons_2_prob_icon','field_640fa0291d519'),(102059,1970,'problem_icons_2_prob_concerned_stat','64% highly concerned'),(102060,1970,'_problem_icons_2_prob_concerned_stat','field_640fa0dd81d95'),(102061,1970,'problem_icons_2_prob_concerded_text','are highly concerned'),(102062,1970,'_problem_icons_2_prob_concerded_text','field_640fa10181d96'),(102063,1970,'problem_icons_2_prob_issue_text',''),(102064,1970,'_problem_icons_2_prob_issue_text','field_640fa11a81d97'),(102065,1970,'problem_icons_3_prob_icon','1699'),(102066,1970,'_problem_icons_3_prob_icon','field_640fa0291d519'),(102067,1970,'problem_icons_3_prob_concerned_stat','64% highly concerned'),(102068,1970,'_problem_icons_3_prob_concerned_stat','field_640fa0dd81d95'),(102069,1970,'problem_icons_3_prob_concerded_text','are highly concerned'),(102070,1970,'_problem_icons_3_prob_concerded_text','field_640fa10181d96'),(102071,1970,'problem_icons_3_prob_issue_text',''),(102072,1970,'_problem_icons_3_prob_issue_text','field_640fa11a81d97'),(102073,1970,'problem_icons_0_prob_concerned_text','House prices have doubled in a decade'),(102074,1970,'_problem_icons_0_prob_concerned_text','field_640fa10181d96'),(102075,1970,'problem_icons_1_prob_concerned_text','The gap between rich and poor is growing'),(102076,1970,'_problem_icons_1_prob_concerned_text','field_640fa10181d96'),(102077,1970,'problem_icons_2_prob_concerned_text','Construction of social housing is down'),(102078,1970,'_problem_icons_2_prob_concerned_text','field_640fa10181d96'),(102079,1970,'problem_icons_3_prob_concerned_text','Banks are making more than ever from housing'),(102080,1970,'_problem_icons_3_prob_concerned_text','field_640fa10181d96'),(102081,1970,'monitor_content','The Australian Housing Monitor is a large, nationally-representative survey covering public experiences and attitudes toward housing related issues. Questions range from how well the respondent is keeping up with their mortgage/rent, to what they think about social housing construction.\r\n\r\nA broad range of demographic criteria are included, such as gender, location, age, income, voting preference, educational level, tenure type, and employment status. These variables allow CEH researchers to understand the trends and diversity of opinion around the country.\r\n\r\nIt also incorporates questions from previous surveys to track trends over time.\r\nThe inaugural poll was conducted by Essential in December 2022, and was completed by 4,735 people.'),(102082,1970,'_monitor_content','field_640fcc4014404'),(102083,1970,'problem_head','Housing in Australia is not working, and Australians are concerned.'),(102084,1970,'_problem_head','field_641935436aded'),(102085,1970,'problem_signoff','Explore the research showing how concerned Australians are our about the housing situation.'),(102086,1970,'_problem_signoff','field_641935626adee'),(102087,1970,'sections','a:2:{i:0;s:4:\"hero\";i:1;s:9:\"news_grid\";}'),(102088,1970,'_sections','field_5dafb40b8143a'),(102089,1970,'sections_0_is_full_height','1'),(102090,1970,'_sections_0_is_full_height','field_61d6f6fd5a37e'),(102091,1970,'sections_0_image','1648'),(102092,1970,'_sections_0_image','field_61d6f6d45a37d'),(102093,1970,'sections_0_heading','Heading'),(102094,1970,'_sections_0_heading','field_61d6f69e5a379'),(102095,1970,'sections_0_subtitle','Ya ya '),(102096,1970,'_sections_0_subtitle','field_61d6f6ac5a37a'),(102097,1970,'sections_0_link_one',''),(102098,1970,'_sections_0_link_one','field_61d6f6b55a37b'),(102099,1970,'sections_0_link_two',''),(102100,1970,'_sections_0_link_two','field_61d6f6c35a37c'),(102101,1970,'sections_1_select_categories','a:1:{i:0;s:2:\"27\";}'),(102102,1970,'_sections_1_select_categories','field_637f04483b63b'),(102103,1970,'intro_head_major','Super Consumers Australia is <span>fighting</span> to ensure that the superannuation industry is <span>held accountable</span> for the outcomes they deliver to Australian consumers.'),(102104,1970,'_intro_head_major','field_64e828783ad9f'),(102105,1970,'intro_head_minor','We want super to work for everyone—not just super fund companies. With our research, journalism and campaigns we are creating the trustworthy and transparent superannuation system we all deserve.'),(102106,1970,'_intro_head_minor','field_64e8288c3ada0'),(102107,1970,'intro_icons_0_int_icon','1922'),(102108,1970,'_intro_icons_0_int_icon','field_64e828b33ada2'),(1