nnetwork id=7]'),(208102,2762,'_signup_form','field_64fd8361d90ac'),(208103,2762,'signup_head','Join the campaign'),(208104,2762,'_signup_head','field_64fd83dc6b0b1'),(208105,2762,'boxes_section_title','Boxes'),(208106,2762,'_boxes_section_title','field_65262bbfd17fc'),(208107,2762,'intro_boxes_0_box_icon','1943'),(208108,2762,'_intro_boxes_0_box_icon','field_65262db5d36ee'),(208109,2762,'intro_boxes_0_box_title','Events'),(208110,2762,'_intro_boxes_0_box_title','field_65262d29ed8e3'),(208111,2762,'intro_boxes_0_box_dropdown','Our rigorous, conflict-free research and data analysis lifts the lid on fund performance, fees and insurance. Drawing on our policy expertise, we turn this analysis into action by using it to back reform and make super easier for people to understand. <a href=\"//localhost:4000:4000:4000:4000:4000:4000:/how/\">More</a>'),(208112,2762,'_intro_boxes_0_box_dropdown','field_65262dead0a0c'),(208113,2762,'intro_boxes_1_box_icon','1941'),(208114,2762,'_intro_boxes_1_box_icon','field_65262db5d36ee'),(208115,2762,'intro_boxes_1_box_title','Projects'),(208116,2762,'_intro_boxes_1_box_title','field_65262d29ed8e3'),(208117,2762,'intro_boxes_1_box_dropdown','Our rigorous, conflict-free research and data analysis lifts the lid on fund performance, fees and insurance. Drawing on our policy expertise, we turn this analysis into action by using it to back reform and make super easier for people to understand. <a href=\"//localhost:4000:4000:4000:4000:4000:4000:/how/\">More</a>'),(208118,2762,'_intro_boxes_1_box_dropdown','field_65262dead0a0c'),(208119,2762,'intro_boxes_2_box_icon','1937'),(208120,2762,'_intro_boxes_2_box_icon','field_65262db5d36ee'),(208121,2762,'intro_boxes_2_box_title','Ideas'),(208122,2762,'_intro_boxes_2_box_title','field_65262d29ed8e3'),(208123,2762,'intro_boxes_2_box_dropdown','Our rigorous, conflict-free research and data analysis lifts the lid on fund performance, fees and insurance. Drawing on our policy expertise, we turn this analysis into action by using it to back reform and make super easier for people to understand. <a href=\"//localhost:4000:4000:4000:4000:4000:4000:/how/\">More</a>'),(208124,2762,'_intro_boxes_2_box_dropdown','field_65262dead0a0c'),(208125,2762,'intro_boxes','3'),(208126,2762,'_intro_boxes','field_65262d14ed8e2'),(208127,2762,'get_help_section_title','Get Help'),(208128,2762,'_get_help_section_title','field_65262c35143de'),(208129,2762,'get_help_block_home',''),(208130,2762,'_get_help_block_home','field_65262c8a143e1'),(208131,2762,'gh_block_home_0_help_image','1956'),(208132,2762,'_gh_block_home_0_help_image','field_65262cd0143e2'),(208133,2762,'gh_block_home_0_help_title','How much do I need to retire? '),(208134,2762,'_gh_block_home_0_help_title','field_65262cec143e3'),(208135,2762,'gh_block_home_0_help_url','#'),(208136,2762,'_gh_block_home_0_help_url','field_65262cf4143e4'),(208137,2762,'gh_block_home_1_help_image','1962'),(208138,2762,'_gh_block_home_1_help_image','field_65262cd0143e2'),(208139,2762,'gh_block_home_1_help_title','I have a problem with  my super fund'),(208140,2762,'_gh_block_home_1_help_title','field_65262cec143e3'),(208141,2762,'gh_block_home_1_help_url','#'),(208142,2762,'_gh_block_home_1_help_url','field_65262cf4143e4'),(208143,2762,'gh_block_home_2_help_image','1961'),(208144,2762,'_gh_block_home_2_help_image','field_65262cd0143e2'),(208145,2762,'gh_block_home_2_help_title','How do I choose the right super? '),(208146,2762,'_gh_block_home_2_help_title','field_65262cec143e3'),(208147,2762,'gh_block_home_2_help_url','#'),(208148,2762,'_gh_block_home_2_help_url','field_65262cf4143e4'),(208149,2762,'gh_block_home','3'),(208150,2762,'_gh_block_home','field_65262c8a143e1'),(208151,2762,'turn_on_insights',''),(208152,2762,'_turn_on_insights','field_645c4a2e654a6'),(208153,2762,'report_questions','a:3:{i:0;s:2:\"59\";i:1;s:2:\"61\";i:2;s:4:\"2587\";}'),(208154,2762,'_report_questions','field_6109ed5e02e5a'),(208155,2762,'intro_text','The Disability Dialogue is a place where people with disabilities, their families, organisations providing support, academics, and the wider community come together to work on things that matter to us.\r\n\r\nThe Dialogue is a hub of knowledge and collaboration, separate from government, where we work together to come up. With new ideas on important topics. Our ideas can make a big difference in how services and systems are set up for people with disabilities.'),(208156,2762,'_intro_text','field_66441acfe963c'),(208157,2762,'word_link','#'),(208158,2762,'_word_link','field_6646c69723804'),(208159,2762,'pdf_link','#'),(208160,2762,'_pdf_link','field_6646c6da23805'),(208161,2762,'intro_boxes_0_box_image','2241'),(208162,2762,'_intro_boxes_0_box_image','field_65262db5d36ee'),(208163,2762,'intro_boxes_1_box_image','2179'),(208164,2762,'_intro_boxes_1_box_image','field_65262db5d36ee'),(208165,2762,'intro_boxes_2_box_image','2012'),(208166,2762,'_intro_boxes_2_box_image','field_65262db5d36ee'),(208167,2762,'intro_boxes_0_box_excerpt','Excerpt text here just a sentance or so and no more.'),(208168,2762,'_intro_boxes_0_box_excerpt','field_665975273e827'),(208169,2762,'intro_boxes_1_box_excerpt','Excerpt text here just a sentance or so and no more.'),(208170,2762,'_intro_boxes_1_box_excerpt','field_665975273e827'),(208171,2762,'intro_boxes_2_box_excerpt','Excerpt text here just a sentance or so and no more.'),(208172,2762,'_intro_boxes_2_box_excerpt','field_665975273e827'),(208173,2762,'intro_boxes_0_btn-text','Latest events'),(208174,2762,'_intro_boxes_0_btn-text','field_665abda8b8d4b'),(208175,2762,'intro_boxes_1_btn-text','Latest projects'),(208176,2762,'_intro_boxes_1_btn-text','field_665abda8b8d4b'),(208177,2762,'intro_boxes_2_btn-text','Latest ideas'),(208178,2762,'_intro_boxes_2_btn-text','field_665abda8b8d4b'),(208179,2762,'display-easy-read',''),(208180,2762,'_display-easy-read','field_666129bd2da00'),(208181,2762,'hm_hero_sum','Statement about the issue and lost life savings'),(208182,2762,'_hm_hero_sum','field_64ed37241effa'),(208183,2762,'hm_hero_sub','Real homes, run by not-for-profit providers, for everyday people and families. Join our NSW election campaign and ask your local candidates to commit to more community housing.'),(208184,2762,'_hm_hero_sub','field_64ed37241effa'),(208185,2762,'intro_head','We’re here to help.'),(208186,2762,'_intro_head','field_64e828783ad9f'),(208187,2762,'intro_content','About 12,000 people invested their hard-earned super savings in two investment funds which have now collapsed, called Shield Master Fund and First Guardian Master Fund. Most people will be entitled to get some money back, but you need to take action soon. This website has information and tools to help you understand what happened, where to get help and how to take back your super.'),(208188,2762,'_intro_content','field_66441acfe963c'),(208189,2762,'deadline_heading','Important deadlines'),(208190,2762,'_deadline_heading','field_69365ff82e6f2'),(208191,2762,'deadline_content','You need to take action before the deadline to take your super back.'),(208192,2762,'_deadline_content','field_693660342e6f3'),(208193,2762,'deadline_button_text','Find out more'),(208194,2762,'_deadline_button_text','field_693660482e6f4'),(208195,2762,'deadline_button_url','/key-deadlines/'),(208196,2762,'_deadline_button_url','field_693660912e6f5'),(208197,2762,'what_head','Get involved'),(208198,2762,'_what_head','field_69366611096ac'),(208199,2762,'what_happened_0_happ_sub','Take action here...'),(208200,2762,'_what_happened_0_happ_sub','field_693d4a8b4197d'),(208201,2762,'what_happened_0_happ_content','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut laoreet dolore magna aliquam erat volutpat. Ut wisi enim ad minim veniam, quis nostrud exerci tation ullamcorper suscipit lobortis nisl ut aliquip ex ea commodo consequat.\r\n\r\nDuis autem vel eum iriure dolor in hendrerit in vulputate velit esse molestie consequat, vel illum dolore eu feugiat nulla facilisis at vero eros et accumsan et iusto odio dignissim qui blandit praesent luptatum zzril delenit augue duis dolore te feugait nulla facilisi.'),(208202,2762,'_what_happened_0_happ_content','field_693d4aa84197e'),(208203,2762,'what_happened_0_happ_url','#'),(208204,2762,'_what_happened_0_happ_url','field_693d4aba4197f'),(208205,2762,'what_happened_0_happ_link_text','Find out More'),(208206,2762,'_what_happened_0_happ_link_text','field_693d4ad641980'),(208207,2762,'what_happened_1_happ_sub','Take action here...'),(208208,2762,'_what_happened_1_happ_sub','field_693d4a8b4197d'),(208209,2762,'what_happened_1_happ_content','Duis autem vel eum iriure dolor in hendrerit in vulputate velit esse molestie consequat, vel illum dolore eu feugiat nulla facilisis at vero eros et accumsan et iusto odio dignissim qui blandit praesent luptatum zzril delenit augue duis dolore te feugait nulla facilisi.\r\n\r\nLorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut laoreet dolore magna aliquam erat volutpat. Ut wisi enim ad minim veniam, quis nostrud exerci tation ullamcorper suscipit lobortis nisl ut aliquip ex ea commodo consequat.'),(208210,2762,'_what_happened_1_happ_content','field_693d4aa84197e'),(208211,2762,'what_happened_1_happ_url','#'),(208212,2762,'_what_happened_1_happ_url','field_693d4aba4197f'),(208213,2762,'what_happened_1_happ_link_text','Find out More'),(208214,2762,'_what_happened_1_happ_link_text','field_693d4ad641980'),(208215,2762,'what_happened','2'),(208216,2762,'_what_happened','field_693d4a6f4197c'),(208217,2762,'what_happened_0_happ_icon','2703'),(208218,2762,'_what_happened_0_happ_icon','field_693d4c9b3ec4d'),(208219,2762,'what_happened_1_happ_icon','2703'),(208220,2762,'_what_happened_1_happ_icon','field_693d4c9b3ec4d'),(208221,2762,'display_news_section',''),(208222,2762,'_display_news_section','field_69434cc6d5f7d'),(208223,2762,'issues_head','These are the issues'),(208224,2762,'_issues_head','field_6a3b076406aef'),(208225,2762,'issues_items_0_issue_icon','2705'),(208226,2762,'_issues_items_0_issue_icon','field_6a3b07b506af1'),(208227,2762,'issues_items_0_issues_item_hd','A secure home is slipping out of reach'),(208228,2762,'_issues_items_0_issues_item_hd','field_6a3b07d706af2'),(208229,2762,'issues_items_0_issues_item_txt','•	A shortage of 132,000 social and affordable rental homes\r\n•	70,000+ households waiting for social housing\r\n•	Record-high private market rents\r\n•	Home ownership increasingly out of reach for generations'),(208230,2762,'_issues_items_0_issues_item_txt','field_6a3b07fc06af3'),(208231,2762,'issues_items_0_issues_link_text',''),(208232,2762,'_issues_items_0_issues_link_text','field_6a3b080f06af4'),(208233,2762,'issues_items_0_issues_target_url',''),(208234,2762,'_issues_items_0_issues_target_url','field_6a3b082b06af5'),(208235,2762,'issues_items','2'),(208236,2762,'_issues_items','field_6a3b078206af0'),(208237,2762,'issues_items_1_issue_icon','2708'),(208238,2762,'_issues_items_1_issue_icon','field_6a3b07b506af1'),(208239,2762,'issues_items_1_issues_item_hd','The solutions we need '),(208240,2762,'_issues_items_1_issues_item_hd','field_6a3b07d706af2'),(208241,2762,'issues_items_1_issues_item_txt','Community housing works. We’re calling on the next NSW Government for three actions: long-term investment for new community housing, more funding to future-proof existing homes, and support to help people stayed housed.'),(208242,2762,'_issues_items_1_issues_item_txt','field_6a3b07fc06af3'),(208243,2762,'issues_items_1_issues_link_text',''),(208244,2762,'_issues_items_1_issues_link_text','field_6a3b080f06af4'),(208245,2762,'issues_items_1_issues_target_url',''),(208246,2762,'_issues_items_1_issues_target_url','field_6a3b082b06af5'),(208247,2762,'issues_items_0_issues_sub_head',''),(208248,2762,'_issues_items_0_issues_sub_head','field_6a3b0aa79365e'),(208249,2762,'issues_items_1_issues_sub_head',''),(208250,2762,'_issues_items_1_issues_sub_head','field_6a3b0aa79365e'),(208251,2762,'video_head','The people next door'),(208252,2762,'_video_head','field_6a5ff269ef234'),(208253,2762,'video_intro','Nurses. Childcare workers. Single parents. Older Australians who want to stay near the people they love. Community housing is the solution.'),(208254,2762,'_video_intro','field_6a606161b34b6'),(208255,2762,'hm_hero_title_sm','because we all deserve a safe, secure and affordable home'),(208256,2762,'_hm_hero_title_sm','field_6a607121b523f'),(208259,2763,'footnotes',''),(208261,2763,'banner_head',''),(208262,2763,'_banner_head','field_5b568121a8ffe'),(208263,2763,'banner_sub',''),(208264,2763,'_banner_sub','field_5b568139fd366'),(208265,2763,'banner_button','<a class=\"btn btn-home\" style=\"width: 200px;\" href=\"#project\">Sign the petition</a>'),(208266,2763,'_banner_button','field_5b568147fd367'),(208267,2763,'support_section_title','How can Lifestart support you?'),(208268,2763,'_support_section_title','field_5b67c7d060398'),(208269,2763,'support_left_title','Services'),(208270,2763,'_support_left_title','field_5b67c298e7f8f'),(208271,2763,'support_left_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy.'),(208272,2763,'_support_left_cont','field_5b67c5f6e7f91'),(208273,2763,'support_left_button','<a class=\"btn btn-green\" href=\"/services/\">View all services</a>'),(208274,2763,'_support_left_button','field_5b67c60ae7f92'),(208275,2763,'support_ctr_title','Talk to us'),(208276,2763,'_support_ctr_title','field_5b67c62a58af3'),(208277,2763,'support_ctr_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut laoreet.'),(208278,2763,'_support_ctr_cont','field_5b67c63158af4'),(208279,2763,'support_ctr_button','<a class=\"btn btn-orange\" href=\"/supports/\">Find us</a>'),(208280,2763,'_support_ctr_button','field_5b67c63658af5'),(208281,2763,'support_right_title','NDIS Registered provider'),(208282,2763,'_support_right_title','field_5b67c6a38c064'),(208283,2763,'support_right_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut.'),(208284,2763,'_support_right_cont','field_5b67c6c98c065'),(208285,2763,'support_right_button','<a class=\"btn btn-blue\" href=\"#\">Read more</a>'),(208286,2763,'_support_right_button','field_5b67c6dd8c066'),(208287,2763,'first_image_title','Lifestart is about supporting young children'),(208288,2763,'_first_image_title','field_5b67ca606afc4'),(208289,2763,'first_image_cont','from 0-24 years living with disabilities and their familes'),(208290,2763,'_first_image_cont','field_5b67caff6afc5'),(208291,2763,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(208292,2763,'_first_image_button','field_5b67cb0d6afc6'),(208293,2763,'second _image_title','Lifestart is about supporting young children'),(208294,2763,'_second _image_title','field_5b67cb20ddf9a'),(208295,2763,'second_image_cont','from 0-24 years living with disabilities and their familes'),(208296,2763,'_second_image_cont','field_5b67cb24ddf9b'),(208297,2763,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(208298,2763,'_second_image_button','field_5b67cb29ddf9c'),(208299,2763,'second_image_title','Lifestart is about supporting young children'),(208300,2763,'_second_image_title','field_5b67cb20ddf9a'),(208301,2763,'page_col_image','412'),(208302,2763,'_page_col_image','field_5de6546e7c63a'),(208303,2763,'page_col_image_3','437'),(208304,2763,'_page_col_image_3','field_5de6e3998e07e'),(208305,2763,'sec_2_title','Community'),(208306,2763,'_sec_2_title','field_5de6e3ef2798f'),(208307,2763,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(208308,2763,'_sec_2_text','field_5de78dc89e613'),(208309,2763,'sec_3_title','The Project'),(208310,2763,'_sec_3_title','field_5de6e3d37d8da'),(208311,2763,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(208312,2763,'_sec_3_text','field_5de6e4044e5e8'),(208313,2763,'page_col_image_2','436'),(208314,2763,'_page_col_image_2','field_5de6546e7c63a'),(208315,2763,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(208316,2763,'_sec_2_button','field_5de6e58c86706'),(208317,2763,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(208318,2763,'_sec_3_button','field_5de6e5a243c03'),(208319,2763,'page_col_image_4','455'),(208320,2763,'_page_col_image_4','field_5de70801090ce'),(208321,2763,'sec_4_title','Location'),(208322,2763,'_sec_4_title','field_5de7082a12a81'),(208323,2763,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(208324,2763,'_sec_4_text','field_5de7084812a82'),(208325,2763,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(208326,2763,'_sec_4_button','field_5de7085e12a83'),(208327,2763,'news_title','Project updates'),(208328,2763,'_news_title','field_5de78da3aabb9'),(208329,2763,'sec_2_text_copy',''),(208330,2763,'_sec_2_text_copy','field_5de78dc89e613'),(208331,2763,'timeline-title','Timeline'),(208332,2763,'_timeline-title','field_5de78df29e615