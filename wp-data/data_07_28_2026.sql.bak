,1833,'_survey_index_6_survey_icon','field_6294562942237'),(64801,1833,'survey_index_6_survey_title','Energy Management'),(64802,1833,'_survey_index_6_survey_title','field_6294564042238'),(64803,1833,'survey_index_6_survey_url','#'),(64804,1833,'_survey_index_6_survey_url','field_6294564e42239'),(64805,1833,'survey_index_6_survey_url_text','View Results'),(64806,1833,'_survey_index_6_survey_url_text','field_629456584223a'),(64807,1833,'survey_index_7_survey_icon','1493'),(64808,1833,'_survey_index_7_survey_icon','field_6294562942237'),(64809,1833,'survey_index_7_survey_title','Going Off-grid'),(64810,1833,'_survey_index_7_survey_title','field_6294564042238'),(64811,1833,'survey_index_7_survey_url','#'),(64812,1833,'_survey_index_7_survey_url','field_6294564e42239'),(64813,1833,'survey_index_7_survey_url_text','View Results'),(64814,1833,'_survey_index_7_survey_url_text','field_629456584223a'),(64815,1833,'survey_index','8'),(64816,1833,'_survey_index','field_6294561242236'),(64817,1833,'report_title','Download the report'),(64818,1833,'_report_title','field_62f30edfb57e1'),(64819,1833,'report_intro','Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus massa erat, consectetur at semper at, feugiat vel orci. '),(64820,1833,'_report_intro','field_62f30eedb57e2'),(64821,1833,'report_link_url','#'),(64822,1833,'_report_link_url','field_62f30ef4b57e3'),(64823,1833,'report_link_text','Download'),(64824,1833,'_report_link_text','field_62f30f01b57e4'),(64825,1833,'solutions_content','The housing system is complex, and no one solution will solve the complex problems we now face but there are some critical first steps to be taken now.\r\n<ul>\r\n 	<li>Set out an ambitious national housing agreement between commonwealth and state governments with targets and funding for the construction of affordable homes.</li>\r\n 	<li>Phase out tax breaks for property investors and using the increase in revenue to build more public housing.</li>\r\n 	<li>Establish laws which limit rental increases beyond what is fair.</li>\r\n 	<li>Rebalance tenancy laws to provide renters with more security and control, such as eliminating no grounds evictions.</li>\r\n 	<li>Phase out stamp duty and replace it with a broad-based land tax.</li>\r\n</ul>\r\n<h4>While there are many opinions on what policy changes will fix the housing market, doing nothing is not an option.</h4>'),(64826,1833,'_solutions_content','field_640e8b307a958'),(64827,1833,'problem_icons_0_prob_icon','1699'),(64828,1833,'_problem_icons_0_prob_icon','field_640fa0291d519'),(64829,1833,'problem_icons_0_prob_concerned_stat','70% highly concerned'),(64830,1833,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(64831,1833,'problem_icons_0_prob_concerded_text','are highly concerned'),(64832,1833,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(64833,1833,'problem_icons_0_prob_issue_text',''),(64834,1833,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(64835,1833,'problem_icons','4'),(64836,1833,'_problem_icons','field_640fa0191d518'),(64837,1833,'ceh_content_left',''),(64838,1833,'_ceh_content_left','field_640e97e8f1c8c'),(64839,1833,'ceh_content_right',''),(64840,1833,'_ceh_content_right','field_640e97fdf1c8d'),(64841,1833,'pc_content_left',''),(64842,1833,'_pc_content_left','field_640e983bf1c8f'),(64843,1833,'pc_content_right',''),(64844,1833,'_pc_content_right','field_640e984df1c90'),(64845,1833,'problem_icons_1_prob_icon','1699'),(64846,1833,'_problem_icons_1_prob_icon','field_640fa0291d519'),(64847,1833,'problem_icons_1_prob_concerned_stat','69% highly concerned'),(64848,1833,'_problem_icons_1_prob_concerned_stat','field_640fa0dd81d95'),(64849,1833,'problem_icons_1_prob_concerded_text','are highly concerned'),(64850,1833,'_problem_icons_1_prob_concerded_text','field_640fa10181d96'),(64851,1833,'problem_icons_1_prob_issue_text',''),(64852,1833,'_problem_icons_1_prob_issue_text','field_640fa11a81d97'),(64853,1833,'problem_icons_2_prob_icon','1699'),(64854,1833,'_problem_icons_2_prob_icon','field_640fa0291d519'),(64855,1833,'problem_icons_2_prob_concerned_stat','64% highly concerned'),(64856,1833,'_problem_icons_2_prob_concerned_stat','field_640fa0dd81d95'),(64857,1833,'problem_icons_2_prob_concerded_text','are highly concerned'),(64858,1833,'_problem_icons_2_prob_concerded_text','field_640fa10181d96'),(64859,1833,'problem_icons_2_prob_issue_text',''),(64860,1833,'_problem_icons_2_prob_issue_text','field_640fa11a81d97'),(64861,1833,'problem_icons_3_prob_icon','1699'),(64862,1833,'_problem_icons_3_prob_icon','field_640fa0291d519'),(64863,1833,'problem_icons_3_prob_concerned_stat','64% highly concerned'),(64864,1833,'_problem_icons_3_prob_concerned_stat','field_640fa0dd81d95'),(64865,1833,'problem_icons_3_prob_concerded_text','are highly concerned'),(64866,1833,'_problem_icons_3_prob_concerded_text','field_640fa10181d96'),(64867,1833,'problem_icons_3_prob_issue_text',''),(64868,1833,'_problem_icons_3_prob_issue_text','field_640fa11a81d97'),(64869,1833,'problem_icons_0_prob_concerned_text','House prices have doubled in a decade'),(64870,1833,'_problem_icons_0_prob_concerned_text','field_640fa10181d96'),(64871,1833,'problem_icons_1_prob_concerned_text','The gap between rich and poor is growing'),(64872,1833,'_problem_icons_1_prob_concerned_text','field_640fa10181d96'),(64873,1833,'problem_icons_2_prob_concerned_text','Construction of social housing is down'),(64874,1833,'_problem_icons_2_prob_concerned_text','field_640fa10181d96'),(64875,1833,'problem_icons_3_prob_concerned_text','Banks are making more than ever from housing'),(64876,1833,'_problem_icons_3_prob_concerned_text','field_640fa10181d96'),(64877,1833,'monitor_content','The Australian Housing Monitor is a large, nationally-representative survey covering public experiences and attitudes toward housing related issues. Questions range from how well the respondent is keeping up with their mortgage/rent, to what they think about social housing construction.\r\n\r\nA broad range of demographic criteria are included, such as gender, location, age, income, voting preference, educational level, tenure type, and employment status. These variables allow CEH researchers to understand the trends and diversity of opinion around the country.\r\n\r\nIt also incorporates questions from previous surveys to track trends over time.\r\nThe inaugural poll was conducted by Essential in December 2022, and was completed by 4,735 people.'),(64878,1833,'_monitor_content','field_640fcc4014404'),(64879,1833,'problem_head','Housing in Australia is not working, and Australians are concerned.'),(64880,1833,'_problem_head','field_641935436aded'),(64881,1833,'problem_signoff','Explore the research showing how concerned Australians are our about the housing situation.'),(64882,1833,'_problem_signoff','field_641935626adee'),(64883,1833,'sections','a:2:{i:0;s:4:\"hero\";i:1;s:9:\"news_grid\";}'),(64884,1833,'_sections','field_5dafb40b8143a'),(64885,1833,'sections_0_is_full_height','1'),(64886,1833,'_sections_0_is_full_height','field_61d6f6fd5a37e'),(64887,1833,'sections_0_image','1648'),(64888,1833,'_sections_0_image','field_61d6f6d45a37d'),(64889,1833,'sections_0_heading','Heading'),(64890,1833,'_sections_0_heading','field_61d6f69e5a379'),(64891,1833,'sections_0_subtitle','Ya ya '),(64892,1833,'_sections_0_subtitle','field_61d6f6ac5a37a'),(64893,1833,'sections_0_link_one',''),(64894,1833,'_sections_0_link_one','field_61d6f6b55a37b'),(64895,1833,'sections_0_link_two',''),(64896,1833,'_sections_0_link_two','field_61d6f6c35a37c'),(64897,1833,'sections_1_select_categories','a:1:{i:0;s:2:\"27\";}'),(64898,1833,'_sections_1_select_categories','field_637f04483b63b'),(64899,1833,'intro_head_major','Queenslanders are known for both our love of the great outdoors and our state pride…'),(64900,1833,'_intro_head_major','field_64e828783ad9f'),(64901,1833,'intro_head_minor','But there’s a few things you might not know about our beautiful state.'),(64902,1833,'_intro_head_minor','field_64e8288c3ada0'),(64903,1833,'intro_icons_0_int_icon','1806'),(64904,1833,'_intro_icons_0_int_icon','field_64e828b33ada2'),(64905,1833,'intro_icons_0_int_icon_text','At 1,727,000 square kilometres, we’re 2.5 times the size of Texas. <span>Yeeha!</span>'),(64906,1833,'_intro_icons_0_int_icon_text','field_64e828e33ada3'),(64907,1833,'intro_icons_1_int_icon','1806'),(64908,1833,'_intro_icons_1_int_icon','field_64e828b33ada2'),(64909,1833,'intro_icons_1_int_icon_text','We have twice as many species of native plant and animal as any other Australian state or territory.'),(64910,1833,'_intro_icons_1_int_icon_text','field_64e828e33ada3'),(64911,1833,'intro_icons_2_int_icon','1806'),(64912,1833,'_intro_icons_2_int_icon','field_64e828b33ada2'),(64913,1833,'intro_icons_2_int_icon_text','We have less land classified as ‘protected’ than any other state or territory.'),(64914,1833,'_intro_icons_2_int_icon_text','field_64e828e33ada3'),(64915,1833,'intro_icons','3'),(64916,1833,'_intro_icons','field_64e828963ada1'),(64917,1833,'threat_head_major','What we stand to lose if we don’t act soon to protect beautiful Queensland:'),(64918,1833,'_threat_head_major','field_64ec258d9dbd1'),(64919,1833,'threats_icons','3'),(64920,1833,'_threats_icons','field_64ec2551a93f9'),(64921,1833,'threats_icons_0_thr_icon','1819'),(64922,1833,'_threats_icons_0_thr_icon','field_64ec2551a93fa'),(64923,1833,'threats_icons_0_thr_icon_text','The rich cultural heritage of our First Nations people and their continuous ties to country, dating back more than 50,000 years.'),(64924,1833,'_threats_icons_0_thr_icon_text','field_64ec2551a93fb'),(64925,1833,'threats_icons_1_thr_icon','1819'),(64926,1833,'_threats_icons_1_thr_icon','field_64ec2551a93fa'),(64927,1833,'threats_icons_1_thr_icon_text','Thousands of species of plant and animal which are now classified as threatened or endangered in Queensland.'),(64928,1833,'_threats_icons_1_thr_icon_text','field_64ec2551a93fb'),(64929,1833,'threats_icon