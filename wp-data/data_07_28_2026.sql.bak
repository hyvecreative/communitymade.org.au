_button','field_5b67c6dd8c066'),(91180,1940,'first_image_title','Lifestart is about supporting young children'),(91181,1940,'_first_image_title','field_5b67ca606afc4'),(91182,1940,'first_image_cont','from 0-24 years living with disabilities and their familes'),(91183,1940,'_first_image_cont','field_5b67caff6afc5'),(91184,1940,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(91185,1940,'_first_image_button','field_5b67cb0d6afc6'),(91186,1940,'second _image_title','Lifestart is about supporting young children'),(91187,1940,'_second _image_title','field_5b67cb20ddf9a'),(91188,1940,'second_image_cont','from 0-24 years living with disabilities and their familes'),(91189,1940,'_second_image_cont','field_5b67cb24ddf9b'),(91190,1940,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(91191,1940,'_second_image_button','field_5b67cb29ddf9c'),(91192,1940,'second_image_title','Lifestart is about supporting young children'),(91193,1940,'_second_image_title','field_5b67cb20ddf9a'),(91194,1940,'page_col_image','412'),(91195,1940,'_page_col_image','field_5de6546e7c63a'),(91196,1940,'page_col_image_3','437'),(91197,1940,'_page_col_image_3','field_5de6e3998e07e'),(91198,1940,'sec_2_title','Community'),(91199,1940,'_sec_2_title','field_5de6e3ef2798f'),(91200,1940,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(91201,1940,'_sec_2_text','field_5de78dc89e613'),(91202,1940,'sec_3_title','The Project'),(91203,1940,'_sec_3_title','field_5de6e3d37d8da'),(91204,1940,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(91205,1940,'_sec_3_text','field_5de6e4044e5e8'),(91206,1940,'page_col_image_2','436'),(91207,1940,'_page_col_image_2','field_5de6546e7c63a'),(91208,1940,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(91209,1940,'_sec_2_button','field_5de6e58c86706'),(91210,1940,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(91211,1940,'_sec_3_button','field_5de6e5a243c03'),(91212,1940,'page_col_image_4','455'),(91213,1940,'_page_col_image_4','field_5de70801090ce'),(91214,1940,'sec_4_title','Location'),(91215,1940,'_sec_4_title','field_5de7082a12a81'),(91216,1940,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(91217,1940,'_sec_4_text','field_5de7084812a82'),(91218,1940,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(91219,1940,'_sec_4_button','field_5de7085e12a83'),(91220,1940,'news_title','Project updates'),(91221,1940,'_news_title','field_5de78da3aabb9'),(91222,1940,'sec_2_text_copy',''),(91223,1940,'_sec_2_text_copy','field_5de78dc89e613'),(91224,1940,'timeline-title','Timeline'),(91225,1940,'_timeline-title','field_5de78df29e615'),(91226,1940,'timeline_title','Timeline'),(91227,1940,'_timeline_title','field_5de78df29e615'),(91228,1940,'contact_title','Contact us'),(91229,1940,'_contact_title','field_5de7981e06057'),(91230,1940,'contact_intro','Contact text...'),(91231,1940,'_contact_intro','field_5de7983506058'),(91232,1940,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(91233,1940