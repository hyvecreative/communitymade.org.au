ght_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut.'),(196266,2720,'_support_right_cont','field_5b67c6c98c065'),(196267,2720,'support_right_button','<a class=\"btn btn-blue\" href=\"#\">Read more</a>'),(196268,2720,'_support_right_button','field_5b67c6dd8c066'),(196269,2720,'first_image_title','Lifestart is about supporting young children'),(196270,2720,'_first_image_title','field_5b67ca606afc4'),(196271,2720,'first_image_cont','from 0-24 years living with disabilities and their familes'),(196272,2720,'_first_image_cont','field_5b67caff6afc5'),(196273,2720,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(196274,2720,'_first_image_button','field_5b67cb0d6afc6'),(196275,2720,'second _image_title','Lifestart is about supporting young children'),(196276,2720,'_second _image_title','field_5b67cb20ddf9a'),(196277,2720,'second_image_cont','from 0-24 years living with disabilities and their familes'),(196278,2720,'_second_image_cont','field_5b67cb24ddf9b'),(196279,2720,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(196280,2720,'_second_image_button','field_5b67cb29ddf9c'),(196281,2720,'second_image_title','Lifestart is about supporting young children'),(196282,2720,'_second_image_title','field_5b67cb20ddf9a'),(196283,2720,'page_col_image','412'),(196284,2720,'_page_col_image','field_5de6546e7c63a'),(196285,2720,'page_col_image_3','437'),(196286,2720,'_page_col_image_3','field_5de6e3998e07e'),(196287,2720,'sec_2_title','Community'),(196288,2720,'_sec_2_title','field_5de6e3ef2798f'),(196289,2720,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(196290,2720,'_sec_2_text','field_5de78dc89e613'),(196291,2720,'sec_3_title','The Project'),(196292,2720,'_sec_3_title','field_5de6e3d37d8da'),(196293,2720,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(196294,2720,'_sec_3_text','field_5de6e4044e5e8'),(196295,2720,'page_col_image_2','436'),(196296,2720,'_page_col_image_2','field_5de6546e7c63a'),(196297,2720,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(196298,2720,'_sec_2_button','field_5de6e58c86706'),(196299,2720,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(196300,2720,'_sec_3_button','field_5de6e5a243c03'),(196301,2720,'page_col_image_4','455'),(196302,2720,'_page_col_image_4','field_5de70801090ce'),(196303,2720,'sec_4_title','Location'),(196304,2720,'_sec_4_title','field_5de7082a12a81'),(196305,2720,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(196306,2720,'_sec_4_text','field_5de7084812a82'),(196307,2720,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(196308,2720,'_sec_4_button','field_5de7085e12a83'),(196309,2720,'news_title','Project updates'),(196310,2720,'_news_title','field_5de78da3aabb9'),(196311,2720,'sec_2_text_copy',''),(196312,2720,'_sec_2_text_copy','field_5de78dc89e613'),(196313,2720,'timeline-title','Timeline'),(196314,2720,'_timeline-title','field_5de78df29e615'),(196315,2720,'timeline_title','Timeline'),(196316,2720,'_timelin