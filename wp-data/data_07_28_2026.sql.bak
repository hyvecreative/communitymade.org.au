049,1951,'_survey_index_7_survey_icon','field_6294562942237'),(95050,1951,'survey_index_7_survey_title','Going Off-grid'),(95051,1951,'_survey_index_7_survey_title','field_6294564042238'),(95052,1951,'survey_index_7_survey_url','#'),(95053,1951,'_survey_index_7_survey_url','field_6294564e42239'),(95054,1951,'survey_index_7_survey_url_text','View Results'),(95055,1951,'_survey_index_7_survey_url_text','field_629456584223a'),(95056,1951,'survey_index','8'),(95057,1951,'_survey_index','field_6294561242236'),(95058,1951,'report_title','Download the report'),(95059,1951,'_report_title','field_62f30edfb57e1'),(95060,1951,'report_intro','Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus massa erat, consectetur at semper at, feugiat vel orci. '),(95061,1951,'_report_intro','field_62f30eedb57e2'),(95062,1951,'report_link_url','#'),(95063,1951,'_report_link_url','field_62f30ef4b57e3'),(95064,1951,'report_link_text','Download'),(95065,1951,'_report_link_text','field_62f30f01b57e4'),(95066,1951,'solutions_content','The housing system is complex, and no one solution will solve the complex problems we now face but there are some critical first steps to be taken now.\r\n<ul>\r\n 	<li>Set out an ambitious national housing agreement between commonwealth and state governments with targets and funding for the construction of affordable homes.</li>\r\n 	<li>Phase out tax breaks for property investors and using the increase in revenue to build more public housing.</li>\r\n 	<li>Establish laws which limit rental increases beyond what is fair.</li>\r\n 	<li>Rebalance tenancy laws to provide renters with more security and control, such as eliminating no grounds evictions.</li>\r\n 	<li>Phase out stamp duty and replace it with a broad-based land tax.</li>\r\n</ul>\r\n<h4>While there are many opinions on what policy changes will fix the housing market, doing nothing is not an option.</h4>'),(95067,1951,'_solutions_content','field_640e8b307a958'),(95068,1951,'problem_icons_0_prob_icon','1699'),(95069,1951,'_problem_icons_0_prob_icon','field_640fa0291d519'),(95070,1951,'problem_icons_0_prob_concerned_stat','70% highly concerned'),(95071,1951,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(95072,1951,'problem_icons_0_prob_concerded_text','are highly concerned'),(95073,1951,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(95074,1951,'problem_icons_0_prob_issue_text',''),(95075,1951,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(95076,1951,'problem_icons','4'),(95077,1951,'_problem_icons','field_640fa0191d518'),(95078,1951,'ceh_content_left',''),(95079,1951,'_ceh_content_left','field_640e97e8f1c8c'),(95080,1951,'ceh_content_right',''),(95081,1951,'_ceh_content_right','field_640e97fdf1c8d'),(95082,1951,'pc_content_left',''),(95083,1951,'_pc_content_left','field_640e983bf1c8f'),(95084,1951,'pc_content_right',''),(95085,1951,'_pc_content_right','field_640e984df1c90'),(95086,1951,'problem_icons_1_prob_icon','1699'),(95087,1951,'_problem_icons_1_prob_icon','field_640fa0291d519'),(95088,1951,'problem_icons_1_prob_concerned_stat','69% highly concerned'),(95089,1951,'_problem_icons_1_prob_concerned_stat','field_640fa0dd81d95'),(95090,1951,'problem_icons_1_prob_concerded_text','are highly concerned'),(95091,1951,'_problem_icons_1_prob_concerded_text','field_640fa10181d96'),(95092,1951,'problem_icons_1_prob_issue_text',''),(95093,1951,'_problem_icons_1_prob_issue_text','field_640fa11a81d97'),(95094,1951,'problem_icons_2_prob_icon','1699'),(95095,1951,'_problem_icons_2_prob_icon','field_640fa0291d519'),(95096,1951,'problem_icons_2_prob_concerned_stat','64% highly concerned'),(95097,1951,'_problem_icons_2_prob_concerned_stat','field_640fa0dd81d95'),(95098,1951,'problem_icons_2_prob_concerded_text','are highly concerned'),(95099,1951,'_problem_icons_2_prob_concerded_text','field_640fa10181d96'),(95100,1951,'problem_icons_2_prob_issue_text',''),(95101,1951,'_problem_icons_2_prob_issue_text','field_640fa11a81d97'),(95102,1951,'problem_icons_3_prob_icon','1699'),(95103,1951,'_problem_icons_3_prob_icon','field_640fa0291d519'),(95104,1951,'problem_icons_3_prob_concerned_stat','64% highly concerned'),(95105,1951,'_problem_icons_3_prob_concerned_stat','field_640fa0dd81d95'),(95106,1951,'problem_icons_3_prob_concerded_text','are highly concerned'),(95107,1951,'_problem_icons_3_prob_concerded_text','field_640fa10181d96'),(95108,1951,'problem_icons_3_prob_issue_text',''),(95109,1951,'_problem_icons_3_prob_issue_text','field_640fa11a81d97'),(95110,1951,'problem_icons_0_prob_concerned_text','House prices have doubled in a decade'),(95111,1951,'_problem_icons_0_prob_concerned_text','field_640fa10181d96'),(95112,1951,'problem_icons_1_prob_concerned_text','The gap between rich and poor is growing'),(95113,1951,'_problem_icons_1_prob_concerned_text','field_640fa10181d96'),(95114,1951,'problem_icons_2_prob_concerned_text','Construction of social housing is down'),(95115,1951,'_problem_icons_2_prob_concerned_text','field_640fa10181d96'),(95116,1951,'problem_icons_3_prob_concerned_text','Banks are making more than ever from housing'),(95117,1951,'_problem_icons_3_prob_concerned_text','field_640fa10181d96'),(95118,1951,'monitor_content','The Australian Housing Monitor is a large, nationally-representative survey covering public experiences and attitudes toward housing related issues. Questions range from how well the respondent is keeping up with their mortgage/rent, to what they think about social housing construction.\r\n\r\nA broad range of demographic criteria are included, such as gender, location, age, income, voting preference, educational level, tenure type, and employment status. These variables allow CEH researchers to understand the trends and diversity of opinion around the country.\r\n\r\nIt also incorporates questions from previous surveys to track trends over time.\r\nThe inaugural poll was conducted by Essential in December 2022, and was completed by 4,735 people.'),(95119,1951,'_monitor_content','field_640fcc4014404'),(95120,1951,'problem_head','Housing in Australia is not working, and Australians are concerned.'),(95121,1951,'_problem_head','field_641935436aded'),(95122,1951,'problem_signoff','Explore the research showing how concerned Australians are our about the housing situation.'),(95123,1951,'_problem_signoff','field_641935626adee'),(95124,1951,'sections','a:2:{i:0;s:4:\"hero\";i:1;s:9:\"news_grid\";}'),(95125,1951,'_sections','field_5dafb40b8143a'),(95127,1951,'sections_0_is_full_height','1'),(95128,1951,'_sections_0_is_full_height','field_61d6f6fd5a37e'),(95129,1951,'sections_0_image','1648'),(95130,1951,'_sections_0_image','field_61d6f6d45a37d'),(95131,1951,'sections_0_heading','Heading'),(95132,1951,'_sections_0_heading','field_61d6f69e5a379'),(95133,1951,'sections_0_subtitle','Ya ya '),(95134,1951,'_sections_0_subtitle','field_61d6f6ac5a37a'),(95135,1951,'sections_0_link_one',''),(95136,1951,'_sections_0_link_one','field_61d6f6b55a37b'),(95137,1951,'sections_0_link_two',''),(95138,1951,'_sections_0_link_two','field_61d6f6c35a37c'),(95139,1951,'sections_1_select_categories','a:1:{i:0;s:2:\"27\";}'),(95140,1951,'_sections_1_select_categories','field_637f04483b63b'),(95141,1951,'_thumbnail_id','1947'),(95142,1951,'intro_head_major','Super Consumers Australia is <span>fighting</span> to ensure that the superannuation industry is <span>held accountable</span> for the outcomes they deliver to Australian consumers.'),(95143,1951,'_intro_head_major','field_64e828783ad9f'),(95144,1951,'intro_head_minor','We want super to work for everyone—not just super fund companies. With our research, journalism and campaigns we are creating the trustworthy and transparent superannuation system we all deserve.'),(95145,1951,'_intro_head_minor','field_64e8288c3ada0'),(95146,1951,'intro_icons_0_int_icon','1922'),(95147,1951,'_intro_icons_0_int_icon','field_64e828b33ada2'),(95148,1951,'intro_icons_0_int_icon_text','At 1,727,000 square kilometres, we’re 2.5 times the size of Texas. <span>Yeeha!</span>'),(95149,1951,'_intro_icons_0_int_icon_text','field_64e828e33ada3'),(95150,1951,'intro_icons_1_int_icon','1920'),(95151,1951,'_intro_icons_1_int_icon','field_64e828b33ada2'),(95152,1951,'intro_icons_1_int_icon_text','We have twice as many species of native plant and animal as any other Australian state or territory.'),(95153,1951,'_intro_icons_1_int_icon_text','field_64e828e33ada3'),(95154,1951,'intro_icons_2_int_icon','1921'),(95155,1951,'_intro_icons_2_int_icon','field_64e828b33ada2'),(95156,1951,'intro_icons_2_int_icon_text','We have less land classified as ‘protected’ than any other state or territory.'),(95157,1951,'_intro_icons_2_int_icon_text','field_64e828e33ada3'),(95158,1951,'intro_icons','3'),(95159,1951,'_intro_icons','field_64e828963ada1'),(95160,1951,'threat_head_major','What we stand to lose if we don’t act soon to protect beautiful Queensland:'),(95161,1951,'_threat_head_major','field_64ec258d9dbd1'),(95162,1951,'threats_icons','3'),(95163,1951,'_threats_icons','field_64ec2551a93f9'),(95164,1951,'threats_icons_0_thr_icon','1819'),(95165,1951,'_threats_icons_0_thr_icon','field_64ec2551a93fa'),(95166,1951,'threats_icons_0_thr_icon_text','The rich cultural heritage of our First Nations people and their continuous ties to country, dating back more than 50,000 years.'),(95167,1951,'_threats_icons_0_thr_icon_text','field_64ec2551a93fb'),(95168,1951,'threats_icons_1_thr_icon','1819'),(95169,1951,'_threats_icons_1_thr_icon','field_64ec2551a93fa'),(95170,1951,'threats_icons_1_thr_icon_text','Thousands of species of plant and animal which are now classified as threatened or endangered in Queensland.'),(95171,1951,'_threats_icons_1_thr_icon_text','field_64ec2551a93fb'),(95172,1951,'threats_icons_2_thr_icon','1819'),(95173,1951,'_threats_icons_2_thr_icon','field_64ec2551a93fa'),(95174,1951,'threats_icons_2_thr_icon_text','The access to nature that is central to the Queensland way of life.'),(95175,1951,'_threats