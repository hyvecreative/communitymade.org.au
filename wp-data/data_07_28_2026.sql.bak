\"delay\";i:0;s:15:\"parent_repeater\";s:19:\"field_62b2730c06cbd\";}','Question Content','question_content','publish','closed','closed','','field_62b2736b06cbf','','','2023-03-01 04:30:48','2023-03-01 04:30:48','',1630,'http://localhost/?post_type=acf-field&p=1632',1,'acf-field','',0),(1633,1,'2023-03-01 04:31:58','2023-03-01 04:31:58','a:8:{s:10:\"aria-label\";s:0:\"\";s:4:\"type\";s:3:\"tab\";s:12:\"instructions\";s:0:\"\";s:8:\"required\";i:0;s:17:\"conditional_logic\";i:0;s:7:\"wrapper\";a:3:{s:5:\"width\";s:0:\"\";s:5:\"class\";s:0:\"\";s:2:\"id\";s:0:\"\";}s:9:\"placement\";s:3:\"top\";s:8:\"endpoint\";i:0;}','Main Accordion question title','main_accordion_question_title','publish','closed','closed','','field_63fed5288ce12','','','2023-03-01 04:32:22','2023-03-01 04:32:22','',1618,'http://localhost/?post_type=acf-field&#038;p=1633',0,'acf-field','',0),(1634,1,'2023-03-01 04:32:44','2023-03-01 04:32:44','a:8:{s:10:\"aria-label\";s:0:\"\";s:4:\"type\";s:3:\"tab\";s:12:\"instructions\";s:0:\"\";s:8:\"required\";i:0;s:17:\"conditional_logic\";i:0;s:7:\"wrapper\";a:3:{s:5:\"width\";s:0:\"\";s:5:\"class\";s:0:\"\";s:2:\"id\";s:0:\"\";}s:9:\"placement\";s:3:\"top\";s:8:\"endpoint\";i:0;}','Question Results content','_question_results_content','publish','closed','closed','','field_63fed55e44557','','','2023-03-01 04:33:00','2023-03-01 04:33:00','',1618,'http://localhost/?post_type=acf-field&#038;p=1634',3,'acf-field','',0),(1635,1,'2023-03-01 04:38:18','2023-03-01 04:38:18','<!-- wp:paragraph -->\n<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus massa erat, consectetur at semper at, feugiat vel orci. Quisque consectetur egestas placerat. Mauris in nibh leo. Aliquam aliquet ut lectus ac aliquet. Sed id dignissim sapien. Integer vehicula, ligula dapibus vehicula varius, libero massa scelerisque ipsum, sed interdum ligula nisl et arcu. Quisque sed eros metus.</p>\n<!-- /wp:paragraph -->','Home','','inherit','closed','closed','','6-revision-v1','',''