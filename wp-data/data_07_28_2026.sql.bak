181627,2671,'_intro_boxes_0_box_dropdown','field_65262dead0a0c'),(181628,2671,'intro_boxes_1_box_icon','1941'),(181629,2671,'_intro_boxes_1_box_icon','field_65262db5d36ee'),(181630,2671,'intro_boxes_1_box_title','Projects'),(181631,2671,'_intro_boxes_1_box_title','field_65262d29ed8e3'),(181632,2671,'intro_boxes_1_box_dropdown','Our rigorous, conflict-free research and data analysis lifts the lid on fund performance, fees and insurance. Drawing on our policy expertise, we turn this analysis into action by using it to back reform and make super easier for people to understand. <a href=\"//localhost:4000:4000:4000:4000:4000:4000:/how/\">More</a>'),(181633,2671,'_intro_boxes_1_box_dropdown','field_65262dead0a0c'),(181634,2671,'intro_boxes_2_box_icon','1937'),(181635,2671,'_intro_boxes_2_box_icon','field_65262db5d36ee'),(181636,2671,'intro_boxes_2_box_title','Ideas'),(181637,2671,'_intro_boxes_2_box_title','field_65262d29ed8e3'),(181638,2671,'intro_boxes_2_box_dropdown','Our rigorous, conflict-free research and data analysis lifts the lid on fund performance, fees and insurance. Drawing on our policy expertise, we turn this analysis into action by using it to back reform and make super easier for people to understand. <a href=\"//localhost:4000:4000:4000:4000:4000:4000:/how/\">More</a>'),(181639,2671,'_intro_boxes_2_box_dropdown','field_65262dead0a0c'),(181640,2671,'intro_boxes','3'),(181641,2671,'_intro_boxes','field_65262d14ed8e2'),(181642,2671,'get_help_section_title','Get Help'),(181643,2671,'_get_help_section_title','field_65262c35143de'),(181644,2671,'get_help_block_home',''),(181645,2671,'_get_help_block_home','field_65262c8a143e1'),(181646,2671,'gh_block_home_0_help_image','1956'),(181647,2671,'_gh_block_home_0_help_image','field_65262cd0143e2'),(181648,2671,'gh_block_home_0_help_title','How much do I need to retire? '),(181649,2671,'_gh_block_home_0_help_title','field_65262cec143e3'),(181650,2671,'gh_block_home_0_help_url','#'),(181651,2671,'_gh_block_home_0_help_url','field_65262cf4143e4'),(181652,2671,'gh_block_home_1_help_image','1962'),(181653,2671,'_gh_block_home_1_help_image','field_65262cd0143e2'),(181654,2671,'gh_block_home_1_help_title','I have a problem with  my super fund'),(181655,2671,'_gh_block_home_1_help_title','field_65262cec143e3'),(181656,2671,'gh_block_home_1_help_url','#'),(181657,2671,'_gh_block_home_1_help_url','field_65262cf4143e4'),(181658,2671,'gh_block_home_2_help_image','1961'),(181659,2671,'_gh_block_home_2_help_image','field_65262cd0143e2'),(181660,2671,'gh_block_home_2_help_title','How do I choose the right super? '),(181661,2671,'_gh_block_home_2_help_title','field_65262cec143e3'),(181662,2671,'gh_block_home_2_help_url','#'),(181663,2671,'_gh_block_home_2_help_url','field_65262cf4143e4'),(181664,2671,'gh_block_home','3'),(181665,2671,'_gh_block_home','field_65262c8a143e1'),(181666,2671,'turn_on_insights',''),(181667,2671,'_turn_on_insights','field_645c4a2e654a6'),(181668,2671,'report_questions','a:3:{i:0;s:2:\"59\";i:1;s:2:\"61\";i:2;s:4:\"2587\";}'),(181669,2671,'_report_questions','field_6109ed5e02e5a'),(181670,2671,'intro_text','The Disability Dialogue is a place where people with disabilities, their families, organisations providing support, academics, and the wider community come together to work on things that matter to us.\r\n\r\nThe Dialogue is a hub of knowledge and collaboration, separate from government, where we work together to come up. With new ideas on important topics. Our ideas can make a big difference in how services and systems are set up for people with disabilities.'),(181671,2671,'_intro_text','field_66441acfe963c'),(181672,2671,'word_link','#'),(181673,2671,'_word_link','field_6646c69723804'),(181674,2671,'pdf_link','#'),(181675,2671,'_pdf_link','field_6646c6da23805'),(181676,2671,'intro_boxes_0_box_image','2241'),(181677,2671,'_intro_boxes_0_box_image','field_65262db5d36ee'),(181678,2671,'intro_boxes_1_box_image','2179'),(181679,2671,'_intro_boxes_1_box_image','field_65262db5d36ee'),(181680,2671,'intro_boxes_2_box_image','2012'),(181681,2671,'_intro_boxes_2_box_image','field_65262db5d36ee'),(181682,2671,'intro_boxes_0_box_excerpt','Excerpt text here just a sentance or so and no more.'),(181683,2671,'_intro_boxes_0_box_excerpt','field_665975273e827'),(181684,2671,'intro_boxes_1_box_excerpt','Excerpt text here just a sentance or so and no more.'),(181685,2671,'_intro_boxes_1_box_excerpt','field_665975273e827'),(181686,2671,'intro_boxes_2_box_excerpt','Excerpt text here just a sentance or so and no more.'),(181687,2671,'_intro_boxes_2_box_excerpt','field_665975273e827'),(181688,2671,'intro_boxes_0_btn-text','Latest events'),(181689,2671,'_intro_boxes_0_btn-text','field_665abda8b8d4b'),(181690,2671,'intro_boxes_1_btn-text','Latest projects'),(181691,2671,'_intro_boxes_1_btn-text','field_665abda8b8d4b'),(181692,2671,'intro_boxes_2_btn-text','Latest ideas'),(181693,2671,'_intro_boxes_2_btn-text','field_665abda8b8d4b'),(181694,2671,'display-easy-read',''),(181695,2671,'_display-easy-read','field_666129bd2da00'),(181696,2671,'hm_hero_sum','Statement about the issue and lost life savings'),(181697,2671,'_hm_hero_sum','field_64ed37241effa'),(181698,2671,'hm_hero_sub','By investing in the Shield and First Guardian master funds'),(181699,2671,'_hm_hero_sub','field_64ed37241effa'),(181700,2671,'intro_head','We’re here to help.'),(181701,2671,'_intro_head','field_64e828783ad9f'),(181702,2671,'intro_content','About 12,000 people invested their hard-earned super savings in two investment funds which have now collapsed, called Shield Master Fund and First Guardian Master Fund. Most people will be entitled to get some money back, but you need to take action soon. This website has information and tools to help you understand what happened, where to get help and how to take back your super.'),(181703,2671,'_intro_content','field_66441acfe963c'),(181704,2671,'deadline_heading','Important deadlines'),(181705,2671,'_deadline_heading','field_69365ff82e6f2'),(181706,2671,'deadline_content','You need to take action before the deadline to take your super back.'),(181707,2671,'_deadline_content','field_693660342e6f3'),(181708,2671,'deadline_button_text','Find out more'),(181709,2671,'_deadline_button_text','field_693660482e6f4'),(181710,2671,'deadline_button_url','/key-deadlines/'),(181711,2671,'_deadline_button_url','field_693660912e6f5'),(181712,2671,'what_head','What happened?'),(181713,2671,'_what_head','field_69366611096ac'),(181714,2671,'what_happened_0_happ_sub','What are Shield and First Guardian?'),(181715,2671,'_what_happened_0_happ_sub','field_693d4a8b4197d'),(181716,2671,'what_happened_0_happ_content','About 12,000 people invested their hard-earned super savings in two investment funds called Shield Master Fund and First Guardian Master Fund. Those funds have collapsed, and a large part of the $1.2 billion people invested is gone.\r\n\r\nMost people invested through financial advisers who contacted them after they clicked on a social media ad offering a free super comparison or review.'),(181717,2671,'_what_happened_0_happ_content','field_693d4aa84197e'),(181718,2671,'what_happened_0_happ_url','/what-happened/'),(181719,2671,'_what_happened_0_happ_url','field_693d4aba4197f'),(181720,2671,'what_happened_0_happ_link_text','More'),(181721,2671,'_what_happened_0_happ_link_text','field_693d4ad641980'),(181722,2671,'what_happened_1_happ_sub','What is being done about this?'),(181723,2671,'_what_happened_1_happ_sub','field_693d4a8b4197d'),(181724,2671,'what_happened_1_happ_content','There is a lot of work being done to try to get money back for people who invested.\r\n\r\nThe regulator is also investigating what happened and has started enforcement action against a number of different people and companies for their involvement in the collapses of Shield and First Guardian Master Funds. Learn about the progress of this work'),(181725,2671,'_what_happened_1_happ_content','field_693d4aa84197e'),(181726,2671,'what_happened_1_happ_url','/what-happened/'),(181727,2671,'_what_happened_1_happ_url','field_693d4aba4197f'),(181728,2671,'what_happened_1_happ_link_text','More'),(181729,2671,'_what_happened_1_happ_link_text','field_693d4ad641980'),(181730,2671,'what_happened','2'),(181731,2671,'_what_happened','field_693d4a6f4197c'),(181732,2671,'what_happened_0_happ_icon','2605'),(181733,2671,'_what_happened_0_happ_icon','field_693d4c9b3ec4d'),(181734,2671,'what_happened_1_happ_icon','2604'),(181735,2671,'_what_happened_1_happ_icon','field_693d4c9b3ec4d'),(181736,2671,'display_news_section','a:1:{i:0;s:9:\"Show news\";}'),(181737,2671,'_display_news_section','field_69434cc6d5f7d'),(181740,2672,'footnotes',''),(181742,2672,'banner_head',''),(181743,2672,'_banner_head','field_5b568121a8ffe'),(181744,2672,'banner_sub',''),(181745,2672,'_banner_sub','field_5b568139fd366'),(181746,2672,'banner_button','<a class=\"btn btn-home\" style=\"width: 200px;\" href=\"#project\">Sign the petition</a>'),(181747,2672,'_banner_button','field_5b568147fd367'),(181748,2672,'support_section_title','How can Lifestart support you?'),(181749,2672,'_support_section_title','field_5b67c7d060398'),(181750,2672,'support_left_title','Services'),(181751,2672,'_support_left_title','field_5b67c298e7f8f'),(181752,2672,'support_left_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy.'),(181753,2672,'_support_left_cont','field_5b67c5f6e7f91'),(181754,2672,'support_left_button','<a class=\"btn btn-green\" href=\"/services/\">View all services</a>'),(181755,2672,'_support_left_button','field_5b67c60ae7f92'),(181756,2672,'support_ctr_title','Talk to us'),(181757,2672,'_support_ctr_title','field_5b67c62a58af3'),(181758,2672,'support_ctr_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut laoreet.'),(181759,2672,'_support_ctr_cont','field_5b67c63158af4'),(181760,2672,'support_ctr_button','<a class=\"btn btn-orange\" href=\"/supports/\">Find us</a>'),(181761,2672,'_support_ctr_button','field_5b67c63658af5'),(181762,2672,'support_right_title','NDIS Registered provider'),(181763,2672,'_support_right_title','field_5b67c6a38c064'),(181764,2672,'support_right_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut.'),(181765,2672,'_support_right_cont','field_5b67c6c98c065'),(181766,2672,'support_right_button','<a class=\"btn btn-blue\" href=\"#\">Read more</a>'),(181767,2672,'_support_right_button','field_5b67c6dd8c066'),(181768,2672,'first_image_title','Lifestart is about supporting young children'),(181769,2672,'_first_image_title','field_5b67ca606afc4'),(181770,2672,'first_image_cont','from 0-24 years living with disabilities and their familes'),(181771,2672,'_first_image_cont','field_5b67caff6afc5'),(181772,2672,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(181773,2672,'_first_image_button','field_5b67cb0d6afc6'),(181774,2672,'second _image_title','Lifestart is about supporting young children'),(181775,2672,'_second _image_title','field_5b67cb20ddf9a'),(181776,2672,'second_image_cont','from 0-24 years living with disabilities and their familes'),(181777,2672,'_second_image_cont','field_5b67cb24ddf9b'),(181778,2672,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(181779,2672,'_second_image_button','field_5b67cb29ddf9c'),(181780,2672,'second_image_title','Lifestart is about supporting young children'),(181781,2672,'_second_image_title','field_5b67cb20ddf9a'),(181782,2672,'page_col_image','412'),(181783,2672,'_page_col_image','field_5de6546e7c63a'),(181784,2672,'page_col_image_3','437'),(181785,2672,'_page_col_image_3','field_5de6e3998e07e'),(181786,2672,'sec_2_title','Community'),(181787,2672,'_sec_2_title','field_5de6e3ef2798f'),(181788,2672,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(181789,2672,'_sec_2_text','field_5de78dc89e613'),(181790,2672,'sec_3_title','The Project'),(181791,2672,'_sec_3_title','field_5de6e3d37d8da'),(181792,2672,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(181793,2672,'_sec_3_text','field_5de6e4044e5e8'),(181794,2672,'page_col_image_2','436'),(181795,2672,'_page_col_image_2','field_5de6546e7c63a'),(181796,2672,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(181797,2672,'_sec_2_button','field_5de6e58c86706'),(181798,2672,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(181799,2672,'_sec_3_button','field_5de6e5a243c03'),(181800,2672,'page_col_image_4','455'),(181801,2672,'_page_col_image_4','field_5de70801090ce'),(181802,2672,'sec_4_title','Location'),(181803,2672,'_sec_4_title','field_5de7082a12a81'),(181804,2672,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(181805,2672,'_sec_4_text','field_5de7084812a82'),(181806,2672,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(181807,2672,'_sec_4_button','field_5de7085e12a83'),(181808,2672,'news_title','Project updates'),(181809,2672,'_news_title','field_5de78da3aabb9'),(181810,2672,'sec_2_text_copy',''),(