alue\";s:0:\"\";s:4:\"tabs\";s:3:\"all\";s:7:\"toolbar\";s:4:\"full\";s:12:\"media_upload\";i:1;s:5:\"delay\";i:0;}','Action form shortcode','action_form','publish','closed','closed','','field_64f15c5025a76','','','2024-06-06 01:12:07','2024-06-06 01:12:07','',2013,'http://localhost/?post_type=acf-field&#038;p=2017',4,'acf-field','',0),(2018,1,'2023-10-24 05:11:32','2023-10-24 05:11:32','a:11:{s:10:\"aria-label\";s:0:\"\";s:4:\"type\";s:4:\"text\";s:12:\"instructions\";s:0:\"\";s:8:\"required\";i:0;s:17:\"conditional_logic\";i:0;s:7:\"wrapper\";a:3:{s:5:\"width\";s:0:\"\";s:5:\"class\";s:0:\"\";s:2:\"id\";s:0:\"\";}s:13:\"default_value\";s:17:\"Sign the petition\";s:9:\"maxlength\";s:0:\"\";s:11:\"placeholder\";s:0:\"\";s:7:\"prepend\";s:0:\"\";s:6:\"append\";s:0:\"\";}','Action Type','action_type','publish','closed','closed','','field_64f15ce30a8cd','','','2024-06-06 01:12:07','2024-06-06 01:12:07','',2013,'http://localhost/?post_type=acf-field&#038;p=2018',5,'acf-field','',0),(2019,1,'2023-10-24 05:13:08','2023-10-24 05:13:08','<!-- wp:paragraph -->\n<p>Content...</p>\n<!-- /wp:paragraph -->','Your Stories','','inherit','closed','closed','','2009-revision-v1','','','2023-10-24 05:13:08','2023-10-24 05:13:08','',2009,'http://localhost/?p=2019',0,'revision','',0),(2020,1,'2023-10-24 05:13:25','2023-10-24 05:13:25','<!-- wp:paragraph -->\n<p>Content...</p>\n<!-- /wp:paragraph -->','Your Stories','','inherit','closed','closed','','2009-revision-v1','','','2023-10-24 05:13:25','2023-10-24 05:13:25','',2009,'http://localhost/?p=2020',0,'revision','',0),(2021,1,'2023-10-24 05:36:16','2023-10-24 05:36:16','<!-- wp:heading {\"level\":3} -->\n<h3 class=\"wp-block-heading\">We want to hear your stories of navigating Australia’s superannuation system.</h3>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Real-life case studies are invaluable for inclusion in our investigative journalism and our submissions to decision-makers. Together, we can hold the industry accountable and make the superannuation system work for everyone.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>Do you find the superannuation system confusing? Have you got a complaint about your super and found it difficult to get action or answers from your fund? Has your boss ever withheld your super payments? Did you find out that your super account includes unexpected fees or insurance you didn’t ask for? Have you had an insurance claim knocked back by your super fund?</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>Whatever your experience, your story can help us advocate for consumers and create a fairer superannuation system. Fill out the form on this page—it just takes a minute!</p>\n<!-- /wp:paragraph -->','Your Stories','','inherit','closed','closed','','2009-revision-v1','','','2023-10-24 05:36:16','2023-10-24 05:36:16','',2009,'http://localhost/?p=2021',0,'revision','',0),(2027,1,'2023-10-25 00:44:04','2023-10-25 00:44:04','<!-- wp:heading -->\n<h2 class=\"wp-block-heading\"></h2>\n<!-- /wp:heading -->','The board','','publish','closed','closed','','the-board','','','2023-10-25 05:19:42','2023-10-25 05:19:42','',19,'http://localhost/?page_id=2027',0,'page','',0),(2028,1,'2023-10-25 00:44:04','2023-10-25 00:44:04','<!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Heading h2</h2>\n<!-- /wp:heading -->\n\n<!-- wp:paragraph -->\n<p>Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut laoreet dolore magna aliquam erat volutpat. Ut wisi enim ad minim veniam, quis nostrud exerci tation ullamcorper suscipit lobortis nisl ut aliquip ex ea commodo consequat. Duis autem vel eum iriure dolor in hendrerit in vulputate velit esse molestie consequat, vel illum dolore eu feugiat nulla facilisis at vero eros et accumsan et iusto odio dignissim qui blandit prae</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:image {\"id\":1947,\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} -->\n<figure class=\"wp-block-image size-la