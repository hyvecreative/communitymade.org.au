','field_5de6e5a243c03'),(21055,1099,'page_col_image_4','455'),(21056,1099,'_page_col_image_4','field_5de70801090ce'),(21057,1099,'sec_4_title','Location'),(21058,1099,'_sec_4_title','field_5de7082a12a81'),(21059,1099,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(21060,1099,'_sec_4_text','field_5de7084812a82'),(21061,1099,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(21062,1099,'_sec_4_button','field_5de7085e12a83'),(21063,1099,'news_title','Project updates'),(21064,1099,'_news_title','field_5de78da3aabb9'),(21065,1099,'sec_2_text_copy',''),(21066,1099,'_sec_2_text_copy','field_5de78dc89e613'),(21067,1099,'timeline-title','Timeline'),(21068,1099,'_timeline-title','field_5de78df29e615'),(21069,1099,'timeline_title','Timeline'),(21070,1099,'_timeline_title','field_5de78df29e615'),(21071,1099,'contact_title','Contact us'),(21072,1099,'_contact_title','field_5de7981e06057'),(21073,1099,'contact_intro','Contact text...'),(21074,1099,'_contact_intro','field_5de7983506058'),(21075,1099,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(21076,1099,'_news_button','field_5de8329896e02'),(21077,1099,'timeline_intro','Introduction of timeline detail...'),(21078,1099,'_timeline_intro','field_5de98f5fb1781'),(21079,1099,'timeline_pic','477'),(21080,1099,'_timeline_pic','field_5de98f72b1782'),(21081,1099,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(21082,1099,'_timeline_button','field_5de99363677f8'),(21083,1099,'banner_image_position','center'),(21084,1099,'_banner_image_position','field_5f3bc4757dd02'),(21085,1099,'services_title','Our services'),(21086,1099,'_services_title','field_5f20f3cd80eb2'),(21087,1099,'services_items_0_services_item_image','1061'),(21088,1