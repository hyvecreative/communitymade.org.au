934,'problem_icons_3_prob_concerned_text','Banks are making more than ever from housing'),(89659,1934,'_problem_icons_3_prob_concerned_text','field_640fa10181d96'),(89660,1934,'monitor_content','The Australian Housing Monitor is a large, nationally-representative survey covering public experiences and attitudes toward housing related issues. Questions range from how well the respondent is keeping up with their mortgage/rent, to what they think about social housing construction.\r\n\r\nA broad range of demographic criteria are included, such as gender, location, age, income, voting preference, educational level, tenure type, and employment status. These variables allow CEH researchers to understand the trends and diversity of opinion around the country.\r\n\r\nIt also incorporates questions from previous surveys to track trends over time.\r\nThe inaugural poll was conducted by Essential in December 2022, and was completed by 4,735 people.'),(89661,1934,'_monitor_content','field_640fcc4014404'),(89662,1934,'problem_head','Housing in Australia is not working, and Australians are concerned.'),(89663,1934,'_problem_head','field_641935436aded'),(89664,1934,'problem_signoff','Explore the research showing how concerned Australians are our about the housing situation.'),(89665,1934,'_problem_signoff','field_641935626adee'),(89666,1934,'sections','a:2:{i:0;s:4:\"hero\";i:1;s:9:\"news_grid\";}'),(89667,1934,'_sections','field_5dafb40b8143a'),(89668,1934,'sections_0_is_full_height','1'),(89669,1934,'_sections_0_is_full_height','field_61d6f6fd5a37e'),(89670,1934,'sections_0_image','1648'),(89671,1934,'_sections_0_image','field_61d6f6d45a37d'),(89672,1934,'sections_0_heading','Heading'),(89673,1934,'_sections_0_heading','field_61d6f69e5a379'),(89674,1934,'sections_0_subtitle','Ya ya '),(89675,1934,'_sections_0_subtitle','field_61d6f6ac5a37a'),(89676,1934,'sections_0_link_one',''),(89677,1934,'_sections_0_link_one','field_61d6f6b55a37b'),(89678,1934,'sections_0_link_two',''),(89679,1934,'_sections_0_link_two','field_61d6f6c35a37c'),(89680,1934,'sections_1_select_categories','a:1:{i:0;s:2:\"27\";}'),(89681,1934,'_sections_1_select_categories','field_637f04483b63b'),(89682,1934,'intro_head_major','Super Consumers Australia is <span>fighting</span> to ensure that the superannuation industry is <span>held accountable</span> for the outcomes they deliver to Australian consumers.'),(89683,1934,'_intro_head_major','field_64e828783ad9f'),(89684,1934,'intro_head_minor','We want super to work for everyone—not just super fund companies. With our research, journalism and campaigns we are creating the trustworthy and transparent superannuation system we all deserve.'),(89685,1934,'_intro_head_minor','field_64e8288c3ada0'),(89686,1934,'intro_icons_0_int_icon','1922'),(89687,1934,'_intro_icons_0_int_icon','field_64e828b33ada2'),(89688,1934,'intro_icons_0_int_icon_text','At 1,727,000 square kilometres, we’re 2.5 times the size of Texas. <span>Yeeha!</span>'),(89689,1934,'_intro_icons_0_int_icon_text','field_64e828e33ada3'),(89690,1934,'intro_icons_1_int_icon','1920'),(89691,1934,'_intro_icons_1_int_icon','field_64e828b33ada2'),(89692,1934,'intro_icons_1_int_icon_text','We have twice as many species of native plant and animal as any other Australian state or territory.'),(89693,1934,'_intro_icons_1_int_icon_text','field_64e828e33ada3'),(89694,1934,'intro_icons_2_int_icon','1921'),(89695,1934,'_intro_icons_2_int_icon','field_64e828b33ada2'),(89696,1934,'intro_icons_2_int_icon_text','We have less land classified as ‘protected’ than any other state or territory.'),(89697,1934,'_intro_icons_2_int_icon_text','field_64e828e33ada3'),(89698,1934,'intro_icons','3'),(89699,1934,'_intro_icons','field_64e828963ada1'),(89700,1934,'threat_head_major','What we stand to lose if we don’t act soon to protect beautiful Queensland:'),(89701,1934,'_threat_head_major','field_64ec258d9dbd1'),(89702,1934,'threats_icons','3'),(89703,1934,'_threats_icons','field_64ec2551a93f9'),(8970