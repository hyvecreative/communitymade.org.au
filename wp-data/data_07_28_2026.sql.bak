pp_link_text','Find out More'),(212299,2785,'_what_happened_1_happ_link_text','field_693d4ad641980'),(212300,2785,'what_happened','2'),(212301,2785,'_what_happened','field_693d4a6f4197c'),(212302,2785,'what_happened_0_happ_icon','2703'),(212303,2785,'_what_happened_0_happ_icon','field_693d4c9b3ec4d'),(212304,2785,'what_happened_1_happ_icon','2703'),(212305,2785,'_what_happened_1_happ_icon','field_693d4c9b3ec4d'),(212306,2785,'display_news_section',''),(212307,2785,'_display_news_section','field_69434cc6d5f7d'),(212308,2785,'issues_head','These are the issues'),(212309,2785,'_issues_head','field_6a3b076406aef'),(212310,2785,'issues_items_0_issue_icon','2705'),(212311,2785,'_issues_items_0_issue_icon','field_6a3b07b506af1'),(212312,2785,'issues_items_0_issues_item_hd','A secure home is slipping out of reach'),(212313,2785,'_issues_items_0_issues_item_hd','field_6a3b07d706af2'),(212314,2785,'issues_items_0_issues_item_txt','•	A shortage of 132,000 social and affordable rental homes\r\n•	70,000+ households waiting for social housing\r\n•	Record-high private market rents\r\n•	Home ownership increasingly out of reach for generations'),(212315,2785,'_issues_items_0_issues_item_txt','field_6a3b07fc06af3'),(212316,2785,'issues_items_0_issues_link_text',''),(212317,2785,'_issues_items_0_issues_link_text','field_6a3b080f06af4'),(212318,2785,'issues_items_0_issues_target_url',''),(212319,2785,'_issues_items_0_issues_target_url','field_6a3b082b06af5'),(212320,2785,'issues_items','2'),(212321,2785,'_issues_items','field_6a3b078206af0'),(212322,2785,'issues_items_1_issue_icon','2708'),(212323,2785,'_issues_items_1_issue_icon','field_6a3b07b506af1'),(212324,2785,'issues_items_1_issues_item_hd','The solutions we need '),(212325,2785,'_issues_items_1_issues_item_hd','field_6a3b07d706af2'),(212326,2785,'issues_items_1_issues_item_txt','Community housing works. We’re calling on the next NSW Government for three actions: long-term investment for new community housing, more funding to future-proof existing homes, and support to help people stayed housed.'),(212327,2785,'_issues_items_1_issues_item_txt','field_6a3b07fc06af3'),(212328,2785,'issues_items_1_issues_link_text',''),(212329,2785,'_issues_items_1_issues_link_text','field_6a3b080f06af4'),(212330,2785,'issues_items_1_issues_target_url',''),(212331,2785,'_issues_items_1_issues_target_url','field_6a3b082b06af5'),(212332,2785,'issues_items_0_issues_sub_head',''),(212333,2785,'_issues_items_0_issues_sub_head','field_6a3b0aa79365e'),(212334,2785,'issues_items_1_issues_sub_head',''),(212335,2785,'_issues_items_1_issues_sub_head','field_6a3b0aa79365e'),(212336,2785,'video_head','The people next door'),(212337,2785,'_video_head','field_6a5ff269ef234'),(212338,2785,'video_intro','Nurses. Childcare workers. Single parents. Older Australians who want to stay near the people they love. Community housing is the solution.'),(212339,2785,'_video_intro','field_6a606161b34b6'),(212340,2785,'hm_hero_title_sm','because we all deserve a safe, secure and affordable home'),(212341,2785,'_hm_hero_title_sm','field_6a607121b523f'),(212342,2785,'solutions_head',''),(212343,2785,'_solutions_head','field_6a61a1aaac606'),(212344,2785,'solutions_items','3'),(212345,2785,'_solutions_items','field_6a61a1aeac607'),(212346,2785,'solutions_items_0_issue_icon','2703'),(212347,2785,'_solutions_items_0_issue_icon','field_6a61a1aeac608'),(212348,2785,'solutions_items_0_issues_item_hd',''),(212349,2785,'_solutions_items_0_issues_item_hd','field_6a61a1aeac609'),(212350,2785,'solutions_items_0_issues_sub_head','long-term investment for new community housing,'),(212351,2785,'_solutions_items_0_issues_sub_head','field_6a61a1aeac60a'),(212352,2785,'solutions_items_0_issues_item_txt',''),(212353,2785,'_solutions_items_0_issues_item_txt','field_6a61a1aeac60b'),(212354,2785,'solutions_items_0_issues_link_text',''),(212355,2785,'_solutions_items_0_issues_link_text','field_6a61a1aeac60c'),(212356,2785,'solutions_items_0_issues_target_url',''