19,1794,'_survey_index_5_survey_title','field_6294564042238'),(57920,1794,'survey_index_5_survey_url','#'),(57921,1794,'_survey_index_5_survey_url','field_6294564e42239'),(57922,1794,'survey_index_5_survey_url_text','View Results'),(57923,1794,'_survey_index_5_survey_url_text','field_629456584223a'),(57924,1794,'survey_index_6_survey_icon','1492'),(57925,1794,'_survey_index_6_survey_icon','field_6294562942237'),(57926,1794,'survey_index_6_survey_title','Energy Management'),(57927,1794,'_survey_index_6_survey_title','field_6294564042238'),(57928,1794,'survey_index_6_survey_url','#'),(57929,1794,'_survey_index_6_survey_url','field_6294564e42239'),(57930,1794,'survey_index_6_survey_url_text','View Results'),(57931,1794,'_survey_index_6_survey_url_text','field_629456584223a'),(57932,1794,'survey_index_7_survey_icon','1493'),(57933,1794,'_survey_index_7_survey_icon','field_6294562942237'),(57934,1794,'survey_index_7_survey_title','Going Off-grid'),(57935,1794,'_survey_index_7_survey_title','field_6294564042238'),(57936,1794,'survey_index_7_survey_url','#'),(57937,1794,'_survey_index_7_survey_url','field_6294564e42239'),(57938,1794,'survey_index_7_survey_url_text','View Results'),(57939,1794,'_survey_index_7_survey_url_text','field_629456584223a'),(57940,1794,'survey_index','8'),(57941,1794,'_survey_index','field_6294561242236'),(57942,1794,'report_title','Download the report'),(57943,1794,'_report_title','field_62f30edfb57e1'),(57944,1794,'report_intro','Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus massa erat, consectetur at semper at, feugiat vel orci. '),(57945,1794,'_report_intro','field_62f30eedb57e2'),(57946,1794,'report_link_url','#'),(57947,1794,'_report_link_url','field_62f30ef4b57e3'),(57948,1794,'report_link_text','Download'),(57949,1794,'_report_link_text','field_62f30f01b57e4'),(57950,1794,'solutions_content','The housing system is complex, and no one solution will solve the complex problems we now face but there are some critical first steps to be taken now.\r\n<ul>\r\n 	<li>Set out an ambitious national housing agreement between commonwealth and state governments with targets and funding for the construction of affordable homes.</li>\r\n 	<li>Phase out tax breaks for property investors and using the increase in revenue to build more public housing.</li>\r\n 	<li>Establish laws which limit rental increases beyond what is fair.</li>\r\n 	<li>Rebalance tenancy laws to provide renters with more security and control, such as eliminating no grounds evictions.</li>\r\n 	<li>Phase out stamp duty and replace it with a broad-based land tax.</li>\r\n</ul>\r\n<h4>While there are many opinions on what policy changes will fix the housing market, doing nothing is not an option.</h4>'),(57951,1794,'_solutions_content','field_640e8b307a958'),(57952,1794,'problem_icons_0_prob_icon','1699'),(57953,1794,'_problem_icons_0_prob_icon','field_640fa0291d519'),(57954,1794,'problem_icons_0_prob_concerned_stat','70% highly concerned'),(57955,1794,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(57956,1794,'problem_icons_0_prob_concerded_text','are highly concerned'),(57957,1794,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(57958,1794,'problem_icons_0_prob_issue_text',''),(57959,1794,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(57960,1794,'problem_icons','4'),(57961,1794,'_problem_icons','field_640fa0191d518'),(57962,1794,'ceh_content_left',''),(57963,1794,'_ceh_content_left','field_640e97e8f1c8c'),(57964,1794,'ceh_content_right',''),(57965,1794,'_ceh_content_right','field_640e97fdf1c8d'),(57966,1794,'pc_content_left',''),(57967,1794,'_pc_content_left','field_640e983bf1c8f'),(57968,1794,'pc_content_right',''),(57969,1794,'_pc_content_right','field_640e984df1c90'),(57970,1794,'problem_icons_1_prob_icon','1699'),(57971,1794,'_problem_icons_1_prob_icon','field_640fa0291d519'),(57972,1794,'problem_icons_1_prob_concerned_stat','69% highly concerned'),(57973,1794,'_problem_icons_1_prob_