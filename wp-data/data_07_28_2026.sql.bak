d_66441acfe963c'),(210589,2782,'word_link','#'),(210590,2782,'_word_link','field_6646c69723804'),(210591,2782,'pdf_link','#'),(210592,2782,'_pdf_link','field_6646c6da23805'),(210593,2782,'intro_boxes_0_box_image','2241'),(210594,2782,'_intro_boxes_0_box_image','field_65262db5d36ee'),(210595,2782,'intro_boxes_1_box_image','2179'),(210596,2782,'_intro_boxes_1_box_image','field_65262db5d36ee'),(210597,2782,'intro_boxes_2_box_image','2012'),(210598,2782,'_intro_boxes_2_box_image','field_65262db5d36ee'),(210599,2782,'intro_boxes_0_box_excerpt','Excerpt text here just a sentance or so and no more.'),(210600,2782,'_intro_boxes_0_box_excerpt','field_665975273e827'),(210601,2782,'intro_boxes_1_box_excerpt','Excerpt text here just a sentance or so and no more.'),(210602,2782,'_intro_boxes_1_box_excerpt','field_665975273e827'),(210603,2782,'intro_boxes_2_box_excerpt','Excerpt text here just a sentance or so and no more.'),(210604,2782,'_intro_boxes_2_box_excerpt','field_665975273e827'),(210605,2782,'intro_boxes_0_btn-text','Latest events'),(210606,2782,'_intro_boxes_0_btn-text','field_665abda8b8d4b'),(210607,2782,'intro_boxes_1_btn-text','Latest projects'),(210608,2782,'_intro_boxes_1_btn-text','field_665abda8b8d4b'),(210609,2782,'intro_boxes_2_btn-text','Latest ideas'),(210610,2782,'_intro_boxes_2_btn-text','field_665abda8b8d4b'),(210611,2782,'display-easy-read',''),(210612,2782,'_display-easy-read','field_666129bd2da00'),(210613,2782,'_thumbnail_id','2688'),(210614,2782,'inline_featured_image',''),(210615,2782,'hm_hero_sum','Statement about the issue and lost life savings'),(210616,2782,'_hm_hero_sum','field_64ed37241effa'),(210617,2782,'_yoast_wpseo_content_score','90'),(210618,2782,'_yoast_wpseo_estimated-reading-time-minutes','1'),(210619,2782,'hm_hero_sub','Real homes, run by not-for-profit providers, for everyday people and families. Join our NSW election campaign and ask your local candidates to commit to more community housing.'),(210620,2782,'_hm_hero_sub','field_64ed37241effa'),(210621,2782,'intro_head','We’re here to help.'),(210622,2782,'_intro_head','field_64e828783ad9f'),(210623,2782,'intro_content','About 12,000 people invested their hard-earned super savings in two investment funds which have now collapsed, called Shield Master Fund and First Guardian Master Fund. Most people will be entitled to get some money back, but you need to take action soon. This website has information and tools to help you understand what happened, where to get help and how to take back your super.'),(210624,2782,'_intro_content','field_66441acfe963c'),(210625,2782,'deadline_heading','Important deadlines'),(210626,2782,'_deadline_heading','field_69365ff82e6f2'),(210627,2782,'deadline_content','You need to take action before the deadline to take your super back.'),(210628,2782,'_deadline_content','field_693660342e6f3'),(210629,2782,'deadline_button_text','Find out more'),(210630,2782,'_deadline_button_text','field_693660482e6f4'),(210631,2782,'deadline_button_url','/key-deadlines/'),(210632,2782,'_deadline_button_url','field_693660912e6f5'),(210633,2782,'what_head','Get involved'),(210634,2782,'_what_head','field_69366611096ac'),(210635,2782,'what_happened_0_happ_sub','Take action here...'),(210636,2782,'_what_happened_0_happ_sub','field_693d4a8b4197d'),(210637,2782,'what_happened_0_happ_content','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut laoreet dolore magna aliquam erat volutpat. Ut wisi enim ad minim veniam, quis nostrud exerci tation ullamcorper suscipit lobortis nisl ut aliquip ex ea commodo consequat.\r\n\r\nDuis autem vel eum iriure dolor in hendrerit in vulputate velit esse molestie consequat, vel illum dolore eu feugiat nulla facilisis at vero eros et accumsan et iusto odio dignissim qui blandit praesent luptatum zzril delenit augue duis dolore te feugait nulla facilisi.'),(210638,2782,'_what_happened_0_happ_content','field_693d4aa84197e'),(210639,2782,'what_happened_0_happ_url'