036,2203,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(127037,2203,'_second_image_button','field_5b67cb29ddf9c'),(127038,2203,'second_image_title','Lifestart is about supporting young children'),(127039,2203,'_second_image_title','field_5b67cb20ddf9a'),(127040,2203,'page_col_image','412'),(127041,2203,'_page_col_image','field_5de6546e7c63a'),(127042,2203,'page_col_image_3','437'),(127043,2203,'_page_col_image_3','field_5de6e3998e07e'),(127044,2203,'sec_2_title','Community'),(127045,2203,'_sec_2_title','field_5de6e3ef2798f'),(127046,2203,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(127047,2203,'_sec_2_text','field_5de78dc89e613'),(127048,2203,'sec_3_title','The Project'),(127049,2203,'_sec_3_title','field_5de6e3d37d8da'),(127050,2203,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(127051,2203,'_sec_3_text','field_5de6e4044e5e8'),(127052,2203,'page_col_image_2','436'),(127053,2203,'_page_col_image_2','field_5de6546e7c63a'),(127054,2203,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(127055,2203,'_sec_2_button','field_5de6e58c86706'),(127056,2203,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(127057,2203,'_sec_3_button','field_5de6e5a243c03'),(127058,2203,'page_col_image_4','455'),(127059,2203,'_page_col_image_4','field_5de70801090ce'),(127060,2203,'sec_4_title','Location'),(127061,2203,'_sec_4_title','field_5de7082a12a81'),(127062,2203,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(127063,2203,'_sec_4_text','field_5de7084812a82'),(127064,2203,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(127065,2203,'_sec_4_button','field_5de7085e12a83'),(127066,2203,'news_title','Project updates'),(127067,2203,'_news_title','field_5de78da3aabb9'),(127068,2203,'sec_2_text_copy',''),(127069,2203,'_sec_2_text_copy','field_5de78dc89e613'),(127070,2203,'timeline-title','Timeline'),(127071,2203,'_timeline-title','field_5de78df29e615'),(127072,2203,'timeline_title','Timeline'),(127073,2203,'_timeline_title','field_5de78df29e615'),(127074,2203,'contact_title','Contact us'),(127075,2203,'_contact_title','field_5de7981e06057'),(127076,2203,'contact_intro','Contact text...'),(127077,2203,'_contact_intro','field_5de7983506058'),(127078,2203,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(127079,2203,'_news_button','field_5de8329896e02'),(127080,2203,'timeline_intro','Introduction of timeline detail...'),(127081,2203,'_timeline_intro','field_5de98f5fb1781'),(127082,2203,'timeline_pic','477'),(127083,2203,'_timeline_pic','field_5de98f72b1782'),(127084,2203,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(127085,2203,'_timeline_button','field_5de99363677f8'),(127086,2203,'banner_image_position','center'),(127087,2203,'_banner_image_position','field_5f3bc4757dd02'),(127088,2203,'services_title','Our services'),(127089,2203,'_services_title','field_5f20f3cd80eb2'),(127090,2203,'services_items_0_services_item_image','1061'),(127091,2203,'_services