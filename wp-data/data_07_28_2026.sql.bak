rned_text','field_640fa10181d96'),(58002,1794,'monitor_content','The Australian Housing Monitor is a large, nationally-representative survey covering public experiences and attitudes toward housing related issues. Questions range from how well the respondent is keeping up with their mortgage/rent, to what they think about social housing construction.\r\n\r\nA broad range of demographic criteria are included, such as gender, location, age, income, voting preference, educational level, tenure type, and employment status. These variables allow CEH researchers to understand the trends and diversity of opinion around the country.\r\n\r\nIt also incorporates questions from previous surveys to track trends over time.\r\nThe inaugural poll was conducted by Essential in December 2022, and was completed by 4,735 people.'),(58003,1794,'_monitor_content','field_640fcc4014404'),(58004,1794,'problem_head','Housing in Australia is not working, and Australians are concerned.'),(58005,1794,'_problem_head','field_641935436aded'),(58006,1794,'problem_signoff','Explore the research showing how concerned Australians are our about the housing situation.'),(58007,1794,'_problem_signoff','field_641935626adee'),(58008,1794,'sections','a:2:{i:0;s:4:\"hero\";i:1;s:9:\"news_grid\";}'),(58009,1794,'_sections','field_5dafb40b8143a'),(58010,1794,'sections_0_is_full_height','1'),(58011,1794,'_sections_0_is_full_height','field_61d6f6fd5a37e'),(58012,1794,'sections_0_image','1648'),(58013,1794,'_sections_0_image','field_61d6f6d45a37d'),(58014,1794,'sections_0_heading','Heading'),(58015,1794,'_sections_0_heading','field_61d6f69e5a379'),(58016,1794,'sections_0_subtitle','Ya ya '),(58017,1794,'_sections_0_subtitle','field_61d6f6ac5a37a'),(58018,1794,'sections_0_link_one',''),(58019,1794,'_sections_0_link_one','field_61d6f6b55a37b'),(58020,1794,'sections_0_link_two',''),(58021,1794,'_sections_0_link_two','field_61d6f6c35a37c'),(58022,1794,'sections_1_select_categories','a:1:{i:0;s:2:\"27\";}'),(58023,17