_button','<a class=\"btn btn-orange\" href=\"/supports/\">Find us</a>'),(179811,2657,'_support_ctr_button','field_5b67c63658af5'),(179812,2657,'support_right_title','NDIS Registered provider'),(179813,2657,'_support_right_title','field_5b67c6a38c064'),(179814,2657,'support_right_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut.'),(179815,2657,'_support_right_cont','field_5b67c6c98c065'),(179816,2657,'support_right_button','<a class=\"btn btn-blue\" href=\"#\">Read more</a>'),(179817,2657,'_support_right_button','field_5b67c6dd8c066'),(179818,2657,'first_image_title','Lifestart is about supporting young children'),(179819,2657,'_first_image_title','field_5b67ca606afc4'),(179820,2657,'first_image_cont','from 0-24 years living with disabilities and their familes'),(179821,2657,'_first_image_cont','field_5b67caff6afc5'),(179822,2657,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(179823,2657,'_first_image_button','field_5b67cb0d6afc6'),(179824,2657,'second _image_title','Lifestart is about supporting young children'),(179825,2657,'_second _image_title','field_5b67cb20ddf9a'),(179826,2657,'second_image_cont','from 0-24 years living with disabilities and their familes'),(179827,2657,'_second_image_cont','field_5b67cb24ddf9b'),(179828,2657,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(179829,2657,'_second_image_button','field_5b67cb29ddf9c'),(179830,2657,'second_image_title','Lifestart is about supporting young children'),(179831,2657,'_second_image_title','field_5b67cb20ddf9a'),(179832,2657,'page_col_image','412'),(179833,2657,'_page_col_image','field_5de6546e7c63a'),(179834,2657,'page_col_image_3','437'),(179835,2657,'_page_col_image_3','field_5de6e3998e07e'),(179836,2657,'sec_2_title','Community'),(179837,2657,'_sec_2_title','field_5de6e3ef2798f'),(179838,2657,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(179839,2657,'_sec_2_text','field_5de78dc89e613'),(179840,2657,'sec_3_title','The Project'),(179841,2657,'_sec_3_title','field_5de6e3d37d8da'),(179842,2657,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(179843,2657,'_sec_3_text','field_5de6e4044e5e8'),(179844,2657,'page_col_image_2','436'),(179845,2657,'_page_col_image_2','field_5de6546e7c63a'),(179846,2657,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(179847,2657,'_sec_2_button','field_5de6e58c86706'),(179848,2657,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(179849,2657,'_sec_3_button','field_5de6e5a243c03'),(179850,2657,'page_col_image_4','455'),(179851,2657,'_page_col_image_4','field_5de70801090ce'),(179852,2657,'sec_4_title','Location'),(179853,2657,'_sec_4_title','field_5de7082a12a81'),(179854,2657,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(179855,2657,'_sec_4_text','field_5de7084812a82'),(179856,2657,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(179857,2657,'_sec_4_button','field_5de7085e12a83'),(179858,2657,'news_title','Project updates'),(179859,2657,'_news_title','field_5de78da3aabb9'),(179860,2657,'sec_2_text_copy',''),(179861,2657,'_sec_2_text_copy','field_5de78dc89e613'),(179862,2657,'timeline-title','Timeline'),(179863,2657,'_timeline-title','field_5de78df29e615'),(179864,2657,'timeline_title','Timeline'),(179865,2657,'_timeline_title','field_5de78df29e615'),(179866,2657,'contact_title','Contact us'),(179867,2657,'_contact_title','field_5de7981e06057'),(179868,2657,'contact_intro','Contact text...'),(179869,2657,'_contact_intro','field_5de7983506058'),(179870,2657,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(179871,2657,'_news_button','field_5de8329896e02'),(179872,2657,'timeline_intro','Introduction of timeline detail...'),(179873,2657,'_timeline_intro','field_5de98f5fb1781'),(179874,2657,'timeline_pic','477'),(179875,2657,'_timeline_pic','field_5de98f72b1782'),(179876,2657,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(179877,2657,'_timeline_button','field_5de99363677f8'),(179878,2657,'banner_image_position','center'),(179879,2657,'_banner_image_position','field_5f3bc4757dd02'),(179880,2657,'services_title','Our services'),(179881,2657,'_services_title','field_5f20f3cd80eb2'),(179882,2657,'services_items_0_services_item_image','1061'),(179883,2657,'_services_items_0_services_item_image','field_5f2121355be14'),(179884,2657,'services_items_0_sservices_item_title','1300 Telephone counselling line'),(179885,2657,'_services_items_0_sservices_item_title','field_605089efca82e'),(179886,2657,'services_items_0_services_item_text',''),(179887,2657,'_services_items_0_services_item_text','field_5f2121535be15'),(179888,2657,'services_items_0_services_link_url','#'),(179889,2657,'_services_items_0_services_link_url','field_6050866041225'),(179890,2657,'services_items_0_services_link_text','Find out more'),(179891,2657,'_services_items_0_services_link_text','field_6050866d41226'),(179892,2657,'services_items_1_services_item_image','1061