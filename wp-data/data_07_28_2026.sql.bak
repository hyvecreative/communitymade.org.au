familes'),(77069,1873,'_second_image_cont','field_5b67cb24ddf9b'),(77070,1873,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(77071,1873,'_second_image_button','field_5b67cb29ddf9c'),(77072,1873,'second_image_title','Lifestart is about supporting young children'),(77073,1873,'_second_image_title','field_5b67cb20ddf9a'),(77074,1873,'page_col_image','412'),(77075,1873,'_page_col_image','field_5de6546e7c63a'),(77076,1873,'page_col_image_3','437'),(77077,1873,'_page_col_image_3','field_5de6e3998e07e'),(77078,1873,'sec_2_title','Community'),(77079,1873,'_sec_2_title','field_5de6e3ef2798f'),(77080,1873,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(77081,1873,'_sec_2_text','field_5de78dc89e613'),(77082,1873,'sec_3_title','The Project'),(77083,1873,'_sec_3_title','field_5de6e3d37d8da'),(77084,1873,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(77085,1873,'_sec_3_text','field_5de6e4044e5e8'),(77086,1873,'page_col_image_2','436'),(77087,1873,'_page_col_image_2','field_5de6546e7c63a'),(77088,1873,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(77089,1873,'_sec_2_button','field_5de6e58c86706'),(77090,1873,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(77091,1873,'_sec_3_button','field_5de6e5a243c03'),(77092,1873,'page_col_image_4','455'),(77093,1873,'_page_col_image_4','field_5de70801090ce'),(77094,1873,'sec_4_title','Location'),(77095,1873,'_sec_4_title','field_5de7082a12a81'),(77096,1873,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(77097,1873,'_sec_4_text','field_5de7084812a82'),(77098,1873,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(77099,1873,'_sec_4_button','field_5de7085e12a83'),(77100,1873,'news_title','Project updates'),(77101,1873,'_news_title','field_5de78da3aabb9'),(77102,1873,'sec_2_text_copy',''),(77103,1873,'_sec_2_text_copy','field_5de78dc89e613'),(77104,1873,'timeline-title','Timeline'),(77105,1873,'_timeline-title','field_5de78df29e615'),(77106,1873,'timeline_title','Timeline'),(77107,1873,'_timeline_title','field_5de78df29e615'),(77108,1873,'contact_title','Contact us'),(77109,1873,'_contact_title','field_5de7981e06057'),(77110,1873,'contact_intro','Contact text...'),(77111,1873,'_contact_intro','field_5de7983506058'),(77112,1873,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(77113,1873,'_news_button','field_5de8329896e02'),(77114,1873,'timeline_intro','Introduction of timeline detail...'),(77115,1873,'_timeline_intro','field_5de98f5fb1781'),(77116,1873,'timeline_pic','477'),(77117,1873,'_timeline_pic','field_5de98f72b1782'),(77118,1873,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(77119,1873,'_timeline_button','field_5de99363677f8'),(77120,1873,'banner_image_position','center'),(77121,1873,'_banner_image_position','field_5f3bc4757dd02'),(77122,1873,'services_title','Our services'),(77123,1873,'_services_title','field_5f20f3cd80eb2'),(77124,1873,'services_items_0_services_item_image','1061'),(77125,1