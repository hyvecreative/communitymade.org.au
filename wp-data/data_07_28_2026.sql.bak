ppened_1_happ_url','#'),(196152,2719,'_what_happened_1_happ_url','field_693d4aba4197f'),(196153,2719,'what_happened_1_happ_link_text','Find out More'),(196154,2719,'_what_happened_1_happ_link_text','field_693d4ad641980'),(196155,2719,'what_happened','2'),(196156,2719,'_what_happened','field_693d4a6f4197c'),(196157,2719,'what_happened_0_happ_icon','2703'),(196158,2719,'_what_happened_0_happ_icon','field_693d4c9b3ec4d'),(196159,2719,'what_happened_1_happ_icon','2703'),(196160,2719,'_what_happened_1_happ_icon','field_693d4c9b3ec4d'),(196161,2719,'display_news_section',''),(196162,2719,'_display_news_section','field_69434cc6d5f7d'),(196163,2719,'issues_head','These are the issues'),(196164,2719,'_issues_head','field_6a3b076406aef'),(196165,2719,'issues_items_0_issue_icon','2705'),(196166,2719,'_issues_items_0_issue_icon','field_6a3b07b506af1'),(196167,2719,'issues_items_0_issues_item_hd','The problem'),(196168,2719,'_issues_items_0_issues_item_hd','field_6a3b07d706af2'),(196169,2719,'issues_items_0_issues_item_txt','Rents are rising, waitlists are growing and more people are experiencing housing stress for the first time.'),(196170,2719,'_issues_items_0_issues_item_txt','field_6a3b07fc06af3'),(196171,2719,'issues_items_0_issues_link_text','Find out more'),(196172,2719,'_issues_items_0_issues_link_text','field_6a3b080f06af4'),(196173,2719,'issues_items_0_issues_target_url','#'),(196174,2719,'_issues_items_0_issues_target_url','field_6a3b082b06af5'),(196175,2719,'issues_items','4'),(196176,2719,'_issues_items','field_6a3b078206af0'),(196177,2719,'issues_items_1_issue_icon','2708'),(196178,2719,'_issues_items_1_issue_icon','field_6a3b07b506af1'),(196179,2719,'issues_items_1_issues_item_hd','Scaling the solution'),(196180,2719,'_issues_items_1_issues_item_hd','field_6a3b07d706af2'),(196181,2719,'issues_items_1_issues_item_txt','Governments, communities and not-for-profit community housing providers are working together to make rental housing more affordable for everyone who calls NSW home.'),(196182,2719,'_issues_items_1_issues_item_txt','field_6a3b07fc06af3'),(196183,2719,'issues_items_1_issues_link_text','Find out more'),(196184,2719,'_issues_items_1_issues_link_text','field_6a3b080f06af4'),(196185,2719,'issues_items_1_issues_target_url','#'),(196186,2719,'_issues_items_1_issues_target_url','field_6a3b082b06af5'),(196187,2719,'issues_items_0_issues_sub_head','The housing crisis is spiralling. '),(196188,2719,'_issues_items_0_issues_sub_head','field_6a3b0aa79365e'),(196189,2719,'issues_items_1_issues_sub_head','Community housing is social infrastructure.'),(196190,2719,'_issues_items_1_issues_sub_head','field_6a3b0aa79365e'),(196191,2719,'issues_items_2_issue_icon','2703'),(196192,2719,'_issues_items_2_issue_icon','field_6a3b07b506af1'),(196193,2719,'issues_items_2_issues_item_hd','Why community made:'),(196194,2719,'_issues_items_2_issues_item_hd','field_6a3b07d706af2'),(196195,2719,'issues_items_2_issues_sub_head',''),(196196,2719,'_issues_items_2_issues_sub_head','field_6a3b0aa79365e'),(196197,2719,'issues_items_2_issues_item_txt','Community housing is local. Every dollar invested is given back to community through homes, services and jobs. It’s built to thrive, like our communities.  Community housing is an investment in our state’s future. By investing in people today, we boost our local economies, communities and productivity – ensuring that NSW leads the nation.'),(196198,2719,'_issues_items_2_issues_item_txt','field_6a3b07fc06af3'),(196199,2719,'issues_items_2_issues_link_text',''),(196200,2719,'_issues_items_2_issues_link_text','field_6a3b080f06af4'),(196201,2719,'issues_items_2_issues_target_url',''),(196202,2719,'_issues_items_2_issues_target_url','field_6a3b082b06af5'),(196203,2719,'issues_items_3_issue_icon',''),(196204,2719,'_issues_items_3_issue_icon','field_6a3b07b506af1'),(196205,2719,'issues_items_3_issues_item_hd',''),(196206,2719,'_issues_items_3_issues_item_hd','field_6a3b07d706af2'),(196207,2719,'issues_items_3_