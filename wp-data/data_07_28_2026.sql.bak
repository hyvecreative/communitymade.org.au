_items_1_issues_item_txt','field_6a3b07fc06af3'),(195363,2718,'issues_items_1_issues_link_text','Find out more'),(195364,2718,'_issues_items_1_issues_link_text','field_6a3b080f06af4'),(195365,2718,'issues_items_1_issues_target_url','#'),(195366,2718,'_issues_items_1_issues_target_url','field_6a3b082b06af5'),(195367,2718,'issues_items_0_issues_sub_head','The housing crisis is spiralling. '),(195368,2718,'_issues_items_0_issues_sub_head','field_6a3b0aa79365e'),(195369,2718,'issues_items_1_issues_sub_head','Community housing is social infrastructure.'),(195370,2718,'_issues_items_1_issues_sub_head','field_6a3b0aa79365e'),(195371,2718,'issues_items_2_issue_icon','2703'),(195372,2718,'_issues_items_2_issue_icon','field_6a3b07b506af1'),(195373,2718,'issues_items_2_issues_item_hd','Why community made:'),(195374,2718,'_issues_items_2_issues_item_hd','field_6a3b07d706af2'),(195375,2718,'issues_items_2_issues_sub_head',''),(195376,2718,'_issues_items_2_issues_sub_head','field_6a3b0aa79365e'),(195377,2718,'issues_items_2_issues_item_txt','Community housing is local. Every dollar invested is given back to community through homes, services and jobs. It’s built to thrive, like our communities.  Community housing is an investment in our state’s future. By investing in people today, we boost our local economies, communities and productivity – ensuring that NSW leads the nation.'),(195378,2718,'_issues_items_2_issues_item_txt','field_6a3b07fc06af3'),(195379,2718,'issues_items_2_issues_link_text',''),(195380,2718,'_issues_items_2_issues_link_text','field_6a3b080f06af4'),(195381,2718,'issues_items_2_issues_target_url',''),(195382,2718,'_issues_items_2_issues_target_url','field_6a3b082b06af5'),(195383,2718,'issues_items_3_issue_icon',''),(195384,2718,'_issues_items_3_issue_icon','field_6a3b07b506af1'),(195385,2718,'issues_items_3_issues_item_hd',''),(195386,2718,'_issues_items_3_issues_item_hd','field_6a3b07d706af2'),(195387,2718,'issues_items_3_issues_sub_head',''),(195388,2718,'_issu