ddf9a'),(24197,1122,'second_image_cont','from 0-24 years living with disabilities and their familes'),(24198,1122,'_second_image_cont','field_5b67cb24ddf9b'),(24199,1122,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(24200,1122,'_second_image_button','field_5b67cb29ddf9c'),(24201,1122,'second_image_title','Lifestart is about supporting young children'),(24202,1122,'_second_image_title','field_5b67cb20ddf9a'),(24203,1122,'page_col_image','412'),(24204,1122,'_page_col_image','field_5de6546e7c63a'),(24205,1122,'page_col_image_3','437'),(24206,1122,'_page_col_image_3','field_5de6e3998e07e'),(24207,1122,'sec_2_title','Community'),(24208,1122,'_sec_2_title','field_5de6e3ef2798f'),(24209,1122,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(24210,1122,'_sec_2_text','field_5de78dc89e613'),(24211,1122,'sec_3_title','The Project'),(24212,1122,'_sec_3_title','field_5de6e3d37d8da'),(24213,1122,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(24214,1122,'_sec_3_text','field_5de6e4044e5e8'),(24215,1122,'page_col_image_2','436'),(24216,1122,'_page_col_image_2','field_5de6546e7c63a'),(24217,1122,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(24218,1122,'_sec_2_button','field_5de6e58c86706'),(24219,1122,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(24220,1122,'_sec_3_button','field_5de6e5a243c03'),(24221,1122,'page_col_image_4','455'),(24222,1122,'_page_col_image_4','field_5de70801090ce'),(24223,1122,'sec_4_title','Location'),(24224,1122,'_sec_4_title','field_5de7082a12a81'),(24225,1122,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(24226,1122,'_sec_4_text','field_5de7084812a82'),(24227,1122,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(24228,1122,'_sec_4_button','field_5de7085e12a83'),(24229,1122,'news_title','Project updates'),(24230,1122,'_news_title','field_5de78da3aabb9'),(24231,1122,'sec_2_text_copy',''),(24232,1122,'_sec_2_text_copy','field_5de78dc89e613'),(24233,1122,'timeline-title','Timeline'),(24234,1122,'_timeline-title','field_5de78df29e615'),(24235,1122,'timeline_title','Timeline'),(24236,1122,'_timeline_title','field_5de78df29e615'),(24237,1122,'contact_title','Contact us'),(24238,1122,'_contact_title','field_5de7981e06057'),(24239,1122,'contact_intro','Contact text...'),(24240,1122,'_contact_intro','field_5de7983506058'),(24241,1122,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(24242,1122,'_news_button','field_5de8329896e02'),(24243,1122,'timeline_intro','Introduction of timeline detail...'),(24244,1122,'_timeline_intro','field_5de98f5fb1781'),(24245,1122,'timeline_pic','477'),(24246,1122,'_timeline_pic','field_5de98f72b1782'),(24247,1122,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(24248,1122,'_timeline_button','field_5de99363677f8'),(24249,1122,'banner_image_position','center'),(24250,1122,'_banner_image_position','field_5f3bc4757dd02'),(24251,1122,'services_title','Our services'),(24252,1122,'_services_title