,(104467,2006,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(104468,2006,'_second_image_button','field_5b67cb29ddf9c'),(104469,2006,'second_image_title','Lifestart is about supporting young children'),(104470,2006,'_second_image_title','field_5b67cb20ddf9a'),(104471,2006,'page_col_image','412'),(104472,2006,'_page_col_image','field_5de6546e7c63a'),(104473,2006,'page_col_image_3','437'),(104474,2006,'_page_col_image_3','field_5de6e3998e07e'),(104475,2006,'sec_2_title','Community'),(104476,2006,'_sec_2_title','field_5de6e3ef2798f'),(104477,2006,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(104478,2006,'_sec_2_text','field_5de78dc89e613'),(104479,2006,'sec_3_title','The Project'),(104480,2006,'_sec_3_title','field_5de6e3d37d8da'),(104481,2006,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(104482,2006,'_sec_3_text','field_5de6e4044e5e8'),(104483,2006,'page_col_image_2','436'),(104484,2006,'_page_col_image_2','field_5de6546e7c63a'),(104485,2006,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(104486,2006,'_sec_2_button','field_5de6e58c86706'),(104487,2006,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(104488,2006,'_sec_3_button','field_5de6e5a243c03'),(104489,2006,'page_col_image_4','455'),(104490,2006,'_page_col_image_4','field_5de70801090ce'),(104491,2006,'sec_4_title','Location'),(104492,2006,'_sec_4_title','field_5de7082a12a81'),(104493,2006,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(104494,2006,'_sec_4_text','field_5de7084812a82'),(104495,2006,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(104496,2006,'_sec_4_button','field_5de7085e12a83'),(104497,2006,'news_title','Project updates'),(104498,2006,'_news_title','field_5de78da3aabb9'),(104499,2006,'sec_2_text_copy',''),(104500,2006,'_sec_2_text_copy','field_5de78dc89e613'),(104501,2006,'timeline-title','Timeline'),(104502,2006,'_timeline-title','field_5de78df29e615'),(104503,2006,'timeline_title','Timeline'),(104504,2006,'_timeline_title','field_5de78df29e615'),(104505,2006,'contact_title','Contact us'),(104506,2006,'_contact_title','field_5de7981e06057'),(104507,2006,'contact_intro','Contact text...'),(104508,2006,'_contact_intro','field_5de7983506058'),(104509,2006,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(104510,2006,'_news_button','field_5de8329896e02'),(104511,2006,'timeline_intro','Introduction of timeline detail...'),(104512,2006,'_timeline_intro','field_5de98f5fb1781'),(104513,2006,'timeline_pic','477'),(104514,2006,'_timeline_pic','field_5de98f72b1782'),(104515,2006,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(104516,2006,'_timeline_button','field_5de99363677f8'),(104517,2006,'banner_image_position','center'),(104518,2006,'_banner_image_position','field_5f3bc4757dd02'),(104519,2006,'services_title','Our services'),(104520,2006,'_services_title','field_5f20f3cd80eb2'),(104521,2006,'services_items_0_services_item_image','1061'),(104522,2006,'_ser