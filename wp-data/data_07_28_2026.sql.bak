0,'_survey_index_6_survey_url_text','field_629456584223a'),(60618,1820,'survey_index_7_survey_icon','1493'),(60619,1820,'_survey_index_7_survey_icon','field_6294562942237'),(60620,1820,'survey_index_7_survey_title','Going Off-grid'),(60621,1820,'_survey_index_7_survey_title','field_6294564042238'),(60622,1820,'survey_index_7_survey_url','#'),(60623,1820,'_survey_index_7_survey_url','field_6294564e42239'),(60624,1820,'survey_index_7_survey_url_text','View Results'),(60625,1820,'_survey_index_7_survey_url_text','field_629456584223a'),(60626,1820,'survey_index','8'),(60627,1820,'_survey_index','field_6294561242236'),(60628,1820,'report_title','Download the report'),(60629,1820,'_report_title','field_62f30edfb57e1'),(60630,1820,'report_intro','Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus massa erat, consectetur at semper at, feugiat vel orci. '),(60631,1820,'_report_intro','field_62f30eedb57e2'),(60632,1820,'report_link_url','#'),(60633,1820,'_report_link_url','field_62f30ef4b57e3'),(60634,1820,'report_link_text','Download'),(60635,1820,'_report_link_text','field_62f30f01b57e4'),(60636,1820,'solutions_content','The housing system is complex, and no one solution will solve the complex problems we now face but there are some critical first steps to be taken now.\r\n<ul>\r\n 	<li>Set out an ambitious national housing agreement between commonwealth and state governments with targets and funding for the construction of affordable homes.</li>\r\n 	<li>Phase out tax breaks for property investors and using the increase in revenue to build more public housing.</li>\r\n 	<li>Establish laws which limit rental increases beyond what is fair.</li>\r\n 	<li>Rebalance tenancy laws to provide renters with more security and control, such as eliminating no grounds evictions.</li>\r\n 	<li>Phase out stamp duty and replace it with a broad-based land tax.</li>\r\n</ul>\r\n<h4>While there are many opinions on what policy changes will fix the housing market, doing nothing is not an option.</h4>'),(60637,1820,'_solutions_content','field_640e8b307a958'),(60638,1820,'problem_icons_0_prob_icon','1699'),(60639,1820,'_problem_icons_0_prob_icon','field_640fa0291d519'),(60640,1820,'problem_icons_0_prob_concerned_stat','70% highly concerned'),(60641,1820,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(60642,1820,'problem_icons_0_prob_concerded_text','are highly concerned'),(60643,1820,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(60644,1820,'problem_icons_0_prob_issue_text',''),(60645,1820,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(60646,1820,'problem_icons','4'),(60647,1820,'_problem_icons','field_640fa0191d518'),(60648,1820,'ceh_content_left',''),(60649,1820,'_ceh_content_left','field_640e97e8f1c8c'),(60650,1820,'ceh_content_right',''),(60651,1820,'_ceh_content_right','field_640e97fdf1c8d'),(60652,1820,'pc_content_left',''),(60653,1820,'_pc_content_left','field_640e983bf1c8f'),(60654,1820,'pc_content_right',''),(60655,1820,'_pc_content_right','field_640e984df1c90'),(60656,1820,'problem_icons_1_prob_icon','1699'),(60657,1820,'_problem_icons_1_prob_icon','field_640fa0291d519'),(60658,1820,'problem_icons_1_prob_concerned_stat','69% highly concerned'),(60659,1820,'_problem_icons_1_prob_concerned_stat','field_640fa0dd81d95'),(60660,1820,'problem_icons_1_prob_concerded_text','are highly concerned'),(60661,1820,'_problem_icons_1_prob_concerded_text','field_640fa10181d96'),(60662,1820,'problem_icons_1_prob_issue_text',''),(60663,1820,'_problem_icons_1_prob_issue_text','field_640fa11a81d97'),(60664,1820,'problem_icons_2_prob_icon','1699'),(60665,1820,'_problem_icons_2_prob_icon','field_640fa0291d519'),(60666,1820,'problem_icons_2_prob_concerned_stat','64% highly concerned'),(60667,1820,'_problem_icons_2_prob_concerned_stat','field_640fa0dd81d95'),(60668,1820,'problem_icons_2_prob_concerded_text','are highly concerned'),(60669,1820,'_problem_icons_2_prob_concerded_text','field_640fa10181d96'),(60670,1820,'problem_icons_2_prob_issue_text',''),(60671,1820,'_problem_icons_2_prob_issue_text','field_640fa11a81d97'),(60672,1820,'problem_icons_3_prob_icon','1699'),(60673,1820,'_problem_icons_3_prob_icon','field_640fa0291d519'),(60674,1820,'problem_icons_3_prob_concerned_stat','64% highly concerned'),(60675,1820,'_problem_icons_3_prob_concerned_stat','field_640fa0dd81d95'),(60676,1820,'problem_icons_3_prob_concerded_text','are highly concerned'),(60677,1820,'_problem_icons_3_prob_concerded_text','field_640fa10181d96'),(60678,1820,'problem_icons_3_prob_issue_text',''),(60679,1820,'_problem_icons_3_prob_issue_text','field_640fa11a81d97'),(60680,1820,'problem_icons_0_prob_concerned_text','House prices have doubled in a decade'),(60681,1820,'_problem_icons_0_prob_concerned_text','field_640fa10181d96'),(60682,1820,'problem_icons_1_prob_concerned_text','The gap between rich and poor is growing'),(60683,1820,'_problem_icons_1_prob_concerned_text','field_640fa10181d96'),(60684,1820,'problem_icons_2_prob_concerned_text','Construction of social housing is down'),(60685,1820,'_problem_icons_2_prob_concerned_text','field_640fa10181d96'),(60686,1820,'problem_icons_3_prob_concerned_text','Banks are making more than ever from housing'),(60687,1820,'_problem_icons_3_prob_concerned_text','field_640fa10181d96'),(60688,1820,'monitor_content','The Australian Housing Monitor is a large, nationally-representative survey covering public experiences and attitudes toward housing related issues. Questions range from how well the respondent is keeping up with their mortgage/rent, to what they think about social housing construction.\r\n\r\nA broad range of demographic criteria are included, such as gender, location, age, income, voting preference, educational level, tenure type, and employment status. These variables allow CEH researchers to understand the trends and diversity of opinion around the country.\r\n\r\nIt also incorporates questions from previous surveys to track trends over time.\r\nThe inaugural poll was conducted by Essential in December 2022, and was completed by 4,735 people.'),(60689,1820,'_monitor_content','field_640fcc4014404'),(60690,1820,'problem_head','Housing in Australia is not working, and Australians are concerned.'),(60691,1820,'_problem_head','field_641935436aded'),(60692,1820,'problem_signoff','Explore the research showing how concerned Australians are our about the housing situation.'),(60693,1820,'_problem_signoff','field_641935626adee'),(60694,1820,'sections','a:2:{i:0;s:4:\"hero\";i:1;s:9:\"news_grid\";}'),(60695,1820,'_sections','field_5dafb40b8143a'),(60696,1820,'sections_0_is_full_height','1'),(60697,1820,'_sections_0_is_full_height','field_61d6f6fd5a37e'),(60698,1820,'sections_0_image','1648'),(60699,1820,'_sections_0_image','field_61d6f6d45a37d'),(60700,1820,'sections_0_heading','Heading'),(60701,1820,'_sections_0_heading','field_61d6f69e5a379'),(60702,1820,'sections_0_subtitle','Ya ya '),(60703,1820,'_sections_0_subtitle','field_61d6f6ac5a37a'),(60704,1820,'sections_0_link_one',''),(60705,1820,'_sections_0_link_one','field_61d6f6b55a37b'),(60706,1820,'sections_0_link_two',''),(60707,1820,'_sections_0_link_two','field_61d6f6c35a37c'),(60708,1820,'sections_1_select_categories','a:1:{i:0;s:2:\"27\";}'),(60709,1820,'_sections_1_select_categories','field_637f04483b63b'),(60710,1820,'intro_head_major','Queenslanders are known for both our love of the great outdoors and our state pride…'),(60711,1820,'_intro_head_major','field_64e828783ad9f'),(60712,1820,'intro_head_minor','But there’s a few things you might not know about our beautiful state.'),(60713,1820,'_intro_head_minor','field_64e8288c3ada0'),(60714,1820,'intro_icons_0_int_icon','1806'),(60715,1820,'_intro_icons_0_int_icon','field_64e828b33ada2'),(60716,1820,'intro_icons_0_int_icon_text','At 1,727,000 square kilometres, we’re 2.5 times the size of Texas. <span>Yeeha!</span>'),(60717,1820,'_intro_icons_0_int_icon_text','field_64e828e33ada3'),(60718,1820,'intro_icons_1_int_icon','1806'),(60719,1820,'_intro_icons_1_int_icon','field_64e828b33ada2'),(60720,1820,'intro_icons_1_int_icon_text','We have twice as many species of native plant and animal as any other Australian state or territory.'),(60721,1820,'_intro_icons_1_int_icon_text','field_64e828e33ada3'),(60722,1820,'intro_icons_2_int_icon','1806'),(60723,1820,'_intro_icons_2_int_icon','field_64e828b33ada2'),(60724,1820,'intro_icons_2_int_icon_text','We have less land classified as ‘protected’ than any other state or territory.'),(60725,1820,'_intro_icons_2_int_icon_text','field_64e828e33ada3'),(60726,1820,'intro_icons','3'),(60727,1820,'_intro_icons','field_64e828963ada1'),(60728,1820,'threat_head_major',''),(60729,1820,'_threat_head_major','field_64ec258d9dbd1'),(60730,1820,'threats_icons','3'),(60731,1820,'_threats_icons','field_64ec2551a93f9'),(60732,1820,'threats_icons_0_thr_icon','1819'),(60733,1820,'_threats_icons_0_thr_icon','field_64ec2551a93fa'),(60734,1820,'threats_icons_0_thr_icon_text',''),(60735,1820,'_threats_icons_0_thr_icon_text','field_64ec2551a93fb'),(60736,1820,'threats_icons_1_thr_icon','1819'),(60737,1820,'_threats_icons_1_thr_icon','field_64ec2551a93fa'),(60738,1820,'threats_icons_1_thr_icon_text',''),(60739,1820,'_threats_icons_1_thr_icon_text','field_64ec2551a93fb'),(60740,1820,'threats_icons_2_thr_icon','1819'),(60741,1820,'_threats_icons_2_thr_icon','field_64ec2551a93fa'),(60742,1820,'threats_icons_2_thr_icon_text',''),(60743,1820,'_threats_icons_2_thr_icon_text','field_64ec2551a93fb'),(60744,1821,'banner_head',''),(60745,1821,'_banner_head','field_5b568121a8ffe'),(60746,1821,'banner_sub',''),(60747,1821,'_banner_sub','field_5b568139fd366'),(60748,1821,'banner_button','<a class=\"btn btn-home\" style=\"width: 200px;\" href=\"#project\">Sign the petition</a>'),(60749,1821,'_banner_button','field_5b568147fd367'),(60750,1821,'support_section_title','How can Lifestart support you?'),(60751,1821,'_support_section_title','field_5b67c7d060398'),(60752,1821,'supp