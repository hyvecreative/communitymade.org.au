64fd8361d90ac'),(154398,2458,'signup_head','Join the campaign'),(154399,2458,'_signup_head','field_64fd83dc6b0b1'),(154400,2458,'boxes_section_title','Boxes'),(154401,2458,'_boxes_section_title','field_65262bbfd17fc'),(154402,2458,'intro_boxes_0_box_icon','1943'),(154403,2458,'_intro_boxes_0_box_icon','field_65262db5d36ee'),(154404,2458,'intro_boxes_0_box_title','Events'),(154405,2458,'_intro_boxes_0_box_title','field_65262d29ed8e3'),(154406,2458,'intro_boxes_0_box_dropdown','Our rigorous, conflict-free research and data analysis lifts the lid on fund performance, fees and insurance. Drawing on our policy expertise, we turn this analysis into action by using it to back reform and make super easier for people to understand. <a href=\"//localhost:4000:4000:4000:4000:4000:4000:/how/\">More</a>'),(154407,2458,'_intro_boxes_0_box_dropdown','field_65262dead0a0c'),(154408,2458,'intro_boxes_1_box_icon','1941'),(154409,2458,'_intro_boxes_1_box_icon','field_65262db5d36ee'),(154410,2458,'intro_boxes_1_box_title','Projects'),(154411,2458,'_intro_boxes_1_box_title','field_65262d29ed8e3'),(154412,2458,'intro_boxes_1_box_dropdown','Our rigorous, conflict-free research and data analysis lifts the lid on fund performance, fees and insurance. Drawing on our policy expertise, we turn this analysis into action by using it to back reform and make super easier for people to understand. <a href=\"//localhost:4000:4000:4000:4000:4000:4000:/how/\">More</a>'),(154413,2458,'_intro_boxes_1_box_dropdown','field_65262dead0a0c'),(154414,2458,'intro_boxes_2_box_icon','1937'),(154415,2458,'_intro_boxes_2_box_icon','field_65262db5d36ee'),(154416,2458,'intro_boxes_2_box_title','Ideas'),(154417,2458,'_intro_boxes_2_box_title','field_65262d29ed8e3'),(154418,2458,'intro_boxes_2_box_dropdown','Our rigorous, conflict-free research and data analysis lifts the lid on fund performance, fees and insurance. Drawing on our policy expertise, we turn this analysis into action by using it to back reform and make super easier for people to understand. <a href=\"//localhost:4000:4000:4000:4000:4000:4000:/how/\">More</a>'),(154419,2458,'_intro_boxes_2_box_dropdown','field_65262dead0a0c'),(154420,2458,'intro_boxes','3'),(154421,2458,'_intro_boxes','field_65262d14ed8e2'),(154422,2458,'get_help_section_title','Get Help'),(154423,2458,'_get_help_section_title','field_65262c35143de'),(154424,2458,'get_help_block_home',''),(154425,2458,'_get_help_block_home','field_65262c8a143e1'),(154426,2458,'gh_block_home_0_help_image','1956'),(154427,2458,'_gh_block_home_0_help_image','field_65262cd0143e2'),(154428,2458,'gh_block_home_0_help_title','How much do I need to retire? '),(154429,2458,'_gh_block_home_0_help_title','field_65262cec143e3'),(154430,2458,'gh_block_home_0_help_url','#'),(154431,2458,'_gh_block_home_0_help_url','field_65262cf4143e4'),(154432,2458,'gh_block_home_1_help_image','1962'),(154433,2458,'_gh_block_home_1_help_image','field_65262cd0143e2'),(154434,2458,'gh_block_home_1_help_title','I have a problem with  my super fund'),(154435,2458,'_gh_block_home_1_help_title','field_65262cec143e3'),(154436,2458,'gh_block_home_1_help_url','#'),(154437,2458,'_gh_block_home_1_help_url','field_65262cf4143e4'),(154438,2458,'gh_block_home_2_help_image','1961'),(154439,2458,'_gh_block_home_2_help_image','field_65262cd0143e2'),(154440,2458,'gh_block_home_2_help_title','How do I choose the right super? '),(154441,2458,'_gh_block_home_2_help_title','field_65262cec143e3'),(154442,2458,'gh_block_home_2_help_url','#'),(154443,2458,'_gh_block_home_2_help_url','field_65262cf4143e4'),(154444,2458,'gh_block_home','3'),(154445,2458,'_gh_block_home','field_65262c8a143e1'),(154446,2458,'turn_on_insights',''),(154447,2458,'_turn_on_insights','field_645c4a2e654a6'),(154448,2458,'report_questions','a:3:{i:0;s:4:\"1997\";i:1;s:4:\"2067\";i:2;s:4:\"2089\";}'),(154449,2458,'_report_questions','field_6109ed5e02e5a'),(154450,2458,'intro_text','The Disability Dialogue is a place where people with disabilities, their families, organisations providing support, academics, and the wider community come together to work on things that matter to us.\r\n\r\nThe Dialogue is a hub of knowledge and collaboration, separate from government, where we work together to come up. With new ideas on important topics. Our ideas can make a big difference in how services and systems are set up for people with disabilities.'),(154451,2458,'_intro_text','field_66441acfe963c'),(154452,2458,'word_link','#'),(154453,2458,'_word_link','field_6646c69723804'),(154454,2458,'pdf_link','#'),(154455,2458,'_pdf_link','field_6646c6da23805'),(154456,2458,'intro_boxes_0_box_image','2241'),(154457,2458,'_intro_boxes_0_box_image','field_65262db5d36ee'),(154458,2458,'intro_boxes_1_box_image','2179'),(154459,2458,'_intro_boxes_1_box_image','field_65262db5d36ee'),(154460,2458,'intro_boxes_2_box_image','2012'),(154461,2458,'_intro_boxes_2_box_image','field_65262db5d36ee'),(154462,2458,'intro_boxes_0_box_excerpt','Excerpt text here just a sentance or so and no more.'),(154463,2458,'_intro_boxes_0_box_excerpt','field_665975273e827'),(154464,2458,'intro_boxes_1_box_excerpt','Excerpt text here just a sentance or so and no more.'),(154465,2458,'_intro_boxes_1_box_excerpt','field_665975273e827'),(154466,2458,'intro_boxes_2_box_excerpt','Excerpt text here just a sentance or so and no more.'),(154467,2458,'_intro_boxes_2_box_excerpt','field_665975273e827'),(154468,2458,'intro_boxes_0_btn-text','Latest events'),(154469,2458,'_intro_boxes_0_btn-text','field_665abda8b8d4b'),(154470,2458,'intro_boxes_1_btn-text','Latest projects'),(154471,2458,'_intro_boxes_1_btn-text','field_665abda8b8d4b'),(154472,2458,'intro_boxes_2_btn-text','Latest ideas'),(154473,2458,'_intro_boxes_2_btn-text','field_665abda8b8d4b'),(154474,2458,'display-easy-read',''),(154475,2458,'_display-easy-read','field_666129bd2da00'),(154476,2458,'hm_hero_sum','Statement about the issue and lost life savings'),(154477,2458,'_hm_hero_sum','field_64ed37241effa'),(15