470,1795,'survey_index_5_survey_url','#'),(58471,1795,'_survey_index_5_survey_url','field_6294564e42239'),(58472,1795,'survey_index_5_survey_url_text','View Results'),(58473,1795,'_survey_index_5_survey_url_text','field_629456584223a'),(58474,1795,'survey_index_6_survey_icon','1492'),(58475,1795,'_survey_index_6_survey_icon','field_6294562942237'),(58476,1795,'survey_index_6_survey_title','Energy Management'),(58477,1795,'_survey_index_6_survey_title','field_6294564042238'),(58478,1795,'survey_index_6_survey_url','#'),(58479,1795,'_survey_index_6_survey_url','field_6294564e42239'),(58480,1795,'survey_index_6_survey_url_text','View Results'),(58481,1795,'_survey_index_6_survey_url_text','field_629456584223a'),(58482,1795,'survey_index_7_survey_icon','1493'),(58483,1795,'_survey_index_7_survey_icon','field_6294562942237'),(58484,1795,'survey_index_7_survey_title','Going Off-grid'),(58485,1795,'_survey_index_7_survey_title','field_6294564042238'),(58486,1795,'survey_index_7_survey_url','#'),(58487,1795,'_survey_index_7_survey_url','field_6294564e42239'),(58488,1795,'survey_index_7_survey_url_text','View Results'),(58489,1795,'_survey_index_7_survey_url_text','field_629456584223a'),(58490,1795,'survey_index','8'),(58491,1795,'_survey_index','field_6294561242236'),(58492,1795,'report_title','Download the report'),(58493,1795,'_report_title','field_62f30edfb57e1'),(58494,1795,'report_intro','Lorem ipsum dolor sit amet, consectetur adipiscing elit. Phasellus massa erat, consectetur at semper at, feugiat vel orci. '),(58495,1795,'_report_intro','field_62f30eedb57e2'),(58496,1795,'report_link_url','#'),(58497,1795,'_report_link_url','field_62f30ef4b57e3'),(58498,1795,'report_link_text','Download'),(58499,1795,'_report_link_text','field_62f30f01b57e4'),(58500,1795,'solutions_content','The housing system is complex, and no one solution will solve the complex problems we now face but there are some critical first steps to be taken now.\r\n<ul>\r\n 	<li>Set out an ambitious national housing agreement between commonwealth and state governments with targets and funding for the construction of affordable homes.</li>\r\n 	<li>Phase out tax breaks for property investors and using the increase in revenue to build more public housing.</li>\r\n 	<li>Establish laws which limit rental increases beyond what is fair.</li>\r\n 	<li>Rebalance tenancy laws to provide renters with more security and control, such as eliminating no grounds evictions.</li>\r\n 	<li>Phase out stamp duty and replace it with a broad-based land tax.</li>\r\n</ul>\r\n<h4>While there are many opinions on what policy changes will fix the housing market, doing nothing is not an option.</h4>'),(58501,1795,'_solutions_content','field_640e8b307a958'),(58502,1795,'problem_icons_0_prob_icon','1699'),(58503,1795,'_problem_icons_0_prob_icon','field_640fa0291d519'),(58504,1795,'problem_icons_0_prob_concerned_stat','70% highly concerned'),(58505,1795,'_problem_icons_0_prob_concerned_stat','field_640fa0dd81d95'),(58506,1795,'problem_icons_0_prob_concerded_text','are highly concerned'),(58507,1795,'_problem_icons_0_prob_concerded_text','field_640fa10181d96'),(58508,1795,'problem_icons_0_prob_issue_text',''),(58509,1795,'_problem_icons_0_prob_issue_text','field_640fa11a81d97'),(58510,1795,'problem_icons','4'),(58511,1795,'_problem_icons','field_640fa0191d518'),(58512,1795,'ceh_content_left',''),(58513,1795,'_ceh_content_left','field_640e97e8f1c8c'),(58514,1795,'ceh_content_right',''),(58515,1795,'_ceh_content_right','field_640e97fdf1c8d'),(58516,1795,'pc_content_left',''),(58517,1795,'_pc_content_left','field_640e983bf1c8f'),(58518,1795,'pc_content_right',''),(58519,1795,'_pc_content_right','field_640e984df1c90'),(58520,1795,'problem_icons_1_prob_icon','1699'),(58521,1795,'_problem_icons_1_prob_icon','field_640fa0291d519'),(58522,1795,'problem_icons_1_prob_concerned_stat','69% highly concerned'),(58523,1795,'_problem_icons_1_prob_concerned_stat','field_640fa0dd81d95'),(58524,1795,'problem_icons_1_prob_concerded_text','are highly concerned'),(58525,1795,'_problem_icons_1_prob_concerded_text','field_640fa10181d96'),(58526,1795,'problem_icons_1_prob_issue_text',''),(58527,1795,'_problem_icons_1_prob_issue_text','field_640fa11a81d97'),(58528,1795,'problem_icons_2_prob_icon','1699'),(58529,1795,'_problem_icons_2_prob_icon','field_640fa0291d519'),(58530,1795,'problem_icons_2_prob_concerned_stat','64% highly concerned'),(58531,1795,'_problem_icons_2_prob_concerned_stat','field_640fa0dd81d95'),(58532,1795,'problem_icons_2_prob_concerded_text','are highly concerned'),(58533,1795,'_problem_icons_2_prob_concerded_text','field_640fa10181d96'),(58534,1795,'problem_icons_2_prob_issue_text',''),(58535,1795,'_problem_icons_2_prob_issue_text','field_640fa11a81d97'),(58536,1795,'problem_icons_3_prob_icon','1699'),(58537,1795,'_problem_icons_3_prob_icon','field_640fa0291d519'),(58538,1795,'problem_icons_3_prob_concerned_stat','64% highly concerned'),(58539,1795,'_problem_icons_3_prob_concerned_stat','field_640fa0dd81d95'),(58540,1795,'problem_icons_3_prob_concerded_text','are highly concerned'),(58541,1795,'_problem_icons_3_prob_concerded_text','field_640fa10181d96'),(58542,1795,'problem_icons_3_prob_issue_text',''),(58543,1795,'_problem_icons_3_prob_issue_text','field_640fa11a81d97'),(58544,1795,'problem_icons_0_prob_concerned_text','House prices have doubled in a decade'),(58545,1795,'_problem_icons_0_prob_concerned_text','field_640fa10181d96'),(58546,1795,'problem_icons_1_prob_concerned_text','The gap between rich and poor is growing'),(58547,1795,'_problem_icons_1_prob_concerned_text','field_640fa10181d96'),(58548,1795,'problem_icons_2_prob_concerned_text','Construction of social housing is down'),(58549,1795,'_problem_icons_2_prob_concerned_text','field_640fa10181d96'),(58550,1795,'problem_icons_3_prob_concerned_text','Banks are making more than ever from housing'),(58551,1795,'_problem_icons_3_prob_concerned_text','field_640fa10181d96'),(58552,1795,'monitor_content','The Australian Housing Monitor is a large, nationally-representative survey covering public experiences and attitudes toward housing related issues. Questions range from how well the respondent is keeping up with their mortgage/rent, to what they think about social housing construction.\r\n\r\nA broad range of demographic criteria are included, such as gender, location, age, income, voting preference, educational level, tenure type, and employment status. These variables allow CEH researchers to understand the trends and diversity of opinion around the country.\r\n\r\nIt also incorporates questions from previous surveys to track trends over time.\r\nThe inaugural poll was conducted by Essential in December 2022, and was completed by 4,735 people.'),(58553,1795,'_monitor_content','field_640fcc4014404'),(58554,1795,'problem_head','Housing in Australia is not working, and Australians are concerned.'),(58555,1795,'_problem_head','field_641935436aded'),(58556,1795,'problem_signoff','Explore the research showing how concerned Australians are our about the housing situation.'),(58557,1795,'_problem_signoff','field_641935626adee'),(58558,1795,'sections','a:2:{i:0;s:4:\"hero\";i:1;s:9:\"news_grid\";}'),(58559,1795,'_sections','field_5dafb40b8143a'),(58560,1795,'sections_0_is_full_height','1'),(58561,1795,'_sections_0_is_full_height','field_61d6f6fd5a37e'),(58562,1795,'sections_0_image','1648'),(58563,1795,'_sections_0_image','field_61d6f6d45a37d'),(58564,1795,'sections_0_heading','Heading'),(58565,1795,'_sections_0_heading','field_61d6f69e5a379'),(58566,1795,'sections_0_subtitle','Ya ya '),(58567,1795,'_sections_0_subtitle','field_61d6f6ac5a37a'),(58568,1795,'sections_0_link_one',''),(58569,1795,'_sections_0_link_one','field_61d6f6b55a37b'),(58570,1795,'sections_0_link_two',''),(58571,1795,'_sections_0_link_two','field_61d6f6c35a37c'),(58572,1795,'sections_1_select_categories','a:1:{i:0;s:2:\"27\";}'),(58573,1795,'_sections_1_select_categories','field_637f04483b63b'),(58584,