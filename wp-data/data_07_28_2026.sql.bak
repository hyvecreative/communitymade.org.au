5079,2122,'problem_icons_2_prob_concerned_text','Construction of social housing is down'),(115080,2122,'_problem_icons_2_prob_concerned_text','field_640fa10181d96'),(115081,2122,'problem_icons_3_prob_concerned_text','Banks are making more than ever from housing'),(115082,2122,'_problem_icons_3_prob_concerned_text','field_640fa10181d96'),(115083,2122,'monitor_content','The Australian Housing Monitor is a large, nationally-representative survey covering public experiences and attitudes toward housing related issues. Questions range from how well the respondent is keeping up with their mortgage/rent, to what they think about social housing construction.\r\n\r\nA broad range of demographic criteria are included, such as gender, location, age, income, voting preference, educational level, tenure type, and employment status. These variables allow CEH researchers to understand the trends and diversity of opinion around the country.\r\n\r\nIt also incorporates questions from previous surveys to track trends over time.\r\nThe inaugural poll was conducted by Essential in December 2022, and was completed by 4,735 people.'),(115084,2122,'_monitor_content','field_640fcc4014404'),(115085,2122,'problem_head','Housing in Australia is not working, and Australians are concerned.'),(115086,2122,'_problem_head','field_641935436aded'),(115087,2122,'problem_signoff','Explore the research showing how concerned Australians are our about the housing situation.'),(115088,2122,'_problem_signoff','field_641935626adee'),(115089,2122,'sections','a:2:{i:0;s:4:\"hero\";i:1;s:9:\"news_grid\";}'),(115090,2122,'_sections','field_5dafb40b8143a'),(115091,2122,'sections_0_is_full_height','1'),(115092,2122,'_sections_0_is_full_height','field_61d6f6fd5a37e'),(115093,2122,'sections_0_image','1648'),(115094,2122,'_sections_0_image','field_61d6f6d45a37d'),(115095,2122,'sections_0_heading','Heading'),(115096,2122,'_sections_0_heading','field_61d6f69e5a379'),(115097,2122,'sections_0_subtitle','Ya ya '),(115098,2122,'_sections_0_subtitle','field_61d6f6ac5a37a'),(115099,2122,'sections_0_link_one',''),(115100,2122,'_sections_0_link_one','field_61d6f6b55a37b'),(115101,2122,'sections_0_link_two',''),(115102,2122,'_sections_0_link_two','field_61d6f6c35a37c'),(115103,2122,'sections_1_select_categories','a:1:{i:0;s:2:\"27\";}'),(115104,2122,'_sections_1_select_categories','field_637f04483b63b'),(115105,2122,'intro_head_major','Super Consumers Australia is <span>fighting</span> to ensure that the superannuation industry is <span>held accountable</span> for the outcomes they deliver to Australian consumers.'),(115106,2122,'_intro_head_major','field_64e828783ad9f'),(115107,2122,'intro_head_minor','We want super to work for everyone—not just super fund companies. With our research, journalism and campaigns we are creating the trustworthy and transparent superannuation system we all deserve.'),(115108,2122,'_intro_head_minor','field_64e8288c3ada0'),(115109,2122,'intro_icons_0_int_icon','1922'),(115110,2122,'_intro_icons_0_int_icon','field_64e828b33ada2'),(115111,2122,'intro_icons_0_int_icon_text','At 1,727,000 square kilometres, we’re 2.5 times the size of Texas. <span>Yeeha!</span>'),(115112,2122,'_intro_icons_0_int_icon_text','field_64e828e33ada3'),(115113,2122,'intro_icons_1_int_icon','1920'),(115114,2122,'_intro_icons_1_int_icon','field_64e828b33ada2'),(115115,2122,'intro_icons_1_int_icon_text','We have twice as many species of native plant and animal as any other Australian state or territory.'),(115116,2122,'_intro_icons_1_int_icon_text','field_64e828e33ada3'),(115117,2122,'intro_icons_2_int_icon','1921'),(115118,2122,'_intro_icons_2_int_icon','field_64e828b33ada2'),(115119,2122,'intro_icons_2_int_icon_text','We have less land classified as ‘protected’ than any other state or territory.'),(115120,2122,'_intro_icons_2_int_icon_text','field_64e828e33ada3'),(115121,2122,'intro_icons','3'),(115122,2122,'_intro_icons','field_64e828963ada1'),(115123,2122,'threat_head_major','What we 