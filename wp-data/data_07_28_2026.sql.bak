ack reform and make super easier for people to understand. <a href=\"//localhost:4000:4000:4000/how/\">More</a> '),(113701,2071,'_intro_boxes_0_box_dropdown','field_65262dead0a0c'),(113702,2071,'intro_boxes_1_box_icon','1941'),(113703,2071,'_intro_boxes_1_box_icon','field_65262db5d36ee'),(113704,2071,'intro_boxes_1_box_title','Investigative journalism'),(113705,2071,'_intro_boxes_1_box_title','field_65262d29ed8e3'),(113706,2071,'intro_boxes_1_box_dropdown','Dropdown text'),(113707,2071,'_intro_boxes_1_box_dropdown','field_65262dead0a0c'),(113708,2071,'intro_boxes_2_box_icon','1937'),(113709,2071,'_intro_boxes_2_box_icon','field_65262db5d36ee'),(113710,2071,'intro_boxes_2_box_title','Research'),(113711,2071,'_intro_boxes_2_box_title','field_65262d29ed8e3'),(113712,2071,'intro_boxes_2_box_dropdown','Dropdown text'),(113713,2071,'_intro_boxes_2_box_dropdown','field_65262dead0a0c'),(113714,2071,'intro_boxes','3'),(113715,2071,'_intro_boxes','field_65262d14ed8e2'),(113716,2071,'get_help_section_title','Get Help'),(113717,2071,'_get_help_section_title','field_65262c35143de'),(113718,2071,'get_help_block_home',''),(113719,2071,'_get_help_block_home','field_65262c8a143e1'),(113720,2071,'gh_block_home_0_help_image','1956'),(113721,2071,'_gh_block_home_0_help_image','field_65262cd0143e2'),(113722,2071,'gh_block_home_0_help_title','How much do I need to retire? '),(113723,2071,'_gh_block_home_0_help_title','field_65262cec143e3'),(113724,2071,'gh_block_home_0_help_url','#'),(113725,2071,'_gh_block_home_0_help_url','field_65262cf4143e4'),(113726,2071,'gh_block_home_1_help_image','1962'),(113727,2071,'_gh_block_home_1_help_image','field_65262cd0143e2'),(113728,2071,'gh_block_home_1_help_title','I have a problem with  my super fund'),(113729,2071,'_gh_block_home_1_help_title','field_65262cec143e3'),(113730,2071,'gh_block_home_1_help_url','#'),(113731,2071,'_gh_block_home_1_help_url','field_65262cf4143e4'),(113732,2071,'gh_block_home_2_help_image','1961'),(113733,2071,'_gh_block_ho