5de6546e7c63a'),(24511,1123,'page_col_image_3','437'),(24512,1123,'_page_col_image_3','field_5de6e3998e07e'),(24513,1123,'sec_2_title','Community'),(24514,1123,'_sec_2_title','field_5de6e3ef2798f'),(24515,1123,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(24516,1123,'_sec_2_text','field_5de78dc89e613'),(24517,1123,'sec_3_title','The Project'),(24518,1123,'_sec_3_title','field_5de6e3d37d8da'),(24519,1123,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(24520,1123,'_sec_3_text','field_5de6e4044e5e8'),(24521,1123,'page_col_image_2','436'),(24522,1123,'_page_col_image_2','field_5de6546e7c63a'),(24523,1123,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(24524,1123,'_sec_2_button','field_5de6e58c86706'),(24525,1123,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(24526,1123,'_sec_3_button','field_5de6e5a243c03'),(24527,1123,'page_col_image_4','455'),(24528,1123,'_page_col_image_4','field_5de70801090ce'),(24529,1123,'sec_4_title','Location'),(24530,1123,'_sec_4_title','field_5de7082a12a81'),(24531,1123,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(24532,1123,'_sec_4_text','field_5de7084812a82'),(24533,1123,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(24534,1123,'_sec_4_button','field_5de7085e12a83'),(24535,1123,'news_title','Project updates'),(24536,1123,'_news_title','field_5de78da3aabb9'),(24537,1123,'sec_2_text_copy',''),(24538,1123,'_sec_2_text_copy','field_5de78dc89e613'),(24539,1123,'timeline-title','Timeline'),(24540,1123,'_timeline-title','field_5de78df29e615'),(24541,1123,'timeline_title','Timeline'),(24542,1123,'_timeline_title','field_5de78df29e615'),(24543,1123,'contact_title','Contact us'),(24544,1123,'_contact_title','field_5de7981e06057'),(24545,1123,'contact_intro','Contact text...'),(24546,1123,'_contact_intro','field_5de7983506058'),(24547,1123,'news_button','<a class=\"btn btn-home btn-news\" href=\"/updates/\">See all updates</a>'),(24548,1123,'_news_button','field_5de8329896e02'),(24549,1123,'timeline_intro','Introduction of timeline detail...'),(24550,1123,'_timeline_intro','field_5de98f5fb1781'),(24551,1123,'timeline_pic','477'),(24552,1123,'_timeline_pic','field_5de98f72b1782'),(24553,1123,'timeline_button','<a class=\"btn btn-home btn-news\" href=\"/about/\">Detailed timeline</a>'),(24554,1123,'_timeline_button','field_5de99363677f8'),(24555,1123,'banner_image_position','center'),(24556,1123,'_banner_image_position','field_5f3bc4757dd02'),(24557,1123,'services_title','Our services'),(24558,1123,'_services_title','field_5f20f3cd80eb2'),(24559,1123,'services_items_0_services_item_image','1061'),(24560,1123,'_services_items_0_services_item_image','field_5f2121355be14'),(24561,1123,'services_items_0_sservices_item_title','1300 Telephone counselling line'),(24562,1123,'_services_items_0_sservices_item_title','field_605089efca82e'),(24563,1123,'services_items_0_services_item_text',''),(24564,1123,'_services_items_0_services_item_text','field_5f2121535be15'),(24565,1123,'services_items_0_services_link_url','#'),(24566,1123,'_serv