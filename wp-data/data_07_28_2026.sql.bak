utton','field_5b67c63658af5'),(46786,1594,'support_right_title','NDIS Registered provider'),(46787,1594,'_support_right_title','field_5b67c6a38c064'),(46788,1594,'support_right_cont','Lorem ipsum dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod tincidunt ut.'),(46789,1594,'_support_right_cont','field_5b67c6c98c065'),(46790,1594,'support_right_button','<a class=\"btn btn-blue\" href=\"#\">Read more</a>'),(46791,1594,'_support_right_button','field_5b67c6dd8c066'),(46792,1594,'first_image_title','Lifestart is about supporting young children'),(46793,1594,'_first_image_title','field_5b67ca606afc4'),(46794,1594,'first_image_cont','from 0-24 years living with disabilities and their familes'),(46795,1594,'_first_image_cont','field_5b67caff6afc5'),(46796,1594,'first_image_button','<a class=\"btn\" href=\"#\">Learn more</a>'),(46797,1594,'_first_image_button','field_5b67cb0d6afc6'),(46798,1594,'second _image_title','Lifestart is about supporting young children'),(46799,1594,'_second _image_title','field_5b67cb20ddf9a'),(46800,1594,'second_image_cont','from 0-24 years living with disabilities and their familes'),(46801,1594,'_second_image_cont','field_5b67cb24ddf9b'),(46802,1594,'second_image_button','<a class=\"btn btn-blue\" href=\"/about/\">Learn more</a>'),(46803,1594,'_second_image_button','field_5b67cb29ddf9c'),(46804,1594,'second_image_title','Lifestart is about supporting young children'),(46805,1594,'_second_image_title','field_5b67cb20ddf9a'),(46806,1594,'page_col_image','412'),(46807,1594,'_page_col_image','field_5de6546e7c63a'),(46808,1594,'page_col_image_3','437'),(46809,1594,'_page_col_image_3','field_5de6e3998e07e'),(46810,1594,'sec_2_title','Community'),(46811,1594,'_sec_2_title','field_5de6e3ef2798f'),(46812,1594,'sec_2_text','The project will be located about 5km south-west of the small rural township of Coolah. Sheep and cattle have grazed the undulating valleys and rocky outcrops across the region since the early days of European settlement.'),(46813,1594,'_sec_2_text','field_5de78dc89e613'),(46814,1594,'sec_3_title','The Project'),(46815,1594,'_sec_3_title','field_5de6e3d37d8da'),(46816,1594,'sec_3_text','The Valley of the Winds project is an 800 megawatt wind farm that is in the early stages of planning. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump that  will be capable of generating 2,000,000 megawatt hours of clean renewable energy each year.'),(46817,1594,'_sec_3_text','field_5de6e4044e5e8'),(46818,1594,'page_col_image_2','436'),(46819,1594,'_page_col_image_2','field_5de6546e7c63a'),(46820,1594,'sec_2_button','<a class=\"btn btn-home\" href=\"/hyveclean/community\">More about the community</a> <a class=\"btn btn-home\" href=\"/hyveclean/about/\">Positives for the area</a> <a class=\"btn btn-home\" href=\"#contact\">Contact us</a>\r\n'),(46821,1594,'_sec_2_button','field_5de6e58c86706'),(46822,1594,'sec_3_button','<a class=\"btn btn-home\" href=\"/hyveclean/the-project/\">Detailed project description</a> <a class=\"btn btn-home\" href=\"#location\">Location map</a>'),(46823,1594,'_sec_3_button','field_5de6e5a243c03'),(46824,1594,'page_col_image_4','455'),(46825,1594,'_page_col_image_4','field_5de70801090ce'),(46826,1594,'sec_4_title','Location'),(46827,1594,'_sec_4_title','field_5de7082a12a81'),(46828,1594,'sec_4_text','The project will be located in Central NSW about 5km south-west of the small rural township of Coolah. About 120 wind turbines are being proposed across two clusters at Mount Hope and Black Stump.'),(46829,1594,'_sec_4_text','field_5de7084812a82'),(46830,1594,'sec_4_button','<a class=\"btn btn-home\" href=\"/hyveclean/about/\">Detailed location information</a>'),(46831,1594,'_sec_4_button','field_5de7085e12a83'),(46832,1594,'news_title','Project updates'),(46833,1594,'_news_title','field_5de78da3aabb9'),(46834,1594,'sec_2_text_copy',''),(46835,1594,'_sec_2_text_copy','field_5de78dc89e613'),(46836,1594,'timeline-title','Time